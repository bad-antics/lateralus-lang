// ===================================================================
// examples/units_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: SI Dimensional Analysis for Thruster Force
// and Work Energy Verification (stdlib/units.ltl)
// ===================================================================

pub fn make_qty(val, dim_l, dim_m, dim_t) {
    let q = dict()
    q["val"] = val
    q["L"] = dim_l
    q["M"] = dim_m
    q["T"] = dim_t
    return q
}

pub fn dims_match(a, b) {
    if (a["L"] == b["L"]) && (a["M"] == b["M"]) && (a["T"] == b["T"]) {
        return 1
    }
    return 0
}

pub fn qty_mul(a, b) {
    return make_qty(a["val"] * b["val"], a["L"] + b["L"], a["M"] + b["M"], a["T"] + b["T"])
}

pub fn qty_div(a, b) {
    return make_qty(a["val"] / b["val"], a["L"] - b["L"], a["M"] - b["M"], a["T"] - b["T"])
}

pub fn main() {
    print("=== SI Dimensional Analysis & Unit Verification ===")

    let dist = make_qty(1500, 1, 0, 0)     // 1500 m
    let time_s = make_qty(50, 0, 0, 1)     // 50 s
    let vel = qty_div(dist, time_s)        // 30 m/s
    assert(vel["val"] == 30 && vel["L"] == 1 && vel["T"] == -1, "Velocity 30 m/s (L^1 T^-1)")

    let mass = make_qty(12, 0, 1, 0)       // 12 kg
    let accel = make_qty(10, 1, 0, -2)     // 10 m/s^2
    let force = qty_mul(mass, accel)       // 120 N (kg*m/s^2)
    assert(force["val"] == 120 && force["L"] == 1 && force["M"] == 1 && force["T"] == -2, "Force 120 N")

    let disp = make_qty(25, 1, 0, 0)       // 25 m
    let energy = qty_mul(force, disp)      // 3000 J (kg*m^2/s^2)
    assert(energy["val"] == 3000 && energy["L"] == 2 && energy["M"] == 1 && energy["T"] == -2, "Energy 3000 J")

    assert(dims_match(dist, mass) == 0, "Length and Mass dimensions must not match")
    print("All SI dimensional analysis and derived unit laws verified!")
}
