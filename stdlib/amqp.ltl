--- Standard library: AMQP 0-9-1 protocol support
--- Handles framing, connection, channel, basic, and exchange operations.

module amqp

--- AMQP frame types
let FRAME_METHOD = 1
let FRAME_HEADER = 2
let FRAME_BODY   = 3
let FRAME_HEARTBEAT = 8

--- AMQP reply codes
let REPLY_SUCCESS = 200
let CONTENT_TOO_LARGE = 311
let NO_ROUTE = 312

--- Encodes a boolean value as a 1-octet integer
fn enc_bool(val) {
    if val {
        [1]
    } else {
        [0]
    }
}

--- Decodes a boolean value from a buffer at index i
fn dec_bool(buf, i) {
    if i >= len(buf) {
        nil
    } else {
        buf[i] > 0
    }
}

--- Encodes an octet (unsigned 8-bit int)
fn enc_octet(val) {
    [val & 0xff]
}

--- Decodes an octet
fn dec_octet(buf, i) {
    if i >= len(buf) {
        nil
    } else {
        buf[i]
    }
}

--- Encodes a short uint (unsigned 16-bit int, big-endian)
fn enc_short(val) {
    [(val / 256) & 0xff, val & 0xff]
}

--- Decodes a short uint
fn dec_short(buf, i) {
    if i + 1 >= len(buf) {
        nil
    } else {
        (buf[i] * 256) + buf[i + 1]
    }
}

--- Encodes a long uint (unsigned 32-bit int, big-endian)
fn enc_long(val) {
    [
        (val / 16777216) & 0xff,
        (val / 65536) & 0xff,
        (val / 256) & 0xff,
        val & 0xff
    ]
}

--- Decodes a long uint
fn dec_long(buf, i) {
    if i + 3 >= len(buf) {
        nil
    } else {
        (buf[i] * 16777216) +
        (buf[i + 1] * 65536) +
        (buf[i + 2] * 256) +
        buf[i + 3]
    }
}

--- Encodes a short string (max 255 octets) with length prefix
fn enc_short_str(s) {
    let b = bytes(s)
    let n = len(b)
    if n > 255 {
        nil
    } else {
        [n] + b
    }
}

--- Decodes a short string with bounds check and proper UTF-8 decoding
fn dec_short_str(buf, i) {
    if i >= len(buf) {
        nil
    } else {
        let n = buf[i]
        if i + 1 + n > len(buf) {
            nil
        } else {
            let slice_bytes = []
            let k = 0
            while k < n {
                slice_bytes = slice_bytes + [buf[i + 1 + k]]
                k = k + 1
            }
            string(slice_bytes)
        }
    }
}

--- Decodes a long string with bounds check and proper UTF-8 decoding
fn dec_long_str(buf, i) {
    if i + 3 >= len(buf) {
        nil
    } else {
        let n = (buf[i] * 16777216) + (buf[i + 1] * 65536) + (buf[i + 2] * 256) + buf[i + 3]
        if i + 4 + n > len(buf) {
            nil
        } else {
            let slice_bytes = []
            let k = 0
            while k < n {
                slice_bytes = slice_bytes + [buf[i + 4 + k]]
                k = k + 1
            }
            string(slice_bytes)
        }
    }
}

--- Encodes a field table (dictionary of AMQP fields)
fn enc_field_table(table) {
    -- Simplified: encode as empty table (4 zero bytes for length)
    [0, 0, 0, 0]
}

--- Decodes a field table
fn dec_field_table(buf, i) {
    let l = dec_long(buf, i)
    if l == nil {
        nil
    } else {
        {}
    }
}

--- Parses an AMQP frame header (7 octets: type 1, channel 2, length 4)
fn parse_frame_header(buf, i) {
    if i + 6 >= len(buf) {
        nil
    } else {
        {
            "type": buf[i],
            "channel": (buf[i + 1] * 256) + buf[i + 2],
            "length": (buf[i + 3] * 16777216) + (buf[i + 4] * 65536) + (buf[i + 5] * 256) + buf[i + 6]
        }
    }
}

--- Serializes an AMQP frame
fn serialize_frame(type_val, channel, payload) {
    let length = len(payload)
    [type_val] + enc_short(channel) + enc_long(length) + payload + [206]
}