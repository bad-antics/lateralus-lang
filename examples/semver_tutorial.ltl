// examples/semver_tutorial.ltl - Practical Semantic Versioning 2.0.0
// Demonstrates version parsing, release bumping, dependency range checking, and comparison.

import semver

fn release_next(current_str: str, release_type: str) -> str {
    let v = semver.parse(current_str)
    let next_v = v
    
    if release_type == "major" {
        next_v = semver.bump_major(v)
    } else if release_type == "minor" {
        next_v = semver.bump_minor(v)
    } else if release_type == "patch" {
        next_v = semver.bump_patch(v)
    }
    
    return semver.to_string(next_v)
}

fn check_dependency_compatibility(required_spec: str, installed_version: str) -> bool {
    let installed = semver.parse(installed_version)
    // Assume caret specification e.g. "^1.2" -> major 1, min minor 2
    return semver.satisfies_caret(installed, 1, 2)
}

fn main() {
    println("=== Lateralus Semantic Versioning (SemVer 2.0.0) ===")
    
    // 1. Parsing release strings
    let raw = "v1.4.2-beta.3+sha.7f89d"
    let parsed = semver.parse(raw)
    
    println("Raw Input: " + raw)
    println("Major: " + to_str(semver.major(parsed)))
    println("Minor: " + to_str(semver.minor(parsed)))
    println("Patch: " + to_str(semver.patch(parsed)))
    println("Pre-release: " + semver.prerelease(parsed))
    println("Build Meta:  " + semver.build_meta(parsed))
    println("Is Pre-release: " + to_str(semver.is_prerelease(parsed)))
    
    // 2. Automated release bumping
    let next_patch = release_next("1.4.2", "patch")
    let next_minor = release_next("1.4.2", "minor")
    let next_major = release_next("1.4.2", "major")
    
    println("Bumped Patch: " + next_patch) // 1.4.3
    println("Bumped Minor: " + next_minor) // 1.5.0
    println("Bumped Major: " + next_major) // 2.0.0
    
    // 3. Precedence & Ordering
    let v_alpha = semver.parse("1.0.0-alpha")
    let v_stable = semver.parse("1.0.0")
    if semver.lt(v_alpha, v_stable) {
        println("Verified: Pre-release 1.0.0-alpha < Stable 1.0.0")
    }
    
    // 4. Caret Compatibility (^1.2)
    let comp1 = check_dependency_compatibility("^1.2", "1.5.1")
    let comp2 = check_dependency_compatibility("^1.2", "2.0.0")
    println("Installed 1.5.1 satisfies ^1.2: " + to_str(comp1)) // true
    println("Installed 2.0.0 satisfies ^1.2: " + to_str(comp2)) // false
}
