// Lateralus Standard Library Example: Binary Search Tree (BST)
// Demonstrates hierarchical key-value storage, fast search, and sorted in-order traversal projection.

fn bst_new(val: int) -> dict {
    let mut node = {};
    node["val"] = val;
    node["left"] = nil;
    node["right"] = nil;
    return node;
}

fn bst_insert(root: dict, val: int) -> dict {
    if root == nil {
        return bst_new(val);
    }
    let r_val = root["val"];
    if val < r_val {
        root["left"] = bst_insert(root["left"], val);
    } else {
        if val > r_val {
            root["right"] = bst_insert(root["right"], val);
        }
    }
    return root;
}

fn bst_search(root: dict, val: int) -> bool {
    if root == nil {
        return false;
    }
    let r_val = root["val"];
    if val == r_val {
        return true;
    }
    if val < r_val {
        return bst_search(root["left"], val);
    }
    return bst_search(root["right"], val);
}

fn bst_min(root: dict) -> int {
    let mut curr = root;
    while curr["left"] != nil {
        curr = curr["left"];
    }
    return curr["val"];
}

fn bst_max(root: dict) -> int {
    let mut curr = root;
    while curr["right"] != nil {
        curr = curr["right"];
    }
    return curr["val"];
}

fn bst_inorder(root: dict) -> list {
    if root == nil {
        return [];
    }
    let left_list = bst_inorder(root["left"]);
    let right_list = bst_inorder(root["right"]);
    return left_list + [root["val"]] + right_list;
}

fn main() -> int {
    println("=== Binary Search Tree (BST) Example ===");

    // Construct compiler symbol table offsets:
    let mut root = bst_new(50);
    root = bst_insert(root, 30);
    root = bst_insert(root, 70);
    root = bst_insert(root, 20);
    root = bst_insert(root, 40);
    root = bst_insert(root, 60);
    root = bst_insert(root, 80);

    println("Checking symbol offset existence for 40:");
    if bst_search(root, 40) {
        println("Found: symbol offset 40 is registered.");
    } else {
        println("Not found.");
    }

    println("Minimum symbol offset in table:");
    println(bst_min(root));

    println("Maximum symbol offset in table:");
    println(bst_max(root));

    println("Sorted in-order projection of all symbol offsets:");
    let ordered = bst_inorder(root);
    let mut idx = 0;
    while idx < len(ordered) {
        println(ordered[idx]);
        idx = idx + 1;
    }

    println("BST execution completed successfully.");
    return 0;
}
