// stdlib/prometheus.ltl
// Prometheus text exposition format parser (quote-aware, strict).

import "stdlib/strings"

// Strip a single trailing carriage return (CRLF tolerance).
fn strip_cr(s) {
    let n = len(s)
    if n > 0 && slice(s, n - 1, n) == "\r" {
        return slice(s, 0, n - 1)
    }
    return s
}

// Return the index (relative to `s`) of the first '}' that is outside any
// double-quoted label value. Returns -1 if no such closing brace exists.
// Backslash escapes inside quoted strings are honoured.
fn find_label_close(s) {
    let n = len(s)
    let i = 0
    let in_quote = false
    while i < n {
        let c = slice(s, i, i + 1)
        if in_quote {
            if c == "\\" {
                // skip the escaped character
                i = i + 2
                continue
            }
            if c == "\"" {
                in_quote = false
            }
        } else {
            if c == "\"" {
                in_quote = true
            } else if c == "}" {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

// Parse a label set body (the text between '{' and '}') into a list of
// [key, value] pairs. Returns nil on malformed input, including an
// unterminated quoted value.
fn parse_labels(s) {
    let n = len(s)
    let i = 0
    let out = []
    while i < n {
        // skip leading whitespace and separators
        let c = slice(s, i, i + 1)
        if c == " " || c == "\t" || c == "," {
            i = i + 1
            continue
        }

        // read key up to '='
        let ks = i
        while i < n && slice(s, i, i + 1) != "=" {
            i = i + 1
        }
        if i >= n {
            // key without '=' -> malformed
            return nil
        }
        let key = strings.trim(slice(s, ks, i))
        if len(key) == 0 {
            return nil
        }
        i = i + 1 // skip '='

        // value must start with an opening quote
        if i >= n || slice(s, i, i + 1) != "\"" {
            return nil
        }
        i = i + 1 // skip opening quote

        let val = ""
        let terminated = false
        while i < n {
            let ch = slice(s, i, i + 1)
            if ch == "\\" {
                if i + 1 >= n {
                    // dangling escape at end of input -> unterminated
                    return nil
                }
                let nx = slice(s, i + 1, i + 2)
                if nx == "n" {
                    val = val + "\n"
                } else if nx == "\\" {
                    val = val + "\\"
                } else if nx == "\"" {
                    val = val + "\""
                } else {
                    val = val + nx
                }
                i = i + 2
                continue
            }
            if ch == "\"" {
                terminated = true
                i = i + 1
                break
            }
            val = val + ch
            i = i + 1
        }

        if !terminated {
            // missing closing quote: reject rather than emit a truncated pair
            return nil
        }

        out = out + [[key, val]]
    }
    return out
}

// Parse a single exposition line into a sample record, or nil if the line
// is blank, a comment, or malformed.
fn parse_line(line) {
    let line = strings.trim(strip_cr(line))
    if len(line) == 0 {
        return nil
    }
    if slice(line, 0, 1) == "#" {
        return nil
    }

    let n = len(line)
    let i = 0

    // metric name: up to '{' or whitespace
    while i < n {
        let c = slice(line, i, i + 1)
        if c == "{" || c == " " || c == "\t" {
            break
        }
        i = i + 1
    }
    let name = slice(line, 0, i)
    if len(name) == 0 {
        return nil
    }

    let labels = []
    if i < n && slice(line, i, i + 1) == "{" {
        let rest = slice(line, i + 1, n)
        let close = find_label_close(rest)
        if close < 0 {
            // unterminated label block
            return nil
        }
        let parsed = parse_labels(slice(rest, 0, close))
        if parsed == nil {
            return nil
        }
        labels = parsed
        // advance past the closing '}'
        i = i + 1 + close + 1
    }

    // remainder: "<value> [timestamp]"
    let remainder = strings.trim(slice(line, i, n))
    if len(remainder) == 0 {
        // no sample value present
        return nil
    }

    let parts = strings.split(remainder, " ")
    let value = ""
    let timestamp = nil
    let seen = 0
    for p in parts {
        if len(p) == 0 {
            continue
        }
        if seen == 0 {
            value = p
        } else if seen == 1 {
            timestamp = p
        }
        seen = seen + 1
    }

    if len(value) == 0 {
        return nil
    }

    return {
        "name": name,
        "labels": labels,
        "value": value,
        "timestamp": timestamp
    }
}

// Parse a full exposition payload (LF or CRLF line endings).
fn parse_exposition(text) {
    let samples = []
    let lines = strings.split(text, "\n")
    for raw in lines {
        let ln = strip_cr(raw)
        let sample = parse_line(ln)
        if sample != nil {
            samples = samples + [sample]
        }
    }
    return samples
}