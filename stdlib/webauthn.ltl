--- stdlib/webauthn.ltl (fixed) ---
fn parse_authenticator_data(buf: list<int>) -> map<any> {
    if len(buf) < 37 {
        return {"ok": false}
    }
    let rp_id_hash = slice(buf, 0, 32)
    let flags = buf[32]
    let sign_count = (buf[33] << 24) | (buf[34] << 16) | (buf[35] << 8) | buf[36]

    let flag_ed = (flags & 0x80) != 0
    let flag_at = (flags & 0x40) != 0
    let flag_uv = (flags & 0x04) != 0
    let flag_up = (flags & 0x01) != 0

    let m = {
        "ok": true,
        "rp_id_hash": rp_id_hash,
        "flags": flags,
        "sign_count": sign_count,
        "flag_ed": flag_ed,
        "flag_at": flag_at,
        "flag_uv": flag_uv,
        "flag_up": flag_up
    }

    if flag_at {
        if len(buf) < 55 {
            return {"ok": false}
        }
        let aaguid = slice(buf, 37, 53)
        let id_len = (buf[53] << 8) | buf[54]
        if 55 + id_len > len(buf) {
            return {"ok": false}
        }
        let credential_id = slice(buf, 55, 55 + id_len)
        let cose_public_key = slice(buf, 55 + id_len, len(buf))

        m["aaguid"] = aaguid
        m["credential_id"] = credential_id
        m["cose_public_key"] = cose_public_key
    }

    return m
}

fn verify_client_data(client_data: map<any>, expected_type: string, expected_challenge: string, expected_origin: string, expected_token_binding_status: string) -> list<any> {
    let keys_list = keys(client_data)
    if not contains(keys_list, "type") {
        return [false, "missing type"]
    }
    if client_data["type"] != expected_type {
        return [false, "invalid type"]
    }

    if not contains(keys_list, "challenge") {
        return [false, "missing challenge"]
    }
    if client_data["challenge"] != expected_challenge {
        return [false, "invalid challenge"]
    }

    if not contains(keys_list, "origin") {
        return [false, "missing origin"]
    }
    if client_data["origin"] != expected_origin {
        return [false, "invalid origin"]
    }

    if expected_token_binding_status != "" {
        if not contains(keys_list, "tokenBinding") {
            return [false, "missing tokenBinding"]
        }
        let tb = client_data["tokenBinding"]
        if type(tb) == "map" {
            let tb_keys = keys(tb)
            if contains(tb_keys, "status") {
                if tb["status"] != expected_token_binding_status {
                    return [false, "invalid token binding status"]
                }
            } else {
                return [false, "missing token binding status"]
            }
        } else {
            return [false, "invalid token binding format"]
        }
    }

    return [true, "ok"]
}