// ===================================================================
// tests/stdlib_suffix_tree_tutorial.ltl
// -------------------------------------------------------------------
// Complete test suite for Suffix Tree in Lateralus.
// Linear-time compact trie for all suffixes, enabling O(m) pattern
// matching and multi-occurrence frequency counting.
// Esko Ukkonen (1995).
// ===================================================================

pub fn st_create(text: str) -> dict {
    let mut tree = {}
    let n = text.len()

    let mut start = [0, 0]
    let mut end = [0, 0]
    let mut link = [0, 1]
    let mut children = [{}, {}]

    tree["start"] = start
    tree["end"] = end
    tree["link"] = link
    tree["children"] = children
    tree["text"] = text
    tree["root"] = 1

    // Build suffix tree by incrementally inserting all suffixes
    // Compact edge compression
    let mut i = 0
    while i < n {
        let mut curr_node = 1
        let mut j = i
        while j < n {
            let ch = text[j]
            let mut node_children = children[curr_node]

            if contains(node_children, ch) {
                let child_id = node_children[ch]
                let e_start = start[child_id]
                let e_end = end[child_id]
                let edge_len = e_end - e_start

                // Compare edge characters
                let mut match_len = 0
                let mut edge_pos = e_start
                let mut text_pos = j

                while edge_pos < e_end and text_pos < n and text[edge_pos] == text[text_pos] {
                    match_len = match_len + 1
                    edge_pos = edge_pos + 1
                    text_pos = text_pos + 1
                }

                if match_len == edge_len {
                    // Full edge matched, advance to child node
                    curr_node = child_id
                    j = j + match_len
                } else {
                    // Partial edge match: split edge and create internal node
                    let split_node = start.len()
                    start.push(e_start)
                    end.push(e_start + match_len)
                    link.push(1)

                    let mut split_children = {}
                    let old_branch_ch = text[e_start + match_len]
                    split_children[old_branch_ch] = child_id

                    start[child_id] = e_start + match_len

                    // Create new leaf node for remaining suffix
                    let new_leaf = start.len()
                    start.push(j + match_len)
                    end.push(n)
                    link.push(1)
                    children.push({})

                    let new_branch_ch = text[j + match_len]
                    split_children[new_branch_ch] = new_leaf
                    children.push(split_children)

                    // Update parent to point to split node
                    node_children[ch] = split_node
                    children[curr_node] = node_children
                    j = n // Suffix fully consumed
                }
            } else {
                // No matching edge, create new leaf directly
                let new_leaf = start.len()
                start.push(j)
                end.push(n)
                link.push(1)
                children.push({})

                node_children[ch] = new_leaf
                children[curr_node] = node_children
                j = n
            }
        }
        i = i + 1
    }

    tree["start"] = start
    tree["end"] = end
    tree["link"] = link
    tree["children"] = children
    return tree
}

pub fn st_contains(tree: dict, pattern: str) -> bool {
    let text = tree["text"]
    let start = tree["start"]
    let end = tree["end"]
    let children = tree["children"]

    let m = pattern.len()
    if m == 0 {
        return true
    }

    let mut curr_node = 1
    let mut p_idx = 0

    while p_idx < m {
        let ch = pattern[p_idx]
        let node_children = children[curr_node]

        if not contains(node_children, ch) {
            return false
        }

        let child_id = node_children[ch]
        let e_start = start[child_id]
        let e_end = end[child_id]

        let mut edge_pos = e_start
        while edge_pos < e_end and p_idx < m {
            if text[edge_pos] != pattern[p_idx] {
                return false
            }
            edge_pos = edge_pos + 1
            p_idx = p_idx + 1
        }
        curr_node = child_id
    }

    return true
}

pub fn st_count_leaves(tree: dict, node: int) -> int {
    let children = tree["children"]
    let node_children = children[node]

    let mut count = 0
    let mut has_child = false
    for ch in keys(node_children) {
        has_child = true
        let child_id = node_children[ch]
        count = count + st_count_leaves(tree, child_id)
    }

    if not has_child {
        return 1
    }
    return count
}

pub fn st_count_occurrences(tree: dict, pattern: str) -> int {
    let text = tree["text"]
    let start = tree["start"]
    let end = tree["end"]
    let children = tree["children"]

    let m = pattern.len()
    if m == 0 {
        return 0
    }

    let mut curr_node = 1
    let mut p_idx = 0

    while p_idx < m {
        let ch = pattern[p_idx]
        let node_children = children[curr_node]

        if not contains(node_children, ch) {
            return 0
        }

        let child_id = node_children[ch]
        let e_start = start[child_id]
        let e_end = end[child_id]

        let mut edge_pos = e_start
        while edge_pos < e_end and p_idx < m {
            if text[edge_pos] != pattern[p_idx] {
                return 0
            }
            edge_pos = edge_pos + 1
            p_idx = p_idx + 1
        }
        curr_node = child_id
    }

    return st_count_leaves(tree, curr_node)
}

// -------------------------------------------------------------------
// Smoke tests and Golden Test Vectors
// -------------------------------------------------------------------

pub fn test_st_basic_matching() -> bool {
    let text = "banana$"
    let st = st_create(text)

    if not st_contains(st, "banana") {
        return false
    }
    if not st_contains(st, "anana") {
        return false
    }
    if not st_contains(st, "nana") {
        return false
    }
    if not st_contains(st, "ana") {
        return false
    }
    if not st_contains(st, "na") {
        return false
    }
    if not st_contains(st, "a") {
        return false
    }

    if st_contains(st, "apple") {
        return false
    }
    if st_contains(st, "band") {
        return false
    }
    return true
}

pub fn test_st_frequency_counts() -> bool {
    let text = "banana$"
    let st = st_create(text)

    let cnt_ana = st_count_occurrences(st, "ana")
    let cnt_na = st_count_occurrences(st, "na")
    let cnt_banana = st_count_occurrences(st, "banana")
    let cnt_none = st_count_occurrences(st, "xyz")

    if cnt_ana != 2 {
        return false
    }
    if cnt_na != 2 {
        return false
    }
    if cnt_banana != 1 {
        return false
    }
    if cnt_none != 0 {
        return false
    }
    return true
}

pub fn test_st_dna_primers() -> bool {
    let dna = "GATTACAGATTACA$"
    let st = st_create(dna)

    if not st_contains(st, "GATTACA") {
        return false
    }
    if not st_contains(st, "TTACA") {
        return false
    }

    // "GATTACA" appears exactly 2 times
    let count_target = st_count_occurrences(st, "GATTACA")
    if count_target != 2 {
        return false
    }

    if st_contains(st, "GGGG") {
        return false
    }
    return true
}
