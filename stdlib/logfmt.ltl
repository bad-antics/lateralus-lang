// stdlib/logfmt.ltl
// logfmt encoder / decoder (key=value key2="quoted value" ...)
//
// format(pairs)        -> String
// parse(line)          -> Result<List<[String, String]>, String>   (strict)
// parse_lenient(line)  -> List<[String, String]>                   (best effort)

fn is_control(c) {
    // any C0 control character (includes \n, \r, \t) and DEL
    let code = ord(c)
    return code < 32 || code == 127
}

fn needs_quoting(s) {
    let n = len(s)
    if n == 0 {
        return true
    }
    let i = 0
    while i < n {
        let c = s[i]
        if c == " " || c == "=" || c == "\"" || c == "\\" {
            return true
        }
        if is_control(c) {
            return true
        }
        i = i + 1
    }
    return false
}

fn hex2(code) {
    let digits = "0123456789abcdef"
    let hi = code / 16
    let lo = code % 16
    return digits[hi] + digits[lo]
}

fn escape_quoted(s) {
    let out = ""
    let n = len(s)
    let i = 0
    while i < n {
        let c = s[i]
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else if is_control(c) {
            out = out + "\\x" + hex2(ord(c))
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn format_value(v) {
    let s = to_string(v)
    if needs_quoting(s) {
        return "\"" + escape_quoted(s) + "\""
    }
    return s
}

fn format(pairs) {
    let parts = []
    for p in pairs {
        let k = to_string(p[0])
        let v = format_value(p[1])
        push(parts, k + "=" + v)
    }
    return join(parts, " ")
}

fn is_space(c) {
    return c == " " || c == "\t"
}

fn hex_val(c) {
    let digits = "0123456789abcdef"
    let lc = lower(c)
    let i = 0
    while i < 16 {
        if digits[i] == lc {
            return i
        }
        i = i + 1
    }
    return -1
}

// Strict parser. Returns Ok(list) or Err(message).
fn parse(line) {
    let n = len(line)
    let i = 0
    let result = []

    while i < n {
        // skip leading whitespace between pairs
        while i < n && is_space(line[i]) {
            i = i + 1
        }
        if i >= n {
            break
        }

        // ---- key ----
        let k = ""
        let key_start = i
        while i < n && line[i] != "=" && !is_space(line[i]) {
            if line[i] == "\"" {
                return Err("logfmt: unexpected quote in key at offset " + to_string(i))
            }
            k = k + line[i]
            i = i + 1
        }

        if len(k) == 0 {
            // token begins with '=' (e.g. "=val")
            return Err("logfmt: empty key at offset " + to_string(key_start))
        }

        // bare key with no value ("flag")
        if i >= n || is_space(line[i]) {
            push(result, [k, ""])
            continue
        }

        // line[i] == "="
        i = i + 1

        // ---- value ----
        let v = ""
        if i < n && line[i] == "\"" {
            let quote_start = i
            i = i + 1
            let closed = false
            while i < n {
                let c = line[i]
                if c == "\\" {
                    if i + 1 >= n {
                        return Err("logfmt: dangling escape at offset " + to_string(i))
                    }
                    let e = line[i + 1]
                    if e == "n" {
                        v = v + "\n"
                        i = i + 2
                    } else if e == "r" {
                        v = v + "\r"
                        i = i + 2
                    } else if e == "t" {
                        v = v + "\t"
                        i = i + 2
                    } else if e == "\\" {
                        v = v + "\\"
                        i = i + 2
                    } else if e == "\"" {
                        v = v + "\""
                        i = i + 2
                    } else if e == "x" {
                        if i + 3 >= n {
                            return Err("logfmt: truncated \\x escape at offset " + to_string(i))
                        }
                        let h = hex_val(line[i + 2])
                        let l = hex_val(line[i + 3])
                        if h < 0 || l < 0 {
                            return Err("logfmt: invalid \\x escape at offset " + to_string(i))
                        }
                        v = v + chr(h * 16 + l)
                        i = i + 4
                    } else {
                        // unknown escape: keep the escaped char literally
                        v = v + e
                        i = i + 2
                    }
                } else if c == "\"" {
                    closed = true
                    i = i + 1
                    break
                } else {
                    v = v + c
                    i = i + 1
                }
            }
            if !closed {
                return Err("logfmt: unterminated quoted value at offset " + to_string(quote_start))
            }
            // after a closing quote only whitespace or end-of-input is legal
            if i < n && !is_space(line[i]) {
                return Err("logfmt: unexpected character after closing quote at offset " + to_string(i))
            }
        } else {
            while i < n && !is_space(line[i]) {
                if line[i] == "\"" {
                    return Err("logfmt: unexpected quote in unquoted value at offset " + to_string(i))
                }
                v = v + line[i]
                i = i + 1
            }
        }

        push(result, [k, v])
    }

    return Ok(result)
}

// Best-effort parser preserving the legacy (non-failing) contract:
// returns the pairs parsed before the first error, or all pairs on success.
fn parse_lenient(line) {
    let r = parse(line)
    if is_ok(r) {
        return unwrap(r)
    }
    // fall back: parse the longest valid prefix of whitespace-separated tokens
    let out = []
    let n = len(line)
    let i = 0
    while i < n {
        while i < n && is_space(line[i]) {
            i = i + 1
        }
        if i >= n {
            break
        }
        let k = ""
        while i < n && line[i] != "=" && !is_space(line[i]) {
            k = k + line[i]
            i = i + 1
        }
        let v = ""
        if i < n && line[i] == "=" {
            i = i + 1
            if i < n && line[i] == "\"" {
                i = i + 1
                while i < n && line[i] != "\"" {
                    if line[i] == "\\" && i + 1 < n {
                        i = i + 1
                    }
                    v = v + line[i]
                    i = i + 1
                }
                if i < n {
                    i = i + 1
                }
            } else {
                while i < n && !is_space(line[i]) {
                    v = v + line[i]
                    i = i + 1
                }
            }
        }
        if len(k) > 0 {
            push(out, [k, v])
        }
    }
    return out
}