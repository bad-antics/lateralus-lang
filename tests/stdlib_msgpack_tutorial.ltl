// Pinned test vectors for stdlib/msgpack tutorial (msgpack.org specification).

import msgpack

pub fn test_msgpack_primitive_wire_tags() -> bool {
    // 1. Nil tag (0xc0 = 192)
    let nil_bytes = msgpack_encode(nil)
    if len(nil_bytes) != 1 || nil_bytes[0] != 192 { return false }

    // 2. Boolean tags (false=0xc2=194, true=0xc3=195)
    let false_bytes = msgpack_encode(false)
    if len(false_bytes) != 1 || false_bytes[0] != 194 { return false }

    let true_bytes = msgpack_encode(true)
    if len(true_bytes) != 1 || true_bytes[0] != 195 { return false }

    // 3. Positive fixint (0x00 - 0x7f, single byte)
    let fixint_bytes = msgpack_encode(42)
    if len(fixint_bytes) != 1 || fixint_bytes[0] != 42 { return false }

    // 4. Uint16 (0xcd = 205 followed by 2 big-endian bytes)
    // 1000 = 0x03E8 -> [205, 3, 232]
    let u16_bytes = msgpack_encode(1000)
    if len(u16_bytes) != 3 { return false }
    if u16_bytes[0] != 205 || u16_bytes[1] != 3 || u16_bytes[2] != 232 { return false }

    // 5. Fixstr ("hi" -> 0xa2 = 162 followed by 'h', 'i')
    let str_bytes = msgpack_encode("hi")
    if len(str_bytes) != 3 { return false }
    if str_bytes[0] != 162 || str_bytes[1] != 104 || str_bytes[2] != 105 { return false }

    return true
}

pub fn test_msgpack_decode_roundtrip() -> bool {
    // Array round-trip
    let arr = [10, 20, 30]
    let arr_enc = msgpack_encode(arr)
    let arr_dec = msgpack_decode(arr_enc)
    if arr_dec[1] != len(arr_enc) { return false }
    let restored_arr = arr_dec[0]
    if len(restored_arr) != 3 { return false }
    if restored_arr[0] != 10 || restored_arr[1] != 20 || restored_arr[2] != 3 { return false }

    // Map round-trip
    let m = {}
    m["status"] = "ok"
    m["code"] = 200
    let m_enc = msgpack_encode(m)
    let m_dec = msgpack_decode(m_enc)
    let restored_m = m_dec[0]
    if restored_m["status"] != "ok" { return false }
    if restored_m["code"] != 200 { return false }

    return true
}
