// =======================================================================
// examples/spiral_wave_edge_cases.ltl
// Edge-case tour of the stdlib.spiral wave (stdlib/spiral_wave.ltl):
// the smallest spirals (N=1, N=2) and odd vs even sizes.
// Run with:  python3 -m lateralus_lang run examples/spiral_wave_edge_cases.ltl
// =======================================================================

// Build an n×n matrix of zeros.
fn spiral_zeros(n: int) -> list {
    let m = []
    for i in range(n) {
        let row = []
        for j in range(n) {
            row = row + [0]
        }
        m = m + [row]
    }
    return m
}

// Fill an n×n matrix with 1..n*n in clockwise spiral order.
fn spiral_build(n: int) -> list {
    let m = spiral_zeros(n)
    let top = 0
    let bottom = n - 1
    let left = 0
    let right = n - 1
    let val = 1

    while top <= bottom && left <= right {
        let c = left
        while c <= right {
            m[top][c] = val
            val = val + 1
            c = c + 1
        }
        top = top + 1

        let r = top
        while r <= bottom {
            m[r][right] = val
            val = val + 1
            r = r + 1
        }
        right = right - 1

        if top <= bottom {
            let c2 = right
            while c2 >= left {
                m[bottom][c2] = val
                val = val + 1
                c2 = c2 - 1
            }
            bottom = bottom - 1
        }

        if left <= right {
            let r2 = bottom
            while r2 >= top {
                m[r2][left] = val
                val = val + 1
                r2 = r2 - 1
            }
            left = left + 1
        }
    }

    return m
}

// Pretty-print a square matrix with aligned columns.
fn spiral_print(m: list) {
    let n = len(m)
    let i = 0
    while i < n {
        let line = ""
        let j = 0
        while j < n {
            let cell = m[i][j]
            let pad = ""
            if cell < 10 {
                pad = "  "
            } else {
                pad = " "
            }
            line = line + pad + str(cell)
            j = j + 1
        }
        println(line)
        i = i + 1
    }
}

// Deterministic weighted checksum: sum of value * (1 + row + col).
fn spiral_checksum(m: list) -> int {
    let n = len(m)
    let total = 0
    let i = 0
    while i < n {
        let j = 0
        while j < n {
            total = total + m[i][j] * (1 + i + j)
            j = j + 1
        }
        i = i + 1
    }
    return total
}

fn main() {
    // N=1: the degenerate single-cell spiral.
    println("--- N=1 ---")
    spiral_print(spiral_build(1))
    println("checksum: " + str(spiral_checksum(spiral_build(1))))

    // N=2: smallest even spiral (no centre cell).
    println("--- N=2 ---")
    spiral_print(spiral_build(2))
    println("checksum: " + str(spiral_checksum(spiral_build(2))))

    // N=3: smallest odd spiral with a single centre cell.
    println("--- N=3 ---")
    spiral_print(spiral_build(3))
    println("checksum: " + str(spiral_checksum(spiral_build(3))))
}

main()