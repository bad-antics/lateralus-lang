// ===================================================================
// tests/stdlib_burrows_wheeler_tutorial.ltl
// -------------------------------------------------------------------
// Complete test suite for Burrows-Wheeler Transform (BWT) in Lateralus.
// Features cyclic rotation sorting, forward BWT transform, and
// exact lossless inversion via LF-mapping permutation vectors.
// Michael Burrows and David Wheeler (1994).
// ===================================================================

pub fn rot_cmp(text: str, i: int, j: int, n: int) -> int {
    let mut k = 0
    while k < n {
        let pos1 = (i + k) % n
        let pos2 = (j + k) % n
        let c1 = text[pos1]
        let c2 = text[pos2]
        if c1 < c2 {
            return -1
        }
        if c1 > c2 {
            return 1
        }
        k = k + 1
    }
    return 0
}

pub fn bwt_transform(text: str) -> dict {
    let mut res = {}
    let n = text.len()
    if n == 0 {
        res["transformed"] = ""
        res["primary_index"] = 0
        return res
    }

    // Initialize shift indices 0 .. n-1
    let mut shifts = []
    let mut i = 0
    while i < n {
        shifts.push(i)
        i = i + 1
    }

    // Sort cyclic rotations (insertion sort)
    let mut p = 1
    while p < n {
        let key = shifts[p]
        let mut q = p - 1
        let mut moving = true
        while moving and q >= 0 {
            let prev = shifts[q]
            if rot_cmp(text, key, prev, n) < 0 {
                shifts[q + 1] = prev
                q = q - 1
            } else {
                moving = false
            }
        }
        shifts[q + 1] = key
        p = p + 1
    }

    // Find primary index and build last column L
    let mut transformed = ""
    let mut primary_index = 0
    let mut r = 0
    while r < n {
        let shift = shifts[r]
        if shift == 0 {
            primary_index = r
        }
        let last_pos = (shift + n - 1) % n
        transformed = transformed + text[last_pos]
        r = r + 1
    }

    res["transformed"] = transformed
    res["primary_index"] = primary_index
    return res
}

pub fn bwt_inverse(transformed: str, primary_index: int) -> str {
    let n = transformed.len()
    if n == 0 {
        return ""
    }

    // Step 1: Count character frequencies in transformed string
    let mut counts = {}
    let mut rank = []
    let mut i = 0
    while i < n {
        let ch = transformed[i]
        let mut current_cnt = 0
        if contains(counts, ch) {
            current_cnt = counts[ch]
        }
        rank.push(current_cnt)
        counts[ch] = current_cnt + 1
        i = i + 1
    }

    // Step 2: Extract distinct characters and sort them
    let mut distinct_chars = keys(counts)
    let m = distinct_chars.len()
    let mut a = 1
    while a < m {
        let k = distinct_chars[a]
        let mut b = a - 1
        let mut moving = true
        while moving and b >= 0 {
            let prev = distinct_chars[b]
            if k < prev {
                distinct_chars[b + 1] = prev
                b = b - 1
            } else {
                moving = false
            }
        }
        distinct_chars[b + 1] = k
        a = a + 1
    }

    // Step 3: Compute prefix sum offsets C[c] for each character
    let mut c_offsets = {}
    let mut total_offset = 0
    let mut d = 0
    while d < m {
        let ch = distinct_chars[d]
        c_offsets[ch] = total_offset
        let cnt = counts[ch]
        total_offset = total_offset + cnt
        d = d + 1
    }

    // Step 4: Build LF-mapping array P[i] = C[L[i]] + rank[i]
    let mut next_row = []
    let mut j = 0
    while j < n {
        let ch = transformed[j]
        let base_off = c_offsets[ch]
        let r_val = rank[j]
        next_row.push(base_off + r_val)
        j = j + 1
    }

    // Step 5: Walk backward from primary_index to reconstruct original text
    let mut reconstructed_chars = []
    let mut curr = primary_index
    let mut step = 0
    while step < n {
        let ch = transformed[curr]
        reconstructed_chars.push(ch)
        curr = next_row[curr]
        step = step + 1
    }

    // Reverse reconstructed_chars to get forward string
    let mut original = ""
    let mut idx = n - 1
    while idx >= 0 {
        original = original + reconstructed_chars[idx]
        idx = idx - 1
    }

    return original
}

pub fn bwt_rle_count(s: str) -> int {
    let n = s.len()
    if n == 0 {
        return 0
    }
    let mut runs = 1
    let mut i = 1
    while i < n {
        if s[i] != s[i - 1] {
            runs = runs + 1
        }
        i = i + 1
    }
    return runs
}

// -------------------------------------------------------------------
// Smoke tests and Golden Test Vectors
// -------------------------------------------------------------------

pub fn test_bwt_roundtrip_banana() -> bool {
    let original = "banana$"
    let transformed_dict = bwt_transform(original)

    let transformed = transformed_dict["transformed"]
    let p_idx = transformed_dict["primary_index"]

    // Expected BWT for "banana$" is "annb$aa"
    if transformed != "annb$aa" {
        return false
    }

    let restored = bwt_inverse(transformed, p_idx)
    if restored != original {
        return false
    }
    return true
}

pub fn test_bwt_roundtrip_dna() -> bool {
    let dna = "ACGTACGTACGT$"
    let t_dict = bwt_transform(dna)
    let restored = bwt_inverse(t_dict["transformed"], t_dict["primary_index"])

    if restored != dna {
        return false
    }
    return true
}

pub fn test_bwt_compression_clustering() -> bool {
    let repetitive = "AAAAABBBBBCCCCCDDDDD$"
    let t_dict = bwt_transform(repetitive)
    let t_str = t_dict["transformed"]

    let restored = bwt_inverse(t_str, t_dict["primary_index"])
    if restored != repetitive {
        return false
    }

    // Check that run-length count is small due to clustering
    let runs = bwt_rle_count(t_str)
    if runs > 8 {
        return false
    }
    return true
}

pub fn test_bwt_single_char() -> bool {
    let text = "X"
    let t_dict = bwt_transform(text)
    let restored = bwt_inverse(t_dict["transformed"], t_dict["primary_index"])

    if restored != text {
        return false
    }
    return true
}
