// Original AI-assisted tutorial example; MIT.
// Run with scripts/run_deque_tutorial.py, which prepends stdlib/deque.ltl.
fn main() {
    let jobs = from_list([20, 30])
    jobs = push_front(jobs, 10)
    jobs = push_back(jobs, 40)
    println(to_list(jobs))

    let first_job = pop_front(jobs)
    println(first_job[0])
    jobs = first_job[1]
    let last_job = pop_back(jobs)
    println(last_job[0])
    jobs = last_job[1]
    println(to_list(jobs))

    println(rotate_left([10, 20, 30, 40], 5))
    println(rotate_right([10, 20, 30, 40], 5))
    println(rotate_right([10, 20, 30, 40], 0))
    println(at(jobs, 2))
    println(pop_front(new()))
    println(is_empty(clear(jobs)))
}
