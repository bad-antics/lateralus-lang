fn pending_jobs() -> list {
    let jobs = new()
    jobs = push_back(jobs, "resize-photo")
    jobs = push_back(jobs, "update-index")
    return push_front(jobs, "send-alert")
}

fn main() {
    urgent_job_goes_first()
    popping_an_empty_queue()

    let jobs = pending_jobs()
    while !is_empty(jobs) {
        let result = pop_front(jobs)
        println(result[0])
        jobs = result[1]
    }
}

fn urgent_job_goes_first() {
    let first = pop_front(pending_jobs())
    assert_eq(first, ["send-alert", ["resize-photo", "update-index"]])
    let second = pop_front(first[1])
    assert_eq(second, ["resize-photo", ["update-index"]])
    assert_eq(pop_front(second[1]), ["update-index", []])
}

fn popping_an_empty_queue() {
    assert_eq(pop_front(new()), [nil, []])
}
