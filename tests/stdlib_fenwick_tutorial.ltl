// Standard Library Fenwick Tree (Binary Indexed Tree) Verification Suite
// Validates O(log n) point updates, cumulative prefix sums, range sum queries, and boundary safety.

fn lowbit(x: int) -> int {
    return x & (0 - x);
}

fn fenwick_add(tree: list, size: int, idx: int, delta: int) -> list {
    let mut t = tree;
    let mut i = idx;
    while i <= size {
        t[i] = t[i] + delta;
        i = i + lowbit(i);
    }
    return t;
}

fn fenwick_query(tree: list, idx: int) -> int {
    let mut sum = 0;
    let mut i = idx;
    while i > 0 {
        sum = sum + tree[i];
        i = i - lowbit(i);
    }
    return sum;
}

fn fenwick_range_query(tree: list, left: int, right: int) -> int {
    if left > right {
        return 0;
    }
    return fenwick_query(tree, right) - fenwick_query(tree, left - 1);
}

fn fenwick_build(arr: list) -> list {
    let n = len(arr);
    let mut tree = [];
    let mut i = 0;
    while i <= n {
        tree = tree + [0];
        i = i + 1;
    }
    let mut idx = 1;
    while idx <= n {
        tree = fenwick_add(tree, n, idx, arr[idx - 1]);
        idx = idx + 1;
    }
    return tree;
}

fn main() -> int {
    // 1. Bitwise Lowbit Invariant Verification
    assert(lowbit(1) == 1);
    assert(lowbit(2) == 2);
    assert(lowbit(3) == 1);
    assert(lowbit(4) == 4);
    assert(lowbit(6) == 2);
    assert(lowbit(8) == 8);
    assert(lowbit(12) == 4);

    // 2. Classical 8-element Array Build & Prefix Sums
    // Input: [3, 2, -1, 6, 5, 4, -3, 2]
    // 1-based indices: 1..8
    let data = [3, 2, -1, 6, 5, 4, -3, 2];
    let mut tree = fenwick_build(data);

    // Prefix sum queries:
    // P(1) = 3
    // P(2) = 3 + 2 = 5
    // P(3) = 5 + (-1) = 4
    // P(4) = 4 + 6 = 10
    // P(5) = 10 + 5 = 15
    // P(6) = 15 + 4 = 19
    // P(7) = 19 + (-3) = 16
    // P(8) = 16 + 2 = 18
    assert(fenwick_query(tree, 1) == 3);
    assert(fenwick_query(tree, 2) == 5);
    assert(fenwick_query(tree, 3) == 4);
    assert(fenwick_query(tree, 4) == 10);
    assert(fenwick_query(tree, 5) == 15);
    assert(fenwick_query(tree, 6) == 19);
    assert(fenwick_query(tree, 7) == 16);
    assert(fenwick_query(tree, 8) == 18);

    // Range sum queries:
    // sum[2..5] = data[1] + data[2] + data[3] + data[4] = 2 + (-1) + 6 + 5 = 12
    // fenwick_range_query(2, 5) = P(5) - P(1) = 15 - 3 = 12
    assert(fenwick_range_query(tree, 2, 5) == 12);
    // sum[4..7] = 6 + 5 + 4 + (-3) = 12
    assert(fenwick_range_query(tree, 4, 7) == 12);
    // sum[3..3] = -1
    assert(fenwick_range_query(tree, 3, 3) == -1);

    // 3. Dynamic Point Updates
    // Add delta +4 to index 3 (data[2] was -1, now becomes 3)
    tree = fenwick_add(tree, 8, 3, 4);

    // After update:
    // P(1) = 3 (unchanged)
    // P(2) = 5 (unchanged)
    // P(3) = 4 + 4 = 8
    // P(4) = 10 + 4 = 14
    // P(8) = 18 + 4 = 22
    assert(fenwick_query(tree, 1) == 3);
    assert(fenwick_query(tree, 2) == 5);
    assert(fenwick_query(tree, 3) == 8);
    assert(fenwick_query(tree, 4) == 14);
    assert(fenwick_query(tree, 8) == 22);
    assert(fenwick_range_query(tree, 3, 3) == 3);
    assert(fenwick_range_query(tree, 2, 5) == 16);

    // 4. Single-element Base Case
    let single = [42];
    let single_tree = fenwick_build(single);
    assert(fenwick_query(single_tree, 1) == 42);
    assert(fenwick_range_query(single_tree, 1, 1) == 42);

    return 0;
}
