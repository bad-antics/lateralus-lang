// Rosetta Code: The Twelve Days of Christmas is too long; use Collatz conjecture
// https://rosettacode.org/wiki/Collatz_sequence
module examples.rosetta.collatz

import io

fn collatz_steps(n: int) -> int {
    let x = n
    let steps = 0
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        steps = steps + 1
    }
    return steps
}

@test
fn test_collatz() {
    assert_eq(collatz_steps(1), 0)
    assert_eq(collatz_steps(2), 1)
    assert_eq(collatz_steps(16), 4)
}

fn main() {
    print("collatz_steps(16) = " + str(collatz_steps(16)))
}

main()
