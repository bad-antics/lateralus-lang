// Rosetta Code · Palindrome detection · Lateralus
// Exact, case-insensitive, and letters-only comparators.

fn is_palindrome_exact(s: str) -> bool {
    let n = len(s)
    let i = 0
    while i < n / 2 {
        if slice(s, i, i + 1) != slice(s, n - 1 - i, n - i) { return false }
        i = i + 1
    }
    return true
}

fn keep_letters(s: str) -> str {
    let low = str_lower(s)
    let out = ""
    let i = 0
    while i < len(low) {
        let c = slice(low, i, i + 1)
        let o = ord(c)
        if o >= 97 {
            if o <= 122 { out = out + c }
        }
        i = i + 1
    }
    return out
}

fn is_palindrome_text(s: str) -> bool {
    return is_palindrome_exact(keep_letters(s))
}

fn main() {
    assert_eq(is_palindrome_exact("ingirumimusnocteetconsumimurigni"), true, "latin")
    assert_eq(is_palindrome_exact("abc"), false, "abc")
    assert_eq(is_palindrome_text("A man, a plan, a canal: Panama"), true, "panama")
    assert_eq(is_palindrome_text("Not a palindrome"), false, "negative")
    print("palindrome: all assertions passed")
}

main()
