// ===================================================================
// examples/statistics_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: API Gateway Latency Anomaly & Z-Score
// Distribution Analyzer (stdlib/statistics.ltl)
// ===================================================================

pub fn int_sqrt(x) {
    if x <= 0 { return 0 }
    let r = x
    let i = 0
    while i < 16 {
        r = (r + (x / r)) / 2
        i = i + 1
    }
    return r
}

pub fn calc_mean(arr, n) {
    let s = 0
    let i = 0
    while i < n {
        s = s + arr[i]
        i = i + 1
    }
    return s / n
}

pub fn calc_variance(arr, n, mean_val) {
    let sq_sum = 0
    let i = 0
    while i < n {
        let diff = arr[i] - mean_val
        sq_sum = sq_sum + (diff * diff)
        i = i + 1
    }
    return sq_sum / n
}

pub fn main() {
    print("=== API Gateway Latency Distribution Statistics ===")

    // Classic textbook dataset: [2, 4, 4, 4, 5, 5, 7, 9] (ms)
    let samples = dict()
    samples[0] = 2; samples[1] = 4; samples[2] = 4; samples[3] = 4
    samples[4] = 5; samples[5] = 5; samples[6] = 7; samples[7] = 9
    let n = 8

    let mean_val = calc_mean(samples, n)
    let var_val = calc_variance(samples, n, mean_val)
    let std_val = int_sqrt(var_val)

    // Z-score of tail latency sample 9ms: (9 - 5) / 2 = +2 sigma
    let z_tail = (samples[7] - mean_val) / std_val

    assert(mean_val == 5, "Mean == 5")
    assert(var_val == 4, "Variance == 4")
    assert(std_val == 2, "StdDev == 2")
    assert(z_tail == 2, "9ms sample is exactly +2 sigma")

    print("Latency distribution mean=5ms, variance=4, stddev=2ms, tail Z-score=+2 verified!")
}
