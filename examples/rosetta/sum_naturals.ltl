// Rosetta Code: Sum of natural numbers
// https://rosettacode.org/wiki/Sum_of_a_list_of_numbers
module examples.rosetta.sum_naturals

import io

fn sum_to(n: int) -> int {
    let total = 0
    let i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

@test
fn test_sum() {
    assert_eq(sum_to(0), 0)
    assert_eq(sum_to(1), 1)
    assert_eq(sum_to(10), 55)
    assert_eq(sum_to(100), 5050)
}

fn main() {
    print("sum_to(100) = " + str(sum_to(100)))
}

main()
