// ===================================================================
// examples/cartesian_tree_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: Financial Price Trough Topology & Histogram
// Maximum Rectangular Sub-Span Analysis using Cartesian Tree.
// ===================================================================

pub fn build_cartesian_tree(arr, n) {
    let left = dict()
    let right = dict()
    let parent = dict()
    let i = 0
    while i < n {
        left[i] = -1
        right[i] = -1
        parent[i] = -1
        i = i + 1
    }

    let stack = dict()
    let top = 0

    i = 0
    while i < n {
        let last_popped = -1
        while top > 0 && arr[stack[top - 1]] > arr[i] {
            last_popped = stack[top - 1]
            top = top - 1
        }

        if last_popped != -1 {
            left[i] = last_popped
            parent[last_popped] = i
        }

        if top > 0 {
            let p = stack[top - 1]
            right[p] = i
            parent[i] = p
        }

        stack[top] = i
        top = top + 1
        i = i + 1
    }

    let root = -1
    if n > 0 {
        root = stack[0]
    }

    let tree = dict()
    tree["root"] = root
    tree["left"] = left
    tree["right"] = right
    tree["parent"] = parent
    return tree
}

pub fn main() {
    print("=== Quantitative Trading Price Series & Cartesian Tree RMQ ===")

    // Simulated 6-period intraday asset tick prices (normalized integer cents):
    // Minute 0: $2.50, Minute 1: $1.20, Minute 2: $4.50, Minute 3: $0.90, Minute 4: $3.80, Minute 5: $2.10
    let prices = dict()
    prices[0] = 250
    prices[1] = 120
    prices[2] = 450
    prices[3] = 90
    prices[4] = 380
    prices[5] = 210

    let n = 6
    print("Building Cartesian Tree over 6 intraday price periods...")
    let tree = build_cartesian_tree(prices, n)

    let root = tree["root"]
    print("Intraday global minimum price trough index (root of tree):")
    print(root)
    print("Minimum price in cents:")
    print(prices[root])

    // Verify root is Minute 3 (value 90 cents)
    assert(root == 3, "Minimum price trough occurs at minute 3 ($0.90)")
    assert(prices[root] == 90, "Minimum price is 90 cents")

    // In a Cartesian tree, the left subtree of root covers [0..root-1] (Minutes 0..2)
    // and the root of that left subtree is the minimum of [0..2]!
    let left_sub_root = tree["left"][root]
    print("Sub-period [0..2] minimum price index:")
    print(left_sub_root)
    print("Sub-period minimum price in cents:")
    print(prices[left_sub_root])
    assert(left_sub_root == 1, "Minimum of [0..2] is Minute 1 ($1.20)")
    assert(prices[left_sub_root] == 120, "Price at Minute 1 is 120 cents")

    // Similarly, the right subtree covers [root+1..n-1] (Minutes 4..5)
    let right_sub_root = tree["right"][root]
    print("Sub-period [4..5] minimum price index:")
    print(right_sub_root)
    print("Sub-period minimum price in cents:")
    print(prices[right_sub_root])
    assert(right_sub_root == 5, "Minimum of [4..5] is Minute 5 ($2.10)")
    assert(prices[right_sub_root] == 210, "Price at Minute 5 is 210 cents")

    print("Cartesian Tree RMQ topology and hierarchy validated successfully!")
}
