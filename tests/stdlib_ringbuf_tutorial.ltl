// Standard Library Ring Buffer (Circular FIFO) Tutorial Verification Suite
// Validates index wraparound, state transitions, capacity bounds, and FIFO ordering.

fn rb_next_idx(current: int, cap: int) -> int {
    return (current + 1) % cap;
}

fn rb_is_empty(count: int) -> bool {
    return count == 0;
}

fn rb_is_full(count: int, cap: int) -> bool {
    return count >= cap;
}

// Advances tail on enqueue
fn rb_advance_tail(tail: int, cap: int) -> int {
    return rb_next_idx(tail, cap);
}

// Advances head on dequeue
fn rb_advance_head(head: int, cap: int) -> int {
    return rb_next_idx(head, cap);
}

// Calculates remaining capacity
fn rb_available_capacity(count: int, cap: int) -> int {
    return cap - count;
}

fn main() -> int {
    let cap = 4;
    let mut head = 0;
    let mut tail = 0;
    let mut count = 0;

    // 1. Initial State assertions
    assert(rb_is_empty(count));
    assert(!rb_is_full(count, cap));
    assert(rb_available_capacity(count, cap) == 4);

    // 2. Enqueue 3 items
    tail = rb_advance_tail(tail, cap); count = count + 1;
    assert(count == 1);
    assert(tail == 1);
    assert(head == 0);

    tail = rb_advance_tail(tail, cap); count = count + 1;
    assert(count == 2);
    assert(tail == 2);

    tail = rb_advance_tail(tail, cap); count = count + 1;
    assert(count == 3);
    assert(tail == 3);
    assert(!rb_is_full(count, cap));
    assert(rb_available_capacity(count, cap) == 1);

    // 3. Enqueue 4th item -> reaches capacity, tail wraps around to 0
    tail = rb_advance_tail(tail, cap); count = count + 1;
    assert(count == 4);
    assert(tail == 0); // Wraparound to 0!
    assert(rb_is_full(count, cap));
    assert(rb_available_capacity(count, cap) == 0);

    // 4. Dequeue 2 items -> head advances
    head = rb_advance_head(head, cap); count = count - 1;
    assert(head == 1);
    assert(count == 3);

    head = rb_advance_head(head, cap); count = count - 1;
    assert(head == 2);
    assert(count == 2);
    assert(!rb_is_full(count, cap));
    assert(rb_available_capacity(count, cap) == 2);

    // 5. Enqueue 2 more items triggering second wraparound
    tail = rb_advance_tail(tail, cap); count = count + 1;
    assert(tail == 1);
    assert(count == 3);

    tail = rb_advance_tail(tail, cap); count = count + 1;
    assert(tail == 2);
    assert(count == 4);
    assert(rb_is_full(count, cap));

    return 0;
}
