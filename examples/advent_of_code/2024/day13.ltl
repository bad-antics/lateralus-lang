// Advent of Code 2024 · Day 13 · Claw Contraption
// Each machine: a*A + b*B = Prize, A costs 3 tokens, B costs 1.
// Solve the 2x2 system exactly with Cramer's rule; accept only non-negative
// integer solutions. Part 1 also requires a, b <= 100. Part 2 adds
// 10000000000000 to both prize coordinates (no 100-press cap).
// Sample -> 480 / 875318608908 (official sample answers).

let SAMPLE = "Button A: X+94, Y+34
Button B: X+22, Y+67
Prize: X=8400, Y=5400

Button A: X+26, Y+66
Button B: X+67, Y+21
Prize: X=12748, Y=12176

Button A: X+17, Y+86
Button B: X+84, Y+37
Prize: X=7870, Y=6450

Button A: X+69, Y+23
Button B: X+27, Y+71
Prize: X=18641, Y=10279"

// Parse the machines into a list of [ax, ay, bx, by, px, py].
fn parse(text: str) -> list {
    let machines = []
    let lines = str_split(text, "\n")
    let nums = []
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let clean = str_replace(line, "Button A: X+", "")
            clean = str_replace(clean, "Button B: X+", "")
            clean = str_replace(clean, "Prize: X=", "")
            clean = str_replace(clean, ", Y+", " ")
            clean = str_replace(clean, ", Y=", " ")
            let parts = str_split(clean, " ")
            nums = nums + [int(parts[0]), int(parts[1])]
        }
        i = i + 1
    }
    let j = 0
    while j < len(nums) {
        machines = machines + [[nums[j], nums[j + 1], nums[j + 2], nums[j + 3], nums[j + 4], nums[j + 5]]]
        j = j + 6
    }
    return machines
}

// Solve a*A + b*B = P. Returns [a, b], or [-1, -1] if there is no
// non-negative integer solution.
fn solve(ax: int, ay: int, bx: int, by: int, px: int, py: int) -> list {
    let det = ax * by - ay * bx
    if det == 0 { return [-1, -1] }
    let anum = px * by - py * bx
    let bnum = ax * py - ay * px
    if imod(anum, det) != 0 { return [-1, -1] }
    if imod(bnum, det) != 0 { return [-1, -1] }
    let a = idiv(anum, det)
    let b = idiv(bnum, det)
    if a < 0 { return [-1, -1] }
    if b < 0 { return [-1, -1] }
    return [a, b]
}

fn total_cost(text: str, offset: int, cap: int) -> int {
    let machines = parse(text)
    let total = 0
    let i = 0
    while i < len(machines) {
        let m = machines[i]
        let s = solve(m[0], m[1], m[2], m[3], m[4] + offset, m[5] + offset)
        if s[0] >= 0 {
            // cap < 0 means no cap (part 2).
            if cap < 0 || (s[0] <= cap && s[1] <= cap) {
                total = total + 3 * s[0] + s[1]
            }
        }
        i = i + 1
    }
    return total
}

fn part1(text: str) -> int {
    return total_cost(text, 0, 100)
}

fn part2(text: str) -> int {
    return total_cost(text, 10000000000000, -1)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 480)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 875318608908)
}

fn main() {
    print("Day 13 Part 1: " + str(part1(SAMPLE)))
    print("Day 13 Part 2: " + str(part2(SAMPLE)))
}

main()
