// ===================================================================
// examples/msgpack_tutorial.ltl
//
// Tutorial: High-Performance Binary Serialization with Lateralus
// stdlib/msgpack.ltl (MessagePack Specification).
//
// Demonstrates:
// 1. Packing nested maps, lists, integers, booleans, and strings.
// 2. Compact wire footprint compared to verbose text formats.
// 3. Decoding and stream offset tracking via `decode_at`.
// ===================================================================

import msgpack

pub fn main() {
    print("=== Lateralus MessagePack (msgpack.org) Tutorial ===")

    // 1. Construct complex telemetry payload
    let telemetry = {}
    telemetry["device_id"] = "sensor_alpha_01"
    telemetry["online"] = true
    telemetry["seq"] = 4096
    telemetry["readings"] = [21, 23, 22]

    print("Constructing telemetry packet...")

    // 2. Binary encode
    let packed_bytes = msgpack_encode(telemetry)
    print("Packed binary size: " + str(len(packed_bytes)) + " bytes")
    print("First 4 wire bytes: " + str(packed_bytes[0]) + ", " +
          str(packed_bytes[1]) + ", " + str(packed_bytes[2]) + ", " +
          str(packed_bytes[3]))

    // 3. Deserialize (decode)
    let decode_result = msgpack_decode(packed_bytes)
    let restored = decode_result[0]
    let consumed_bytes = decode_result[1]

    print("Consumed bytes during unpack: " + str(consumed_bytes))

    // 4. Validate unpacked fields
    if restored["device_id"] == "sensor_alpha_01" && restored["online"] == true {
        print("PASS: Top-level fields restored accurately")
    }

    if restored["seq"] == 4096 {
        print("PASS: Integer sequence number preserved")
    }

    let restored_readings = restored["readings"]
    if len(restored_readings) == 3 && restored_readings[1] == 23 {
        print("PASS: Nested array values matched byte-for-byte")
    }

    print("=== MessagePack tutorial demonstration completed successfully ===")
}
