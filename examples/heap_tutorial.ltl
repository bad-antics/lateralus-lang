// ===================================================================
// examples/heap_tutorial.ltl — stdlib/heap.ltl tutorial companion
// Runnable tour of the binary min-heap: push/pop/peek, sift helpers,
// push_pop/replace shortcuts, n_smallest, merge, and heap_sort.
// Inlined from stdlib/heap.ltl (import math -> local min; for -> while;
// _parent int() workaround for the float-division bug).
// ===================================================================

fn imin(a: int, b: int) -> int { if a < b { return a } return b }
fn iparent(i: int) -> int { return int((i - 1) / 2) }
fn ileft(i: int) -> int { return 2 * i + 1 }
fn iright(i: int) -> int { return 2 * i + 2 }

fn sift_up(h: list, i: int) -> list {
    while i > 0 {
        let p = iparent(i)
        if h[i] < h[p] {
            let tmp = h[i]
            h[i] = h[p]
            h[p] = tmp
            i = p
        } else {
            return h
        }
    }
    return h
}

fn sift_down(h: list, i: int) -> list {
    let n = len(h)
    let go = true
    while go {
        let smallest = i
        let l = ileft(i)
        let r = iright(i)
        if l < n && h[l] < h[smallest] { smallest = l }
        if r < n && h[r] < h[smallest] { smallest = r }
        if smallest == i { return h }
        let tmp = h[i]
        h[i] = h[smallest]
        h[smallest] = tmp
        i = smallest
    }
    return h
}

fn hpush(h: list, value) -> list {
    let heap = h + [value]
    return sift_up(heap, len(heap) - 1)
}

fn hpop(h: list) -> list {
    if len(h) == 0 { return [-1, h] }
    if len(h) == 1 { return [h[0], []] }
    let min_val = h[0]
    let last = h[len(h) - 1]
    let heap = slice(h, 0, len(h) - 1)
    heap[0] = last
    heap = sift_down(heap, 0)
    return [min_val, heap]
}

fn hpeek(h: list) -> int {
    if len(h) == 0 { return -1 }
    return h[0]
}

fn hfrom(items: list) -> list {
    let h = []
    let i = 0
    while i < len(items) { h = hpush(h, items[i]); i = i + 1 }
    return h
}

fn push_pop(h: list, value) -> list {
    if len(h) == 0 { return [value, h] }
    if value <= h[0] { return [value, h] }
    let old_min = h[0]
    h[0] = value
    h = sift_down(h, 0)
    return [old_min, h]
}

fn hreplace(h: list, value) -> list {
    if len(h) == 0 { return [-1, [value]] }
    let old_min = h[0]
    h[0] = value
    h = sift_down(h, 0)
    return [old_min, h]
}

fn n_smallest(h: list, n: int) -> list {
    let result = []
    let heap = h
    let count = imin(n, len(heap))
    let i = 0
    while i < count {
        let pair = hpop(heap)
        result = result + [pair[0]]
        heap = pair[1]
        i = i + 1
    }
    return result
}

fn hmerge(h1: list, h2: list) -> list {
    let result = h1
    let i = 0
    while i < len(h2) { result = hpush(result, h2[i]); i = i + 1 }
    return result
}

fn heap_sort(items: list) -> list {
    let h = hfrom(items)
    let sorted = []
    while len(h) > 0 {
        let pair = hpop(h)
        sorted = sorted + [pair[0]]
        h = pair[1]
    }
    return sorted
}

fn show(xs: list) -> str {
    let s = ""
    let i = 0
    while i < len(xs) {
        if i > 0 { s = s + "," }
        s = s + to_str(xs[i])
        i = i + 1
    }
    return s
}

fn main() {
    println("=== LATERALUS STDLIB HEAP TUTORIAL ===")

    println("STEP 1 build + peek:")
    let h = hfrom([5, 2, 8, 1, 9, 3])
    println("  heap array=" + show(h))
    println("  peek=" + str(hpeek(h)) + " size=" + str(len(h)))

    println("STEP 2 pop order (sorted extraction):")
    let order = []
    let hh = h
    while len(hh) > 0 {
        let pair = hpop(hh)
        order = order + [pair[0]]
        hh = pair[1]
    }
    println("  pop order=" + show(order))

    println("STEP 3 push_pop / replace:")
    let h2 = hfrom([10, 20, 30])
    let pp = push_pop(h2, 5)
    println("  push_pop(5) -> popped=" + str(pp[0]) + " heap0=" + str(pp[1][0]))
    let pp2 = push_pop(h2, 99)
    println("  push_pop(99) -> popped=" + str(pp2[0]))
    let rp = hreplace(hfrom([4, 8, 15]), 1)
    println("  replace(1) -> old_min=" + str(rp[0]) + " new peek=" + str(hpeek(rp[1])))

    println("STEP 4 n_smallest + merge:")
    let h3 = hfrom([42, 7, 13, 99, 23, 1])
    println("  n_smallest(3)=" + show(n_smallest(h3, 3)))
    let hm = hmerge(hfrom([1, 5]), hfrom([3, 2]))
    println("  merged peek=" + str(hpeek(hm)) + " size=" + str(len(hm)))

    println("STEP 5 heap_sort:")
    println("  sort([9,4,7,1,3])=" + show(heap_sort([9, 4, 7, 1, 3])))
    println("PINNED_VECTORS: heap=[1,2,3,5,9,8] peek=1 poporder=1,2,3,5,8,9 pp5-popped=5-heap0=10 pp99=10 replace-oldmin=4 newsort=1,3,4,7,9 nsmallest=1,7,13 mergesize=4 sort=1,3,4,7,9")
}

main()
