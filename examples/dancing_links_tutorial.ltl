// ===================================================================
// examples/dancing_links_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: Cloud Infrastructure Exact Task-Bundle
// Partitioning & Conflict-Free Hardware Allocation via DLX Algorithm X.
// ===================================================================

pub fn new_dlx(num_cols) {
    let dlx = dict()
    dlx["nodes"] = dict()
    dlx["sz"] = num_cols + 1
    dlx["num_cols"] = num_cols

    let root = dict()
    root["left"] = num_cols
    root["right"] = 1
    root["up"] = 0
    root["down"] = 0
    root["col"] = 0
    root["row"] = 0
    root["size"] = 0
    dlx["nodes"][0] = root

    let c = 1
    while c <= num_cols {
        let col_node = dict()
        col_node["left"] = c - 1
        col_node["right"] = c + 1
        if c == num_cols {
            col_node["right"] = 0
        }
        col_node["up"] = c
        col_node["down"] = c
        col_node["col"] = c
        col_node["row"] = 0
        col_node["size"] = 0
        dlx["nodes"][c] = col_node
        c = c + 1
    }
    return dlx
}

pub fn dlx_add_row(dlx, row_id, cols_list, num_elems) {
    if num_elems <= 0 {
        return true
    }
    let first_id = -1
    let k = 0
    while k < num_elems {
        let c = cols_list[k]
        let new_id = dlx["sz"]
        dlx["sz"] = new_id + 1

        let col_head = dlx["nodes"][c]
        let up_id = col_head["up"]

        let node = dict()
        node["col"] = c
        node["row"] = row_id
        node["down"] = c
        node["up"] = up_id

        dlx["nodes"][up_id]["down"] = new_id
        col_head["up"] = new_id
        col_head["size"] = col_head["size"] + 1

        if first_id == -1 {
            first_id = new_id
            node["left"] = new_id
            node["right"] = new_id
        } else {
            let left_id = dlx["nodes"][first_id]["left"]
            node["left"] = left_id
            node["right"] = first_id
            dlx["nodes"][left_id]["right"] = new_id
            dlx["nodes"][first_id]["left"] = new_id
        }

        dlx["nodes"][new_id] = node
        k = k + 1
    }
    return true
}

pub fn dlx_cover(dlx, c) {
    let c_node = dlx["nodes"][c]
    let r_id = c_node["right"]
    let l_id = c_node["left"]
    dlx["nodes"][r_id]["left"] = l_id
    dlx["nodes"][l_id]["right"] = r_id

    let i = c_node["down"]
    while i != c {
        let i_node = dlx["nodes"][i]
        let j = i_node["right"]
        while j != i {
            let j_node = dlx["nodes"][j]
            let u_id = j_node["up"]
            let d_id = j_node["down"]
            dlx["nodes"][d_id]["up"] = u_id
            dlx["nodes"][u_id]["down"] = d_id
            let col_id = j_node["col"]
            dlx["nodes"][col_id]["size"] = dlx["nodes"][col_id]["size"] - 1
            j = j_node["right"]
        }
        i = i_node["down"]
    }
    return true
}

pub fn dlx_uncover(dlx, c) {
    let c_node = dlx["nodes"][c]
    let i = c_node["up"]
    while i != c {
        let i_node = dlx["nodes"][i]
        let j = i_node["left"]
        while j != i {
            let j_node = dlx["nodes"][j]
            let col_id = j_node["col"]
            dlx["nodes"][col_id]["size"] = dlx["nodes"][col_id]["size"] + 1
            let u_id = j_node["up"]
            let d_id = j_node["down"]
            dlx["nodes"][d_id]["up"] = j
            dlx["nodes"][u_id]["down"] = j
            j = j_node["left"]
        }
        i = i_node["up"]
    }
    let r_id = c_node["right"]
    let l_id = c_node["left"]
    dlx["nodes"][r_id]["left"] = c
    dlx["nodes"][l_id]["right"] = c
    return true
}

pub fn dlx_solve(dlx, solution, depth) {
    if dlx["nodes"][0]["right"] == 0 {
        solution["depth"] = depth
        return true
    }

    let best_c = dlx["nodes"][0]["right"]
    let min_size = dlx["nodes"][best_c]["size"]
    let curr_c = dlx["nodes"][best_c]["right"]
    while curr_c != 0 {
        let curr_sz = dlx["nodes"][curr_c]["size"]
        if curr_sz < min_size {
            min_size = curr_sz
            best_c = curr_c
        }
        curr_c = dlx["nodes"][curr_c]["right"]
    }

    if min_size == 0 {
        return false
    }

    dlx_cover(dlx, best_c)

    let r = dlx["nodes"][best_c]["down"]
    while r != best_c {
        solution[depth] = dlx["nodes"][r]["row"]

        let j = dlx["nodes"][r]["right"]
        while j != r {
            dlx_cover(dlx, dlx["nodes"][j]["col"])
            j = dlx["nodes"][j]["right"]
        }

        if dlx_solve(dlx, solution, depth + 1) {
            return true
        }

        let back_j = dlx["nodes"][r]["left"]
        while back_j != r {
            dlx_uncover(dlx, dlx["nodes"][back_j]["col"])
            back_j = dlx["nodes"][back_j]["left"]
        }

        r = dlx["nodes"][r]["down"]
    }

    dlx_uncover(dlx, best_c)
    return false
}

pub fn run_cloud_resource_scheduler() {
    // 5 Hardware Constraint Slices:
    // Col 1: CPU_A
    // Col 2: CPU_B
    // Col 3: GPU_ACCELERATOR
    // Col 4: HIGH_BANDWIDTH_RAM
    // Col 5: FAST_NVME_STORAGE
    let scheduler = new_dlx(5)

    // Job Profile 101 (Database Engine): CPU_A (1) + HIGH_BANDWIDTH_RAM (4)
    let p101 = dict()
    p101[0] = 1
    p101[1] = 4
    dlx_add_row(scheduler, 101, p101, 2)

    // Job Profile 102 (AI Deep Learning Inference): GPU_ACCELERATOR (3) + FAST_NVME_STORAGE (5)
    let p102 = dict()
    p102[0] = 3
    p102[1] = 5
    dlx_add_row(scheduler, 102, p102, 2)

    // Job Profile 103 (Telemetry Microservice): CPU_B (2)
    let p103 = dict()
    p103[0] = 2
    dlx_add_row(scheduler, 103, p103, 1)

    // Job Profile 104 (Conflicting Heavy Monolith): CPU_A (1) + GPU_ACCELERATOR (3)
    let p104 = dict()
    p104[0] = 1
    p104[1] = 3
    dlx_add_row(scheduler, 104, p104, 2)

    let sol = dict()
    let success = dlx_solve(scheduler, sol, 0)

    let report = dict()
    report["success"] = success
    report["assigned_jobs_count"] = sol["depth"]
    report["job_0"] = sol[0]
    report["job_1"] = sol[1]
    report["job_2"] = sol[2]
    return report
}
