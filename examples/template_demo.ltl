// examples/template_demo.ltl - stdlib.template tutorial

import stdlib.template

fn main() {
    let values = {}
    values["name"] = "Ada"
    values["language"] = "Lateralus"
    let greeting = stdlib.template.render("Hello, <<name>>! Welcome to <<language>>.", values)
    let with_missing = stdlib.template.render("Hello, <<name>>! Role: <<role>>.", values)
    let with_default = stdlib.template.render_default("Hello, <<name>>! Role: <<role>>.", values, "guest")

    println(greeting)
    println(with_missing)
    println(with_default)
}

main()
