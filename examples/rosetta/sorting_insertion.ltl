// Rosetta Code: Insertion sort
fn ins_sort(a: list) -> list {
    let mut arr = a
    let mut i = 1
    while i < len(arr) {
        let key = arr[i]
        let mut j = i - 1
        while j >= 0 && arr[j] > key {
            arr[j + 1] = arr[j]
            j = j - 1
        }
        arr[j + 1] = key
        i = i + 1
    }
    return arr
}
println(str(ins_sort([5, 2, 9, 1])))
if ins_sort([5, 2, 9, 1]) == [1, 2, 5, 9] { println("OK") } else { println("FAIL") }
