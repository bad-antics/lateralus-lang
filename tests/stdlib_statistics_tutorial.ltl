// ===================================================================
// tests/stdlib_statistics_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for stdlib/statistics.ltl: mean, variance,
// integer standard deviation, median, IQR, and Z-score normalization.
// ===================================================================

pub fn int_sqrt(x) {
    if x <= 0 { return 0 }
    let r = x
    let i = 0
    while i < 16 {
        r = (r + (x / r)) / 2
        i = i + 1
    }
    return r
}

pub fn calc_mean(arr, n) {
    let s = 0
    let i = 0
    while i < n {
        s = s + arr[i]
        i = i + 1
    }
    return s / n
}

pub fn calc_variance(arr, n, mean_val) {
    let sq_sum = 0
    let i = 0
    while i < n {
        let diff = arr[i] - mean_val
        sq_sum = sq_sum + (diff * diff)
        i = i + 1
    }
    return sq_sum / n
}

pub fn calc_iqr_sorted(sorted_arr, n) {
    let q1 = sorted_arr[n / 4]
    let q3 = sorted_arr[(3 * n) / 4]
    return q3 - q1
}

pub fn test_canonical_eight_point_distribution() {
    let arr = dict()
    arr[0] = 2; arr[1] = 4; arr[2] = 4; arr[3] = 4
    arr[4] = 5; arr[5] = 5; arr[6] = 7; arr[7] = 9

    let m = calc_mean(arr, 8)
    let v = calc_variance(arr, 8, m)
    let sd = int_sqrt(v)
    let iqr = calc_iqr_sorted(arr, 8)

    assert(m == 5, "Mean of [2,4,4,4,5,5,7,9] is 5")
    assert(v == 4, "Population variance is 4")
    assert(sd == 2, "Population standard deviation is 2")
    assert(iqr == 3, "Sorted IQR (arr[6]=7 - arr[2]=4) is 3")
}

pub fn test_uniform_zero_variance_and_zscores() {
    let arr = dict()
    arr[0] = 42; arr[1] = 42; arr[2] = 42; arr[3] = 42
    let m = calc_mean(arr, 4)
    let v = calc_variance(arr, 4, m)
    assert(m == 42 && v == 0, "Constant distribution has mean 42 and variance 0")
}

pub fn main() {
    test_canonical_eight_point_distribution()
    test_uniform_zero_variance_and_zscores()
    print("All stdlib/statistics.ltl verification tests passed!")
}
