// Advent of Code 2024 · Day 9 · Disk Fragmenter
// Part 1: compact one block at a time from the right into the leftmost free space.
// Part 2: move whole files, highest id first, into the leftmost free span that fits.
// Self-verifying with @test blocks; sample from the AoC statement.

let SAMPLE = "2333133121414131402"

fn digit_at(s: str, i: int) -> int {
    return int(slice(s, i, i + 1))
}

// Build the disk as a list of file ids, -1 for free space.
fn expand(s: str) -> list {
    let disk = []
    let i = 0
    while i < len(s) {
        let size = digit_at(s, i)
        let id = -1
        if i % 2 == 0 { id = int(i / 2) }
        let k = 0
        while k < size {
            disk = disk + [id]
            k = k + 1
        }
        i = i + 1
    }
    return disk
}

fn checksum(disk: list) -> int {
    let total = 0
    let i = 0
    while i < len(disk) {
        if disk[i] >= 0 { total = total + i * int(disk[i]) }
        i = i + 1
    }
    return total
}

fn part1(s: str) -> int {
    let disk = expand(s)
    let l = 0
    let r = len(disk) - 1
    while l < r {
        if disk[l] >= 0 {
            l = l + 1
        } else if disk[r] < 0 {
            r = r - 1
        } else {
            disk[l] = disk[r]
            disk[r] = -1
            l = l + 1
            r = r - 1
        }
    }
    return checksum(disk)
}

fn part2(s: str) -> int {
    let disk = expand(s)
    let maxId = -1
    for v in disk { if v > maxId { maxId = v } }
    let id = maxId
    while id >= 0 {
        // locate the run for this id
        let start = -1
        let size = 0
        let i = 0
        while i < len(disk) {
            if disk[i] == id { start = i; i = len(disk) }
            i = i + 1
        }
        if start >= 0 {
            let j = start
            while j < len(disk) && disk[j] == id { size = size + 1; j = j + 1 }
            // find the leftmost free span before start that fits
            let freeStart = -1
            let k = 0
            while k < start && freeStart < 0 {
                if disk[k] < 0 {
                    let run = 0
                    let m = k
                    while m < start && disk[m] < 0 { run = run + 1; m = m + 1 }
                    if run >= size { freeStart = k }
                    k = m
                } else {
                    k = k + 1
                }
            }
            if freeStart >= 0 {
                let t = 0
                while t < size {
                    disk[freeStart + t] = id
                    disk[start + t] = -1
                    t = t + 1
                }
            }
        }
        id = id - 1
    }
    return checksum(disk)
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 1928)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 2858)
}

fn main() {
    print("Day 9 Part 1: " + str(part1(SAMPLE)))
    print("Day 9 Part 2: " + str(part2(SAMPLE)))
}

main()
