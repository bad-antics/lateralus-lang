// ===================================================================
// tests/stdlib_bipartite_matching_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for the Maximum Bipartite Matching algorithm,
// alternating augmenting paths, and Berge's Lemma.
// ===================================================================

fn init_adj(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

fn add_bipartite_edge(adj, u, v) {
    adj[u] = push(adj[u], v)
}

fn dfs_augment(u, adj, match_r, visited) {
    let neighbors = adj[u]
    let i = 0
    while i < len(neighbors) {
        let v = neighbors[i]
        if not visited[v] {
            visited[v] = true
            if match_r[v] == -1 or dfs_augment(match_r[v], adj, match_r, visited) {
                match_r[v] = u
                return true
            }
        }
        i = i + 1
    }
    return false
}

pub fn max_bipartite_matching(n1, n2, adj) {
    let match_r = dict()
    let j = 0
    while j < n2 {
        match_r[j] = -1
        j = j + 1
    }

    let match_count = 0
    let u = 0
    while u < n1 {
        let visited = dict()
        let k = 0
        while k < n2 {
            visited[k] = false
            k = k + 1
        }

        if dfs_augment(u, adj, match_r, visited) {
            match_count = match_count + 1
        }
        u = u + 1
    }

    let match_l = dict()
    let l_idx = 0
    while l_idx < n1 {
        match_l[l_idx] = -1
        l_idx = l_idx + 1
    }

    let r_idx = 0
    while r_idx < n2 {
        let matched_u = match_r[r_idx]
        if matched_u != -1 {
            match_l[matched_u] = r_idx
        }
        r_idx = r_idx + 1
    }

    let res = dict()
    res["matching_size"] = match_count
    res["match_l"] = match_l
    res["match_r"] = match_r
    return res
}

pub fn test_bipartite_perfect_matching() -> bool {
    let n1 = 3
    let n2 = 3
    let adj = init_adj(n1)

    add_bipartite_edge(adj, 0, 0)
    add_bipartite_edge(adj, 0, 1)
    add_bipartite_edge(adj, 1, 1)
    add_bipartite_edge(adj, 1, 2)
    add_bipartite_edge(adj, 2, 0)
    add_bipartite_edge(adj, 2, 2)

    let result = max_bipartite_matching(n1, n2, adj)
    if result["matching_size"] != 3 {
        return false
    }

    return true
}

pub fn test_bipartite_bottleneck() -> bool {
    let n1 = 3
    let n2 = 3
    let adj = init_adj(n1)

    add_bipartite_edge(adj, 0, 0)
    add_bipartite_edge(adj, 1, 0)
    add_bipartite_edge(adj, 2, 0)
    add_bipartite_edge(adj, 2, 1)

    let result = max_bipartite_matching(n1, n2, adj)
    if result["matching_size"] != 2 {
        return false
    }

    return true
}

pub fn test_bipartite_disconnected() -> bool {
    let n1 = 4
    let n2 = 4
    let adj = init_adj(n1)

    add_bipartite_edge(adj, 0, 0)
    add_bipartite_edge(adj, 1, 1)

    let result = max_bipartite_matching(n1, n2, adj)
    if result["matching_size"] != 2 {
        return false
    }

    return true
}

pub fn test_bipartite_complete_dense_2x2() -> bool {
    let n1 = 2
    let n2 = 2
    let adj = init_adj(n1)

    add_bipartite_edge(adj, 0, 0)
    add_bipartite_edge(adj, 0, 1)
    add_bipartite_edge(adj, 1, 0)
    add_bipartite_edge(adj, 1, 1)

    let result = max_bipartite_matching(n1, n2, adj)
    if result["matching_size"] != 2 {
        return false
    }

    return true
}

pub fn test_bipartite_single_edge() -> bool {
    let n1 = 1
    let n2 = 1
    let adj = init_adj(n1)

    add_bipartite_edge(adj, 0, 0)

    let result = max_bipartite_matching(n1, n2, adj)
    if result["matching_size"] != 1 {
        return false
    }
    if result["match_l"][0] != 0 or result["match_r"][0] != 0 {
        return false
    }

    return true
}
