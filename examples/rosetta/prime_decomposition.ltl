// Rosetta Code · Prime decomposition · Lateralus

fn factorize(n: int) -> list {
    let x = n
    let out = []
    let p = 2
    while p * p <= x {
        while imod(x, p) == 0 {
            out = out + [p]
            x = idiv(x, p)
        }
        p = p + 1
    }
    if x > 1 { out = out + [x] }
    return out
}

fn main() {
    assert_eq(factorize(1), [], "1")
    assert_eq(factorize(12), [2, 2, 3], "12")
    assert_eq(factorize(97), [97], "prime")
    assert_eq(factorize(123456), [2, 2, 2, 2, 2, 2, 3, 643], "123456")
    print("factorize(360) = " + str(factorize(360)))
}

main()
