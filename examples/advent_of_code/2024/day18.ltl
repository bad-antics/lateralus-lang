// Advent of Code 2024 · Day 18 · RAM Run
// Bytes fall into a memory grid, blocking paths.
// Part 1: BFS shortest path after first N bytes fall. (sample: 12 bytes in 7x7)
// Part 2: first byte that makes the exit unreachable.

let SAMPLE = "5,4
4,2
4,5
3,0
2,1
6,3
2,4
1,5
0,6
3,3
2,6
5,1
1,2
5,5
2,5
6,5
1,4
0,4
6,4
1,1
6,1
1,0
0,5
1,6
2,0"

// Sample: 7x7 grid, first 12 bytes
let SAMPLE_SIZE = 7
let SAMPLE_BYTES = 12

fn parse_bytes(text: str) -> list {
    let lines = str_split(text, "\n")
    let result = []
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let parts = str_split(line, ",")
            result = result + [[int(str_trim(parts[0])), int(str_trim(parts[1]))]]
        }
        i = i + 1
    }
    return result
}

fn bfs_shortest(blocked: map, size: int) -> int {
    // BFS from (0,0) to (size-1, size-1)
    if contains(blocked, "0,0") { return -1 }
    let goal = str(size - 1) + "," + str(size - 1)
    let queue = [[0, 0, 0]]  // [r, c, dist]
    let visited = {}
    visited["0,0"] = true

    while len(queue) > 0 {
        let cur = queue[0]
        queue = queue[1:]
        let r = cur[0]
        let c = cur[1]
        let d = cur[2]
        let key = str(r) + "," + str(c)
        if key == goal { return d }
        let neighbors = [[r-1,c],[r+1,c],[r,c-1],[r,c+1]]
        let i = 0
        while i < len(neighbors) {
            let nr = neighbors[i][0]
            let nc = neighbors[i][1]
            if nr >= 0 && nr < size && nc >= 0 && nc < size {
                let nk = str(nr) + "," + str(nc)
                if !contains(visited, nk) && !contains(blocked, nk) {
                    visited[nk] = true
                    queue = queue + [[nr, nc, d + 1]]
                }
            }
            i = i + 1
        }
    }
    return -1
}

fn part1_sh(text: str, size: int, n_bytes: int) -> int {
    let bytes = parse_bytes(text)
    let blocked = {}
    let i = 0
    while i < n_bytes && i < len(bytes) {
        let b = bytes[i]
        blocked[str(b[1]) + "," + str(b[0])] = true  // row=y, col=x
        i = i + 1
    }
    return bfs_shortest(blocked, size)
}

fn part1(text: str) -> int {
    return part1_sh(text, SAMPLE_SIZE, SAMPLE_BYTES)
}

fn part2_sh(text: str, size: int) -> str {
    let bytes = parse_bytes(text)
    let blocked = {}
    let i = 0
    while i < len(bytes) {
        let b = bytes[i]
        blocked[str(b[1]) + "," + str(b[0])] = true
        if bfs_shortest(blocked, size) < 0 {
            return str(b[0]) + "," + str(b[1])
        }
        i = i + 1
    }
    return "-1,-1"
}

fn part2(text: str) -> str {
    return part2_sh(text, SAMPLE_SIZE)
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 22)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), "6,1")
}

fn main() {
    print("Day 18 Part 1: " + str(part1(SAMPLE)))
    print("Day 18 Part 2: " + part2(SAMPLE))
}

main()
