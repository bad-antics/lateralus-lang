// Advent of Code 2024 · Day 5 · Print Queue
// Part 1: sum the middle page of every update that already obeys the X|Y ordering rules.
// Part 2: reorder the incorrect updates with those rules and sum their middle pages.

let SAMPLE = "47|53
97|13
97|61
97|47
75|29
61|13
75|53
29|13
97|29
53|29
61|53
97|53
61|29
47|13
75|47
97|75
47|61
75|61
47|29
75|13
53|13

75,47,61,53,29
97,61,53,29,13
75,29,13
75,97,47,61,53
61,13,29
97,13,75,29,47"

// Returns [rules, updates]. Rules are kept as their raw "X|Y" strings in a set,
// so "must a come before b?" is just contains(rules, a + "|" + b).
fn parse(text: str) -> list {
    let rules = set()
    let updates = []
    for raw in str_split(text, "\n") {
        let line = str_trim(raw)
        if str_contains(line, "|") {
            rules.add(line)
        } else if len(line) > 0 {
            updates.append(str_split(line, ","))
        }
    }
    return [rules, updates]
}

fn before(rules: set, a: str, b: str) -> bool {
    return contains(rules, a + "|" + b)
}

// An update is in order when no later page is required to precede an earlier one.
fn in_order(rules: set, pages: list) -> bool {
    for i in range(0, len(pages)) {
        for j in range(i + 1, len(pages)) {
            if before(rules, pages[j], pages[i]) { return false }
        }
    }
    return true
}

// Insertion sort using the rules as the comparator (updates are short).
fn reorder(rules: set, pages: list) -> list {
    let out = []
    for p in pages {
        out.append(p)
        let k = len(out) - 1
        while k > 0 && before(rules, out[k], out[k - 1]) {
            let tmp = out[k]
            out[k] = out[k - 1]
            out[k - 1] = tmp
            k = k - 1
        }
    }
    return out
}

fn middle(pages: list) -> int {
    return int(pages[idiv(len(pages), 2)])
}

fn part1(text: str) -> int {
    let p = parse(text)
    let total = 0
    for pages in p[1] {
        if in_order(p[0], pages) { total = total + middle(pages) }
    }
    return total
}

fn part2(text: str) -> int {
    let p = parse(text)
    let total = 0
    for pages in p[1] {
        if !in_order(p[0], pages) { total = total + middle(reorder(p[0], pages)) }
    }
    return total
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 143)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 123)
}

fn main() {
    print("Day 5 Part 1: " + str(part1(SAMPLE)))
    print("Day 5 Part 2: " + str(part2(SAMPLE)))
}

main()
