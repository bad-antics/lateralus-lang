// ===================================================================
// Lateralus Example: stdlib.algorithms — Sorting, Search & Number Theory
// -------------------------------------------------------------------
// Practical demonstration of divide-and-conquer algorithms, binary
// search on sorted sequences, list transformations, and prime sieves.
// ===================================================================

import algorithms

fn main() {
    println("=== Standard Algorithms Tour ===")

    // 1. Sorting with Merge Sort
    let unsorted = [64, 34, 25, 12, 22, 11, 90]
    let sorted_items = merge_sort(unsorted)
    println("[1] Merge Sort:")
    println("  Original: " + str(unsorted))
    println("  Sorted:   " + str(sorted_items))

    // 2. Binary Search on Sorted Collections
    println("\n[2] Binary Search (Requires Sorted Array):")
    let target = 25
    let index = binary_search(sorted_items, target)
    println("  Found target " + str(target) + " at index: " + str(index))
    let missing_index = binary_search(sorted_items, 999)
    println("  Search for missing 999 returns: " + str(missing_index))

    // 3. Array Utilities: Unique & Chunking
    println("\n[3] List Operations:")
    let duplicates = [1, 2, 2, 3, 4, 4, 4, 5]
    println("  Deduplicated: " + str(unique(duplicates)))
    let chunks = chunk(sorted_items, 3)
    println("  Chunked (size 3): " + str(chunks))

    // 4. Number Theory & Primes
    println("\n[4] Number Theory:")
    let primes = primes_up_to(30)
    println("  Primes <= 30: " + str(primes))
    println("  GCD(48, 18): " + str(gcd(48, 18)))
    println("  LCM(12, 15): " + str(lcm(12, 15)))
    println("  Fibonacci(7): " + str(fibonacci_sequence(7)))
}

main()
