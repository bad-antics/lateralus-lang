// ===================================================================
// tests/stdlib_parsec_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for stdlib/parsec.ltl: ordered choice (|),
// concatenated sequence (&), Kleene star (*), and backtracking.
// ===================================================================

pub fn parse_choice(tokens, n, pos, tok_a, tok_b) {
    if pos >= n { return -1 }
    if (tokens[pos] == tok_a) || (tokens[pos] == tok_b) {
        return pos + 1
    }
    return -1
}

pub fn parse_sequence2(tokens, n, pos, tok_first, tok_second) {
    if (pos + 1) >= n { return -1 }
    if (tokens[pos] == tok_first) && (tokens[pos + 1] == tok_second) {
        return pos + 2
    }
    return -1
}

pub fn parse_many(tokens, n, pos, target_tok) {
    let cur = pos
    while (cur < n) && (tokens[cur] == target_tok) {
        cur = cur + 1
    }
    return cur
}

pub fn test_choice_and_sequence_combinators() {
    let toks = dict()
    toks[0] = 10; toks[1] = 20; toks[2] = 30

    assert(parse_choice(toks, 3, 0, 10, 99) == 1, "First branch of choice matches")
    assert(parse_choice(toks, 3, 0, 99, 10) == 1, "Second branch of choice matches")
    assert(parse_choice(toks, 3, 0, 88, 99) == -1, "Neither branch matches -> -1")

    assert(parse_sequence2(toks, 3, 1, 20, 30) == 3, "Sequence (20, 30) matches at pos 1")
    assert(parse_sequence2(toks, 3, 1, 20, 99) == -1, "Partial sequence fails cleanly")
}

pub fn test_kleene_many_combinator() {
    let toks = dict()
    toks[0] = 7; toks[1] = 7; toks[2] = 7; toks[3] = 99

    assert(parse_many(toks, 4, 0, 7) == 3, "Consumes three 7 tokens")
    assert(parse_many(toks, 4, 0, 5) == 0, "Zero occurrences succeeds at pos 0")
}

pub fn main() {
    test_choice_and_sequence_combinators()
    test_kleene_many_combinator()
    print("All stdlib/parsec.ltl verification tests passed!")
}
