// Lateralus Standard Library Example: Prefix Trie Route Matching
// Demonstrates fast API endpoint grouping and prefix route dispatch.

fn route_insert(routes: dict, prefixes: dict, path: string) -> int {
    routes[path] = 1;
    let mut i = 1;
    while i <= len(path) {
        let pref = slice(path, 0, i);
        let mut cnt = 0;
        if contains(prefixes, pref) {
            cnt = prefixes[pref];
        }
        prefixes[pref] = cnt + 1;
        i = i + 1;
    }
    return 0;
}

fn main() -> int {
    println("=== Lateralus Prefix Trie API Gateway Router Demo ===");

    let mut route_table = {};
    let mut prefix_tree = {};

    // Register active API endpoints
    route_insert(route_table, prefix_tree, "/api/v1/users");
    route_insert(route_table, prefix_tree, "/api/v1/auth");
    route_insert(route_table, prefix_tree, "/api/v1/tokens");
    route_insert(route_table, prefix_tree, "/api/v2/orders");
    route_insert(route_table, prefix_tree, "/healthz");

    println("Registered 5 endpoints across /api/v1, /api/v2, and system health.");

    // Query 1: Validate routing for API v1 group
    assert(contains(prefix_tree, "/api/v1"));
    let v1_route_count = prefix_tree["/api/v1"];
    println("Endpoints matched under '/api/v1': " + str(v1_route_count));
    assert(v1_route_count == 3);

    // Query 2: Direct hit on exact endpoint
    assert(contains(route_table, "/api/v1/auth"));
    println("Exact Route Matched: /api/v1/auth -> AuthenticateHandler");

    // Query 3: Non-existent route rejection
    assert(!contains(route_table, "/api/v1/unknown"));
    println("Unregistered Route Rejected: /api/v1/unknown -> 404 NotFound");

    // Query 4: API v2 group verification
    assert(contains(prefix_tree, "/api/v2"));
    assert(prefix_tree["/api/v2"] == 1);
    println("Endpoints matched under '/api/v2': 1");

    println("Trie routing lookup completed in O(K) prefix time without full linear scans!");
    return 0;
}
