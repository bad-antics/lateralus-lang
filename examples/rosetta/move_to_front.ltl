// Rosetta Code · Move-to-front algorithm · Lateralus
// https://rosettacode.org/wiki/Move-to-front_algorithm
//
// Encode each lowercase letter as its index in a symbol table, then move
// that symbol to the front. Decoding replays the same table updates.

let SYMBOLS = "abcdefghijklmnopqrstuvwxyz"

fn initial_table() -> list {
    let t = []
    let i = 0
    while i < len(SYMBOLS) {
        t = t + [slice(SYMBOLS, i, i + 1)]
        i = i + 1
    }
    return t
}

fn move_to_front(table: list, idx: int) -> list {
    return [table[idx]] + slice_list(table, 0, idx) + slice_list(table, idx + 1, len(table))
}

fn mtf_encode(s: str) -> list {
    let table = initial_table()
    let out = []
    let i = 0
    while i < len(s) {
        let c = slice(s, i, i + 1)
        let idx = 0
        while table[idx] != c { idx = idx + 1 }
        out = out + [idx]
        table = move_to_front(table, idx)
        i = i + 1
    }
    return out
}

fn mtf_decode(codes: list) -> str {
    let table = initial_table()
    let out = ""
    let i = 0
    while i < len(codes) {
        let idx = codes[i]
        out = out + table[idx]
        table = move_to_front(table, idx)
        i = i + 1
    }
    return out
}

fn main() {
    // The three words from the Rosetta task.
    let cases = [
        ["broood", [1, 17, 15, 0, 0, 5]],
        ["bananaaa", [1, 1, 13, 1, 1, 1, 0, 0]],
        ["hiphophiphop", [7, 8, 15, 2, 15, 2, 2, 3, 2, 2, 3, 2]]
    ]
    let i = 0
    while i < len(cases) {
        let word = cases[i][0]
        let enc = mtf_encode(word)
        let dec = mtf_decode(enc)
        print(word + " -> " + str(enc) + " -> " + dec)
        assert_eq(enc, cases[i][1])
        assert_eq(dec, word)
        i = i + 1
    }
}

main()
