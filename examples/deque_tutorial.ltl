// examples/deque_tutorial.ltl - Practical Double-Ended Queue (Deque)
// Demonstrates bidirectional job queues, round-robin cyclic rotation, and undo/redo stacks.

import deque

fn process_priority_task(q: list, urgent_task: str) -> list {
    // Urgent tasks are pushed to the front
    println("Pushing urgent task to FRONT: " + urgent_task)
    return deque.push_front(q, urgent_task)
}

fn process_standard_task(q: list, normal_task: str) -> list {
    // Standard tasks are pushed to the back
    println("Pushing normal task to BACK: " + normal_task)
    return deque.push_back(q, normal_task)
}

fn simulate_round_robin_scheduler() {
    println("\n--- Round-Robin Scheduler (Cyclic Rotation) ---")
    let workers = deque.from_list(["Worker-A", "Worker-B", "Worker-C", "Worker-D"])
    
    // Rotate left: front worker completes slice and goes to back
    let round1 = deque.rotate_left(workers, 1)
    println("Initial order:    " + to_str(deque.to_list(workers)))
    println("After 1st slice: " + to_str(deque.to_list(round1)))
    
    let round2 = deque.rotate_left(round1, 1)
    println("After 2nd slice: " + to_str(deque.to_list(round2)))
}

fn main() {
    println("=== Lateralus Double-Ended Queue (Deque) ===")
    
    // 1. Build job queue
    let q = deque.new()
    q = process_standard_task(q, "Backup Database")
    q = process_standard_task(q, "Send Daily Newsletter")
    q = process_priority_task(q, "CRITICAL: Fix Payment Gateway")
    
    println("Queue state: " + to_str(deque.to_list(q)))
    println("Next task to execute (front): " + deque.front(q))
    
    // 2. Dispatch tasks FIFO
    let dispatched = deque.pop_front(q)
    let current_job = dispatched[0]
    let remaining_q = dispatched[1]
    
    println("Executing: " + current_job)
    println("Remaining tasks: " + to_str(deque.to_list(remaining_q)))
    
    // 3. Scheduler demo
    simulate_round_robin_scheduler()
}
