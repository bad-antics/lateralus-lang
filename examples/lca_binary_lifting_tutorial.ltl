// ===================================================================
// examples/lca_binary_lifting_tutorial.ltl
// -------------------------------------------------------------------
// Demonstration of Lowest Common Ancestor (LCA) via Binary Lifting.
//
// Real-World Applications:
// 1. Version Control Systems (Git merge-base calculation in commit trees).
// 2. Microservice Dependency Hierarchy & Root Cause Analysis.
// 3. Organizational Chart Role-Based Access Control (RBAC) Least Common Privilege.
// ===================================================================

fn init_graph(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

fn add_edge(adj, u, v) {
    adj[u] = push(adj[u], v)
    adj[v] = push(adj[v], u)
}

fn init_jump_table(log_n, n) {
    let up = dict()
    let i = 0
    while i < log_n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = 0
            j = j + 1
        }
        up[i] = row
        i = i + 1
    }
    return up
}

fn dfs_prepare(u, p, d, adj, depth, up, log_n) {
    depth[u] = d
    up[0][u] = p

    let i = 1
    while i < log_n {
        let anc = up[i - 1][u]
        up[i][u] = up[i - 1][anc]
        i = i + 1
    }

    let nbrs = adj[u]
    let k = 0
    while k < len(nbrs) {
        let v = nbrs[k]
        if v != p {
            dfs_prepare(v, u, d + 1, adj, depth, up, log_n)
        }
        k = k + 1
    }
}

pub fn create_tree_index(n, root, adj) {
    let log_n = 10
    let depth = dict()
    let up = init_jump_table(log_n, n)

    dfs_prepare(root, root, 0, adj, depth, up, log_n)

    let info = dict()
    info["depth"] = depth
    info["up"] = up
    info["log_n"] = log_n
    info["pow2"] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024]
    return info
}

pub fn query_lca(info, u_in, v_in) {
    let depth = info["depth"]
    let up = info["up"]
    let log_n = info["log_n"]
    let pow2 = info["pow2"]

    let u = u_in
    let v = v_in

    if depth[u] < depth[v] {
        let tmp = u
        u = v
        v = tmp
    }

    let diff = depth[u] - depth[v]
    let i = log_n - 1
    while i >= 0 {
        let p2 = pow2[i]
        if diff >= p2 {
            u = up[i][u]
            diff = diff - p2
        }
        i = i - 1
    }

    if u == v {
        return u
    }

    let j = log_n - 1
    while j >= 0 {
        if up[j][u] != up[j][v] {
            u = up[j][u]
            v = up[j][v]
        }
        j = j - 1
    }

    return up[0][u]
}

pub fn query_distance(info, u, v) {
    let ancestor = query_lca(info, u, v)
    let depth = info["depth"]
    return depth[u] + depth[v] - 2 * depth[ancestor]
}

pub fn main() {
    print("=================================================================")
    print("   Lateralus Standard Library: LCA via Binary Lifting Demo       ")
    print("=================================================================")

    // Model Git Commit Tree:
    //         0 (Initial Commit)
    //        / \
    //       1   2 (Main Branches)
    //      / \   \
    //     3   4   5 (Feature Slices)
    //    /
    //   6 (Bugfix Commit)
    let n = 7
    let adj = init_graph(n)
    add_edge(adj, 0, 1)
    add_edge(adj, 0, 2)
    add_edge(adj, 1, 3)
    add_edge(adj, 1, 4)
    add_edge(adj, 2, 5)
    add_edge(adj, 3, 6)

    let info = create_tree_index(n, 0, adj)

    print("Tree Precomputation Complete [log2(N)=10 table generated].")

    // Case 1: Merge Base between commit 6 and commit 4
    let mb_6_4 = query_lca(info, 6, 4)
    let dist_6_4 = query_distance(info, 6, 4)
    print("Git Merge-Base(Commit 6, Commit 4) -> Commit: " + str(mb_6_4) + " [Distance: " + str(dist_6_4) + " hops]")

    // Case 2: Cross-Branch Merge Base between commit 6 and commit 5
    let mb_6_5 = query_lca(info, 6, 5)
    let dist_6_5 = query_distance(info, 6, 5)
    print("Git Merge-Base(Commit 6, Commit 5) -> Commit: " + str(mb_6_5) + " [Distance: " + str(dist_6_5) + " hops]")

    // Case 3: Direct Ancestor check (Commit 3 and Commit 6)
    let mb_3_6 = query_lca(info, 3, 6)
    let dist_3_6 = query_distance(info, 3, 6)
    print("Git Merge-Base(Commit 3, Commit 6) -> Commit: " + str(mb_3_6) + " [Distance: " + str(dist_3_6) + " hops]")

    print("LCA Demonstration finished with 100% precision.")
}
