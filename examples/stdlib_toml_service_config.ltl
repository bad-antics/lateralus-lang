// stdlib toml tutorial: read service configuration and validate required settings.
// Uses toml.parse on a pinned fixture and checks:
// - [service].port
// - [service].enabled
// - preserves quoted "#" in strings
// - reports missing required key "service.api_key"

import stdlib.toml

fn read_file(path: str) -> str {
    // Fallback to embedded fixture content for environments without file IO helpers.
    // The pinned fixture is examples/fixtures/stdlib_toml_service.toml
    return "[service]\nname = \"billing-api\"\nport = 8080\nenabled = true\nbanner = \"ready #1\"\n\n[database]\nurl = \"postgres://localhost/app\"\n"
}

pub fn main() {
    let text = read_file("examples/fixtures/stdlib_toml_service.toml")
    let cfg = toml.parse(text)
    let service = cfg["service"]

    let ok = true

    if service["port"] == 8080 {
        print("[PASS] service.port == 8080")
    } else {
        print("[FAIL] service.port")
        ok = false
    }

    if service["enabled"] == true {
        print("[PASS] service.enabled == true")
    } else {
        print("[FAIL] service.enabled")
        ok = false
    }

    if service["banner"] == "ready #1" {
        print("[PASS] quoted # preserved in banner")
    } else {
        print("[FAIL] quoted # preserved in banner")
        ok = false
    }

    if contains(keys(service), "api_key") {
        print("[FAIL] service.api_key should be missing")
        ok = false
    } else {
        print("[FAIL_REPORT] missing required key: service.api_key")
    }

    if ok {
        print("PINNED_TOML_OK")
    } else {
        print("PINNED_TOML_ERROR")
    }
}
