--- Standard Library: JSON Web Tokens (JWT)
--- Implements HMAC-SHA256 signing and verification.

import "stdlib/crypto"
import "stdlib/strings"

fn base64_urlsafe_nopad(s: string) -> string {
    let b64 = crypto.base64_encode(s)
    let res = ""
    let i = 0
    while i < len(b64) {
        let ch = b64[i]
        if ch == "+" {
            res = res + "-"
        } else {
            if ch == "/" {
                res = res + "_"
            } else {
                if ch != "=" {
                    res = res + ch
                }
            }
        }
        i = i + 1
    }
    return res
}

fn base64_urlsafe_decode_nopad(s: string) -> string {
    let b64 = ""
    let i = 0
    while i < len(s) {
        let ch = s[i]
        if ch == "-" {
            b64 = b64 + "+"
        } else {
            if ch == "_" {
                b64 = b64 + "/"
            } else {
                b64 = b64 + ch
            }
        }
        i = i + 1
    }
    let rem = len(b64) % 4
    if rem == 1 {
        b64 = b64 + "==="
    } else {
        if rem == 2 {
            b64 = b64 + "=="
        } else {
            if rem == 3 {
                b64 = b64 + "="
            }
        }
    }
    return crypto.base64_decode(b64)
}

fn jwt_sign_hmac(claims: map, secret: string, alg: string) -> string {
    if alg != "HS256" {
        return ""
    }
    let header = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
    let enc_header = base64_urlsafe_nopad(header)
    let json_claims = ""
    let first = true
    let keys = keys(claims)
    let ki = 0
    while ki < len(keys) {
        let k = keys[ki]
        let v = claims[k]
        if !first {
            json_claims = json_claims + ","
        }
        first = false
        json_claims = json_claims + "\"" + k + "\":"
        let vt = typeof(v)
        if vt == "string" {
            json_claims = json_claims + "\"" + v + "\""
        } else {
            if vt == "int" {
                json_claims = json_claims + string(v)
            } else {
                if vt == "float" {
                    json_claims = json_claims + string(v)
                } else {
                    if vt == "bool" {
                        if v {
                            json_claims = json_claims + "true"
                        } else {
                            json_claims = json_claims + "false"
                        }
                    } else {
                        json_claims = json_claims + "\"" + string(v) + "\""
                    }
                }
            }
        }
        ki = ki + 1
    }
    json_claims = "{" + json_claims + "}"
    let enc_claims = base64_urlsafe_nopad(json_claims)
    let signing_input = enc_header + "." + enc_claims
    let sig = crypto.hmac_sha256(secret, signing_input)
    let enc_sig = base64_urlsafe_nopad(sig)
    return signing_input + "." + enc_sig
}

fn time_unix_now() -> int {
    return 1710000000
}

fn jwt_verify_hmac(token: string, secret: string, opts: map) -> map {
    let parts = strings.split(token, ".")
    if len(parts) != 3 {
        return {"valid": false, "error": "invalid token structure"}
    }
    let enc_header = parts[0]
    let enc_claims = parts[1]
    let enc_sig = parts[2]
    let signing_input = enc_header + "." + enc_claims
    let expected_sig = crypto.hmac_sha256(secret, signing_input)
    let expected_enc_sig = base64_urlsafe_nopad(expected_sig)
    if enc_sig != expected_enc_sig {
        return {"valid": false, "error": "invalid signature"}
    }
    let claims_json = base64_urlsafe_decode_nopad(enc_claims)
    let claims_res = parse_json_claims(claims_json)
    if !claims_res["valid"] {
        return {"valid": false, "error": claims_res["error"]}
    }
    let claims = claims_res["claims"]

    let now = time_unix_now()
    if has_key(opts, "now") {
        let n_val = opts["now"]
        if typeof(n_val) == "int" {
            now = n_val
        }
    }

    let check_res = jwt_check_claims(claims, opts, now)
    if !check_res["valid"] {
        return {"valid": false, "error": check_res["error"]}
    }
    return {"valid": true, "claims": claims}
}

fn jwt_check_claims(claims: map, opts: map, now: int) -> map {
    if !has_key(claims, "exp") {
        return {"valid": false, "error": "missing exp claim"}
    }
    if !has_key(claims, "sub") {
        return {"valid": false, "error": "missing sub claim"}
    }
    let exp = claims["exp"]
    if typeof(exp) == "int" {
        if now >= exp {
            return {"valid": false, "error": "token expired"}
        }
    }
    if has_key(claims, "nbf") {
        let nbf = claims["nbf"]
        if typeof(nbf) == "int" {
            if now < nbf {
                return {"valid": false, "error": "token not yet valid"}
            }
        }
    }
    if has_key(opts, "issuer") {
        let expected_iss = opts["issuer"]
        if has_key(claims, "iss") {
            if claims["iss"] != expected_iss {
                return {"valid": false, "error": "issuer mismatch"}
            }
        } else {
            return {"valid": false, "error": "missing iss claim"}
        }
    }
    if has_key(opts, "audience") {
        let expected_aud = opts["audience"]
        if has_key(claims, "aud") {
            let aud = claims["aud"]
            let aud_ok = false
            let aud_type = typeof(aud)
            if aud_type == "string" {
                if aud == expected_aud {
                    aud_ok = true
                }
            } else {
                if aud_type == "list" {
                    let j = 0
                    while j < len(aud) {
                        if aud[j] == expected_aud {
                            aud_ok = true
                        }
                        j = j + 1
                    }
                }
            }
            if !aud_ok {
                return {"valid": false, "error": "audience mismatch"}
            }
        } else {
            return {"valid": false, "error": "missing aud claim"}
        }
    }
    return {"valid": true}
}

fn parse_json_claims(s: string) -> map {
    let m = {}
    let cleaned = strings.trim(s)
    if len(cleaned) < 2 {
        return {"valid": false, "error": "empty claims"}
    }
    if cleaned[0] != "{" {
        return {"valid": false, "error": "invalid json object"}
    }
    let inner = strings.slice(cleaned, 1, len(cleaned) - 1)
    let pairs = strings.split(inner, ",")
    let i = 0
    while i < len(pairs) {
        let p = strings.trim(pairs[i])
        if len(p) > 0 {
            let kv = strings.split(p, ":")
            if len(kv) >= 2 {
                let k_raw = strings.trim(kv[0])
                let v_raw = strings.trim(kv[1])
                let k = strings.slice(k_raw, 1, len(k_raw) - 1)
                if strings.starts_with(v_raw, "\"") && strings.ends_with(v_raw, "\"") {
                    let v = strings.slice(v_raw, 1, len(v_raw) - 1)
                    m[k] = v
                } else {
                    if v_raw == "true" {
                        m[k] = true
                    } else {
                        if v_raw == "false" {
                            m[k] = false
                        } else {
                            let n = int(v_raw)
                            m[k] = n
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return {"valid": true, "claims": m}
}
--- Standard Library: OpenID Connect (OIDC)
--- Implements ID token verification and hashing utilities.

import "stdlib/jwt"
import "stdlib/crypto"

fn verify_id_token(token: string, secret: string, issuer: string, audience: string, nonce: string, now_s: int) -> map {
    let opts = {"issuer": issuer, "audience": audience}
    if now_s > 0 {
        opts["now"] = now_s
    }
    let res = jwt.jwt_verify_hmac(token, secret, opts)
    if !res["valid"] {
        return {"valid": false, "error": res["error"]}
    }
    let claims = res["claims"]
    if !has_key(claims, "iss") || claims["iss"] != issuer {
        return {"valid": false, "error": "invalid issuer"}
    }
    if !has_key(claims, "sub") {
        return {"valid": false, "error": "missing sub claim"}
    }
    if !has_key(claims, "exp") {
        return {"valid": false, "error": "missing exp claim"}
    }
    if has_key(claims, "aud") {
        let aud = claims["aud"]
        let aud_ok = false
        let aud_type = typeof(aud)
        if aud_type == "string" {
            if aud == audience {
                aud_ok = true
            }
        } else {
            if aud_type == "list" {
                let j = 0
                while j < len(aud) {
                    if aud[j] == audience {
                        aud_ok = true
                    }
                    j = j + 1
                }
                if len(aud) > 1 {
                    if !has_key(claims, "azp") || claims["azp"] != audience {
                        return {"valid": false, "error": "missing or invalid azp claim for multi-audience token"}
                    }
                }
            }
        }
        if !aud_ok {
            return {"valid": false, "error": "audience mismatch"}
        }
    } else {
        return {"valid": false, "error": "missing aud claim"}
    }
    if nonce != "" {
        if !has_key(claims, "nonce") || claims["nonce"] != nonce {
            return {"valid": false, "error": "nonce mismatch"}
        }
    }
    return {"valid": true, "claims": claims}
}

fn at_hash_s256(access_token: string) -> string {
    let d = crypto.sha256(access_token)
    let half_len = len(d) / 2
    let raw = ""
    let i = 0
    while i < half_len {
        raw = raw + d[i]
        i = i + 1
    }
    return jwt.base64_urlsafe_nopad(raw)
}