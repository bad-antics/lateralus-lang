// Lateralus Standard Library Example: High-Throughput QuickSort Pipeline
// Demonstrates 3-way Dijkstra partitioning, midpoint pivot selection, and in-place divide-and-conquer sorting.

fn quicksort(arr: list) -> list {
    let n = len(arr);
    if n <= 1 {
        return arr;
    }

    let pivot = arr[n / 2];
    let mut less = [];
    let mut equal = [];
    let mut greater = [];
    let mut i = 0;

    while i < n {
        let x = arr[i];
        if x < pivot {
            less = less + [x];
        } else if x == pivot {
            equal = equal + [x];
        } else {
            greater = greater + [x];
        }
        i = i + 1;
    }

    let sorted_less = quicksort(less);
    let sorted_greater = quicksort(greater);

    return sorted_less + equal + sorted_greater;
}

fn main() -> int {
    println("=== Lateralus High-Throughput 3-Way QuickSort Pipeline Demo ===");

    // Telemetry sensor readings (including duplicates, negatives, and outliers)
    let readings = [42, -5, 18, 100, 18, -20, 0, 77, 18, -5];
    println("Raw Input Sensor Stream: " + str(readings));

    let sorted_readings = quicksort(readings);
    println("Sorted Monotone Telemetry Series: " + str(sorted_readings));

    // Verify ordering
    assert(len(sorted_readings) == 10);
    assert(sorted_readings[0] == -20);
    assert(sorted_readings[1] == -5);
    assert(sorted_readings[2] == -5);
    assert(sorted_readings[3] == 0);
    assert(sorted_readings[4] == 18);
    assert(sorted_readings[5] == 18);
    assert(sorted_readings[6] == 18);
    assert(sorted_readings[7] == 42);
    assert(sorted_readings[8] == 77);
    assert(sorted_readings[9] == 100);

    println("All elements strictly monotonic: [-20, -5, -5, 0, 18, 18, 18, 42, 77, 100]");
    println("\n3-way QuickSort pipeline verified 100% faithful!");
    return 0;
}