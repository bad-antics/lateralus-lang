// ===================================================================
// examples/bucket_sort_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: Environmental IoT Weather Sensor Network
// Temperature Distribution & Histogram Binning using Bucket Sort.
// ===================================================================

pub fn insertion_sort(bucket, size) {
    let i = 1
    while i < size {
        let key = bucket[i]
        let j = i - 1
        while j >= 0 && bucket[j] > key {
            bucket[j + 1] = bucket[j]
            j = j - 1
        }
        bucket[j + 1] = key
        i = i + 1
    }
    return bucket
}

pub fn bucket_sort(arr, n, num_buckets) {
    if n <= 1 {
        return arr
    }

    let min_val = arr[0]
    let max_val = arr[0]
    let i = 1
    while i < n {
        if arr[i] < min_val {
            min_val = arr[i]
        }
        if arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }

    if min_val == max_val {
        return arr
    }

    let range_span = max_val - min_val
    let buckets = dict()
    let bucket_sizes = dict()
    let b = 0
    while b < num_buckets {
        buckets[b] = dict()
        bucket_sizes[b] = 0
        b = b + 1
    }

    i = 0
    while i < n {
        let val = arr[i]
        let b_idx = ((val - min_val) * (num_buckets - 1)) / range_span
        if b_idx >= num_buckets {
            b_idx = num_buckets - 1
        }
        let cur_sz = bucket_sizes[b_idx]
        buckets[b_idx][cur_sz] = val
        bucket_sizes[b_idx] = cur_sz + 1
        i = i + 1
    }

    b = 0
    while b < num_buckets {
        let sz = bucket_sizes[b]
        if sz > 1 {
            buckets[b] = insertion_sort(buckets[b], sz)
        }
        b = b + 1
    }

    let output = dict()
    let out_idx = 0
    b = 0
    while b < num_buckets {
        let sz = bucket_sizes[b]
        let j = 0
        while j < sz {
            output[out_idx] = buckets[b][j]
            out_idx = out_idx + 1
            j = j + 1
        }
        b = b + 1
    }

    return output
}

pub fn main() {
    print("=== IoT Environmental Weather Station Telemetry Sorting ===")

    // Simulated 8 temperature readings across agricultural stations (scaled x10 to integer tenths of a degree C)
    // Values: [185, 240, 150, 310, 205, 175, 280, 220] (15.0C to 31.0C)
    let readings = dict()
    readings[0] = 185
    readings[1] = 240
    readings[2] = 150
    readings[3] = 310
    readings[4] = 205
    readings[5] = 175
    readings[6] = 280
    readings[7] = 220

    let n = 8
    let num_buckets = 4

    print("Sorting raw sensor readings into 4 temperature micro-climate zones:")
    let sorted_readings = bucket_sort(readings, n, num_buckets)

    let idx = 0
    while idx < n {
        print(sorted_readings[idx])
        idx = idx + 1
    }

    // Verify ordering correctness
    assert(sorted_readings[0] == 150, "Minimum reading is 15.0 C (150)")
    assert(sorted_readings[1] == 175, "Second reading is 17.5 C (175)")
    assert(sorted_readings[2] == 185, "Third reading is 18.5 C (185)")
    assert(sorted_readings[3] == 205, "Fourth reading is 20.5 C (205)")
    assert(sorted_readings[4] == 220, "Fifth reading is 22.0 C (220)")
    assert(sorted_readings[5] == 240, "Sixth reading is 24.0 C (240)")
    assert(sorted_readings[6] == 280, "Seventh reading is 28.0 C (280)")
    assert(sorted_readings[7] == 310, "Maximum reading is 31.0 C (310)")

    print("IoT temperature readings sorted linearly in expected O(n) time successfully!")
}
