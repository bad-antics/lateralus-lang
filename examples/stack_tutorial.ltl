// ===================================================================
// examples/stack_tutorial.ltl — stdlib/stack.ltl tutorial companion
// Runnable tour of the LIFO stack: push/pop/peek, contains, reversed,
// swap_top, dup, drop, clear, and fold. Inlined (for -> while).
// ===================================================================

fn snew() -> list { return [] }
fn sfrom(items: list) -> list {
    let s = []
    let i = 0
    while i < len(items) { s = s + [items[i]]; i = i + 1 }
    return s
}
fn spush(s: list, item) -> list { return s + [item] }
fn spop(s: list) -> list {
    if len(s) == 0 { return ["", s] }
    let top = s[len(s) - 1]
    let rest = slice(s, 0, len(s) - 1)
    return [top, rest]
}
fn speak(s: list) -> str {
    if len(s) == 0 { return "" }
    return to_str(s[len(s) - 1])
}
fn ssize(s: list) -> int { return len(s) }
fn scontains(s: list, item) -> bool {
    let i = 0
    while i < len(s) {
        if s[i] == item { return true }
        i = i + 1
    }
    return false
}
fn sreversed(s: list) -> list { return reverse(s) }
fn sswap_top(s: list) -> list {
    if len(s) < 2 { return s }
    let a = s[len(s) - 1]
    let b = s[len(s) - 2]
    let base = slice(s, 0, len(s) - 2)
    return base + [a, b]
}
fn sdup(s: list) -> list {
    if len(s) == 0 { return s }
    return s + [s[len(s) - 1]]
}
fn sdrop(s: list, n: int) -> list {
    let keep = len(s) - n
    if keep < 0 { keep = 0 }
    return slice(s, 0, keep)
}
fn add2(a, b) -> int { return a + b }
fn sfold(s: list, init, func) -> int {
    let acc = init
    let i = 0
    while i < len(s) { acc = func(acc, s[i]); i = i + 1 }
    return acc
}
fn show(xs: list) -> str {
    let s = ""
    let i = 0
    while i < len(xs) {
        if i > 0 { s = s + "," }
        s = s + to_str(xs[i])
        i = i + 1
    }
    return s
}

fn main() {
    println("=== LATERALUS STDLIB STACK TUTORIAL ===")

    println("STEP 1 push/pop/peek (LIFO):")
    let s = snew()
    s = spush(s, "a"); s = spush(s, "b"); s = spush(s, "c")
    println("  stack=" + show(s) + " top=" + speak(s))
    let p1 = spop(s)
    println("  pop -> " + p1[0] + " rest=" + show(p1[1]))
    println("  peek now=" + speak(p1[1]))

    println("STEP 2 from_list + contains:")
    let s2 = sfrom([10, 20, 30])
    println("  from_list=[10,20,30] top=" + speak(s2))
    println("  contains 20=" + str(scontains(s2, 20)) + " contains 99=" + str(scontains(s2, 99)))

    println("STEP 3 bulk ops:")
    println("  reversed=[10,30,20] top=" + speak(sreversed(s2)))
    println("  swap_top " + show(sswap_top([1, 2, 3])) + " (top two swap)")
    println("  dup [1,2] -> " + show(sdup([1, 2])))
    println("  drop 2 of [1,2,3,4] -> " + show(sdrop([1, 2, 3, 4], 2)))
    println("  drop 9 of [1,2] -> " + show(sdrop([1, 2], 9)))

    println("STEP 4 fold bottom-to-top:")
    let total = sfold([1, 2, 3, 4], 0, add2)
    println("  fold([1,2,3,4], +) = " + str(total))
    let total2 = sfold(sfrom([5, 6]), 100, add2)
    println("  fold(stack[5,6], init=100) = " + str(total2))

    println("STEP 5 to_string + clear:")
    println("  Stack(" + show(s2) + ")")
    println("  clear -> size=" + str(len(snew())))
    println("PINNED_VECTORS: push-pop=c-rest-ab peek-b contains20=T contains99=F rev-top=10 swap=1,3,2 dup=1,2,2 drop2=1,2 drop9=empty fold=10 fold2=111")
}

main()
