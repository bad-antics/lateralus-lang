import sort

@test
fn sorted_handles_duplicates() -> bool {
    return sort.sorted([3, 1, 2, 1]) == [1, 1, 2, 3]
}

@test
fn sorted_desc_reverses() -> bool {
    return sort.sorted_desc([3, 1, 2]) == [3, 2, 1]
}

@test
fn mergesort_is_stable() -> bool {
    let rows = [[2, "b"], [1, "a"], [2, "c"]]
    return sort.mergesort(rows) == [[1, "a"], [2, "b"], [2, "c"]]
}

@test
fn sort_by_key_orders_pairs() -> bool {
    let rows = [[3, "c"], [1, "a"], [2, "b"]]
    let got = sort.sort_by_key(rows, fn(row) { return row[0] })
    return got == [[1, "a"], [2, "b"], [3, "c"]]
}

@test
fn insertion_sort_keeps_nearly_sorted_input() -> bool {
    return sort.insertion_sort([1, 2, 3, 5, 4]) == [1, 2, 3, 4, 5]
}

@test
fn is_sorted_checks_guards() -> bool {
    return sort.is_sorted([1, 2, 2, 3]) && !sort.is_sorted([2, 1])
}
