// ===================================================================
// tests/stdlib_dinic_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for Dinic's Algorithm (1970), BFS level graph,
// DFS blocking flow augmentation, and O(V^2 E) maximum network flow.
// ===================================================================

fn min_val(a, b) {
    if a < b {
        return a
    }
    return b
}

fn init_2d_matrix(n, val) {
    let mtx = dict()
    let i = 0
    while i < n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = val
            j = j + 1
        }
        mtx[i] = row
        i = i + 1
    }
    return mtx
}

fn init_adj(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

pub fn create_flow_network(n) {
    let net = dict()
    net["n"] = n
    net["res"] = init_2d_matrix(n, 0)
    net["adj"] = init_adj(n)
    return net
}

pub fn add_capacity(net, u, v, cap) {
    let res = net["res"]
    let adj = net["adj"]

    res[u][v] = res[u][v] + cap

    let neighbors_u = adj[u]
    adj[u] = push(neighbors_u, v)

    let neighbors_v = adj[v]
    adj[v] = push(neighbors_v, u)
}

fn bfs_level_graph(net, s, t, level) {
    let n = net["n"]
    let res = net["res"]
    let adj = net["adj"]

    let i = 0
    while i < n {
        level[i] = -1
        i = i + 1
    }

    level[s] = 0
    let queue = [s]
    let q_head = 0

    while q_head < len(queue) {
        let u = queue[q_head]
        q_head = q_head + 1

        let neighbors = adj[u]
        let k = 0
        while k < len(neighbors) {
            let v = neighbors[k]
            if level[v] == -1 and res[u][v] > 0 {
                level[v] = level[u] + 1
                queue = push(queue, v)
            }
            k = k + 1
        }
    }

    return level[t] != -1
}

fn send_blocking_flow(net, u, flow_in, t, level) {
    if u == t {
        return flow_in
    }

    let res = net["res"]
    let adj = net["adj"]
    let neighbors = adj[u]
    let k = 0

    while k < len(neighbors) {
        let v = neighbors[k]
        if level[v] == level[u] + 1 and res[u][v] > 0 {
            let curr_cap = min_val(flow_in, res[u][v])
            let pushed = send_blocking_flow(net, v, curr_cap, t, level)

            if pushed > 0 {
                res[u][v] = res[u][v] - pushed
                res[v][u] = res[v][u] + pushed
                return pushed
            }
        }
        k = k + 1
    }

    return 0
}

pub fn dinic_max_flow(net, s, t) {
    let n = net["n"]
    let total_flow = 0
    let level = dict()
    let inf_flow = 1000000000

    while bfs_level_graph(net, s, t, level) {
        while true {
            let pushed = send_blocking_flow(net, s, inf_flow, t, level)
            if pushed <= 0 {
                break
            }
            total_flow = total_flow + pushed
        }
    }

    return total_flow
}

// -------------------------------------------------------------------
// Verification Tests
// -------------------------------------------------------------------

pub fn test_classic_six_node_network() {
    // 0: Source (S), 5: Sink (T)
    let net = create_flow_network(6)
    add_capacity(net, 0, 1, 10)
    add_capacity(net, 0, 2, 10)
    add_capacity(net, 1, 2, 2)
    add_capacity(net, 1, 3, 4)
    add_capacity(net, 1, 4, 8)
    add_capacity(net, 2, 4, 9)
    add_capacity(net, 3, 5, 10)
    add_capacity(net, 4, 3, 6)
    add_capacity(net, 4, 5, 10)

    let max_flow = dinic_max_flow(net, 0, 5)
    assert(max_flow == 19, "Classic 6-node network max flow must be exactly 19")
}

pub fn test_parallel_bottlenecks() {
    // 4 nodes: 0 (S), 1, 2, 3 (T)
    let net = create_flow_network(4)
    add_capacity(net, 0, 1, 10)
    add_capacity(net, 0, 2, 10)
    add_capacity(net, 1, 3, 5)
    add_capacity(net, 2, 3, 15)

    let max_flow = dinic_max_flow(net, 0, 3)
    assert(max_flow == 15, "Parallel bottleneck max flow is 5 + 10 = 15")
}

pub fn test_direct_source_sink() {
    let net = create_flow_network(2)
    add_capacity(net, 0, 1, 25)
    let flow = dinic_max_flow(net, 0, 1)
    assert(flow == 25, "Direct S->T capacity must equal 25")
}

pub fn test_disconnected_network() {
    let net = create_flow_network(4)
    add_capacity(net, 0, 1, 50)
    add_capacity(net, 2, 3, 50)
    let flow = dinic_max_flow(net, 0, 3)
    assert(flow == 0, "No path between S and T must yield 0 max flow")
}

pub fn main() {
    test_classic_six_node_network()
    test_parallel_bottlenecks()
    test_direct_source_sink()
    test_disconnected_network()
    print("All Dinic's Algorithm verification tests passed successfully!")
}
