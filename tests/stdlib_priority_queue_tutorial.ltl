// Standard Library Binary Min-Heap Priority Queue Tutorial Verification Suite
// Validates sift-up, sift-down, array-backed complete binary tree, and strictly ascending extraction.

fn pq_sift_up(heap: list, start_idx: int) -> int {
    let mut idx = start_idx;
    while idx > 0 {
        let parent = (idx - 1) / 2;
        if heap[idx] < heap[parent] {
            let tmp = heap[idx];
            heap[idx] = heap[parent];
            heap[parent] = tmp;
            idx = parent;
        } else {
            break;
        }
    }
    return 0;
}

fn pq_sift_down(heap: list, start_idx: int) -> int {
    let mut idx = start_idx;
    let n = len(heap);

    while 2 * idx + 1 < n {
        let left = 2 * idx + 1;
        let right = 2 * idx + 2;
        let mut smallest = idx;

        if heap[left] < heap[smallest] {
            smallest = left;
        }
        if right < n && heap[right] < heap[smallest] {
            smallest = right;
        }

        if smallest != idx {
            let tmp = heap[idx];
            heap[idx] = heap[smallest];
            heap[smallest] = tmp;
            idx = smallest;
        } else {
            break;
        }
    }
    return 0;
}

fn pq_push(heap: list, val: int) -> int {
    heap.append(val);
    pq_sift_up(heap, len(heap) - 1);
    return 0;
}

fn list_drop_last(items: list) -> list {
    let mut res = [];
    let mut i = 0;
    while i < len(items) - 1 {
        res.append(items[i]);
        i = i + 1;
    }
    return res;
}

fn main() -> int {
    let mut heap = [];

    // 1. Initial State assertions
    assert(len(heap) == 0);

    // 2. Insert unsorted values: [50, 10, 80, 20, 5, 70]
    pq_push(heap, 50);
    pq_push(heap, 10);
    pq_push(heap, 80);
    pq_push(heap, 20);
    pq_push(heap, 5);
    pq_push(heap, 70);

    assert(len(heap) == 6);
    // Root element must always be the minimum (5)
    assert(heap[0] == 5);

    // 3. Extract minimums sequentially (must yield strictly sorted order: 5, 10, 20, 50, 70, 80)
    let min1 = heap[0];
    assert(min1 == 5);
    heap[0] = heap[len(heap) - 1];
    heap = list_drop_last(heap);
    pq_sift_down(heap, 0);

    let min2 = heap[0];
    assert(min2 == 10);
    heap[0] = heap[len(heap) - 1];
    heap = list_drop_last(heap);
    pq_sift_down(heap, 0);

    let min3 = heap[0];
    assert(min3 == 20);
    heap[0] = heap[len(heap) - 1];
    heap = list_drop_last(heap);
    pq_sift_down(heap, 0);

    let min4 = heap[0];
    assert(min4 == 50);
    heap[0] = heap[len(heap) - 1];
    heap = list_drop_last(heap);
    pq_sift_down(heap, 0);

    let min5 = heap[0];
    assert(min5 == 70);
    heap[0] = heap[len(heap) - 1];
    heap = list_drop_last(heap);
    pq_sift_down(heap, 0);

    let min6 = heap[0];
    assert(min6 == 80);
    heap = list_drop_last(heap);
    assert(len(heap) == 0);

    return 0;
}
