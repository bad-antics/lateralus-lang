// ===================================================================
// examples/kruskal_mst_tutorial.ltl
// -------------------------------------------------------------------
// Practical example demonstrating Kruskal's Minimum Spanning Tree (MST)
// algorithm for designing a minimal-cost, loop-free cross-datacenter
// fiber optic backbone network.
// ===================================================================

fn make_edge(u, v, w) {
    let e = dict()
    e["u"] = u
    e["v"] = v
    e["w"] = w
    return e
}

fn sort_edges(edges) {
    let n = len(edges)
    let i = 1
    while i < n {
        let key = edges[i]
        let j = i - 1
        while j >= 0 and edges[j]["w"] > key["w"] {
            edges[j + 1] = edges[j]
            j = j - 1
        }
        edges[j + 1] = key
        i = i + 1
    }
    return edges
}

fn dsu_find(parent, i) {
    let p = parent[i]
    while p != parent[p] {
        p = parent[p]
    }
    return p
}

fn dsu_union(parent, rank, x, y) {
    let root_x = dsu_find(parent, x)
    let root_y = dsu_find(parent, y)
    if root_x == root_y {
        return false
    }
    if rank[root_x] < rank[root_y] {
        parent[root_x] = root_y
    } else {
        if rank[root_x] > rank[root_y] {
            parent[root_y] = root_x
        } else {
            parent[root_y] = root_x
            rank[root_x] = rank[root_x] + 1
        }
    }
    return true
}

pub fn kruskal_mst(n, edges) {
    let sorted_edges = sort_edges(edges)

    let parent = dict()
    let rank = dict()
    let i = 0
    while i < n {
        parent[i] = i
        rank[i] = 0
        i = i + 1
    }

    let mst_edges = []
    let total_weight = 0
    let edge_count = 0

    let idx = 0
    while idx < len(sorted_edges) and edge_count < n - 1 {
        let edge = sorted_edges[idx]
        let u = edge["u"]
        let v = edge["v"]
        let w = edge["w"]

        if dsu_union(parent, rank, u, v) {
            mst_edges = push(mst_edges, edge)
            total_weight = total_weight + w
            edge_count = edge_count + 1
        }
        idx = idx + 1
    }

    let res = dict()
    res["edges"] = mst_edges
    res["total_weight"] = total_weight
    res["is_connected"] = (edge_count == n - 1)
    return res
}

pub fn main() {
    print("=== Kruskal's Minimum Spanning Tree (MST) Optimization ===")
    print("Designing global cloud datacenter fiber backbone topology...")

    // Datacenter Node IDs:
    // 0: Frankfurt
    // 1: London
    // 2: New York
    // 3: Tokyo
    // 4: Singapore

    let candidate_links = [
        make_edge(0, 1, 14),   // Frankfurt <-> London (14ms)
        make_edge(0, 2, 85),   // Frankfurt <-> New York (85ms)
        make_edge(1, 2, 70),   // London <-> New York (70ms)
        make_edge(0, 3, 210),  // Frankfurt <-> Tokyo (210ms)
        make_edge(3, 4, 65),   // Tokyo <-> Singapore (65ms)
        make_edge(1, 4, 160),  // London <-> Singapore (160ms)
        make_edge(2, 3, 140)   // New York <-> Tokyo (140ms)
    ]

    let result = kruskal_mst(5, candidate_links)

    print("Network Fully Connected:")
    print(result["is_connected"])

    print("Total Optimized Backbone Latency / Cost:")
    print(result["total_weight"])

    print("Selected Backbone Fiber Spans Count:")
    print(len(result["edges"]))

    let i = 0
    while i < len(result["edges"]) {
        let span = result["edges"][i]
        print("Selected Span:")
        print(span)
        i = i + 1
    }
}
