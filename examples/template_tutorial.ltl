// Run with stdlib/strings.ltl and stdlib/template.ltl as shown in the tutorial.
let subject = "Hello <<name>>, your order ships <<day>>."
let fields = {}
fields["name"] = "Sam"
fields["day"] = "Friday"

let complete = render(subject, fields)
assert_eq(complete, "Hello Sam, your order ships Friday.")
println(complete)

let fields_without_day = {}
fields_without_day["name"] = "Sam"

let draft = render(subject, fields_without_day)
assert_eq(draft, "Hello Sam, your order ships <<day>>.")
println(draft)

let final_message = render_default(subject, fields_without_day, "soon")
assert_eq(final_message, "Hello Sam, your order ships soon.")
println(final_message)
