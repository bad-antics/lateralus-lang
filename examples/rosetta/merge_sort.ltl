// Rosetta Code · Sorting algorithms/Merge sort · Lateralus

fn merge(left: list, right: list) -> list {
    let out = []
    let i = 0
    let j = 0
    while i < len(left) {
        let take_left = true
        if j < len(right) {
            if right[j] < left[i] { take_left = false }
        }
        if take_left {
            out = out + [left[i]]
            i = i + 1
        } else {
            out = out + [right[j]]
            j = j + 1
        }
    }
    while j < len(right) {
        out = out + [right[j]]
        j = j + 1
    }
    return out
}

fn merge_sort(xs: list) -> list {
    let n = len(xs)
    if n <= 1 { return list_copy(xs) }
    let mid = idiv(n, 2)
    let left = merge_sort(slice(xs, 0, mid))
    let right = merge_sort(slice(xs, mid, n))
    return merge(left, right)
}

fn main() {
    assert_eq(merge_sort([38, 27, 43, 3, 9, 82, 10]), [3, 9, 10, 27, 38, 43, 82], "classic")
    assert_eq(merge_sort([1]), [1], "single")
    print("merge_sort: " + str(merge_sort([5, 1, 4, 2, 8])))
}

main()
