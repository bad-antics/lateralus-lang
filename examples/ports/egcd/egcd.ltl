// examples/ports/egcd/egcd.ltl
// Extended Euclidean Algorithm and Modular Inverses in idiomatic Lateralus

module examples.ports.egcd

import io

fn mod_inv(a: int, m: int) -> int {
    let mut x0 = 1
    let mut x1 = 0
    let mut curr_a = a
    let mut curr_b = m

    while curr_b != 0 {
        let q = (curr_a / curr_b) as int
        let rem = curr_a % curr_b
        curr_a = curr_b
        curr_b = rem

        let next_x = x0 - q * x1
        x0 = x1
        x1 = next_x
    }

    if curr_a != 1 {
        return -1
    }

    let mut res = x0 % m
    if res < 0 {
        res = res + m
    }
    return res
}

fn sum_inverses(limit: int, modulus: int) -> int {
    let mut total = 0
    let mut i = 1
    while i <= limit {
        let inv = mod_inv(i, modulus)
        if inv != -1 {
            total = (total + inv) % modulus
        }
        i += 1
    }
    return total
}

fn main() {
    let limit = 100000
    let modulus = 1000000007
    let result = sum_inverses(limit, modulus)
    io.println("limit=" + limit as str + " modulus=" + modulus as str + " checksum=" + result as str)
}

main()
