// Standard Library Matrix / Linear Algebra Tutorial Verification Suite
// Validates matrix multiplication, transposition, identity laws, non-commutativity, and determinant properties.

fn matrix_zeros(rows: int, cols: int) -> list {
    let mut m = [];
    let mut i = 0;
    while i < rows {
        let mut row = [];
        let mut j = 0;
        while j < cols {
            row = row + [0];
            j = j + 1;
        }
        m = m + [row];
        i = i + 1;
    }
    return m;
}

fn matrix_identity(n: int) -> list {
    let mut m = [];
    let mut i = 0;
    while i < n {
        let mut row = [];
        let mut j = 0;
        while j < n {
            if i == j {
                row = row + [1];
            } else {
                row = row + [0];
            }
            j = j + 1;
        }
        m = m + [row];
        i = i + 1;
    }
    return m;
}

fn matrix_transpose(a: list) -> list {
    let rows = len(a);
    let cols = len(a[0]);
    let mut t = [];
    let mut j = 0;
    while j < cols {
        let mut row = [];
        let mut i = 0;
        while i < rows {
            row = row + [a[i][j]];
            i = i + 1;
        }
        t = t + [row];
        j = j + 1;
    }
    return t;
}

fn matrix_add(a: list, b: list) -> list {
    let rows = len(a);
    let cols = len(a[0]);
    let mut c = [];
    let mut i = 0;
    while i < rows {
        let mut row = [];
        let mut j = 0;
        while j < cols {
            row = row + [a[i][j] + b[i][j]];
            j = j + 1;
        }
        c = c + [row];
        i = i + 1;
    }
    return c;
}

fn matrix_mul(a: list, b: list) -> list {
    let m = len(a);
    let k_dim = len(a[0]);
    let n = len(b[0]);

    let mut c = [];
    let mut i = 0;
    while i < m {
        let mut row = [];
        let mut j = 0;
        while j < n {
            let mut sum = 0;
            let mut k = 0;
            while k < k_dim {
                sum = sum + a[i][k] * b[k][j];
                k = k + 1;
            }
            row = row + [sum];
            j = j + 1;
        }
        c = c + [row];
        i = i + 1;
    }
    return c;
}

fn matrix_det2(a: list) -> int {
    return a[0][0] * a[1][1] - a[0][1] * a[1][0];
}

fn matrix_det3(a: list) -> int {
    let term1 = a[0][0] * (a[1][1] * a[2][2] - a[1][2] * a[2][1]);
    let term2 = a[0][1] * (a[1][0] * a[2][2] - a[1][2] * a[2][0]);
    let term3 = a[0][2] * (a[1][0] * a[2][1] - a[1][1] * a[2][0]);
    return term1 - term2 + term3;
}

fn main() -> int {
    // 1. Identity multiplication invariant: A * I == A
    let a = [
        [1, 2],
        [3, 4]
    ];
    let i2 = matrix_identity(2);
    let ai = matrix_mul(a, i2);
    assert(ai[0][0] == 1);
    assert(ai[0][1] == 2);
    assert(ai[1][0] == 3);
    assert(ai[1][1] == 4);

    // 2. Transposition Invariant: (A^T)^T == A
    let at = matrix_transpose(a);
    assert(at[0][1] == 3);
    assert(at[1][0] == 2);
    let att = matrix_transpose(at);
    assert(att[0][0] == a[0][0]);
    assert(att[0][1] == a[0][1]);
    assert(att[1][0] == a[1][0]);
    assert(att[1][1] == a[1][1]);

    // 3. Non-Commutative Invariant: A * B != B * A
    let b = [
        [0, 5],
        [6, 7]
    ];
    let ab = matrix_mul(a, b);
    let ba = matrix_mul(b, a);
    // AB = [[1*0 + 2*6, 1*5 + 2*7], [3*0 + 4*6, 3*5 + 4*7]] = [[12, 19], [24, 43]]
    assert(ab[0][0] == 12);
    assert(ab[0][1] == 19);
    assert(ab[1][0] == 24);
    assert(ab[1][1] == 43);

    // BA = [[0*1 + 5*3, 0*2 + 5*4], [6*1 + 7*3, 6*2 + 7*4]] = [[15, 20], [27, 40]]
    assert(ba[0][0] == 15);
    assert(ba[0][1] == 20);
    assert(ba[1][0] == 27);
    assert(ba[1][1] == 40);
    assert(ab[0][0] != ba[0][0]); // Proof of non-commutativity!

    // 4. Transpose Product Invariant: (AB)^T == B^T * A^T
    let ab_t = matrix_transpose(ab);
    let bt_at = matrix_mul(matrix_transpose(b), matrix_transpose(a));
    assert(ab_t[0][0] == bt_at[0][0]);
    assert(ab_t[0][1] == bt_at[0][1]);
    assert(ab_t[1][0] == bt_at[1][0]);
    assert(ab_t[1][1] == bt_at[1][1]);

    // 5. Determinant Multiplicative Invariant: det(AB) == det(A) * det(B)
    let det_a = matrix_det2(a);   // 1*4 - 2*3 = -2
    let det_b = matrix_det2(b);   // 0*7 - 5*6 = -30
    let det_ab = matrix_det2(ab); // 12*43 - 19*24 = 516 - 456 = 60
    assert(det_a == -2);
    assert(det_b == -30);
    assert(det_ab == 60);
    assert(det_ab == det_a * det_b); // Proves det(AB) = det(A)*det(B)!

    // 6. 3x3 Determinant
    let m3 = [
        [1, 2, 3],
        [0, 1, 4],
        [5, 6, 0]
    ];
    // det(m3) = 1*(0 - 24) - 2*(0 - 20) + 3*(0 - 5) = -24 + 40 - 15 = 1
    assert(matrix_det3(m3) == 1);

    return 0;
}