import bitops

@test "bitops tutorial verification"
fn test_bitops() {
    assert(bitops.bit_set(0, 2) == 4)
    assert(bitops.bit_clear(4, 2) == 0)
    assert(bitops.bit_test(4, 2) == true)
    
    assert(bitops.extract_bits(0xAF, 4, 4) == 0xA)
    assert(bitops.insert_bits(0, 0xF, 4, 4) == 0xF0)
    
    assert(bitops.popcount(0b1011) == 3)
    assert(bitops.clz(1) == 63)
    assert(bitops.ctz(2) == 1)
    
    assert(bitops.bswap32(0x12345678) == 0x78563412)
    assert(bitops.rotl32(1, 1) == 2)
    assert(bitops.is_power_of_2(8) == true)
}