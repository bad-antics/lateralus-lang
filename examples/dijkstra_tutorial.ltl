// Lateralus Standard Library Example: Dijkstra's Shortest Path Algorithm
// Demonstrates single-source shortest path calculation, edge relaxation, and route reconstruction.

fn dijkstra(n: int, adj: dict, source: int) -> dict {
    let INF = 1000000000;
    let mut dist = [];
    let mut visited = [];
    let mut parent = [];
    let mut i = 0;
    while i < n {
        dist = dist + [INF];
        visited = visited + [false];
        parent = parent + [-1];
        i = i + 1;
    }

    dist[source] = 0;

    let mut step = 0;
    while step < n {
        let mut u = -1;
        let mut min_d = INF;
        let mut j = 0;
        while j < n {
            if visited[j] == false && dist[j] < min_d {
                min_d = dist[j];
                u = j;
            }
            j = j + 1;
        }

        if u == -1 {
            step = n;
        } else {
            visited[u] = true;
            if contains(adj, u) {
                let neighbors = adj[u];
                let mut k = 0;
                while k < len(neighbors) {
                    let edge = neighbors[k];
                    let v = edge[0];
                    let weight = edge[1];
                    if visited[v] == false {
                        let candidate = dist[u] + weight;
                        if candidate < dist[v] {
                            dist[v] = candidate;
                            parent[v] = u;
                        }
                    }
                    k = k + 1;
                }
            }
            step = step + 1;
        }
    }

    let mut result = {};
    result["dist"] = dist;
    result["parent"] = parent;
    return result;
}

fn reconstruct_path(parent: list, target: int) -> list {
    let mut path = [];
    let mut curr = target;
    while curr != -1 {
        path = [curr] + path;
        curr = parent[curr];
    }
    return path;
}

fn main() -> int {
    println("=== Dijkstra Shortest Path Example ===");

    // Construct 5-city weighted transportation network:
    // 0: London, 1: Paris, 2: Amsterdam, 3: Berlin, 4: Vienna
    let mut adj = {};
    adj[0] = [[1, 4], [2, 2]];
    adj[1] = [[2, 1], [3, 5]];
    adj[2] = [[3, 8], [4, 10]];
    adj[3] = [[4, 2]];

    let result = dijkstra(5, adj, 0);
    let dist = result["dist"];
    let parent = result["parent"];

    println("Shortest distances from source node 0:");
    let mut i = 0;
    while i < 5 {
        println(dist[i]);
        i = i + 1;
    }

    let path_to_4 = reconstruct_path(parent, 4);
    println("Reconstructed shortest path to node 4:");
    let mut p = 0;
    while p < len(path_to_4) {
        println(path_to_4[p]);
        p = p + 1;
    }

    println("Dijkstra calculation finished successfully.");
    return 0;
}
