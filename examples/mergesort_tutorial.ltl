// Lateralus Standard Library Example: Stable MergeSort Pipeline
// Demonstrates O(N log N) divide-and-conquer sorting and stability preservation on financial order books.

fn merge_orders(left: list, right: list) -> list {
    let mut res = [];
    let mut i = 0;
    let mut j = 0;
    let n_left = len(left);
    let n_right = len(right);

    while i < n_left && j < n_right {
        // Price comparison: lower price first; on equal price, preserve arrival order (<=)
        if left[i][0] <= right[j][0] {
            res = res + [left[i]];
            i = i + 1;
        } else {
            res = res + [right[j]];
            j = j + 1;
        }
    }

    while i < n_left {
        res = res + [left[i]];
        i = i + 1;
    }

    while j < n_right {
        res = res + [right[j]];
        j = j + 1;
    }

    return res;
}

fn mergesort_orders(arr: list) -> list {
    let n = len(arr);
    if n <= 1 {
        return arr;
    }

    let mid = n / 2;
    let left = slice(arr, 0, mid);
    let right = slice(arr, mid, n);

    let sorted_left = mergesort_orders(left);
    let sorted_right = mergesort_orders(right);

    return merge_orders(sorted_left, sorted_right);
}

fn main() -> int {
    println("=== Lateralus Stable MergeSort Financial Order Pipeline Demo ===");

    // Order stream: [Price, OrderID]
    // Multiple orders share price 100 with arrival order: "ORD-01", "ORD-03", "ORD-05"
    let raw_orders = [
        [105, "ORD-02"],
        [100, "ORD-01"],
        [102, "ORD-04"],
        [100, "ORD-03"],
        [98,  "ORD-06"],
        [100, "ORD-05"]
    ];

    println("Incoming Raw Unsorted Orders: " + str(raw_orders));

    let sorted_orders = mergesort_orders(raw_orders);
    println("Sorted Price-Time Order Queue: " + str(sorted_orders));

    // Verify lowest price first: 98
    assert(sorted_orders[0][0] == 98);
    assert(sorted_orders[0][1] == "ORD-06");

    // Verify stability on Price 100: ORD-01 must come before ORD-03 and ORD-05!
    assert(sorted_orders[1][0] == 100);
    assert(sorted_orders[1][1] == "ORD-01");

    assert(sorted_orders[2][0] == 100);
    assert(sorted_orders[2][1] == "ORD-03");

    assert(sorted_orders[3][0] == 100);
    assert(sorted_orders[3][1] == "ORD-05");

    println("FIFO Price-Time Priority strictly preserved: [ORD-01, ORD-03, ORD-05]");
    println("\nMergeSort sorting pipeline verified 100% faithful!");
    return 0;
}