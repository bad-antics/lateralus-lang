// Standard Library Prefix Trie Tutorial Verification Suite
// Validates node path traversal, terminal key membership, and prefix bounds.

fn trie_insert(exact_map: dict, prefix_map: dict, word: string) -> int {
    exact_map[word] = 1;
    let w_len = len(word);
    let mut i = 1;
    while i <= w_len {
        let pref = slice(word, 0, i);
        let mut curr_count = 0;
        if contains(prefix_map, pref) {
            curr_count = prefix_map[pref];
        }
        prefix_map[pref] = curr_count + 1;
        i = i + 1;
    }
    return 0;
}

fn trie_contains(exact_map: dict, word: string) -> bool {
    return contains(exact_map, word);
}

fn trie_has_prefix(prefix_map: dict, prefix: string) -> bool {
    if len(prefix) == 0 {
        return true;
    }
    return contains(prefix_map, prefix);
}

fn trie_count_with_prefix(prefix_map: dict, prefix: string) -> int {
    if contains(prefix_map, prefix) {
        return prefix_map[prefix];
    }
    return 0;
}

fn main() -> int {
    let mut exact_words = {};
    let mut prefixes = {};

    // 1. Insert words into Trie
    trie_insert(exact_words, prefixes, "apple");
    trie_insert(exact_words, prefixes, "app");
    trie_insert(exact_words, prefixes, "application");
    trie_insert(exact_words, prefixes, "apt");
    trie_insert(exact_words, prefixes, "banana");

    // 2. Exact word search assertions
    assert(trie_contains(exact_words, "app"));
    assert(trie_contains(exact_words, "apple"));
    assert(trie_contains(exact_words, "application"));
    assert(trie_contains(exact_words, "apt"));
    assert(trie_contains(exact_words, "banana"));

    // Missing exact keys
    assert(!trie_contains(exact_words, "appl")); // Prefix exists, but not exact word
    assert(!trie_contains(exact_words, "ap"));
    assert(!trie_contains(exact_words, "band"));
    assert(!trie_contains(exact_words, "orange"));

    // 3. Prefix search assertions
    assert(trie_has_prefix(prefixes, "app"));
    assert(trie_has_prefix(prefixes, "appl"));
    assert(trie_has_prefix(prefixes, "ban"));
    assert(trie_has_prefix(prefixes, "")); // Empty prefix matches non-empty trie
    assert(!trie_has_prefix(prefixes, "cat"));
    assert(!trie_has_prefix(prefixes, "band"));

    // 4. Prefix frequency counts
    // "app", "apple", "application" all share prefix "app"
    assert(trie_count_with_prefix(prefixes, "app") == 3);
    // "app", "apple", "application", "apt" all share prefix "ap"
    assert(trie_count_with_prefix(prefixes, "ap") == 4);
    assert(trie_count_with_prefix(prefixes, "banana") == 1);
    assert(trie_count_with_prefix(prefixes, "xyz") == 0);

    return 0;
}
