// ===================================================================
// examples/bipartite_matching_tutorial.ltl
// -------------------------------------------------------------------
// Practical example demonstrating Maximum Bipartite Matching for
// peer-to-peer decentralized order crossing and liquidity tranche matching.
// ===================================================================

fn init_adj(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

fn add_bipartite_edge(adj, u, v) {
    adj[u] = push(adj[u], v)
}

fn dfs_augment(u, adj, match_r, visited) {
    let neighbors = adj[u]
    let i = 0
    while i < len(neighbors) {
        let v = neighbors[i]
        if not visited[v] {
            visited[v] = true
            if match_r[v] == -1 or dfs_augment(match_r[v], adj, match_r, visited) {
                match_r[v] = u
                return true
            }
        }
        i = i + 1
    }
    return false
}

pub fn max_bipartite_matching(n1, n2, adj) {
    let match_r = dict()
    let j = 0
    while j < n2 {
        match_r[j] = -1
        j = j + 1
    }

    let match_count = 0
    let u = 0
    while u < n1 {
        let visited = dict()
        let k = 0
        while k < n2 {
            visited[k] = false
            k = k + 1
        }

        if dfs_augment(u, adj, match_r, visited) {
            match_count = match_count + 1
        }
        u = u + 1
    }

    let match_l = dict()
    let l_idx = 0
    while l_idx < n1 {
        match_l[l_idx] = -1
        l_idx = l_idx + 1
    }

    let r_idx = 0
    while r_idx < n2 {
        let matched_u = match_r[r_idx]
        if matched_u != -1 {
            match_l[matched_u] = r_idx
        }
        r_idx = r_idx + 1
    }

    let res = dict()
    res["matching_size"] = match_count
    res["match_l"] = match_l
    res["match_r"] = match_r
    return res
}

pub fn main() {
    print("=== Decentralized Order Book Matching Engine ===")
    print("Executing maximum cardinality bilateral liquidity order cross...")

    // 4 Buyer Orders (Left Set 0..3)
    // 4 Seller Tranches (Right Set 0..3)
    let n1 = 4
    let n2 = 4
    let adj = init_adj(n1)

    // Buyer 0 bids on seller tranches 0 and 1
    add_bipartite_edge(adj, 0, 0)
    add_bipartite_edge(adj, 0, 1)

    // Buyer 1 bids on seller tranches 1 and 2
    add_bipartite_edge(adj, 1, 1)
    add_bipartite_edge(adj, 1, 2)

    // Buyer 2 bids on seller tranches 2 and 3
    add_bipartite_edge(adj, 2, 2)
    add_bipartite_edge(adj, 2, 3)

    // Buyer 3 bids on seller tranche 0
    add_bipartite_edge(adj, 3, 0)

    let match_result = max_bipartite_matching(n1, n2, adj)

    print("Total Matched Orders:")
    print(match_result["matching_size"])

    let buyer = 0
    while buyer < n1 {
        let seller = match_result["match_l"][buyer]
        if seller != -1 {
            print("Matched Pair: Buyer Order -> Seller Tranche:")
            print(buyer)
            print(seller)
        }
        buyer = buyer + 1
    }

    print("Order Book Cleared at Maximum Possible Throughput!")
}
