// Run from checkout with: python3 scripts/run_bitset_tutorial.py
// Models compact RBAC permission sets across two 32-bit words (capacity = 64).

fn main() {
    // 0=READ, 1=WRITE, 2=DEPLOY, 33=AUDIT_LOG, 40=BILLING_ADMIN
    let role_editor = from_list(64, [0, 1])
    let role_ops = from_list(64, [0, 2, 33])

    let combined = union(role_editor, role_ops)
    let shared = intersection(role_editor, role_ops)
    let ops_only = difference(role_ops, role_editor)
    let xor_perms = symmetric_difference(role_editor, role_ops)

    println("cap=" + str(capacity(combined)))
    println("combined=" + to_string(combined))
    println("shared=" + to_string(shared))
    println("ops_only=" + to_string(ops_only))
    println("xor=" + to_string(xor_perms))
    println("editor_subset_combined=" + str(is_subset(role_editor, combined)))
    println("ops_subset_editor=" + str(is_subset(role_ops, role_editor)))

    // Grant temporary BILLING_ADMIN (40), verify, then toggle off
    let elevated = set(combined, 40)
    println("has_40_after_set=" + str(test(elevated, 40)))
    let revoked = toggle(elevated, 40)
    println("has_40_after_toggle=" + str(test(revoked, 40)))
}
