// Rosetta Code: Palindrome detection (case-insensitive, ignoring non-letters)
fn is_palindrome(s: str) -> bool {
    let mut clean = ""
    let mut i = 0
    while i < len(s) {
        let ch = s[i]
        if (ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9") { clean = clean + ch }
        i = i + 1
    }
    let mut lo = 0
    let mut hi = len(clean) - 1
    while lo < hi {
        if clean[lo] != clean[hi] { return false }
        lo = lo + 1
        hi = hi - 1
    }
    return true
}

if is_palindrome("racecar") { println("racecar -> true") }
if is_palindrome("A man, a plan, a canal: Panama") { println("panama -> true") }
if is_palindrome("hello") { println("FAIL") } else { println("hello -> false") }
if is_palindrome("racecar") && !is_palindrome("hello") { println("OK") } else { println("FAIL") }
