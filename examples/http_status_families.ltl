// Offline stdlib.http response-family example.
// Run: python3 -m lateralus_lang run examples/http_status_families.ltl

from stdlib.http import is_ok, is_redirect, is_client_error, is_server_error

fn check(code: int, expected: str) {
    let response = {}
    response["status"] = code
    let family = "none"
    if is_ok(response) { family = "ok" }
    if is_redirect(response) { family = "redirect" }
    if is_client_error(response) { family = "client_error" }
    if is_server_error(response) { family = "server_error" }
    assert(family == expected)
}

fn main() {
    check(199, "none")
    check(200, "ok")
    check(299, "ok")
    check(300, "redirect")
    check(399, "redirect")
    check(400, "client_error")
    check(499, "client_error")
    check(500, "server_error")
    check(599, "server_error")
    check(600, "none")
    println("HTTP status family boundaries pass")
}
