// Lateralus Standard Library Example: Fast Binary Range Search Pipeline
// Demonstrates O(log N) partition point queries, duplicate counting, and bisect search.

fn binary_search(arr: list, target: int) -> int {
    let mut low = 0;
    let mut high = len(arr) - 1;
    while low <= high {
        let mid = low + (high - low) / 2;
        if arr[mid] == target {
            return mid;
        } else if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1;
}

fn lower_bound(arr: list, target: int) -> int {
    let mut low = 0;
    let mut high = len(arr);
    while low < high {
        let mid = low + (high - low) / 2;
        if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

fn upper_bound(arr: list, target: int) -> int {
    let mut low = 0;
    let mut high = len(arr);
    while low < high {
        let mid = low + (high - low) / 2;
        if arr[mid] <= target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

fn main() -> int {
    println("=== Lateralus Logarithmic Binary Range Search Demo ===");

    // Sorted ledger block timestamps:
    let timestamps = [1000, 1050, 1100, 1100, 1100, 1200, 1350, 1500];
    println("Sorted Ledger Timestamps: " + str(timestamps));

    // 1. Exact query
    let target = 1050;
    let pos = binary_search(timestamps, target);
    println("Exact Search for " + str(target) + " -> Found at index " + str(pos));
    assert(pos == 1);

    // 2. Range query: How many events occurred at timestamp 1100?
    let lb = lower_bound(timestamps, 1100);
    let ub = upper_bound(timestamps, 1100);
    let count = ub - lb;
    println("Range Query for timestamp 1100:");
    println("  -> Lower Bound (first index >= 1100): " + str(lb));
    println("  -> Upper Bound (first index > 1100): " + str(ub));
    println("  -> Total Events in Batch: " + str(count) + " (Evaluated in O(log N) time)");
    assert(count == 3);

    // 3. Insertion Index query
    let new_ts = 1150;
    let ins_idx = lower_bound(timestamps, new_ts);
    println("Optimal sorted insertion index for timestamp " + str(new_ts) + ": " + str(ins_idx));
    assert(ins_idx == 5);

    println("\nBinary search and bound partitions verified 100% faithful!");
    return 0;
}