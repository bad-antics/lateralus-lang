// Advent of Code 2024 · Day 6 · Guard Gallivant
// Guard moves forward until blocked, then turns right 90°.
// Part 1: count distinct positions visited before guard leaves map.
// Part 2: count positions where adding one obstruction creates a loop.

let SAMPLE = "....#.....
.........#
..........
..#.......
.......#..
..........
.#..^.....
........#.
#.........
......#..."

fn parse_map(text: str) -> list {
    let lines = str_split(text, "\n")
    let grid = []
    let i = 0
    while i < len(lines) {
        let row = str_trim(lines[i])
        if len(row) > 0 {
            grid = grid + [row]
        }
        i = i + 1
    }
    return grid
}

fn find_guard(grid: list) -> list {
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            let ch = slice(grid[r], c, c + 1)
            if ch == "^" || ch == ">" || ch == "v" || ch == "<" {
                let dir = 0
                if ch == ">" { dir = 1 }
                if ch == "v" { dir = 2 }
                if ch == "<" { dir = 3 }
                return [r, c, dir]
            }
            c = c + 1
        }
        r = r + 1
    }
    return [-1, -1, 0]
}

// dirs: 0=up, 1=right, 2=down, 3=left
let DR = [-1, 0, 1, 0]
let DC = [0, 1, 0, -1]

fn get_cell(grid: list, r: int, c: int) -> str {
    if r < 0 || r >= len(grid) { return "." }
    let row = grid[r]
    if c < 0 || c >= len(row) { return "." }
    return slice(row, c, c + 1)
}

fn walk(grid: list, start_r: int, start_c: int, start_dir: int) -> list {
    // Returns list of visited (r,c) positions, or empty list if loop detected
    let rows = len(grid)
    let cols = len(grid[0])
    let r = start_r
    let c = start_c
    let dir = start_dir
    let visited_pos = {}
    let visited_state = {}
    let path = []

    let max_steps = rows * cols * 4 + 1
    let steps = 0

    while steps < max_steps {
        let state_key = str(r) + "," + str(c) + "," + str(dir)
        if contains(visited_state, state_key) {
            // Loop detected
            return []
        }
        visited_state[state_key] = true

        let pos_key = str(r) + "," + str(c)
        if !contains(visited_pos, pos_key) {
            visited_pos[pos_key] = true
            path = path + [[r, c]]
        }

        let nr = r + DR[dir]
        let nc = c + DC[dir]
        let ahead = get_cell(grid, nr, nc)

        if ahead == "." || ahead == "^" || ahead == ">" || ahead == "v" || ahead == "<" {
            if nr < 0 || nr >= rows || nc < 0 || nc >= cols {
                // Left the map
                return path
            }
            r = nr
            c = nc
        } else {
            // Obstacle — turn right
            dir = (dir + 1) % 4
        }
        steps = steps + 1
    }
    return []
}

fn set_cell(grid: list, r: int, c: int, ch: str) -> list {
    let new_grid = []
    let i = 0
    while i < len(grid) {
        if i == r {
            let row = grid[i]
            let new_row = slice(row, 0, c) + ch + slice(row, c + 1, len(row))
            new_grid = new_grid + [new_row]
        } else {
            new_grid = new_grid + [grid[i]]
        }
        i = i + 1
    }
    return new_grid
}

fn part1(text: str) -> int {
    let grid = parse_map(text)
    let guard = find_guard(grid)
    let path = walk(grid, guard[0], guard[1], guard[2])
    return len(path)
}

fn part2(text: str) -> int {
    let grid = parse_map(text)
    let guard = find_guard(grid)
    let gr = guard[0]
    let gc = guard[1]
    let gdir = guard[2]

    // Only check positions along the guard's normal path
    let path = walk(grid, gr, gc, gdir)
    let count = 0
    let tried = {}
    let i = 0
    while i < len(path) {
        let pr = path[i][0]
        let pc = path[i][1]
        let key = str(pr) + "," + str(pc)
        if !contains(tried, key) && !(pr == gr && pc == gc) {
            tried[key] = true
            let orig = get_cell(grid, pr, pc)
            if orig == "." {
                let new_grid = set_cell(grid, pr, pc, "#")
                let result = walk(new_grid, gr, gc, gdir)
                if len(result) == 0 {
                    count = count + 1
                }
            }
        }
        i = i + 1
    }
    return count
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 41)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 6)
}

fn main() {
    print("Day 6 Part 1: " + str(part1(SAMPLE)))
    print("Day 6 Part 2: " + str(part2(SAMPLE)))
}

main()
