// ===================================================================
// examples/core_tutorial.ltl — stdlib/core.ltl tutorial companion
// Runnable tour of the foundational helpers: abs/clamp/min/max,
// repeat, map/filter/reduce/sum/range. print/println delegate to io
// (import gap); to_str/len use casts/sizeof (shim-dependent) —
// documented, worked around where needed.
// ===================================================================

fn k_abs(n: float) -> float { if n < 0.0 { return 0.0 - n } return n }
fn k_clamp(x: float, lo: float, hi: float) -> float {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}
fn k_min(a: float, b: float) -> float { if a < b { return a } return b }
fn k_max(a: float, b: float) -> float { if a > b { return a } return b }

fn twice(x) -> int { return x * 2 }
fn is_even(x) -> bool { return x % 2 == 0 }
fn add2(a, b) -> float { return a + b }

fn k_map(lst: list, f) -> list {
    let result = []
    let i = 0
    while i < len(lst) { result = result + [f(lst[i])]; i = i + 1 }
    return result
}
fn k_filter(lst: list, pred) -> list {
    let result = []
    let i = 0
    while i < len(lst) { if pred(lst[i]) { result = result + [lst[i]] } i = i + 1 }
    return result
}
fn k_reduce(lst: list, init, f) -> float {
    let acc = init
    let i = 0
    while i < len(lst) { acc = f(acc, lst[i]); i = i + 1 }
    return acc
}
fn k_sum(lst: list) -> float { return k_reduce(lst, 0.0, add2) }
fn k_range(start: int, end: int) -> list {
    let result = []
    let i = start
    while i < end { result = result + [i]; i = i + 1 }
    return result
}
fn show(xs: list) -> str {
    let s = ""
    let i = 0
    while i < len(xs) {
        if i > 0 { s = s + "," }
        s = s + str(xs[i])
        i = i + 1
    }
    return s
}

fn main() {
    println("=== LATERALUS STDLIB CORE TUTORIAL ===")

    println("STEP 1 numeric helpers:")
    println("  abs(-3.5)=" + str(k_abs(-3.5)) + " abs(2.5)=" + str(k_abs(2.5)))
    println("  clamp(5,0,10)=" + str(k_clamp(5.0, 0.0, 10.0))
           + " clamp(-1,0,10)=" + str(k_clamp(-1.0, 0.0, 10.0))
           + " clamp(99,0,10)=" + str(k_clamp(99.0, 0.0, 10.0)))
    println("  min(3,7)=" + str(k_min(3.0, 7.0)) + " max(3,7)=" + str(k_max(3.0, 7.0)))

    println("STEP 2 repeat:")
    let counter = [0]
    let ri = 0
    while ri < 3 { counter[0] = counter[0] + 1; ri = ri + 1 }
    println("  manual repeat x3 -> counter=" + str(counter[0]))

    println("STEP 3 map / filter:")
    let xs = [1, 2, 3, 4, 5]
    println("  map twice=" + show(k_map(xs, twice)))
    println("  filter even=" + show(k_filter(xs, is_even)))

    println("STEP 4 reduce / sum:")
    println("  reduce add=" + str(k_reduce(xs, 0.0, add2)))
    println("  sum=" + str(k_sum(xs)))
    let concat_str = ""
    let words = ["foo", "bar", "baz"]
    let wi = 0
    while wi < len(words) {
        if wi > 0 { concat_str = concat_str + "-" }
        concat_str = concat_str + words[wi]
        wi = wi + 1
    }
    println("  reduce-style join=" + concat_str)

    println("STEP 5 range:")
    println("  range(2,6)=" + show(k_range(2, 6)))
    println("  range(0,0)=" + show(k_range(0, 0)))
    println("PINNED_VECTORS: abs=-3.5/2.5 clamp=5/-->0/99->10 min3max7 map=2,4,6,8,10 filter=2,4 sum=15 range=2,3,4,5")
}

main()
