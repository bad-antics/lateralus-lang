// Rosetta Code · Matrix multiplication · Lateralus
// Matrices are lists of rows; empty inner lists mean a zero row.

fn mat_mul(a: list, b: list) -> list {
    let rows = len(a)
    let cols = len(b[0])
    let inner = len(b)
    let out = []
    let i = 0
    while i < rows {
        let row = []
        let j = 0
        while j < cols {
            let acc = 0
            let k = 0
            while k < inner {
                acc = acc + a[i][k] * b[k][j]
                k = k + 1
            }
            row = row + [acc]
            j = j + 1
        }
        out = out + [row]
        i = i + 1
    }
    return out
}

fn main() {
    let a = [[1, 2], [3, 4]]
    let b = [[5, 6], [7, 8]]
    assert_eq(mat_mul(a, b), [[19, 22], [43, 50]], "2x2")
    let c = [[1, 2, 3]]
    let d = [[4], [5], [6]]
    assert_eq(mat_mul(c, d), [[32]], "1x3 * 3x1")
    print("A*B = " + str(mat_mul(a, b)))
}

main()
