// ===================================================================
// examples/random_tutorial.ltl — stdlib/random.ltl tutorial companion
// Runnable tour of the RNG module: seeding, uniform floats, inclusive
// int ranges, choice/sample/shuffle. Self-contained — calls the same
// primitives the transpiler exposes, with seed(42) for determinism.
// ===================================================================

fn uniform(lo: float, hi: float) -> float {
    return lo + random_float() * (hi - lo)
}

fn rand_int(lo: int, hi: int) -> int {
    return random_int(lo, hi)
}

fn choice(lst: list) -> str {
    if len(lst) == 0 {
        return "<empty>"
    }
    return str(random_choice(lst))
}

fn shuffle(lst: list) -> list {
    return random_shuffle(lst)
}

fn sample(lst: list, k: int) -> list {
    return random_sample(lst, k)
}

fn main() {
    println("=== LATERALUS STDLIB RANDOM TUTORIAL ===")

    random_seed(42)
    println("STEP 1 random() = " + str(random_float()))
    println("STEP 1 rand_int(1,10) x2 = " + str(rand_int(1, 10)) + ", " + str(rand_int(1, 10)))

    random_seed(7)
    println("STEP 2 uniform(10,20) = " + str(uniform(10.0, 20.0)))
    println("STEP 2 uniform(-5,5) = " + str(uniform(-5.0, 5.0)))

    random_seed(42)
    println("STEP 3 choice = " + choice(["red", "green", "blue"]))
    println("STEP 3 choice(empty) = " + choice([]))

    random_seed(42)
    let orig = [1, 2, 3, 4, 5]
    let shuffled = shuffle(orig)
    println("STEP 4 shuffle = [" + join(shuffled, ",") + "] orig still = [" + join(orig, ",") + "]")

    random_seed(42)
    println("STEP 5 sample([1..8],3) = [" + join(sample([1, 2, 3, 4, 5, 6, 7, 8], 3), ",") + "]")

    random_seed(99)
    println("STEP 6 different seed -> rand_int(1,100) = " + str(rand_int(1, 100)))
    println("PINNED_VECTORS: seed42_rand=0.6394267984578837 ints=1,5 uni=13.238327648331623,-3.4915082607549808 choice=blue sample=2,1,6 shuffle=4,2,3,5,1|1,2,3,4,5 seed99_1_100=52")
}

main()
