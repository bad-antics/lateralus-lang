// Pinned test vectors for stdlib/roaring.ltl
import roaring

@test
fn test_roaring_containers_and_dedup() {
    let a = new_bitmap()
    a = add(a, 1)
    a = add(a, 42)
    a = add(a, 65536)
    a = add(a, 65537)
    a = add(a, 131072)
    a = add(a, 42)

    assert(cardinality(a) == 5)
    assert(has(a, 65536))
    assert(!has(a, 65535))
    assert(to_list(a) == [1, 42, 65536, 65537, 131072])
}

@test
fn test_roaring_union_sorted() {
    let a = new_bitmap()
    a = add(a, 1)
    a = add(a, 42)
    a = add(a, 65536)
    a = add(a, 65537)
    a = add(a, 131072)

    let b = new_bitmap()
    b = add(b, 42)
    b = add(b, 999)
    b = add(b, 65537)

    let u = union(a, b)
    assert(cardinality(u) == 6)
    assert(to_list(u) == [1, 42, 999, 65536, 65537, 131072])
}
