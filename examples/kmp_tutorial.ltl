// Lateralus Standard Library Example: Knuth-Morris-Pratt (KMP) Log Scanner
// Demonstrates backtrack-free linear substring matching across server log streams.

fn build_lps(p: string) -> list {
    let mut table = [0];
    let mut prev = 0;
    let mut i = 1;
    while i < len(p) {
        if slice(p, i, i + 1) == slice(p, prev, prev + 1) {
            prev = prev + 1;
            table.append(prev);
            i = i + 1;
        } else {
            if prev != 0 {
                prev = table[prev - 1];
            } else {
                table.append(0);
                i = i + 1;
            }
        }
    }
    return table;
}

fn scan_log(log_line: string, target_pattern: string) -> int {
    let lps = build_lps(target_pattern);
    let mut i = 0;
    let mut j = 0;
    let t_len = len(log_line);
    let p_len = len(target_pattern);

    while i < t_len {
        if slice(log_line, i, i + 1) == slice(target_pattern, j, j + 1) {
            i = i + 1;
            j = j + 1;
            if j == p_len {
                return i - j;
            }
        } else {
            if j != 0 {
                j = lps[j - 1];
            } else {
                i = i + 1;
            }
        }
    }
    return -1;
}

fn main() -> int {
    println("=== Lateralus KMP Security Log Scanner Demo ===");

    let log1 = "[INFO] 127.0.0.1 - GET /api/v1/users 200 OK";
    let log2 = "[ALERT] 192.168.1.5 - POST /admin?exec=malicious_payload 403 FORBIDDEN";

    println("Inspecting Log 1 for API route '/api/v1'...");
    let offset1 = scan_log(log1, "/api/v1");
    println("  -> Pattern matched at offset: " + str(offset1));
    assert(offset1 == 23);

    println("Inspecting Log 2 for exploit signature 'malicious_payload'...");
    let offset2 = scan_log(log2, "malicious_payload");
    println("  -> EXPLOIT DETECTED at offset: " + str(offset2));
    assert(offset2 == 39);

    println("KMP inspection completed in O(N + M) without backtracking on text streams!");
    return 0;
}
