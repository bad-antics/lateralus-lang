// ===================================================================
// examples/regex_log_extraction.ltl — stdlib/regex.ltl tutorial
// Extracting structured job IDs from build logs with regular expressions.
// Demonstrates find_first and find_all with fixed test vectors.
// ===================================================================

import stdlib.regex as regex

fn extract_first_job_id(log_line: str) -> str {
    return regex.find_first("[a-z]+-[0-9]+", log_line)
}

fn extract_all_job_ids(log_line: str) -> list {
    return regex.find_all("[a-z]+-[0-9]+", log_line)
}

fn has_active_jobs(log_line: str) -> bool {
    return regex.is_match("[a-z]+-[0-9]+", log_line)
}

fn list_to_str(items: list) -> str {
    let mut out = "["
    let mut i = 0
    while i < len(items) {
        if i > 0 {
            out = out + ", "
        }
        out = out + str(items[i])
        i = i + 1
    }
    return out + "]"
}

fn main() {
    println("=== LATERALUS STDLIB REGEX TUTORIAL: LOG EXTRACTION ===")

    let log_with_jobs = "jobs: sync-104, build-7, ignored"
    let log_without_jobs = "jobs: none"

    println("Vector 1: Active build log:")
    println("  Input: " + log_with_jobs)
    let first_job = extract_first_job_id(log_with_jobs)
    let all_jobs = extract_all_job_ids(log_with_jobs)
    let is_active = has_active_jobs(log_with_jobs)

    println("  First Job ID: " + first_job)
    println("  All Job IDs:  " + list_to_str(all_jobs))
    println("  Has Jobs:     " + str(is_active))

    println("Vector 2: Empty build log:")
    println("  Input: " + log_without_jobs)
    let no_first = extract_first_job_id(log_without_jobs)
    let no_all = extract_all_job_ids(log_without_jobs)
    let no_active = has_active_jobs(log_without_jobs)

    println("  First Job ID: " + no_first)
    println("  All Job IDs:  " + list_to_str(no_all))
    println("  Has Jobs:     " + str(no_active))

    println("PINNED_VECTORS: first=sync-104 all=[sync-104, build-7] has=True empty_first= empty_all=[] empty_has=False")
    println("  ✓ examples/regex_log_extraction.ltl: OK")
}
