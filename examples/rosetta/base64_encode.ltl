// Rosetta Code · Base64 encode · Lateralus
// RFC 4648 alphabet, standard "=" padding, ASCII input.

fn b64_alphabet() -> str {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

fn b64_char(v: int) -> str {
    let a = b64_alphabet()
    return slice(a, v, v + 1)
}

fn base64_encode(s: str) -> str {
    let out = ""
    let i = 0
    while i < len(s) {
        let b0 = imod(ord(slice(s, i, i + 1)), 256)
        let b1 = 0
        let b2 = 0
        let have1 = 0
        let have2 = 0
        if i + 1 < len(s) { b1 = imod(ord(slice(s, i + 1, i + 2)), 256)  have1 = 1 }
        if i + 2 < len(s) { b2 = imod(ord(slice(s, i + 2, i + 3)), 256)  have2 = 1 }
        out = out + b64_char(idiv(b0, 4))
        out = out + b64_char(imod(b0, 4) * 16 + idiv(b1, 16))
        if have1 == 1 { out = out + b64_char(imod(b1, 16) * 4 + idiv(b2, 64)) } else { out = out + "=" }
        if have2 == 1 { out = out + b64_char(imod(b2, 64)) } else { out = out + "=" }
        i = i + 3
    }
    return out
}

fn main() {
    assert_eq(base64_encode(""), "", "empty")
    assert_eq(base64_encode("f"), "Zg==", "1 byte")
    assert_eq(base64_encode("fo"), "Zm8=", "2 bytes")
    assert_eq(base64_encode("foo"), "Zm9v", "3 bytes")
    assert_eq(base64_encode("foob"), "Zm9vYg==", "4 bytes")
    assert_eq(base64_encode("fooba"), "Zm9vYmE=", "5 bytes")
    assert_eq(base64_encode("foobar"), "Zm9vYmFy", "6 bytes")
    print("base64(\"Lateralus\") = " + base64_encode("Lateralus"))
}

main()
