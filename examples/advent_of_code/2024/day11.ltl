// Advent of Code 2024 · Day 11 · Plutonian Pebbles
// Blink rules: 0 -> 1; even digit count -> split in half; otherwise n * 2024.
// Part 1: stones after 25 blinks. Part 2: after 75 blinks (multiset counting).
// Self-verifying with @test blocks; sample from the AoC statement.

let SAMPLE = "125 17"

fn parse(text: str) -> dict {
    let counts = {}
    for tok in str_split(str_trim(text), " ") {
        let t = str_trim(tok)
        if len(t) > 0 {
            if contains(counts, t) { counts[t] = counts[t] + 1 } else { counts[t] = 1 }
        }
    }
    return counts
}

fn blink(counts: dict) -> dict {
    let out = {}
    for k in keys(counts) {
        let n = counts[k]
        let s = k
        if s == "0" {
            if contains(out, "1") { out["1"] = out["1"] + n } else { out["1"] = n }
        } else if len(s) % 2 == 0 {
            let half = int(len(s) / 2)
            let a = slice(s, 0, half)
            let b = slice(s, half, len(s))
            let an = str(int(a))
            let bn = str(int(b))
            if contains(out, an) { out[an] = out[an] + n } else { out[an] = n }
            if contains(out, bn) { out[bn] = out[bn] + n } else { out[bn] = n }
        } else {
            let m = str(int(s) * 2024)
            if contains(out, m) { out[m] = out[m] + n } else { out[m] = n }
        }
    }
    return out
}

fn total_after(text: str, blinks: int) -> int {
    let counts = parse(text)
    let i = 0
    while i < blinks {
        counts = blink(counts)
        i = i + 1
    }
    let total = 0
    for k in keys(counts) { total = total + counts[k] }
    return total
}

@test
fn test_part1() {
    assert_eq(total_after(SAMPLE, 25), 55312)
}

fn main() {
    print("Day 11 Part 1: " + str(total_after(SAMPLE, 25)))
    print("Day 11 Part 2: " + str(total_after(SAMPLE, 75)))
}

main()
