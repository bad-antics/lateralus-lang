// Standard Library CRC-32 (IEEE 802.3) Tutorial Verification Suite
// Validates reversed polynomial 0xEDB88320, byte updates, and canonical golden vectors.

fn ascii_code(ch: string) -> int {
    if ch == "1" { return 49; }
    if ch == "2" { return 50; }
    if ch == "3" { return 51; }
    if ch == "4" { return 52; }
    if ch == "5" { return 53; }
    if ch == "6" { return 54; }
    if ch == "7" { return 55; }
    if ch == "8" { return 56; }
    if ch == "9" { return 57; }
    if ch == "A" { return 65; }
    if ch == "B" { return 66; }
    if ch == "C" { return 67; }
    return 0;
}

// Single byte bitwise polynomial reduction (IEEE 802.3: 0xEDB88320 = 3988292384)
fn crc32_step(crc_in: int, byte_val: int) -> int {
    let mut c = crc_in ^ byte_val;
    let poly = 3988292384;
    let mut i = 0;
    while i < 8 {
        if (c & 1) != 0 {
            c = (c >> 1) ^ poly;
        } else {
            c = c >> 1;
        }
        i = i + 1;
    }
    return c;
}

// Computes complete CRC-32 for digit sequences
fn crc32_compute_digits(data: string) -> int {
    let mut crc = 4294967295; // 0xFFFFFFFF initial state
    let d_len = len(data);
    let mut idx = 0;

    while idx < d_len {
        let ch = slice(data, idx, idx + 1);
        let b = ascii_code(ch);
        crc = crc32_step(crc, b);
        idx = idx + 1;
    }

    return crc ^ 4294967295; // XOR out
}

fn main() -> int {
    // 1. Empty string yields 0x00000000
    let empty_crc = crc32_compute_digits("");
    assert(empty_crc == 0);

    // 2. Canonical IEEE 802.3 Golden Vector: "123456789" -> 0xCBF43926 (3421780262)
    let golden_crc = crc32_compute_digits("123456789");
    assert(golden_crc == 3421780262);

    // 3. Single character update consistency
    let crc_1 = crc32_compute_digits("1");
    assert(crc_1 != 0);

    // 4. Invariant: Different inputs produce distinct checksums
    let crc_12 = crc32_compute_digits("12");
    let crc_13 = crc32_compute_digits("13");
    assert(crc_12 != crc_13);

    return 0;
}
