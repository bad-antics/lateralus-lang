// ===================================================================
// Lateralus Example: stdlib.suffix_array — Suffix Arrays & Kasai's LCP
// -------------------------------------------------------------------
// Prefix-doubling suffix array construction and Kasai's linear-time
// Longest Common Prefix (LCP) algorithm for repeated substring discovery
// and sub-linear string pattern search.
// ===================================================================

import suffix_array

fn main() {
    println("=== Suffix Array & LCP Analysis ===")

    // Canonical textbook example: "banana"
    let text = "banana"
    println("Input text: '" + text + "' (length: " + str(len(text)) + ")")

    // 1. Construct Suffix Array
    let sa = build(text)
    println("\n[1] Suffix Array (Lexicographically Sorted Suffix Indices):")
    println("  SA: " + str(sa))

    // Display suffixes in sorted order
    let i = 0
    while i < len(sa) {
        let idx = sa[i]
        let sfx = slice(text, idx, len(text))
        println("  SA[" + str(i) + "] = " + str(idx) + " -> '" + sfx + "'")
        i = i + 1
    }

    // 2. Construct LCP Array via Kasai's Algorithm
    let l = lcp(text, sa)
    println("\n[2] Longest Common Prefix (LCP) Array:")
    println("  LCP: " + str(l))

    // 3. Find Longest Repeated Substring
    let repeated = longest_repeated(text)
    println("\n[3] Longest Repeated Substring:")
    println("  Repeated sequence: '" + repeated + "'")

    // 4. Binary Pattern Search
    println("\n[4] Pattern Search via Suffix Array:")
    let queries = ["ana", "ban", "nan", "xyz"]
    let q = 0
    while q < len(queries) {
        let pat = queries[q]
        let pos = search(text, sa, pat)
        if pos >= 0 {
            println("  Found pattern '" + pat + "' at text index: " + str(pos))
        } else {
            println("  Pattern '" + pat + "' not found (-1)")
        }
        q = q + 1
    }
}

main()
