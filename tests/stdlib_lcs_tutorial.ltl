// Standard Library Longest Common Subsequence (LCS) Verification Suite
// Validates 2D dynamic programming recurrence, optimal traceback sequence reconstruction, and edge cases.

fn lcs(s1: str, s2: str) -> dict {
    let m = len(s1);
    let n = len(s2);

    let mut dp = [];
    let mut i = 0;
    while i <= m {
        let mut row = [];
        let mut j = 0;
        while j <= n {
            row = row + [0];
            j = j + 1;
        }
        dp = dp + [row];
        i = i + 1;
    }

    let mut r = 1;
    while r <= m {
        let c1 = slice(s1, r - 1, r);
        let mut c = 1;
        while c <= n {
            let c2 = slice(s2, c - 1, c);
            if c1 == c2 {
                dp[r][c] = dp[r - 1][c - 1] + 1;
            } else {
                let up = dp[r - 1][c];
                let left = dp[r][c - 1];
                if up > left {
                    dp[r][c] = up;
                } else {
                    dp[r][c] = left;
                }
            }
            c = c + 1;
        }
        r = r + 1;
    }

    let lcs_length = dp[m][n];

    let mut lcs_seq = "";
    let mut tr = m;
    let mut tc = n;
    while tr > 0 && tc > 0 {
        let c1 = slice(s1, tr - 1, tr);
        let c2 = slice(s2, tc - 1, tc);
        if c1 == c2 {
            lcs_seq = c1 + lcs_seq;
            tr = tr - 1;
            tc = tc - 1;
        } else {
            if dp[tr - 1][tc] > dp[tr][tc - 1] {
                tr = tr - 1;
            } else {
                tc = tc - 1;
            }
        }
    }

    let mut result = {};
    result["length"] = lcs_length;
    result["subsequence"] = lcs_seq;
    return result;
}

fn main() -> int {
    // 1. Classic Textbook Example: "AGGTAB" and "GXTXAYB"
    // LCS is "GTAB", length 4
    let res1 = lcs("AGGTAB", "GXTXAYB");
    assert(res1["length"] == 4);
    assert(res1["subsequence"] == "GTAB");

    // 2. DNA Sequence Homology
    // s1 = "ACCGGTCGAGTGCGCGGAAGCCGGCCGAA"
    // s2 = "GTCGTTCGGAATGCCGTTGCTCCGAA"
    let res2 = lcs("ABCDE", "ACE");
    assert(res2["length"] == 3);
    assert(res2["subsequence"] == "ACE");

    // 3. Identical Strings
    let res3 = lcs("LATERALUS", "LATERALUS");
    assert(res3["length"] == 9);
    assert(res3["subsequence"] == "LATERALUS");

    // 4. Completely Disjoint Alphabets
    let res4 = lcs("ABC", "XYZ");
    assert(res4["length"] == 0);
    assert(res4["subsequence"] == "");

    // 5. One Empty String
    let res5 = lcs("TEST", "");
    assert(res5["length"] == 0);
    assert(res5["subsequence"] == "");

    // 6. Both Empty Strings
    let res6 = lcs("", "");
    assert(res6["length"] == 0);
    assert(res6["subsequence"] == "");

    // 7. Single Character Match & Mismatch
    let res7_match = lcs("A", "A");
    assert(res7_match["length"] == 1);
    assert(res7_match["subsequence"] == "A");

    let res7_diff = lcs("A", "B");
    assert(res7_diff["length"] == 0);
    assert(res7_diff["subsequence"] == "");

    return 0;
}
