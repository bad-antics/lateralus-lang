// ===================================================================
// examples/matrix_exponentiation_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: Telecommunications Backbone Route Counting and
// Multi-Hop Path Analysis using Matrix Binary Exponentiation.
// ===================================================================

pub fn identity_matrix(k) {
    let I = dict()
    let i = 0
    while i < k {
        let row = dict()
        let j = 0
        while j < k {
            if i == j {
                row[j] = 1
            } else {
                row[j] = 0
            }
            j = j + 1
        }
        I[i] = row
        i = i + 1
    }
    return I
}

pub fn matrix_multiply(A, B, k, mod_val) {
    let C = dict()
    let i = 0
    while i < k {
        let row = dict()
        let j = 0
        while j < k {
            let sum = 0
            let p = 0
            while p < k {
                let term = (A[i][p] * B[p][j]) % mod_val
                sum = (sum + term) % mod_val
                p = p + 1
            }
            row[j] = sum
            j = j + 1
        }
        C[i] = row
        i = i + 1
    }
    return C
}

pub fn matrix_power(A, power, k, mod_val) {
    let res = identity_matrix(k)
    let base = dict()
    let i = 0
    while i < k {
        let row = dict()
        let j = 0
        while j < k {
            row[j] = A[i][j] % mod_val
            j = j + 1
        }
        base[i] = row
        i = i + 1
    }

    let p = power
    while p > 0 {
        if p % 2 != 0 {
            res = matrix_multiply(res, base, k, mod_val)
        }
        base = matrix_multiply(base, base, k, mod_val)
        p = p / 2
    }

    return res
}

pub fn main() {
    print("=== Telecom Multi-Hop Backbone Network Simulation ===")
    let mod_val = 1000000007

    // Network topology with 4 Datacenters:
    // DC0: North Virginia, DC1: Frankfurt, DC2: Singapore, DC3: Tokyo
    // Direct fiber links:
    // DC0 <-> DC1 (bidirectional)
    // DC1 <-> DC2 (bidirectional)
    // DC2 <-> DC3 (bidirectional)
    // DC3 <-> DC0 (trans-Pacific direct link)
    let adj = dict()
    
    let r0 = dict()
    r0[0] = 0; r0[1] = 1; r0[2] = 0; r0[3] = 1
    adj[0] = r0

    let r1 = dict()
    r1[0] = 1; r1[1] = 0; r1[2] = 1; r1[3] = 0
    adj[1] = r1

    let r2 = dict()
    r2[0] = 0; r2[1] = 1; r2[2] = 0; r2[3] = 1
    adj[2] = r2

    let r3 = dict()
    r3[0] = 1; r3[1] = 0; r3[2] = 1; r3[3] = 0
    adj[3] = r3

    let hops = 4
    let paths_4_hops = matrix_power(adj, hops, 4, mod_val)

    print("Analyzing path diversity for 4-hop packet forwarding:")
    let dc0_to_dc0 = paths_4_hops[0][0]
    let dc0_to_dc2 = paths_4_hops[0][2]
    print("Number of 4-hop routes from DC0 back to DC0: ")
    print(dc0_to_dc0)
    print("Number of 4-hop routes from DC0 across to DC2: ")
    print(dc0_to_dc2)

    // Verification against theoretical combinatorial paths in 4-cycle graph
    assert(dc0_to_dc0 == 8, "Expected 8 return paths for 4-cycle after 4 hops")
    assert(dc0_to_dc2 == 8, "Expected 8 cross paths for 4-cycle after 4 hops")

    print("Telecom network topology multi-hop routing analysis completed!")
}
