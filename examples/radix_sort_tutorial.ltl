// ===================================================================
// Lateralus Example: stdlib.radix_sort — Non-Comparison Sorting Tour
// -------------------------------------------------------------------
// Linear-time O(n) sorting algorithms that bypass comparator overhead:
// - radix_sort_u32 / radix_sort_u64: LSD byte passes for unsigned integers
// - radix_sort_i32: Signed integer sorting via sign-bit inversion
// - radix_sort_str: MSD recursive bucket sort for strings
// - counting_sort: O(n + k) direct index accumulation
// ===================================================================

import radix_sort

fn main() {
    println("=== High-Performance Non-Comparison Sorts ===")

    // 1. Unsigned 32-bit Integers (LSD Radix)
    let u_nums = [170, 45, 75, 90, 802, 24, 2, 66]
    let u_sorted = radix_sort_u32(u_nums)
    println("[1] Unsigned 32-bit Radix Sort:")
    println("  Input:  " + str(u_nums))
    println("  Sorted: " + str(u_sorted))

    // 2. Signed 32-bit Integers (Negative & Positive)
    let i_nums = [170, -45, 75, -90, 802, -24, 2, -66, 0]
    let i_sorted = radix_sort_i32(i_nums)
    println("\n[2] Signed 32-bit Radix Sort (Sign-Bit Inversion):")
    println("  Input:  " + str(i_nums))
    println("  Sorted: " + str(i_sorted))

    // 3. String Radix Sort (MSD Trie-like Bucket Sort)
    let words = ["banana", "apple", "cherry", "date", "apricot", "avocado"]
    let words_sorted = radix_sort_str(words)
    println("\n[3] String MSD Radix Sort:")
    println("  Input:  " + str(words))
    println("  Sorted: " + str(words_sorted))

    // 4. Counting Sort for Bounded Ranges
    let bounded = [4, 2, 2, 8, 3, 3, 1, 0, 5]
    let bounded_sorted = counting_sort(bounded, 10)
    println("\n[4] Counting Sort (Bounded Range k=10):")
    println("  Input:  " + str(bounded))
    println("  Sorted: " + str(bounded_sorted))
}

main()
