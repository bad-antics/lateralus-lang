-- stdlib/bitflags.ltl
-- Type-safe protocol & permission bitmasks, pipeline-friendly.
--
-- Design notes:
--   * Every operation takes the flag set FIRST so it composes with `|>`.
--   * Named-flag lookups return Result (Ok / Err) -- unknown names are
--     reported, never silently ignored.
--   * clear is width-agnostic: (flags | mask) ^ mask removes the bits in
--     `mask` without needing a fixed-width bitwise NOT.
--
-- Example:
--   let perms = bf_empty() |> bf_set(READ) |> bf_set(WRITE)
--   perms |> bf_has(WRITE)   -- true

-- ---------------------------------------------------------------
-- Construction
-- ---------------------------------------------------------------

--- The empty flag set.
fn bf_empty() {
    return 0
}

--- Build a flag set from a list of single-bit masks.
fn bf_from_list(masks) {
    let acc = 0
    for m in masks {
        acc = acc | m
    }
    return acc
}

--- The mask for bit position `n` (0-based).
fn bf_bit(n) {
    return 1 << n
}

-- ---------------------------------------------------------------
-- Core operations (flag set first => pipeline friendly)
-- ---------------------------------------------------------------

--- Set (turn on) all bits of `mask`.
fn bf_set(flags, mask) {
    return flags | mask
}

--- Clear (turn off) all bits of `mask`. Width-agnostic:
--- (flags | mask) ^ mask forces the mask bits on, then flips them off,
--- leaving every other bit untouched.
fn bf_clear(flags, mask) {
    return (flags | mask) ^ mask
}

--- Toggle all bits of `mask`.
fn bf_toggle(flags, mask) {
    return flags ^ mask
}

--- True when ALL bits of `mask` are set in `flags`.
fn bf_has(flags, mask) {
    return (flags & mask) == mask
}

--- True when ANY bit of `mask` is set in `flags`.
fn bf_has_any(flags, mask) {
    return (flags & mask) != 0
}

--- True when no bits are set.
fn bf_is_empty(flags) {
    return flags == 0
}

-- ---------------------------------------------------------------
-- Set algebra
-- ---------------------------------------------------------------

--- Union of two flag sets.
fn bf_union(a, b) {
    return a | b
}

--- Intersection of two flag sets.
fn bf_intersect(a, b) {
    return a & b
}

--- Difference: bits in `a` that are not in `b`.
fn bf_difference(a, b) {
    return bf_clear(a, b)
}

--- Complement of `flags` within a bounded `universe` mask.
--- universe ^ (flags & universe) never depends on integer width.
fn bf_complement(flags, universe) {
    return universe ^ (flags & universe)
}

-- ---------------------------------------------------------------
-- Inspection
-- ---------------------------------------------------------------

--- Number of set bits (population count).
fn bf_count(flags) {
    let n = 0
    let v = flags
    while v != 0 {
        n = n + (v & 1)
        v = v >> 1
    }
    return n
}

--- Render the lowest `width` bits as a binary string, MSB first.
fn bf_to_binary(flags, width) {
    let out = ""
    let i = width - 1
    while i >= 0 {
        if ((flags >> i) & 1) == 1 {
            out = out + "1"
        } else {
            out = out + "0"
        }
        i = i - 1
    }
    return out
}

-- ---------------------------------------------------------------
-- Named flags with Result validation
-- ---------------------------------------------------------------
-- A "table" is a list of [name, mask] pairs, e.g.
--   [["READ", 4], ["WRITE", 2], ["EXEC", 1]]

--- Look up a flag mask by name. Ok(mask) or Err(message).
fn bf_lookup(table, name) {
    for entry in table {
        if entry[0] == name {
            return Ok(entry[1])
        }
    }
    return Err("unknown flag: " + name)
}

--- Set a named flag. Returns Ok(new_flags) or Err on unknown name.
fn bf_set_named(flags, table, name) {
    let r = bf_lookup(table, name)
    match r {
        Ok(mask) => Ok(bf_set(flags, mask)),
        Err(e) => Err(e)
    }
}

--- Clear a named flag. Returns Ok(new_flags) or Err on unknown name.
fn bf_clear_named(flags, table, name) {
    let r = bf_lookup(table, name)
    match r {
        Ok(mask) => Ok(bf_clear(flags, mask)),
        Err(e) => Err(e)
    }
}

--- Toggle a named flag. Returns Ok(new_flags) or Err on unknown name.
fn bf_toggle_named(flags, table, name) {
    let r = bf_lookup(table, name)
    match r {
        Ok(mask) => Ok(bf_toggle(flags, mask)),
        Err(e) => Err(e)
    }
}

--- Test a named flag. Returns Ok(bool) or Err on unknown name.
fn bf_has_named(flags, table, name) {
    let r = bf_lookup(table, name)
    match r {
        Ok(mask) => Ok(bf_has(flags, mask)),
        Err(e) => Err(e)
    }
}

--- Build a flag set from a list of names. Fails on the first unknown name.
fn bf_from_names(table, names) {
    let acc = 0
    for name in names {
        let r = bf_lookup(table, name)
        match r {
            Ok(mask) => {
                acc = acc | mask
            },
            Err(e) => {
                return Err(e)
            }
        }
    }
    return Ok(acc)
}

--- List the names of all flags set in `flags`, in table order.
fn bf_names(flags, table) {
    let out = []
    for entry in table {
        if bf_has(flags, entry[1]) {
            out = out + [entry[0]]
        }
    }
    return out
}

-- ---------------------------------------------------------------
-- Reference flag tables (RFC 9293 TCP control bits, POSIX modes)
-- ---------------------------------------------------------------

--- TCP header control bits (RFC 9293 Section 3.1).
fn tcp_flags_table() {
    return [
        ["FIN", 1],
        ["SYN", 2],
        ["RST", 4],
        ["PSH", 8],
        ["ACK", 16],
        ["URG", 32],
        ["ECE", 64],
        ["CWR", 128]
    ]
}

--- POSIX-style file access flags.
fn posix_flags_table() {
    return [
        ["EXEC", 1],
        ["WRITE", 2],
        ["READ", 4],
        ["CLOEXEC", 8]
    ]
}