// Lateralus Standard Library Example: Dynamic Network Topology & Cycle Detection Pipeline
// Demonstrates Disjoint Set Union (DSU) with path compression and union-by-rank.

fn dsu_make(n: int) -> dict {
    let mut parent = [];
    let mut rank = [];
    let mut i = 0;
    while i < n {
        parent = parent + [i];
        rank = rank + [0];
        i = i + 1;
    }
    let mut dsu = {};
    dsu["parent"] = parent;
    dsu["rank"] = rank;
    dsu["count"] = n;
    return dsu;
}

fn dsu_find(dsu: dict, i: int) -> int {
    let parent = dsu["parent"];
    let mut root = i;
    while root != parent[root] {
        root = parent[root];
    }
    let mut curr = i;
    while curr != root {
        let nxt = parent[curr];
        parent[curr] = root;
        curr = nxt;
    }
    return root;
}

fn dsu_union(dsu: dict, x: int, y: int) -> bool {
    let root_x = dsu_find(dsu, x);
    let root_y = dsu_find(dsu, y);
    if root_x == root_y {
        return false;
    }

    let rank = dsu["rank"];
    let parent = dsu["parent"];

    if rank[root_x] < rank[root_y] {
        parent[root_x] = root_y;
    } else if rank[root_x] > rank[root_y] {
        parent[root_y] = root_x;
    } else {
        parent[root_y] = root_x;
        rank[root_x] = rank[root_x] + 1;
    }

    dsu["count"] = dsu["count"] - 1;
    return true;
}

fn dsu_connected(dsu: dict, x: int, y: int) -> bool {
    return dsu_find(dsu, x) == dsu_find(dsu, y);
}

fn main() -> int {
    println("=== Lateralus Disjoint Set Union (DSU) Network Pipeline Demo ===");

    // 5 Network switches: Node 0, 1, 2, 3, 4
    let mut net = dsu_make(5);
    println("Initialized 5 isolated network switches. Disjoint clusters: " + str(net["count"]));

    // Edge additions:
    // Link 0 <-> 1
    let e1 = dsu_union(net, 0, 1);
    println("Adding Fiber Cable (0 <-> 1) -> Success: " + str(e1));
    assert(e1);

    // Link 1 <-> 2
    let e2 = dsu_union(net, 1, 2);
    println("Adding Fiber Cable (1 <-> 2) -> Success: " + str(e2));
    assert(e2);

    // Redundant loop attempt: Link 0 <-> 2 (Would create an Ethernet loop/broadcast storm!)
    let loop_attempt = dsu_union(net, 0, 2);
    println("Spanning Tree Guard: Attempting cable (0 <-> 2) -> " + str(loop_attempt));
    assert(loop_attempt == false); // Cycle detected and prevented!

    // Link 3 <-> 4
    let e3 = dsu_union(net, 3, 4);
    println("Adding Fiber Cable (3 <-> 4) -> Success: " + str(e3));
    assert(e3);

    println("Current Island Subnets: " + str(net["count"]));
    assert(net["count"] == 2);

    // Interconnect Subnet 1 and Subnet 2 via (2 <-> 3)
    let backbone = dsu_union(net, 2, 3);
    println("Deploying Backbone Trunk (2 <-> 3) -> Success: " + str(backbone));
    assert(backbone);

    println("Unified Network Topology Established! Total Disjoint Clusters: " + str(net["count"]));
    assert(net["count"] == 1);
    assert(dsu_connected(net, 0, 4));

    println("\nDSU graph connectivity and spanning tree invariants verified 100% faithful!");
    return 0;
}