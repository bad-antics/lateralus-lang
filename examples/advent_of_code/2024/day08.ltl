// Advent of Code 2024 · Day 8 · Resonant Collinearity
// Part 1: count distinct antinodes inside the grid for every same-frequency pair.
// Part 2: count every point on those lines (resonant harmonics, antennas included).
// Self-verifying with @test blocks; sample from the AoC statement.

let SAMPLE = "............
........0...
.....0......
.......0....
....0.......
......A.....
............
............
........A...
.........A..
............
............"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn cell(grid: list, r: int, c: int) -> str {
    if r < 0 || c < 0 || r >= len(grid) { return "" }
    if c >= len(grid[r]) { return "" }
    return slice(grid[r], c, c + 1)
}

fn in_grid(grid: list, r: int, c: int) -> bool {
    if r < 0 || c < 0 || r >= len(grid) { return false }
    return c < len(grid[r])
}

// Antennas as [freq, row, col]
fn antennas(grid: list) -> list {
    let out = []
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            let ch = cell(grid, r, c)
            if ch != "." { out = out + [[ch, r, c]] }
            c = c + 1
        }
        r = r + 1
    }
    return out
}

fn part1(text: str) -> int {
    let grid = lines_of(text)
    let ants = antennas(grid)
    let seen = {}
    let i = 0
    while i < len(ants) {
        let j = i + 1
        while j < len(ants) {
            if ants[i][0] == ants[j][0] {
                let r1 = ants[i][1]
                let c1 = ants[i][2]
                let r2 = ants[j][1]
                let c2 = ants[j][2]
                let ar = 2 * r1 - r2
                let ac = 2 * c1 - c2
                if in_grid(grid, ar, ac) { seen[str(ar) + "," + str(ac)] = 1 }
                let br = 2 * r2 - r1
                let bc = 2 * c2 - c1
                if in_grid(grid, br, bc) { seen[str(br) + "," + str(bc)] = 1 }
            }
            j = j + 1
        }
        i = i + 1
    }
    return len(keys(seen))
}

fn part2(text: str) -> int {
    let grid = lines_of(text)
    let ants = antennas(grid)
    let seen = {}
    let i = 0
    while i < len(ants) {
        let j = i + 1
        while j < len(ants) {
            if ants[i][0] == ants[j][0] {
                let r1 = ants[i][1]
                let c1 = ants[i][2]
                let r2 = ants[j][1]
                let c2 = ants[j][2]
                let dr = r2 - r1
                let dc = c2 - c1
                let r = r1
                let c = c1
                while in_grid(grid, r, c) {
                    seen[str(r) + "," + str(c)] = 1
                    r = r + dr
                    c = c + dc
                }
                r = r1
                c = c1
                while in_grid(grid, r, c) {
                    seen[str(r) + "," + str(c)] = 1
                    r = r - dr
                    c = c - dc
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    return len(keys(seen))
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 14)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 34)
}

fn main() {
    print("Day 8 Part 1: " + str(part1(SAMPLE)))
    print("Day 8 Part 2: " + str(part2(SAMPLE)))
}

main()
