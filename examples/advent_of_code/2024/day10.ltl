// Advent of Code 2024 · Day 10 · Hoof It
// Part 1: sum, per trailhead (0), of distinct 9s reachable by steps of +1.
// Part 2: sum, per trailhead, of distinct hiking trails (rating).
// Self-verifying with @test blocks; sample from the AoC statement.

let SAMPLE = "89010123
78121874
87430965
96549874
45678903
32019012
01329801
10456732"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn d_at(grid: list, r: int, c: int) -> int {
    if r < 0 || c < 0 || r >= len(grid) { return -1 }
    if c >= len(grid[r]) { return -1 }
    return int(slice(grid[r], c, c + 1))
}

fn in_grid(grid: list, r: int, c: int) -> bool {
    if r < 0 || c < 0 || r >= len(grid) { return false }
    return c < len(grid[r])
}

// Collect the set of reachable 9 positions from (r, c).
fn reach(grid: list, r: int, c: int, seen: dict) -> dict {
    if d_at(grid, r, c) == 9 {
        seen[str(r) + "," + str(c)] = 1
        return seen
    }
    let want = d_at(grid, r, c) + 1
    let dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]]
    for d in dirs {
        let nr = r + d[0]
        let nc = c + d[1]
        if in_grid(grid, nr, nc) && d_at(grid, nr, nc) == want {
            seen = reach(grid, nr, nc, seen)
        }
    }
    return seen
}

// Count distinct trails (paths) from (r, c) to any 9.
fn trails(grid: list, r: int, c: int) -> int {
    if d_at(grid, r, c) == 9 { return 1 }
    let want = d_at(grid, r, c) + 1
    let total = 0
    let dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]]
    for d in dirs {
        let nr = r + d[0]
        let nc = c + d[1]
        if in_grid(grid, nr, nc) && d_at(grid, nr, nc) == want {
            total = total + trails(grid, nr, nc)
        }
    }
    return total
}

fn part1(text: str) -> int {
    let grid = lines_of(text)
    let total = 0
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            if d_at(grid, r, c) == 0 { total = total + len(keys(reach(grid, r, c, {}))) }
            c = c + 1
        }
        r = r + 1
    }
    return total
}

fn part2(text: str) -> int {
    let grid = lines_of(text)
    let total = 0
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            if d_at(grid, r, c) == 0 { total = total + trails(grid, r, c) }
            c = c + 1
        }
        r = r + 1
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 36)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 81)
}

fn main() {
    print("Day 10 Part 1: " + str(part1(SAMPLE)))
    print("Day 10 Part 2: " + str(part2(SAMPLE)))
}

main()
