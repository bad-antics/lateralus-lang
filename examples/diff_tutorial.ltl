// Lateralus Standard Library Example: Unified Diff & Shortest Edit Script (SES)
// Demonstrates Myers/LCS diff computation and formatting for version control and automated code patching.

fn max_int(a: int, b: int) -> int {
    if a > b {
        return a;
    }
    return b;
}

fn compute_lcs_table(a: list, b: list) -> list {
    let n = len(a);
    let m = len(b);
    let cols = m + 1;
    let total_cells = (n + 1) * cols;

    let mut dp = [];
    let mut k = 0;
    while k < total_cells {
        dp = dp + [0];
        k = k + 1;
    }

    let mut i = 1;
    while i <= n {
        let mut j = 1;
        while j <= m {
            let idx = i * cols + j;
            if a[i - 1] == b[j - 1] {
                let prev_diag = (i - 1) * cols + (j - 1);
                dp[idx] = dp[prev_diag] + 1;
            } else {
                let up = (i - 1) * cols + j;
                let left = i * cols + (j - 1);
                dp[idx] = max_int(dp[up], dp[left]);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return dp;
}

fn generate_unified_diff(a: list, b: list) -> list {
    let n = len(a);
    let m = len(b);
    let cols = m + 1;
    let dp = compute_lcs_table(a, b);

    let mut reversed_diff = [];
    let mut i = n;
    let mut j = m;

    while i > 0 || j > 0 {
        if i > 0 && j > 0 && a[i - 1] == b[j - 1] {
            reversed_diff = reversed_diff + [" " + a[i - 1]];
            i = i - 1;
            j = j - 1;
        } else if j > 0 && (i == 0 || dp[i * cols + (j - 1)] >= dp[(i - 1) * cols + j]) {
            reversed_diff = reversed_diff + ["+" + b[j - 1]];
            j = j - 1;
        } else if i > 0 && (j == 0 || dp[(i - 1) * cols + j] > dp[i * cols + (j - 1)]) {
            reversed_diff = reversed_diff + ["-" + a[i - 1]];
            i = i - 1;
        }
    }

    let mut diff = [];
    let mut k = len(reversed_diff) - 1;
    while k >= 0 {
        diff = diff + [reversed_diff[k]];
        k = k - 1;
    }
    return diff;
}

fn main() -> int {
    println("=== Lateralus Unified Diff & Shortest Edit Script (SES) Demo ===");

    let old_src = [
        "// Application Configuration",
        "let max_retries = 3;",
        "let use_tls = false;",
        "let endpoint = \"http://api.local\";"
    ];

    let new_src = [
        "// Application Configuration",
        "let max_retries = 5;",
        "let use_tls = true;",
        "let endpoint = \"https://api.cloud.io\";"
    ];

    println("Generating Unified Diff between old_src and new_src:");
    println("--- a/config.ltl");
    println("+++ b/config.ltl");

    let diff_lines = generate_unified_diff(old_src, new_src);
    let mut additions = 0;
    let mut deletions = 0;
    let mut unchanged = 0;

    let mut i = 0;
    while i < len(diff_lines) {
        let line = diff_lines[i];
        println(line);
        let prefix = slice(line, 0, 1);
        if prefix == "+" {
            additions = additions + 1;
        }
        if prefix == "-" {
            deletions = deletions + 1;
        }
        if prefix == " " {
            unchanged = unchanged + 1;
        }
        i = i + 1;
    }

    println("\nDiff Summary: +" + str(additions) + " additions, -" + str(deletions) + " deletions, " + str(unchanged) + " context lines");
    assert(additions == 3);
    assert(deletions == 3);
    assert(unchanged == 1);

    println("Unified diff generated and validated 100% successfully!");
    return 0;
}