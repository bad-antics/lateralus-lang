// Standard Library Rabin-Karp Rolling Hash Substring Search Verification Suite
// Validates polynomial rolling hash calculations, O(1) sliding window updates, and collision-free matching.

fn rabin_karp_search(text: str, pattern: str) -> list {
    let n = len(text);
    let m = len(pattern);
    let mut matches = [];

    if m == 0 || m > n {
        return matches;
    }

    let B = 256;
    let M = 1000000007;

    // Precompute h = B^(m - 1) % M
    let mut h = 1;
    let mut i = 0;
    while i < (m - 1) {
        h = (h * B) % M;
        i = i + 1;
    }

    // Compute initial hash of pattern and first window of text
    let mut p_hash = 0;
    let mut t_hash = 0;
    let mut j = 0;
    while j < m {
        p_hash = (p_hash * B + ord(slice(pattern, j, j + 1))) % M;
        t_hash = (t_hash * B + ord(slice(text, j, j + 1))) % M;
        j = j + 1;
    }

    // Slide window across text
    let mut idx = 0;
    while idx <= (n - m) {
        if p_hash == t_hash {
            // Check character match to prevent hash collision false positives
            if slice(text, idx, idx + m) == pattern {
                matches = matches + [idx];
            }
        }

        if idx < (n - m) {
            let c_out = ord(slice(text, idx, idx + 1));
            let c_in = ord(slice(text, idx + m, idx + m + 1));
            t_hash = (t_hash - (c_out * h) % M) % M;
            if t_hash < 0 {
                t_hash = t_hash + M;
            }
            t_hash = (t_hash * B + c_in) % M;
        }

        idx = idx + 1;
    }

    return matches;
}

fn main() -> int {
    // 1. Classical Multi-occurrence Matching
    // Text: "AABAACAADAABAABA"
    // Pattern: "AABA"
    // Matches at index 0, 9, 12
    let res1 = rabin_karp_search("AABAACAADAABAABA", "AABA");
    assert(len(res1) == 3);
    assert(res1[0] == 0);
    assert(res1[1] == 9);
    assert(res1[2] == 12);

    // 2. Pattern at the End of Text
    let res2 = rabin_karp_search("blockchain_cryptography", "cryptography");
    assert(len(res2) == 1);
    assert(res2[0] == 11);

    // 3. Pattern Not Present
    let res3 = rabin_karp_search("lateralus_compiler", "rust");
    assert(len(res3) == 0);

    // 4. Pattern Equal to Full Text
    let res4 = rabin_karp_search("exact_match", "exact_match");
    assert(len(res4) == 1);
    assert(res4[0] == 0);

    // 5. Pattern Longer than Text
    let res5 = rabin_karp_search("short", "much_longer_pattern");
    assert(len(res5) == 0);

    // 6. Single Character Matches
    // Text: "banana", Pattern: "a"
    // Indices: 1, 3, 5
    let res6 = rabin_karp_search("banana", "a");
    assert(len(res6) == 3);
    assert(res6[0] == 1);
    assert(res6[1] == 3);
    assert(res6[2] == 5);

    return 0;
}
