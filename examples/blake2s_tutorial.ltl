// examples/blake2s_tutorial.ltl - Demonstrates stdlib.blake2s hashing
import stdlib.blake2s

fn main() {
    let text = "Lateralus fast cryptography"
    let digest = blake2s.hash256_str(text)
    let hex_val = blake2s.to_hex(digest)
    
    let key = [1, 2, 3, 4, 5, 6, 7, 8]
    let mac = blake2s.hash([10, 20, 30], key, 32)
    let mac_hex = blake2s.to_hex(mac)
}
