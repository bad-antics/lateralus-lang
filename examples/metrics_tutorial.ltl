// ===================================================================
// examples/metrics_tutorial.ltl — stdlib/metrics.ltl tutorial companion
// Runnable tour of the in-process metrics registry: counters, gauges,
// histograms with le-buckets, label fingerprints, and Prometheus
// text exposition. Self-contained.
// ===================================================================

fn new_registry() -> map {
    let r = {}
    r["families"] = {}
    return r
}

fn ensure_family(reg: map, name: str, help: str, kind: str, buckets: list) {
    let fams = reg["families"]
    if contains(keys(fams), name) {
        return
    }
    let fam = {}
    fam["name"] = name
    fam["help"] = help
    fam["kind"] = kind
    fam["buckets"] = buckets
    fam["series"] = {}
    fams[name] = fam
}

fn register_counter(reg: map, name: str, help: str) {
    ensure_family(reg, name, help, "counter", [])
}

fn register_gauge(reg: map, name: str, help: str) {
    ensure_family(reg, name, help, "gauge", [])
}

fn register_histogram(reg: map, name: str, help: str, buckets: list) {
    ensure_family(reg, name, help, "histogram", buckets)
}

fn fingerprint(labels: map) -> str {
    let ks = sorted(keys(labels))
    let parts = []
    for k in ks {
        parts = parts + [k + "=" + str(labels[k])]
    }
    return join(parts, ",")
}

fn labels_fmt(labels: map) -> str {
    let ks = keys(labels)
    if len(ks) == 0 {
        return ""
    }
    let parts = []
    for k in ks {
        parts = parts + [k + "=\"" + str(labels[k]) + "\""]
    }
    // chr() for braces: the lexer treats { } inside string literals as
    // interpolation markers, so "{" alone is a parse error.
    return chr(123) + join(parts, ",") + chr(125)
}

fn merge_label(labels: map, k: str, v: str) -> str {
    let m = {}
    let src_keys = keys(labels)
    for kk in src_keys {
        m[kk] = labels[kk]
    }
    m[k] = v
    return labels_fmt(m)
}

fn touch(reg: map, name: str, labels: map) -> map {
    let fam = reg["families"][name]
    let fp = fingerprint(labels)
    let series = fam["series"]
    if !contains(keys(series), fp) {
        let s = {}
        s["labels"] = labels
        s["value"] = 0.0
        s["count"] = 0
        s["sum"] = 0.0
        s["bucket_counts"] = []
        series[fp] = s
    }
    return series[fp]
}

fn inc(reg: map, name: str, labels: map, by: float) {
    let s = touch(reg, name, labels)
    s["value"] = s["value"] + by
}

fn set_value(reg: map, name: str, labels: map, v: float) {
    let s = touch(reg, name, labels)
    s["value"] = v
}

fn observe(reg: map, name: str, labels: map, v: float) {
    let s = touch(reg, name, labels)
    let fam = reg["families"][name]
    s["count"] = s["count"] + 1
    s["sum"] = s["sum"] + v

    if len(s["bucket_counts"]) == 0 {
        let nb = len(fam["buckets"]) + 1
        let k = 0
        let bc = []
        while k < nb {
            bc = bc + [0]
            k = k + 1
        }
        s["bucket_counts"] = bc
    }

    let placed = false
    let i = 0
    while i < len(fam["buckets"]) {
        if !placed {
            if v <= fam["buckets"][i] {
                s["bucket_counts"][i] = s["bucket_counts"][i] + 1
                placed = true
            }
        }
        i = i + 1
    }
    if !placed {
        let last = len(fam["buckets"])
        s["bucket_counts"][last] = s["bucket_counts"][last] + 1
    }
}

fn render_prometheus(reg: map) -> str {
    let out = ""
    let names = keys(reg["families"])
    for name in names {
        let fam = reg["families"][name]
        if len(fam["help"]) > 0 {
            out = out + "# HELP " + fam["name"] + " " + fam["help"] + "\n"
        }
        out = out + "# TYPE " + fam["name"] + " " + fam["kind"] + "\n"
        let fps = keys(fam["series"])
        for fp in fps {
            let s = fam["series"][fp]
            let lbl = labels_fmt(s["labels"])
            if fam["kind"] == "counter" {
                out = out + fam["name"] + lbl + " " + str(s["value"]) + "\n"
            }
            if fam["kind"] == "gauge" {
                out = out + fam["name"] + lbl + " " + str(s["value"]) + "\n"
            }
            if fam["kind"] == "histogram" {
                let cum = 0
                let i = 0
                while i < len(fam["buckets"]) {
                    cum = cum + s["bucket_counts"][i]
                    out = out + fam["name"] + "_bucket"
                        + merge_label(s["labels"], "le", str(fam["buckets"][i]))
                        + " " + str(cum) + "\n"
                    i = i + 1
                }
                cum = cum + s["bucket_counts"][len(fam["buckets"])]
                out = out + fam["name"] + "_bucket"
                    + merge_label(s["labels"], "le", "+Inf")
                    + " " + str(cum) + "\n"
                out = out + fam["name"] + "_sum" + lbl + " " + str(s["sum"]) + "\n"
                out = out + fam["name"] + "_count" + lbl + " " + str(s["count"]) + "\n"
            }
        }
    }
    return out
}

fn show_series(reg: map, name: str) -> str {
    let fam = reg["families"][name]
    let fps = keys(fam["series"])
    if len(fps) == 0 {
        return "<no series>"
    }
    return join(fps, " | ")
}

fn main() {
    println("=== LATERALUS STDLIB METRICS TUTORIAL ===")
    let reg = new_registry()
    register_counter(reg, "http_requests_total", "Total HTTP requests")
    register_gauge(reg, "queue_depth", "Current queue depth")
    register_histogram(reg, "request_latency_seconds", "Request latency", [0.1, 0.5, 1.0])

    println("STEP 1 families: " + join(keys(reg["families"]), ","))

    let no_labels = {}
    let lbl = {}
    lbl["route"] = "/api"
    lbl["method"] = "GET"

    inc(reg, "http_requests_total", no_labels, 1.0)
    inc(reg, "http_requests_total", no_labels, 1.0)
    inc(reg, "http_requests_total", lbl, 1.0)
    println("STEP 2 counter series: " + show_series(reg, "http_requests_total"))

    set_value(reg, "queue_depth", no_labels, 7.0)
    set_value(reg, "queue_depth", no_labels, 3.0)
    println("STEP 3 gauge overwritten: last set_value wins (3.0)")

    observe(reg, "request_latency_seconds", no_labels, 0.05)
    observe(reg, "request_latency_seconds", no_labels, 0.3)
    observe(reg, "request_latency_seconds", no_labels, 2.0)
    println("STEP 4 histogram observed 0.05, 0.3, 2.0 into buckets [0.1,0.5,1.0]")

    println("STEP 5 prometheus output:")
    println(render_prometheus(reg))
    println("PINNED_VECTORS: families=http_requests_total,queue_depth,request_latency_seconds fp=method=GET,route=/api gauge=3.0 buckets=1,2,2,+Inf:3 sum=2.35 count=3 lbl=route=/api+method=GET")
}

main()
