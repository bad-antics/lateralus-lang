// Rosetta Code: Greatest common divisor (Euclidean algorithm)
fn gcd(a: int, b: int) -> int {
    let mut x = a
    let mut y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

println("gcd(48, 18) = " + str(gcd(48, 18)))
println("gcd(101, 103) = " + str(gcd(101, 103)))
if gcd(48, 18) == 6 && gcd(17, 5) == 1 { println("OK") } else { println("FAIL") }
