// ===================================================================
// Runnable conformance example for stdlib/base64.ltl
// RFC 4648 section 10 vectors, round-trips, URL-safe, and helpers.
// ===================================================================
//
// The implementation below is inlined because the Python runner does not
// yet resolve `import stdlib.base64`; keep it in sync with the module.

// -- Alphabet --------------------------------------------------------

let CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let PAD = "="

// -- Encoding --------------------------------------------------------

/// Encode a string to base64.
pub fn encode(data: str) -> str {
    let result = ""
    let i = 0
    let n = len(data)

    while i < n {
        let b0 = ord(data[i])
        let b1 = 0
        let b2 = 0
        let padding = 0

        if i + 1 < n {
            b1 = ord(data[i + 1])
        } else {
            padding = padding + 1
        }
        if i + 2 < n {
            b2 = ord(data[i + 2])
        } else {
            padding = padding + 1
        }

        // Split 3 bytes into 4 sextets without producing floats.
        let c0 = b0 >> 2
        let c1 = ((b0 & 3) << 4) | (b1 >> 4)
        let c2 = ((b1 & 15) << 2) | (b2 >> 6)
        let c3 = b2 & 63

        result = result + CHARS[c0]
        result = result + CHARS[c1]

        if padding <= 1 {
            result = result + CHARS[c2]
        } else {
            result = result + PAD
        }

        if padding == 0 {
            result = result + CHARS[c3]
        } else {
            result = result + PAD
        }

        i = i + 3
    }

    return result
}

// -- Decoding --------------------------------------------------------

/// Look up the index of a base64 character.
fn char_index(c: str) -> int {
    for i in range(0, 64) {
        if CHARS[i] == c {
            return i
        }
    }
    return -1
}

/// Decode a base64 string.
pub fn decode(encoded: str) -> str {
    let result = ""
    let i = 0
    let n = len(encoded)

    while i < n {
        let c0 = char_index(encoded[i])
        let c1 = char_index(encoded[i + 1])

        let has_c2 = (i + 2 < n) and (encoded[i + 2] != PAD)
        let has_c3 = (i + 3 < n) and (encoded[i + 3] != PAD)

        let v2 = 0
        let v3 = 0
        if has_c2 {
            v2 = char_index(encoded[i + 2])
        }
        if has_c3 {
            v3 = char_index(encoded[i + 3])
        }

        // Reconstruct 3 bytes from 4 sextets.
        let byte0 = (c0 << 2) | (c1 >> 4)
        result = result + chr(byte0)

        if has_c2 {
            let byte1 = ((c1 & 15) << 4) | (v2 >> 2)
            result = result + chr(byte1)
        }

        if has_c3 {
            let byte2 = ((v2 & 3) << 6) | v3
            result = result + chr(byte2)
        }

        i = i + 4
    }

    return result
}

// -- URL-safe variants -----------------------------------------------

/// Encode using URL-safe base64 (+ becomes -, / becomes _).
pub fn encode_url(data: str) -> str {
    let b = encode(data)
    let result = ""
    for i in range(0, len(b)) {
        let c = b[i]
        if c == "+" {
            result = result + "-"
        } else if c == "/" {
            result = result + "_"
        } else {
            result = result + c
        }
    }
    return result
}

/// Decode URL-safe base64 (- becomes +, _ becomes /).
pub fn decode_url(encoded: str) -> str {
    let b = ""
    for i in range(0, len(encoded)) {
        let c = encoded[i]
        if c == "-" {
            b = b + "+"
        } else if c == "_" {
            b = b + "/"
        } else {
            b = b + c
        }
    }
    return decode(b)
}

// -- Utilities -------------------------------------------------------

/// Check if a string is valid padded base64.
pub fn is_valid(s: str) -> bool {
    let n = len(s)
    if n == 0 {
        return true
    }
    if n % 4 != 0 {
        return false
    }

    let padding = 0
    if s[n - 1] == PAD {
        padding = padding + 1
    }
    if n > 1 and s[n - 2] == PAD {
        padding = padding + 1
    }

    let body = n - padding
    for i in range(0, body) {
        if char_index(s[i]) < 0 {
            return false
        }
    }
    for i in range(body, n) {
        if s[i] != PAD {
            return false
        }
    }
    return true
}

/// Compute the encoded length for `n` input bytes.
pub fn encoded_length(n: int) -> int {
    return to_int(floor((n + 2) / 3)) * 4
}

/// Compute the decoded length from encoded string length.
pub fn decoded_length(encoded: str) -> int {
    let n = len(encoded)
    let padding = 0
    if n > 0 and encoded[n - 1] == PAD {
        padding = padding + 1
    }
    if n > 1 and encoded[n - 2] == PAD {
        padding = padding + 1
    }
    return (n >> 2) * 3 - padding
}

// -- Checks ----------------------------------------------------------

fn check(label: str, ok: bool) -> int {
    if ok {
        println("  ok   " + label)
        return 1
    }
    println("  FAIL " + label)
    return 0
}

fn main() {
    let passed = 0
    let total = 27

    println("=== RFC 4648 base64 encode vectors ===")
    passed = passed + check("encode empty", encode("") == "")
    passed = passed + check("encode f", encode("f") == "Zg==")
    passed = passed + check("encode fo", encode("fo") == "Zm8=")
    passed = passed + check("encode foo", encode("foo") == "Zm9v")
    passed = passed + check("encode foob", encode("foob") == "Zm9vYg==")
    passed = passed + check("encode fooba", encode("fooba") == "Zm9vYmE=")
    passed = passed + check("encode foobar", encode("foobar") == "Zm9vYmFy")

    println("=== RFC 4648 base64 decode vectors ===")
    passed = passed + check("decode empty", decode("") == "")
    passed = passed + check("decode Zg==", decode("Zg==") == "f")
    passed = passed + check("decode Zm8=", decode("Zm8=") == "fo")
    passed = passed + check("decode Zm9v", decode("Zm9v") == "foo")
    passed = passed + check("decode Zm9vYg==", decode("Zm9vYg==") == "foob")
    passed = passed + check("decode Zm9vYmE=", decode("Zm9vYmE=") == "fooba")
    passed = passed + check("decode Zm9vYmFy", decode("Zm9vYmFy") == "foobar")

    println("=== round-trips ===")
    passed = passed + check("hello, world", decode(encode("hello, world")) == "hello, world")
    passed = passed + check("a+b/c?", decode(encode("a+b/c?")) == "a+b/c?")
    passed = passed + check("Lateralus", decode(encode("Lateralus")) == "Lateralus")
    passed = passed + check("0123456789", decode(encode("0123456789")) == "0123456789")
    passed = passed + check("single byte", decode(encode("x")) == "x")

    println("=== URL-safe alphabet ===")
    passed = passed + check("+/ become -_", encode_url("a+b/c?") == "YStiL2M_")
    passed = passed + check("url round-trip", decode_url(encode_url("a+b/c?")) == "a+b/c?")

    println("=== validation ===")
    passed = passed + check("empty is valid", is_valid(""))
    passed = passed + check("Zg== is valid", is_valid("Zg=="))
    passed = passed + check("==== is invalid", !is_valid("===="))
    passed = passed + check("Zg=A is invalid", !is_valid("Zg=A"))

    println("=== length helpers ===")
    passed = passed + check("encoded_length(5) == 8", encoded_length(5) == 8)
    passed = passed + check("decoded_length(Zm9vYmFy) == 6", decoded_length("Zm9vYmFy") == 6)

    println("")
    println("pass=" + str(passed) + " fail=" + str(total - passed))
}

main()
