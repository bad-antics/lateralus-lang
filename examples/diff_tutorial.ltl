# Diff Tutorial Example
# Demonstrates Myers diff algorithm with colored unified diff output

# Import diff functionality
from stdlib.diff import diff_lines, format_unified_diff

# Define test functions
func test_basic_diff() {
    let old_lines = ["function hello() {", "  console.log('Hello');", "}"]
    let new_lines = ["function hello() {", "  console.log('Hello, world!');", "  console.log('Done');", "}"]
    
    let diff = diff_lines(old_lines, new_lines)
    let unified = format_unified_diff(old_lines, new_lines, diff)
    
    # Print colored output
    print("\n=== Basic Diff Example ===")
    for line in unified {
        if line.starts_with("+") {
            print("\x1b[32m" + line + "\x1b[0m")  # Green for additions
        } elif line.starts_with("-") {
            print("\x1b[31m" + line + "\x1b[0m")  # Red for deletions
        } else {
            print(line)  # Default for context
        }
    }
}

func test_empty_files() {
    let old_lines = []
    let new_lines = ["new", "file", "content"]
    
    let diff = diff_lines(old_lines, new_lines)
    let unified = format_unified_diff(old_lines, new_lines, diff)
    
    print("\n=== Empty Files Diff ===")
    for line in unified {
        if line.starts_with("+") {
            print("\x1b[32m" + line + "\x1b[0m")
        } else {
            print(line)
        }
    }
}

func test_identical_files() {
    let content = ["line 1", "line 2", "line 3"]
    
    let diff = diff_lines(content, content)
    let unified = format_unified_diff(content, content, diff)
    
    print("\n=== Identical Files Diff ===")
    for line in unified {
        print("\x1b[90m" + line + "\x1b[0m")  # Gray for identical content
    }
}

func test_complex_changes() {
    let old_lines = [
        "function add(a, b) {",
        "  return a + b;",
        "}",
        "",
        "function subtract(a, b) {",
        "  return a - b;",
        "}"
    ]
    
    let new_lines = [
        "function add(a, b) {",
        "  // Add type checking",
        "  if (typeof a !== 'number' || typeof b !== 'number') {",
        "    throw new TypeError('Arguments must be numbers');",
        "  }",
        "  return a + b;",
        "}",
        "",
        "function multiply(a, b) {",
        "  return a * b;",
        "}",
        "",
        "function subtract(a, b) {",
        "  return a - b;",
        "}"
    ]
    
    let diff = diff_lines(old_lines, new_lines)
    let unified = format_unified_diff(old_lines, new_lines, diff)
    
    print("\n=== Complex Changes Diff ===")
    for line in unified {
        if line.starts_with("+") {
            print("\x1b[32m" + line + "\x1b[0m")
        } elif line.starts_with("-") {
            print("\x1b[31m" + line + "\x1b[0m")
        } else {
            print(line)
        }
    }
}

# Run all tests
print("Starting diff tutorial examples...")
test_basic_diff()
test_empty_files()
test_identical_files()
test_complex_changes()
print("\nDiff tutorial examples completed.")
