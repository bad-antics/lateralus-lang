// ===================================================================
// examples/fractional_knapsack_tutorial.ltl
// -------------------------------------------------------------------
// Demonstration of Fractional Knapsack Greedy Slicing in Lateralus.
//
// Real-World Applications:
// 1. Cloud Infrastructure: Fractional compute-memory slice allocation across spot VMs.
// 2. High-Value Logistics: Precious metal refinery cargo freight value maximization.
// 3. Network Bandwidth Allocation: Packet priority fractional transmission under congestion.
// ===================================================================

fn compare_density(item1, item2) {
    let v1 = item1[0]
    let w1 = item1[1]
    let v2 = item2[0]
    let w2 = item2[1]
    let cross1 = v1 * w2
    let cross2 = v2 * w1
    if cross1 > cross2 {
        return -1
    }
    if cross1 < cross2 {
        return 1
    }
    return 0
}

pub fn fractional_knapsack_scaled(items_in, capacity) {
    let n = len(items_in)
    let items = []
    let c = 0
    while c < n {
        items = push(items, items_in[c])
        c = c + 1
    }

    let a = 1
    while a < n {
        let key = items[a]
        let b = a - 1
        while b >= 0 {
            let prev = items[b]
            if compare_density(prev, key) > 0 {
                items[b + 1] = prev
                b = b - 1
            } else {
                break
            }
        }
        items[b + 1] = key
        a = a + 1
    }

    let remaining_cap = capacity
    let total_val_scaled = 0
    let fractions = []
    let i = 0

    while i < n and remaining_cap > 0 {
        let item = items[i]
        let v = item[0]
        let w = item[1]

        if w <= remaining_cap {
            remaining_cap = remaining_cap - w
            total_val_scaled = total_val_scaled + v * 1000
            fractions = push(fractions, [item[2], 1000])
        } else {
            let fraction_permille = (remaining_cap * 1000) / w
            total_val_scaled = total_val_scaled + (v * fraction_permille)
            fractions = push(fractions, [item[2], fraction_permille])
            remaining_cap = 0
        }
        i = i + 1
    }

    let res = dict()
    res["total_val_scaled"] = total_val_scaled
    res["fractions"] = fractions
    return res
}

pub fn main() {
    print("=================================================================")
    print("   Lateralus Standard Library: Cloud VM Slice Allocation Demo    ")
    print("=================================================================")

    // Workload Jobs: [Revenue ($/hr), RAM Weight (GB), Job ID]
    let cloud_jobs = [
        [300, 50, 101],   // High density: $6.0/GB
        [400, 100, 102],  // Medium density: $4.0/GB
        [250, 50, 103],   // High density: $5.0/GB
        [150, 150, 104]   // Low density: $1.0/GB
    ]

    let server_ram_capacity = 175  // Available RAM on host: 175 GB
    print("Physical Host Memory Capacity: " + str(server_ram_capacity) + " GB")

    let plan = fractional_knapsack_scaled(cloud_jobs, server_ram_capacity)

    let total_revenue = plan["total_val_scaled"] / 1000
    print("Optimal Total Revenue Yield: $" + str(total_revenue) + "/hr")

    print("Fractional Job Allocations:")
    let allocations = plan["fractions"]
    let i = 0
    while i < len(allocations) {
        let alloc = allocations[i]
        let job_id = alloc[0]
        let permille = alloc[1]
        let pct = permille / 10
        print("  -> Job #" + str(job_id) + " allocated: " + str(pct) + "% of requested capacity")
        i = i + 1
    }

    print("Greedy fractional resource packing completed with 100% precision.")
}
