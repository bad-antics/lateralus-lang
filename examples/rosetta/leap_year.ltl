// Rosetta Code: Leap year
fn is_leap(y: int) -> bool {
    if y % 400 == 0 { return true }
    if y % 100 == 0 { return false }
    return y % 4 == 0
}
println("2000 -> " + str(is_leap(2000)))
println("1900 -> " + str(is_leap(1900)))
println("2024 -> " + str(is_leap(2024)))
if is_leap(2000) && !is_leap(1900) && is_leap(2024) && !is_leap(2023) { println("OK") } else { println("FAIL") }
