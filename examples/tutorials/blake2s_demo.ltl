// examples/tutorials/blake2s_demo.ltl
// Runnable demonstration of BLAKE2s hashing in Lateralus

module examples.tutorials.blake2s_demo

import io
import blake2s

fn main() {
    let message = "Lateralus High Performance Cryptography"
    let digest = blake2s.hash256_str(message)
    io.println("Digest bytes length: " + len(digest).to_string())
}
