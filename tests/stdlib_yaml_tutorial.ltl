// Pinned test vectors for stdlib/yaml tutorial (YAML 1.2).

import yaml

pub fn test_yaml_scalars_and_comments() -> bool {
    let raw = "
# System Header
app_name: \"lateralus_core\"
version: 1
active: true
empty_field: null
tilde_field: ~
quoted_tag: \"#1-release\" # comment after string
"
    let doc = yaml_parse(raw)

    if doc["app_name"] != "lateralus_core" { return false }
    if doc["version"] != 1 { return false }
    if doc["active"] != true { return false }
    if doc["empty_field"] != nil { return false }
    if doc["tilde_field"] != nil { return false }
    if doc["quoted_tag"] != "#1-release" { return false }

    return true
}

pub fn test_yaml_nested_maps() -> bool {
    let raw = "
service:
  name: api_gateway
  port: 8080
  network:
    ip: 10.0.0.1
    cidr: 24
"
    let doc = yaml_parse(raw)
    let svc = doc["service"]

    if svc["name"] != "api_gateway" { return false }
    if svc["port"] != 8080 { return false }

    let net = svc["network"]
    if net["ip"] != "10.0.0.1" { return false }
    if net["cidr"] != 24 { return false }

    return true
}

pub fn test_yaml_block_sequence() -> bool {
    let raw = "
packages:
  - web
  - crypto
  - database
"
    let doc = yaml_parse(raw)
    let pkgs = doc["packages"]

    if len(pkgs) != 3 { return false }
    if pkgs[0] != "web" || pkgs[1] != "crypto" || pkgs[2] != "database" { return false }

    return true
}
