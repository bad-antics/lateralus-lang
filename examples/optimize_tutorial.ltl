// ===================================================================
// examples/optimize_tutorial.ltl — stdlib/optimize.ltl tutorial companion
// Runnable tour of the numerical-methods module: root finding
// (bisect/newton/secant), integration (trapezoid/simpson),
// differentiation, 1D minimization, interpolation, fixed-point.
// Self-contained; functions are passed as first-class values.
// ===================================================================

fn f_quad(x: float) -> float { return x * x - 2.0 }
fn df_quad(x: float) -> float { return 2.0 * x }
fn f_sq(x: float) -> float { return x * x }
fn df_sq(x: float) -> float { return 2.0 * x }
fn f_shift(x: float) -> float { return (x - 2.0) * (x - 2.0) }
fn g_babylon(x: float) -> float { return 0.5 * (x + 2.0 / x) }

fn bisect(f: fn, a: float, b: float, tol: float) -> float {
    let fa = f(a)
    let lo = a
    let hi = b
    let i = 0
    while i < 100 {
        let mid = (lo + hi) / 2.0
        let fm = f(mid)
        if abs(fm) < tol or (hi - lo) / 2.0 < tol {
            return mid
        }
        if fa * fm < 0.0 {
            hi = mid
        } else {
            lo = mid
            fa = fm
        }
        i = i + 1
    }
    return (lo + hi) / 2.0
}

fn newton(f: fn, df: fn, x0: float, tol: float) -> float {
    let x = x0
    let i = 0
    while i < 100 {
        let fx = f(x)
        if abs(fx) < tol {
            return x
        }
        let dfx = df(x)
        if abs(dfx) < 1e-15 {
            return x
        }
        x = x - fx / dfx
        i = i + 1
    }
    return x
}

fn secant(f: fn, x0: float, x1: float, tol: float) -> float {
    let xprev = x0
    let xcurr = x1
    let i = 0
    while i < 100 {
        let fprev = f(xprev)
        let fcurr = f(xcurr)
        if abs(fcurr) < tol {
            return xcurr
        }
        let xnext = xcurr - fcurr * (xcurr - xprev) / (fcurr - fprev)
        xprev = xcurr
        xcurr = xnext
        i = i + 1
    }
    return xcurr
}

fn trapezoid(f: fn, a: float, b: float, n: int) -> float {
    let h = (b - a) / n
    let s = 0.5 * (f(a) + f(b))
    let i = 1
    while i < n {
        s = s + f(a + i * h)
        i = i + 1
    }
    return s * h
}

fn simpson(f: fn, a: float, b: float, n: int) -> float {
    let h = (b - a) / n
    let s = f(a) + f(b)
    let i = 1
    while i < n {
        if i % 2 == 1 {
            s = s + 4.0 * f(a + i * h)
        } else {
            s = s + 2.0 * f(a + i * h)
        }
        i = i + 1
    }
    return s * h / 3.0
}

fn forward_diff(f: fn, x: float, h: float) -> float {
    return (f(x + h) - f(x)) / h
}

fn central_diff(f: fn, x: float, h: float) -> float {
    return (f(x + h) - f(x - h)) / (2.0 * h)
}

fn second_derivative(f: fn, x: float, h: float) -> float {
    return (f(x + h) - 2.0 * f(x) + f(x - h)) / (h * h)
}

fn golden_section_min(f: fn, a: float, b: float, tol: float) -> float {
    let phi = (sqrt(5.0) - 1.0) / 2.0
    let lo = a
    let hi = b
    let i = 0
    while (hi - lo) > tol and i < 200 {
        let x1 = hi - phi * (hi - lo)
        let x2 = lo + phi * (hi - lo)
        if f(x1) < f(x2) {
            hi = x2
        } else {
            lo = x1
        }
        i = i + 1
    }
    return (lo + hi) / 2.0
}

fn gradient_descent_1d(f: fn, df: fn, x0: float, lr: float, steps: int) -> float {
    let x = x0
    let i = 0
    while i < steps {
        x = x - lr * df(x)
        i = i + 1
    }
    return x
}

fn lerp(a: float, b: float, t: float) -> float {
    return a + t * (b - a)
}

fn bilinear(x: float, y: float, q11: float, q21: float, q12: float, q22: float) -> float {
    let r1 = lerp(q11, q21, x)
    let r2 = lerp(q12, q22, x)
    return lerp(r1, r2, y)
}

fn lagrange_interp(xs: list, ys: list, x: float) -> float {
    let n = len(xs)
    let result = 0.0
    let i = 0
    while i < n {
        let basis = 1.0
        let j = 0
        while j < n {
            if j != i {
                basis = basis * (x - xs[j]) / (xs[i] - xs[j])
            }
            j = j + 1
        }
        result = result + ys[i] * basis
        i = i + 1
    }
    return result
}

fn fixed_point(g: fn, x0: float, tol: float) -> float {
    let x = x0
    let i = 0
    while i < 1000 {
        let x_new = g(x)
        if abs(x_new - x) < tol {
            return x_new
        }
        x = x_new
        i = i + 1
    }
    return x
}

fn main() {
    println("=== LATERALUS STDLIB OPTIMIZE TUTORIAL ===")

    println("STEP 1 root of x^2-2 = sqrt(2):")
    println("  bisect   = " + str(bisect(f_quad, 1.0, 2.0, 1e-12)))
    println("  newton   = " + str(newton(f_quad, df_quad, 1.5, 1e-12)))
    println("  secant   = " + str(secant(f_quad, 1.0, 2.0, 1e-12)))
    println("  sqrt(2)  = " + str(sqrt(2.0)))

    println("STEP 2 integrate x^2 on [0,1] (exact = 0.3333...):")
    println("  trapezoid n=100  = " + str(trapezoid(f_sq, 0.0, 1.0, 100)))
    println("  simpson  n=100  = " + str(simpson(f_sq, 0.0, 1.0, 100)))

    println("STEP 3 derivatives of x^2 at x=3 (f'=6, f''=2):")
    println("  forward = " + str(forward_diff(f_sq, 3.0, 1e-5)))
    println("  central = " + str(central_diff(f_sq, 3.0, 1e-5)))
    println("  second  = " + str(second_derivative(f_sq, 3.0, 1e-3)))

    println("STEP 4 minimize (x-2)^2 on [0,4]:")
    println("  golden_section = " + str(golden_section_min(f_shift, 0.0, 4.0, 1e-10)))
    println("  grad_descent x0=5 lr=0.1 steps=50 = " + str(gradient_descent_1d(f_sq, df_sq, 5.0, 0.1, 50)))

    println("STEP 5 interpolation:")
    println("  lerp(0,10,0.3) = " + str(lerp(0.0, 10.0, 0.3)))
    println("  bilinear center = " + str(bilinear(0.5, 0.5, 0.0, 10.0, 0.0, 20.0)))
    println("  lagrange x^2 at 1.5 = " + str(lagrange_interp([0.0, 1.0, 2.0], [0.0, 1.0, 4.0], 1.5)))

    println("STEP 6 fixed_point g(x)=0.5*(x+2/x) from 1.0:")
    println("  = " + str(fixed_point(g_babylon, 1.0, 1e-12)))
    println("PINNED_VECTORS: bisect=1.4142135623733338 newton=1.4142135623730951 secant=1.4142135623730954 trap=0.33335000000000004 simp=0.3333333333333334 fwd=6.000009999951316 cent=6.000000000039306 d2=2.000000000279556 golden=1.9999999999999998 gd=7.136238463529802e-05 lagrange=2.25 babylon=1.414213562373095")
}

main()
