// Run from the checkout with: python3 scripts/run_lru_tutorial.py
// The runner prepends the unchanged stdlib/lru.ltl source.
fn main() {
    let catalog = {}
    catalog["coffee"] = "Coffee"
    catalog["rice"] = "Rice"
    catalog["beans"] = "Beans"
    let requests = ["coffee", "rice", "coffee", "beans", "rice"]
    let cache = new(2)
    let loads = 0
    for key in requests {
        let result = get(cache, key)
        cache = result[0]
        let value = result[1]
        if value == nil {
            value = catalog[key]
            cache = put(cache, key, value)
            loads = loads + 1
            println("MISS " + key + " -> " + value)
        } else {
            println("HIT " + key + " -> " + value)
        }
    }
    println("oldest=" + all_keys(cache)[0])
    println("newest=" + all_keys(cache)[1])
    println("hits=" + str(hits(cache)))
    println("misses=" + str(misses(cache)))
    println("catalog_loads=" + str(loads))
}
