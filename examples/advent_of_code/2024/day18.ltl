// Advent of Code 2024 · Day 18 · RAM Run
// BFS on a 7x7 memory grid (sample) after the first 12 bytes fall.
// Part 1: shortest path from (0,0) to (6,6) = 22 steps.
// Part 2: first byte that blocks every path = "6,1" (bytes added one at a
// time from byte 13 onward until BFS finds no path).
// Sample answers: part 1 = 22, part 2 = "6,1".

let SAMPLE = "5,4
4,2
4,5
3,0
2,1
6,3
2,4
1,5
0,6
3,3
2,6
5,1
1,2
5,5
2,5
6,5
1,4
0,4
6,4
1,1
6,1
1,0
0,5
1,6
2,0"

fn parse(text: str) -> list {
    let pts = []
    let lines = str_split(text, "\n")
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let parts = str_split(line, ",")
            pts = pts + [[int(parts[0]), int(parts[1])]]
        }
        i = i + 1
    }
    return pts
}

fn key(x: int, y: int) -> str {
    return str(x) + "," + str(y)
}

// BFS shortest distance from (0,0) to (6,6) with the first `n` bytes
// corrupted. Returns -1 when the exit is unreachable.
fn bfs(pts: list, n: int) -> int {
    let blocked = {}
    let i = 0
    while i < n {
        blocked[key(pts[i][0], pts[i][1])] = true
        i = i + 1
    }
    let dist = {}
    dist[key(0, 0)] = 0
    let queue = [[0, 0]]
    let head = 0
    let dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]]
    while head < len(queue) {
        let cur = queue[head]
        head = head + 1
        let x = cur[0]
        let y = cur[1]
        let d = dist[key(x, y)]
        if x == 6 && y == 6 { return d }
        let j = 0
        while j < len(dirs) {
            let nx = x + dirs[j][0]
            let ny = y + dirs[j][1]
            if nx >= 0 && nx <= 6 && ny >= 0 && ny <= 6 {
                let k = key(nx, ny)
                if contains(blocked, k) == false && contains(dist, k) == false {
                    dist[k] = d + 1
                    queue = queue + [[nx, ny]]
                }
            }
            j = j + 1
        }
    }
    return -1
}

fn part1(text: str) -> int {
    let pts = parse(text)
    return bfs(pts, 12)
}

fn part2(text: str) -> str {
    let pts = parse(text)
    let n = 12
    while n < len(pts) {
        n = n + 1
        if bfs(pts, n) == -1 {
            let b = pts[n - 1]
            return str(b[0]) + "," + str(b[1])
        }
    }
    return ""
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 22)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), "6,1")
}

fn main() {
    print("Day 18 Part 1: " + str(part1(SAMPLE)))
    print("Day 18 Part 2: " + part2(SAMPLE))
}

main()
