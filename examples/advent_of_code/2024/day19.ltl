// Advent of Code 2024 · Day 19 · Linen Layout
// Count how many desired designs can be built by concatenating available
// towel patterns (part 1), and the total number of distinct ways to build
// them (part 2). Memoised recursion over the remaining suffix of a design.
// Sample answers: part 1 = 6, part 2 = 16.

let SAMPLE = "r, wr, b, g, bwu, rb, gb, br

brwrr
bggr
gbbr
rrbgbr
ubwu
bwurrg
brgr
bbrgwb"

fn parse(text: str) -> list {
    let blocks = str_split(text, "\n\n")
    let towels = str_split(blocks[0], ", ")
    let designs = []
    let lines = str_split(blocks[1], "\n")
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            designs = designs + [line]
        }
        i = i + 1
    }
    return [towels, designs]
}

// Number of ways to build `design` from `towels`, memoised on the
// remaining suffix string. The empty design can be built in exactly 1 way.
fn count_ways(design: str, towels: list, memo: dict) -> int {
    if len(design) == 0 { return 1 }
    if contains(memo, design) { return memo[design] }
    let total = 0
    let i = 0
    while i < len(towels) {
        let t = towels[i]
        if str_starts_with(design, t) {
            let rest = slice(design, len(t), len(design))
            total = total + count_ways(rest, towels, memo)
        }
        i = i + 1
    }
    memo[design] = total
    return total
}

fn all_counts(text: str) -> list {
    let p = parse(text)
    let towels = p[0]
    let designs = p[1]
    let memo = {}
    let counts = []
    let i = 0
    while i < len(designs) {
        counts = counts + [count_ways(designs[i], towels, memo)]
        i = i + 1
    }
    return counts
}

fn part1(text: str) -> int {
    let counts = all_counts(text)
    let total = 0
    let i = 0
    while i < len(counts) {
        if counts[i] > 0 { total = total + 1 }
        i = i + 1
    }
    return total
}

fn part2(text: str) -> int {
    let counts = all_counts(text)
    let total = 0
    let i = 0
    while i < len(counts) {
        total = total + counts[i]
        i = i + 1
    }
    return total
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 6)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 16)
}

fn main() {
    print("Day 19 Part 1: " + str(part1(SAMPLE)))
    print("Day 19 Part 2: " + str(part2(SAMPLE)))
}

main()
