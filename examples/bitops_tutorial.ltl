// Runnable companion for docs/blog/bitops-tutorial.ltlml
module examples.bitops_tutorial

import bitops
import io

fn main() {
    let flags: u64 = bitops.bit_set(0, 1)
    let flags2: u64 = bitops.bit_set(flags, 5)
    io.println(flags2 as str)   // expected: 34
    io.println(bitops.popcount(flags2) as str) // expected: 2
    io.println(bitops.extract_bits(0xD6, 1, 3) as str) // expected: 3
    io.println(bitops.is_power_of_2(64) as str) // expected: true
    io.println(bitops.bswap16(0x1234) as str) // expected: 13330
}

main()
