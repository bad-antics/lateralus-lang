      "}"
    ],
    "description": "If statement"
  },
  "Lateralus If-Else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "If-else statement"
  },
  "Lateralus If-Elif-Else": {
    "prefix": "ifee",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} elif ${3:condition} {",
      "\t${4}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "If-elif-else chain"
  },
  "Lateralus Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
