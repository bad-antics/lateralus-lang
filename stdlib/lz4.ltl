// ===================================================================
// stdlib/lz4.ltl  —  LZ4 block format codec (pure Lateralus)
// -------------------------------------------------------------------
// Implements the LZ4 block format (lz4 frame NOT included — use the
// "legacy" block mode: token byte, literal length extension, literal
// bytes, 2-byte little-endian match offset, match length extension).
//
// Reference: https://github.com/lz4/lz4/blob/dev/doc/lz4_Block_format.md
//
// The compressor is a simple 16-bit hash-chain greedy matcher
// (lz4-style "fast" mode); the decompressor is canonical.
// ===================================================================

let LZ4_MINMATCH   = 4
let LZ4_HASH_BITS  = 12
let LZ4_HASH_SIZE  = 4096       // 1 << 12
let LZ4_HASH_MASK  = 4095
let LZ4_MF_LIMIT   = 12         // last match cannot start within 12 of end
let LZ4_LAST_LITS  = 5          // last 5 bytes are always literals
let LZ4_MAXD       = 65535

fn hash4(buf: list, i: int) -> int {
    let v = buf[i] | (buf[i + 1] << 8)
          | (buf[i + 2] << 16) | (buf[i + 3] << 24)
    // Knuth multiplicative hash → top LZ4_HASH_BITS bits.
    return ((v * 2654435761) >> (32 - LZ4_HASH_BITS)) & LZ4_HASH_MASK
}

// Output is written into a pre-sized buffer through an explicit
// position (`out[pos] = b`) rather than `out = out + [b]`, which copies
// the whole list per byte and makes large inputs quadratic.

// n zero bytes, built by doubling.
fn lz4_zeros(n: int) -> list {
    if n <= 0 { return [] }
    let z = [0]
    while len(z) < n { z = z + z }
    return slice(z, 0, n)
}

// Make sure buf can hold `need` bytes (doubling growth).
fn lz4_reserve(buf: list, need: int) -> list {
    let b = buf
    while len(b) < need { b = b + lz4_zeros(len(b) + 16) }
    return b
}

// Write an LZ4 length extension (runs of 255 + remainder) at pos.
// Returns the new position.
fn put_var_len(out: list, pos: int, v: int) -> int {
    while v >= 255 {
        out[pos] = 255
        pos = pos + 1
        v = v - 255
    }
    out[pos] = v
    return pos + 1
}

// Write a token + literal run src[at .. at+lit_len) at pos.
fn put_literals(out: list, pos: int, src: list, at: int,
                lit_len: int, mlen_t: int) -> int {
    let t_lit = lit_len
    if t_lit > 15 { t_lit = 15 }
    let t_m = mlen_t
    if t_m > 15 { t_m = 15 }
    out[pos] = ((t_lit << 4) | t_m) & 0xff
    pos = pos + 1
    if lit_len >= 15 { pos = put_var_len(out, pos, lit_len - 15) }
    let k = 0
    while k < lit_len {
        out[pos + k] = src[at + k]
        k = k + 1
    }
    return pos + lit_len
}

/// Compress a byte list to an LZ4 block (no frame header).
pub fn compress(src: list) -> list {
    let n = len(src)
    // Worst case: every byte a literal, plus length extensions + token.
    let out = lz4_zeros(n + idiv(n, 255) + 16)
    let pos = 0
    let anchor = 0       // start of pending literals
    let i = 0
    if n < LZ4_MF_LIMIT + LZ4_LAST_LITS {
        // too small — whole thing as one literal run
        pos = put_literals(out, pos, src, 0, n, 0)
        return slice(out, 0, pos)
    }
    // hash table: position of last occurrence for each 4-byte prefix
    let htab = [-1]
    while len(htab) < LZ4_HASH_SIZE { htab = htab + htab }
    let end_limit = n - LZ4_MF_LIMIT - LZ4_LAST_LITS
    while i <= end_limit {
        let hv = hash4(src, i)
        let ref_pos = htab[hv]
        htab[hv] = i
        if ref_pos >= 0 && i - ref_pos <= LZ4_MAXD
           && src[ref_pos]     == src[i]
           && src[ref_pos + 1] == src[i + 1]
           && src[ref_pos + 2] == src[i + 2]
           && src[ref_pos + 3] == src[i + 3] {
            // match — extend
            let mlen = 4
            while i + mlen < n - LZ4_LAST_LITS
                  && src[ref_pos + mlen] == src[i + mlen] {
                mlen = mlen + 1
            }
            let mlen_t = mlen - LZ4_MINMATCH
            pos = put_literals(out, pos, src, anchor, i - anchor, mlen_t)
            // match offset (little-endian)
            let off = i - ref_pos
            out[pos] = off & 0xff
            out[pos + 1] = (off >> 8) & 0xff
            pos = pos + 2
            if mlen_t >= 15 { pos = put_var_len(out, pos, mlen_t - 15) }
            i = i + mlen
            anchor = i
        } else {
            i = i + 1
        }
    }
    // last literal run (contains the tail)
    pos = put_literals(out, pos, src, anchor, n - anchor, 0)
    return slice(out, 0, pos)
}

/// Decompress an LZ4 block.
pub fn decompress(src: list) -> list {
    let n = len(src)
    let out = lz4_zeros(4 * n + 64)
    let pos = 0
    let i = 0
    while i < n {
        let tok = src[i]
        i = i + 1
        // -- literal length
        let lit_len = (tok >> 4) & 0x0f
        if lit_len == 15 {
            let more = true
            while more {
                let b = src[i]
                i = i + 1
                lit_len = lit_len + b
                if b != 255 { more = false }
            }
        }
        // -- literals
        out = lz4_reserve(out, pos + lit_len)
        let k = 0
        while k < lit_len { out[pos + k] = src[i + k]; k = k + 1 }
        pos = pos + lit_len
        i = i + lit_len
        if i >= n { return slice(out, 0, pos) }
        // -- match offset
        let off = src[i] | (src[i + 1] << 8)
        i = i + 2
        // -- match length
        let mlen = tok & 0x0f
        if mlen == 15 {
            let more2 = true
            while more2 {
                let b2 = src[i]
                i = i + 1
                mlen = mlen + b2
                if b2 != 255 { more2 = false }
            }
        }
        mlen = mlen + LZ4_MINMATCH
        // -- copy from history (byte-wise to support overlap / RLE)
        out = lz4_reserve(out, pos + mlen)
        let start = pos - off
        let m = 0
        while m < mlen { out[pos + m] = out[start + m]; m = m + 1 }
        pos = pos + mlen
    }
    return slice(out, 0, pos)
}
