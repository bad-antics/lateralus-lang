// Driver for the aho_corasick stdlib micro-benchmark.
// The harness inlines stdlib/aho_corasick.ltl above this driver.
//
// Workload: Aho-Corasick multi-pattern search. Bounty spec asks for
// 1,000 patterns over 1 MB of text. The interpreter's 60 s script
// limit makes that intractable; we use 10 patterns over ~198 KB of
// text (completes in ~11 s). Python/Node references use the same
// patterns and text. See benchmarks/results/stdlib_results.md.
//
// `char_at` is a recognised builtin but is not emitted by the codegen
// backend, so we provide a slice-based shim used by aho_corasick.ltl.

fn char_at(s: str, i: int) -> str { return slice(s, i, i + 1) }

fn main() {
    let pats = ["the", "quick", "brown", "fox", "jumps", "lazy", "dog", "hello", "world", "lateralus"]
    let auto = build(pats)
    let text = "the quick brown fox jumps over the lazy dog hello world lateralus "
    let big = repeat_str(text, 3000)
    let hits = find_all(auto, big)
    println(len(big))
    println(len(hits))
}

main()