// Rosetta Code · Run-length encoding · Lateralus
// "aaabcc" -> "3a1b2c" and back. No `break` in the dialect, so runs use a flag.

fn rle_encode(s: str) -> str {
    let out = ""
    let i = 0
    let n = len(s)
    while i < n {
        let c = slice(s, i, i + 1)
        let run = 1
        let alive = true
        while alive {
            if i + run < n {
                if slice(s, i + run, i + run + 1) == c {
                    run = run + 1
                } else {
                    alive = false
                }
            } else {
                alive = false
            }
        }
        out = out + str(run) + c
        i = i + run
    }
    return out
}

fn rle_decode(s: str) -> str {
    let out = ""
    let i = 0
    while i < len(s) {
        let digits = ""
        let scanning = true
        while scanning {
            if i < len(s) {
                let o = ord(slice(s, i, i + 1))
                if o >= 48 {
                    if o <= 57 {
                        digits = digits + slice(s, i, i + 1)
                        i = i + 1
                    } else {
                        scanning = false
                    }
                } else {
                    scanning = false
                }
            } else {
                scanning = false
            }
        }
        if len(digits) > 0 {
            let c = slice(s, i, i + 1)
            let n = int(digits)
            let k = 0
            while k < n {
                out = out + c
                k = k + 1
            }
            i = i + 1
        }
    }
    return out
}

fn main() {
    assert_eq(rle_encode("aaabcc"), "3a1b2c", "small")
    assert_eq(rle_encode("WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWBWWWWWWWWWWWWWW"), "12W1B12W3B24W1B14W", "encode")
    assert_eq(rle_decode("12W1B12W3B24W1B14W"), "WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWBWWWWWWWWWWWWWW", "decode")
    assert_eq(rle_decode(rle_encode("aabbaa")), "aabbaa", "roundtrip")
    print("rle_encode(\"aaabcc\") = " + rle_encode("aaabcc"))
}

main()
