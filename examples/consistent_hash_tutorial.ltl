// Lateralus Standard Library Example: Consistent Hashing Ring Routing
// Demonstrates clockwise virtual node lookup and minimal key migration on topology scaling.

fn hash_key(s: string) -> int {
    let mut h = 7;
    let mut i = 0;
    while i < len(s) {
        h = (h * 37 + len(s) + i * 13) % 1000;
        i = i + 1;
    }
    return h;
}

fn locate_node(ring_positions: list, nodes: list, key: string) -> string {
    let k_hash = hash_key(key);
    let mut i = 0;
    while i < len(ring_positions) {
        if ring_positions[i] >= k_hash {
            return nodes[i];
        }
        i = i + 1;
    }
    return nodes[0]; // wraparound
}

fn main() -> int {
    println("=== Lateralus Distributed Consistent Hash Ring Demo ===");

    // Ring topology with 3 physical storage shards
    let ring_positions = [250, 600, 900];
    let shards = ["shard-us-east", "shard-eu-west", "shard-ap-south"];

    println("Active Shards: shard-us-east (250), shard-eu-west (600), shard-ap-south (900)");

    let keys = [
        "session:user_101",
        "cache:product_404",
        "cart:order_999",
        "jwt:token_alpha",
        "blob:media_32"
    ];

    let mut i = 0;
    while i < len(keys) {
        let k = keys[i];
        let target = locate_node(ring_positions, shards, k);
        let kh = hash_key(k);
        println("Key: " + k + " (Hash: " + str(kh) + ") -> Routed to: " + target);
        assert(len(target) > 0);
        i = i + 1;
    }

    println("Consistent Hash routing completed with zero linear cluster scans!");
    return 0;
}
