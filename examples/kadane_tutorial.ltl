// ===================================================================
// examples/kadane_tutorial.ltl
// -------------------------------------------------------------------
// Practical example demonstrating Kadane's Maximum Subarray and 2D
// Submatrix algorithm for quantitative trading streak analysis and
// financial heatmap peak yield detection.
// ===================================================================

pub fn kadane_1d(nums) {
    let n = len(nums)
    if n == 0 {
        let res = dict()
        res["max_sum"] = 0
        res["start"] = -1
        res["end"] = -1
        return res
    }

    let max_so_far = nums[0]
    let current_max = nums[0]
    let start_idx = 0
    let end_idx = 0
    let temp_start = 0

    let i = 1
    while i < n {
        let x = nums[i]
        if x > current_max + x {
            current_max = x
            temp_start = i
        } else {
            current_max = current_max + x
        }

        if current_max > max_so_far {
            max_so_far = current_max
            start_idx = temp_start
            end_idx = i
        }
        i = i + 1
    }

    let res = dict()
    res["max_sum"] = max_so_far
    res["start"] = start_idx
    res["end"] = end_idx
    return res
}

pub fn kadane_2d(matrix, rows, cols) {
    if rows == 0 or cols == 0 {
        let res = dict()
        res["max_sum"] = 0
        res["r1"] = -1
        res["r2"] = -1
        res["c1"] = -1
        res["c2"] = -1
        return res
    }

    let global_max = matrix[0][0]
    let best_r1 = 0
    let best_r2 = 0
    let best_c1 = 0
    let best_c2 = 0

    let r1 = 0
    while r1 < rows {
        let col_sums = []
        let c = 0
        while c < cols {
            col_sums = push(col_sums, 0)
            c = c + 1
        }

        let r2 = r1
        while r2 < rows {
            let col_idx = 0
            while col_idx < cols {
                col_sums[col_idx] = col_sums[col_idx] + matrix[r2][col_idx]
                col_idx = col_idx + 1
            }

            let sub_res = kadane_1d(col_sums)
            if sub_res["max_sum"] > global_max {
                global_max = sub_res["max_sum"]
                best_r1 = r1
                best_r2 = r2
                best_c1 = sub_res["start"]
                best_c2 = sub_res["end"]
            }
            r2 = r2 + 1
        }
        r1 = r1 + 1
    }

    let res = dict()
    res["max_sum"] = global_max
    res["r1"] = best_r1
    res["r2"] = best_r2
    res["c1"] = best_c1
    res["c2"] = best_c2
    return res
}

pub fn main() {
    print("=== Quantitative Trading Strategy PnL Momentum Detection ===")
    print("Analyzing daily trading returns for peak cumulative winning streak...")

    // Consecutive daily returns (in basis points / tenths of a percent)
    let daily_returns = [-3, 2, -1, 4, 5, -2, 6, -8, 1]

    let pnl_result = kadane_1d(daily_returns)

    print("Peak Cumulative Return (basis points):")
    print(pnl_result["max_sum"])

    print("Winning Streak Day Start Index:")
    print(pnl_result["start"])

    print("Winning Streak Day End Index:")
    print(pnl_result["end"])

    print("=== Cross-Asset Sector Heatmap Yield Optimization ===")
    // 3x4 sector yield delta matrix across asset classes and quarters
    let sector_matrix = [
        [ 2,  1, -3, -4],
        [-1,  5,  6, -2],
        [-3,  2,  4,  1]
    ]

    let submatrix_result = kadane_2d(sector_matrix, 3, 4)

    print("Maximum Submatrix Cumulative Yield:")
    print(submatrix_result["max_sum"])

    print("Optimal Submatrix Top Row (r1):")
    print(submatrix_result["r1"])

    print("Optimal Submatrix Bottom Row (r2):")
    print(submatrix_result["r2"])

    print("Optimal Submatrix Left Col (c1):")
    print(submatrix_result["c1"])

    print("Optimal Submatrix Right Col (c2):")
    print(submatrix_result["c2"])
}
