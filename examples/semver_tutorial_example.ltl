// ===================================================================
// examples/semver_tutorial.ltl -- stdlib semver tutorial example
// Companion example for the stdlib.semver blog tutorial.
//
// Scenario: a release gate. Given a mixed list of version strings
// (stable releases and pre-releases), find the newest stable one
// and compute the next minor release from it.
// ===================================================================

// stdlib pub functions are called with the module prefix:
// semver_parse, semver_compare, semver_to_string, ...

let versions = ["1.2.3", "1.3.0-beta.1", "1.2.9", "1.3.0"]

let best = semver_parse("0.0.0")
let i = 0
while i < len(versions) {
    let parsed = semver_parse(versions[i])
    if semver_is_stable(parsed) and semver_compare(parsed, best) > 0 {
        best = parsed
    }
    i = i + 1
}

println("Latest stable: {semver_to_string(best)}")
println("Next minor:    {semver_to_string(semver_bump_minor(best))}")
println("Next patch:    {semver_to_string(semver_bump_patch(best))}")

// Expected output:
//   Latest stable: 1.3.0
//   Next minor:    1.4.0
//   Next patch:    1.3.1
//
// Why 1.3.0 wins: "1.3.0-beta.1" is a pre-release, so the gate skips
// it; "1.3.0" stable beats "1.2.9" on the minor field (3 > 2).
