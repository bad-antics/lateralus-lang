// examples/base64_tutorial.ltl - Demonstrates stdlib.base64 encoding and decoding
import stdlib.base64

fn main() {
    let message = "Lateralus Standard Library Base64"
    let enc = base64.encode(message)
    let dec = base64.decode(enc)
    
    let url_data = "https://example.com/api?a=1&b=+2/3"
    let url_enc = base64.encode_url(url_data)
    let url_dec = base64.decode_url(url_enc)
    
    let valid = base64.is_valid(enc)
    let est_len = base64.encoded_length(len(message))
    let dec_len = base64.decoded_length(enc)
}
