#!/usr/bin/env lateralus
import semver

fn main() {
    let v1 = parse("v1.2.3-beta.1+build.42")
    let v2 = parse("1.2.3")
    let v3 = parse("1.3.0")

    print("parsed:", to_string(v1))
    print("compare(pre, stable):", compare(v1, v2))
    print("eq ignoring build:", eq(parse("1.2.3+a"), parse("1.2.3+b")))
    print("bump_minor:", to_string(bump_minor(v2)))
    print("bump_major:", to_string(bump_major(v2)))
    print("caret ^1.2 on 1.3.0:", satisfies_caret(v3, 1, 2))
    print("tilde ~1.2 on 1.3.0:", satisfies_tilde(v3, 1, 2))
}
main()
