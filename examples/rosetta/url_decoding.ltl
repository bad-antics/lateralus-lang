// Rosetta Code · URL decoding · Lateralus
// https://rosettacode.org/wiki/URL_decoding
//
// Turn %XX escapes back into bytes, then decode the byte stream as UTF-8 so
// multi-byte sequences such as %C3%A1 become a single character. Each escape
// is decoded exactly once, so "%25%32%35" yields the literal text "%25".

let HEX = "0123456789abcdef"

fn hex_digit(c: str) -> int {
    let lc = str_lower(c)
    let i = 0
    while i < 16 {
        if slice(HEX, i, i + 1) == lc { return i }
        i = i + 1
    }
    return -1
}

fn percent_bytes(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        let c = slice(s, i, i + 1)
        if c == "%" && i + 2 < len(s) {
            let hi = hex_digit(slice(s, i + 1, i + 2))
            let lo = hex_digit(slice(s, i + 2, i + 3))
            if hi >= 0 && lo >= 0 {
                out = out + [hi * 16 + lo]
                i = i + 3
                continue
            }
        }
        out = out + [ord(c)]
        i = i + 1
    }
    return out
}

fn utf8_decode(bytes: list) -> str {
    let out = ""
    let i = 0
    while i < len(bytes) {
        let b = bytes[i]
        let cp = b
        let extra = 0
        if b >= 0xF0      { cp = b & 0x07; extra = 3 }
        else if b >= 0xE0 { cp = b & 0x0F; extra = 2 }
        else if b >= 0xC0 { cp = b & 0x1F; extra = 1 }
        let k = 1
        while k <= extra {
            cp = (cp << 6) | (bytes[i + k] & 0x3F)
            k = k + 1
        }
        out = out + chr(cp)
        i = i + 1 + extra
    }
    return out
}

fn url_decode(s: str) -> str {
    return utf8_decode(percent_bytes(s))
}

fn main() {
    // All three examples from the Rosetta task.
    let cases = [
        ["http%3A%2F%2Ffoo%20bar%2F", "http://foo bar/"],
        ["google.com/search?q=%60Abdu%27l-Bah%C3%A1", "google.com/search?q=`Abdu'l-Bah" + chr(0xE1)],
        ["%25%32%35", "%25"]
    ]
    let i = 0
    while i < len(cases) {
        let got = url_decode(cases[i][0])
        print(cases[i][0] + "  ->  " + got)
        assert_eq(got, cases[i][1])
        i = i + 1
    }

    // Lower-case hex digits and a 4-byte UTF-8 sequence (U+1D11E).
    assert_eq(url_decode("%e2%82%ac"), chr(0x20AC))
    assert_eq(url_decode("%F0%9D%84%9E"), chr(0x1D11E))
    // A stray percent sign that is not a valid escape is kept literally.
    assert_eq(url_decode("100%"), "100%")
}

main()
