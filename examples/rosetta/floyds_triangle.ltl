// Rosetta Code · Floyd's triangle · Lateralus

fn floyd_rows(n: int) -> list {
    let rows = []
    let v = 1
    let r = 1
    while r <= n {
        let row = []
        let c = 0
        while c < r {
            row = row + [v]
            v = v + 1
            c = c + 1
        }
        rows = rows + [row]
        r = r + 1
    }
    return rows
}

fn main() {
    let rows = floyd_rows(5)
    assert_eq(rows[0], [1], "row 1")
    assert_eq(rows[4], [11, 12, 13, 14, 15], "row 5")
    assert_eq(len(rows), 5, "row count")
    let i = 0
    while i < len(rows) {
        print(str_join(to_str_list(rows[i]), " "))
        i = i + 1
    }
}

fn to_str_list(xs: list) -> list {
    let out = []
    let i = 0
    while i < len(xs) {
        out = out + [str(xs[i])]
        i = i + 1
    }
    return out
}

main()
