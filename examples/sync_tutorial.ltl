// =======================================================================
// examples/sync_tutorial.ltl — Concurrency Synchronization & Atomics Demo
// =======================================================================

println("=== Lateralus stdlib.sync Demonstration ===")

// 1. Spinlock Lifecycle
let lock = spinlock_new()
println("Spinlock initialized")

let acquired = spinlock_try_lock(lock)
println("Spinlock try_lock: " + to_str(acquired))
spinlock_unlock(lock)
println("Spinlock unlocked")

// 2. Cooperative Mutex
let m = mutex_new()
mutex_lock(m)
println("Mutex acquired, locked state: " + to_str(m.locked))
mutex_unlock(m)
println("Mutex released, locked state: " + to_str(m.locked))

// 3. Atomic Memory Operations
let cell = 1000 as Ptr<u32>
atomic_store(cell, 256)
let val = atomic_load(cell)
println("Atomic load from cell 1000: " + to_str(val))

let old_cas = atomic_cas(cell, 256, 512)
println("Atomic CAS old value: " + to_str(old_cas))

// 4. Memory Barriers
compiler_barrier()
memory_barrier()
read_barrier()
write_barrier()
println("Hardware memory barriers executed successfully.")

println("Sync tutorial completed successfully.")
