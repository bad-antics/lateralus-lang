// tests/stdlib_red_black_tree_tutorial.ltl
// Comprehensive Golden Test Vectors for Red-Black Tree Invariants

fn is_red(nodes: list, idx: int) -> int {
    if idx == -1 {
        return 0
    }
    let node: map = nodes[idx]
    let c: int = node.color
    return c
}

fn set_color(nodes: list, idx: int, color: int) -> void {
    if idx != -1 {
        let node: map = nodes[idx]
        node.color = color
    }
}

fn get_parent(nodes: list, idx: int) -> int {
    if idx == -1 {
        return -1
    }
    let node: map = nodes[idx]
    let p: int = node.parent
    return p
}

fn get_left(nodes: list, idx: int) -> int {
    if idx == -1 {
        return -1
    }
    let node: map = nodes[idx]
    let l: int = node.left
    return l
}

fn get_right(nodes: list, idx: int) -> int {
    if idx == -1 {
        return -1
    }
    let node: map = nodes[idx]
    let r: int = node.right
    return r
}

fn rb_left_rotate(tree: map, x: int) -> void {
    let nodes: list = tree.nodes
    let node_x: map = nodes[x]
    let y: int = node_x.right
    let node_y: map = nodes[y]
    
    node_x.right = node_y.left
    if node_y.left != -1 {
        let y_left_node: map = nodes[node_y.left]
        y_left_node.parent = x
    }
    
    node_y.parent = node_x.parent
    if node_x.parent == -1 {
        tree.root = y
    } else {
        let node_p: map = nodes[node_x.parent]
        if x == node_p.left {
            node_p.left = y
        } else {
            node_p.right = y
        }
    }
    
    node_y.left = x
    node_x.parent = y
}

fn rb_right_rotate(tree: map, y: int) -> void {
    let nodes: list = tree.nodes
    let node_y: map = nodes[y]
    let x: int = node_y.left
    let node_x: map = nodes[x]
    
    node_y.left = node_x.right
    if node_x.right != -1 {
        let x_right_node: map = nodes[node_x.right]
        x_right_node.parent = y
    }
    
    node_x.parent = node_y.parent
    if node_y.parent == -1 {
        tree.root = x
    } else {
        let node_p: map = nodes[node_y.parent]
        if y == node_p.left {
            node_p.left = x
        } else {
            node_p.right = x
        }
    }
    
    node_x.right = y
    node_y.parent = x
}

fn rb_insert_fixup(tree: map, z_init: int) -> void {
    let nodes: list = tree.nodes
    let z: int = z_init
    
    while z != tree.root and is_red(nodes, get_parent(nodes, z)) == 1 {
        let p: int = get_parent(nodes, z)
        let gp: int = get_parent(nodes, p)
        
        if p == get_left(nodes, gp) {
            let y: int = get_right(nodes, gp)
            if is_red(nodes, y) == 1 {
                set_color(nodes, p, 0)
                set_color(nodes, y, 0)
                set_color(nodes, gp, 1)
                z = gp
            } else {
                if z == get_right(nodes, p) {
                    z = p
                    rb_left_rotate(tree, z)
                    p = get_parent(nodes, z)
                    gp = get_parent(nodes, p)
                }
                set_color(nodes, p, 0)
                set_color(nodes, gp, 1)
                rb_right_rotate(tree, gp)
            }
        } else {
            let y: int = get_left(nodes, gp)
            if is_red(nodes, y) == 1 {
                set_color(nodes, p, 0)
                set_color(nodes, y, 0)
                set_color(nodes, gp, 1)
                z = gp
            } else {
                if z == get_left(nodes, p) {
                    z = p
                    rb_right_rotate(tree, z)
                    p = get_parent(nodes, z)
                    gp = get_parent(nodes, p)
                }
                set_color(nodes, p, 0)
                set_color(nodes, gp, 1)
                rb_left_rotate(tree, gp)
            }
        }
    }
    
    set_color(nodes, tree.root, 0)
}

fn rb_insert(tree: map, key: int, val: int) -> void {
    let nodes: list = tree.nodes
    let new_idx: int = len(nodes)
    let new_node = {
        key: key,
        val: val,
        color: 1,
        parent: -1,
        left: -1,
        right: -1
    }
    nodes.append(new_node)
    
    let y: int = -1
    let x: int = tree.root
    
    while x != -1 {
        y = x
        let node_x: map = nodes[x]
        let k_x: int = node_x.key
        if key < k_x {
            x = node_x.left
        } else if key > k_x {
            x = node_x.right
        } else {
            node_x.val = val
            return
        }
    }
    
    new_node.parent = y
    if y == -1 {
        tree.root = new_idx
    } else {
        let node_y: map = nodes[y]
        let k_y: int = node_y.key
        if key < k_y {
            node_y.left = new_idx
        } else {
            node_y.right = new_idx
        }
    }
    
    rb_insert_fixup(tree, new_idx)
    let c: int = tree.count
    tree.count = c + 1
}

fn rb_search(tree: map, key: int) -> int {
    let nodes: list = tree.nodes
    let curr: int = tree.root
    while curr != -1 {
        let node: map = nodes[curr]
        let k: int = node.key
        if key == k {
            return node.val
        } else if key < k {
            curr = node.left
        } else {
            curr = node.right
        }
    }
    return -1
}

fn rb_inorder_rec(nodes: list, curr: int, out: list) -> void {
    if curr == -1 {
        return
    }
    let node: map = nodes[curr]
    rb_inorder_rec(nodes, node.left, out)
    out.append(node.key)
    rb_inorder_rec(nodes, node.right, out)
}

fn rb_inorder(tree: map) -> list {
    let out: list = []
    let nodes: list = tree.nodes
    rb_inorder_rec(nodes, tree.root, out)
    return out
}

fn check_no_consecutive_red(nodes: list, curr: int) -> int {
    if curr == -1 {
        return 1
    }
    let node: map = nodes[curr]
    if node.color == 1 {
        if is_red(nodes, node.left) == 1 or is_red(nodes, node.right) == 1 {
            return 0
        }
    }
    let l_ok: int = check_no_consecutive_red(nodes, node.left)
    let r_ok: int = check_no_consecutive_red(nodes, node.right)
    if l_ok == 1 and r_ok == 1 {
        return 1
    }
    return 0
}

fn check_black_height(nodes: list, curr: int) -> int {
    if curr == -1 {
        return 1
    }
    let node: map = nodes[curr]
    let left_bh: int = check_black_height(nodes, node.left)
    let right_bh: int = check_black_height(nodes, node.right)
    if left_bh == -1 or right_bh == -1 or left_bh != right_bh {
        return -1
    }
    let add: int = 0
    if node.color == 0 {
        add = 1
    }
    return left_bh + add
}

fn create_rb_tree() -> map {
    let empty_nodes: list = []
    return {
        root: -1,
        count: 0,
        nodes: empty_nodes
    }
}

fn test_monotonic_and_invariants() -> int {
    let tree: map = create_rb_tree()
    
    // Insert sequence: 10, 20, 30, 15, 25, 5, 1
    rb_insert(tree, 10, 100)
    rb_insert(tree, 20, 200)
    rb_insert(tree, 30, 300)
    rb_insert(tree, 15, 150)
    rb_insert(tree, 25, 250)
    rb_insert(tree, 5, 50)
    rb_insert(tree, 1, 10)
    
    let nodes: list = tree.nodes
    let root_node: map = nodes[tree.root]
    
    // Invariant 2: Root must be BLACK
    if root_node.color != 0 {
        return 1
    }
    
    // Invariant 4: No consecutive RED nodes
    if check_no_consecutive_red(nodes, tree.root) != 1 {
        return 2
    }
    
    // Invariant 5: Black-height equality
    if check_black_height(nodes, tree.root) <= 0 {
        return 3
    }
    
    // In-order traversal must be sorted: [1, 5, 10, 15, 20, 25, 30]
    let sorted: list = rb_inorder(tree)
    if len(sorted) != 7 {
        return 4
    }
    
    let i: int = 1
    while i < len(sorted) {
        let prev: int = sorted[i - 1]
        let curr: int = sorted[i]
        if prev >= curr {
            return 5
        }
        i = i + 1
    }
    
    // Search queries
    if rb_search(tree, 15) != 150 {
        return 6
    }
    if rb_search(tree, 999) != -1 {
        return 7
    }
    
    return 0
}

fn main() -> int {
    let status: int = test_monotonic_and_invariants()
    if status == 0 {
        print("ALL_RED_BLACK_TREE_TESTS_PASSED")
    } else {
        print("TEST_FAILED_STATUS_CODE:")
        print(status)
    }
    return status
}
