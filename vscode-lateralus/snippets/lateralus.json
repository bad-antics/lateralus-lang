  "std:aho_corasick build+find": {
    "prefix": "aho",
    "body": [
      "from stdlib.aho_corasick import build, find_all",
      "let ac = build([${1:\"error\", \"warning\"}])",
      "let hits = find_all(ac, ${2:text})",
      "println(str(hits))"
    ],
    "description": "aho_corasick: multi-pattern search"
  },
  "std:base64 encode/decode": {
    "prefix": "b64",
    "body": [
      "from stdlib.base64 import encode, decode",
      "let enc = encode(${1:data})",
      "let dec = decode(enc)",
      "println(dec)"
    ],
    "description": "base64: roundtrip"
  },
  "std:blake2s hash": {
    "prefix": "blake",
    "body": [
      "from stdlib.blake2s import hash256_str",
      "println(hash256_str(${1:\"data\"}))"
    ],
    "description": "blake2s: fast hash"
  },
  "std:bloom filter": {
    "prefix": "bloom",
    "body": [
      "from stdlib.bloom import new_filter, hash_positions, bit_set",
      "let bf = new_filter(${1:1000}, ${2:0.01})",
      "// add + check membership"
    ],
    "description": "bloom: probabilistic membership"
  },
  "std:bitops bit test": {
    "prefix": "bit",
    "body": [
      "from stdlib.bitops import bit_set, bit_test",
      "if bit_test(${1:flags}, ${2:3}) { println(\"bit is set\") }"
    ],
    "description": "bitops: flag manipulation"
  },
  "std:channel send/recv": {
    "prefix": "chan",
    "body": [
      "from stdlib.channel import channel_new, channel_send, channel_recv",
      "let ch = channel_new(${1:10})",
      "channel_send(ch, ${2:message})",
      "println(str(channel_recv(ch)))"
    ],
    "description": "channel: CSP-style communication"
  },
  "std:chacha20 encrypt": {
    "prefix": "chacha",
    "body": [
