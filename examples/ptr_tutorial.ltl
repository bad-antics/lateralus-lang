// =======================================================================
// examples/ptr_tutorial.ltl — Raw pointer arithmetic & alignment demo
// =======================================================================

println("=== Lateralus stdlib.ptr Demonstration ===")

// 1. Null check and validity
let p0 = null()
println("Base null pointer initialized")
let p_alloc = offset(p0, 4096)
println("Allocated simulated block at offset 4096")

// 2. Alignment
let unaligned = offset(p_alloc, 7)
let aligned_8 = align_up(unaligned, 8)
println("Aligned address to 8-byte boundary")

// 3. Typed writes and reads
write_u8(aligned_8, 66)
let val8 = read_u8(aligned_8)
println("Read back written u8 value: " + to_str(val8))

let u32_ptr = offset(aligned_8, 4)
write_u32(u32_ptr, 305419896)
let val32 = read_u32(u32_ptr)
println("Read back written u32 value: " + to_str(val32))

// 4. Memory copy and verification
let dst_ptr = offset(p_alloc, 64)
write_bytes(p_alloc, 170, 16)
copy_nonoverlapping(dst_ptr, p_alloc, 16, 1)
let copied_byte = read_u8(dst_ptr)
println("Copied buffer verified byte: " + to_str(copied_byte))

println("Pointer tutorial completed successfully.")
