// Rosetta Code: Binary search — find index of target in sorted list
fn bsearch(arr: list, target: int) -> int {
    let mut lo = 0
    let mut hi = len(arr) - 1
    while lo <= hi {
        let mid = int((lo + hi) / 2)
        if arr[mid] == target { return mid }
        if arr[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}

let xs = [1, 3, 5, 7, 9, 11, 13, 15]
println("index of 7  = " + str(bsearch(xs, 7)))
println("index of 15 = " + str(bsearch(xs, 15)))
println("index of 4  = " + str(bsearch(xs, 4)) + " (not found)")
if bsearch(xs, 7) == 3 && bsearch(xs, 4) == -1 && bsearch(xs, 15) == 7 { println("OK") } else { println("FAIL") }
