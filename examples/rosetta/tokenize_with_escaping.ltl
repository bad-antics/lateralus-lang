// Rosetta Code · Tokenize a string with escaping · Lateralus
// https://rosettacode.org/wiki/Tokenize_a_string_with_escaping
//
// Split on a separator character, except where it is preceded by the
// escape character. The escape character escapes whatever follows it
// (including itself) and is removed from the output. Empty fields are kept.

fn tokenize(s: str, sep: str, esc: str) -> list {
    let tokens = []
    let cur = ""
    let escaping = false
    let i = 0
    while i < len(s) {
        let c = slice(s, i, i + 1)
        if escaping {
            cur = cur + c
            escaping = false
        } else if c == esc {
            escaping = true
        } else if c == sep {
            tokens = tokens + [cur]
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    return tokens + [cur]
}

fn main() {
    // The Rosetta task input and expected output.
    let input = "one^|uno||three^^^^|four^^^|^cuatro|"
    let tokens = tokenize(input, "|", "^")
    print("input:  " + input)
    let i = 0
    while i < len(tokens) {
        print("  [" + str(i) + "] \"" + tokens[i] + "\"")
        i = i + 1
    }
    assert_eq(tokens, ["one|uno", "", "three^^", "four^|cuatro", ""])

    // Edge cases: empty input is one empty field; leading and trailing
    // separators produce empty fields; an escaped escape is a literal.
    assert_eq(tokenize("", "|", "^"), [""])
    assert_eq(tokenize("|a|", "|", "^"), ["", "a", ""])
    assert_eq(tokenize("a^^|b", "|", "^"), ["a^", "b"])
    assert_eq(tokenize("x,y\\,z", ",", "\\"), ["x", "y,z"])
}

main()
