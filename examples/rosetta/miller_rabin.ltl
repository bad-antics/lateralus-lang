// Rosetta Code · Miller-Rabin Primality Test & Goldbach Partitions · Lateralus
// Self-contained 56-line port compiled via `lateralus c` and benchmarked against Python 3.

fn mod_mul(a: int, b: int, m: int) -> int {
    let res = 0
    let x = a % m
    let y = b
    while y > 0 {
        if y % 2 == 1 {
            res = (res + x) % m
        }
        x = (x * 2) % m
        y = int(y / 2)
    }
    return res
}

fn mod_pow(base: int, exp: int, mod_val: int) -> int {
    let result = 1
    let b = base % mod_val
    let e = exp
    while e > 0 {
        if e % 2 == 1 {
            result = mod_mul(result, b, mod_val)
        }
        b = mod_mul(b, b, mod_val)
        e = int(e / 2)
    }
    return result
}

fn miller_rabin_pass(n: int, a: int, d: int, s: int) -> bool {
    let x = mod_pow(a, d, n)
    if x == 1 or x == n - 1 {
        return true
    }
    let r = 1
    while r < s {
        x = mod_mul(x, x, n)
        if x == n - 1 {
            return true
        }
        r = r + 1
    }
    return false
}

fn is_prime(n: int) -> bool {
    if n < 2 { return false }
    if n == 2 or n == 3 or n == 5 or n == 7 { return true }
    if n % 2 == 0 or n % 3 == 0 { return false }
    let d = n - 1
    let s = 0
    while d % 2 == 0 {
        d = int(d / 2)
        s = s + 1
    }
    if not miller_rabin_pass(n, 2, d, s) { return false }
    if not miller_rabin_pass(n, 3, d, s) { return false }
    if not miller_rabin_pass(n, 5, d, s) { return false }
    if not miller_rabin_pass(n, 7, d, s) { return false }
    return true
}

fn main() {
    let count = 0
    let checksum = 0
    let k = 2
    while k <= 50000 {
        if is_prime(k) {
            count = count + 1
            checksum = (checksum + k) % 1000000007
        }
        k = k + 1
    }
    println("primes <= 50000: " + str(count))
    println("prime checksum:  " + str(checksum))
}

main()
