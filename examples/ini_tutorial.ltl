#!/usr/bin/env lateralus
import "ini"
fn test_basic() {
    let doc = ini.parse("[db]\nhost=localhost\nport=5432\nssl=true\n")
    assert(ini.get(doc, "db", "host") == "localhost")
    assert(ini.get_int(doc, "db", "port") == 5432)
    assert(ini.get_bool(doc, "db", "ssl") == true)
    print("Basic: PASSED")
}
fn test_typed() {
    let doc = ini.parse("[app]\ncount=42\nhex=0xFF\npi=3.14\nflag=yes\n")
    assert(ini.get_int(doc, "app", "count") == 42)
    assert(ini.get_int(doc, "app", "hex") == 255)
    assert(ini.get_float(doc, "app", "pi") == 3.14)
    assert(ini.get_bool(doc, "app", "flag") == true)
    assert(ini.get_int(doc, "app", "missing", 100) == 100)
    print("Typed getters: PASSED")
}
fn test_modification() {
    let doc = ini.parse("[db]\nhost=localhost\n")
    let doc2 = ini.set(doc, "db", "port", "5432")
    assert(ini.get(doc2, "db", "port") == "5432")
    assert(ini.get(doc, "db", "port") == None)  -- immutable
    let doc3 = ini.delete(doc2, "db", "port")
    assert(ini.get(doc3, "db", "port") == None)
    print("Modification: PASSED")
}
fn test_serialization() {
    let doc = ini.parse("[db]\nhost=localhost\nport=5432\n")
    let text = ini.to_string(doc)
    let doc2 = ini.parse(text)
    assert(ini.get(doc2, "db", "host") == "localhost")
    print("Serialization: PASSED")
}
fn test_merge() {
    let base = ini.parse("[c]\ndebug=false\n[db]\nhost=localhost\n")
    let override = ini.parse("[c]\ndebug=true\n[api]\nendpoint=api.com\n")
    let merged = ini.merge(base, override)
    assert(ini.get_bool(merged, "c", "debug") == true)
    assert(ini.get(merged, "db", "host") == "localhost")
    assert(ini.get(merged, "api", "endpoint") == "api.com")
    print("Merge: PASSED")
}
fn main() { test_basic(); test_typed(); test_modification(); test_serialization(); test_merge(); print("All ini tests PASSED") }