// Driver for the xxhash64 stdlib micro-benchmark.
// The harness inlines stdlib/xxhash.ltl above this driver to form a
// single combined source file (the interpreter's `import` resolves to a
// Python module, not a .ltl file, so modules are concatenated instead).
//
// Workload: XXH64 over 2 MB of byte data (full bounty spec size).

fn gen_byte(x: int) -> int { return (x * 31 + 7) & 0xff }

fn main() {
    let buf = map(range_ltl(0, 2000000), gen_byte)
    let h = hash64(buf, 0)
    println(h)
}

main()