#!/usr/bin/env lateralus
import qgram

fn main() {
    let grams = qgrams("cat", 2)
    let ov = overlap("night", "nacht", 2)
    let sim = jaccard("night", "nacht", 2)
    let idx = build_index(["lateralus", "lathe", "banana"], 3)
    let hits = query(idx, "late", 3)

    print("qgrams('cat', 2):", grams)
    print("overlap('night', 'nacht', 2):", ov)
    print("jaccard('night', 'nacht', 2):", sim)
    print("query('late', 3):", hits)
}
main()
