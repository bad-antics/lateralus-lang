// ===================================================================
// LATERALUS v1.5 — Standard Library Tutorial: stdlib.csv
// Parsing, Transforming, and Generating CSV Data
// ===================================================================

import csv
import io
import strings

// -- 1. Introduction & Synthetic Data --------------------------------
// The stdlib.csv module provides robust parsers and generators for comma-
// separated values, supporting custom delimiters, quoted fields, and header mapping.

fn sample_raw_csv() -> str {
    return "id,product,category,price,active\n" +
           "101,Widget Alpha,Hardware,24.99,true\n" +
           "102,Gizmo Beta,Electronics,49.50,false\n" +
           "103,\"Super Widget, Deluxe\",Hardware,99.00,true"
}

// -- 2. Parsing CSV Rows and Headers ---------------------------------

fn parse_and_inspect_csv() -> void {
    let raw = sample_raw_csv()
    let parsed_result = csv.parse(raw, {"has_header": true})
    
    println("=== Parsed CSV Headers ===")
    println(parsed_result["headers"])
    
    println("\n=== Parsed CSV Records ===")
    let rows = parsed_result["rows"]
    for row in rows {
        println("Product: " + row["product"] + " | Price: $" + row["price"])
    }
}

// -- 3. Generating CSV from Structured Records ------------------------

fn generate_csv_report() -> str {
    let headers = ["region", "total_sales", "status"]
    let records = [
        ["North", "12500.50", "certified"],
        ["South", "8900.00", "pending"],
        ["East", "15400.25", "certified"],
    ]

    let csv_output = csv.generate(headers, records, {"delimiter": ","})
    return csv_output
}

// -- 4. Main Execution & Pinned Test Fixture Vector ------------------

fn main() -> void {
    parse_and_inspect_csv()
    
    println("\n=== Generated CSV Output ===")
    let generated = generate_csv_report()
    println(generated)
    
    // Pinned expected-output assertion vector for test verification
    let expected_fixture = "region,total_sales,status\nNorth,12500.50,certified\nSouth,8900.00,pending\nEast,15400.25,certified\n"
    if generated == expected_fixture {
        println("[PASS] CSV generation matches pinned test fixture vector.")
    } else {
        println("[FAIL] CSV generation mismatch!")
    }
}

main()
