// Advent of Code 2024 · Day 10 · Hoof It
// Topographic map of heights 0-9. A hiking trail climbs one height at a
// time (up/down/left/right) from a trailhead (0) to a summit (9).
// Part 1: trailhead score = number of distinct summits reachable.
// Part 2: trailhead rating = number of distinct trails to summits.

let SAMPLE = "89010123
78121874
87430965
96549874
45678903
32019012
01329801
10456732"

fn rows_of(text: str) -> list {
    let rows = []
    let lines = str_split(text, "\n")
    let i = 0
    while i < len(lines) {
        if len(str_trim(lines[i])) > 0 {
            rows = rows + [lines[i]]
        }
        i = i + 1
    }
    return rows
}

fn height(rows: list, r: int, c: int) -> int {
    return int(slice(rows[r], c, c + 1))
}

fn in_bounds(rows: list, r: int, c: int) -> bool {
    if r < 0 { return false }
    if c < 0 { return false }
    if r >= len(rows) { return false }
    if c >= len(rows[0]) { return false }
    return true
}

// Reachable summits from (r, c) as a list of "r,c" keys (may repeat).
// A summit returns its own key; otherwise combine the neighbours'
// lists and deduplicate.
fn summits(rows: list, r: int, c: int) -> list {
    let h = height(rows, r, c)
    if h == 9 {
        return [str(r) + "," + str(c)]
    }
    let found = []
    let dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]]
    let d = 0
    while d < len(dirs) {
        let nr = r + dirs[d][0]
        let nc = c + dirs[d][1]
        if in_bounds(rows, nr, nc) && height(rows, nr, nc) == h + 1 {
            let sub = summits(rows, nr, nc)
            let k = 0
            while k < len(sub) {
                if contains(found, sub[k]) == false {
                    found = found + [sub[k]]
                }
                k = k + 1
            }
        }
        d = d + 1
    }
    return found
}

// Number of distinct trails from (r, c) to any summit.
fn trails(rows: list, r: int, c: int) -> int {
    let h = height(rows, r, c)
    if h == 9 {
        return 1
    }
    let total = 0
    let dirs = [[-1, 0], [1, 0], [0, -1], [0, 1]]
    let d = 0
    while d < len(dirs) {
        let nr = r + dirs[d][0]
        let nc = c + dirs[d][1]
        if in_bounds(rows, nr, nc) && height(rows, nr, nc) == h + 1 {
            total = total + trails(rows, nr, nc)
        }
        d = d + 1
    }
    return total
}

fn part1(text: str) -> int {
    let rows = rows_of(text)
    let total = 0
    let r = 0
    while r < len(rows) {
        let c = 0
        while c < len(rows[r]) {
            if height(rows, r, c) == 0 {
                total = total + len(summits(rows, r, c))
            }
            c = c + 1
        }
        r = r + 1
    }
    return total
}

fn part2(text: str) -> int {
    let rows = rows_of(text)
    let total = 0
    let r = 0
    while r < len(rows) {
        let c = 0
        while c < len(rows[r]) {
            if height(rows, r, c) == 0 {
                total = total + trails(rows, r, c)
            }
            c = c + 1
        }
        r = r + 1
    }
    return total
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 36)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 81)
}

fn main() {
    print("Day 10 Part 1: " + str(part1(SAMPLE)))
    print("Day 10 Part 2: " + str(part2(SAMPLE)))
}

main()
