// ===================================================================
// examples/prim_mst_tutorial.ltl
// -------------------------------------------------------------------
// Practical example demonstrating Prim-Jarník Minimum Spanning Tree (MST)
// algorithm for designing a dense, loop-free municipal electrical power
// transmission grid.
// ===================================================================

fn init_matrix(n, default_val) {
    let m = dict()
    let i = 0
    while i < n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = default_val
            j = j + 1
        }
        m[i] = row
        i = i + 1
    }
    return m
}

fn add_undirected_edge(matrix, u, v, w) {
    matrix[u][v] = w
    matrix[v][u] = w
}

pub fn prim_mst(n, matrix) {
    let in_mst = dict()
    let key = dict()
    let parent = dict()

    let i = 0
    while i < n {
        in_mst[i] = false
        key[i] = 999999999
        parent[i] = -1
        i = i + 1
    }

    key[0] = 0

    let count = 0
    let step = 0
    while step < n {
        let min_val = 999999999
        let u = -1
        let v_idx = 0
        while v_idx < n {
            if not in_mst[v_idx] and key[v_idx] < min_val {
                min_val = key[v_idx]
                u = v_idx
            }
            v_idx = v_idx + 1
        }

        if u == -1 {
            step = n
        } else {
            in_mst[u] = true
            count = count + 1

            let v = 0
            while v < n {
                let weight = matrix[u][v]
                if weight > 0 and not in_mst[v] and weight < key[v] {
                    key[v] = weight
                    parent[v] = u
                }
                v = v + 1
            }
            step = step + 1
        }
    }

    let total_weight = 0
    let mst_edges = []
    let is_connected = (count == n)

    if is_connected {
        let idx = 1
        while idx < n {
            total_weight = total_weight + key[idx]
            let edge = dict()
            edge["u"] = parent[idx]
            edge["v"] = idx
            edge["w"] = key[idx]
            mst_edges = push(mst_edges, edge)
            idx = idx + 1
        }
    }

    let res = dict()
    res["total_weight"] = total_weight
    res["edges"] = mst_edges
    res["is_connected"] = is_connected
    return res
}

pub fn main() {
    print("=== Prim's Minimum Spanning Tree (MST) Optimization ===")
    print("Designing optimal electrical power grid transmission cabling...")

    // 6 Substation Nodes:
    // 0: Central Renewable Power Plant
    // 1: Industrial Park
    // 2: Data Center Hub
    // 3: Residential North
    // 4: Hospital Medical Complex
    // 5: Municipal Rail Transit

    let n = 6
    let grid_matrix = init_matrix(n, 0)

    // Dense grid interconnection candidates (cabling distance in km)
    add_undirected_edge(grid_matrix, 0, 1, 4)
    add_undirected_edge(grid_matrix, 0, 2, 4)
    add_undirected_edge(grid_matrix, 1, 2, 2)
    add_undirected_edge(grid_matrix, 1, 3, 3)
    add_undirected_edge(grid_matrix, 2, 3, 4)
    add_undirected_edge(grid_matrix, 2, 4, 2)
    add_undirected_edge(grid_matrix, 3, 4, 3)
    add_undirected_edge(grid_matrix, 3, 5, 2)
    add_undirected_edge(grid_matrix, 4, 5, 3)

    let result = prim_mst(n, grid_matrix)

    print("Power Grid Fully Connected:")
    print(result["is_connected"])

    print("Total Optimized Cabling Distance (km):")
    print(result["total_weight"])

    print("Active Transmission Lines Count:")
    print(len(result["edges"]))

    let i = 0
    while i < len(result["edges"]) {
        let line = result["edges"][i]
        print("Constructed High-Voltage Line:")
        print(line)
        i = i + 1
    }
}
