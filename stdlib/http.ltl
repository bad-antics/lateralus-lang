// stdlib/http.ltl: HTTP client helpers and URL parsing

import "stdlib/json"

// ---------------------------------------------------------------------------
// Internal string helpers (index-based, first/last occurrence aware)
// ---------------------------------------------------------------------------

// Returns the index of the first occurrence of `needle` in `s`, or -1.
fn _http_find(s, needle) {
    let n = len(s)
    let m = len(needle)
    if m == 0 { return 0 }
    let i = 0
    while i + m <= n {
        if str_slice(s, i, i + m) == needle { return i }
        i = i + 1
    }
    return -1
}

// Returns the index of the last occurrence of `needle` in `s`, or -1.
fn _http_find_last(s, needle) {
    let n = len(s)
    let m = len(needle)
    if m == 0 { return n }
    let i = n - m
    while i >= 0 {
        if str_slice(s, i, i + m) == needle { return i }
        i = i - 1
    }
    return -1
}

// True if `s` is non-empty and consists solely of ASCII digits.
fn _http_is_digits(s) {
    let n = len(s)
    if n == 0 { return false }
    let i = 0
    while i < n {
        let c = str_slice(s, i, i + 1)
        if c < "0" || c > "9" { return false }
        i = i + 1
    }
    return true
}

fn _http_default_port(scheme) {
    if scheme == "https" { return 443 }
    if scheme == "http" { return 80 }
    if scheme == "wss" { return 443 }
    if scheme == "ws" { return 80 }
    return 0
}

// ---------------------------------------------------------------------------
// JSON helpers
// ---------------------------------------------------------------------------

fn get_json(url) {
    let resp = http_get(url)
    return json_parse(resp)
}

fn post_json(url, data) {
    // json_stringify is the canonical encoder (json_encode does not exist).
    let body = json_stringify(data)
    return http_post(url, body, {"Content-Type": "application/json"})
}

// ---------------------------------------------------------------------------
// URL parsing
// ---------------------------------------------------------------------------

// Parses a URL into a record:
//   { scheme, userinfo, host, port, path, query, fragment }
// Splits only on the first '#', first '?' and first '://'; handles IPv6
// literals and userinfo; never raises on malformed ports.
fn parse_url(url) {
    let s = url
    let fragment = ""
    let query = ""
    let scheme = ""
    let userinfo = ""
    let host = ""
    let port = 0
    let path = "/"

    // 1. Fragment: split at the FIRST '#'.
    let hi = _http_find(s, "#")
    if hi >= 0 {
        fragment = str_slice(s, hi + 1, len(s))
        s = str_slice(s, 0, hi)
    }

    // 2. Query: split at the FIRST '?'.
    let qi = _http_find(s, "?")
    if qi >= 0 {
        query = str_slice(s, qi + 1, len(s))
        s = str_slice(s, 0, qi)
    }

    // 3. Scheme: split at the FIRST "://".
    let rest = s
    let si = _http_find(s, "://")
    if si >= 0 {
        scheme = str_slice(s, 0, si)
        rest = str_slice(s, si + 3, len(s))
    }

    // 4. Authority vs path: split at the FIRST '/'.
    let authority = rest
    let pi = _http_find(rest, "/")
    if pi >= 0 {
        authority = str_slice(rest, 0, pi)
        path = str_slice(rest, pi, len(rest))
    }

    // 5. Userinfo: everything before the LAST '@' in the authority.
    let ai = _http_find_last(authority, "@")
    if ai >= 0 {
        userinfo = str_slice(authority, 0, ai)
        authority = str_slice(authority, ai + 1, len(authority))
    }

    // 6. Host and port.
    let port_str = ""
    if len(authority) > 0 && str_slice(authority, 0, 1) == "[" {
        // Bracketed IPv6 literal: [addr] or [addr]:port
        let close = _http_find(authority, "]")
        if close >= 0 {
            host = str_slice(authority, 0, close + 1)
            let after = str_slice(authority, close + 1, len(authority))
            if len(after) > 0 && str_slice(after, 0, 1) == ":" {
                port_str = str_slice(after, 1, len(after))
            }
        } else {
            // Unterminated bracket: treat the whole thing as the host.
            host = authority
        }
    } else {
        let ci = _http_find_last(authority, ":")
        if ci >= 0 {
            host = str_slice(authority, 0, ci)
            port_str = str_slice(authority, ci + 1, len(authority))
        } else {
            host = authority
        }
    }

    // 7. Port: only accept purely numeric ports; otherwise use scheme default.
    if _http_is_digits(port_str) {
        port = to_int(port_str)
    } else {
        port = _http_default_port(scheme)
    }

    return {
        "scheme": scheme,
        "userinfo": userinfo,
        "host": host,
        "port": port,
        "path": path,
        "query": query,
        "fragment": fragment
    }
}