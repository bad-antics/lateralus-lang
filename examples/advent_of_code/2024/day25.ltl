// Advent of Code 2024 · Day 25 · Code Chronicle
// Part 1: convert lock and key schematics to column heights; count lock/key
// pairs whose heights never overlap in any column. (Day 25 has no part 2.)

let SAMPLE = "#####
.####
.####
.####
.#.#.
.#...
.....

#####
##.##
.#.##
...##
...#.
...#.
.....

.....
#....
#....
#...#
#.#.#
#.###
#####

.....
.....
#.#..
###..
###.#
###.#
#####

.....
.....
.....
#....
#.#..
#.#.#
#####"

// Returns [locks, keys], each a list of 5 column heights. A schematic whose
// top row is filled is a lock; otherwise it is a key. Heights exclude the
// solid base row, so they range 0..5.
fn parse(text: str) -> list {
    let locks = []
    let key_list = []
    let blocks = str_split(str_trim(str_replace(text, "\r", "")), "\n\n")
    for block in blocks {
        let rows = str_split(str_trim(block), "\n")
        let heights = [-1, -1, -1, -1, -1]
        for row in rows {
            for c in range(0, 5) {
                if row[c] == "#" { heights[c] = heights[c] + 1 }
            }
        }
        if rows[0] == "#####" { locks.append(heights) } else { key_list.append(heights) }
    }
    return [locks, key_list]
}

fn fits(lock: list, key: list) -> bool {
    for c in range(0, 5) {
        if lock[c] + key[c] > 5 { return false }
    }
    return true
}

fn part1(text: str) -> int {
    let p = parse(text)
    let count = 0
    for lock in p[0] {
        for key in p[1] {
            if fits(lock, key) { count = count + 1 }
        }
    }
    return count
}

@test
fn test_heights() {
    let p = parse(SAMPLE)
    assert_eq(p[0][0], [0, 5, 3, 4, 3])
    assert_eq(p[1][0], [5, 0, 2, 1, 3])
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 3)
}

fn main() {
    print("Day 25 Part 1: " + str(part1(SAMPLE)))
    print("Day 25 Part 2: none — the last star comes from finishing the other 49")
}

main()
