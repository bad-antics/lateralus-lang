// ===================================================================
// tests/stdlib_kdtree_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for K-Dimensional Tree (KD-Tree), alternating
// hyperplane spatial partitioning, and O(log n) Nearest Neighbor Search.
// ===================================================================

pub fn new_kdtree() {
    let tree = dict()
    tree["root"] = -1
    tree["nodes"] = dict()
    tree["count"] = 0
    return tree
}

pub fn dist_sq(x1, y1, x2, y2) {
    let dx = x1 - x2
    let dy = y1 - y2
    return dx * dx + dy * dy
}

pub fn insert_kd_node(tree, curr_id, new_id, depth) {
    if curr_id == -1 {
        return new_id
    }

    let curr = tree["nodes"][curr_id]
    let new_node = tree["nodes"][new_id]
    let axis = depth % 2

    if axis == 0 {
        if new_node["x"] < curr["x"] {
            curr["left"] = insert_kd_node(tree, curr["left"], new_id, depth + 1)
        } else {
            curr["right"] = insert_kd_node(tree, curr["right"], new_id, depth + 1)
        }
    } else {
        if new_node["y"] < curr["y"] {
            curr["left"] = insert_kd_node(tree, curr["left"], new_id, depth + 1)
        } else {
            curr["right"] = insert_kd_node(tree, curr["right"], new_id, depth + 1)
        }
    }

    return curr_id
}

pub fn insert_point(tree, x, y) {
    let id = tree["count"]
    let node = dict()
    node["id"] = id
    node["x"] = x
    node["y"] = y
    node["left"] = -1
    node["right"] = -1

    tree["nodes"][id] = node
    tree["count"] = id + 1

    tree["root"] = insert_kd_node(tree, tree["root"], id, 0)
    return id
}

pub fn search_nn_recursive(tree, curr_id, qx, qy, depth, best) {
    if curr_id == -1 {
        return 0
    }

    let curr = tree["nodes"][curr_id]
    let d = dist_sq(curr["x"], curr["y"], qx, qy)

    if d < best["dist"] {
        best["dist"] = d
        best["best_id"] = curr_id
        best["best_x"] = curr["x"]
        best["best_y"] = curr["y"]
    }

    let axis = depth % 2
    let diff = 0
    let first_branch = -1
    let second_branch = -1

    if axis == 0 {
        diff = qx - curr["x"]
        if diff < 0 {
            first_branch = curr["left"]
            second_branch = curr["right"]
        } else {
            first_branch = curr["right"]
            second_branch = curr["left"]
        }
    } else {
        diff = qy - curr["y"]
        if diff < 0 {
            first_branch = curr["left"]
            second_branch = curr["right"]
        } else {
            first_branch = curr["right"]
            second_branch = curr["left"]
        }
    }

    // 1. Traverse primary branch closest to query point
    search_nn_recursive(tree, first_branch, qx, qy, depth + 1, best)

    // 2. Pruning invariant: only search other branch if hyper-plane distance squared < best distance
    if diff * diff < best["dist"] {
        search_nn_recursive(tree, second_branch, qx, qy, depth + 1, best)
    }

    return 0
}

pub fn find_nearest_neighbor(tree, qx, qy) {
    let best = dict()
    best["dist"] = 2000000000
    best["best_id"] = -1
    best["best_x"] = 0
    best["best_y"] = 0

    search_nn_recursive(tree, tree["root"], qx, qy, 0, best)
    return best
}

// -------------------------------------------------------------------
// Verification Tests
// -------------------------------------------------------------------

pub fn test_classic_six_points() {
    // Standard 2D dataset:
    // (2, 3), (5, 4), (9, 6), (4, 7), (8, 1), (7, 2)
    let tree = new_kdtree()
    insert_point(tree, 2, 3)
    insert_point(tree, 5, 4)
    insert_point(tree, 9, 6)
    insert_point(tree, 4, 7)
    insert_point(tree, 8, 1)
    insert_point(tree, 7, 2)

    // Query 1: Exactly coincident with point (5, 4)
    let nn1 = find_nearest_neighbor(tree, 5, 4)
    assert(nn1["dist"] == 0, "Distance to self is 0")
    assert(nn1["best_x"] == 5 && nn1["best_y"] == 4, "Matches (5, 4)")

    // Query 2: Point (8, 2) -> Nearest is (7, 2) (dist^2 = 1) or (8, 1) (dist^2 = 1)
    let nn2 = find_nearest_neighbor(tree, 8, 2)
    assert(nn2["dist"] == 1, "Distance to closest point is 1")
    assert((nn2["best_x"] == 8 && nn2["best_y"] == 1) || (nn2["best_x"] == 7 && nn2["best_y"] == 2), "Closest is either (8, 1) or (7, 2)")

    // Query 3: Point (3, 4) -> Closest to (2, 3) (dist^2 = 1+1=2) or (5, 4) (dist^2 = 4)
    let nn3 = find_nearest_neighbor(tree, 3, 4)
    assert(nn3["dist"] == 2, "Distance squared is 2")
    assert(nn3["best_x"] == 2 && nn3["best_y"] == 3, "Closest point is (2, 3)")
}

pub fn test_quadrant_extremes() {
    let tree = new_kdtree()
    insert_point(tree, 100, 100)
    insert_point(tree, -100, 100)
    insert_point(tree, -100, -100)
    insert_point(tree, 100, -100)

    // Query in bottom-left quadrant (-90, -95)
    let nn = find_nearest_neighbor(tree, -90, -95)
    assert(nn["best_x"] == -100 && nn["best_y"] == -100, "Closest to quadrant 3 corner")
    assert(nn["dist"] == 100 + 25, "10^2 + 5^2 = 125")
}

pub fn test_single_point() {
    let tree = new_kdtree()
    insert_point(tree, 42, 84)
    let nn = find_nearest_neighbor(tree, 0, 0)
    assert(nn["best_x"] == 42 && nn["best_y"] == 84, "Sole point is nearest")
    assert(nn["dist"] == 42 * 42 + 84 * 84, "Exact euclidean squared distance")
}

pub fn main() {
    test_classic_six_points()
    test_quadrant_extremes()
    test_single_point()
    print("All KD-Tree verification tests passed successfully!")
}
