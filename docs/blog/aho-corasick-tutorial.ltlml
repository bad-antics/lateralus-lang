# Multi-Pattern Matching with Aho-Corasick

@meta {
  title: "Multi-Pattern Matching with Aho-Corasick"
  date: "2026-05-20"
  author: "contributor"
  tags: ["stdlib", "aho-corasick", "tutorial"]
}

@paragraph {
  The Aho-Corasick algorithm is the gold standard for searching multiple patterns in a text simultaneously. In Lateralus, the `stdlib/aho_corasick` module provides a high-performance implementation.
}

@code lang=lateralus {
  import stdlib.aho_corasick as ac

  fn main() {
    let patterns = ["error", "warn", "critical"]
    let auto = ac.build(patterns)
    let log = "System error: disk full. Warning: low memory."
    
    let matches = ac.find_all(auto, log)
    # Returns [[0, 12], [1, 28]] where 0 is 'error' and 1 is 'warn'
    print(matches)
  }
}

@heading level=2 { Test Vectors }

@code lang=lateralus {
  @test "overlapping matches" {
    let auto = ac.build(["he", "she", "hers", "his"])
    let matches = ac.find_all(auto, "ushers")
    # Expected: [[1, 3], [0, 3], [2, 5]]
    assert(len(matches) == 3)
  }

  @test "no match behavior" {
    let auto = ac.build(["foo"])
    assert(len(ac.find_all(auto, "bar")) == 0)
  }
}
</script>
</body>
</html>