// Driver for the chacha20 stdlib micro-benchmark.
// The harness inlines stdlib/chacha20.ltl above this driver.
//
// Workload: ChaCha20 encrypt 1 MB (bounty spec). The interpreter has a
// hard 60 s per-script execution limit (compiler.py), and 1 MB exceeds
// it; 150 KB completes in ~41 s. Python/Node references use the same
// 150 KB input. See benchmarks/results/stdlib_results.md.

fn gen_byte(x: int) -> int { return (x * 31 + 7) & 0xff }

fn main() {
    let key = map(range_ltl(0, 32), gen_byte)
    let nonce = map(range_ltl(0, 12), gen_byte)
    let data = map(range_ltl(0, 150000), gen_byte)
    let ct = xor(key, nonce, 0, data)
    println(len(ct))
    println(ct[12345])
}

main()