// ===================================================================
// tests/stdlib_counting_sort_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for Counting Sort, linear time O(n + k) integer
// distribution, stability invariants, and negative range handling.
// ===================================================================

pub fn counting_sort(arr, n) {
    if n <= 1 {
        return arr
    }

    // 1. Find min and max elements
    let min_val = arr[0]
    let max_val = arr[0]
    let i = 1
    while i < n {
        if arr[i] < min_val {
            min_val = arr[i]
        }
        if arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }

    let range_len = max_val - min_val + 1

    // 2. Initialize frequency histogram
    let count = dict()
    let c = 0
    while c < range_len {
        count[c] = 0
        c = c + 1
    }

    // 3. Populate frequency histogram
    i = 0
    while i < n {
        let offset = arr[i] - min_val
        count[offset] = count[offset] + 1
        i = i + 1
    }

    // 4. Compute cumulative prefix sums
    c = 1
    while c < range_len {
        count[c] = count[c] + count[c - 1]
        c = c + 1
    }

    // 5. Build output array in backward order for stability
    let output = dict()
    i = n - 1
    while i >= 0 {
        let val = arr[i]
        let offset = val - min_val
        let target_idx = count[offset] - 1
        output[target_idx] = val
        count[offset] = count[offset] - 1
        i = i - 1
    }

    return output
}

// -------------------------------------------------------------------
// Verification Tests
// -------------------------------------------------------------------

pub fn test_basic_positive_integers() {
    let arr = dict()
    arr[0] = 4; arr[1] = 2; arr[2] = 2; arr[3] = 8; arr[4] = 3; arr[5] = 3; arr[6] = 1
    let sorted = counting_sort(arr, 7)

    assert(sorted[0] == 1, "Sorted[0] == 1")
    assert(sorted[1] == 2, "Sorted[1] == 2")
    assert(sorted[2] == 2, "Sorted[2] == 2")
    assert(sorted[3] == 3, "Sorted[3] == 3")
    assert(sorted[4] == 3, "Sorted[4] == 3")
    assert(sorted[5] == 4, "Sorted[5] == 4")
    assert(sorted[6] == 8, "Sorted[6] == 8")
}

pub fn test_negative_and_zero_values() {
    let arr = dict()
    arr[0] = -5; arr[1] = -10; arr[2] = 0; arr[3] = -3; arr[4] = 8; arr[5] = 5; arr[6] = -1
    let sorted = counting_sort(arr, 7)

    assert(sorted[0] == -10, "Min element -10")
    assert(sorted[1] == -5, "Element -5")
    assert(sorted[2] == -3, "Element -3")
    assert(sorted[3] == -1, "Element -1")
    assert(sorted[4] == 0, "Element 0")
    assert(sorted[5] == 5, "Element 5")
    assert(sorted[6] == 8, "Max element 8")
}

pub fn test_already_sorted_and_reversed() {
    let arr1 = dict()
    arr1[0] = 10; arr1[1] = 20; arr1[2] = 30
    let s1 = counting_sort(arr1, 3)
    assert(s1[0] == 10 && s1[1] == 20 && s1[2] == 30, "Already sorted")

    let arr2 = dict()
    arr2[0] = 9; arr2[1] = 7; arr2[2] = 5; arr2[3] = 3; arr2[4] = 1
    let s2 = counting_sort(arr2, 5)
    assert(s2[0] == 1 && s2[1] == 3 && s2[2] == 5 && s2[3] == 7 && s2[4] == 9, "Reversed to sorted")
}

pub fn test_uniform_elements() {
    let arr = dict()
    arr[0] = 42; arr[1] = 42; arr[2] = 42; arr[3] = 42
    let s = counting_sort(arr, 4)
    assert(s[0] == 42 && s[1] == 42 && s[2] == 42 && s[3] == 42, "Uniform array retains elements")
}

pub fn main() {
    test_basic_positive_integers()
    test_negative_and_zero_values()
    test_already_sorted_and_reversed()
    test_uniform_elements()
    print("All Counting Sort verification tests passed successfully!")
}
