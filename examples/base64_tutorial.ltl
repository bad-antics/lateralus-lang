// ===================================================================
// examples/base64_tutorial.ltl
//
// Tutorial: RFC 4648 Base64 Encoding & URL-safe Variants with
// Lateralus `stdlib/base64.ltl`.
//
// Demonstrates:
// 1. Text & binary data encoding/decoding.
// 2. Generating HTTP Basic Authentication headers.
// 3. URL-safe encoding for web tokens and query parameters.
// 4. Memory buffer sizing and structural validation.
// ===================================================================

import base64

pub fn main() {
    print("=== Lateralus Base64 (RFC 4648) Tutorial ===")

    // 1. Basic encoding and decoding
    let raw_message = "Lateralus-Polyglot-Runtime-2026"
    let encoded = base64_encode(raw_message)
    let decoded = base64_decode(encoded)

    print("Original text:  " + raw_message)
    print("Base64 encoded: " + encoded)
    print("Decoded text:   " + decoded)

    if decoded == raw_message {
        print("PASS: Decoded string exactly restores original payload")
    }

    // 2. HTTP Basic Authentication header construction
    let username = "admin"
    let password = "SecretPassword123!"
    let auth_payload = username + ":" + password
    let auth_token = base64_encode(auth_payload)
    let http_header = "Authorization: Basic " + auth_token

    print("Constructed HTTP Header: " + http_header)

    // 3. URL-safe encoding (replaces '+' with '-' and '/' with '_')
    // Crucial for JWTs and URL query parameters without percent-encoding
    let sensitive_url_token = base64_encode_url("oauth:client_id=1234&session=active")
    print("URL-Safe Token: " + sensitive_url_token)

    let restored_token = base64_decode_url(sensitive_url_token)
    if restored_token == "oauth:client_id=1234&session=active" {
        print("PASS: URL-safe variant decodes cleanly")
    }

    // 4. Validation & Buffer length estimation
    let test_string = "Zm9vYmFy"
    if base64_is_valid(test_string) {
        let expected_bytes = base64_decoded_length(test_string)
        print("PASS: '" + test_string + "' is valid base64 (decodes to " + str(expected_bytes) + " bytes)")
    }

    print("=== Base64 tutorial demonstration completed successfully ===")
}
