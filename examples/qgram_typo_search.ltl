// Run with stdlib/qgram.ltl as shown in docs/blog/qgram-typo-search.ltlml.
fn suggestions(typed: str, words: list, cutoff: float) -> list {
    let hits = []
    for word in words {
        if jaccard(typed, word, 2) >= cutoff {
            hits = hits + [word]
        }
    }
    return hits
}

let catalogue = ["plane", "brick", "planet", "plum"]

@test
fn test_missing_letter() {
    let edge = chr(1)
    assert_eq(qgrams("plnet", 2), [edge + "p", "pl", "ln", "ne", "et", "t" + edge])
    assert_eq(jaccard("plnet", "planet", 2), 0.625)
    assert_eq(suggestions("plnet", catalogue, 0.5), ["planet"])
    assert_eq(suggestions("plnet", catalogue, 0.75), [])
}

test_missing_letter()
for hit in suggestions("plnet", catalogue, 0.5) {
    print(hit)
}
