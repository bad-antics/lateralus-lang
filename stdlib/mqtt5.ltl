--- stdlib/mqtt5.ltl
--- MQTT v5.0 protocol support library

module mqtt5

--- Packet Types
let PKT_CONNECT     = 1
let PKT_CONNACK     = 2
let PKT_PUBLISH     = 3
let PKT_PUBACK      = 4
let PKT_PUBREC      = 5
let PKT_PUBREL      = 6
let PKT_PUBCOMP     = 7
let PKT_SUBSCRIBE   = 8
let PKT_SUBACK      = 9
let PKT_UNSUBSCRIBE = 10
let PKT_UNSUBACK    = 11
let PKT_PINGREQ     = 12
let PKT_PINGRESP    = 13
let PKT_DISCONNECT  = 14
let PKT_AUTH        = 15

--- Record definition for an MQTT 5.0 packet
record Packet {
    packet_type: int,
    flags: int,
    remaining_length: int,
    properties: map,
    payload: []int
}

--- Decode an MQTT variable byte integer (MQTT 5.0 §1.5.5)
--- Returns (value, next_index) or nil if truncated or overlong (>4 bytes).
fn dec_varint(buf: []int, i: int) -> any {
    let mut val = 0
    let mut shift = 0
    let mut idx = i
    let mut count = 0

    while idx < len(buf) {
        if count >= 4 {
            return nil
        }
        let b = buf[idx]
        idx = idx + 1
        count = count + 1
        val = val + ((b & 127) << shift)
        if (b & 128) == 0 {
            return [val, idx]
        }
        shift = shift + 7
    }
    return nil
}

--- Encode an integer into an MQTT variable byte integer
fn enc_varint(val: int) -> []int {
    let mut out = []
    let mut x = val
    if x == 0 {
        return [0]
    }
    while x > 0 {
        let mut encoded = x % 128
        x = x / 128
        if x > 0 {
            encoded = encoded | 128
        }
        out = push(out, encoded)
    }
    return out
}

--- Decode a UTF-8 string from a buffer with a 2-byte length prefix
fn dec_utf8(buf: []int, i: int) -> any {
    if i + 2 > len(buf) {
        return nil
    }
    let length = (buf[i] << 8) + buf[i + 1]
    let start = i + 2
    let end = start + length
    if end > len(buf) {
        return nil
    }
    
    let mut s = ""
    let mut k = 0
    while k < length {
        let b1 = buf[start + k]
        if b1 < 128 {
            s = s + chr(b1)
            k = k + 1
        } else if (b1 & 224) == 192 {
            if k + 1 >= length {
                return nil
            }
            let b2 = buf[start + k + 1]
            let code = ((b1 & 31) << 6) | (b2 & 63)
            s = s + chr(code)
            k = k + 2
        } else if (b1 & 240) == 224 {
            if k + 2 >= length {
                return nil
            }
            let b2 = buf[start + k + 1]
            let b3 = buf[start + k + 2]
            let code = ((b1 & 15) << 12) | ((b2 & 63) << 6) | (b3 & 63)
            s = s + chr(code)
            k = k + 3
        } else if (b1 & 248) == 240 {
            if k + 3 >= length {
                return nil
            }
            let b2 = buf[start + k + 1]
            let b3 = buf[start + k + 2]
            let b4 = buf[start + k + 3]
            let code = ((b1 & 7) << 18) | ((b2 & 63) << 12) | ((b3 & 63) << 6) | (b4 & 63)
            s = s + chr(code)
            k = k + 4
        } else {
            return nil
        }
    }
    return [s, end]
}

--- Encode a UTF-8 string with a 2-byte length prefix
fn enc_utf8(s: string) -> []int {
    let mut bytes = []
    let mut i = 0
    while i < len(s) {
        let code = ord(s[i])
        bytes = push(bytes, code)
        i = i + 1
    }
    let length = len(bytes)
    let msb = length / 256
    let lsb = length % 256
    return concat([msb, lsb], bytes)
}

--- Decode MQTT 5.0 properties
fn dec_properties(buf: []int, i: int) -> any {
    let prop_res = dec_varint(buf, i)
    if prop_res == nil {
        return nil
    }
    let prop_len = prop_res[0]
    let mut idx = prop_res[1]
    let end_idx = idx + prop_len
    if end_idx > len(buf) {
        return nil
    }

    let mut props = {}
    while idx < end_idx {
        if idx >= len(buf) {
            return nil
        }
        let prop_id = buf[idx]
        idx = idx + 1

        if prop_id == 31 { -- Reason String
            let str_res = dec_utf8(buf, idx)
            if str_res == nil {
                return nil
            }
            props["reason_string"] = str_res[0]
            idx = str_res[1]
        } else if prop_id == 38 { -- User Property
            let k_res = dec_utf8(buf, idx)
            if k_res == nil {
                return nil
            }
            idx = k_res[1]
            let v_res = dec_utf8(buf, idx)
            if v_res == nil {
                return nil
            }
            idx = v_res[1]
            if not has_key(props, "user_properties") {
                props["user_properties"] = {}
            }
            props["user_properties"][k_res[0]] = v_res[0]
        } else if prop_id == 17 { -- Session Expiry Interval
            if idx + 4 > len(buf) {
                return nil
            }
            let val = (buf[idx] << 24) + (buf[idx+1] << 16) + (buf[idx+2] << 8) + buf[idx+3]
            props["session_expiry_interval"] = val
            idx = idx + 4
        } else {
            -- Unknown or unsupported property in stub, skip or fail
            return nil
        }
    }

    return [props, end_idx]
}

--- Parse an MQTT 5.0 packet from a byte buffer
fn parse_packet(buf: []int, i: int) -> any {
    if i >= len(buf) {
        return nil
    }
    let byte1 = buf[i]
    let packet_type = (byte1 >> 4) & 15
    let flags = byte1 & 15

    let varint_res = dec_varint(buf, i + 1)
    if varint_res == nil {
        return nil
    }
    let remaining_length = varint_res[0]
    let mut payload_start = varint_res[1]
    let packet_end = payload_start + remaining_length
    if packet_end > len(buf) {
        return nil
    }

    let mut properties = {}
    if packet_type == PKT_CONNECT or packet_type == PKT_CONNACK or packet_type == PKT_PUBLISH {
        let prop_res = dec_properties(buf, payload_start)
        if prop_res == nil {
            return nil
        }
        properties = prop_res[0]
        payload_start = prop_res[1]
    }

    let mut payload = []
    let mut k = payload_start
    while k < packet_end {
        payload = push(payload, buf[k])
        k = k + 1
    }

    return Packet {
        packet_type: packet_type,
        flags: flags,
        remaining_length: remaining_length,
        properties: properties,
        payload: payload
    }
}