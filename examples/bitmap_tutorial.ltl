// Lateralus Standard Library Example: Dense Bitmap & BitSet Operations
// Demonstrates compact boolean arrays, bitwise manipulation, Hamming weight (popcount), and set union/intersection.

fn bitmap_create(capacity: int) -> list {
    let mut words = [];
    let mut num_words = capacity / 32;
    if capacity % 32 != 0 {
        num_words = num_words + 1;
    }
    let mut i = 0;
    while i < num_words {
        words = words + [0];
        i = i + 1;
    }
    return words;
}

fn bitmap_set(words: list, bit_idx: int) -> list {
    let mut res = words;
    let w_idx = bit_idx / 32;
    let b_pos = bit_idx % 32;
    let mask = 1 << b_pos;
    res[w_idx] = res[w_idx] | mask;
    return res;
}

fn bitmap_test(words: list, bit_idx: int) -> bool {
    let w_idx = bit_idx / 32;
    let b_pos = bit_idx % 32;
    let mask = 1 << b_pos;
    return (words[w_idx] & mask) != 0;
}

fn bitmap_clear(words: list, bit_idx: int) -> list {
    let mut res = words;
    let w_idx = bit_idx / 32;
    let b_pos = bit_idx % 32;
    let mask = 1 << b_pos;
    if (res[w_idx] & mask) != 0 {
        res[w_idx] = res[w_idx] ^ mask;
    }
    return res;
}

fn word_popcount(w: int) -> int {
    let mut count = 0;
    let mut val = w;
    while val > 0 {
        count = count + (val & 1);
        val = val >> 1;
    }
    return count;
}

fn bitmap_popcount(words: list) -> int {
    let mut total = 0;
    let mut i = 0;
    while i < len(words) {
        total = total + word_popcount(words[i]);
        i = i + 1;
    }
    return total;
}

fn main() -> int {
    println("=== Lateralus Dense Bitmap & BitSet Engine Demo ===");

    // Allocate a 64-bit BitSet (represented in 2 x 32-bit integer words)
    let mut bitset = bitmap_create(64);
    println("Initialized 64-bit BitSet (Words allocated: " + str(len(bitset)) + ")");

    // Set various feature flags / IDs
    bitset = bitmap_set(bitset, 7);   // Flag 7
    bitset = bitmap_set(bitset, 19);  // Flag 19
    bitset = bitmap_set(bitset, 42);  // Flag 42 (in second word)
    bitset = bitmap_set(bitset, 63);  // Flag 63 (last bit)

    println("Active flags set at indices: [7, 19, 42, 63]");
    let count = bitmap_popcount(bitset);
    println("Hamming Weight (Population Count): " + str(count));
    assert(count == 4);

    // Membership tests
    assert(bitmap_test(bitset, 7));
    assert(bitmap_test(bitset, 42));
    assert(bitmap_test(bitset, 10) == false);
    println("Membership query test(42) -> true, test(10) -> false: Verified!");

    // Clearing bit 19
    bitset = bitmap_clear(bitset, 19);
    assert(bitmap_test(bitset, 19) == false);
    assert(bitmap_popcount(bitset) == 3);
    println("Cleared flag 19 -> Remaining active flags: " + str(bitmap_popcount(bitset)));

    println("\nBitmap operations completed successfully with 100% precision!");
    return 0;
}