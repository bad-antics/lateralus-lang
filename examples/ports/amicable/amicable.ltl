// examples/ports/amicable/amicable.ltl
// Single-pass amicable numbers search ported cleanly from amicable.py

module examples.ports.amicable

import io

fn sum_proper_divisors(n: int) -> int {
    if n <= 1 {
        return 0
    }
    let mut total = 1
    let mut d = 2
    while d * d <= n {
        if n % d == 0 {
            total += d
            let other = n / d
            if other != d {
                total += other
            }
        }
        d += 1
    }
    return total
}

fn amicable_check(a: int, upper: int) -> int {
    let b = sum_proper_divisors(a)
    if b > a {
        if b < upper {
            if sum_proper_divisors(b) == a {
                return a + b
            }
        }
    }
    return 0
}

fn main() {
    let upper = 200000
    let mut pairs = 0
    let mut total_sum = 0
    let mut a = 2
    while a < upper {
        let pair_sum = amicable_check(a, upper)
        if pair_sum > 0 {
            pairs += 1
            total_sum += pair_sum
        }
        a += 1
    }
    io.println("upper=" + upper as str + " pairs=" + pairs as str + " sum=" + total_sum as str)
}

main()
