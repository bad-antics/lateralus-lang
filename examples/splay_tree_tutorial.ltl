// ===================================================================
// examples/splay_tree_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: Low-Latency Network Gateway DNS Cache &
// Working-Set Dynamic Symbol Table using Splay Tree.
// ===================================================================

pub fn new_splay_tree() {
    let tree = dict()
    tree["root"] = -1
    tree["nodes"] = dict()
    tree["sz"] = 0
    return tree
}

pub fn splay(tree, key) {
    if tree["root"] == -1 {
        return -1
    }

    let dummy_id = 999999
    let dummy = dict()
    dummy["left"] = -1
    dummy["right"] = -1
    tree["nodes"][dummy_id] = dummy

    let l_max = dummy_id
    let r_min = dummy_id
    let t = tree["root"]

    while true {
        let t_node = tree["nodes"][t]
        if key < t_node["key"] {
            if t_node["left"] == -1 {
                break
            }
            let left_id = t_node["left"]
            let left_node = tree["nodes"][left_id]
            if key < left_node["key"] {
                let y = left_id
                t_node["left"] = left_node["right"]
                left_node["right"] = t
                t = y
                t_node = left_node
                if t_node["left"] == -1 {
                    break
                }
            }
            tree["nodes"][r_min]["left"] = t
            r_min = t
            t = t_node["left"]
            tree["nodes"][r_min]["left"] = -1
        } else {
            if key > t_node["key"] {
                if t_node["right"] == -1 {
                    break
                }
                let right_id = t_node["right"]
                let right_node = tree["nodes"][right_id]
                if key > right_node["key"] {
                    let y = right_id
                    t_node["right"] = right_node["left"]
                    right_node["left"] = t
                    t = y
                    t_node = right_node
                    if t_node["right"] == -1 {
                        break
                    }
                }
                tree["nodes"][l_max]["right"] = t
                l_max = t
                t = t_node["right"]
                tree["nodes"][l_max]["right"] = -1
            } else {
                break
            }
        }
    }

    let t_node = tree["nodes"][t]
    tree["nodes"][l_max]["right"] = t_node["left"]
    tree["nodes"][r_min]["left"] = t_node["right"]
    t_node["left"] = tree["nodes"][dummy_id]["right"]
    t_node["right"] = tree["nodes"][dummy_id]["left"]
    tree["root"] = t

    return t
}

pub fn splay_insert(tree, key, val) {
    if tree["root"] == -1 {
        let new_id = tree["sz"]
        tree["sz"] = new_id + 1
        let node = dict()
        node["key"] = key
        node["val"] = val
        node["left"] = -1
        node["right"] = -1
        tree["nodes"][new_id] = node
        tree["root"] = new_id
        return true
    }

    splay(tree, key)
    let root = tree["nodes"][tree["root"]]
    if root["key"] == key {
        root["val"] = val
        return true
    }

    let new_id = tree["sz"]
    tree["sz"] = new_id + 1
    let new_node = dict()
    new_node["key"] = key
    new_node["val"] = val

    if key < root["key"] {
        new_node["left"] = root["left"]
        new_node["right"] = tree["root"]
        root["left"] = -1
    } else {
        new_node["right"] = root["right"]
        new_node["left"] = tree["root"]
        root["right"] = -1
    }

    tree["nodes"][new_id] = new_node
    tree["root"] = new_id
    return true
}

pub fn splay_search(tree, key) {
    if tree["root"] == -1 {
        return nil
    }
    splay(tree, key)
    let root = tree["nodes"][tree["root"]]
    if root["key"] == key {
        return root["val"]
    }
    return nil
}

pub fn run_gateway_dns_cache_pipeline() {
    let dns_cache = new_splay_tree()

    // Key: Hash / IP Route ID
    // Val: Upstream IP Endpoint
    splay_insert(dns_cache, 101, "10.0.1.5:8080 (Auth Gateway)")
    splay_insert(dns_cache, 204, "10.0.2.12:443 (Payment Gateway)")
    splay_insert(dns_cache, 308, "10.0.3.99:9000 (Database Replica)")
    splay_insert(dns_cache, 412, "10.0.4.1:80 (Static CDN)")

    // High frequency traffic burst to Auth Gateway (ID 101)
    let auth_ip = splay_search(dns_cache, 101)

    // Because ID 101 was accessed, it is now directly at the root!
    let root_key_after_auth = tree_root_key(dns_cache)

    // Traffic burst to Payment Gateway (ID 204)
    let payment_ip = splay_search(dns_cache, 204)
    let root_key_after_pay = tree_root_key(dns_cache)

    let report = dict()
    report["auth_ip"] = auth_ip
    report["root_after_auth"] = root_key_after_auth
    report["payment_ip"] = payment_ip
    report["root_after_pay"] = root_key_after_pay
    return report
}

pub fn tree_root_key(tree) {
    if tree["root"] == -1 {
        return -1
    }
    return tree["nodes"][tree["root"]]["key"]
}
