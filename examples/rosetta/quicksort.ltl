fn quicksort(arr: list) -> list {
    if len(arr) <= 1 { return arr }
    let pivot = arr[0]
    let left = []
    let right = []
    let i = 1
    while i < len(arr) {
        if arr[i] < pivot { left = left + [arr[i]] } else { right = right + [arr[i]] }
        i = i + 1
    }
    return quicksort(left) + [pivot] + quicksort(right)
}
fn main() {
    println(quicksort([9, 3, 1, 5, 6, 2, 4, 1]))
}
