import stdlib.stack as Stack
import stdlib.assert as Assert
import stdlib.print as Print

// Create a new stack and verify it starts empty
let s = Stack.new()
Assert.isTrue(Stack.isEmpty(s))

// Push two values
Stack.push(s, 10)
Stack.push(s, 20)

// Peek should return the last pushed value (20)
Assert.equal(Stack.peek(s), 20)

// Pop should return values in LIFO order
Assert.equal(Stack.pop(s), 20)
Assert.equal(Stack.peek(s), 10)
Assert.equal(Stack.pop(s), 10)

// After popping all elements the stack must be empty again
Assert.isTrue(Stack.isEmpty(s))

// Optional: print the successful run (useful when executing manually)
Print.println("stack_tutorial_test passed")
