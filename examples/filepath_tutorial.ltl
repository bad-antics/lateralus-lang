// examples/filepath_tutorial.ltl — Executable demonstration of stdlib.filepath
// Demonstrates path extraction, joining, normalization, and extension swapping.

fn main() {
    let p = "/var/log/app/server.log"

    // 1. Component Extraction
    let dir = dirname(p)
    let file = basename(p)
    let ext = extension(p)
    let s = stem(p)

    // 2. Joining & Normalization
    let segments = ["/opt", "services", "web", "..", "api", "v1"]
    let joined = join_path(segments)
    let normalized = normalize(joined)

    // 3. Extension manipulation
    let source_file = "build/bundle.ts"
    let target_file = with_extension(source_file, ".js")

    // 4. Queries
    let abs_flag = is_absolute(normalized)
    let rel_flag = is_relative(source_file)
    let ext_match = has_extension(target_file, ".js")

    println("Filepath operations verified successfully.")
}

main()
