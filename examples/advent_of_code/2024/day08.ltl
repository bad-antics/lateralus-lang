// Advent of Code 2024 · Day 8 · Resonant Collinearity
// Antennas with the same frequency create antinodes.
// Part 1: for each pair, antinodes are at points collinear where one is
//         twice as far as the other (distance = gap from pair, in both dirs).
// Part 2: antinodes at every integer point on the line through any pair.

let SAMPLE = "............
........0...
.....0......
.......0....
....0.......
......A.....
............
............
........A...
.........A..
............
............"

fn parse_grid(text: str) -> list {
    let lines = str_split(text, "\n")
    let grid = []
    let i = 0
    while i < len(lines) {
        let row = str_trim(lines[i])
        if len(row) > 0 {
            grid = grid + [row]
        }
        i = i + 1
    }
    return grid
}

fn get_cell(grid: list, r: int, c: int) -> str {
    if r < 0 || r >= len(grid) { return "." }
    let row = grid[r]
    if c < 0 || c >= len(row) { return "." }
    return slice(row, c, c + 1)
}

fn group_antennas(grid: list) -> map {
    let groups = {}
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            let ch = get_cell(grid, r, c)
            if ch != "." {
                if !contains(groups, ch) {
                    groups[ch] = []
                }
                groups[ch] = groups[ch] + [[r, c]]
            }
            c = c + 1
        }
        r = r + 1
    }
    return groups
}

fn part1(text: str) -> int {
    let grid = parse_grid(text)
    let rows = len(grid)
    let cols = len(grid[0])
    let groups = group_antennas(grid)
    let antinodes = {}

    for freq in groups {
        let locs = groups[freq]
        let i = 0
        while i < len(locs) {
            let j = i + 1
            while j < len(locs) {
                let r1 = locs[i][0]
                let c1 = locs[i][1]
                let r2 = locs[j][0]
                let c2 = locs[j][1]
                let dr = r2 - r1
                let dc = c2 - c1
                // antinode beyond locs[i]
                let ar1 = r1 - dr
                let ac1 = c1 - dc
                if ar1 >= 0 && ar1 < rows && ac1 >= 0 && ac1 < cols {
                    antinodes[str(ar1) + "," + str(ac1)] = true
                }
                // antinode beyond locs[j]
                let ar2 = r2 + dr
                let ac2 = c2 + dc
                if ar2 >= 0 && ar2 < rows && ac2 >= 0 && ac2 < cols {
                    antinodes[str(ar2) + "," + str(ac2)] = true
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    return len(antinodes)
}

fn gcd(a: int, b: int) -> int {
    if a < 0 { a = -a }
    if b < 0 { b = -b }
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

fn part2(text: str) -> int {
    let grid = parse_grid(text)
    let rows = len(grid)
    let cols = len(grid[0])
    let groups = group_antennas(grid)
    let antinodes = {}

    for freq in groups {
        let locs = groups[freq]
        let i = 0
        while i < len(locs) {
            let j = i + 1
            while j < len(locs) {
                let r1 = locs[i][0]
                let c1 = locs[i][1]
                let r2 = locs[j][0]
                let c2 = locs[j][1]
                let dr = r2 - r1
                let dc = c2 - c1
                let g = gcd(dr, dc)
                if g < 0 { g = -g }
                if g == 0 { g = 1 }
                let sr = dr / g
                let sc = dc / g
                // Walk in both directions from r1,c1
                let k = 0
                while true {
                    let r = r1 + k * sr
                    let c = c1 + k * sc
                    if r < 0 || r >= rows || c < 0 || c >= cols { k = rows * cols + 1 }
                    else {
                        antinodes[str(r) + "," + str(c)] = true
                        k = k + 1
                    }
                }
                let m = 1
                while true {
                    let r = r1 - m * sr
                    let c = c1 - m * sc
                    if r < 0 || r >= rows || c < 0 || c >= cols { m = rows * cols + 1 }
                    else {
                        antinodes[str(r) + "," + str(c)] = true
                        m = m + 1
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
    }
    return len(antinodes)
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 14)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 34)
}

fn main() {
    print("Day 8 Part 1: " + str(part1(SAMPLE)))
    print("Day 8 Part 2: " + str(part2(SAMPLE)))
}

main()
