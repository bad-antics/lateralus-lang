// ===================================================================
// examples/boyer_moore_tutorial.ltl
// -------------------------------------------------------------------
// Demonstration of Boyer-Moore Fast String Search in Lateralus.
//
// Real-World Applications:
// 1. Text Editor Fast Find (Sublime Text / VS Code Ctrl+F engine).
// 2. High-Throughput Production Log Analyzer: Scanning gigabytes for 'FATAL_ERROR'.
// 3. Command-Line Search Utilities (GNU grep sublinear fast path).
// ===================================================================

fn find_last_occurrence(pattern, m, ch) {
    let i = m - 1
    while i >= 0 {
        if pattern[i] == ch {
            return i
        }
        i = i - 1
    }
    return -1
}

pub fn boyer_moore_search_all(text, pattern) {
    let n = len(text)
    let m = len(pattern)
    let results = []
    if m == 0 or n < m {
        return results
    }

    let s = 0
    while s <= (n - m) {
        let j = m - 1
        while j >= 0 and pattern[j] == text[s + j] {
            j = j - 1
        }

        if j < 0 {
            results = push(results, s)
            let next_shift = 1
            if s + m < n {
                let next_ch = text[s + m]
                let last_idx = find_last_occurrence(pattern, m, next_ch)
                let cand_shift = m - last_idx
                if cand_shift > 1 {
                    next_shift = cand_shift
                }
            }
            s = s + next_shift
        } else {
            let bad_ch = text[s + j]
            let last_idx = find_last_occurrence(pattern, m, bad_ch)
            let shift = j - last_idx
            if shift < 1 {
                shift = 1
            }
            s = s + shift
        }
    }

    return results
}

pub fn main() {
    print("=================================================================")
    print("   Lateralus Standard Library: Boyer-Moore Fast Search Demo      ")
    print("=================================================================")

    // Simulated Server Log Stream
    let log_data = "2026-11-22 21:00:01 INFO Connection established. 2026-11-22 21:00:15 ERROR Database timeout on node 4. 2026-11-22 21:00:30 INFO Retrying query. 2026-11-22 21:00:45 ERROR Circuit breaker tripped on cluster 2."
    print("Log text size: " + str(len(log_data)) + " bytes.")

    let query_pattern = "ERROR"
    print("Searching for incident keyword: '" + query_pattern + "'...")

    let error_offsets = boyer_moore_search_all(log_data, query_pattern)
    print("Total incident matches located: " + str(len(error_offsets)))

    let i = 0
    while i < len(error_offsets) {
        let offset = error_offsets[i]
        print("  -> Incident #" + str(i + 1) + " found at byte offset: " + str(offset))
        i = i + 1
    }

    print("Boyer-Moore sublinear right-to-left scan completed successfully.")
}
