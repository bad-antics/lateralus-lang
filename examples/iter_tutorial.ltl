// ===================================================================
// examples/iter_tutorial.ltl — stdlib/iter.ltl tutorial companion
// Runnable tour of the lazy-iterator toolkit: construction
// (from_list/range_iter/range_step/repeat/empty/once), chainable
// transforms (map/filter/take/skip/take_while/skip_while/flat_map/
// enumerate/zip/chain/unique/chunks/windows) and terminal operations
// (collect/reduce/sum/product/count/any/all/find/position/min/max/
// for_each/to_map).
// Self-contained — the module code is inlined, as in the other
// stdlib tutorials.
// ===================================================================

// -- Iterator construction (inlined from stdlib/iter.ltl) -----------

fn from_list(lst: list) -> map {
    let m = {}
    m["_type"] = "iter"
    m["source"] = lst
    m["index"] = 0
    m["transforms"] = []
    m["len"] = len(lst)
    return m
}

fn range_iter(start: int, stop: int) -> map {
    let mut items = []
    let mut i = start
    while i < stop {
        items = push(items, i)
        i += 1
    }
    return from_list(items)
}

fn range_step(start: int, stop: int, step: int) -> map {
    let mut items = []
    let mut i = start
    if step > 0 {
        while i < stop {
            items = push(items, i)
            i += step
        }
    } else if step < 0 {
        while i > stop {
            items = push(items, i)
            i += step
        }
    }
    return from_list(items)
}

fn repeat(value, n: int) -> map {
    let mut items = []
    let mut i = 0
    while i < n {
        items = push(items, value)
        i += 1
    }
    return from_list(items)
}

fn empty() -> map {
    return from_list([])
}

fn once(value) -> map {
    return from_list([value])
}

// -- Terminal collect (needed before transforms below) --------------

fn collect(it: map) -> list {
    if it["_type"] != "iter" {
        throw TypeError("collect requires an iterator")
    }
    return it["source"]
}

// -- Transforms ------------------------------------------------------

fn iter_map(it: map, f) -> map {
    let items = collect(it)
    let mut result = []
    for x in items {
        result = push(result, f(x))
    }
    return from_list(result)
}

fn iter_filter(it: map, pred) -> map {
    let items = collect(it)
    let mut result = []
    for x in items {
        if pred(x) { result = push(result, x) }
    }
    return from_list(result)
}

fn iter_take(it: map, n: int) -> map {
    let items = collect(it)
    let mut result = []
    let mut i = 0
    for x in items {
        if i >= n { break }
        result = push(result, x)
        i += 1
    }
    return from_list(result)
}

fn iter_skip(it: map, n: int) -> map {
    let items = collect(it)
    if n >= len(items) { return empty() }
    return from_list(slice_list(items, n, len(items)))
}

fn iter_take_while(it: map, pred) -> map {
    let items = collect(it)
    let mut result = []
    for x in items {
        if !pred(x) { break }
        result = push(result, x)
    }
    return from_list(result)
}

fn iter_skip_while(it: map, pred) -> map {
    let items = collect(it)
    let mut result = []
    let mut skipping = true
    for x in items {
        if skipping && pred(x) { continue }
        skipping = false
        result = push(result, x)
    }
    return from_list(result)
}

fn iter_flat_map(it: map, f) -> map {
    let items = collect(it)
    let mut result = []
    for x in items {
        let sub = f(x)
        for y in sub {
            result = push(result, y)
        }
    }
    return from_list(result)
}

fn iter_enumerate(it: map) -> map {
    let items = collect(it)
    let mut result = []
    let mut i = 0
    for x in items {
        let entry = {}
        entry["index"] = i
        entry["value"] = x
        result = push(result, entry)
        i += 1
    }
    return from_list(result)
}

fn min_int(a: int, b: int) -> int {
    if a < b { return a }
    return b
}

fn iter_zip(a: map, b: map) -> map {
    let items_a = collect(a)
    let items_b = collect(b)
    let mut result = []
    let n = min_int(len(items_a), len(items_b))
    let mut i = 0
    while i < n {
        result = push(result, [items_a[i], items_b[i]])
        i += 1
    }
    return from_list(result)
}

fn iter_chain(a: map, b: map) -> map {
    let items_a = collect(a)
    let items_b = collect(b)
    return from_list(items_a + items_b)
}

fn iter_unique(it: map) -> map {
    let items = collect(it)
    let mut seen = {}
    let mut result = []
    for x in items {
        let key = to_str(x)
        if !contains(keys(seen), key) {
            seen[key] = true
            result = push(result, x)
        }
    }
    return from_list(result)
}

fn iter_chunks(it: map, size: int) -> map {
    let items = collect(it)
    let mut result = []
    let mut i = 0
    while i < len(items) {
        let end = min_int(i + size, len(items))
        result = push(result, slice_list(items, i, end))
        i += size
    }
    return from_list(result)
}

fn iter_windows(it: map, size: int) -> map {
    let items = collect(it)
    let mut result = []
    let mut i = 0
    while i + size <= len(items) {
        result = push(result, slice_list(items, i, i + size))
        i += 1
    }
    return from_list(result)
}

// -- Terminal operations ----------------------------------------------

fn iter_reduce(it: map, init, f) {
    let items = collect(it)
    let mut acc = init
    for x in items {
        acc = f(acc, x)
    }
    return acc
}

fn iter_fold(it: map, init, f) {
    return iter_reduce(it, init, f)
}

fn iter_sum(it: map) -> float {
    return iter_reduce(it, 0, fn(a, b) { a + b })
}

fn iter_product(it: map) -> float {
    return iter_reduce(it, 1, fn(a, b) { a * b })
}

fn iter_count(it: map) -> int {
    return len(collect(it))
}

fn iter_any(it: map, pred) -> bool {
    for x in collect(it) {
        if pred(x) { return true }
    }
    return false
}

fn iter_all(it: map, pred) -> bool {
    for x in collect(it) {
        if !pred(x) { return false }
    }
    return true
}

fn iter_find(it: map, pred) -> map {
    for x in collect(it) {
        if pred(x) {
            let hit = {}
            hit["_tag"] = "Some"
            hit["value"] = x
            hit["is_some"] = true
            return hit
        }
    }
    let miss = {}
    miss["_tag"] = "None"
    miss["is_some"] = false
    return miss
}

fn iter_position(it: map, pred) -> int {
    let mut i = 0
    for x in collect(it) {
        if pred(x) { return i }
        i += 1
    }
    return -1
}

fn iter_min(it: map) {
    let items = collect(it)
    if len(items) == 0 { throw ValueError("min of empty iterator") }
    let mut m = items[0]
    for x in items {
        if x < m { m = x }
    }
    return m
}

fn iter_max(it: map) {
    let items = collect(it)
    if len(items) == 0 { throw ValueError("max of empty iterator") }
    let mut m = items[0]
    for x in items {
        if x > m { m = x }
    }
    return m
}

fn iter_for_each(it: map, f) {
    for x in collect(it) {
        f(x)
    }
}

fn iter_to_map(it: map, key_fn, val_fn) -> map {
    let mut result = {}
    for x in collect(it) {
        result[key_fn(x)] = val_fn(x)
    }
    return result
}

// -- Demo --------------------------------------------------------------

fn show(label: str, v) {
    print(label + " => " + to_str(v))
}

fn main() {
    print("=== LATERALUS STDLIB ITER TUTORIAL ===")

    // Construction
    show("range_iter(1,6)", collect(range_iter(1, 6)))
    show("range_step(0,10,3)", collect(range_step(0, 10, 3)))
    show("range_step(9,0,-3)", collect(range_step(9, 0, -3)))
    show("repeat(7,3)", collect(repeat(7, 3)))
    show("once(42)", collect(once(42)))
    show("empty().count", iter_count(empty()))

    // Transforms — note each stage returns a fresh iterator
    let base = range_iter(1, 11)
    let doubled = iter_map(base, fn(x) { return x * 2 })
    let evens = iter_filter(doubled, fn(x) { return x % 4 == 0 })
    show("1..10 map*2 filter%4==0", collect(evens))
    show("take(1..10, 4)", collect(iter_take(base, 4)))
    show("skip(1..10, 7)", collect(iter_skip(base, 7)))
    show("skip past end", collect(iter_skip(base, 99)))
    show("take_while(<5)", collect(iter_take_while(base, fn(x) { return x < 5 })))
    show("skip_while(<4)", collect(iter_skip_while(base, fn(x) { return x < 4 })))
    // NOTE: iter_flat_map expects f to return a list — the tutorial
    // passes list-returning lambdas (returning an iterator map would
    // iterate its keys, since `for y in sub` walks map entries).
    show("flat_map squares", collect(iter_flat_map(
        range_iter(1, 4), fn(x) { return [x * x, x * x + 1] })))
    show("enumerate(1..4)", collect(iter_enumerate(range_iter(1, 4))))
    show("zip(1..4, 10..13)", collect(iter_zip(range_iter(1, 4), range_iter(10, 13))))
    show("zip unequal len", collect(iter_zip(range_iter(1, 5), range_iter(7, 9))))
    show("chain", collect(iter_chain(once(1), range_iter(2, 5))))
    show("unique", collect(iter_unique(from_list([3, 1, 3, 2, 1, 3]))))
    show("chunks(1..7,3)", collect(iter_chunks(range_iter(1, 8), 3)))
    show("windows(1..5,3)", collect(iter_windows(range_iter(1, 6), 3)))

    // Terminals
    show("sum(1..10)", iter_sum(range_iter(1, 11)))
    show("product(1..5)", iter_product(range_iter(1, 6)))
    show("count", iter_count(range_iter(1, 11)))
    show("fold concat", iter_fold(from_list(["a", "b", "c"]), "", fn(acc, x) { return acc + x }))
    show("any >8", iter_any(range_iter(1, 11), fn(x) { return x > 8 }))
    show("all >0", iter_all(range_iter(1, 11), fn(x) { return x > 0 }))
    show("find even>6", iter_find(range_iter(1, 11), fn(x) { return x % 2 == 0 && x > 6 }))
    show("find none", iter_find(range_iter(1, 4), fn(x) { return x > 100 }))
    show("position first odd>7", iter_position(range_iter(1, 11), fn(x) { return x % 2 == 1 && x > 7 }))
    show("min(3,1,4,1,5)", iter_min(from_list([3, 1, 4, 1, 5])))
    show("max(3,1,4,1,5)", iter_max(from_list([3, 1, 4, 1, 5])))

    // NOTE: lambdas cannot rebind outer `let mut` locals (Python
    // closure scoping), so for_each demos via mutation of a map,
    // which IS a reference type.
    let acc = {}
    acc["total"] = 0
    iter_for_each(range_iter(1, 4), fn(x) { acc["total"] = acc["total"] + x * x })
    show("for_each sum of squares", acc["total"])

    show("to_map squares", iter_to_map(range_iter(1, 4),
        fn(x) { return x }, fn(x) { return x * x }))

    print("PINNED_VECTORS: sum_1_10=55 prod_1_5=120 chunks_1_7_s3=3 windows_1_5_s3=3 unique_3313213=3 zip_min=2")
}
