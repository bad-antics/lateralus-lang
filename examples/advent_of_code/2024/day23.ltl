// Advent of Code 2024 · Day 23 · LAN Party
// Undirected graph of computers. Part 1: count triangles (3-cliques) with
// at least one computer whose name starts with "t". Sample answer: 7.
// Part 2: the largest clique, names sorted and comma-joined.
// Sample answer: "co,de,ka,ta" (Bron-Kerbosch maximum clique).

let SAMPLE = "kh-tc
qp-kh
de-cg
ka-co
yn-aq
qp-ub
cg-tb
vc-aq
tb-ka
wh-tc
yn-cg
kh-ub
ta-co
de-co
tc-td
tb-wq
wh-td
ta-ka
td-qp
aq-cg
wq-ub
ub-vc
de-ta
wq-aq
wq-vc
wh-yn
ka-de
kh-ta
co-tc
wh-qp
tb-vc
td-yn"

// Adjacency as dict of dict-sets: adj[name][neighbor] = true.
fn parse(text: str) -> dict {
    let adj = {}
    let lines = str_split(text, "\n")
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let parts = str_split(line, "-")
            let a = parts[0]
            let b = parts[1]
            if contains(adj, a) == false { adj[a] = {} }
            if contains(adj, b) == false { adj[b] = {} }
            let na = adj[a]
            na[b] = true
            let nb = adj[b]
            nb[a] = true
        }
        i = i + 1
    }
    return adj
}

fn connected(adj: dict, a: str, b: str) -> bool {
    if contains(adj, a) == false { return false }
    let nb = adj[a]
    return contains(nb, b)
}

// Intersection of two dict-sets, as a fresh dict-set.
fn dict_inter(a: dict, b: dict) -> dict {
    let r = {}
    let ks = keys(a)
    let i = 0
    while i < len(ks) {
        if contains(b, ks[i]) { r[ks[i]] = true }
        i = i + 1
    }
    return r
}

// Bron-Kerbosch: largest clique containing R, with candidates P and
// excluded X (both dict-sets). Returns the largest clique found.
fn bron_kerbosch(adj: dict, r: list, p: dict, x: dict) -> list {
    if len(p) == 0 {
        if len(x) == 0 { return r }
        return r
    }
    let best = r
    let pkeys = keys(p)
    let i = 0
    while i < len(pkeys) {
        let v = pkeys[i]
        let nbs = adj[v]
        let np = dict_inter(p, nbs)
        let nx = dict_inter(x, nbs)
        let cand = bron_kerbosch(adj, r + [v], np, nx)
        if len(cand) > len(best) { best = cand }
        // move v from P to X
        let j = 0
        let ks2 = keys(p)
        let pnew = {}
        while j < len(ks2) {
            if ks2[j] != v { pnew[ks2[j]] = true }
            j = j + 1
        }
        p = pnew
        x[v] = true
        i = i + 1
    }
    return best
}

fn part1(text: str) -> int {
    let adj = parse(text)
    let nodes = sorted(keys(adj))
    let total = 0
    let i = 0
    while i < len(nodes) {
        let j = i + 1
        while j < len(nodes) {
            let k = j + 1
            while k < len(nodes) {
                let a = nodes[i]
                let b = nodes[j]
                let c = nodes[k]
                if connected(adj, a, b) {
                    if connected(adj, a, c) {
                        if connected(adj, b, c) {
                            let has_t = false
                            if str_starts_with(a, "t") { has_t = true }
                            if str_starts_with(b, "t") { has_t = true }
                            if str_starts_with(c, "t") { has_t = true }
                            if has_t { total = total + 1 }
                        }
                    }
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return total
}

fn part2(text: str) -> str {
    let adj = parse(text)
    let nodes = sorted(keys(adj))
    let p = {}
    let i = 0
    while i < len(nodes) {
        p[nodes[i]] = true
        i = i + 1
    }
    let clique = bron_kerbosch(adj, [], p, {})
    clique = sorted(clique)
    return str_join(clique, ",")
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 7)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), "co,de,ka,ta")
}

fn main() {
    print("Day 23 Part 1: " + str(part1(SAMPLE)))
    print("Day 23 Part 2: " + part2(SAMPLE))
}

main()
