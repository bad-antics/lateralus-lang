--- stdlib/saml.ltl
+++ stdlib/saml.ltl
@@ -75,9 +75,13 @@
 fn redirect_binding_url(destination: String, req: SamlRequest, sig_alg: String, secret_key: String, relay_state: String) -> String {
     let params = make_redirect_params(req, sig_alg, secret_key, relay_state)
     let encoded = oauth2_form_encode(params)
-    if encoded == "" {
-        return destination
+    if encoded == "" {
+        return destination
     }
-    return destination + "?" + encoded
+    let sep = if string_contains(destination, "?") { "&" } else { "?" }
+    return destination + sep + encoded
 }
 
@@ -150,11 +154,17 @@
 fn attr_of(tag: String, attr: String) -> String {
     let target = attr + "=\""
     let start = string_index_of(tag, target)
-    if start < 0 {
+    if start < 0 {
         return ""
     }
     let start_at = start + string_length(target)
     let to = string_index_of_from(tag, "\"", start_at)
+    let tag_end = string_index_of(tag, ">")
+    if to < 0 || (tag_end >= 0 && to > tag_end) {
+        return ""
+    }
+    if to < 0 {
+        return ""
+    }
     return slice(tag, start_at, to)
 }
 
@@ -188,9 +198,15 @@
 fn between_tags(xml: String, tag: String) -> String {
     let open_tag = "<" + tag + ">"
     let prefix_open = "<saml:" + tag + ">"
+    let attr_prefix = "<" + tag + " "
+    let saml_attr_prefix = "<saml:" + tag + " "
+    
     let start = string_index_of(xml, open_tag)
     let used_open = open_tag
     if start < 0 {
         start = string_index_of(xml, prefix_open)
         used_open = prefix_open
     }
     if start < 0 {
+        start = string_index_of(xml, attr_prefix)
+        used_open = attr_prefix
+    }
+    if start < 0 {
+        start = string_index_of(xml, saml_attr_prefix)
+        used_open = saml_attr_prefix
+    }
+    if start < 0 {
         return ""
     }
     
     let content_start = start + string_length(used_open)
-    if used_open == attr_prefix || used_open == saml_attr_prefix {
-        let gt = string_index_of_from(xml, ">", start)
-        if gt < 0 {
-            return ""
-        }
-        content_start = gt + 1
+    if used_open == attr_prefix || used_open == saml_attr_prefix {
+        let gt = string_index_of_from(xml, ">", start)
+        if gt < 0 {
+            return ""
+        }
+        content_start = gt + 1
     }
     
     let close_tag = "</" + tag + ">"