// Rosetta Code · Factorial · Lateralus
// Iterative, recursive, and a small table of exact values.

fn factorial_iter(n: int) -> int {
    let acc = 1
    let i = 2
    while i <= n {
        acc = acc * i
        i = i + 1
    }
    return acc
}

fn factorial_rec(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial_rec(n - 1)
}

fn main() {
    assert_eq(factorial_iter(0), 1, "0!")
    assert_eq(factorial_iter(5), 120, "5!")
    assert_eq(factorial_iter(10), 3628800, "10!")
    assert_eq(factorial_rec(7), 5040, "7! recursive")
    let i = 0
    while i <= 10 {
        print(str(i) + "! = " + str(factorial_iter(i)))
        i = i + 1
    }
}

main()
