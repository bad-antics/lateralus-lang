// examples/cbor_tutorial.ltl — Executable demonstration of stdlib.cbor
// Demonstrates RFC 8949 binary serialization and roundtrip decoding.

fn main() {
    // 1. Primitive scalars
    let u0 = encode(0)
    let u23 = encode(23)
    let u24 = encode(24)
    let u1000 = encode(1000)
    let n1 = encode(-1)
    let n10 = encode(-10)
    let b_f = encode(false)
    let b_t = encode(true)
    let b_null = encode(nil)
    let b_str = encode("hello")

    // 2. Collections
    let b_arr = encode([1, 2, 3])
    let b_map = encode({ a: 1 })

    // 3. Verify decoding roundtrips
    let rec_u0 = decode(u0)
    let rec_u23 = decode(u23)
    let rec_u24 = decode(u24)
    let rec_u1000 = decode(u1000)
    let rec_n1 = decode(n1)
    let rec_n10 = decode(n10)
    let rec_f = decode(b_f)
    let rec_t = decode(b_t)
    let rec_null = decode(b_null)
    let rec_str = decode(b_str)
    let rec_arr = decode(b_arr)
    let rec_map = decode(b_map)

    println("CBOR RFC 8949 roundtrip verified successfully.")
}

main()
