// examples/color_tutorial.ltl - Demonstrates stdlib.color utilities
import stdlib.color

fn main() {
    let brand = color.rgb(255, 105, 180) // Hot pink
    let hex_val = color.to_hex(brand)
    
    let r = color.red(brand)
    let g = color.green(brand)
    let b = color.blue(brand)
    
    let light = color.lighten(brand, 0.2)
    let dark = color.darken(brand, 0.2)
    let gray = color.grayscale(brand)
    let inv = color.invert(brand)
}
