// Advent of Code 2024 · Day 10 · Hoof It
// Part 1: sum over trailheads (height 0) of how many distinct 9s a +1-step trail reaches.
// Part 2: sum over trailheads of the number of distinct trails (paths) to any 9.

let SAMPLE = "89010123
78121874
87430965
96549874
45678903
32019012
01329801
10456732"

// Grid of digit heights, one row per non-empty line.
fn parse(text: str) -> list {
    let grid = []
    for raw in str_split(text, "\n") {
        let line = str_trim(raw)
        if len(line) == 0 { continue }
        let row = []
        for ch in line {
            row.append(int(ch))
        }
        grid.append(row)
    }
    return grid
}

// Walk outward from one trailhead level by level (height 1, 2, ... 9).
// `ways` maps a cell key (r * cols + c) to the number of distinct paths that
// reach it, so after level 9 the key count is the score (part 1) and the sum
// of path counts is the rating (part 2). Returns [score, rating].
fn trailhead(grid: list, r0: int, c0: int) -> list {
    let rows = len(grid)
    let cols = len(grid[0])
    let ways = {}
    ways[r0 * cols + c0] = 1
    let dr = [1, -1, 0, 0]
    let dc = [0, 0, 1, -1]
    for h in range(1, 10) {
        let next = {}
        for key in keys(ways) {
            let r = idiv(key, cols)
            let c = imod(key, cols)
            for d in range(0, 4) {
                let nr = r + dr[d]
                let nc = c + dc[d]
                if nr < 0 || nr >= rows || nc < 0 || nc >= cols { continue }
                if grid[nr][nc] != h { continue }
                let nk = nr * cols + nc
                if contains(next, nk) {
                    next[nk] = next[nk] + ways[key]
                } else {
                    next[nk] = ways[key]
                }
            }
        }
        ways = next
    }
    return [len(ways), sum(values(ways))]
}

// Sum one component ([score, rating][which]) over every trailhead.
fn total(text: str, which: int) -> int {
    let grid = parse(text)
    let acc = 0
    for r in range(0, len(grid)) {
        for c in range(0, len(grid[0])) {
            if grid[r][c] == 0 {
                acc = acc + trailhead(grid, r, c)[which]
            }
        }
    }
    return acc
}

fn part1(text: str) -> int {
    return total(text, 0)
}

fn part2(text: str) -> int {
    return total(text, 1)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 36)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 81)
}

fn main() {
    print("Day 10 Part 1: " + str(part1(SAMPLE)))
    print("Day 10 Part 2: " + str(part2(SAMPLE)))
}

main()
