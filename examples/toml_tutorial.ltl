// ===================================================================
// examples/toml_tutorial.ltl
//
// Tutorial: Structured Configuration Parsing with Lateralus
// stdlib/toml.ltl (TOML 1.0).
//
// Demonstrates:
// 1. Parsing TOML documents into nested Lateralus maps.
// 2. Safe string literal handling and inline comment preservation.
// 3. Multi-level table routing ([api.rate_limits]).
// 4. Repeated table arrays ([[routes]]) for microservice routing.
// ===================================================================

import toml

pub fn main() {
    print("=== Lateralus TOML 1.0 Parser Tutorial ===")

    let manifest = "
# Microservice Configuration Manifest
service_name = \"auth_gateway\"
port = 9000
enabled = true

[rate_limit]
max_requests = 500
window_seconds = 60

[[routes]]
path = \"/login\"
method = \"POST\"
auth_required = false

[[routes]]
path = \"/profile\"
method = \"GET\"
auth_required = true
"

    print("Parsing manifest configuration...")
    let conf = toml_parse(manifest)

    print("Service: " + conf["service_name"])
    print("Listen Port: " + str(conf["port"]))
    print("Enabled: " + str(conf["enabled"]))

    let rl = conf["rate_limit"]
    print("Rate Limit: " + str(rl["max_requests"]) + " reqs / " + str(rl["window_seconds"]) + "s")

    let routes = conf["routes"]
    print("Configured routes count: " + str(len(routes)))

    let i = 0
    while i < len(routes) {
        let r = routes[i]
        print("  Route [" + r["method"] + "] " + r["path"] +
              " (Auth: " + str(r["auth_required"]) + ")")
        i = i + 1
    }

    print("=== TOML tutorial demonstration completed successfully ===")
}
