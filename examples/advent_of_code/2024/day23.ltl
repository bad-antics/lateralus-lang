// Advent of Code 2024 · Day 23 · LAN Party
// Part 1: count sets of three mutually connected computers that contain a
// name starting with "t". Sample answer 7 (of the 12 triples listed on
// https://adventofcode.com/2024/day/23).

let SAMPLE = "kh-tc
qp-kh
de-cg
ka-co
yn-aq
qp-ub
cg-tb
vc-aq
tb-ka
wh-tc
yn-cg
kh-ub
ta-co
de-co
tc-td
tb-wq
wh-td
ta-ka
td-qp
aq-cg
wq-ub
ub-vc
de-ta
wq-aq
wq-vc
wh-yn
ka-de
kh-ta
co-tc
wh-qp
tb-vc
td-yn"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn graph(text: str) -> dict {
    let g = {}
    for line in lines_of(text) {
        let parts = str_split(line, "-")
        let a = parts[0]
        let b = parts[1]
        if not contains(g, a) { g[a] = [] }
        if not contains(g, b) { g[b] = [] }
        g[a] = g[a] + [b]
        g[b] = g[b] + [a]
    }
    return g
}

fn starts_with_t(name: str) -> bool {
    if len(name) == 0 { return false }
    return slice(name, 0, 1) == "t"
}

// Count triples (a,b,c) where all three edges exist and one name starts with t.
fn part1(text: str) -> int {
    let g = graph(text)
    let nodes = keys(g)
    let counted = {}
    let total = 0
    for a in nodes {
        for b in g[a] {
            if b <= a { continue }
            for c in g[b] {
                if c <= b { continue }
                if not contains(g[a], c) { continue }
                if starts_with_t(a) || starts_with_t(b) || starts_with_t(c) {
                    let key = a + "," + b + "," + c
                    if not contains(counted, key) {
                        counted[key] = 1
                        total = total + 1
                    }
                }
            }
        }
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 7)
}

fn main() {
    print("Day 23 Part 1 (sample): " + str(part1(SAMPLE)))
}

main()
