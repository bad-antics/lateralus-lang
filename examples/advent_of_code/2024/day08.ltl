// Advent of Code 2024 · Day 8 · Resonant Collinearity
// Antennas (letter/digit) of the same frequency create antinodes.
// Part 1: for a pair of antennas, antinodes sit one step beyond each
// antenna along their line (one antenna twice as far as the other).
// Part 2: antinodes sit at every grid position exactly in line with
// any pair of same-frequency antennas (antennas themselves count).

let SAMPLE = "............
........0...
.....0......
.......0....
....0.......
......A.....
............
............
........A...
.........A..
............
............"

fn rows_of(text: str) -> list {
    let rows = []
    let lines = str_split(text, "\n")
    let i = 0
    while i < len(lines) {
        if len(str_trim(lines[i])) > 0 {
            rows = rows + [lines[i]]
        }
        i = i + 1
    }
    return rows
}

fn ch(rows: list, r: int, c: int) -> str {
    return slice(rows[r], c, c + 1)
}

fn in_bounds(rows: list, r: int, c: int) -> bool {
    if r < 0 { return false }
    if c < 0 { return false }
    if r >= len(rows) { return false }
    if c >= len(rows[0]) { return false }
    return true
}

// Group antenna positions by frequency: dict freq -> list of [r, c].
fn antennas_by_freq(rows: list) -> dict {
    let by_freq = {}
    let r = 0
    while r < len(rows) {
        let c = 0
        while c < len(rows[r]) {
            let f = ch(rows, r, c)
            if f != "." {
                if contains(by_freq, f) {
                    by_freq[f] = by_freq[f] + [[r, c]]
                } else {
                    by_freq[f] = [[r, c]]
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    return by_freq
}

// Record an antinode position in the set (dict with "r,c" keys).
fn mark(antis, r: int, c: int) {
    antis[str(r) + "," + str(c)] = true
}

fn part1(text: str) -> int {
    let rows = rows_of(text)
    let by_freq = antennas_by_freq(rows)
    let antis = {}
    let freqs = keys(by_freq)
    let fi = 0
    while fi < len(freqs) {
        let ants = by_freq[freqs[fi]]
        let i = 0
        while i < len(ants) {
            let j = 0
            while j < len(ants) {
                if i != j {
                    let dr = ants[i][0] - ants[j][0]
                    let dc = ants[i][1] - ants[j][1]
                    let ar = ants[i][0] + dr
                    let ac = ants[i][1] + dc
                    if in_bounds(rows, ar, ac) {
                        mark(antis, ar, ac)
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
        fi = fi + 1
    }
    return len(keys(antis))
}

fn part2(text: str) -> int {
    let rows = rows_of(text)
    let by_freq = antennas_by_freq(rows)
    let antis = {}
    let freqs = keys(by_freq)
    let fi = 0
    while fi < len(freqs) {
        let ants = by_freq[freqs[fi]]
        let i = 0
        while i < len(ants) {
            let j = 0
            while j < len(ants) {
                if i != j {
                    let dr = ants[i][0] - ants[j][0]
                    let dc = ants[i][1] - ants[j][1]
                    // every point a + k*d, k from -n to +n, that stays in bounds
                    let k = -len(rows) - len(rows[0])
                    while k <= len(rows) + len(rows[0]) {
                        let ar = ants[i][0] + k * dr
                        let ac = ants[i][1] + k * dc
                        if in_bounds(rows, ar, ac) {
                            mark(antis, ar, ac)
                        }
                        k = k + 1
                    }
                }
                j = j + 1
            }
            i = i + 1
        }
        fi = fi + 1
    }
    return len(keys(antis))
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 14)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 34)
}

fn main() {
    print("Day 8 Part 1: " + str(part1(SAMPLE)))
    print("Day 8 Part 2: " + str(part2(SAMPLE)))
}

main()
