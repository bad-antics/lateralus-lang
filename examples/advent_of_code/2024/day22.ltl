// Advent of Code 2024 · Day 22 · Monkey Market
// Pseudo-random number generator: mix (XOR) and prune (mod 16777216).
// Part 1: sum of 2000th secret numbers for each buyer.
// Part 2: find 4-change sequence that maximizes bananas (last digit of price).

let SAMPLE = "1
10
100
2024"

let SAMPLE2 = "1
2
3
2024"

fn next_secret(s: int) -> int {
    let MOD = 16777216
    s = (s ^ (s * 64)) % MOD
    s = (s ^ (s / 32)) % MOD
    s = (s ^ (s * 2048)) % MOD
    return s
}

fn nth_secret(s: int, n: int) -> int {
    let i = 0
    while i < n {
        s = next_secret(s)
        i = i + 1
    }
    return s
}

fn part1(text: str) -> int {
    let lines = str_split(text, "\n")
    let total = 0
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            total = total + nth_secret(int(line), 2000)
        }
        i = i + 1
    }
    return total
}

fn part2(text: str) -> int {
    let lines = str_split(text, "\n")
    let seq_total = {}

    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let s = int(line)
            let prices = [s % 10]
            let j = 0
            while j < 2000 {
                s = next_secret(s)
                prices = prices + [s % 10]
                j = j + 1
            }
            // For each 4-change window, record price (only first occurrence per buyer)
            let seen = {}
            let k = 4
            while k < len(prices) {
                let d1 = prices[k-3] - prices[k-4]
                let d2 = prices[k-2] - prices[k-3]
                let d3 = prices[k-1] - prices[k-2]
                let d4 = prices[k] - prices[k-1]
                let key = str(d1) + "," + str(d2) + "," + str(d3) + "," + str(d4)
                if !contains(seen, key) {
                    seen[key] = true
                    if !contains(seq_total, key) { seq_total[key] = 0 }
                    seq_total[key] = seq_total[key] + prices[k]
                }
                k = k + 1
            }
        }
        i = i + 1
    }

    let best = 0
    for key in seq_total {
        if seq_total[key] > best { best = seq_total[key] }
    }
    return best
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 37327623)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE2), 23)
}

fn main() {
    print("Day 22 Part 1: " + str(part1(SAMPLE)))
    print("Day 22 Part 2: " + str(part2(SAMPLE2)))
}

main()
