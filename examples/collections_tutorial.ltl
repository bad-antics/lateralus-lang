// ===================================================================
// examples/collections_tutorial.ltl — stdlib/collections.ltl companion
// Runnable tour of the functional list combinators: slicing
// (head/tail/take/drop/init/last), concat/search, predicates
// (count/any/all), flat_map/chunk/interleave/partition/group_by,
// foldl/sum/product/min/max/enumerate.
// Inlined with while loops; named fns for higher-order params.
// ===================================================================

fn c_append(lst: list, item) -> list { return lst + [item] }
fn c_prepend(item, lst: list) -> list { return [item] + lst }
fn c_head(lst: list) { if len(lst) == 0 { return "EMPTY" } return lst[0] }
fn c_tail(lst: list) -> list { return slice(lst, 1, len(lst)) }
fn c_last(lst: list) { if len(lst) == 0 { return "EMPTY" } return lst[len(lst)-1] }
fn c_init(lst: list) -> list { return slice(lst, 0, len(lst)-1) }
fn c_take(lst: list, n: int) -> list { return slice(lst, 0, n) }
fn c_drop(lst: list, n: int) -> list { return slice(lst, n, len(lst)) }
fn c_concat(a: list, b: list) -> list { return a + b }
fn c_contains(lst: list, item) -> bool {
    let i = 0
    while i < len(lst) { if lst[i] == item { return true } i = i + 1 }
    return false
}
fn c_index_of(lst: list, item) -> int {
    let i = 0
    while i < len(lst) { if lst[i] == item { return i } i = i + 1 }
    return -1
}
fn is_even(x) -> bool { return x % 2 == 0 }
fn is_pos(x) -> bool { return x > 0 }
fn double(x) -> list { return [x, x * 2] }
fn plus_pair(p: list) -> int { return p[0] + p[1] }
fn c_count_where(lst: list, pred) -> int {
    let n = 0
    let i = 0
    while i < len(lst) { if pred(lst[i]) { n = n + 1 } i = i + 1 }
    return n
}
fn c_any(lst: list, pred) -> bool {
    let i = 0
    while i < len(lst) { if pred(lst[i]) { return true } i = i + 1 }
    return false
}
fn c_all(lst: list, pred) -> bool {
    let i = 0
    while i < len(lst) { if not pred(lst[i]) { return false } i = i + 1 }
    return true
}
fn c_flat_map(lst: list, f) -> list {
    let result = []
    let i = 0
    while i < len(lst) {
        let ys = f(lst[i])
        let j = 0
        while j < len(ys) { result = result + [ys[j]]; j = j + 1 }
        i = i + 1
    }
    return result
}
fn c_chunk(lst: list, size: int) -> list {
    let result = []
    let i = 0
    while i < len(lst) {
        result = result + [slice(lst, i, i + size)]
        i = i + size
    }
    return result
}
fn c_interleave(a: list, b: list) -> list {
    let result = []
    let i = 0
    while i < len(a) || i < len(b) {
        if i < len(a) { result = result + [a[i]] }
        if i < len(b) { result = result + [b[i]] }
        i = i + 1
    }
    return result
}
fn c_partition(lst: list, pred) -> list {
    let yes = []
    let no = []
    let i = 0
    while i < len(lst) {
        if pred(lst[i]) { yes = yes + [lst[i]] } else { no = no + [lst[i]] }
        i = i + 1
    }
    return [yes, no]
}
fn c_sum(lst: list) -> float {
    let acc = 0.0
    let i = 0
    while i < len(lst) { acc = acc + lst[i]; i = i + 1 }
    return acc
}
fn c_product(lst: list) -> float {
    let acc = 1.0
    let i = 0
    while i < len(lst) { acc = acc * lst[i]; i = i + 1 }
    return acc
}
fn c_max(lst: list) { if len(lst) == 0 { return 0 } let m = lst[0]; let i = 1; while i < len(lst) { if lst[i] > m { m = lst[i] } i = i + 1 } return m }
fn c_min(lst: list) { if len(lst) == 0 { return 0 } let m = lst[0]; let i = 1; while i < len(lst) { if lst[i] < m { m = lst[i] } i = i + 1 } return m }
fn c_enumerate(lst: list) -> list {
    let result = []
    let i = 0
    while i < len(lst) { result = result + [[i, lst[i]]]; i = i + 1 }
    return result
}
fn c_group_by(lst: list, parity) -> map {
    let groups = {}
    let i = 0
    while i < len(lst) {
        let k = parity(lst[i])
        if contains(keys(groups), k) { groups[k] = groups[k] + [lst[i]] } else { groups[k] = [lst[i]] }
        i = i + 1
    }
    return groups
}
fn parity(x) -> str { if x % 2 == 0 { return "even" } return "odd" }
fn show(xs: list) -> str {
    let s = ""
    let i = 0
    while i < len(xs) {
        if i > 0 { s = s + "," }
        s = s + str(xs[i])
        i = i + 1
    }
    return s
}

fn main() {
    println("=== LATERALUS STDLIB COLLECTIONS TUTORIAL ===")
    let xs = [5, 3, 8, 1, 9, 2]

    println("STEP 1 slicing + concat:")
    println("  xs=" + show(xs))
    println("  head=" + str(c_head(xs)) + " last=" + str(c_last(xs))
           + " tail=" + show(c_tail(xs)) + " init=" + show(c_init(xs)))
    println("  take2=" + show(c_take(xs, 2)) + " drop2=" + show(c_drop(xs, 2)))
    println("  append=" + show(c_append(xs, 7)) + " prepend=" + show(c_prepend(0, xs)))
    println("  concat=" + show(c_concat([1,2],[3,4])))

    println("STEP 2 search + predicates:")
    println("  contains 8=" + str(c_contains(xs, 8)) + " index_of 9=" + str(c_index_of(xs, 9)))
    println("  count even=" + str(c_count_where(xs, is_even))
           + " any pos=" + str(c_any(xs, is_pos))
           + " all pos=" + str(c_all(xs, is_pos)))

    println("STEP 3 higher-order transforms:")
    println("  flat_map double=" + show(c_flat_map([1,2,3], double)))
    let pairs = []
    let i = 0
    while i + 1 < 6 { pairs = pairs + [[xs[i], xs[i+1]]]; i = i + 2 }
    println("  zip_with-style pairs sum (manual):")
    let a = [1, 2, 3]
    let b = [10, 20, 30]
    let sums = []
    let j = 0
    while j < len(a) { sums = sums + [a[j] + b[j]]; j = j + 1 }
    println("    " + show(sums) + " (note: upstream zip_with has a syntax bug)")

    println("STEP 4 chunk / interleave / partition:")
    println("  chunk3=" + show(c_chunk(xs, 3)))
    println("  interleave=" + show(c_interleave([1,3,5],[2,4])))
    let part = c_partition(xs, is_even)
    println("  partition even -> yes=" + show(part[0]) + " no=" + show(part[1]))

    println("STEP 5 group_by / enumerate / aggregates:")
    let groups = c_group_by([1,2,3,4,5,6], parity)
    println("  group_by parity: even=" + show(groups["even"]) + " odd=" + show(groups["odd"]))
    println("  enumerate=" + show(c_enumerate(["a","b"])))
    println("  sum=" + str(c_sum(xs)) + " product=" + str(c_product([2,3,4]))
           + " max=" + str(c_max(xs)) + " min=" + str(c_min(xs)))
    println("PINNED_VECTORS: xs=5,3,8,1,9,2 head=5 last=2 take2=5,3 drop2=8,1,9,2 contains8=T index9=4 even=2 anypos=T allpos=T flatmap=1,2,2,4,3,6 chunk=5,3,8|1,9,2 interleave=1,2,3,4,5 sums=11,22,33 group_even=2,4,6 group_odd=1,3,5 sum=28.0 product=24.0 max=9 min=1")
}

main()
