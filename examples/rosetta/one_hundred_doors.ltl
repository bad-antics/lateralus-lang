// Rosetta Code · 100 doors · Lateralus
// 100 closed doors, toggle every nth door; list the open ones at the end.

fn open_doors(n: int) -> list {
    let doors = []
    let i = 0
    while i < n {
        doors = doors + [false]
        i = i + 1
    }
    let step = 1
    while step <= n {
        let k = step - 1
        while k < n {
            if doors[k] { doors[k] = false } else { doors[k] = true }
            k = k + step
        }
        step = step + 1
    }
    let out = []
    let j = 0
    while j < n {
        if doors[j] { out = out + [j + 1] }
        j = j + 1
    }
    return out
}

fn main() {
    let r = open_doors(100)
    print("open doors: " + str(r))
    assert_eq(r, [1, 4, 9, 16, 25, 36, 49, 64, 81, 100], "100 doors")
}

main()
