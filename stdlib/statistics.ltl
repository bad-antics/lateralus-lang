// Lateralus Standard Library — statistics compatibility module.
// The historical draft was incomplete and could not be parsed.

module stdlib.statistics

import stdlib.stats

pub fn mean(data) { return stats.mean(data) }
pub fn median(data) { return stats.median(data) }
pub fn mode(data) { return stats.mode(data) }
pub fn variance(data) { return stats.variance(data) }
pub fn stddev(data) { return stats.stddev(data) }
pub fn percentile(data, p) { return stats.percentile(data, p) }
pub fn quartiles(data) { return stats.quartiles(data) }
pub fn iqr(data) { return stats.iqr(data) }
pub fn zscore(data) { return stats.zscore(data) }
