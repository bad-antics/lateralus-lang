// Rosetta Code · Vigenère cipher · Lateralus
// https://rosettacode.org/wiki/Vigen%C3%A8re_cipher
//
// Classic polyalphabetic substitution. Per the task, input is upper-cased
// and everything outside A-Z is discarded before enciphering; the key only
// advances on letters that are actually encrypted.

fn letters_only(s: str) -> str {
    let up = str_upper(s)
    let out = ""
    let i = 0
    while i < len(up) {
        let c = slice(up, i, i + 1)
        let o = ord(c)
        if o >= 65 && o <= 90 { out = out + c }
        i = i + 1
    }
    return out
}

// direction = 1 to encrypt, -1 to decrypt.
fn vigenere(text: str, key: str, direction: int) -> str {
    let t = letters_only(text)
    let k = letters_only(key)
    let out = ""
    let i = 0
    while i < len(t) {
        let p = ord(slice(t, i, i + 1)) - 65
        let s = ord(slice(k, i % len(k), i % len(k) + 1)) - 65
        let c = (p + direction * s + 26) % 26
        out = out + chr(c + 65)
        i = i + 1
    }
    return out
}

fn main() {
    let plain = "Beware the Jabberwock, my son! The jaws that bite, the claws that catch!"
    let key = "VIGENERECIPHER"

    let enc = vigenere(plain, key, 1)
    let dec = vigenere(enc, key, -1)
    print("plain : " + plain)
    print("key   : " + key)
    print("enc   : " + enc)
    print("dec   : " + dec)

    assert_eq(enc, "WMCEEIKLGRPIFVMEUGXQPWQVIOIAVEYXUEKFKBTALVXTGAFXYEVKPAGY")
    assert_eq(dec, letters_only(plain))

    // The textbook example from Bellaso / Kasiski write-ups.
    assert_eq(vigenere("ATTACKATDAWN", "LEMON", 1), "LXFOPVEFRNHR")
    assert_eq(vigenere("LXFOPVEFRNHR", "lemon", -1), "ATTACKATDAWN")
}

main()
