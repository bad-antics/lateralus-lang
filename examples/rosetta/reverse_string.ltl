// Rosetta Code: Reverse a string
// https://rosettacode.org/wiki/Reverse_a_string
module examples.rosetta.reverse_string

import io

fn reverse_string(s: str) -> str {
    let out = ""
    let i = len(s) - 1
    while i >= 0 {
        out = out + slice(s, i, i + 1)
        i = i - 1
    }
    return out
}

@test
fn test_reverse() {
    assert_eq(reverse_string("hello"), "olleh")
    assert_eq(reverse_string(""), "")
    assert_eq(reverse_string("a"), "a")
    assert_eq(reverse_string("ab"), "ba")
}

fn main() {
    print("reverse(\"hello\") = " + reverse_string("hello"))
}

main()
