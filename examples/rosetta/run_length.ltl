fn run_length(s: string) -> string {
    let out = ""
    let i = 0
    while i < len(s) {
        let ch = s[i]
        let cnt = 1
        while i + cnt < len(s) && s[i + cnt] == ch {
            cnt = cnt + 1
        }
        out = out + ch + str(cnt)
        i = i + cnt
    }
    return out
}
fn main() {
    println(run_length("aaabbc"))
}
