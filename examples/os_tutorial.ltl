// ===================================================================
// examples/os_tutorial.ltl — Operating System Interfaces & Path Tutorial
// -------------------------------------------------------------------
// Demonstrates cross-platform path manipulation, environment variable
// management, and process metadata inspection in Lateralus.
// ===================================================================

println("=== Lateralus stdlib.os Tutorial ===")

// 1. Cross-Platform Path Manipulation
let sep = path_separator()
println("\n[1] Path Delimiters & Components:")
println("    Active Path Separator: " + sep)

let joined = path_join(["var", "log", "lateralus", "app.log"])
println("    Joined Path: " + joined)

let base = basename(joined)
let dir = dirname(joined)
println("    Basename:    " + base)
println("    Dirname:     " + dir)

// 2. Extension Extraction and Stripping
println("\n[2] File Extensions:")
let filename = "archive.bundle.tar.gz"
let ext = extension(filename)
let stripped = strip_extension(filename)
println("    Target File:       " + filename)
println("    Extension:         " + ext)
println("    Stripped Base:     " + stripped)

// 3. Path Canonicalization & Normalization
println("\n[3] Path Canonicalization:")
let messy = "project" + sep + "build" + sep + ".." + sep + "src" + sep + "." + sep + "main.ltl"
let clean = normalize_path(messy)
println("    Raw Relative Path: " + messy)
println("    Normalized Path:   " + clean)

// 4. Environment Variables
println("\n[4] Environment Variables:")
setenv("LATERALUS_APP_STAGE", "production")
let stage = getenv("LATERALUS_APP_STAGE")
println("    LATERALUS_APP_STAGE = " + stage)

// 5. System Architecture & Process Metadata
println("\n[5] System & Process Information:")
println("    Platform:     " + platform())
println("    Architecture: " + arch())
println("    Process ID:   " + str(pid()))

println("\nTutorial complete: stdlib.os operations verified.")
