// Euclid's algorithm, used to select coprime parameters.
fn gcd(a: int, b: int) -> int {
    let mut x = a
    let mut y = b
    while y > 0 {
        let remainder = x % y
        x = y
        y = remainder
    }
    return x
}

fn count_triangles(limit: int) -> int {
    let mut count = 0
    let mut m = 2
    while 2 * m * (m + 1) <= limit {
        let mut n = 1 + m % 2
        while n < m {
            let perimeter = 2 * m * (m + n)
            if perimeter > limit {
                break
            }
            if gcd(m, n) == 1 {
                // Each positive scale through limit / perimeter fits.
                count = count + int(limit / perimeter)
            }
            n = n + 2
        }
        m = m + 1
    }
    return count
}

fn main() -> int {
    println(count_triangles(11))
    println(count_triangles(12))
    println(count_triangles(24))
    println(count_triangles(120))
    println(count_triangles(1000))
    println(count_triangles(10000000))
    return 0
}

main()
