// Pinned test vectors for the stdlib/semver tutorial (SemVer 2.0.0).

import semver

pub fn test_semver_parsing_and_stripping() -> bool {
    let v1 = semver_parse("v2.4.11-beta.3+sha.a1b2c3d")
    if semver_major(v1) != 2 { return false }
    if semver_minor(v1) != 4 { return false }
    if semver_patch(v1) != 11 { return false }
    if semver_prerelease(v1) != "beta.3" { return false }
    if semver_build_meta(v1) != "sha.a1b2c3d" { return false }
    if semver_is_stable(v1) { return false }
    if not semver_is_prerelease(v1) { return false }

    let v2 = semver_parse("3.0.0")
    if not semver_is_stable(v2) { return false }
    if semver_is_prerelease(v2) { return false }
    if semver_prerelease(v2) != "" { return false }
    if semver_build_meta(v2) != "" { return false }

    return true
}

pub fn test_semver_precedence_rules() -> bool {
    // Specification Rule 11: Pre-release has lower precedence than normal version
    let alpha = semver_parse("1.0.0-alpha")
    let beta = semver_parse("1.0.0-beta")
    let rc = semver_parse("1.0.0-rc.1")
    let release = semver_parse("1.0.0")

    if not semver_lt(alpha, beta) { return false }
    if not semver_lt(beta, rc) { return false }
    if not semver_lt(rc, release) { return false }
    if not semver_gt(release, rc) { return false }

    // Build metadata is ignored in precedence comparison
    let b1 = semver_parse("1.0.0+build.1")
    let b2 = semver_parse("1.0.0+build.999")
    if not semver_eq(b1, b2) { return false }

    return true
}

pub fn test_semver_bumping() -> bool {
    let v = semver_parse("1.4.9")

    let p = semver_bump_patch(v)
    if semver_to_string(p) != "1.4.10" { return false }

    let m = semver_bump_minor(v)
    if semver_to_string(m) != "1.5.0" { return false }

    let maj = semver_bump_major(v)
    if semver_to_string(maj) != "2.0.0" { return false }

    return true
}

pub fn test_semver_range_satisfaction() -> bool {
    let v1 = semver_parse("1.2.5")
    let v2 = semver_parse("1.3.1")
    let v3 = semver_parse("2.0.0")

    // Caret range ^1.2: allows 1.2.x and 1.3.x, rejects 2.0.0
    if not semver_satisfies_caret(v1, 1, 2) { return false }
    if not semver_satisfies_caret(v2, 1, 2) { return false }
    if semver_satisfies_caret(v3, 1, 2) { return false }

    // Tilde range ~1.2: allows 1.2.x, rejects 1.3.x
    if not semver_satisfies_tilde(v1, 1, 2) { return false }
    if semver_satisfies_tilde(v2, 1, 2) { return false }

    return true
}
