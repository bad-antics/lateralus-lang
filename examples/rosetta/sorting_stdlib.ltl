// Rosetta Code: Sort a list — using stdlib collections.sort (quicksort)
from stdlib.collections import sort

let xs = [5, 3, 8, 1, 9, 2, 7]
println("input:  " + str(xs))
println("sorted: " + str(sort(xs)))
let desc = reverse(sort(xs))
println("desc:   " + str(desc))
if sort(xs) == [1, 2, 3, 5, 7, 8, 9] { println("OK") } else { println("FAIL") }
