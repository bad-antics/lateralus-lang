// Standard Library UTF-8 RFC 3629 Tutorial Verification Suite
// Validates multi-byte encoding, Unicode scalar value decoding, overlong rejection, and surrogate isolation.

fn utf8_encode_codepoint(cp: int) -> list {
    if cp < 128 {
        return [cp];
    }
    if cp < 2048 {
        let b0 = 192 | (cp >> 6);
        let b1 = 128 | (cp & 63);
        return [b0, b1];
    }
    if cp < 65536 {
        let b0 = 224 | (cp >> 12);
        let b1 = 128 | ((cp >> 6) & 63);
        let b2 = 128 | (cp & 63);
        return [b0, b1, b2];
    }
    // 4-byte Unicode
    let b0 = 240 | (cp >> 18);
    let b1 = 128 | ((cp >> 12) & 63);
    let b2 = 128 | ((cp >> 6) & 63);
    let b3 = 128 | (cp & 63);
    return [b0, b1, b2, b3];
}

fn utf8_validate_and_decode(bytes: list) -> list {
    let mut codepoints = [];
    let mut i = 0;
    let n = len(bytes);

    while i < n {
        let b0 = bytes[i];
        if (b0 & 128) == 0 {
            // 1-byte ASCII (0..127)
            codepoints = codepoints + [b0];
            i = i + 1;
        } else if (b0 & 224) == 192 {
            // 2-byte sequence
            if i + 1 >= n { return []; }
            let b1 = bytes[i + 1];
            if (b1 & 192) != 128 { return []; }
            let cp = ((b0 & 31) << 6) | (b1 & 63);
            if cp < 128 { return []; } // Reject overlong encoding
            codepoints = codepoints + [cp];
            i = i + 2;
        } else if (b0 & 240) == 224 {
            // 3-byte sequence
            if i + 2 >= n { return []; }
            let b1 = bytes[i + 1];
            let b2 = bytes[i + 2];
            if (b1 & 192) != 128 || (b2 & 192) != 128 { return []; }
            let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
            if cp < 2048 { return []; } // Reject overlong
            if cp >= 55296 && cp <= 57343 { return []; } // Reject UTF-16 surrogates (0xD800..0xDFFF)
            codepoints = codepoints + [cp];
            i = i + 3;
        } else if (b0 & 248) == 240 {
            // 4-byte sequence
            if i + 3 >= n { return []; }
            let b1 = bytes[i + 1];
            let b2 = bytes[i + 2];
            let b3 = bytes[i + 3];
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 { return []; }
            let cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
            if cp < 65536 || cp > 1114111 { return []; } // Reject overlong or out-of-range
            codepoints = codepoints + [cp];
            i = i + 4;
        } else {
            return []; // Invalid leading byte
        }
    }
    return codepoints;
}

fn main() -> int {
    // 1. ASCII vector: 'A' (65)
    let ascii_bytes = utf8_encode_codepoint(65);
    assert(len(ascii_bytes) == 1);
    assert(ascii_bytes[0] == 65);
    let ascii_decoded = utf8_validate_and_decode(ascii_bytes);
    assert(len(ascii_decoded) == 1);
    assert(ascii_decoded[0] == 65);

    // 2. 2-byte vector: 'é' (U+00E9 = 233)
    // UTF-8 bytes: [0xC3, 0xA9] = [195, 169]
    let e_bytes = utf8_encode_codepoint(233);
    assert(len(e_bytes) == 2);
    assert(e_bytes[0] == 195);
    assert(e_bytes[1] == 169);
    let e_decoded = utf8_validate_and_decode(e_bytes);
    assert(len(e_decoded) == 1);
    assert(e_decoded[0] == 233);

    // 3. 3-byte vector: '€' Euro Sign (U+20AC = 8364)
    // UTF-8 bytes: [0xE2, 0x82, 0xAC] = [226, 130, 172]
    let euro_bytes = utf8_encode_codepoint(8364);
    assert(len(euro_bytes) == 3);
    assert(euro_bytes[0] == 226);
    assert(euro_bytes[1] == 130);
    assert(euro_bytes[2] == 172);
    let euro_decoded = utf8_validate_and_decode(euro_bytes);
    assert(len(euro_decoded) == 1);
    assert(euro_decoded[0] == 8364);

    // 4. 4-byte vector: '🚀' Rocket Emoji (U+1F680 = 128640)
    // UTF-8 bytes: [0xF0, 0x9F, 0x9A, 0x80] = [240, 159, 154, 128]
    let rocket_bytes = utf8_encode_codepoint(128640);
    assert(len(rocket_bytes) == 4);
    assert(rocket_bytes[0] == 240);
    assert(rocket_bytes[1] == 159);
    assert(rocket_bytes[2] == 154);
    assert(rocket_bytes[3] == 128);
    let rocket_decoded = utf8_validate_and_decode(rocket_bytes);
    assert(len(rocket_decoded) == 1);
    assert(rocket_decoded[0] == 128640);

    // 5. Security Invariant: Overlong Rejection
    // An overlong encoding of ASCII 'A' (65) as 2-byte [0xC1, 0x81] (193, 129) must fail
    let overlong_bytes = [193, 129];
    let rejected_overlong = utf8_validate_and_decode(overlong_bytes);
    assert(len(rejected_overlong) == 0); // Must be rejected!

    // 6. Security Invariant: UTF-16 Surrogate Rejection
    // 0xD800 (55296) encoded as 3-byte [0xED, 0xA0, 0x80] (237, 160, 128) must fail
    let surrogate_bytes = [237, 160, 128];
    let rejected_surrogate = utf8_validate_and_decode(surrogate_bytes);
    assert(len(rejected_surrogate) == 0); // Must be rejected!

    return 0;
}