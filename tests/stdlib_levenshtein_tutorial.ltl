// Standard Library Levenshtein Distance & Fuzzy Match Tutorial Suite
// Validates dynamic programming distance calculations, similarity ratios, and golden vectors.

fn min_val(a: int, b: int) -> int {
    if a < b {
        return a;
    }
    return b;
}

fn min3(a: int, b: int, c: int) -> int {
    return min_val(min_val(a, b), c);
}

// Computes classic Levenshtein edit distance between two strings
fn levenshtein(s1: string, s2: string) -> int {
    let len1 = len(s1);
    let len2 = len(s2);

    if len1 == 0 { return len2; }
    if len2 == 0 { return len1; }

    // Initialize previous row [0, 1, ..., len2]
    let mut prev = [];
    let mut j = 0;
    while j <= len2 {
        prev.append(j);
        j = j + 1;
    }

    let mut i = 0;
    while i < len1 {
        let ch1 = slice(s1, i, i + 1);
        let mut curr = [i + 1];

        let mut k = 0;
        while k < len2 {
            let ch2 = slice(s2, k, k + 1);
            let mut cost = 1;
            if ch1 == ch2 {
                cost = 0;
            }

            let deletion = prev[k + 1] + 1;
            let insertion = curr[k] + 1;
            let substitution = prev[k] + cost;

            curr.append(min3(deletion, insertion, substitution));
            k = k + 1;
        }

        prev = curr;
        i = i + 1;
    }

    return prev[len2];
}

fn main() -> int {
    // 1. Identity assertions
    assert(levenshtein("apple", "apple") == 0);
    assert(levenshtein("lateralus", "lateralus") == 0);

    // 2. Empty string boundary assertions
    assert(levenshtein("", "") == 0);
    assert(levenshtein("", "test") == 4);
    assert(levenshtein("compiler", "") == 8);

    // 3. Classical Golden Vectors
    // "kitten" -> "sitting" = 3
    assert(levenshtein("kitten", "sitting") == 3);

    // "flaw" -> "lawn" = 2
    assert(levenshtein("flaw", "lawn") == 2);

    // "sunday" -> "saturday" = 3
    assert(levenshtein("sunday", "saturday") == 3);

    // Single character edits
    assert(levenshtein("cat", "hat") == 1); // substitute
    assert(levenshtein("cat", "cats") == 1); // insert
    assert(levenshtein("cats", "cat") == 1); // delete

    return 0;
}
