// Lateralus Standard Library Example: Unix Glob File Matching
// Demonstrates filtering project asset trees using wildcard patterns.

fn glob_match(pattern: string, text: string) -> bool {
    let p_len = len(pattern);
    let t_len = len(text);
    let mut p_idx = 0;
    let mut t_idx = 0;
    let mut star_idx = -1;
    let mut match_idx = 0;

    while t_idx < t_len {
        let mut p_char = "";
        if p_idx < p_len {
            p_char = slice(pattern, p_idx, p_idx + 1);
        }
        let t_char = slice(text, t_idx, t_idx + 1);

        if p_idx < p_len && (p_char == "?" || p_char == t_char) {
            p_idx = p_idx + 1;
            t_idx = t_idx + 1;
        } else if p_idx < p_len && p_char == "*" {
            star_idx = p_idx;
            match_idx = t_idx;
            p_idx = p_idx + 1;
        } else if star_idx != -1 {
            p_idx = star_idx + 1;
            match_idx = match_idx + 1;
            t_idx = match_idx;
        } else {
            return false;
        }
    }

    while p_idx < p_len && slice(pattern, p_idx, p_idx + 1) == "*" {
        p_idx = p_idx + 1;
    }

    return p_idx == p_len;
}

fn main() -> int {
    println("=== Lateralus Glob Pattern Filtering Demo ===");

    let files = [
        "src/main.ltl",
        "src/compiler.ltl",
        "tests/test_compiler.ltl",
        "docs/blog/tutorial.md",
        "dist/bundle.js"
    ];

    println("Filtering for source files with pattern: '*.ltl'");
    let mut ltl_count = 0;
    let mut i = 0;
    while i < len(files) {
        let f = files[i];
        if glob_match("*.ltl", f) {
            println("  [MATCH] " + f);
            ltl_count = ltl_count + 1;
        }
        i = i + 1;
    }
    assert(ltl_count == 3);

    println("Filtering for internal src files with pattern: 'src/*'");
    let mut src_count = 0;
    let mut j = 0;
    while j < len(files) {
        let f = files[j];
        if glob_match("src/*", f) {
            println("  [MATCH] " + f);
            src_count = src_count + 1;
        }
        j = j + 1;
    }
    assert(src_count == 2);

    println("Glob filtering completed with 100% precision!");
    return 0;
}
