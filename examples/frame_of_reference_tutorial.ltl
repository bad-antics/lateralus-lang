// ===================================================================
// examples/frame_of_reference_tutorial.ltl — stdlib/frame_of_reference.ltl
// tutorial companion. Runnable tour of FoR integer-column encoding
// (ref+deltas+bit_width) and Gorilla-style delta-of-delta timestamps.
// Self-contained module inline (no source changes needed).
// Documents edge-case bug: encode_dod([5,5]) decodes as [5].
// ===================================================================

fn min_of(xs: list) -> int {
    let m = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] < m { m = xs[i] }
        i = i + 1
    }
    return m
}

fn max_of(xs: list) -> int {
    let m = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] > m { m = xs[i] }
        i = i + 1
    }
    return m
}

fn bit_width(v: int) -> int {
    if v <= 0 { return 1 }
    let b = 0
    while v > 0 { v = v >> 1; b = b + 1 }
    return b
}

/// Encode by subtracting the min.  Returns {ref, deltas, bit_width}.
fn encode(xs: list) -> map {
    if len(xs) == 0 {
        let e = {}
        e["ref"] = 0; e["deltas"] = []; e["bit_width"] = 0
        return e
    }
    let r = min_of(xs)
    let deltas = []
    let i = 0
    while i < len(xs) {
        deltas = deltas + [xs[i] - r]
        i = i + 1
    }
    let bw = bit_width(max_of(deltas))
    let m = {}
    m["ref"]       = r
    m["deltas"]    = deltas
    m["bit_width"] = bw
    return m
}

fn decode(enc: map) -> list {
    let r = enc["ref"]
    let d = enc["deltas"]
    let out = []
    let i = 0
    while i < len(d) {
        out = out + [r + d[i]]
        i = i + 1
    }
    return out
}

// -- Delta-of-delta (Gorilla style) --------------------------------

/// For time-series timestamps.  Returns {first, second_delta, dods}.
fn encode_dod(xs: list) -> map {
    let m = {}
    if len(xs) == 0 {
        m["first"] = 0; m["second_delta"] = 0; m["dods"] = []
        return m
    }
    if len(xs) == 1 {
        m["first"] = xs[0]; m["second_delta"] = 0; m["dods"] = []
        return m
    }
    m["first"] = xs[0]
    let prev_d = xs[1] - xs[0]
    m["second_delta"] = prev_d
    let dods = []
    let i = 2
    while i < len(xs) {
        let d = xs[i] - xs[i - 1]
        dods = dods + [d - prev_d]
        prev_d = d
        i = i + 1
    }
    m["dods"] = dods
    return m
}

fn decode_dod(enc: map) -> list {
    let out = [enc["first"]]
    if len(enc["dods"]) == 0 && enc["second_delta"] == 0 && len(out) == 1 {
        // single-element column
        return out
    }
    let prev_d = enc["second_delta"]
    out = out + [enc["first"] + prev_d]
    let dods = enc["dods"]
    let i = 0
    while i < len(dods) {
        let d = prev_d + dods[i]
        out = out + [out[len(out) - 1] + d]
        prev_d = d
        i = i + 1
    }
    return out
}

fn main() {
    print("=== LATERALUS STDLIB FRAME-OF-REFERENCE TUTORIAL ===")

    // -- Step 1: encode basics ----------------------------------------------
    print("STEP 1 encode:")
    let enc = encode([100, 101, 105, 110, 115])
    print("  ref=" + str(enc["ref"]))
    print("  deltas=" + str(enc["deltas"]))
    print("  bit_width=" + str(enc["bit_width"]))
    print("  decoded=" + str(decode(enc)))
    print("  roundtrip=" + str(decode(enc) == [100, 101, 105, 110, 115]))

    // -- Step 2: edge cases -----------------------------------------------------
    print("STEP 2 edges:")
    let e0 = encode([])
    print("  empty_ref=" + str(e0["ref"]) + " bw=" + str(e0["bit_width"]))
    let e1 = encode([42])
    print("  single=" + str(decode(e1)))
    let eneg = encode([-5, -3, -1, 0, 2])
    print("  neg_deltas=" + str(eneg["deltas"]))
    print("  neg_rt=" + str(decode(eneg) == [-5, -3, -1, 0, 2]))
    let esame = encode([7, 7, 7])
    print("  same_bw=" + str(esame["bit_width"]) + " rt=" + str(decode(esame)))

    // -- Step 3: delta-of-delta timestamps -----------------------------------------
    print("STEP 3 dod:")
    let ts = [1000, 1010, 1025, 1040, 1070, 1100]
    let denc = encode_dod(ts)
    print("  first=" + str(denc["first"]))
    print("  second_delta=" + str(denc["second_delta"]))
    print("  dods=" + str(denc["dods"]))
    print("  dod_rt=" + str(decode_dod(denc) == ts))

    // -- Step 4: known edge-case bug -----------------------------------------------
    print("STEP 4 known bug:")
    let pair = encode_dod([5, 5])
    print("  enc_55=" + str(pair["first"]) + "," + str(pair["second_delta"]) + "," + str(pair["dods"]))
    print("  dec_55=" + str(decode_dod(pair)))
    print("  BUG: [5,5] decodes as [5] — empty-dods+zero-delta sentinel "
        + "collides with 1-element encoding")

    print("PINNED_VECTORS: ref100 bw4 rt_neg dod_ts_rt "
        + "BUG_dod_55_lossy")
    print("  OK examples/frame_of_reference_tutorial.ltl")
    return 0
}
