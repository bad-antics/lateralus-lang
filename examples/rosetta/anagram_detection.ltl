// Rosetta Code · Anagram detection · Lateralus

fn letters(s: str) -> list {
    let out = []
    let i = 0
    let low = str_lower(s)
    while i < len(low) {
        let c = slice(low, i, i + 1)
        if c != " " { out = out + [c] }
        i = i + 1
    }
    return sorted(out)
}

fn is_anagram(a: str, b: str) -> bool {
    return letters(a) == letters(b)
}

fn main() {
    assert_eq(is_anagram("listen", "silent"), true, "listen/silent")
    assert_eq(is_anagram("Dormitory", "dirty room"), true, "spaces ignored")
    assert_eq(is_anagram("abc", "abd"), false, "different")
    print("is_anagram(\"evil\", \"vile\") = " + str(is_anagram("evil", "vile")))
}

main()
