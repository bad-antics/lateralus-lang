// ===================================================================
// examples/x25519_tutorial.ltl
// Interactive walkthrough of RFC 7748 Curve25519 key exchange
// ===================================================================

import stdlib.x25519

fn run() {
    println("=== RFC 7748 Curve25519 Diffie-Hellman Tutorial ===")

    // Alice's 32-byte private key (RFC 7748 test vector)
    let alice_priv = [
        0x77, 0x07, 0x6d, 0x0a, 0x73, 0x18, 0xa5, 0x7d,
        0x3c, 0x16, 0xc1, 0x72, 0x51, 0xb2, 0x66, 0x45,
        0xdf, 0x4c, 0x2f, 0x87, 0xeb, 0xc0, 0x99, 0x2a,
        0xb1, 0x77, 0xfb, 0xa5, 0x1d, 0xb9, 0x2c, 0x2a
    ]

    // Bob's 32-byte private key (RFC 7748 test vector)
    let bob_priv = [
        0x5d, 0xab, 0x08, 0x7e, 0x62, 0x4a, 0x8a, 0x4b,
        0x79, 0x4b, 0xf4, 0x9b, 0x75, 0x94, 0x5f, 0x49,
        0xb9, 0x8a, 0xcc, 0xd6, 0x84, 0x31, 0x87, 0x13,
        0x0d, 0x55, 0xa8, 0x06, 0x31, 0xf5, 0x6c, 0xf7
    ]

    println("\n[1] Clamping Private Scalars:")
    let alice_clamped = clamp_scalar(alice_priv)
    println("Alice byte 0 (cleared lowest 3 bits): " + str(alice_clamped[0]))
    println("Alice byte 31 (bit 6 set, bit 7 cleared): " + str(alice_clamped[31]))

    println("\n[2] Deriving Public Keys (Base Point u=9):")
    let alice_pub = derive_public(alice_priv)
    let bob_pub = derive_public(bob_priv)
    println("Alice Public Key length: " + str(len(alice_pub)) + " bytes")
    println("Bob Public Key length:   " + str(len(bob_pub)) + " bytes")

    println("\n[3] Computing Diffie-Hellman Shared Secrets:")
    let shared_alice = scalar_mult(alice_priv, bob_pub)
    let shared_bob   = scalar_mult(bob_priv, alice_pub)

    let match_count = 0
    let i = 0
    while i < 32 {
        if shared_alice[i] == shared_bob[i] {
            match_count = match_count + 1
        }
        i = i + 1
    }

    println("Shared secret bytes matching: " + str(match_count) + "/32")
    if match_count == 32 {
        println("SUCCESS: Alice and Bob computed identical shared secrets!")
    } else {
        println("ERROR: Shared secrets do not match!")
    }

    println("\n=== RFC 7748 Key Agreement Ceremony Complete ===")
}

run()
