// Standard Library Extended Euclidean Algorithm & Modular Inverse Verification Suite
// Validates Bézout identity (a*x + b*y == gcd), modular multiplicative inverse, and cryptographic coprimality.

fn ext_gcd(a: int, b: int) -> dict {
    let mut old_r = a;
    let mut r = b;
    let mut old_s = 1;
    let mut s = 0;
    let mut old_t = 0;
    let mut t = 1;

    while r != 0 {
        let quotient = idiv(old_r, r);
        let temp_r = r;
        r = old_r - quotient * r;
        old_r = temp_r;

        let temp_s = s;
        s = old_s - quotient * s;
        old_s = temp_s;

        let temp_t = t;
        t = old_t - quotient * t;
        old_t = temp_t;
    }

    let mut result = {};
    result["gcd"] = old_r;
    result["x"] = old_s;
    result["y"] = old_t;
    return result;
}

fn mod_inverse(a: int, m: int) -> int {
    let res = ext_gcd(a, m);
    if res["gcd"] != 1 {
        return -1;
    }
    let mut inv = res["x"] % m;
    if inv < 0 {
        inv = inv + m;
    }
    return inv;
}

fn main() -> int {
    // 1. Classical Bézout Identity Verification: 35 and 15
    // gcd(35, 15) = 5
    // 35 * (1) + 15 * (-2) = 5
    let res1 = ext_gcd(35, 15);
    let g1 = res1["gcd"];
    let x1 = res1["x"];
    let y1 = res1["y"];
    assert(g1 == 5);
    assert(35 * x1 + 15 * y1 == g1);

    // 2. Coprime Pair: 120 and 23
    // gcd(120, 23) = 1
    let res2 = ext_gcd(120, 23);
    let g2 = res2["gcd"];
    let x2 = res2["x"];
    let y2 = res2["y"];
    assert(g2 == 1);
    assert(120 * x2 + 23 * y2 == 1);

    // 3. Modular Multiplicative Inverse: 3 mod 11
    // 3 * 4 = 12 = 1 (mod 11) => inverse is 4
    let inv3 = mod_inverse(3, 11);
    assert(inv3 == 4);
    assert((3 * inv3) % 11 == 1);

    // 4. Larger Modular Inverse: 17 mod 3120 (RSA Textbook Parameters)
    // 17 * 2753 = 46801 = 15 * 3120 + 1 => inverse is 2753
    let inv_rsa = mod_inverse(17, 3120);
    assert(inv_rsa == 2753);
    assert((17 * inv_rsa) % 3120 == 1);

    // 5. Non-Invertible Element (gcd != 1)
    // gcd(6, 9) = 3 != 1 => no inverse exists
    let no_inv = mod_inverse(6, 9);
    assert(no_inv == -1);

    let no_inv_even = mod_inverse(4, 12);
    assert(no_inv_even == -1);

    // 6. Identity Base Case: gcd(a, 0) = a
    let res_zero = ext_gcd(42, 0);
    assert(res_zero["gcd"] == 42);
    assert(res_zero["x"] == 1);
    assert(res_zero["y"] == 0);

    return 0;
}
