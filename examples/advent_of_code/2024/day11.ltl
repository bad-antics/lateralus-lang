// Advent of Code 2024 · Day 11 · Plutonian Pebbles
// Each blink: 0 -> 1, even-digit stones split in half, others are multiplied by 2024.
// Part 1: number of stones after 25 blinks. Part 2: after 75 blinks.

let SAMPLE = "125 17"

// Stone order never matters, and the same engraved numbers repeat constantly,
// so track a map of number -> how many stones carry it. That keeps each blink
// proportional to the number of *distinct* values (a few thousand) instead of
// the total stone count (hundreds of trillions by blink 75).

fn add_count(counts: map, stone: int, n: int) {
    if contains(counts, stone) {
        counts[stone] = counts[stone] + n
    } else {
        counts[stone] = n
    }
}

fn blink(counts: map) -> map {
    let next = {}
    for stone in keys(counts) {
        let n = counts[stone]
        if stone == 0 {
            add_count(next, 1, n)
        } else {
            let digits = str(stone)
            let width = len(digits)
            if imod(width, 2) == 0 {
                let half = idiv(width, 2)
                add_count(next, int(slice(digits, 0, half)), n)
                add_count(next, int(slice(digits, half, width)), n)
            } else {
                add_count(next, stone * 2024, n)
            }
        }
    }
    return next
}

fn stones_after(text: str, blinks: int) -> int {
    let counts = {}
    for word in str_split(str_trim(text), " ") {
        if len(word) > 0 {
            add_count(counts, int(word), 1)
        }
    }
    for i in range(0, blinks) {
        counts = blink(counts)
    }
    return sum(values(counts))
}

fn part1(text: str) -> int {
    return stones_after(text, 25)
}

fn part2(text: str) -> int {
    return stones_after(text, 75)
}

@test
fn test_sample_six_blinks() {
    // The puzzle walks through the example: 22 stones after 6 blinks.
    assert_eq(stones_after(SAMPLE, 6), 22)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 55312)
}

@test
fn test_sample_part2() {
    // No official answer for part 2; value from an independent reference solution.
    assert_eq(part2(SAMPLE), 65601038650482)
}

fn main() {
    print("Day 11 Part 1: " + str(part1(SAMPLE)))
    print("Day 11 Part 2: " + str(part2(SAMPLE)))
}

main()
