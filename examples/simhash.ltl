// SimHash near-duplicate detection.
// Run with the stdlib/xxhash.ltl and stdlib/simhash.ltl modules loaded.

fn main() {
    let original = "The quick brown fox jumps over the lazy dog"
    let copy = "THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG"
    let unrelated = "completely unrelated matrix algebra text here"

    let original_fp = fingerprint(original)
    let copy_fp = fingerprint(copy)
    let unrelated_fp = fingerprint(unrelated)

    print("original:  " + str(original_fp))
    print("copy:      " + str(copy_fp))
    print("unrelated: " + str(unrelated_fp))
    print("copy distance: " + str(hamming(original_fp, copy_fp)))
    print("unrelated distance: " + str(hamming(original_fp, unrelated_fp)))
    print("near duplicate: " + str(near_duplicate(original, copy, 3)))
}

main()
