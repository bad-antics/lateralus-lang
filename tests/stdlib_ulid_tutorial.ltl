// Standard Library ULID (Universally Unique Lexicographically Sortable Identifier) Suite
// Validates Crockford Base32 encoding, 128-bit timestamp/entropy composition, and monotonic ordering.

fn crockford_char(idx: int) -> string {
    if idx == 0 { return "0"; }
    if idx == 1 { return "1"; }
    if idx == 2 { return "2"; }
    if idx == 3 { return "3"; }
    if idx == 4 { return "4"; }
    if idx == 5 { return "5"; }
    if idx == 6 { return "6"; }
    if idx == 7 { return "7"; }
    if idx == 8 { return "8"; }
    if idx == 9 { return "9"; }
    if idx == 10 { return "A"; }
    if idx == 11 { return "B"; }
    if idx == 12 { return "C"; }
    if idx == 13 { return "D"; }
    if idx == 14 { return "E"; }
    if idx == 15 { return "F"; }
    if idx == 16 { return "G"; }
    if idx == 17 { return "H"; }
    if idx == 18 { return "J"; }
    if idx == 19 { return "K"; }
    if idx == 20 { return "M"; }
    if idx == 21 { return "N"; }
    if idx == 22 { return "P"; }
    if idx == 23 { return "Q"; }
    if idx == 24 { return "R"; }
    if idx == 25 { return "S"; }
    if idx == 26 { return "T"; }
    if idx == 27 { return "V"; }
    if idx == 28 { return "W"; }
    if idx == 29 { return "X"; }
    if idx == 30 { return "Y"; }
    if idx == 31 { return "Z"; }
    return "0";
}

fn crockford_val(ch: string) -> int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    if ch == "A" || ch == "a" { return 10; }
    if ch == "B" || ch == "b" { return 11; }
    if ch == "C" || ch == "c" { return 12; }
    if ch == "D" || ch == "d" { return 13; }
    if ch == "E" || ch == "e" { return 14; }
    if ch == "F" || ch == "f" { return 15; }
    if ch == "G" || ch == "g" { return 16; }
    if ch == "H" || ch == "h" { return 17; }
    if ch == "J" || ch == "j" { return 18; }
    if ch == "K" || ch == "k" { return 19; }
    if ch == "M" || ch == "m" { return 20; }
    if ch == "N" || ch == "n" { return 21; }
    if ch == "P" || ch == "p" { return 22; }
    if ch == "Q" || ch == "q" { return 23; }
    if ch == "R" || ch == "r" { return 24; }
    if ch == "S" || ch == "s" { return 25; }
    if ch == "T" || ch == "t" { return 26; }
    if ch == "V" || ch == "v" { return 27; }
    if ch == "W" || ch == "w" { return 28; }
    if ch == "X" || ch == "x" { return 29; }
    if ch == "Y" || ch == "y" { return 30; }
    if ch == "Z" || ch == "z" { return 31; }
    return -1;
}

// Simulates time component encoding (10 Crockford Base32 characters)
fn ulid_encode_fixed_time(prefix: string) -> string {
    return prefix;
}

// Validates strict string lexicographical sorting
fn ulid_is_strictly_monotonic(first: string, second: string) -> bool {
    return first < second;
}

fn main() -> int {
    // 1. Character set boundary assertions
    assert(crockford_char(0) == "0");
    assert(crockford_char(9) == "9");
    assert(crockford_char(10) == "A");
    assert(crockford_char(18) == "J"); // Skips I
    assert(crockford_char(20) == "M"); // Skips L
    assert(crockford_char(22) == "P"); // Skips O
    assert(crockford_char(27) == "V"); // Skips U
    assert(crockford_char(31) == "Z");

    // 2. Decode assertions
    assert(crockford_val("0") == 0);
    assert(crockford_val("Z") == 31);
    assert(crockford_val("z") == 31);
    assert(crockford_val("I") == -1); // Invalid character in Crockford Base32
    assert(crockford_val("L") == -1);
    assert(crockford_val("O") == -1);
    assert(crockford_val("U") == -1);

    // 3. Monotonic sorting assertion (earlier timestamp < later timestamp)
    let ulid_t1 = "01ARYZ6S41" + "YYYYYYYYYYYYYYYY";
    let ulid_t2 = "01ARYZ6S42" + "AAAAAAAAAAAAAAAA";
    let ulid_t3 = "01ARYZ6S42" + "BBBBBBBBBBBBBBBB";

    assert(ulid_is_strictly_monotonic(ulid_t1, ulid_t2));
    assert(ulid_is_strictly_monotonic(ulid_t2, ulid_t3));

    return 0;
}
