// ===================================================================
// examples/argon2_tutorial.ltl
// Interactive walkthrough of stdlib/argon2 RFC 9106 hashing
// ===================================================================

import stdlib.argon2

fn run() {
    println("=== RFC 9106 Argon2id Password Hashing Tutorial ===")

    // 1. Loading Profiles
    println("\n[1] Parameter Profiles:")
    let p_int = profile_interactive()
    println("Interactive profile memory: " + str(p_int["m"]) + " KiB, time: " + str(p_int["t"]) + ", lanes: " + str(p_int["p"]))

    let p_sens = profile_sensitive()
    println("Sensitive profile memory:   " + str(p_sens["m"]) + " KiB, time: " + str(p_sens["t"]) + ", lanes: " + str(p_sens["p"]))

    // 2. Hashing a Password
    println("\n[2] Hashing Password:")
    let password = "CorrectHorseBatteryStaple!"
    let phc = hash(password, p_int)
    println("Generated PHC string: " + phc)

    // 3. Verifying Credentials
    println("\n[3] Verifying Password:")
    let match_correct = verify(password, phc)
    let match_wrong = verify("WrongPassword123!", phc)
    println("Valid password check: " + str(match_correct))
    println("Wrong password check: " + str(match_wrong))

    // 4. Policy Rehash Inspection
    println("\n[4] Rehash Policy Evaluation:")
    let needs_upgrade = needs_rehash(phc, p_sens)
    println("Needs upgrade to sensitive profile: " + str(needs_upgrade))

    println("\n=== Argon2id Walkthrough Completed Successfully ===")
}

run()
