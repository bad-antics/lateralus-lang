// Advent of Code 2024 · Day 19 · Linen Layout
// Towel patterns (comma-separated); designs (one per line).
// Part 1: count designs that can be formed from patterns.
// Part 2: count total distinct ways to form each design; sum all.

let SAMPLE = "r, wr, b, g, bwu, rb, gb, br

brwrr
bggr
gbbr
rrbgwb
ubwu
bbrgwb
bwurrg
brgr
bbrgwb"

fn parse_input(text: str) -> list {
    let parts = str_split(text, "\n\n")
    let pattern_line = str_trim(parts[0])
    let toks = str_split(pattern_line, ", ")
    let patterns = []
    let i = 0
    while i < len(toks) {
        let p = str_trim(toks[i])
        if len(p) > 0 { patterns = patterns + [p] }
        i = i + 1
    }
    let design_lines = str_split(str_trim(parts[1]), "\n")
    let designs = []
    let j = 0
    while j < len(design_lines) {
        let d = str_trim(design_lines[j])
        if len(d) > 0 { designs = designs + [d] }
        j = j + 1
    }
    return [patterns, designs]
}

let WAYS_CACHE = {}

fn count_ways(design: str, patterns: list) -> int {
    if contains(WAYS_CACHE, design) { return WAYS_CACHE[design] }
    if len(design) == 0 { return 1 }
    let total = 0
    let i = 0
    while i < len(patterns) {
        let p = patterns[i]
        let plen = len(p)
        if plen <= len(design) && slice(design, 0, plen) == p {
            total = total + count_ways(slice(design, plen, len(design)), patterns)
        }
        i = i + 1
    }
    WAYS_CACHE[design] = total
    return total
}

fn part1(text: str) -> int {
    let parsed = parse_input(text)
    let patterns = parsed[0]
    let designs = parsed[1]
    let count = 0
    let i = 0
    while i < len(designs) {
        if count_ways(designs[i], patterns) > 0 { count = count + 1 }
        i = i + 1
    }
    return count
}

fn part2(text: str) -> int {
    let parsed = parse_input(text)
    let patterns = parsed[0]
    let designs = parsed[1]
    let total = 0
    let i = 0
    while i < len(designs) {
        total = total + count_ways(designs[i], patterns)
        i = i + 1
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 6)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 16)
}

fn main() {
    print("Day 19 Part 1: " + str(part1(SAMPLE)))
    print("Day 19 Part 2: " + str(part2(SAMPLE)))
}

main()
