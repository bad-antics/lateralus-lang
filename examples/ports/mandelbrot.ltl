// Mandelbrot escape-time renderer — Lateralus port of examples/ports/mandelbrot.py.
// Idiomatic ~50-line Python -> Lateralus for the recurring port bounty.
// Prints one escape-iteration count per pixel, row-major, matching the
// Python reference byte-for-byte. 400x200 viewport, max 1000 iterations.

fn escape_iterations(cx: float, cy: float) -> int {
    let mut zx = 0.0
    let mut zy = 0.0
    let mut i = 0
    while i < 1000 {
        if zx * zx + zy * zy > 4.0 {
            return i
        }
        let nzx = zx * zx - zy * zy + cx
        let nzy = 2.0 * zx * zy + cy
        zx = nzx
        zy = nzy
        i = i + 1
    }
    return i
}

fn main() {
    let mut row = 0
    while row < 200 {
        let cy = (row * 1.0 / 199.0) * 2.0 - 1.0
        let mut col = 0
        while col < 400 {
            let cx = (col * 1.0 / 399.0) * 3.5 - 2.5
            println(escape_iterations(cx, cy))
            col = col + 1
        }
        row = row + 1
    }
}

main()
