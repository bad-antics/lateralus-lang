// Rosetta Code · Happy numbers · Lateralus

fn digit_square_sum(n: int) -> int {
    let x = n
    let total = 0
    while x > 0 {
        let d = x % 10
        total = total + d * d
        x = idiv(x, 10)
    }
    return total
}

fn is_happy(n: int) -> bool {
    let seen = []
    let x = n
    while x != 1 {
        if contains(seen, x) { return false }
        seen = seen + [x]
        x = digit_square_sum(x)
    }
    return true
}

fn main() {
    let found = []
    let i = 1
    while len(found) < 8 {
        if is_happy(i) { found = found + [i] }
        i = i + 1
    }
    assert_eq(found, [1, 7, 10, 13, 19, 23, 28, 31], "first 8 happy")
    print("first 8 happy numbers: " + str(found))
}

main()
