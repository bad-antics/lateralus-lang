// Run with: python scripts/run_levenshtein_tutorial.py
// The runner prepends the actual stdlib/levenshtein.ltl source.

// Compatibility shim: the Python backend does not yet provide char_at.
fn char_at(text: str, index: int) -> str {
    return slice(text, index, index + 1)
}

fn main() {
    // Pinned vector: kitten -> sitten -> sittin -> sitting (three edits).
    assert_eq(distance("kitten", "sitting"), 3)
    assert_eq(distance("sitting", "kitten"), 3)
    assert_eq(distance("", "abc"), 3)
    assert_eq(distance("abc", ""), 3)
    assert_eq(distance("", ""), 0)
    assert_eq(distance("same", "same"), 0)
    assert_eq(distance("flaw", "lawn"), 2)
    assert_eq(bounded("kitten", "sitting", 3), 3)
    assert_true(bounded("kitten", "sitting", 2) > 2)
    assert_eq(bounded("cat", "cat", 0), 0)
    assert_true(bounded("cat", "cut", 0) > 0)
    assert_eq(distance("ca", "ac"), 2)
    assert_eq(damerau("ca", "ac"), 1)
    // This implementation is restricted Damerau (optimal string alignment).
    assert_eq(damerau("CA", "ABC"), 3)
    assert_eq(similarity("", ""), 1.0)
    assert_eq(similarity("abc", "abc"), 1.0)
    assert_eq(similarity("", "abc"), 0.0)
    assert_true(abs(similarity("kitten", "sitting") - 4.0 / 7.0) < 0.000001)
    print("18 pinned checks passed")

    // Suggest candidates within two ordinary edits of the user's input.
    let query = "aple"
    let candidates = ["apple", "maple", "apply", "banana"]
    let limit = 2
    let i = 0
    print("Suggestions for aple (at most 2 edits):")
    while i < len(candidates) {
        let candidate = candidates[i]
        let edits = bounded(query, candidate, limit)
        if edits <= limit {
            print(candidate + ": " + str(edits))
        }
        i = i + 1
    }
}

main()
