// ===================================================================
// Lateralus Example: stdlib.queue — Work Queue with Urgent Jobs
// -------------------------------------------------------------------
// Demonstrates priority scheduling with a double-ended queue:
// - Standard tasks are appended to the back (FIFO order)
// - Urgent tasks jump to the front of the line
// - Workers consume tasks from the front
// ===================================================================

import queue

fn main() {
    println("=== Work Queue with Priority Jobs ===")

    // Initialize an empty job queue
    let q = new()

    // Enqueue routine batch jobs
    println("[+] Enqueuing routine batch tasks...")
    q = push_back(q, "JOB-101: generate invoices")
    q = push_back(q, "JOB-102: database vacuum")

    // An urgent security event arrives
    println("[!] Urgent event detected! Injecting to front of queue...")
    q = push_front(q, "URGENT-999: hotfix zero-day vulnerability")

    // Another normal job arrives
    q = push_back(q, "JOB-103: send marketing newsletter")

    println("Current queue size: " + str(size(q)))
    println("Next task up: " + str(front(q)))

    // Worker processing loop
    println("\n--- Starting Worker Execution ---")
    let processed = []
    while !is_empty(q) {
        let step = pop_front(q)
        let job = step[0]
        q = step[1]
        processed = processed + [job]
        println("  -> Processed: " + str(job))
    }

    println("\nTotal jobs completed: " + str(len(processed)))
    println("Queue empty check: " + str(is_empty(q)))
}

main()
