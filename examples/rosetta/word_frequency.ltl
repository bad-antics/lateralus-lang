// Rosetta Code: Word frequency — count words in a sentence
fn split_words(text: str) -> list {
    let mut out = []
    let mut cur = ""
    for ch in text {
        if ch == " " {
            if len(cur) > 0 { out = out + [cur]; cur = "" }
        } else { cur = cur + ch }
    }
    if len(cur) > 0 { out = out + [cur] }
    return out
}

let text = "the quick brown fox jumps over the lazy dog the fox"
let words = split_words(text)
let mut the_count = 0
let mut fox_count = 0
for w in words {
    if w == "the" { the_count = the_count + 1 }
    if w == "fox" { fox_count = fox_count + 1 }
}
println("words: " + str(len(words)))
println("the = " + str(the_count) + ", fox = " + str(fox_count))
if the_count == 3 && fox_count == 2 && len(words) == 11 { println("OK") } else { println("FAIL") }
