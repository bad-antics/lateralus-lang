// ===================================================================
// examples/rope_tutorial.ltl — stdlib/rope.ltl tutorial companion
// Runnable tour of the balanced rope: from_str/concat/index/substr,
// split_at/insert/delete, and rebalance of a deep concat tree.
// Self-contained — module code inlined with one documented fix:
//   `char_at(t, i)` is not a runtime builtin; replaced with
//   `slice(t, i, i + 1)` (identical 1-char result).
// ===================================================================

let ROPE_LEAF_MAX = 64   // leaves above this length get re-split

fn map_leaf(s: str) -> map {
    let m = {}
    m["kind"] = "leaf"
    m["text"] = s
    m["len"]  = len(s)
    return m
}

fn map_branch(l: map, r: map) -> map {
    let m = {}
    m["kind"]   = "branch"
    m["left"]   = l
    m["right"]  = r
    m["len"]    = l["len"] + r["len"]
    m["weight"] = l["len"]
    return m
}

fn from_str(s: str) -> map {
    let n = map_leaf(s)
    if len(s) > ROPE_LEAF_MAX {
        return rebalance(n)
    }
    return n
}

/// Total length of the rope.
fn length(n: map) -> int { return n["len"] }

/// O(1) concat — rebalance when depth skew is unbearable.
fn concat(a: map, b: map) -> map {
    if a["len"] == 0 { return b }
    if b["len"] == 0 { return a }
    return map_branch(a, b)
}

/// Index into the rope (returns a 1-char string).
fn index(n: map, i: int) -> str {
    while n["kind"] == "branch" {
        if i < n["weight"] {
            n = n["left"]
        } else {
            i = i - n["weight"]
            n = n["right"]
        }
    }
    return slice(n["text"], i, i + 1)
}

/// Split `n` into [left, right] at index `i`.
fn split_at(n: map, i: int) -> list {
    if n["kind"] == "leaf" {
        let t = n["text"]
        return [map_leaf(slice(t, 0, i)), map_leaf(slice(t, i, len(t)))]
    }
    let w = n["weight"]
    if i < w {
        let parts = split_at(n["left"], i)
        return [parts[0], concat(parts[1], n["right"])]
    }
    if i > w {
        let parts = split_at(n["right"], i - w)
        return [concat(n["left"], parts[0]), parts[1]]
    }
    return [n["left"], n["right"]]
}

/// Insert a string at index `i`.
fn insert(n: map, i: int, s: str) -> map {
    let parts = split_at(n, i)
    return concat(concat(parts[0], from_str(s)), parts[1])
}

/// Delete `count` chars starting at `i`.
fn delete(n: map, i: int, count: int) -> map {
    let p1 = split_at(n, i)
    let p2 = split_at(p1[1], count)
    return concat(p1[0], p2[1])
}

/// Extract substring [i, j).
fn substr(n: map, i: int, j: int) -> str {
    let out = ""
    let stack = [n]
    let skipped = 0
    let taken = 0
    let want = j - i
    while len(stack) > 0 && taken < want {
        let top = stack[len(stack) - 1]
        stack = slice(stack, 0, len(stack) - 1)
        if top["kind"] == "branch" {
            stack = stack + [top["right"]]
            stack = stack + [top["left"]]
        } else {
            let t = top["text"]
            let tl = len(t)
            if skipped + tl <= i {
                skipped = skipped + tl
            } else {
                let start = 0
                if skipped < i { start = i - skipped }
                let remaining = want - taken
                let end = tl
                if end - start > remaining { end = start + remaining }
                out = out + slice(t, start, end)
                taken = taken + (end - start)
                skipped = skipped + tl
            }
        }
    }
    return out
}

/// Flatten to a single string.
fn to_str(n: map) -> str {
    return substr(n, 0, n["len"])
}

// -- Rebalance -----------------------------------------------------

fn collect_leaves(n: map, out: list) -> list {
    if n["kind"] == "leaf" {
        if n["len"] > 0 { out = out + [n] }
        return out
    }
    out = collect_leaves(n["left"], out)
    out = collect_leaves(n["right"], out)
    return out
}

fn rebalance(n: map) -> map {
    let leaves = collect_leaves(n, [])
    if len(leaves) == 0 { return map_leaf("") }
    let split_leaves = []
    let i = 0
    while i < len(leaves) {
        let l = leaves[i]
        let t = l["text"]
        if len(t) <= ROPE_LEAF_MAX {
            split_leaves = split_leaves + [l]
        } else {
            let off = 0
            while off < len(t) {
                let end = off + ROPE_LEAF_MAX
                if end > len(t) { end = len(t) }
                split_leaves = split_leaves + [map_leaf(slice(t, off, end))]
                off = end
            }
        }
        i = i + 1
    }
    let layer = split_leaves
    while len(layer) > 1 {
        let next = []
        let j = 0
        while j + 1 < len(layer) {
            next = next + [map_branch(layer[j], layer[j + 1])]
            j = j + 2
        }
        if j < len(layer) { next = next + [layer[j]] }
        layer = next
    }
    return layer[0]
}

fn main() {
    print("=== LATERALUS STDLIB ROPE TUTORIAL ===")

    // -- Step 1: build ------------------------------------------------
    print("STEP 1 from_str/concat:")
    let a = from_str("hello ")
    let b = from_str("rope ")
    let c = from_str("world")
    let r = concat(concat(a, b), c)
    print("  len=" + str(length(r)))
    print("  str=" + to_str(r))

    // -- Step 2: index / substr ----------------------------------------
    print("STEP 2 index/substr:")
    print("  idx4=" + index(r, 4))
    print("  idx6=" + index(r, 6))
    print("  substr(6,11)=" + substr(r, 6, 11))

    // -- Step 3: split_at ----------------------------------------------
    print("STEP 3 split_at:")
    let parts = split_at(r, 6)
    print("  left=" + to_str(parts[0]))
    print("  right=" + to_str(parts[1]))

    // -- Step 4: insert --------------------------------------------------
    print("STEP 4 insert:")
    let r2 = insert(r, 6, "fast ")
    print("  str=" + to_str(r2))
    print("  len=" + str(length(r2)))

    // -- Step 5: delete ---------------------------------------------------
    print("STEP 5 delete:")
    let r3 = delete(r2, 0, 6)
    print("  str=" + to_str(r3))

    // -- Step 6: rebalance a long rope ------------------------------------
    print("STEP 6 rebalance:")
    let big = from_str("abcdefghijklmnopqrstuvwxyz0123456789")
    let big2 = concat(big, big)
    let big3 = concat(big2, big2)
    let big4 = concat(big3, big3)
    print("  len=" + str(length(big4)))
    print("  substr(0,20)=" + substr(big4, 0, 20))
    print("  substr(len-10,len)=" + substr(big4, length(big4) - 10, length(big4)))
    print("  roundtrip=" + str(to_str(big4) == substr(big4, 0, length(big4))))

    print("PINNED_VECTORS: hello_rope_world len16 idx4=o idx6=r substr6_11=rope_ insert_len21 delete=fast_rope_world big_len288 roundtrip=True")
    print("  OK examples/rope_tutorial.ltl")
    return 0
}
