// ===================================================================
// examples/dinic_tutorial.ltl
// -------------------------------------------------------------------
// Demonstration of Dinic's Blocking Flow Algorithm in Lateralus.
//
// Real-World Applications:
// 1. Telecom Backbone Network: Maximal packet data throughput between data centers.
// 2. Supply Chain & Logistics: Air cargo flight payload throughput through regional hubs.
// 3. Cloud Computing: Dynamic network bandwidth slicing across VM tenants.
// ===================================================================

fn min_val(a, b) {
    if a < b {
        return a
    }
    return b
}

fn init_2d_matrix(n, val) {
    let mtx = dict()
    let i = 0
    while i < n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = val
            j = j + 1
        }
        mtx[i] = row
        i = i + 1
    }
    return mtx
}

fn init_adj(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

pub fn create_flow_network(n) {
    let net = dict()
    net["n"] = n
    net["res"] = init_2d_matrix(n, 0)
    net["adj"] = init_adj(n)
    return net
}

pub fn add_capacity(net, u, v, cap) {
    let res = net["res"]
    let adj = net["adj"]

    res[u][v] = res[u][v] + cap

    let neighbors_u = adj[u]
    adj[u] = push(neighbors_u, v)

    let neighbors_v = adj[v]
    adj[v] = push(neighbors_v, u)
}

fn bfs_level_graph(net, s, t, level) {
    let n = net["n"]
    let res = net["res"]
    let adj = net["adj"]

    let i = 0
    while i < n {
        level[i] = -1
        i = i + 1
    }

    level[s] = 0
    let queue = [s]
    let q_head = 0

    while q_head < len(queue) {
        let u = queue[q_head]
        q_head = q_head + 1

        let neighbors = adj[u]
        let k = 0
        while k < len(neighbors) {
            let v = neighbors[k]
            if level[v] == -1 and res[u][v] > 0 {
                level[v] = level[u] + 1
                queue = push(queue, v)
            }
            k = k + 1
        }
    }

    return level[t] != -1
}

fn send_blocking_flow(net, u, flow_in, t, level) {
    if u == t {
        return flow_in
    }

    let res = net["res"]
    let adj = net["adj"]
    let neighbors = adj[u]
    let k = 0

    while k < len(neighbors) {
        let v = neighbors[k]
        if level[v] == level[u] + 1 and res[u][v] > 0 {
            let curr_cap = min_val(flow_in, res[u][v])
            let pushed = send_blocking_flow(net, v, curr_cap, t, level)

            if pushed > 0 {
                res[u][v] = res[u][v] - pushed
                res[v][u] = res[v][u] + pushed
                return pushed
            }
        }
        k = k + 1
    }

    return 0
}

pub fn dinic_max_flow(net, s, t) {
    let total_flow = 0
    let level = dict()
    let inf_flow = 1000000000

    while bfs_level_graph(net, s, t, level) {
        while true {
            let pushed = send_blocking_flow(net, s, inf_flow, t, level)
            if pushed <= 0 {
                break
            }
            total_flow = total_flow + pushed
        }
    }

    return total_flow
}

pub fn main() {
    print("=================================================================")
    print("   Lateralus Standard Library: Dinic Airline Cargo Flow Demo     ")
    print("=================================================================")

    // Logistics Hub Topology:
    // 0: Origin Central Warehouse
    // 1: Transit Hub North
    // 2: Transit Hub South
    // 3: Intermediate Sorting Gateway
    // 4: Destination Air Freight Terminal
    let net = create_flow_network(5)

    add_capacity(net, 0, 1, 100)  // Origin -> North Hub: 100 tons/day
    add_capacity(net, 0, 2, 70)   // Origin -> South Hub: 70 tons/day
    add_capacity(net, 1, 2, 30)   // Cross-link North -> South: 30 tons/day
    add_capacity(net, 1, 3, 80)   // North -> Gateway: 80 tons/day
    add_capacity(net, 2, 3, 50)   // South -> Gateway: 50 tons/day
    add_capacity(net, 1, 4, 40)   // Direct Flight North -> Destination: 40 tons/day
    add_capacity(net, 3, 4, 110)  // Gateway -> Destination: 110 tons/day

    print("Air freight routing topology initialized across 5 regional hubs.")

    let max_throughput = dinic_max_flow(net, 0, 4)

    print("Maximal Daily Cargo Throughput: " + str(max_throughput) + " tons/day")
    print("Dinic's blocking flow algorithm executed with O(V^2 E) efficiency.")
}
