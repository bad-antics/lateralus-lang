// ===================================================================
// tests/stdlib_units_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for stdlib/units.ltl: SI base scaling, derived
// dimensional exponent algebra (N, J, Pa, W), and affine temperature.
// ===================================================================

pub fn make_qty(val, dim_l, dim_m, dim_t) {
    let q = dict()
    q["val"] = val
    q["L"] = dim_l
    q["M"] = dim_m
    q["T"] = dim_t
    return q
}

pub fn dims_match(a, b) {
    if (a["L"] == b["L"]) && (a["M"] == b["M"]) && (a["T"] == b["T"]) {
        return 1
    }
    return 0
}

pub fn qty_add(a, b) {
    assert(dims_match(a, b) == 1, "Dimensional homogeneity required for addition")
    return make_qty(a["val"] + b["val"], a["L"], a["M"], a["T"])
}

pub fn qty_mul(a, b) {
    return make_qty(a["val"] * b["val"], a["L"] + b["L"], a["M"] + b["M"], a["T"] + b["T"])
}

pub fn qty_div(a, b) {
    return make_qty(a["val"] / b["val"], a["L"] - b["L"], a["M"] - b["M"], a["T"] - b["T"])
}

pub fn celsius_to_kelvin_centi(c_deg) {
    return (c_deg * 100) + 27315
}

pub fn test_derived_mechanics_dimensions() {
    let m = make_qty(15, 0, 1, 0)
    let a = make_qty(4, 1, 0, -2)
    let f = qty_mul(m, a)
    assert(f["val"] == 60 && f["L"] == 1 && f["M"] == 1 && f["T"] == -2, "60 N Force")

    let area = make_qty(12, 2, 0, 0)
    let pressure = qty_div(f, area)
    assert(pressure["val"] == 5 && pressure["L"] == -1 && pressure["M"] == 1 && pressure["T"] == -2, "5 Pa Pressure")
}

pub fn test_homogeneous_addition_and_temperature() {
    let d1 = make_qty(1000, 1, 0, 0)
    let d2 = make_qty(250, 1, 0, 0)
    let d_sum = qty_add(d1, d2)
    assert(d_sum["val"] == 1250 && d_sum["L"] == 1, "1000m + 250m == 1250m")

    assert(celsius_to_kelvin_centi(0) == 27315, "0 C == 273.15 K")
    assert(celsius_to_kelvin_centi(100) == 37315, "100 C == 373.15 K")
}

pub fn main() {
    test_derived_mechanics_dimensions()
    test_homogeneous_addition_and_temperature()
    print("All stdlib/units.ltl verification tests passed!")
}
