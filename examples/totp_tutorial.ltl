// RFC 6238 TOTP tutorial example in Lateralus.

import totp

fn main() {
    // 20-byte shared secret (RFC 4226 test vector: "12345678901234567890")
    let secret = bytes_of("12345678901234567890")
    let fixed_time = 1234567890
    let step = 30
    let digits = 6

    println("=== Lateralus stdlib/totp Tutorial ===")

    // 1. Generate 6-digit TOTP code for timestamp 1234567890
    let code = totp_totp(secret, fixed_time, step, digits, "sha1")
    println("Generated 6-digit TOTP code: " + code)

    // 2. Verify exact match (drift = 0)
    let is_valid_now = totp_verify(secret, code, fixed_time, step, digits, 0, "sha1")
    println("Verification (exact time):   " + str(is_valid_now))

    // 3. Verify with +30s clock drift allowed (drift = 1)
    let is_valid_drift = totp_verify(secret, code, fixed_time + 30, step, digits, 1, "sha1")
    println("Verification (+30s drift):   " + str(is_valid_drift))

    // 4. Generate Google Authenticator provisioning URI
    let uri = totp_otpauth_uri("alice@example.com", secret, "AcmeCorp", digits, step, "SHA1")
    println("Provisioning URI:            " + uri)
}
