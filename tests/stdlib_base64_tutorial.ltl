// Official test vectors for stdlib/base64 tutorial (RFC 4648 Section 10).

import base64

pub fn test_rfc4648_test_vectors() -> bool {
    // RFC 4648 Section 10 canonical test suite
    if base64_encode("") != "" { return false }
    if base64_encode("f") != "Zg==" { return false }
    if base64_encode("fo") != "Zm8=" { return false }
    if base64_encode("foo") != "Zm9v" { return false }
    if base64_encode("foob") != "Zm9vYg==" { return false }
    if base64_encode("fooba") != "Zm9vYmE=" { return false }
    if base64_encode("foobar") != "Zm9vYmFy" { return false }

    // Roundtrip decoding
    if base64_decode("") != "" { return false }
    if base64_decode("Zg==") != "f" { return false }
    if base64_decode("Zm8=") != "fo" { return false }
    if base64_decode("Zm9v") != "foo" { return false }
    if base64_decode("Zm9vYg==") != "foob" { return false }
    if base64_decode("Zm9vYmE=") != "fooba" { return false }
    if base64_decode("Zm9vYmFy") != "foobar" { return false }

    return true
}

pub fn test_base64_url_safe_variant() -> bool {
    // String whose standard encoding contains + and /
    // e.g. bytes 0xfb, 0xff -> '++/' in standard base64
    let input = chr(251) + chr(239) + chr(254)
    let std = base64_encode(input)
    let url = base64_encode_url(input)

    // Decoded URL-safe must restore original bytes
    let restored = base64_decode_url(url)
    if restored != input { return false }

    return true
}

pub fn test_base64_length_and_validity() -> bool {
    // Length calculators
    if base64_encoded_length(0) != 0 { return false }
    if base64_encoded_length(1) != 4 { return false }
    if base64_encoded_length(3) != 4 { return false }
    if base64_encoded_length(4) != 8 { return false }

    if base64_decoded_length("Zm9v") != 3 { return false }
    if base64_decoded_length("Zm9vYg==") != 4 { return false }
    if base64_decoded_length("Zm9vYmE=") != 5 { return false }

    // Validity checking
    if not base64_is_valid("Zm9v") { return false }
    if not base64_is_valid("Zm9vYg==") { return false }
    if base64_is_valid("abc") { return false }       // not multiple of 4
    if base64_is_valid("Zm9v!@#$") { return false } // invalid characters

    return true
}
