// Rosetta Code: Reverse a string (and reverse words order)
fn rev(s: str) -> str {
    let mut out = ""
    let mut i = len(s) - 1
    while i >= 0 { out = out + s[i]; i = i - 1 }
    return out
}
let s = "lateralus"
println(rev(s))
if rev(s) == "sularetal" && rev("") == "" { println("OK") } else { println("FAIL") }
