// ===================================================================
// examples/parquet_tutorial.ltl — stdlib/parquet.ltl tutorial companion
// Runnable tour of the Parquet file-format helpers: magic/footer
// framing, footer-pointer parsing, Thrift compact-protocol integer
// primitives (zigzag + uvarint), and the data-page-v1 header fields.
// Self-contained — module code inlined; bytes_of(s) replaced by a
// local ASCII shim (the module only uses it for thrift_string).
// Full Thrift FileMetaData encoding is OUT of scope, matching module.
// ===================================================================

const PARQUET_MAGIC = [0x50, 0x41, 0x52, 0x31]   // "PAR1"

fn s2b(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        out = out + [ord(s[i])]
        i = i + 1
    }
    return out
}

// -- encoding / compression / type constants -------------------------

fn enc_plain()           -> int { return 0 }
fn enc_plain_dict()      -> int { return 2 }
fn enc_rle()             -> int { return 3 }
fn enc_bit_packed()      -> int { return 4 }
fn enc_delta_bin_packed()-> int { return 5 }
fn enc_delta_byte_array()-> int { return 6 }
fn enc_delta_length_ba() -> int { return 7 }
fn enc_rle_dictionary()  -> int { return 8 }

fn comp_uncompressed() -> int { return 0 }
fn comp_snappy()       -> int { return 1 }
fn comp_gzip()         -> int { return 2 }
fn comp_lzo()          -> int { return 3 }
fn comp_brotli()       -> int { return 4 }
fn comp_lz4()          -> int { return 5 }
fn comp_zstd()         -> int { return 6 }

fn type_boolean()    -> int { return 0 }
fn type_int32()      -> int { return 1 }
fn type_int64()      -> int { return 2 }
fn type_float()      -> int { return 4 }
fn type_double()     -> int { return 5 }
fn type_byte_array() -> int { return 6 }
fn type_fixed_len_byte_array() -> int { return 7 }

// -- file framing ------------------------------------------------------

fn magic() -> list { return PARQUET_MAGIC }

fn enc_i32_le(v: int) -> list {
    if v < 0 { v = v + 0x100000000 }
    return [v & 0xff, (v >> 8) & 0xff, (v >> 16) & 0xff, (v >> 24) & 0xff]
}

fn assemble_file(body: list, footer: list) -> list {
    return PARQUET_MAGIC + body + footer
         + enc_i32_le(len(footer)) + PARQUET_MAGIC
}

fn parse_footer_pointer(buf: list) -> map {
    let n = len(buf)
    if n < 12 { return nil }
    if buf[n-4] != 0x50 || buf[n-3] != 0x41
       || buf[n-2] != 0x52 || buf[n-1] != 0x31 { return nil }
    let flen = buf[n-8] | (buf[n-7] << 8) | (buf[n-6] << 16) | (buf[n-5] << 24)
    if n < 12 + flen { return nil }
    let m = {}
    m["footer_len"]    = flen
    m["footer_offset"] = n - 8 - flen
    return m
}

// -- Thrift compact protocol -------------------------------------------

fn thrift_zz_i32(v: int) -> int {
    return ((v << 1) ^ (v >> 31)) & 0xffffffff
}

fn thrift_zz_i64(v: int) -> int {
    return ((v << 1) ^ (v >> 63)) & 0xffffffffffffffff
}

fn thrift_uvarint(v: int) -> list {
    let out = []
    let go = true
    while go {
        let b = v & 0x7f
        v = v >> 7
        if v > 0 { b = b | 0x80 } else { go = false }
        out = out + [b]
    }
    return out
}

fn thrift_varint_i32(v: int) -> list {
    return thrift_uvarint(thrift_zz_i32(v))
}

fn thrift_varint_i64(v: int) -> list {
    return thrift_uvarint(thrift_zz_i64(v))
}

fn thrift_binary(b: list) -> list {
    return thrift_uvarint(len(b)) + b
}

fn thrift_string(s: str) -> list {
    return thrift_binary(s2b(s))
}

fn data_page_v1_header(num_values: int, encoding: int,
                        def_level_enc: int, rep_level_enc: int) -> map {
    let h = {}
    h["num_values"]                = num_values
    h["encoding"]                  = encoding
    h["definition_level_encoding"] = def_level_enc
    h["repetition_level_encoding"] = rep_level_enc
    return h
}

// ===================================================================

fn list_str(xs: list) -> str {
    let out = "["
    let i = 0
    while i < len(xs) {
        if i > 0 { out = out + "," }
        out = out + str(xs[i])
        i = i + 1
    }
    return out + "]"
}

fn main() {
    print("=== LATERALUS STDLIB PARQUET TUTORIAL ===")

    // -- Step 1: codec constants --------------------------------------
    print("STEP 1 encoding/compression/type constants:")
    print("  enc_plain=" + str(enc_plain()) + " enc_rle=" + str(enc_rle())
        + " enc_rle_dict=" + str(enc_rle_dictionary()))
    print("  comp_uncompressed=" + str(comp_uncompressed())
        + " comp_snappy=" + str(comp_snappy()) + " comp_zstd=" + str(comp_zstd()))
    print("  type_int64=" + str(type_int64()) + " type_byte_array="
        + str(type_byte_array()) + " type_fixed_len_byte_array="
        + str(type_fixed_len_byte_array()))

    // -- Step 2: file framing ------------------------------------------
    print("STEP 2 assemble + parse a Parquet file envelope:")
    let body = [1, 2, 3, 4, 5]          // pretend column-chunk bytes
    let footer = [9, 9, 9]              // pretend FileMetaData bytes
    let file = assemble_file(body, footer)
    print("  magic=" + list_str(magic()))
    print("  file_len=" + str(len(file)) + " expect=" + str(4 + 5 + 3 + 4 + 4))
    let fp = parse_footer_pointer(file)
    print("  footer_len=" + str(fp["footer_len"]))
    print("  footer_offset=" + str(fp["footer_offset"]))
    print("  roundtrip=" + str(fp["footer_offset"] == 9))
    let bad = file + [0]
    print("  bad_magic_rejected=" + str(parse_footer_pointer(bad) == nil))

    // -- Step 3: footer length i32 LE ----------------------------------
    print("STEP 3 little-endian footer length bytes:")
    print("  len3=" + list_str(enc_i32_le(3)))
    print("  len300=" + list_str(enc_i32_le(300)))

    // -- Step 4: Thrift zigzag + uvarint -------------------------------
    print("STEP 4 Thrift compact integer primitives:")
    print("  zz_i32(1)=" + str(thrift_zz_i32(1)) + " zz_i32(-1)="
        + str(thrift_zz_i32(0 - 1)) + " zz_i32(64)=" + str(thrift_zz_i32(64)))
    print("  uvarint(0)=" + list_str(thrift_uvarint(0)))
    print("  uvarint(127)=" + list_str(thrift_uvarint(127)))
    print("  uvarint(300)=" + list_str(thrift_uvarint(300)))
    print("  varint_i32(-2)=" + list_str(thrift_varint_i32(0 - 2)))
    print("  varint_i32(150)=" + list_str(thrift_varint_i32(150)))

    // -- Step 5: binary/string + page header ----------------------------
    print("STEP 5 thrift_binary / thrift_string / page header:")
    print("  binary[3]=" + list_str(thrift_binary([65, 66, 67])))
    print("  string_ab=" + list_str(thrift_string("ab")))
    let h = data_page_v1_header(1000, enc_plain_dict(), enc_rle(), enc_bit_packed())
    print("  page num_values=" + str(h["num_values"])
        + " enc=" + str(h["encoding"])
        + " def_enc=" + str(h["definition_level_encoding"])
        + " rep_enc=" + str(h["repetition_level_encoding"]))

    print("PINNED_VECTORS: magic=80,65,82,49 file_len=20 "
        + "footer_len=3 footer_off=9 zz1=2 zzneg1=1 "
        + "uv300=172,2 varint150=172,2 varintneg2=3 "
        + "binABC=3,65,66,67 strab=2,97,98 page=1000,2,3,4")
    print("  ✓ examples/parquet_tutorial.ltl: OK")
    return 0
}
