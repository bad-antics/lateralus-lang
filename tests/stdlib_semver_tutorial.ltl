// Pinned test vectors for stdlib/semver.ltl
import semver

@test
fn test_semver_parse_and_format() {
    let v = parse("v1.2.3-beta.1+build.42")
    assert(major(v) == 1)
    assert(minor(v) == 2)
    assert(patch(v) == 3)
    assert(prerelease(v) == "beta.1")
    assert(build_meta(v) == "build.42")
    assert(is_prerelease(v))
    assert(to_string(v) == "1.2.3-beta.1+build.42")
}

@test
fn test_semver_compare_and_ranges() {
    let pre = parse("1.2.3-beta.1+build.42")
    let stable = parse("1.2.3")
    let next_minor = parse("1.3.0")

    assert(compare(pre, stable) == -1)
    assert(eq(parse("1.2.3+a"), parse("1.2.3+b")))
    assert(to_string(bump_minor(stable)) == "1.3.0")
    assert(to_string(bump_major(stable)) == "2.0.0")
    assert(satisfies_caret(next_minor, 1, 2))
    assert(!satisfies_tilde(next_minor, 1, 2))
}
