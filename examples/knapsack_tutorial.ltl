// Lateralus Standard Library Example: 0/1 Knapsack Dynamic Programming
// Demonstrates discrete optimization for blockchain mempool block packing and resource scheduling.

fn knapsack_01(weights: list, values: list, capacity: int) -> dict {
    let n = len(weights);
    let mut dp = [];
    let mut i = 0;
    while i <= n {
        let mut row = [];
        let mut w = 0;
        while w <= capacity {
            row = row + [0];
            w = w + 1;
        }
        dp = dp + [row];
        i = i + 1;
    }

    let mut item = 1;
    while item <= n {
        let wt = weights[item - 1];
        let val = values[item - 1];
        let mut cap = 0;
        while cap <= capacity {
            if wt <= cap {
                let without_item = dp[item - 1][cap];
                let with_item = dp[item - 1][cap - wt] + val;
                if with_item > without_item {
                    dp[item][cap] = with_item;
                } else {
                    dp[item][cap] = without_item;
                }
            } else {
                dp[item][cap] = dp[item - 1][cap];
            }
            cap = cap + 1;
        }
        item = item + 1;
    }

    let max_val = dp[n][capacity];

    let mut selected = [];
    let mut curr_w = capacity;
    let mut k = n;
    while k > 0 {
        if dp[k][curr_w] != dp[k - 1][curr_w] {
            selected = [k - 1] + selected;
            curr_w = curr_w - weights[k - 1];
        }
        k = k - 1;
    }

    let mut result = {};
    result["max_value"] = max_val;
    result["selected"] = selected;
    return result;
}

fn main() -> int {
    println("=== 0/1 Knapsack Block Packing Example ===");

    // Simulated mempool transactions:
    // Gas/Bytes cost: [200, 300, 450, 100, 250]
    // Priority fees ($): [40, 70, 120, 25, 60]
    // Block gas capacity limit: 600
    let tx_costs = [200, 300, 450, 100, 250];
    let tx_fees = [40, 70, 120, 25, 60];
    let block_limit = 600;

    let solution = knapsack_01(tx_costs, tx_fees, block_limit);
    let max_fee = solution["max_value"];
    let selected_txs = solution["selected"];

    println("Maximum fee revenue for block:");
    println(max_fee);

    println("Selected transaction indices included in block:");
    let mut i = 0;
    while i < len(selected_txs) {
        println(selected_txs[i]);
        i = i + 1;
    }

    println("0/1 Knapsack optimization completed successfully.");
    return 0;
}
