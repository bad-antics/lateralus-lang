module stdlib/smtp

import stdlib/string

pub fn parse_line(s: str) -> [int, str, bool] {
    if len(s) < 3 {
        return [0, s, false]
    }
    let code_res = try_int(slice(s, 0, 3))
    if !code_res.ok {
        return [0, s, false]
    }
    let code = code_res.value
    
    if len(s) >= 4 {
        let sep = slice(s, 3, 4)
        let rest = slice(s, 4, len(s))
        if sep == " " {
            return [code, rest, false]
        } else if sep == "-" {
            return [code, rest, true]
        }
    }
    
    return [code, "", false]
}

fn validate_safe_param(s: str) -> bool {
    let i = 0
    while i < len(s) {
        let c = slice(s, i, i + 1)
        if c == "\r" || c == "\n" || c == "\0" || c == ">" {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn cmd_ehlo(host: str) -> str {
    if !validate_safe_param(host) {
        return ""
    }
    return "EHLO " + host + "\r\n"
}

pub fn cmd_mail_from(addr: str) -> str {
    if !validate_safe_param(addr) {
        return ""
    }
    return "MAIL FROM:<" + addr + ">\r\n"
}

pub fn cmd_rcpt_to(addr: str) -> str {
    if !validate_safe_param(addr) {
        return ""
    }
    return "RCPT TO:<" + addr + ">\r\n"
}

pub fn cmd_data() -> str {
    return "DATA\r\n"
}

pub fn cmd_quit() -> str {
    return "QUIT\r\n"
}

pub fn encode_body(body: str) -> str {
    let clean_body = body
    if string.ends_with(body, "\r\n") {
        clean_body = slice(body, 0, len(body) - 2)
    } else if string.ends_with(body, "\n") {
        clean_body = slice(body, 0, len(body) - 1)
    }

    if len(clean_body) == 0 {
        return ".\r\n"
    }

    let lines = string.split(clean_body, "\n")
    let out = []
    let i = 0
    while i < len(lines) {
        let line = lines[i]
        if string.ends_with(line, "\r") {
            line = slice(line, 0, len(line) - 1)
        }
        if len(line) > 0 && slice(line, 0, 1) == "." {
            line = "." + line
        }
        out = push(out, line)
        i = i + 1
    }
    
    return string.join(out, "\r\n") + "\r\n.\r\n"
}