// ===================================================================
// examples/xxhash_tutorial.ltl — xxHash64 and FNV-1a Hashing Tutorial
// ===================================================================
// Demonstrates high-performance non-cryptographic hashing with
// stdlib.xxhash for in-memory hash tables, cache keys, and deduplication.
// ===================================================================

import stdlib.xxhash

fn main() {
    print("=== Lateralus stdlib.xxhash Tutorial ===")

    // 1. Canonical Empty Input Vector
    let h_empty = xxhash.hash64([], 0)
    print("Empty buffer hash (seed=0):", xxhash.hex64(h_empty))

    // 2. Short Input Hashing
    let short_str = "lateralus"
    let h_short = xxhash.hash64_str(short_str, 0)
    print("Hash of 'lateralus' (seed=0):", xxhash.hex64(h_short))

    // 3. Seed Sensitivity (Avalanche effect on seed variation)
    let h_seed0 = xxhash.hash64_str("partition_key", 0)
    let h_seed1 = xxhash.hash64_str("partition_key", 1)
    let h_seed42 = xxhash.hash64_str("partition_key", 42)
    print("Seed 0 :", xxhash.hex64(h_seed0))
    print("Seed 1 :", xxhash.hex64(h_seed1))
    print("Seed 42:", xxhash.hex64(h_seed42))

    // 4. Multi-stripe buffer hashing (64 bytes = two 32-byte stripe rounds)
    let buf64 = []
    let i = 0
    while i < 64 {
        buf64 = buf64 + [i]
        i = i + 1
    }
    let h_multi = xxhash.hash64(buf64, 0)
    print("Multi-stripe 64-byte buffer hash:", xxhash.hex64(h_multi))

    // 5. Lightweight FNV-1a 64-bit comparison for micro-keys
    let fnv_empty = xxhash.fnv1a_64([])
    let fnv_key = xxhash.fnv1a_64_str("user:1024")
    print("FNV-1a empty offset basis:", xxhash.hex64(fnv_empty))
    print("FNV-1a hash of 'user:1024':", xxhash.hex64(fnv_key))

    print("xxHash and FNV-1a tutorial execution complete.")
}

main()
