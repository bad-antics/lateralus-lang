// Advent of Code 2024 · Day 4 · Ceres Search
// Part 1: count every XMAS in a word search (all 8 directions, overlaps allowed).
// Part 2: count X-shaped MAS pairs — two diagonal MAS words crossing on an A.

let SAMPLE = "MMMSXXMASM
MSAMXMSMSA
AMXSXMAAMM
MSAMASMSMX
XMASAMXAMM
XXAMMXXAMA
SMSMSASXSS
SAXAMASAAA
MAMMMXMMMM
MXMXAXMASX"

fn parse(text: str) -> list {
    let grid = []
    for line in str_split(text, "\n") {
        let row = str_trim(line)
        if len(row) > 0 { grid.append(row) }
    }
    return grid
}

// Character at (r, c), or "" when off the grid.
fn at(grid: list, r: int, c: int) -> str {
    if r < 0 || r >= len(grid) || c < 0 || c >= len(grid[r]) { return "" }
    return grid[r][c]
}

fn part1(text: str) -> int {
    let grid = parse(text)
    let word = "XMAS"
    let count = 0
    for r in range(0, len(grid)) {
        for c in range(0, len(grid[r])) {
            if grid[r][c] != "X" { continue }
            // try all 8 directions from every X
            for dr in [-1, 0, 1] {
                for dc in [-1, 0, 1] {
                    if dr == 0 && dc == 0 { continue }
                    let k = 1
                    while k < 4 && at(grid, r + k * dr, c + k * dc) == word[k] {
                        k = k + 1
                    }
                    if k == 4 { count = count + 1 }
                }
            }
        }
    }
    return count
}

// A diagonal through an A reads MAS (either way) when its ends are M and S.
fn is_ms(a: str, b: str) -> bool {
    return (a == "M" && b == "S") || (a == "S" && b == "M")
}

fn part2(text: str) -> int {
    let grid = parse(text)
    let count = 0
    for r in range(1, len(grid) - 1) {
        for c in range(1, len(grid[r]) - 1) {
            if grid[r][c] != "A" { continue }
            let diag1 = is_ms(grid[r - 1][c - 1], grid[r + 1][c + 1])
            let diag2 = is_ms(grid[r - 1][c + 1], grid[r + 1][c - 1])
            if diag1 && diag2 { count = count + 1 }
        }
    }
    return count
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 18)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 9)
}

fn main() {
    print("Day 4 Part 1: " + str(part1(SAMPLE)))
    print("Day 4 Part 2: " + str(part2(SAMPLE)))
}

main()
