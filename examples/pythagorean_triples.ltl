-- Perimeter-bounded Pythagorean triple counter.
-- Port of a Python reference using Euclid's formula.
--
-- count_triples(limit) returns the number of integer right triangles
-- (a < b < c, a^2 + b^2 = c^2) with perimeter a + b + c <= limit (inclusive).
--
-- Python reference:
--
--   from math import gcd
--   def count_triples(limit):
--       count = 0
--       m = 2
--       while 2 * m * (m + 1) <= limit:
--           for n in range(1, m):
--               if (m - n) % 2 == 1 and gcd(m, n) == 1:
--                   p = 2 * m * (m + n)
--                   if p <= limit:
--                       count += limit // p
--           m += 1
--       return count

fn gcd(a: int, b: int) -> int {
    let x = a
    let y = b
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    return x
}

fn count_triples(limit: int) -> int {
    let count = 0
    let m = 2
    -- smallest primitive perimeter for a given m is 2*m*(m+1) (n = 1)
    while 2 * m * (m + 1) <= limit {
        let n = 1
        while n < m {
            if (m - n) % 2 == 1 {
                if gcd(m, n) == 1 {
                    let p = 2 * m * (m + n)
                    if p <= limit {
                        count = count + limit / p
                    }
                }
            }
            n = n + 1
        }
        m = m + 1
    }
    return count
}

-- Independent brute-force implementation used to cross-check small cases.
fn count_triples_brute(limit: int) -> int {
    let count = 0
    let a = 1
    while a < limit {
        let b = a + 1
        while a + b < limit {
            let s = a * a + b * b
            let c = 0
            -- integer square root by linear search bounded by perimeter
            let cc = b + 1
            while a + b + cc <= limit {
                if cc * cc == s {
                    c = cc
                }
                cc = cc + 1
            }
            if c > 0 {
                count = count + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    return count
}

fn check(limit: int, expected: int) -> bool {
    let fast = count_triples(limit)
    let slow = count_triples_brute(limit)
    let ok = fast == expected and slow == expected
    if ok {
        println("PASS limit={limit} -> {fast}")
    } else {
        println("FAIL limit={limit}: fast={fast} brute={slow} expected={expected}")
    }
    return ok
}

fn main() {
    let all_ok = true
    if not check(0, 0) { all_ok = false }
    if not check(11, 0) { all_ok = false }
    if not check(12, 1) { all_ok = false }
    if not check(24, 2) { all_ok = false }
    if not check(30, 3) { all_ok = false }
    if not check(40, 4) { all_ok = false }
    if not check(100, 17) { all_ok = false }

    -- Larger workload for native-vs-Python timing comparison.
    let big = 10000000
    println("count_triples({big}) = {count_triples(big)}")

    if all_ok {
        println("all checks passed")
    } else {
        println("some checks FAILED")
    }
}

main()