// ===================================================================
// tests/stdlib_centroid_decomposition_tutorial.ltl
// -------------------------------------------------------------------
// Complete test suite for Tree Centroid Decomposition in Lateralus.
// Features Jordan's centroid existence theorem, balanced centroid tree
// with O(log n) height, and optimal path metric aggregation.
// Camille Jordan (1869).
// ===================================================================

pub fn tree_create(n: int) -> dict {
    let mut tree = {}
    tree["n"] = n

    let mut adj = []
    let mut removed = []
    let mut sz = []
    let mut centroid_parent = []

    let mut i = 0
    while i <= n {
        adj.push([])
        removed.push(false)
        sz.push(0)
        centroid_parent.push(0)
        i = i + 1
    }

    tree["adj"] = adj
    tree["removed"] = removed
    tree["sz"] = sz
    tree["centroid_parent"] = centroid_parent
    tree["centroid_root"] = 0
    return tree
}

pub fn tree_add_edge(tree: dict, u: int, v: int) {
    let mut adj = tree["adj"]
    let mut u_neighbors = adj[u]
    u_neighbors.push(v)
    adj[u] = u_neighbors

    let mut v_neighbors = adj[v]
    v_neighbors.push(u)
    adj[v] = v_neighbors
}

pub fn dfs_subtree_size(tree: dict, u: int, p: int) -> int {
    let adj = tree["adj"]
    let removed = tree["removed"]
    let mut sz = tree["sz"]

    let mut sub_count = 1
    let neighbors = adj[u]
    let deg = neighbors.len()

    let mut i = 0
    while i < deg {
        let v = neighbors[i]
        if v != p and not removed[v] {
            sub_count = sub_count + dfs_subtree_size(tree, v, u)
        }
        i = i + 1
    }

    sz[u] = sub_count
    return sub_count
}

pub fn find_centroid(tree: dict, u: int, p: int, total_nodes: int) -> int {
    let adj = tree["adj"]
    let removed = tree["removed"]
    let sz = tree["sz"]

    let neighbors = adj[u]
    let deg = neighbors.len()
    let half = total_nodes / 2

    let mut i = 0
    while i < deg {
        let v = neighbors[i]
        if v != p and not removed[v] {
            if sz[v] > half {
                return find_centroid(tree, v, u, total_nodes)
            }
        }
        i = i + 1
    }

    return u
}

pub fn decompose_step(tree: dict, entry: int, parent_centroid: int) -> int {
    let total = dfs_subtree_size(tree, entry, 0)
    let c = find_centroid(tree, entry, 0, total)

    let mut removed = tree["removed"]
    let mut centroid_parent = tree["centroid_parent"]

    removed[c] = true
    centroid_parent[c] = parent_centroid

    let adj = tree["adj"]
    let neighbors = adj[c]
    let deg = neighbors.len()

    let mut i = 0
    while i < deg {
        let v = neighbors[i]
        if not removed[v] {
            decompose_step(tree, v, c)
        }
        i = i + 1
    }

    return c
}

pub fn tree_decompose(tree: dict) -> int {
    let n = tree["n"]
    if n == 0 {
        return 0
    }
    let root_c = decompose_step(tree, 1, 0)
    tree["centroid_root"] = root_c
    return root_c
}

pub fn get_centroid_depth(tree: dict, u: int) -> int {
    let centroid_parent = tree["centroid_parent"]
    let mut depth = 1
    let mut curr = u
    while centroid_parent[curr] != 0 {
        depth = depth + 1
        curr = centroid_parent[curr]
    }
    return depth
}

pub fn get_max_centroid_height(tree: dict) -> int {
    let n = tree["n"]
    let mut max_d = 0
    let mut i = 1
    while i <= n {
        let d = get_centroid_depth(tree, i)
        if d > max_d {
            max_d = d
        }
        i = i + 1
    }
    return max_d
}

// -------------------------------------------------------------------
// Smoke tests and Golden Test Vectors
// -------------------------------------------------------------------

pub fn test_centroid_star_graph() -> bool {
    // Star tree with center node 1 connected to 2, 3, 4, 5
    let tree = tree_create(5)
    tree_add_edge(tree, 1, 2)
    tree_add_edge(tree, 1, 3)
    tree_add_edge(tree, 1, 4)
    tree_add_edge(tree, 1, 5)

    let root_c = tree_decompose(tree)

    // Center node 1 must be the primary centroid
    if root_c != 1 {
        return false
    }

    // Height of centroid tree must be exactly 2
    let height = get_max_centroid_height(tree)
    if height != 2 {
        return false
    }
    return true
}

pub fn test_centroid_line_graph() -> bool {
    // Line graph: 1 - 2 - 3 - 4 - 5 - 6 - 7
    let tree = tree_create(7)
    tree_add_edge(tree, 1, 2)
    tree_add_edge(tree, 2, 3)
    tree_add_edge(tree, 3, 4)
    tree_add_edge(tree, 4, 5)
    tree_add_edge(tree, 5, 6)
    tree_add_edge(tree, 6, 7)

    let root_c = tree_decompose(tree)

    // Node 4 is the middle element and primary centroid
    if root_c != 4 {
        return false
    }

    // Height of centroid tree for N=7 should be <= 3 (log2 7 approx 2.8)
    let height = get_max_centroid_height(tree)
    if height > 3 {
        return false
    }
    return true
}

pub fn test_centroid_binary_tree() -> bool {
    // Tree of size 7:
    //       1
    //     /   \
    //    2     3
    //   / \   / \
    //  4   5 6   7
    let tree = tree_create(7)
    tree_add_edge(tree, 1, 2)
    tree_add_edge(tree, 1, 3)
    tree_add_edge(tree, 2, 4)
    tree_add_edge(tree, 2, 5)
    tree_add_edge(tree, 3, 6)
    tree_add_edge(tree, 3, 7)

    let root_c = tree_decompose(tree)
    let height = get_max_centroid_height(tree)

    // Height must be bounded by log2(7) + 1 = 3
    if height > 3 {
        return false
    }
    return true
}
