fn is_whitespace(s: string) -> bool {
    return s == " " || s == "\t" || s == "\r" || s == "\n"
}

fn strip_comment(l: string) -> string {
    let mut in_str: bool = false
    let mut qc: string = ""
    let mut i: int = 0
    let n: int = len(l)
    while i < n {
        let c: string = char_at(l, i)
        if in_str {
            if c == "\\" && i + 1 < n {
                i = i + 2
            } else if c == qc {
                in_str = false
                qc = ""
                i = i + 1
            } else {
                i = i + 1
            }
        } else {
            if c == "\"" || c == "'" {
                in_str = true
                qc = c
                i = i + 1
            } else if c == "#" {
                if i == 0 || is_whitespace(char_at(l, i - 1)) {
                    return trim(slice(l, 0, i))
                }
                i = i + 1
            } else {
                i = i + 1
            }
        }
    }
    return trim(l)
}

fn parse_block(s: string) -> any {
    let trimmed: string = trim(s)
    if trimmed == "" {
        return ""
    }
    if starts_with(trimmed, "- ") || trimmed == "-" {
        return parse_seq(trimmed)
    }
    if contains(trimmed, ":") && !starts_with(trimmed, "{") {
        return parse_map(trimmed)
    }
    return parse_scalar(trimmed)
}

fn parse_seq(s: string) -> list[any] {
    let trimmed: string = trim(s)
    let content: string = trimmed
    if starts_with(trimmed, "- ") {
        content = trim(slice(trimmed, 2, len(trimmed)))
    } else if trimmed == "-" {
        content = ""
    }
    let mut res: list[any] = []
    push(res, parse_block(content))
    return res
}