// Lateralus Standard Library Example: Topological Sort (Kahn's Algorithm)
// Demonstrates dependency graph resolution, task scheduling order, and cycle detection.

fn toposort(n: int, adj: dict) -> dict {
    let mut in_degree = [];
    let mut i = 0;
    while i < n {
        in_degree = in_degree + [0];
        i = i + 1;
    }

    let mut u = 0;
    while u < n {
        if contains(adj, u) {
            let targets = adj[u];
            let mut j = 0;
            while j < len(targets) {
                let v = targets[j];
                in_degree[v] = in_degree[v] + 1;
                j = j + 1;
            }
        }
        u = u + 1;
    }

    let mut queue = [];
    let mut q_head = 0;
    let mut k = 0;
    while k < n {
        if in_degree[k] == 0 {
            queue = queue + [k];
        }
        k = k + 1;
    }

    let mut order = [];
    while q_head < len(queue) {
        let curr = queue[q_head];
        q_head = q_head + 1;
        order = order + [curr];

        if contains(adj, curr) {
            let neighbors = adj[curr];
            let mut m = 0;
            while m < len(neighbors) {
                let nxt = neighbors[m];
                in_degree[nxt] = in_degree[nxt] - 1;
                if in_degree[nxt] == 0 {
                    queue = queue + [nxt];
                }
                m = m + 1;
            }
        }
    }

    let mut result = {};
    result["order"] = order;
    result["is_dag"] = (len(order) == n);
    return result;
}

fn main() -> int {
    println("=== Topological Sort (Kahn's Algorithm) Example ===");

    // Construct 6-stage compiler build dependency DAG:
    // 0: Lexer
    // 1: Parser (depends on Lexer)
    // 2: AST Builder (depends on Parser)
    // 3: Type Checker (depends on AST)
    // 4: Optimizer (depends on Type Checker)
    // 5: Linker / Binary Emitter (depends on Type Checker & Optimizer)
    let mut build_graph = {};
    build_graph[0] = [1];
    build_graph[1] = [2];
    build_graph[2] = [3];
    build_graph[3] = [4, 5];
    build_graph[4] = [5];

    let result = toposort(6, build_graph);
    let is_dag = result["is_dag"];
    let order = result["order"];

    if is_dag {
        println("Valid DAG detected! Execution schedule:");
        let mut idx = 0;
        while idx < len(order) {
            let task_id = order[idx];
            println(task_id);
            idx = idx + 1;
        }
    } else {
        println("Error: Cycle detected in task dependency graph!");
    }

    println("Topological sort execution completed successfully.");
    return 0;
}
