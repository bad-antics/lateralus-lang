// Standard Library Manacher's Algorithm Verification Suite
// Validates linear O(n) longest palindromic substring, even/odd palindrome normalization, and boundary handling.

fn manacher_preprocess(s: str) -> str {
    let n = len(s);
    if n == 0 {
        return "^$";
    }
    let mut res = "^";
    let mut i = 0;
    while i < n {
        res = res + "#" + slice(s, i, i + 1);
        i = i + 1;
    }
    res = res + "#$";
    return res;
}

fn longest_palindromic_substring(s: str) -> str {
    let n = len(s);
    if n <= 1 {
        return s;
    }

    let t = manacher_preprocess(s);
    let m = len(t);

    let mut p = [];
    let mut idx = 0;
    while idx < m {
        p = p + [0];
        idx = idx + 1;
    }

    let mut center = 0;
    let mut right = 0;

    let mut i = 1;
    while i < (m - 1) {
        let i_mirror = 2 * center - i;
        if right > i {
            let mirror_rad = p[i_mirror];
            let bound_rad = right - i;
            if mirror_rad < bound_rad {
                p[i] = mirror_rad;
            } else {
                p[i] = bound_rad;
            }
        } else {
            p[i] = 0;
        }

        while slice(t, i + 1 + p[i], i + 1 + p[i] + 1) == slice(t, i - 1 - p[i], i - 1 - p[i] + 1) {
            p[i] = p[i] + 1;
        }

        if (i + p[i]) > right {
            center = i;
            right = i + p[i];
        }

        i = i + 1;
    }

    let mut max_len = 0;
    let mut center_idx = 0;
    let mut k = 1;
    while k < (m - 1) {
        if p[k] > max_len {
            max_len = p[k];
            center_idx = k;
        }
        k = k + 1;
    }

    let start = (center_idx - max_len) >> 1;
    return slice(s, start, start + max_len);
}

fn main() -> int {
    // 1. Classical Odd-Length Palindrome
    let s1 = "racecar";
    let res1 = longest_palindromic_substring(s1);
    assert(res1 == "racecar");

    // 2. Odd-Length Palindrome Substring Inside Noise
    let s2 = "abacdfgdcaba";
    let res2 = longest_palindromic_substring(s2);
    assert(res2 == "aba");

    // 3. Classical Even-Length Palindrome
    let s3 = "forgeeksskeegfor";
    let res3 = longest_palindromic_substring(s3);
    assert(res3 == "geeksskeeg");

    // 4. Even-Length Palindrome Substring
    let s4 = "cbbd";
    let res4 = longest_palindromic_substring(s4);
    assert(res4 == "bb");

    // 5. Entirely Homogeneous Palindrome
    let s5 = "aaaaa";
    let res5 = longest_palindromic_substring(s5);
    assert(res5 == "aaaaa");

    // 6. No Palindrome Longer Than 1 Character
    let s6 = "abcdef";
    let res6 = longest_palindromic_substring(s6);
    assert(len(res6) == 1);

    // 7. Single Character Base Case
    let s7 = "x";
    let res7 = longest_palindromic_substring(s7);
    assert(res7 == "x");

    // 8. Empty String Base Case
    let s8 = "";
    let res8 = longest_palindromic_substring(s8);
    assert(res8 == "");

    return 0;
}
