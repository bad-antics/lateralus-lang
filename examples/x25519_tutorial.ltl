import stdlib.x25519

@test
fn alice_public_key() -> bool {
    let secret = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114,
                  81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42,
                  177, 119, 251, 165, 29, 185, 44, 42]
    let expected = [133, 32, 240, 9, 137, 48, 167, 84, 116, 139, 125, 220,
                    180, 62, 247, 90, 13, 191, 58, 13, 38, 56, 26, 244,
                    235, 164, 169, 142, 170, 155, 78, 106]
    return stdlib.x25519.derive_public(secret) == expected
}

@test
fn bob_public_key() -> bool {
    let secret = [93, 171, 8, 126, 98, 74, 138, 75, 121, 225, 127, 139,
                  131, 128, 14, 230, 111, 59, 177, 41, 38, 24, 182, 253,
                  28, 47, 139, 39, 255, 136, 224, 235]
    let expected = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97,
                    194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120,
                    103, 77, 173, 252, 126, 20, 111, 136, 43, 79]
    return stdlib.x25519.derive_public(secret) == expected
}

@test
fn shared_secret() -> bool {
    let alice_secret = [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193,
                        114, 81, 178, 102, 69, 223, 76, 47, 135, 235,
                        192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42]
    let bob_public = [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97,
                      194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120,
                      103, 77, 173, 252, 126, 20, 111, 136, 43, 79]
    let expected = [74, 93, 157, 91, 164, 206, 45, 225, 114, 142, 59, 244,
                    128, 53, 15, 37, 224, 126, 33, 201, 71, 209, 158, 51,
                    118, 240, 155, 60, 30, 22, 23, 66]
    return stdlib.x25519.scalar_mult(alice_secret, bob_public) == expected
}
