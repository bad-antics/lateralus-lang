// Advent of Code 2024 · Day 13 · Claw Contraption
// Part 1: fewest tokens (A costs 3, B costs 1) to win every winnable prize.
// Part 2: same, after adding 10000000000000 to every prize coordinate.

let SAMPLE = "Button A: X+94, Y+34
Button B: X+22, Y+67
Prize: X=8400, Y=5400

Button A: X+26, Y+66
Button B: X+67, Y+21
Prize: X=12748, Y=12176

Button A: X+17, Y+86
Button B: X+84, Y+37
Prize: X=7870, Y=6450

Button A: X+69, Y+23
Button B: X+27, Y+71
Prize: X=18641, Y=10279"

let PART2_OFFSET = 10000000000000

fn is_digit(c: str) -> bool {
    return c >= "0" && c <= "9"
}

// Every non-negative integer in the text, in order of appearance.
fn numbers(text: str) -> list {
    let out = []
    let cur = 0
    let in_num = false
    for ch in text {
        if is_digit(ch) {
            cur = cur * 10 + int(ch)
            in_num = true
        } else if in_num {
            out.append(cur)
            cur = 0
            in_num = false
        }
    }
    if in_num { out.append(cur) }
    return out
}

// Each machine is the 2x2 linear system
//     a*ax + b*bx = px
//     a*ay + b*by = py
// which has a unique solution whenever det = ax*by - ay*bx != 0 (true for
// every machine in the puzzle), so "fewest tokens" just means: solve it with
// Cramer's rule and keep it only if a and b are non-negative integers.
// Everything stays in exact integer arithmetic (idiv/imod), so the huge
// part 2 coordinates are no problem.
fn tokens(text: str, offset: int) -> int {
    let nums = numbers(text)
    let total = 0
    let i = 0
    while i + 5 < len(nums) {
        let ax = nums[i]
        let ay = nums[i + 1]
        let bx = nums[i + 2]
        let by = nums[i + 3]
        let px = nums[i + 4] + offset
        let py = nums[i + 5] + offset
        i = i + 6
        let det = ax * by - ay * bx
        if det == 0 { continue }
        let a_num = px * by - py * bx
        let b_num = ax * py - ay * px
        if imod(a_num, det) != 0 || imod(b_num, det) != 0 { continue }
        let a = idiv(a_num, det)
        let b = idiv(b_num, det)
        if a < 0 || b < 0 { continue }
        total = total + 3 * a + b
    }
    return total
}

fn part1(text: str) -> int {
    return tokens(text, 0)
}

fn part2(text: str) -> int {
    return tokens(text, PART2_OFFSET)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 480)
}

@test
fn test_sample_part2() {
    // No official answer for part 2 (only machines 2 and 4 are winnable);
    // value from an independent reference solution.
    assert_eq(part2(SAMPLE), 875318608908)
}

fn main() {
    print("Day 13 Part 1: " + str(part1(SAMPLE)))
    print("Day 13 Part 2: " + str(part2(SAMPLE)))
}

main()
