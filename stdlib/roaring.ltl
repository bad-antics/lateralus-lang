# stdlib/roaring.ltl
# Roaring Bitmap Tutorial: Matching Event IDs Across the 16-bit Boundary
#
# This tutorial demonstrates:
# - Creating bitmaps for event IDs spanning 65,536 (0 to 2^16)
# - Duplicate handling within and across the boundary
# - Membership checking that works correctly at chunk boundaries
#
# Run with: lateralus run stdlib/roaring.ltl

module roaring_demo {
  import roary from "stdlib/roaring"
  
  # Define expected results for membership checks
  def test_membership():
    # Create a bitmap covering both ends of the 16-bit range
    set_a = bit_set()
    set_b = bit_set()
    
    # IDs below boundary (0-50)
    for i in [0, 10, 20, 30, 40]:
      set_a.add(i)
    
    # IDs above boundary (65,536+), which wrap to the next chunk
    for i in [65536, 65546, 65550, 65560, 65570]:
      set_a.add(i)
    
    # Verify membership - should all be true
    assert set_a.contains(10) == true
    assert set_a.contains(30) == true
    assert set_a.contains(40) == true
    assert set_a.contains(65536) == true  # Just after boundary
    assert set_a.contains(65570) == true
    assert set_a.contains(65590) == false  # Not in set
    
    # Test cross-chunk union
    set_c = bit_set()
    for i in [1, 11, 21]:
      set_c.add(i)
    
    united = set_a.union(set_c)
    assert united.contains(10) == true
    assert united.contains(30) == true
    assert united.contains(11) == true
    assert united.contains(1) == true
    
    return "membership test passed"
  
  # Test duplicate handling - add same ID multiple times
  def test_duplicates():
    set_dup = bit_set()
    for _ in [1, 2, 3]:
      set_dup.add(42)
    assert set_dup.contains(42) == true
    
    # Add at boundary with duplicates
    for _ in [1, 2, 3]:
      set_dup.add(65535)  # Last ID of first chunk
    for _ in [1, 2, 3]:
      set_dup.add(65536)  # First ID of second chunk
    
    assert set_dup.contains(65535) == true
    assert set_dup.contains(65536) == true
    assert set_dup.size() == 4  # Just the 4 unique values
    
    return "duplicate handling test passed"
  
  # Test difference operations across boundary
  def test_difference():
    high_set = bit_set()
    low_set = bit_set()
    
    for i in [65536, 65540, 65545]:
      high_set.add(i)
    for i in [128, 256, 384]:
      low_set.add(i)
    
    diff = high_set.difference(low_set)
    assert diff.contains(65540) == true
    assert diff.contains(128) == false
    
    return "difference test passed"
  
  # Test intersection across boundary
  def test_intersection():
    set_x = bit_set()
    set_y = bit_set()
    
    for i in [0, 10, 20, 65536, 65546]:
      set_x.add(i)
    for i in [10, 20, 70, 65546]:
      set_y.add(i)
    
    intersection = set_x.intersection(set_y)
    assert intersection.contains(10) == true
    assert intersection.contains(20) == true
    assert intersection.contains(65546) == true
    assert intersection.contains(0) == false  # Only in x
    
    return "intersection test passed"
  
  # Test symmetric difference
  def test_symmetric_difference():
    set_p = bit_set()
    set_q = bit_set()
    
    for i in [100, 200, 65538]:
      set_p.add(i)
    for i in [100, 300, 65548]:
      set_q.add(i)
    
    sym_diff = set_p.symmetric_difference(set_q)
    assert sym_diff.contains(200) == true
    assert sym_diff.contains(300) == true
    assert sym_diff.contains(65538) == true
    assert sym_diff.contains(65548) == true
    assert sym_diff.contains(100) == false  # In both sets
    
    return "symmetric difference test passed"
  
  // Main entry point - run all tests
  fn main() -> str {
    let m = []str[]
    
    let r1 = test_membership()
    m.append(r1)
    
    let r2 = test_duplicates()
    m.append(r2)
    
    let r3 = test_difference()
    m.append(r3)
    
    let r4 = test_intersection()
    m.append(r4)
    
    let r5 = test_symmetric_difference()
    m.append(r5)
    
    // Return summary with all results
    return {
      "membership": r1,
      "duplicates": r2,
      "difference": r3,
      "intersection": r4,
      "symmetric_diff": r5,
      "status": "all_roaring_tests_passed"
    }
  }
}
