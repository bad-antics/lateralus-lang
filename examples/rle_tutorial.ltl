// Lateralus Standard Library Example: Run-Length Encoding (RLE) Pipeline
// Demonstrates run detection, compression metrics, string packing, and roundtrip decompression.

fn rle_encode(text: string) -> list {
    let mut runs = [];
    let n = len(text);
    if n == 0 {
        return runs;
    }

    let mut current_char = slice(text, 0, 1);
    let mut current_count = 1;
    let mut i = 1;

    while i < n {
        let ch = slice(text, i, i + 1);
        if ch == current_char {
            current_count = current_count + 1;
        } else {
            runs = runs + [[current_count, current_char]];
            current_char = ch;
            current_count = 1;
        }
        i = i + 1;
    }
    runs = runs + [[current_count, current_char]];
    return runs;
}

fn rle_decode(runs: list) -> string {
    let mut result = "";
    let mut i = 0;
    while i < len(runs) {
        let run = runs[i];
        let mut count = run[0];
        let ch = run[1];
        while count > 0 {
            result = result + ch;
            count = count - 1;
        }
        i = i + 1;
    }
    return result;
}

fn rle_to_compact_string(runs: list) -> string {
    let mut s = "";
    let mut i = 0;
    while i < len(runs) {
        let run = runs[i];
        s = s + str(run[0]) + run[1];
        i = i + 1;
    }
    return s;
}

fn main() -> int {
    println("=== Lateralus Run-Length Encoding (RLE) Pipeline Demo ===");

    let raw = "WWWWWWAAAAAABBBCCCD";
    println("Original Raw Payload: \"" + raw + "\" (" + str(len(raw)) + " characters)");

    let runs = rle_encode(raw);
    println("Computed Runs: " + str(runs));

    let packed = rle_to_compact_string(runs);
    println("Packed RLE Tokenstream: \"" + packed + "\" (" + str(len(packed)) + " characters)");
    assert(packed == "6W6A3B3C1D");

    let restored = rle_decode(runs);
    println("Decompressed Payload: \"" + restored + "\"");
    assert(restored == raw);

    println("\nRLE compression and lossless decompression verified 100% faithful!");
    return 0;
}