// Rosetta Code · Longest common subsequence · Lateralus
// https://rosettacode.org/wiki/Longest_common_subsequence
//
// Build the classic LCS length table, then walk back from the bottom-right
// corner to recover one longest subsequence. When both directions tie, the
// walk moves up (drops a character of `a`), which fixes which of several
// equally long answers is returned.

fn lcs_table(a: str, b: str) -> list {
    let n = len(a)
    let m = len(b)
    let t = []
    let i = 0
    while i <= n {
        let row = []
        let j = 0
        while j <= m {
            row = row + [0]
            j = j + 1
        }
        t = t + [row]
        i = i + 1
    }
    i = 1
    while i <= n {
        let j = 1
        while j <= m {
            if slice(a, i - 1, i) == slice(b, j - 1, j) {
                t[i][j] = t[i - 1][j - 1] + 1
            } else {
                t[i][j] = max(t[i - 1][j], t[i][j - 1])
            }
            j = j + 1
        }
        i = i + 1
    }
    return t
}

fn lcs(a: str, b: str) -> str {
    let t = lcs_table(a, b)
    let out = ""
    let i = len(a)
    let j = len(b)
    while i > 0 && j > 0 {
        let ca = slice(a, i - 1, i)
        if ca == slice(b, j - 1, j) {
            out = ca + out
            i = i - 1
            j = j - 1
        } else if t[i - 1][j] >= t[i][j - 1] {
            i = i - 1
        } else {
            j = j - 1
        }
    }
    return out
}

fn is_subsequence(sub: str, s: str) -> bool {
    let k = 0
    let i = 0
    while i < len(s) && k < len(sub) {
        if slice(s, i, i + 1) == slice(sub, k, k + 1) { k = k + 1 }
        i = i + 1
    }
    return k == len(sub)
}

fn main() {
    // Pairs from the Rosetta task plus the CLRS textbook example.
    let cases = [
        ["1234", "1224533324", "1234"],
        ["thisisatest", "testing123testing", "tsitest"],
        ["ABCBDAB", "BDCABA", "BCBA"],
        ["abc", "xyz", ""],
        ["", "abc", ""]
    ]
    let i = 0
    while i < len(cases) {
        let a = cases[i][0]
        let b = cases[i][1]
        let got = lcs(a, b)
        print("lcs(\"" + a + "\", \"" + b + "\") = \"" + got + "\"")
        assert_eq(got, cases[i][2])
        // Whatever we return must really be common to both inputs.
        assert_true(is_subsequence(got, a) && is_subsequence(got, b))
        i = i + 1
    }
}

main()
