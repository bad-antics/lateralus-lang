// Lateralus Standard Library Example: Circular Ring Buffer
// Demonstrates zero-allocation streaming FIFO queue with circular index wraparound.

fn rb_next(idx: int, capacity: int) -> int {
    return (idx + 1) % capacity;
}

fn main() -> int {
    println("=== Lateralus Ring Buffer (Circular FIFO) Demo ===");

    let cap = 5;
    let mut head = 0;
    let mut tail = 0;
    let mut count = 0;

    println("Ring buffer created with fixed capacity: 5");

    // Enqueue 5 packets
    let mut i = 1;
    while i <= 5 {
        tail = rb_next(tail, cap);
        count = count + 1;
        println("Enqueued packet " + str(i) + " | tail: " + str(tail) + " | count: " + str(count));
        i = i + 1;
    }

    assert(count == 5);
    assert(tail == 0); // Wraparound occurred!
    println("Buffer is full: count == 5, tail wrapped to 0");

    // Dequeue 3 packets
    let mut j = 1;
    while j <= 3 {
        head = rb_next(head, cap);
        count = count - 1;
        println("Dequeued packet | new head: " + str(head) + " | count: " + str(count));
        j = j + 1;
    }

    assert(head == 3);
    assert(count == 2);

    // Enqueue 2 new packets (exercising circular space)
    tail = rb_next(tail, cap); count = count + 1;
    println("Enqueued packet 6 | tail: " + str(tail) + " | count: " + str(count));

    tail = rb_next(tail, cap); count = count + 1;
    println("Enqueued packet 7 | tail: " + str(tail) + " | count: " + str(count));

    assert(tail == 2);
    assert(count == 4);

    println("Ring Buffer lifecycle verification complete: zero dynamic allocations!");
    return 0;
}
