// ===================================================================
// examples/majority_vote_tutorial.ltl
// -------------------------------------------------------------------
// Practical example demonstrating Boyer-Moore Majority Vote and
// Misra-Gries Heavy Hitters for Byzantine validator consensus voting.
// ===================================================================

pub fn majority_vote(nums) {
    let n = len(nums)
    if n == 0 {
        let res = dict()
        res["candidate"] = nil
        res["count"] = 0
        res["is_majority"] = false
        return res
    }

    let candidate = nums[0]
    let count = 0

    let i = 0
    while i < n {
        let x = nums[i]
        if count == 0 {
            candidate = x
            count = 1
        } else {
            if x == candidate {
                count = count + 1
            } else {
                count = count - 1
            }
        }
        i = i + 1
    }

    let actual_count = 0
    let j = 0
    while j < n {
        if nums[j] == candidate {
            actual_count = actual_count + 1
        }
        j = j + 1
    }

    let threshold = idiv(n, 2)
    let res = dict()
    res["candidate"] = candidate
    res["count"] = actual_count
    res["is_majority"] = (actual_count > threshold)

    return res
}

pub fn majority_two_thirds(nums) {
    let n = len(nums)
    if n == 0 {
        return []
    }

    let cand1 = nums[0]
    let cand2 = nums[0]
    let count1 = 0
    let count2 = 0

    let i = 0
    while i < n {
        let x = nums[i]
        if x == cand1 {
            count1 = count1 + 1
        } else {
            if x == cand2 {
                count2 = count2 + 1
            } else {
                if count1 == 0 {
                    cand1 = x
                    count1 = 1
                } else {
                    if count2 == 0 {
                        cand2 = x
                        count2 = 1
                    } else {
                        count1 = count1 - 1
                        count2 = count2 - 1
                    }
                }
            }
        }
        i = i + 1
    }

    let actual1 = 0
    let actual2 = 0
    let j = 0
    while j < n {
        if nums[j] == cand1 {
            actual1 = actual1 + 1
        } else {
            if nums[j] == cand2 {
                actual2 = actual2 + 1
            }
        }
        j = j + 1
    }

    let threshold = idiv(n, 3)
    let winners = []
    if actual1 > threshold {
        winners = push(winners, cand1)
    }
    if cand2 != cand1 and actual2 > threshold {
        winners = push(winners, cand2)
    }

    return winners
}

pub fn main() {
    print("=== Blockchain Byzantine Fault Tolerant (BFT) Validator Tally ===")
    print("Tallying validator votes for block proposal commit round...")

    // 7 active validators voting on proposal block root hashes:
    // 1001: Canonical valid block proposal
    // 2002: Sybil / fork proposal
    // 3003: Divergent fork proposal
    let validator_votes = [1001, 1001, 2002, 1001, 1001, 1001, 3003]

    let result = majority_vote(validator_votes)

    print("Strict Majority (>50%) Consensus Achieved:")
    print(result["is_majority"])

    print("Winning Block Proposal ID:")
    print(result["candidate"])

    print("Total Supporting Votes:")
    print(result["count"])

    let bft_heavy_hitters = majority_two_thirds(validator_votes)
    print("Supermajority Candidates (>n/3 Quorum):")
    print(bft_heavy_hitters)

    if result["is_majority"] and result["count"] >= 5 {
        print("Block Commit Finalized: 2/3+ Byzantine Supermajority Established!")
    }
}
