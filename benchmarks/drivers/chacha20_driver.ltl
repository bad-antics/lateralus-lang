
// ── benchmark driver: 1 MB ChaCha20 keystream XORed over 1 MB of data ──
// Calls block() directly instead of xor(): xor() appends one byte at a time
// (`out = out + [...]`), which is quadratic at megabyte scale.
let CC_BENCH_N = 1048576

fn hex_digit(v: int) -> str {
    let chars = "0123456789abcdef"
    return chars[v]
}

fn hex_byte(v: int) -> str {
    let out = ""
    let i = 1
    while i >= 0 {
        out = out + hex_digit((v >> (i * 4)) & 0xF)
        i = i - 1
    }
    return out
}

fn hex32(v: int) -> str {
    let out = ""
    let i = 7
    while i >= 0 {
        out = out + hex_digit((v >> (i * 4)) & 0xF)
        i = i - 1
    }
    return out
}

fn xs_next(s: int) -> int {
    let x = s & 0xFFFFFFFF
    x = (x ^ ((x << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF
    x = (x ^ (x >> 17)) & 0xFFFFFFFF
    x = (x ^ ((x << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF
    return x
}

fn gen_bytes(n: int, seed: int) -> list {
    let out = [0] * n
    let s = seed & 0xFFFFFFFF
    let i = 0
    while i < n {
        s = xs_next(s)
        out[i] = s & 0xFF
        if i + 1 < n { out[i + 1] = (s >> 8) & 0xFF }
        if i + 2 < n { out[i + 2] = (s >> 16) & 0xFF }
        if i + 3 < n { out[i + 3] = (s >> 24) & 0xFF }
        i = i + 4
    }
    return out
}

fn adler32(buf: list) -> int {
    let a = 1
    let b = 0
    let i = 0
    let n = len(buf)
    while i < n {
        a = (a + buf[i]) % 65521
        b = (b + a) % 65521
        i = i + 1
    }
    return ((b << 16) | a) & 0xFFFFFFFF
}

fn main() -> int {
    let n = CC_BENCH_N
    let data = gen_bytes(n, 0x0BADF00D)
    let key = [0] * 32
    let i = 0
    while i < 32 { key[i] = i; i = i + 1 }
    let nonce = [0] * 12
    i = 0
    while i < 12 { nonce[i] = i; i = i + 1 }

    let ct = [0] * n
    let off = 0
    let counter = 1
    while off < n {
        let ks = block(key, nonce, counter)
        let take = 64
        if n - off < 64 { take = n - off }
        let j = 0
        while j < take {
            ct[off + j] = data[off + j] ^ ks[j]
            j = j + 1
        }
        off = off + 64
        counter = counter + 1
    }

    let head = hex_byte(ct[0]) + hex_byte(ct[1]) + hex_byte(ct[2]) + hex_byte(ct[3])
             + hex_byte(ct[4]) + hex_byte(ct[5]) + hex_byte(ct[6]) + hex_byte(ct[7])
    println("chacha20 " + head + ":" + hex32(adler32(ct)))
    return 0
}
