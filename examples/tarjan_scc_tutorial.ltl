// ===================================================================
// examples/tarjan_scc_tutorial.ltl
// -------------------------------------------------------------------
// Practical example demonstrating Tarjan's Strongly Connected Components
// (SCC) algorithm for detecting circular module dependencies in microservice
// and compiler dependency graphs.
// ===================================================================

fn min_val(a, b) {
    if a < b {
        return a
    }
    return b
}

fn tarjan_dfs(u, adj, state) {
    state["timer"] = state["timer"] + 1
    state["dfn"][u] = state["timer"]
    state["low"][u] = state["timer"]
    state["stack"] = push(state["stack"], u)
    state["in_stack"][u] = true

    let neighbors = adj[u]
    let i = 0
    while i < len(neighbors) {
        let v = neighbors[i]
        if state["dfn"][v] == 0 {
            tarjan_dfs(v, adj, state)
            state["low"][u] = min_val(state["low"][u], state["low"][v])
        } else {
            if state["in_stack"][v] {
                state["low"][u] = min_val(state["low"][u], state["dfn"][v])
            }
        }
        i = i + 1
    }

    if state["low"][u] == state["dfn"][u] {
        let comp = []
        let done = false
        while not done {
            let top_idx = len(state["stack"]) - 1
            let w = state["stack"][top_idx]
            state["stack"] = slice(state["stack"], 0, top_idx)
            state["in_stack"][w] = false
            comp = push(comp, w)
            if w == u {
                done = true
            }
        }
        state["sccs"] = push(state["sccs"], comp)
    }
}

pub fn tarjan_scc(n, adj) {
    let state = dict()
    state["dfn"] = dict()
    state["low"] = dict()
    state["in_stack"] = dict()
    state["stack"] = []
    state["sccs"] = []
    state["timer"] = 0

    let i = 0
    while i < n {
        state["dfn"][i] = 0
        state["low"][i] = 0
        state["in_stack"][i] = false
        i = i + 1
    }

    let u = 0
    while u < n {
        if state["dfn"][u] == 0 {
            tarjan_dfs(u, adj, state)
        }
        u = u + 1
    }

    return state["sccs"]
}

pub fn main() {
    print("=== Tarjan's Strongly Connected Components (SCC) ===")
    print("Analyzing microservice architecture for cyclic dependency deadlocks...")

    // Service index mapping:
    // 0: api_gateway
    // 1: auth_service
    // 2: user_service (1 <-> 2 cycle)
    // 3: order_service
    // 4: payment_service (3 <-> 4 cycle)
    // 5: analytics_logger (leaf node)

    let adj = dict()
    adj[0] = [1, 3]       // gateway -> auth, order
    adj[1] = [2]          // auth -> user
    adj[2] = [1, 5]       // user -> auth (cycle!), analytics
    adj[3] = [4]          // order -> payment
    adj[4] = [3, 5]       // payment -> order (cycle!), analytics
    adj[5] = []           // analytics (terminal)

    let sccs = tarjan_scc(6, adj)

    print("Partitioned Components Count:")
    print(len(sccs))

    let i = 0
    while i < len(sccs) {
        let comp = sccs[i]
        let size = len(comp)
        if size > 1 {
            print("ALERT: Circular Dependency Cycle Detected in Component:")
            print(comp)
        } else {
            print("Acyclic Component:")
            print(comp)
        }
        i = i + 1
    }
}
