import stdlib.xxhash

fn main() {
    let data1 = "Lateralus"
    let data2 = "Lateralus"
    let data3 = "lateralus"

    let h1 = xxhash.hash64_str(data1, 0)
    let h2 = xxhash.hash64_str(data2, 0)
    let h3 = xxhash.hash64_str(data3, 0)

    println("Hash 1: {h1}")
    println("Hash 2: {h2}")
    println("Hash 3: {h3}")

    if h1 == h2 {
        println("Data 1 and 2 match.")
    }
    
    if h1 != h3 {
        println("Data 1 and 3 differ.")
    }
}