// Pinned test vectors for stdlib/toml tutorial (TOML 1.0).

import toml

pub fn test_toml_basic_types_and_comments() -> bool {
    let toml_str = "
# Global project configuration
name = \"lateralus_app\"
version = \"1.2.0\"
build_id = 42
debug = false
tags = [\"fast\", \"safe\", \"modern\"]
title = \"Release #1\" # trailing comment
"
    let doc = toml_parse(toml_str)

    if doc["name"] != "lateralus_app" { return false }
    if doc["version"] != "1.2.0" { return false }
    if doc["build_id"] != 42 { return false }
    if doc["debug"] != false { return false }
    if doc["title"] != "Release #1" { return false }

    let tags = doc["tags"]
    if len(tags) != 3 { return false }
    if tags[0] != "fast" || tags[1] != "safe" || tags[2] != "modern" { return false }

    return true
}

pub fn test_toml_nested_tables() -> bool {
    let toml_str = "
[server]
port = 8080
host = \"127.0.0.1\"

[database.connection]
pool_size = 10
timeout_ms = 5000
"
    let doc = toml_parse(toml_str)

    let srv = doc["server"]
    if srv["port"] != 8080 { return false }
    if srv["host"] != "127.0.0.1" { return false }

    let db = doc["database"]
    let conn = db["connection"]
    if conn["pool_size"] != 10 { return false }
    if conn["timeout_ms"] != 5000 { return false }

    return true
}

pub fn test_toml_array_of_tables() -> bool {
    let toml_str = "
[[items]]
id = 1
name = \"hammer\"

[[items]]
id = 2
name = \"wrench\"
"
    let doc = toml_parse(toml_str)
    let items = doc["items"]

    if len(items) != 2 { return false }

    let item0 = items[0]
    if item0["id"] != 1 || item0["name"] != "hammer" { return false }

    let item1 = items[1]
    if item1["id"] != 2 || item1["name"] != "wrench" { return false }

    return true
}
