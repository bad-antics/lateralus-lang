/* Rosetta Code: Base64 encode/decode in Lateralus */

module rosetta.base64;

fn encode(input: string) -> string {
    let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    let result = "";
    let i = 0;
    let len = input.length();
    while i < len {
        let b1 = input.byte_at(i);
        let b2 = if i + 1 < len { input.byte_at(i + 1) } else { 0 };
        let b3 = if i + 2 < len { input.byte_at(i + 2) } else { 0 };

        let triple = (b1 * 65536) + (b2 * 256) + b3;
        let idx1 = (triple / 262144) % 64;
        let idx2 = (triple / 4096) % 64;
        let idx3 = (triple / 64) % 64;
        let idx4 = triple % 64;

        result = result + chars.substring(idx1, idx1 + 1);
        result = result + chars.substring(idx2, idx2 + 1);
        result = result + if i + 1 < len { chars.substring(idx3, idx3 + 1) } else { "=" };
        result = result + if i + 2 < len { chars.substring(idx4, idx4 + 1) } else { "=" };

        i = i + 3;
    }
    return result;
}

fn main() {
    let test_str = "Lateralus";
    let encoded = encode(test_str);
    println("Base64(" + test_str + ") = " + encoded);
    assert(encoded == "TGF0ZXJhbHVz");
    println("Base64 Rosetta test passed.");
}
