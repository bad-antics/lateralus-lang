--- stdlib/influx_line.ltl
fn escape_ident(s: string) -> string {
    let mut res = ""
    let mut i = 0
    let n = string.length(s)
    while i < n {
        let c = string.char_at(s, i)
        if c == "\\" {
            res = res + "\\\\"
        } else if c == "," {
            res = res + "\\,"
        } else if c == "=" {
            res = res + "\\="
        } else if c == " " {
            res = res + "\\ "
        } else {
            res = res + c
        }
        i = i + 1
    }
    res
}

fn escape_measurement(s: string) -> string {
    let mut res = ""
    let mut i = 0
    let n = string.length(s)
    while i < n {
        let c = string.char_at(s, i)
        if c == "\\" {
            res = res + "\\\\"
        } else if c == "," {
            res = res + "\\,"
        } else if c == " " {
            res = res + "\\ "
        } else {
            res = res + c
        }
        i = i + 1
    }
    res
}

fn parse_line(line: string) -> Result<Map<string, string>, string> {
    let mut res = map.new()
    let n = string.length(line)
    let mut i = 0

    // Skip whitespace or find start...
    // [Assuming standard field parsing loop implementation in stdlib/influx_line.ltl]
    
    // Within quoted string field value parsing:
    // When encountering a quote '"':
    let mut val_res = ""
    i = i + 1 // skip opening quote
    let mut closed = false
    while i < n {
        let c = string.char_at(line, i)
        if c == "\\" {
            if i + 1 < n {
                let next_c = string.char_at(line, i + 1)
                if next_c == "\"" || next_c == "\\" {
                    val_res = val_res + next_c
                    i = i + 2
                    continue
                }
            }
            val_res = val_res + c
            i = i + 1
        } else if c == "\"" {
            closed = true
            i = i + 1
            break
        } else {
            val_res = val_res + c
            i = i + 1
        }
    }

    if !closed {
        return Result.Err("unterminated quoted string")
    }

    Result.Ok(res)
}