// =======================================================================
// LATERALUS Standard Library — spiral_wave.ltl
// Spiral matrix generation (Wave: stdlib.spiral)
//
// Builds an N×N matrix filled with 1..N*N in clockwise spiral order,
// starting from the top-left corner and spiralling inward.
//
// For N = 5 the resulting matrix is:
//    1  2  3  4  5
//   16 17 18 19  6
//   15 24 25 20  7
//   14 23 22 21  8
//   13 12 11 10  9
//
// Deterministic checksum (sum of value * (1 + row + col)) for N=5:
//   1665
// =======================================================================

// Build an n×n matrix of zeros.
fn spiral_zeros(n: int) -> list {
    let m = []
    for i in range(n) {
        let row = []
        for j in range(n) {
            row = row + [0]
        }
        m = m + [row]
    }
    return m
}

// Fill an n×n matrix with 1..n*n in clockwise spiral order.
fn spiral_build(n: int) -> list {
    let m = spiral_zeros(n)
    let top = 0
    let bottom = n - 1
    let left = 0
    let right = n - 1
    let val = 1

    while top <= bottom && left <= right {
        // left -> right along the top row
        let c = left
        while c <= right {
            m[top][c] = val
            val = val + 1
            c = c + 1
        }
        top = top + 1

        // top -> bottom down the right column
        let r = top
        while r <= bottom {
            m[r][right] = val
            val = val + 1
            r = r + 1
        }
        right = right - 1

        // right -> left along the bottom row
        if top <= bottom {
            let c2 = right
            while c2 >= left {
                m[bottom][c2] = val
                val = val + 1
                c2 = c2 - 1
            }
            bottom = bottom - 1
        }

        // bottom -> top up the left column
        if left <= right {
            let r2 = bottom
            while r2 >= top {
                m[r2][left] = val
                val = val + 1
                r2 = r2 - 1
            }
            left = left + 1
        }
    }

    return m
}

// Pretty-print a square matrix with aligned columns.
fn spiral_print(m: list) {
    let n = len(m)
    let i = 0
    while i < n {
        let line = ""
        let j = 0
        while j < n {
            let cell = m[i][j]
            let pad = ""
            if cell < 10 {
                pad = "  "
            } else {
                pad = " "
            }
            line = line + pad + str(cell)
            j = j + 1
        }
        println(line)
        i = i + 1
    }
}

// Deterministic weighted checksum: sum of value * (1 + row + col).
fn spiral_checksum(m: list) -> int {
    let n = len(m)
    let total = 0
    let i = 0
    while i < n {
        let j = 0
        while j < n {
            total = total + m[i][j] * (1 + i + j)
            j = j + 1
        }
        i = i + 1
    }
    return total
}

fn main() {
    let n = 5
    let spiral = spiral_build(n)
    println("=== Spiral Matrix (N=" + str(n) + ") ===")
    spiral_print(spiral)
    println("Checksum (sum of value*(1+row+col)): " + str(spiral_checksum(spiral)))
}

main()