// Rosetta Code: Greatest common divisor
// https://rosettacode.org/wiki/Greatest_common_divisor
module examples.rosetta.gcd

import io

fn gcd(a: int, b: int) -> int {
    let x = a
    let y = b
    while y != 0 {
        let t = y
        y = x % y
        x = t
    }
    return x
}

@test
fn test_gcd() {
    assert_eq(gcd(12, 18), 6)
    assert_eq(gcd(7, 3), 1)
    assert_eq(gcd(100, 10), 10)
    assert_eq(gcd(0, 5), 5)
}

fn main() {
    print("gcd(12, 18) = " + str(gcd(12, 18)))
}

main()
