// Rosetta Code · Greatest common divisor · Lateralus

fn gcd(a: int, b: int) -> int {
    let x = a
    let y = b
    if x < 0 { x = -x }
    if y < 0 { y = -y }
    while y != 0 {
        let t = y
        y = imod(x, y)
        x = t
    }
    return x
}

fn lcm(a: int, b: int) -> int {
    if a == 0 { return 0 }
    if b == 0 { return 0 }
    let g = gcd(a, b)
    let p = a * b
    if p < 0 { p = -p }
    return idiv(p, g)
}

fn main() {
    assert_eq(gcd(12, 18), 6, "12/18")
    assert_eq(gcd(100, 75), 25, "100/75")
    assert_eq(gcd(-4, 14), 2, "negatives")
    assert_eq(lcm(4, 6), 12, "lcm")
    print("gcd(48,180) = " + str(gcd(48, 180)) + ", lcm(48,180) = " + str(lcm(48, 180)))
}

main()
