// Rosetta Code · Longest common substring · Lateralus
// https://rosettacode.org/wiki/Longest_common_substring
//
// O(n*m) dynamic programme keeping only the previous row: cell [i][j] holds
// the length of the common run ending at a[i-1] and b[j-1]. Ties keep the
// first run found scanning `a` left to right.

fn longest_common_substring(a: str, b: str) -> str {
    let m = len(b)
    let prev = []
    let j = 0
    while j <= m {
        prev = prev + [0]
        j = j + 1
    }
    let best_len = 0
    let best_end = 0
    let i = 1
    while i <= len(a) {
        let cur = [0]
        let ca = slice(a, i - 1, i)
        j = 1
        while j <= m {
            if ca == slice(b, j - 1, j) {
                let run = prev[j - 1] + 1
                cur = cur + [run]
                if run > best_len {
                    best_len = run
                    best_end = i
                }
            } else {
                cur = cur + [0]
            }
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    return slice(a, best_end - best_len, best_end)
}

fn main() {
    // The Rosetta task pair.
    let got = longest_common_substring("thisisatest", "testing123testing")
    print("thisisatest / testing123testing -> \"" + got + "\"")
    assert_eq(got, "test")

    // A substring must be contiguous: "1234" is a common subsequence of
    // these two, but the longest common substring is only "12".
    assert_eq(longest_common_substring("1234", "1224533324"), "12")
    assert_eq(longest_common_substring("ABCBDAB", "BDCABA"), "AB")

    // No overlap, empty inputs, and identical strings.
    assert_eq(longest_common_substring("abc", "xyz"), "")
    assert_eq(longest_common_substring("", "abc"), "")
    assert_eq(longest_common_substring("lateralus", "lateralus"), "lateralus")
    print("edge cases ok")
}

main()
