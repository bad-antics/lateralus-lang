// ===================================================================
// examples/fenwick_tree_tutorial.ltl
// -------------------------------------------------------------------
// Demonstration of Fenwick Tree (Binary Indexed Tree / BIT) in Lateralus.
//
// Real-World Applications:
// 1. High-Frequency Trading Limit Order Book: Cumulative bid/ask depth volume.
// 2. Telemetry Frequency Histograms: Rolling percentile and cumulative density estimation.
// 3. Database Analytics: Dynamic range sum aggregations over mutable metrics.
// ===================================================================

fn lowbit(x) {
    let p = 1
    while p <= x {
        if (x / p) % 2 != 0 {
            return p
        }
        p = p * 2
    }
    return 1
}

pub fn create_fenwick_tree(n) {
    let ft = dict()
    ft["n"] = n
    let arr = []
    let i = 0
    while i <= n {
        arr = push(arr, 0)
        i = i + 1
    }
    ft["tree"] = arr
    return ft
}

pub fn fenwick_add(ft, idx, delta) {
    let n = ft["n"]
    let arr = ft["tree"]
    let i = idx
    while i <= n {
        arr[i] = arr[i] + delta
        i = i + lowbit(i)
    }
    ft["tree"] = arr
}

pub fn fenwick_query(ft, idx) {
    let arr = ft["tree"]
    let sum = 0
    let i = idx
    while i > 0 {
        sum = sum + arr[i]
        i = i - lowbit(i)
    }
    return sum
}

pub fn fenwick_range_query(ft, left, right) {
    if left > right {
        return 0
    }
    if left <= 1 {
        return fenwick_query(ft, right)
    }
    return fenwick_query(ft, right) - fenwick_query(ft, left - 1)
}

pub fn main() {
    print("=================================================================")
    print("   Lateralus Standard Library: Fenwick Tree Order Book Demo      ")
    print("=================================================================")

    // Model price tiers from Price 1 to Price 10 ($100 to $109)
    let max_price_tier = 10
    let order_book = create_fenwick_tree(max_price_tier)

    // Initial limit orders posted at various price levels
    fenwick_add(order_book, 1, 500)   // 500 shares at tier 1
    fenwick_add(order_book, 2, 1200)  // 1200 shares at tier 2
    fenwick_add(order_book, 3, 800)   // 800 shares at tier 3
    fenwick_add(order_book, 4, 2500)  // 2500 shares at tier 4
    fenwick_add(order_book, 5, 3000)  // 3000 shares at tier 5
    fenwick_add(order_book, 6, 1500)  // 1500 shares at tier 6
    fenwick_add(order_book, 7, 900)   // 900 shares at tier 7
    fenwick_add(order_book, 8, 400)   // 400 shares at tier 8
    fenwick_add(order_book, 9, 700)   // 700 shares at tier 9
    fenwick_add(order_book, 10, 100)  // 100 shares at tier 10

    print("Order book initialized with 10 price levels.")

    // 1. Cumulative volume up to Tier 5 (Market Buy sweep depth)
    let depth_tier_5 = fenwick_query(order_book, 5)
    print("Market Sweep Depth (Tiers 1 to 5): " + str(depth_tier_5) + " shares")

    // 2. Total liquidity across entire book
    let total_liquidity = fenwick_query(order_book, 10)
    print("Total Order Book Liquidity: " + str(total_liquidity) + " shares")

    // 3. Middle range volume (Tiers 3 to 7)
    let mid_volume = fenwick_range_query(order_book, 3, 7)
    print("Middle Band Volume (Tiers 3 to 7): " + str(mid_volume) + " shares")

    // 4. Live update: New institutional order arrives at Tier 4 (+5000 shares)
    print("Incoming institutional limit buy: +5000 shares at Tier 4...")
    fenwick_add(order_book, 4, 5000)

    let updated_depth_5 = fenwick_query(order_book, 5)
    let updated_total = fenwick_query(order_book, 10)
    print("Updated Sweep Depth (Tiers 1 to 5): " + str(updated_depth_5) + " shares")
    print("Updated Total Liquidity: " + str(updated_total) + " shares")

    print("Fenwick Tree execution completed with O(log n) real-time responsiveness.")
}
