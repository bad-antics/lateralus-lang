// Lateralus Standard Library Example: LRU Cache Database Layer
// Demonstrates caching query results with capacity limits and least-recently-used eviction.

fn lru_touch(keys: list, key: string) -> list {
    let mut updated = [];
    let mut i = 0;
    while i < len(keys) {
        if keys[i] != key {
            updated.append(keys[i]);
        }
        i = i + 1;
    }
    updated.append(key);
    return updated;
}

fn lru_drop_oldest(keys: list) -> list {
    let mut rem = [];
    let mut i = 1;
    while i < len(keys) {
        rem.append(keys[i]);
        i = i + 1;
    }
    return rem;
}

fn main() -> int {
    println("=== Lateralus LRU Query Cache Demo ===");

    let cap = 3;
    let mut order = [];
    let mut cache = {};

    println("Configured LRU Cache with Max Capacity = 3");

    // Populate initial 3 queries
    cache["user:101"] = "Alice";
    order = lru_touch(order, "user:101");

    cache["user:102"] = "Bob";
    order = lru_touch(order, "user:102");

    cache["user:103"] = "Charlie";
    order = lru_touch(order, "user:103");

    println("Cache filled: user:101 (Alice), user:102 (Bob), user:103 (Charlie)");
    assert(len(order) == 3);

    // Read user:101 -> promotes to newest MRU
    order = lru_touch(order, "user:101");
    println("Cache HIT: read user:101 (Promoted to MRU). Oldest key is now: " + order[0]);
    assert(order[0] == "user:102");

    // Query new record user:104 -> Evicts user:102!
    let evict_target = order[0];
    println("Cache FULL: Evicting LRU entry '" + evict_target + "'");
    cache[evict_target] = "";
    order = lru_drop_oldest(order);

    cache["user:104"] = "Diana";
    order = lru_touch(order, "user:104");

    println("Current active keys in cache:");
    let mut k = 0;
    while k < len(order) {
        let entry = order[k];
        println("  [" + str(k) + "] " + entry + " -> " + cache[entry]);
        k = k + 1;
    }

    assert(cache["user:102"] == ""); // Evicted
    assert(cache["user:101"] == "Alice");
    assert(cache["user:103"] == "Charlie");
    assert(cache["user:104"] == "Diana");

    println("LRU Eviction Lifecycle Verified Successfully!");
    return 0;
}
