// ===================================================================
// examples/simhash_tutorial_example.ltl -- stdlib simhash tutorial example
// Companion example for the stdlib.simhash blog tutorial.
//
// Scenario: Document deduplication and clustering pipeline.
// Given a set of document revisions and distinct articles, compute
// 64-bit SimHash fingerprints, detect near-duplicates using a bit
// threshold, and group them cleanly.
// ===================================================================

// stdlib pub functions are called with the module prefix:
// simhash_fingerprint, simhash_hamming, simhash_similarity,
// simhash_near_duplicate, simhash_fingerprint_all

let articles = [
    "Lateralus Language version 3.2 release notes and compiler improvements",
    "LATERALUS Language version 3.2 release notes and compiler improvements!",
    "Lateralus Language version 3.2 release notes and runtime improvements",
    "Baking authentic sourdough bread with active starter and high hydration"
]

println("--- Document Deduplication with SimHash ---")

// Compute fingerprints in batch
let fps = simhash_fingerprint_all(articles)

// 1. Case-insensitive exact match check (Articles 0 and 1)
let dist_case = simhash_hamming(fps[0], fps[1])
println("Doc 0 vs Doc 1 (case & punctuation difference):")
println("  Hamming Distance: {dist_case} bits")
println("  Similarity Score: {simhash_similarity(fps[0], fps[1])}")

// 2. Minor mutation check (Articles 0 and 2: 'compiler' vs 'runtime')
let dist_edit = simhash_hamming(fps[0], fps[2])
let is_near_dup = simhash_near_duplicate(articles[0], articles[2], 5)
println("\nDoc 0 vs Doc 2 (single word revision):")
println("  Hamming Distance: {dist_edit} bits")
println("  Near-duplicate (threshold <= 5): {is_near_dup}")

// 3. Completely unrelated document check (Articles 0 and 3)
let dist_diff = simhash_hamming(fps[0], fps[3])
println("\nDoc 0 vs Doc 3 (completely distinct topic):")
println("  Hamming Distance: {dist_diff} bits")
println("  Similarity Score: {simhash_similarity(fps[0], fps[3])}")

// Expected output summary:
//   Doc 0 vs Doc 1: Hamming Distance: 0 bits (exact match after tokenization)
//   Doc 0 vs Doc 2: Hamming Distance: small (<= 5 bits, near-duplicate)
//   Doc 0 vs Doc 3: Hamming Distance: large (> 15 bits, distinct topic)
