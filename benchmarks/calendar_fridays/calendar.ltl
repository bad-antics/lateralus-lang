// Proleptic Gregorian calendar. Weekdays are Monday=0 through Sunday=6.
fn leap_days_in_year(year: int) -> int {
    if year % 400 == 0 { return 1 }
    if year % 100 == 0 { return 0 }
    if year % 4 == 0 { return 1 }
    return 0
}

fn common_month_length(month: int) -> int {
    if month == 2 { return 28 }
    if month <= 7 { return 30 + month % 2 }
    return 31 - month % 2
}

fn january_weekday(year: int) -> int {
    // Weekdays and leap years repeat after 146097 days (400 years).
    let remaining = (year - 1) % 400
    let mut offset = 0
    let mut cursor = 1
    while cursor <= remaining {
        offset = offset + 1 + leap_days_in_year(cursor)
        cursor = cursor + 1
    }
    return offset % 7
}

fn count_month(first: int, last: int, month: int) -> int {
    let mut common_offset = 0
    let mut m = 1
    while m < month {
        common_offset = common_offset + common_month_length(m)
        m = m + 1
    }
    // Any consecutive 400 years contain a full weekday cycle, even when
    // the first year is not a multiple of 400. Its prefix covers the tail.
    let mut tail = last - first + 1
    let mut cycles = 0
    while tail >= 400 {
        tail = tail - 400
        cycles = cycles + 1
    }
    let mut span = tail
    if cycles > 0 { span = 400 }
    let mut january = january_weekday(first)
    let mut year = first
    let mut count = 0
    let mut tail_count = 0
    while year < first + span {
        let leap = leap_days_in_year(year)
        let mut day = january + common_offset + 12
        if month > 2 { day = day + leap }
        if day % 7 == 4 {
            count = count + 1
            if year < first + tail { tail_count = tail_count + 1 }
        }
        january = (january + 1 + leap) % 7
        year = year + 1
    }
    return cycles * count + tail_count
}

fn print_calendar(first: int, last: int) -> int {
    let mut month = 1
    while month <= 12 {
        println(count_month(first, last, month))
        month = month + 1
    }
    return 0
}

fn main() -> int {
    return print_calendar(1, 9999)
}

main()
