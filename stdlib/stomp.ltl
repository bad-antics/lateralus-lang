---
--- STOMP 1.2 Client & Frame Parser Library for Lateralus
---

module stomp

--- Connects to a STOMP broker (stub/interface definition)
fn connect(host: String, port: Int, headers: Map<String, String>) -> String {
    let mut frame = "CONNECT\n"
    let mut keys = keys(headers)
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        let v = headers[k]
        frame = frame + k + ":" + v + "\n"
        i = i + 1
    }
    frame = frame + "\n" + chr(0)
    frame
}

--- Sends a message to a destination, computing correct UTF-8 byte-length for content-length
fn send(destination: String, body: String, headers: Map<String, String>) -> String {
    let mut frame = "SEND\ndestination:" + destination + "\n"
    let byte_len = len(bytes_of(body))
    frame = frame + "content-length:" + str(byte_len) + "\n"
    
    let mut keys = keys(headers)
    let mut i = 0
    while i < len(keys) {
        let k = keys[i]
        let v = headers[k]
        -- Avoid duplicating content-length or destination if supplied in headers
        if k != "content-length" {
            if k != "destination" {
                frame = frame + k + ":" + v + "\n"
            }
        }
        i = i + 1
    }
    
    frame = frame + "\n" + body + chr(0)
    frame
}

--- Parses a raw STOMP frame string supporting CRLF/LF line endings, content-length bodies, and binary NULs
fn parse_frame(raw: String) -> Map<String, String> {
    let mut result = {}
    let mut lines = split(raw, "\n")
    if len(lines) == 0 {
        return result
    }

    -- Command line (strip trailing \r if present)
    let mut cmd = lines[0]
    if ends_with(cmd, "\r") {
        cmd = substring(cmd, 0, len(cmd) - 1)
    }
    result["__command"] = cmd

    let mut i = 1
    let mut header_end_idx = -1
    while i < len(lines) {
        let mut line = lines[i]
        if ends_with(line, "\r") {
            line = substring(line, 0, len(line) - 1)
        }
        if line == "" {
            header_end_idx = i
            i = len(lines) -- break
        } else {
            let parts = split_n(line, ":", 2)
            if len(parts) == 2 {
                result[parts[0]] = parts[1]
            }
        }
        i = i + 1
    }

    -- Extract body: check content-length first if present, otherwise fallback or scan
    if header_end_idx != -1 && header_end_idx < len(lines) {
        -- Reconstruct body starting from lines after header_end_idx, joining with \n (or preserving exact raw slice)
        -- To be robust against binary content and CRLF, find the exact byte/char offset after the blank separator.
        let mut body_start_offset = 0
        let mut scan_idx = 0
        let mut cur_line = 0
        while cur_line <= header_end_idx {
            scan_idx = scan_idx + len(lines[cur_line]) + 1
            if cur_line < len(lines) && ends_with(lines[cur_line], "\r") {
                -- account for \r in original length if needed, split("\n") drops \n but leaves \r if present
            }
            cur_line = cur_line + 1
        }
        -- Alternatively, use substring of raw from the blank line boundary
        if has_key(result, "content-length") {
            let cl_str = result["content-length"]
            let cl = int_of(cl_str)
            if scan_idx + cl <= len(raw) {
                let body_val = substring(raw, scan_idx, scan_idx + cl)
                result["__body"] = body_val
            } else {
                let body_val = substring(raw, scan_idx, len(raw))
                -- Strip trailing null terminator if present
                if ends_with(body_val, chr(0)) {
                    body_val = substring(body_val, 0, len(body_val) - 1)
                }
                result["__body"] = body_val
            }
        } else {
            -- Scan to first chr(0)
            let body_val = substring(raw, scan_idx, len(raw))
            let mut null_idx = index_of(body_val, chr(0))
            if null_idx != -1 {
                body_val = substring(body_val, 0, null_idx)
            }
            result["__body"] = body_val
        }
    }

    result
}