// ===================================================================
// tests/stdlib_majority_vote_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for the Boyer-Moore Majority Vote algorithm,
// Misra-Gries streaming heavy hitters, and O(1) space consensus tally.
// ===================================================================

pub fn majority_vote(nums) {
    let n = len(nums)
    if n == 0 {
        let res = dict()
        res["candidate"] = nil
        res["count"] = 0
        res["is_majority"] = false
        return res
    }

    let candidate = nums[0]
    let count = 0

    let i = 0
    while i < n {
        let x = nums[i]
        if count == 0 {
            candidate = x
            count = 1
        } else {
            if x == candidate {
                count = count + 1
            } else {
                count = count - 1
            }
        }
        i = i + 1
    }

    let actual_count = 0
    let j = 0
    while j < n {
        if nums[j] == candidate {
            actual_count = actual_count + 1
        }
        j = j + 1
    }

    let threshold = idiv(n, 2)
    let res = dict()
    res["candidate"] = candidate
    res["count"] = actual_count
    res["is_majority"] = (actual_count > threshold)

    return res
}

pub fn majority_two_thirds(nums) {
    let n = len(nums)
    if n == 0 {
        return []
    }

    let cand1 = nums[0]
    let cand2 = nums[0]
    let count1 = 0
    let count2 = 0

    let i = 0
    while i < n {
        let x = nums[i]
        if x == cand1 {
            count1 = count1 + 1
        } else {
            if x == cand2 {
                count2 = count2 + 1
            } else {
                if count1 == 0 {
                    cand1 = x
                    count1 = 1
                } else {
                    if count2 == 0 {
                        cand2 = x
                        count2 = 1
                    } else {
                        count1 = count1 - 1
                        count2 = count2 - 1
                    }
                }
            }
        }
        i = i + 1
    }

    let actual1 = 0
    let actual2 = 0
    let j = 0
    while j < n {
        if nums[j] == cand1 {
            actual1 = actual1 + 1
        } else {
            if nums[j] == cand2 {
                actual2 = actual2 + 1
            }
        }
        j = j + 1
    }

    let threshold = idiv(n, 3)
    let winners = []
    if actual1 > threshold {
        winners = push(winners, cand1)
    }
    if cand2 != cand1 and actual2 > threshold {
        winners = push(winners, cand2)
    }

    return winners
}

pub fn test_majority_classic() -> bool {
    let v1 = [3, 2, 3]
    let r1 = majority_vote(v1)
    if not r1["is_majority"] or r1["candidate"] != 3 or r1["count"] != 2 {
        return false
    }

    let v2 = [2, 2, 1, 1, 1, 2, 2]
    let r2 = majority_vote(v2)
    if not r2["is_majority"] or r2["candidate"] != 2 or r2["count"] != 4 {
        return false
    }

    return true
}

pub fn test_majority_no_majority() -> bool {
    let v1 = [1, 2, 3, 4]
    let r1 = majority_vote(v1)
    if r1["is_majority"] {
        return false
    }

    let v2 = [1, 2, 1, 2]
    let r2 = majority_vote(v2)
    if r2["is_majority"] {
        return false
    }

    return true
}

pub fn test_majority_uniform() -> bool {
    let v = [7, 7, 7, 7, 7]
    let r = majority_vote(v)
    if not r["is_majority"] or r["candidate"] != 7 or r["count"] != 5 {
        return false
    }

    return true
}

pub fn test_majority_single_element() -> bool {
    let v = [42]
    let r = majority_vote(v)
    if not r["is_majority"] or r["candidate"] != 42 or r["count"] != 1 {
        return false
    }

    return true
}

pub fn test_majority_two_thirds_heavy_hitters() -> bool {
    let v1 = [1, 1, 1, 2, 2, 3]
    let w1 = majority_two_thirds(v1)
    if len(w1) != 1 or w1[0] != 1 {
        return false
    }

    let v2 = [1, 2, 1, 2, 3, 1, 2]
    let w2 = majority_two_thirds(v2)
    if len(w2) != 2 {
        return false
    }

    return true
}
