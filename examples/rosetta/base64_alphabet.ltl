// Rosetta Code: Base64 — implement encode from scratch (RFC 4648 alphabet)
fn b64_char(n: int) -> str {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let mut i = 0
    let mut c = "?"
    for ch in alphabet {
        if i == n { c = ch }
        i = i + 1
    }
    return c
}

println(b64_char(0) + b64_char(25) + b64_char(52) + b64_char(61) + b64_char(63))
if b64_char(0) == "A" && b64_char(63) == "/" { println("OK") } else { println("FAIL") }
