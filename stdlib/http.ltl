// ===========================================================================
// Module: stdlib/http.ltl
// Description: HTTP status code response classifiers and offline tutorial
// ===========================================================================

// ===========================================================================
// Section: Status Classifiers
// ===========================================================================

fn is_ok(status: int) -> bool {
    status >= 200 and status <= 299
}

fn is_redirect(status: int) -> bool {
    status >= 300 and status <= 399
}

fn is_client_error(status: int) -> bool {
    status >= 400 and status <= 499
}

fn is_server_error(status: int) -> bool {
    status >= 500 and status <= 599
}

// ===========================================================================
// Section: Runnable Example & Report Generator
// ===========================================================================

fn classify_status(status: int) -> string {
    if status |> is_ok {
        "OK"
    } else if status |> is_redirect {
        "Redirect"
    } else if status |> is_client_error {
        "Client Error"
    } else if status |> is_server_error {
        "Server Error"
    } else {
        "Unknown / Informational"
    }
}

fn generate_report(status: int) -> string {
    let classification = status |> classify_status
    "Status: " + status + " -> " + classification
}

// ===========================================================================
// Section: Pinned Test Cases & Boundary Assertions
// ===========================================================================

fn run_assertions() -> bool {
    // 199/200 boundary: 199 should be false for all standard response classifiers
    let t199_ok = is_ok(199) == false
    let t199_red = is_redirect(199) == false
    let t199_cli = is_client_error(199) == false
    let t199_srv = is_server_error(199) == false

    let t200_ok = is_ok(200) == true

    // 299/300 boundary
    let t299_ok = is_ok(299) == true
    let t300_red = is_redirect(300) == true

    // 399/400 boundary
    let t399_red = is_redirect(399) == true
    let t400_cli = is_client_error(400) == true

    // 499/500 boundary
    let t499_cli = is_client_error(499) == true
    let t500_srv = is_server_error(500) == true

    // 599/600 boundary: 600 should be false for all standard response classifiers
    let t599_srv = is_server_error(599) == true
    let t600_ok = is_ok(600) == false
    let t600_red = is_redirect(600) == false
    let t600_cli = is_client_error(600) == false
    let t600_srv = is_server_error(600) == false

    t199_ok and t199_red and t199_cli and t199_srv and
    t200_ok and
    t299_ok and t300_red and
    t399_red and t400_cli and
    t499_cli and t500_srv and
    t599_srv and
    t600_ok and t600_red and t600_cli and t600_srv
}