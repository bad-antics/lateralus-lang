// ChaCha20 encrypt 1 MB of deterministic data (RFC 8439).
// Key: bytes 0..31. Nonce: 12 zero bytes. Initial counter: 1.
// Input: glibc LCG bytes (seed 999), 1,048,576 bytes.
// Output: xxhash64 of the ciphertext.
// Expected output: 10941187508525638281
import xxhash
import chacha20

fn main() {
    let n = 1048576
    let data = [0] * n
    let st = 999
    let i = 0
    while i < n {
        st = (1103515245 * st + 12345) % 2147483648
        data[i] = (st >> 16) & 0xff
        i = i + 1
    }
    let key = [0] * 32
    let k = 0
    while k < 32 {
        key[k] = k
        k = k + 1
    }
    let nonce = [0] * 12
    let ct = chacha20.xor(key, nonce, 1, data)
    println(xxhash.hash64(ct, 0))
}

main()
