// Standard Library Consistent Hashing Tutorial Verification Suite
// Validates circular hash ring, virtual node dispatch, wraparound, and minimal key migration.

fn simple_hash(key: string) -> int {
    let mut h = 17;
    let mut i = 0;
    while i < len(key) {
        let ch = slice(key, i, i + 1);
        let mut val = 1;
        if ch == "a" { val = 97; }
        if ch == "b" { val = 98; }
        if ch == "c" { val = 99; }
        if ch == "u" { val = 117; }
        if ch == "s" { val = 115; }
        if ch == "e" { val = 101; }
        if ch == "r" { val = 114; }
        if ch == "1" { val = 49; }
        if ch == "2" { val = 50; }
        if ch == "3" { val = 51; }
        h = (h * 31 + val) % 1000;
        i = i + 1;
    }
    return h;
}

// Dispatches a hash value to the closest clockwise virtual node
fn ring_dispatch(sorted_hashes: list, node_names: list, key_hash: int) -> string {
    let count = len(sorted_hashes);
    if count == 0 {
        return "";
    }
    let mut i = 0;
    while i < count {
        let h = sorted_hashes[i];
        if h >= key_hash {
            return node_names[i];
        }
        i = i + 1;
    }
    // Wraparound to first node
    return node_names[0];
}

fn main() -> int {
    // 1. Construct 3-node ring with sorted positions
    // Node A at pos 150
    // Node B at pos 500
    // Node C at pos 850
    let ring_hashes = [150, 500, 850];
    let ring_nodes = ["NodeA", "NodeB", "NodeC"];

    // 2. Direct hit / between nodes routing
    // Key at 100 <= 150 -> NodeA
    assert(ring_dispatch(ring_hashes, ring_nodes, 100) == "NodeA");
    // Key at 150 == 150 -> NodeA
    assert(ring_dispatch(ring_hashes, ring_nodes, 150) == "NodeA");
    // Key at 300 <= 500 -> NodeB
    assert(ring_dispatch(ring_hashes, ring_nodes, 300) == "NodeB");
    // Key at 600 <= 850 -> NodeC
    assert(ring_dispatch(ring_hashes, ring_nodes, 600) == "NodeC");

    // 3. Wraparound routing (Key beyond highest node wraps to NodeA)
    assert(ring_dispatch(ring_hashes, ring_nodes, 900) == "NodeA");
    assert(ring_dispatch(ring_hashes, ring_nodes, 999) == "NodeA");

    // 4. Deterministic hashing invariant
    let h1 = simple_hash("user1");
    let h2 = simple_hash("user1");
    assert(h1 == h2);
    let target1 = ring_dispatch(ring_hashes, ring_nodes, h1);
    let target2 = ring_dispatch(ring_hashes, ring_nodes, h2);
    assert(target1 == target2);

    return 0;
}
