// ===================================================================
// Lateralus Example: stdlib.qgram — Typo-Tolerant Search & Fuzzy Match
// -------------------------------------------------------------------
// Uses overlapping character n-grams (q-grams) to index text collections
// and score fuzzy search queries against potential typos.
// ===================================================================

import qgram

fn main() {
    println("=== Typo-Tolerant Fuzzy Search (Q-Gram) ===")

    // Sample document library
    let docs = [
        "lateralus programming language",
        "python asynchronous architecture",
        "distributed key-value database",
        "ladder logic industrial automation"
    ]

    // 1. Build a 2-gram (bi-gram) inverted index
    let q = 2
    let idx = build_index(docs, q)
    println("[+] Inverted index built over " + str(len(docs)) + " documents.")

    // 2. Query with a misspelled word ("lateralluss" instead of "lateralus")
    let typo_query = "lateralluss"
    println("\n[1] Querying with misspelled keyword: '" + typo_query + "'")
    let results = query(idx, typo_query, q)

    println("Ranked document matches (Doc ID, Shared Q-Grams):")
    let r = 0
    while r < len(results) {
        let doc_id = results[r][0]
        let score = results[r][1]
        println("  #" + str(r + 1) + " -> Doc [" + str(doc_id) + "]: '" + docs[doc_id] + "' (Score: " + str(score) + ")")
        r = r + 1
    }

    // 3. Q-gram Jaccard Similarity Matrix
    println("\n[2] Jaccard Similarity for Common Typos:")
    let pairs = [
        ["algorithm", "algoritm"],
        ["receive", "recieve"],
        ["calendar", "calender"],
        ["lateralus", "python"]
    ]

    let p = 0
    while p < len(pairs) {
        let w1 = pairs[p][0]
        let w2 = pairs[p][1]
        let sim = jaccard(w1, w2, q)
        println("  sim('" + w1 + "', '" + w2 + "') = " + str(sim))
        p = p + 1
    }
}

main()
