// Advent of Code 2024 · Day 22 · Monkey Market
// Each buyer's secret evolves: mix (*64), mix (/32), mix (*2048), pruning
// (mod 16777216) after each step. Mix is bitwise XOR.
// Part 1: sum of each buyer's 2000th secret. Sample answer: 37327623.
// Part 2: best 4-change sequence (first occurrence per buyer) by total
// bananas. Sample answer: 23 (buyers 1, 2, 3, 2024).

let SAMPLE = "1
10
100
2024"

let SAMPLE2 = "1
2
3
2024"

fn parse(text: str) -> list {
    let buyers = []
    let lines = str_split(text, "\n")
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            buyers = buyers + [int(line)]
        }
        i = i + 1
    }
    return buyers
}

fn next_secret(s: int) -> int {
    let n = s
    n = (n ^ (n * 64)) % 16777216
    n = (n ^ idiv(n, 32)) % 16777216
    n = (n ^ (n * 2048)) % 16777216
    return n
}

fn part1(text: str) -> int {
    let buyers = parse(text)
    let total = 0
    let i = 0
    while i < len(buyers) {
        let s = buyers[i]
        let step = 0
        while step < 2000 {
            s = next_secret(s)
            step = step + 1
        }
        total = total + s
        i = i + 1
    }
    return total
}

// Prices for one buyer: the ones digit of the initial secret plus the
// next 2000 secrets (2001 prices total).
fn prices_of(start: int) -> list {
    let prices = [start % 10]
    let s = start
    let step = 0
    while step < 2000 {
        s = next_secret(s)
        prices = prices + [s % 10]
        step = step + 1
    }
    return prices
}

fn part2(text: str) -> int {
    let buyers = parse(text)
    let totals = {}
    let i = 0
    while i < len(buyers) {
        let prices = prices_of(buyers[i])
        let seen = {}
        let j = 4
        while j < len(prices) {
            let d1 = prices[j - 3] - prices[j - 4]
            let d2 = prices[j - 2] - prices[j - 3]
            let d3 = prices[j - 1] - prices[j - 2]
            let d4 = prices[j] - prices[j - 1]
            let key = str(d1) + "," + str(d2) + "," + str(d3) + "," + str(d4)
            if contains(seen, key) == false {
                seen[key] = true
                if contains(totals, key) {
                    totals[key] = totals[key] + prices[j]
                } else {
                    totals[key] = prices[j]
                }
            }
            j = j + 1
        }
        i = i + 1
    }
    let best = 0
    let ks = keys(totals)
    let k = 0
    while k < len(ks) {
        if totals[ks[k]] > best { best = totals[ks[k]] }
        k = k + 1
    }
    return best
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 37327623)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE2), 23)
}

fn main() {
    print("Day 22 Part 1: " + str(part1(SAMPLE)))
    print("Day 22 Part 2: " + str(part2(SAMPLE2)))
}

main()
