// Advent of Code 2024 · Day 25 · Code Chronicle
// Schematics of five-pin tumbler locks and keys. A lock and a key fit
// together when, in every column, lock height + key height <= 5.
// Part 1: count the fitting lock/key pairs. (Day 25 has no part 2.)
// Sample answer: part 1 = 3.

let SAMPLE = "#####
.####
.####
.####
.#.#.
.#...
.....

#####
##.##
.#.##
...##
...#.
...#.
.....

.....
#....
#....
#...#
#.#.#
#.###
#####

.....
.....
#.#..
###..
###.#
###.#
#####

.....
.....
.....
#....
#.#..
#.#.#
#####"

// Parse the schematics into [locks, keys], each a list of 5 heights.
fn parse(text: str) -> list {
    let locks = []
    let keys = []
    let blocks = str_split(text, "\n\n")
    let b = 0
    while b < len(blocks) {
        let rows = str_split(blocks[b], "\n")
        let heights = []
        let c = 0
        while c < 5 {
            let h = 0
            let r = 0
            while r < len(rows) {
                if rows[r][c] == "#" { h = h + 1 }
                r = r + 1
            }
            // subtract the solid top (locks) / bottom (keys) row
            heights = heights + [h - 1]
            c = c + 1
        }
        if rows[0] == "#####" {
            locks = locks + [heights]
        } else {
            keys = keys + [heights]
        }
        b = b + 1
    }
    return [locks, keys]
}

fn fits(lock: list, key: list) -> bool {
    let c = 0
    while c < 5 {
        if lock[c] + key[c] > 5 { return false }
        c = c + 1
    }
    return true
}

fn part1(text: str) -> int {
    let p = parse(text)
    let locks = p[0]
    let keys = p[1]
    let total = 0
    let i = 0
    while i < len(locks) {
        let j = 0
        while j < len(keys) {
            if fits(locks[i], keys[j]) { total = total + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return total
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 3)
}

fn main() {
    print("Day 25 Part 1: " + str(part1(SAMPLE)))
}

main()
