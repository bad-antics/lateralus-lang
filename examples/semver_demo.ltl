// ===================================================================
// examples/semver_demo.ltl — stdlib.semver tutorial companion
// ===================================================================

import semver

let current = parse("v1.4.0-beta.2+build.19")
let released = parse("1.4.0")

println("Current:  " + to_string(current))
println("Release:  " + to_string(released))
println("Major:    " + str(major(current)))
println("Minor:    " + str(minor(current)))
println("Patch:    " + str(patch(current)))
println("Channel:  " + prerelease(current))
println("Stable?   " + str(is_stable(current)))
println("Before release? " + str(lt(current, released)))

let next_patch = bump_patch(released)
println("Next patch: " + to_string(next_patch))
println("Compatible with ^1.3? " + str(satisfies_caret(current, 1, 3)))
println("Compatible with ~1.4? " + str(satisfies_tilde(current, 1, 4)))
