// Synthetic terrain-grid survey: total height and four-neighbour roughness.
fn survey_a() {
    let grid = [1, 2, 4, 3, 2, 3, 5, 4, 0, 1, 2, 2, 1, 2, 3, 1]
    let mut height = 0
    let mut roughness = 0
    let mut y = 0
    while y < 4 {
        let mut x = 0
        while x < 4 {
            let i = y * 4 + x
            height = height + grid[i]
            if x < 3 { roughness = roughness + abs(grid[i] - grid[i + 1]) }
            if y < 3 { roughness = roughness + abs(grid[i] - grid[i + 4]) }
            x = x + 1
        }
        y = y + 1
    }
    println(height)
    println(roughness)
}

fn survey_b() {
    let grid = [7, 6, 4, 6, 5, 3, 4, 3, 2, 2, 1, 0, 1, 2, 1]
    let mut height = 0
    let mut roughness = 0
    let mut y = 0
    while y < 5 {
        let mut x = 0
        while x < 3 {
            let i = y * 3 + x
            height = height + grid[i]
            if x < 2 { roughness = roughness + abs(grid[i] - grid[i + 1]) }
            if y < 4 { roughness = roughness + abs(grid[i] - grid[i + 3]) }
            x = x + 1
        }
        y = y + 1
    }
    println(height)
    println(roughness)
}

fn main() {
    survey_a()
    survey_b()
}

main()
