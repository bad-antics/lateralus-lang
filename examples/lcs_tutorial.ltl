// Lateralus Standard Library Example: Longest Common Subsequence (LCS)
// Demonstrates 2D dynamic programming for file revision differencing and common token extraction.

fn lcs(s1: str, s2: str) -> dict {
    let m = len(s1);
    let n = len(s2);

    let mut dp = [];
    let mut i = 0;
    while i <= m {
        let mut row = [];
        let mut j = 0;
        while j <= n {
            row = row + [0];
            j = j + 1;
        }
        dp = dp + [row];
        i = i + 1;
    }

    let mut r = 1;
    while r <= m {
        let c1 = slice(s1, r - 1, r);
        let mut c = 1;
        while c <= n {
            let c2 = slice(s2, c - 1, c);
            if c1 == c2 {
                dp[r][c] = dp[r - 1][c - 1] + 1;
            } else {
                let up = dp[r - 1][c];
                let left = dp[r][c - 1];
                if up > left {
                    dp[r][c] = up;
                } else {
                    dp[r][c] = left;
                }
            }
            c = c + 1;
        }
        r = r + 1;
    }

    let lcs_length = dp[m][n];

    let mut lcs_seq = "";
    let mut tr = m;
    let mut tc = n;
    while tr > 0 && tc > 0 {
        let c1 = slice(s1, tr - 1, tr);
        let c2 = slice(s2, tc - 1, tc);
        if c1 == c2 {
            lcs_seq = c1 + lcs_seq;
            tr = tr - 1;
            tc = tc - 1;
        } else {
            if dp[tr - 1][tc] > dp[tr][tc - 1] {
                tr = tr - 1;
            } else {
                tc = tc - 1;
            }
        }
    }

    let mut result = {};
    result["length"] = lcs_length;
    result["subsequence"] = lcs_seq;
    return result;
}

fn main() -> int {
    println("=== Longest Common Subsequence (LCS) Example ===");

    // Version Control Diff: comparing two revisions of code token stream
    let rev_a = "MOV_R1_R2_ADD_R1_JMP_LOOP";
    let rev_b = "MOV_R1_R2_SUB_R3_ADD_R1_RET";

    println("Revision A:");
    println(rev_a);
    println("Revision B:");
    println(rev_b);

    let res = lcs(rev_a, rev_b);
    let common_len = res["length"];
    let common_tokens = res["subsequence"];

    println("LCS Token Length:");
    println(common_len);
    println("Common Invariant Subsequence:");
    println(common_tokens);

    println("LCS calculation completed successfully.");
    return 0;
}
