// ===================================================================
// examples/time_tutorial.ltl — stdlib/time.ltl tutorial companion
// Runnable tour of the time helpers: format_iso, format_date,
// elapsed_ms, perf_counter and now. Functions inlined from
// stdlib/time.ltl (import stdlib.* is not wired up yet — issue #260).
// ===================================================================

fn t_now() -> float {
    return _time.time()
}

fn t_perf_counter() -> float {
    return _time.perf_counter()
}

fn t_format_iso(ts: float) -> str {
    return _time.strftime("%Y-%m-%dT%H:%M:%S", _time.localtime(ts))
}

fn t_format_date(ts: float) -> str {
    return _time.strftime("%Y-%m-%d", _time.localtime(ts))
}

fn t_elapsed_ms(start: float) -> float {
    return (t_perf_counter() - start) * 1000.0
}

fn main() {
    print("=== LATERALUS STDLIB TIME TUTORIAL ===")

    // -- pinned vector: 2023-11-14T22:13:20Z (run tests with TZ=UTC) --
    let ts = 1700000000.0
    print("iso=" + t_format_iso(ts))
    print("date=" + t_format_date(ts))

    // -- epoch sanity: now() is a positive unix timestamp -------------
    let now_ts = t_now()
    print("now_positive=" + str(now_ts > 1700000000.0))

    // -- elapsed_ms measures wall time between two perf_counter() ----
    let t0 = t_perf_counter()
    let acc = 0
    let i = 0
    while i < 100000 {
        acc = acc + i
        i = i + 1
    }
    let ms = t_elapsed_ms(t0)
    print("loop_acc=" + str(acc))
    print("elapsed_ms_positive=" + str(ms > 0.0))

    // -- compose: format a deadline one hour out ----------------------
    let deadline = ts + 3600.0
    print("deadline=" + t_format_iso(deadline))
}
