// Advent of Code 2024 · Day 7 · Bridge Repair
// Each line "target: n1 n2 ..." is an equation missing its operators.
// Operators are evaluated left-to-right, no precedence.
// Part 1: operators are + and *. Part 2: also || (concatenation).
// Sum the test values of the equations that can be made true.

let SAMPLE = "190: 10 19
3267: 81 40 27
83: 17 5
156: 15 6
7290: 6 8 6 15
161011: 16 10 13
192: 17 8 14
21037: 9 7 18 13
292: 11 6 16 20"

// Parse into a list of [target, [numbers]] pairs.
fn parse(text: str) -> list {
    let eqs = []
    let lines = str_split(text, "\n")
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let parts = str_split(line, ":")
            let target = int(str_trim(parts[0]))
            let numparts = str_split(str_trim(parts[1]), " ")
            let nums = []
            let j = 0
            while j < len(numparts) {
                nums = nums + [int(numparts[j])]
                j = j + 1
            }
            eqs = eqs + [[target, nums]]
        }
        i = i + 1
    }
    return eqs
}

fn concat_nums(a: int, b: int) -> int {
    return int(str(a) + str(b))
}

// Can the remaining numbers (from index idx) bring acc up to target?
// allow_concat toggles the || operator. All numbers are positive, so
// prune any branch whose accumulator already exceeds the target.
fn solvable(target: int, nums: list, idx: int, acc: int, allow_concat: bool) -> bool {
    if acc > target {
        return false
    }
    if idx >= len(nums) {
        return acc == target
    }
    let n = nums[idx]
    if solvable(target, nums, idx + 1, acc + n, allow_concat) {
        return true
    }
    if solvable(target, nums, idx + 1, acc * n, allow_concat) {
        return true
    }
    if allow_concat {
        if solvable(target, nums, idx + 1, concat_nums(acc, n), allow_concat) {
            return true
        }
    }
    return false
}

fn solve(text: str, allow_concat: bool) -> int {
    let eqs = parse(text)
    let total = 0
    let i = 0
    while i < len(eqs) {
        let target = eqs[i][0]
        let nums = eqs[i][1]
        if solvable(target, nums, 1, nums[0], allow_concat) {
            total = total + target
        }
        i = i + 1
    }
    return total
}

fn part1(text: str) -> int {
    return solve(text, false)
}

fn part2(text: str) -> int {
    return solve(text, true)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 3749)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 11387)
}

fn main() {
    print("Day 7 Part 1: " + str(part1(SAMPLE)))
    print("Day 7 Part 2: " + str(part2(SAMPLE)))
}

main()
