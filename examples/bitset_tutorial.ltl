// examples/bitset_tutorial.ltl - Demonstrates stdlib.bitset operations
import stdlib.bitset

fn main() {
    let bs = bitset.new(128)
    let bs = bitset.set(bs, 1)
    let bs = bitset.set(bs, 10)
    let bs = bitset.set(bs, 64)
    
    let is_set_10 = bitset.test(bs, 10)
    let total_bits = bitset.count(bs)
    let positions = bitset.to_list(bs)
    
    let other = bitset.from_list(128, [10, 20, 30])
    let u = bitset.union(bs, other)
    let inter = bitset.intersection(bs, other)
}
