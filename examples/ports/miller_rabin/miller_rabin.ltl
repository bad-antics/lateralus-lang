// examples/ports/miller_rabin/miller_rabin.ltl
// Fast Modular Exponentiation and Deterministic Miller-Rabin Primality Test in Lateralus

module examples.ports.miller_rabin

import io

fn power(base: int, exp: int, mod: int) -> int {
    let mut res = 1
    let mut b = base % mod
    let mut e = exp

    while e > 0 {
        if e % 2 == 1 {
            res = (res * b) % mod
        }
        b = (b * b) % mod
        e = (e / 2) as int
    }
    return res
}

fn is_prime(n: int) -> bool {
    if n < 2 {
        return false
    }
    if n == 2 || n == 3 {
        return true
    }
    if n % 2 == 0 {
        return false
    }

    let mut d = n - 1
    let mut s = 0
    while d % 2 == 0 {
        d = (d / 2) as int
        s += 1
    }

    let bases = [2, 3, 5, 7, 11, 13, 17]
    let mut i = 0
    while i < 7 {
        let a = bases[i]
        if n <= a {
            i += 1
            continue
        }

        let mut x = power(a, d, n)
        if x == 1 || x == n - 1 {
            i += 1
            continue
        }

        let mut composite = true
        let mut r = 0
        while r < s - 1 {
            x = (x * x) % n
            if x == n - 1 {
                composite = false
                break
            }
            r += 1
        }

        if composite {
            return false
        }
        i += 1
    }

    return true
}

fn count_primes(limit: int) -> int {
    let mut count = 0
    let mut i = 1
    while i <= limit {
        if is_prime(i) {
            count += 1
        }
        i += 1
    }
    return count
}

fn main() {
    let limit = 50000
    let total = count_primes(limit)
    io.println("Computed pi(" + limit.to_string() + ") = " + total.to_string())
}
