// stdlib_push_relabel_tutorial.ltl
// Comprehensive test suite for Push-Relabel Maximum Flow Algorithm
// Andrew V. Goldberg & Robert E. Tarjan (1988)
// Runnable by any test harness honouring `pub fn test_*() -> bool`

pub fn min_val(a: int, b: int) -> int {
    if a < b {
        return a;
    }
    return b;
}

pub fn push_relabel_max_flow(capacity: list, n: int, s: int, t: int) -> map {
    let mut flow = [];
    let mut excess = [];
    let mut height = [];

    let mut i = 0;
    while i < n {
        let mut row = [];
        let mut j = 0;
        while j < n {
            row = row + [0];
            j = j + 1;
        }
        flow = flow + [row];
        excess = excess + [0];
        if i == s {
            height = height + [n];
        } else {
            height = height + [0];
        }
        i = i + 1;
    }

    // Preflow initialization from source s
    let mut v = 0;
    while v < n {
        let mut cap = capacity[s][v];
        if cap > 0 {
            flow[s][v] = cap;
            flow[v][s] = 0 - cap;
            excess[v] = cap;
            excess[s] = excess[s] - cap;
        }
        v = v + 1;
    }

    let mut active = true;
    let mut iter = 0;
    while active && iter < 1000 {
        iter = iter + 1;
        let mut found_u = -1;
        let mut max_h = -1;

        // Highest-label active vertex selection heuristic
        let mut u = 0;
        while u < n {
            if u != s && u != t {
                if excess[u] > 0 {
                    if height[u] > max_h {
                        max_h = height[u];
                        found_u = u;
                    }
                }
            }
            u = u + 1;
        }

        if found_u == -1 {
            active = false;
        } else {
            let mut curr = found_u;
            let mut target_v = 0;

            while target_v < n && excess[curr] > 0 {
                let mut res_cap = capacity[curr][target_v] - flow[curr][target_v];
                if res_cap > 0 && height[curr] == height[target_v] + 1 {
                    let mut send = min_val(excess[curr], res_cap);
                    flow[curr][target_v] = flow[curr][target_v] + send;
                    flow[target_v][curr] = flow[target_v][curr] - send;
                    excess[curr] = excess[curr] - send;
                    excess[target_v] = excess[target_v] + send;
                }
                target_v = target_v + 1;
            }

            // If excess still remains after checking all neighbors, relabel
            if excess[curr] > 0 {
                let mut min_h = 999999;
                let mut k = 0;
                while k < n {
                    let mut res_cap = capacity[curr][k] - flow[curr][k];
                    if res_cap > 0 {
                        if height[k] < min_h {
                            min_h = height[k];
                        }
                    }
                    k = k + 1;
                }
                if min_h < 999999 {
                    height[curr] = min_h + 1;
                }
            }
        }
    }

    let mut max_flow = excess[t];
    return {
        flow_value: max_flow,
        heights: height,
        excesses: excess
    };
}

// -----------------------------------------------------------------------------
// Test Vectors
// -----------------------------------------------------------------------------

pub fn test_push_relabel_diamond_network() -> bool {
    // 4 Nodes: 0 (Source), 1, 2, 3 (Sink)
    // 0 -> 1: cap 3
    // 0 -> 2: cap 2
    // 1 -> 2: cap 1
    // 1 -> 3: cap 2
    // 2 -> 3: cap 3
    let mut cap = [
        [0, 3, 2, 0],
        [0, 0, 1, 2],
        [0, 0, 0, 3],
        [0, 0, 0, 0]
    ];
    let mut res = push_relabel_max_flow(cap, 4, 0, 3);
    let mut mf = res["flow_value"];
    return mf == 5;
}

pub fn test_push_relabel_bottleneck_pipeline() -> bool {
    // 0 -> 1 (cap 100) -> 2 (cap 15) -> 3 (cap 80)
    let mut cap = [
        [0, 100, 0, 0],
        [0, 0, 15, 0],
        [0, 0, 0, 80],
        [0, 0, 0, 0]
    ];
    let mut res = push_relabel_max_flow(cap, 4, 0, 3);
    let mut mf = res["flow_value"];
    return mf == 15;
}

pub fn test_push_relabel_disconnected_zero_flow() -> bool {
    // 0 -> 1 (cap 10), 2 -> 3 (cap 10), disjoint
    let mut cap = [
        [0, 10, 0, 0],
        [0, 0, 0, 0],
        [0, 0, 0, 10],
        [0, 0, 0, 0]
    ];
    let mut res = push_relabel_max_flow(cap, 4, 0, 3);
    let mut mf = res["flow_value"];
    return mf == 0;
}

pub fn test_push_relabel_dense_mesh() -> bool {
    // 5 Nodes: 0 (Source), 1, 2, 3, 4 (Sink)
    let mut cap = [
        [0, 10, 10, 0, 0],
        [0, 0, 2, 4, 8],
        [0, 0, 0, 9, 0],
        [0, 0, 0, 0, 10],
        [0, 0, 0, 0, 0]
    ];
    let mut res = push_relabel_max_flow(cap, 5, 0, 4);
    let mut mf = res["flow_value"];
    return mf >= 15;
}

pub fn run_all() -> map {
    let mut t1 = test_push_relabel_diamond_network();
    let mut t2 = test_push_relabel_bottleneck_pipeline();
    let mut t3 = test_push_relabel_disconnected_zero_flow();
    let mut t4 = test_push_relabel_dense_mesh();
    let mut passed = t1 && t2 && t3 && t4;
    return {
        total: 4,
        all_passed: passed
    };
}
