// tests/stdlib_edmonds_blossom_tutorial.ltl
// Comprehensive Golden Test Vectors for Edmonds' Blossom Maximum Cardinality Matching

fn find_lca(base: list, parent: list, match: list, u: int, v: int) -> int {
    var visited: list = []
    var i: int = 0
    while i < len(base) {
        visited.append(false)
        i = i + 1
    }
    
    var curr_u: int = u
    var curr_v: int = v
    var done: bool = false
    var lca: int = 0
    
    while !done {
        curr_u = base[curr_u]
        visited[curr_u] = true
        if match[curr_u] == -1 {
            done = true
        } else {
            curr_u = parent[match[curr_u]]
        }
    }
    
    done = false
    while !done {
        curr_v = base[curr_v]
        if visited[curr_v] {
            lca = curr_v
            done = true
        } else {
            curr_v = parent[match[curr_v]]
        }
    }
    return lca
}

fn mark_blossom(lca: int, u: int, base: list, parent: list, match: list, blossom: list) -> void {
    var curr: int = u
    while base[curr] != lca {
        var v: int = match[curr]
        blossom[base[curr]] = true
        blossom[base[v]] = true
        curr = parent[v]
    }
}

fn contract_blossom(lca: int, u: int, v: int, base: list, parent: list, match: list, q: list, types: list) -> void {
    var blossom: list = []
    var i: int = 0
    while i < len(base) {
        blossom.append(false)
        i = i + 1
    }
    
    mark_blossom(lca, u, base, parent, match, blossom)
    mark_blossom(lca, v, base, parent, match, blossom)
    
    if base[u] != lca {
        parent[u] = v
    }
    if base[v] != lca {
        parent[v] = u
    }
    
    i = 0
    while i < len(base) {
        if blossom[base[i]] {
            base[i] = lca
            if types[i] == 1 {
                types[i] = 0
                q.append(i)
            }
        }
        i = i + 1
    }
}

fn find_augmenting_path(n: int, adj: list, match: list) -> int {
    var parent: list = []
    var base: list = []
    var types: list = []
    var q: list = []
    
    var i: int = 0
    while i < n {
        parent.append(-1)
        base.append(i)
        types.append(-1)
        i = i + 1
    }
    
    var root: int = 0
    while root < n {
        if match[root] == -1 {
            q.append(root)
            types[root] = 0
        }
        root = root + 1
    }
    
    var head: int = 0
    var aug_end: int = -1
    
    while head < len(q) && aug_end == -1 {
        var u: int = q[head]
        head = head + 1
        
        var neighbors: list = adj[u]
        var j: int = 0
        while j < len(neighbors) && aug_end == -1 {
            var v: int = neighbors[j]
            if base[u] != base[v] && match[u] != v {
                if v == root || (match[v] != -1 && parent[match[v]] != -1) {
                    var lca: int = find_lca(base, parent, match, u, v)
                    contract_blossom(lca, u, v, base, parent, match, q, types)
                } else if parent[v] == -1 {
                    parent[v] = u
                    if match[v] == -1 {
                        aug_end = v
                    } else {
                        parent[match[v]] = v
                        types[match[v]] = 0
                        q.append(match[v])
                    }
                }
            }
            j = j + 1
        }
    }
    
    if aug_end != -1 {
        var curr: int = aug_end
        while curr != -1 {
            var prev_u: int = parent[curr]
            var next_v: int = -1
            if prev_u != -1 {
                next_v = match[prev_u]
            }
            match[curr] = prev_u
            if prev_u != -1 {
                match[prev_u] = curr
            }
            curr = next_v
        }
        return 1
    }
    return 0
}

fn edmonds_blossom(n: int, edges: list) -> map {
    var adj: list = []
    var match: list = []
    var i: int = 0
    while i < n {
        var empty_list: list = []
        adj.append(empty_list)
        match.append(-1)
        i = i + 1
    }
    
    var e_idx: int = 0
    while e_idx < len(edges) {
        var edge: list = edges[e_idx]
        var u: int = edge[0]
        var v: int = edge[1]
        var adj_u: list = adj[u]
        var adj_v: list = adj[v]
        adj_u.append(v)
        adj_v.append(u)
        e_idx = e_idx + 1
    }
    
    var matches: int = 0
    var augmented: int = 1
    while augmented == 1 {
        augmented = find_augmenting_path(n, adj, match)
        if augmented == 1 {
            matches = matches + 1
        }
    }
    
    return {
        count: matches,
        assignment: match
    }
}

fn test_triangle_odd_cycle() -> void {
    // C3: 3 vertices with triangle odd cycle: 0-1, 1-2, 2-0.
    // Max matching = 1 pair (1 vertex left free).
    var edges: list = [[0, 1], [1, 2], [2, 0]]
    var res: map = edmonds_blossom(3, edges)
    var count: int = res.count
    assert count == 1
}

fn test_triangle_with_stem() -> void {
    // Triangle 0-1-2 with attached stem 0-3.
    // Optimal matching: 0-3 and 1-2 (count = 2 pairs, perfect matching).
    var edges: list = [[0, 1], [1, 2], [2, 0], [0, 3]]
    var res: map = edmonds_blossom(4, edges)
    var count: int = res.count
    assert count == 2
}

fn test_pentagon_odd_cycle_with_tails() -> void {
    // 5-cycle (0-1-2-3-4-0) with tail (4-5).
    // Total 6 vertices. Perfect matching of size 3.
    var edges: list = [
        [0, 1], [1, 2], [2, 3], [3, 4], [4, 0],
        [4, 5]
    ]
    var res: map = edmonds_blossom(6, edges)
    var count: int = res.count
    assert count == 3
}

fn test_complete_graph_k4() -> void {
    // Complete graph K4: all pairs connected.
    // Max matching = 2 pairs (perfect).
    var edges: list = [
        [0, 1], [0, 2], [0, 3],
        [1, 2], [1, 3],
        [2, 3]
    ]
    var res: map = edmonds_blossom(4, edges)
    var count: int = res.count
    assert count == 2
}

fn test_disconnected_graph() -> void {
    // 4 vertices: single edge 0-1, isolated vertices 2 and 3.
    var edges: list = [[0, 1]]
    var res: map = edmonds_blossom(4, edges)
    var count: int = res.count
    assert count == 1
}

fn main() -> int {
    test_triangle_odd_cycle()
    test_triangle_with_stem()
    test_pentagon_odd_cycle_with_tails()
    test_complete_graph_k4()
    test_disconnected_graph()
    print("All Edmonds' Blossom algorithm golden tests passed successfully!")
    return 0
}
