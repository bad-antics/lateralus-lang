// Lateralus Standard Library Example: Floyd-Warshall All-Pairs Shortest Path
// Demonstrates O(V^3) dynamic programming for multi-region inter-node datacenter network routing.

fn floyd_warshall(n: int, edges: list) -> dict {
    let INF = 1000000000;
    let mut dist = [];
    let mut i = 0;
    while i < n {
        let mut row = [];
        let mut j = 0;
        while j < n {
            if i == j {
                row = row + [0];
            } else {
                row = row + [INF];
            }
            j = j + 1;
        }
        dist = dist + [row];
        i = i + 1;
    }

    let mut e_idx = 0;
    while e_idx < len(edges) {
        let e = edges[e_idx];
        let u = e[0];
        let v = e[1];
        let w = e[2];
        if w < dist[u][v] {
            dist[u][v] = w;
        }
        e_idx = e_idx + 1;
    }

    let mut k = 0;
    while k < n {
        let mut r = 0;
        while r < n {
            let mut c = 0;
            while c < n {
                if dist[r][k] != INF && dist[k][c] != INF {
                    let cand = dist[r][k] + dist[k][c];
                    if cand < dist[r][c] {
                        dist[r][c] = cand;
                    }
                }
                c = c + 1;
            }
            r = r + 1;
        }
        k = k + 1;
    }

    let mut has_negative_cycle = false;
    let mut diag = 0;
    while diag < n {
        if dist[diag][diag] < 0 {
            has_negative_cycle = true;
            diag = n;
        } else {
            diag = diag + 1;
        }
    }

    let mut result = {};
    result["dist"] = dist;
    result["has_negative_cycle"] = has_negative_cycle;
    return result;
}

fn main() -> int {
    println("=== Floyd-Warshall All-Pairs Routing Example ===");

    // 4 Regional Cloud Datacenters:
    // 0: US-East, 1: US-West, 2: EU-Central, 3: Asia-East
    // Directed network link ping latencies in milliseconds:
    let network_links = [
        [0, 1, 35],
        [0, 3, 140],
        [1, 2, 70],
        [2, 3, 25]
    ];

    let result = floyd_warshall(4, network_links);
    let matrix = result["dist"];
    let has_neg = result["has_negative_cycle"];

    if has_neg {
        println("Warning: Negative cycle detected in routing table!");
    } else {
        println("Optimal inter-region latency from US-East (0) to Asia-East (3):");
        println(matrix[0][3]); // 0 -> 1 -> 2 -> 3 with latency 35 + 70 + 25 = 130 ms (beats direct 140 ms)
    }

    println("Floyd-Warshall execution completed successfully.");
    return 0;
}
