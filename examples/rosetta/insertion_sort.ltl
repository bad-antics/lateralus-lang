// Rosetta Code · Sorting algorithms/Insertion sort · Lateralus

fn insertion_sort(xs: list) -> list {
    let a = list_copy(xs)
    let i = 1
    while i < len(a) {
        let key = a[i]
        let j = i - 1
        let place = i
        while j >= 0 {
            if a[j] > key {
                a[j + 1] = a[j]
                place = j
                j = j - 1
            } else {
                j = -1
            }
        }
        a[place] = key
        i = i + 1
    }
    return a
}

fn main() {
    assert_eq(insertion_sort([9, 8, 7, 1, 2, 3]), [1, 2, 3, 7, 8, 9], "desc input")
    assert_eq(insertion_sort([1, 2, 3]), [1, 2, 3], "already sorted")
    print("insertion_sort: " + str(insertion_sort([4, 65, 2, -31, 0])))
}

main()
