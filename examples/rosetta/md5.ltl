// Rosetta Code · MD5 · Lateralus
// https://rosettacode.org/wiki/MD5
//
// From-scratch RFC 1321 message digest. Strings are UTF-8 encoded, padded
// to a multiple of 64 bytes, then folded through four rounds of 16 steps.
// All arithmetic is masked to 32 bits because Lateralus ints are unbounded.

let MASK32 = 0xFFFFFFFF
let HEX = "0123456789abcdef"

// Per-step left-rotate amounts.
let MD5_S = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

// K[i] = floor(|sin(i + 1)| * 2^32)
let MD5_K = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
    0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
    0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
    0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
    0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
    0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
    0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
    0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
    0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
]

fn utf8_bytes(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        let cp = ord(slice(s, i, i + 1))
        if cp < 0x80 {
            out = out + [cp]
        } else if cp < 0x800 {
            out = out + [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
        } else if cp < 0x10000 {
            out = out + [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
        } else {
            out = out + [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F),
                         0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
        }
        i = i + 1
    }
    return out
}

fn rotl(x: int, n: int) -> int {
    return ((x << n) | (x >> (32 - n))) & MASK32
}

fn hex_byte(b: int) -> str {
    return slice(HEX, b >> 4, (b >> 4) + 1) + slice(HEX, b & 15, (b & 15) + 1)
}

fn md5_bytes(msg: list) -> str {
    let bit_len = len(msg) * 8
    let data = msg + [0x80]
    while len(data) % 64 != 56 { data = data + [0] }
    // Length is appended little-endian as a 64-bit value.
    let i = 0
    while i < 8 {
        data = data + [(bit_len >> (8 * i)) & 0xFF]
        i = i + 1
    }

    let a0 = 0x67452301
    let b0 = 0xefcdab89
    let c0 = 0x98badcfe
    let d0 = 0x10325476

    let off = 0
    while off < len(data) {
        // Sixteen little-endian 32-bit words.
        let m = []
        let w = 0
        while w < 16 {
            let p = off + 4 * w
            m = m + [data[p] | (data[p + 1] << 8) | (data[p + 2] << 16) | (data[p + 3] << 24)]
            w = w + 1
        }

        let a = a0
        let b = b0
        let c = c0
        let d = d0
        let j = 0
        while j < 64 {
            let f = 0
            let g = 0
            if j < 16 {
                f = (b & c) | ((~b) & d)
                g = j
            } else if j < 32 {
                f = (d & b) | ((~d) & c)
                g = (5 * j + 1) % 16
            } else if j < 48 {
                f = b ^ c ^ d
                g = (3 * j + 5) % 16
            } else {
                f = c ^ (b | ((~d) & MASK32))
                g = (7 * j) % 16
            }
            f = (f + a + MD5_K[j] + m[g]) & MASK32
            a = d
            d = c
            c = b
            b = (b + rotl(f, MD5_S[j])) & MASK32
            j = j + 1
        }
        a0 = (a0 + a) & MASK32
        b0 = (b0 + b) & MASK32
        c0 = (c0 + c) & MASK32
        d0 = (d0 + d) & MASK32
        off = off + 64
    }

    // Digest is the four state words, each serialised little-endian.
    let out = ""
    let words = [a0, b0, c0, d0]
    let k = 0
    while k < 4 {
        let s = 0
        while s < 4 {
            out = out + hex_byte((words[k] >> (8 * s)) & 0xFF)
            s = s + 1
        }
        k = k + 1
    }
    return out
}

fn md5(s: str) -> str {
    return md5_bytes(utf8_bytes(s))
}

fn main() {
    // Rosetta task string, followed by the RFC 1321 appendix A.5 suite.
    let cases = [
        ["The quick brown fox jumped over the lazy dog's back", "e38ca1d920c4b8b8d3946b2c72f01680"],
        ["", "d41d8cd98f00b204e9800998ecf8427e"],
        ["a", "0cc175b9c0f1b6a831c399e269772661"],
        ["abc", "900150983cd24fb0d6963f7d28e17f72"],
        ["message digest", "f96b697d7cb7938d525a2f31aaf161d0"],
        ["abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b"],
        ["12345678901234567890123456789012345678901234567890123456789012345678901234567890",
         "57edf4a22be3c955ac49da2e2107b67a"]
    ]
    let i = 0
    while i < len(cases) {
        let got = md5(cases[i][0])
        print(got + "  \"" + cases[i][0] + "\"")
        assert_eq(got, cases[i][1])
        i = i + 1
    }
}

main()
