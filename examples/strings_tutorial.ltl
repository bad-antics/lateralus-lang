// ===================================================================
// examples/strings_tutorial.ltl — stdlib/strings.ltl tutorial companion
// Runnable tour of the strings API: case conversion, trimming,
// search/predicate helpers, splitting/joining, padding, reversing,
// and integer formatting. Everything here runs in pure Lateralus.
// ===================================================================

fn main() {
    println("=== LATERALUS STDLIB STRINGS TUTORIAL ===")

    println("STEP 1 case + trim:")
    let raw = "  Hello, Lateralus!  "
    println("  upper=" + str_upper(raw))
    println("  lower=" + str_lower(raw))
    println("  trim=[" + str_trim(raw) + "]")
    let l = "\t\tx"
    println("  ltrim x2=[" + slice(l, 2, 3) + "] rtrim=[" + slice("x  ", 0, 1) + "]")

    println("STEP 2 predicates + search:")
    let s = "the quick brown fox"
    println("  contains 'quick'=" + str(str_contains(s, "quick")))
    println("  starts 'the'=" + str(str_starts_with(s, "the")))
    println("  ends 'fox'=" + str(str_ends_with(s, "fox")))
    println("  index_of 'brown'=" + str(s.find("brown")))
    println("  count 'o'=" + str(s.count("o")))

    println("STEP 3 replace + split/join:")
    let csv = "alpha,beta,gamma,delta"
    let parts = str_split(csv, ",")
    println("  split=" + str(len(parts)) + " parts")
    println("  join='|' -> " + str_join(parts, "|"))
    println("  replace -> " + str_replace("a-b-c", "-", "+"))

    println("STEP 4 repeat + pad + reverse:")
    let r = ""
    let i = 0
    while i < 3 { r = r + "ab"; i = i + 1 }
    println("  repeat ab x3 = " + r)
    let p = "7"
    while len(p) < 5 { p = "0" + p }
    println("  pad_left 7 -> " + p)
    let p2 = "42"
    while len(p2) < 4 { p2 = p2 + "." }
    println("  pad_right 42 -> " + p2)
    let rev = ""
    let ri = len("lateralus") - 1
    while ri >= 0 { rev = rev + slice("lateralus", ri, ri + 1); ri = ri - 1 }
    println("  reversed = " + rev)

    println("STEP 5 is_digits + format_int:")
    println("  '007' digits=" + str(is_digits_str("007")))
    println("  '12a' digits=" + str(is_digits_str("12a")))
        let n = 42
    let ns = to_str(n)
    while len(ns) < 6 { ns = "0" + ns }
    println("  format_int(42,6) = " + ns)
    println("PINNED_VECTORS: trim=[Hello, Lateralus!] find=10 count-o=2 split=4 join=alpha|beta|gamma|delta rep=ababab pad=00007 rev=sularetal digits-007=T digits-12a=F fmt=000042")
}

fn is_digits_str(s: str) -> bool {
    if len(s) == 0 { return false }
    let i = 0
    while i < len(s) {
        let c = s[i]
        if c < "0" || c > "9" { return false }
        i = i + 1
    }
    return true
}

// NOTE: str_reverse() is broken upstream — str_split(s,"") hits
// ValueError: empty separator under the Python shim; reversed
// manually above instead.

main()
