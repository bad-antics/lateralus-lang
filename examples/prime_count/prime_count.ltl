// prime_count.ltl — Count the primes below a limit by trial division.
//
// Port of prime_count.py (same algorithm, same limit): 2 is prime, even
// numbers above 2 are not, and every other candidate is tested against
// odd divisors up to its square root.
//
//   lateralus run examples/prime_count/prime_count.ltl
//   lateralus c examples/prime_count/prime_count.ltl -o prime_count.c
//   gcc -O2 -o prime_count prime_count.c -lm && ./prime_count
//
// Expected output:
//   78498
//
// Notes on the shape of this file:
//   - main() prints the bare count, the same style as
//     benchmarks/src/sieve.ltl. The C backend cannot compile string
//     interpolation ("...{x}...") or str(int) yet (it emits invalid C),
//     so the "primes below 1000000: " label lives in the Python
//     original and in README.md, not in the .ltl output.
//   - No @test blocks: the C backend emits calls to assert_true /
//     assert_eq that have no definition in the generated C, so a file
//     with @test blocks cannot compile with `lateralus c`. Correctness
//     is verified as README.md describes (interpreter run at a small
//     limit, compiled binary at the full limit, cross-checked against
//     the Python original). `lateralus test` itself is also currently
//     broken repo-wide (AttributeError in __main__.py, reproduced on
//     examples/showcase.ltl).
//   - `lateralus fmt` was NOT run on this file: it rewrites
//     `return false` to `return false,` and destroys indentation.
//     `lateralus lint --strict` crashes with an AttributeError.
//     Both are pre-existing toolchain bugs, unrelated to this port.

const LIMIT = 1000000

fn is_prime(n: int) -> bool {
    if n < 2 {
        return false
    }
    if n == 2 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let mut d = 3
    while d * d <= n {
        if n % d == 0 {
            return false
        }
        d = d + 2
    }
    return true
}

fn count_primes(limit: int) -> int {
    let mut count = 0
    let mut n = 2
    while n < limit {
        if is_prime(n) {
            count = count + 1
        }
        n = n + 1
    }
    return count
}

fn main() {
    let count = count_primes(LIMIT)
    println(count)
}

main()
