// ===================================================================
// tests/stdlib_lca_binary_lifting_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for the Lowest Common Ancestor (LCA) via
// Binary Lifting, O(n log n) jump table precomputation, and tree distances.
// ===================================================================

fn init_adj(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

fn add_tree_edge(adj, u, v) {
    adj[u] = push(adj[u], v)
    adj[v] = push(adj[v], u)
}

fn init_up_table(log_n, n) {
    let up = dict()
    let i = 0
    while i < log_n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = 0
            j = j + 1
        }
        up[i] = row
        i = i + 1
    }
    return up
}

fn dfs_lca(u, p, d, adj, depth, up, log_n) {
    depth[u] = d
    up[0][u] = p

    let i = 1
    while i < log_n {
        let anc = up[i - 1][u]
        up[i][u] = up[i - 1][anc]
        i = i + 1
    }

    let neighbors = adj[u]
    let k = 0
    while k < len(neighbors) {
        let v = neighbors[k]
        if v != p {
            dfs_lca(v, u, d + 1, adj, depth, up, log_n)
        }
        k = k + 1
    }
}

pub fn build_lca_tree(n, root, adj) {
    let log_n = 10
    let depth = dict()
    let up = init_up_table(log_n, n)

    dfs_lca(root, root, 0, adj, depth, up, log_n)

    let tree_data = dict()
    tree_data["depth"] = depth
    tree_data["up"] = up
    tree_data["log_n"] = log_n
    tree_data["pow2"] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024]
    return tree_data
}

pub fn get_lca(tree_data, u_in, v_in) {
    let depth = tree_data["depth"]
    let up = tree_data["up"]
    let log_n = tree_data["log_n"]
    let pow2 = tree_data["pow2"]

    let u = u_in
    let v = v_in

    if depth[u] < depth[v] {
        let tmp = u
        u = v
        v = tmp
    }

    // Bring u to the same depth as v
    let diff = depth[u] - depth[v]
    let i = log_n - 1
    while i >= 0 {
        let p2 = pow2[i]
        if diff >= p2 {
            u = up[i][u]
            diff = diff - p2
        }
        i = i - 1
    }

    if u == v {
        return u
    }

    // Lift u and v together
    i = log_n - 1
    while i >= 0 {
        if up[i][u] != up[i][v] {
            u = up[i][u]
            v = up[i][v]
        }
        i = i - 1
    }

    return up[0][u]
}

pub fn tree_distance(tree_data, u, v) {
    let depth = tree_data["depth"]
    let lca_node = get_lca(tree_data, u, v)
    return depth[u] + depth[v] - 2 * depth[lca_node]
}

pub fn test_lca_binary_tree() -> bool {
    // Tree topology:
    //         0
    //       /   \
    //      1     2
    //     / \   / \
    //    3   4 5   6
    //   /
    //  7
    let n = 8
    let adj = init_adj(n)
    add_tree_edge(adj, 0, 1)
    add_tree_edge(adj, 0, 2)
    add_tree_edge(adj, 1, 3)
    add_tree_edge(adj, 1, 4)
    add_tree_edge(adj, 2, 5)
    add_tree_edge(adj, 2, 6)
    add_tree_edge(adj, 3, 7)

    let tree_data = build_lca_tree(n, 0, adj)

    // LCA(3, 4) should be 1
    if get_lca(tree_data, 3, 4) != 1 {
        return false
    }
    if tree_distance(tree_data, 3, 4) != 2 {
        return false
    }

    // LCA(7, 4) should be 1
    if get_lca(tree_data, 7, 4) != 1 {
        return false
    }
    if tree_distance(tree_data, 7, 4) != 3 {
        return false
    }

    // LCA(7, 5) should be 0
    if get_lca(tree_data, 7, 5) != 0 {
        return false
    }
    if tree_distance(tree_data, 7, 5) != 5 {
        return false
    }

    return true
}

pub fn test_lca_ancestor_and_descendant() -> bool {
    let n = 8
    let adj = init_adj(n)
    add_tree_edge(adj, 0, 1)
    add_tree_edge(adj, 0, 2)
    add_tree_edge(adj, 1, 3)
    add_tree_edge(adj, 1, 4)
    add_tree_edge(adj, 2, 5)
    add_tree_edge(adj, 2, 6)
    add_tree_edge(adj, 3, 7)

    let tree_data = build_lca_tree(n, 0, adj)

    // LCA(7, 1) should be 1
    if get_lca(tree_data, 7, 1) != 1 {
        return false
    }
    if tree_distance(tree_data, 7, 1) != 2 {
        return false
    }

    // LCA(7, 0) should be 0
    if get_lca(tree_data, 7, 0) != 0 {
        return false
    }

    return true
}

pub fn test_lca_co_located() -> bool {
    let n = 5
    let adj = init_adj(n)
    add_tree_edge(adj, 0, 1)
    add_tree_edge(adj, 1, 2)
    add_tree_edge(adj, 2, 3)
    add_tree_edge(adj, 3, 4)

    let tree_data = build_lca_tree(n, 0, adj)

    if get_lca(tree_data, 3, 3) != 3 {
        return false
    }
    if tree_distance(tree_data, 3, 3) != 0 {
        return false
    }

    return true
}

pub fn test_lca_linear_skewed_chain() -> bool {
    let n = 5
    let adj = init_adj(n)
    add_tree_edge(adj, 0, 1)
    add_tree_edge(adj, 1, 2)
    add_tree_edge(adj, 2, 3)
    add_tree_edge(adj, 3, 4)

    let tree_data = build_lca_tree(n, 0, adj)

    if get_lca(tree_data, 4, 2) != 2 {
        return false
    }
    if tree_distance(tree_data, 4, 2) != 2 {
        return false
    }

    return true
}
