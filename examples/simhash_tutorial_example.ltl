// ===================================================================
// examples/simhash_tutorial.ltl -- stdlib simhash tutorial example
// Companion example for the stdlib.simhash blog tutorial.
//
// Scenario: a near-duplicate scan. Given a small list of documents,
// fingerprint each one and print the Hamming distance for every
// pair, flagging the pairs that sit at or below a dedupe threshold.
// ===================================================================

// stdlib pub functions are called with the module prefix:
// simhash_fingerprint, simhash_hamming, simhash_near_duplicate, ...

let docs = [
    "the quick brown fox",
    "The quick brown fox!",
    "the quick brown fox jumps",
    "quantum entanglement lecture notes",
]

let fps = simhash_fingerprint_all(docs)
let threshold = 3
let pairs = 0

let i = 0
while i < len(docs) {
    let j = i + 1
    while j < len(docs) {
        let d = simhash_hamming(fps[i], fps[j])
        if simhash_near_duplicate(fps[i], fps[j], threshold) {
            println("doc {i} vs doc {j}: hamming {d} -> near duplicate")
            pairs = pairs + 1
        } else {
            println("doc {i} vs doc {j}: hamming {d}")
        }
        j = j + 1
    }
    i = i + 1
}
println("{pairs} near-duplicate pair(s) at threshold {threshold}")

// Expected output:
//   doc 0 vs doc 1: hamming 0 -> near duplicate
//   doc 0 vs doc 2: hamming 13
//   doc 0 vs doc 3: hamming 24
//   doc 1 vs doc 2: hamming 13
//   doc 1 vs doc 3: hamming 24
//   doc 2 vs doc 3: hamming 31
//   1 near-duplicate pair(s) at threshold 3
//
// Why doc 0 and doc 1 collide: the tokeniser lowercases and splits
// on punctuation, so the two strings are the same token list.
// Doc 2 adds one token ("jumps") and moves 13 bits; doc 3 shares no
// tokens with the others and lands far away from all of them.
