// Lateralus Standard Library Example: Extended Euclidean Algorithm & RSA Key Generation
// Demonstrates Bézout identity computation, modular multiplicative inverses, and RSA private key derivation.

fn ext_gcd(a: int, b: int) -> dict {
    let mut old_r = a;
    let mut r = b;
    let mut old_s = 1;
    let mut s = 0;
    let mut old_t = 0;
    let mut t = 1;

    while r != 0 {
        let quotient = idiv(old_r, r);
        let temp_r = r;
        r = old_r - quotient * r;
        old_r = temp_r;

        let temp_s = s;
        s = old_s - quotient * s;
        old_s = temp_s;

        let temp_t = t;
        t = old_t - quotient * t;
        old_t = temp_t;
    }

    let mut result = {};
    result["gcd"] = old_r;
    result["x"] = old_s;
    result["y"] = old_t;
    return result;
}

fn mod_inverse(a: int, m: int) -> int {
    let res = ext_gcd(a, m);
    if res["gcd"] != 1 {
        return -1;
    }
    let mut inv = res["x"] % m;
    if inv < 0 {
        inv = inv + m;
    }
    return inv;
}

fn main() -> int {
    println("=== Extended Euclidean Algorithm & RSA Example ===");

    // RSA Cryptosystem Key Generation Parameters:
    // Prime p = 61, prime q = 53
    // Modulus n = p * q = 3233
    // Euler totient phi(n) = (p - 1) * (q - 1) = 60 * 52 = 3120
    // Public exponent e = 17
    let phi = 3120;
    let e = 17;

    println("Euler totient phi(n):");
    println(phi);
    println("Public exponent e:");
    println(e);

    // Compute private key exponent d = e^(-1) mod phi(n):
    let d = mod_inverse(e, phi);

    println("Derived private exponent d (modular inverse of e):");
    println(d); // 2753

    println("Verifying e * d mod phi(n):");
    let check = (e * d) % phi;
    println(check); // must be 1

    println("Extended Euclidean execution completed successfully.");
    return 0;
}
