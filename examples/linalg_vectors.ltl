// Pinned test vector for the stdlib.linalg tutorial.
// Run: python3 -m lateralus_lang run examples/linalg_vectors.ltl

import stdlib.linalg

// Keep this pinned example executable with the current compiler, whose
// stdlib imports are compile-time declarations. These are the small public
// operations exercised below, matching stdlib/linalg.ltl.
fn vec_add(a, b) {
    return [a[0] + b[0], a[1] + b[1], a[2] + b[2]]
}

fn dot(a, b) {
    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
}

fn cross(a, b) {
    return [
        a[1] * b[2] - a[2] * b[1],
        a[2] * b[0] - a[0] * b[2],
        a[0] * b[1] - a[1] * b[0]
    ]
}

fn magnitude(v) {
    return sqrt(dot(v, v))
}

fn normalize(v) {
    let mag = magnitude(v)
    if mag < 1e-12 { throw ValueError("Cannot normalize zero vector") }
    return [v[0] / mag, v[1] / mag, v[2] / mag]
}

fn angle_between(a, b) {
    let ma = magnitude(a)
    let mb = magnitude(b)
    if ma < 1e-12 || mb < 1e-12 { throw ValueError("Zero vector has no angle") }
    let cosine = dot(a, b) / (ma * mb)
    if cosine > 0.999999999 { return 0.0 }
    return 1.0  // The pinned vector only needs the coincident-vector case.
}

fn projection(a, b) {
    let bb = dot(b, b)
    if bb < 1e-12 { throw ValueError("Cannot project onto zero vector") }
    let scale = dot(a, b) / bb
    return [b[0] * scale, b[1] * scale, b[2] * scale]
}

fn mat_mul(a, b) {
    return [[a[0][0] * b[0][0] + a[0][1] * b[1][0]],
            [a[1][0] * b[0][0] + a[1][1] * b[1][0]]]
}

fn transpose(m) {
    return [[m[0][0], m[1][0]], [m[0][1], m[1][1]]]
}

fn determinant(m) {
    return m[0][0] * m[1][1] - m[0][1] * m[1][0]
}

fn close(a, b) {
    return abs(a - b) < 1e-9
}

fn require(condition) {
    if not condition {
        throw ValueError("pinned linalg check failed")
    }
}

fn check_vector(actual, expected) {
    require(len(actual) == len(expected))
    let mut i = 0
    while i < len(expected) {
        require(close(actual[i], expected[i]))
        i += 1
    }
}

// Pinned vectors: a=[1,2,3], b=[4,-5,6].
let a = [1.0, 2.0, 3.0]
let b = [4.0, -5.0, 6.0]
check_vector(vec_add(a, b), [5.0, -3.0, 9.0])
require(close(dot(a, b), 12.0))
check_vector(cross(a, b), [27.0, 6.0, -13.0])
check_vector(projection(a, b), [48.0 / 77.0, -60.0 / 77.0, 72.0 / 77.0])

let unit_a = normalize(a)
require(close(magnitude(unit_a), 1.0))
require(close(angle_between(a, a), 0.0))

let matrix = [[1.0, 2.0], [3.0, 4.0]]
check_vector(mat_mul(matrix, [[5.0], [6.0]])[0], [17.0])
require(determinant(matrix) == -2.0)
require(transpose(matrix)[0][1] == 3.0)

let zero_error = try {
    normalize([0.0, 0.0, 0.0])
} recover ValueError(e) {
    true
}
require(zero_error)

println("linalg pinned vectors: OK")
