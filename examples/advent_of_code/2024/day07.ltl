// Advent of Code 2024 · Day 7 · Bridge Repair
// Part 1: a calibration is valid if inserting + or * left-to-right gives the target.
// Part 2: also allow the || concatenation operator.
// Self-verifying with @test blocks.

let SAMPLE = "190: 10 19
3267: 81 40 27
83: 17 5
156: 15 6
7290: 6 8 6 15
161011: 16 10 13
192: 13 17
21037: 9 7 18 13
292: 11 6 16 20"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn concat(a: int, b: int) -> int {
    return int(str(a) + str(b))
}

// Can we reach target from nums[0] using ops on nums[1..]?
fn reachable(target: int, nums: list, allowConcat: bool) -> bool {
    let accs = [nums[0]]
    let i = 1
    while i < len(nums) {
        let next = []
        for a in accs {
            let n = nums[i]
            if a + n <= target { next = next + [a + n] }
            if a * n <= target { next = next + [a * n] }
            if allowConcat {
                let c = concat(a, n)
                if c <= target { next = next + [c] }
            }
        }
        accs = next
        if len(accs) == 0 { return false }
        i = i + 1
    }
    for a in accs { if a == target { return true } }
    return false
}

fn run(text: str, allowConcat: bool) -> int {
    let total = 0
    for line in lines_of(text) {
        let parts = str_split(line, ":")
        let target = int(str_trim(parts[0]))
        let nums = []
        for t in str_split(str_trim(parts[1]), " ") {
            let s = str_trim(t)
            if len(s) > 0 { nums = nums + [int(s)] }
        }
        if reachable(target, nums, allowConcat) { total = total + target }
    }
    return total
}

@test
fn test_part1() {
    assert_eq(run(SAMPLE, false), 3749)
}

@test
fn test_part2() {
    assert_eq(run(SAMPLE, true), 11195)
}

fn main() {
    print("Day 7 Part 1: " + str(run(SAMPLE, false)))
    print("Day 7 Part 2: " + str(run(SAMPLE, true)))
}

main()
