// ===================================================================
// tests/stdlib_edmonds_karp_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for the Edmonds-Karp Maximum Network Flow algorithm,
// residual graph updating, and Max-Flow Min-Cut properties.
// ===================================================================

fn init_matrix(n) {
    let m = dict()
    let i = 0
    while i < n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = 0
            j = j + 1
        }
        m[i] = row
        i = i + 1
    }
    return m
}

fn init_adj(n) {
    let adj = dict()
    let i = 0
    while i < n {
        adj[i] = []
        i = i + 1
    }
    return adj
}

fn add_edge(adj, capacity, u, v, cap) {
    adj[u] = push(adj[u], v)
    adj[v] = push(adj[v], u)
    capacity[u][v] = capacity[u][v] + cap
}

fn bfs(n, adj, capacity, s, t, parent) {
    let visited = dict()
    let i = 0
    while i < n {
        visited[i] = false
        parent[i] = -1
        i = i + 1
    }

    let queue = [s]
    visited[s] = true
    let q_head = 0

    while q_head < len(queue) {
        let u = queue[q_head]
        q_head = q_head + 1

        let neighbors = adj[u]
        let k = 0
        while k < len(neighbors) {
            let v = neighbors[k]
            if not visited[v] and capacity[u][v] > 0 {
                parent[v] = u
                visited[v] = true
                if v == t {
                    return true
                }
                queue = push(queue, v)
            }
            k = k + 1
        }
    }

    return visited[t]
}

pub fn edmonds_karp(n, adj, capacity, s, t) {
    let max_flow = 0
    let parent = dict()

    while bfs(n, adj, capacity, s, t, parent) {
        let path_flow = 999999999
        let curr = t
        while curr != s {
            let p = parent[curr]
            let cap = capacity[p][curr]
            if cap < path_flow {
                path_flow = cap
            }
            curr = p
        }

        curr = t
        while curr != s {
            let p = parent[curr]
            capacity[p][curr] = capacity[p][curr] - path_flow
            capacity[curr][p] = capacity[curr][p] + path_flow
            curr = p
        }

        max_flow = max_flow + path_flow
    }

    return max_flow
}

pub fn test_edmonds_karp_diamond_network() -> bool {
    let n = 4
    let adj = init_adj(n)
    let cap = init_matrix(n)

    add_edge(adj, cap, 0, 1, 3)
    add_edge(adj, cap, 0, 2, 2)
    add_edge(adj, cap, 1, 2, 5)
    add_edge(adj, cap, 1, 3, 2)
    add_edge(adj, cap, 2, 3, 3)

    let flow = edmonds_karp(n, adj, cap, 0, 3)
    if flow != 5 {
        return false
    }

    return true
}

pub fn test_edmonds_karp_parallel_routes() -> bool {
    let n = 4
    let adj = init_adj(n)
    let cap = init_matrix(n)

    add_edge(adj, cap, 0, 1, 7)
    add_edge(adj, cap, 0, 2, 8)
    add_edge(adj, cap, 1, 3, 7)
    add_edge(adj, cap, 2, 3, 8)

    let flow = edmonds_karp(n, adj, cap, 0, 3)
    if flow != 15 {
        return false
    }

    return true
}

pub fn test_edmonds_karp_single_bottleneck() -> bool {
    let n = 2
    let adj = init_adj(n)
    let cap = init_matrix(n)

    add_edge(adj, cap, 0, 1, 42)

    let flow = edmonds_karp(n, adj, cap, 0, 1)
    if flow != 42 {
        return false
    }

    return true
}

pub fn test_edmonds_karp_disconnected() -> bool {
    let n = 4
    let adj = init_adj(n)
    let cap = init_matrix(n)

    add_edge(adj, cap, 0, 1, 10)
    add_edge(adj, cap, 2, 3, 10)

    let flow = edmonds_karp(n, adj, cap, 0, 3)
    if flow != 0 {
        return false
    }

    return true
}

pub fn test_edmonds_karp_clrs_six_node() -> bool {
    let n = 6
    let adj = init_adj(n)
    let cap = init_matrix(n)

    add_edge(adj, cap, 0, 1, 10)
    add_edge(adj, cap, 0, 2, 10)
    add_edge(adj, cap, 1, 2, 2)
    add_edge(adj, cap, 1, 3, 4)
    add_edge(adj, cap, 1, 4, 8)
    add_edge(adj, cap, 2, 4, 9)
    add_edge(adj, cap, 3, 5, 10)
    add_edge(adj, cap, 4, 3, 6)
    add_edge(adj, cap, 4, 5, 10)

    let flow = edmonds_karp(n, adj, cap, 0, 5)
    if flow != 19 {
        return false
    }

    return true
}
