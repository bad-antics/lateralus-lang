// ===================================================================
// tests/stdlib_bucket_sort_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for Bucket Sort, O(n) expected time distribution
// sorting, uniform partitioning, and local insertion sort stability.
// ===================================================================

pub fn insertion_sort(bucket, size) {
    let i = 1
    while i < size {
        let key = bucket[i]
        let j = i - 1
        while j >= 0 && bucket[j] > key {
            bucket[j + 1] = bucket[j]
            j = j - 1
        }
        bucket[j + 1] = key
        i = i + 1
    }
    return bucket
}

pub fn bucket_sort(arr, n, num_buckets) {
    if n <= 1 {
        return arr
    }

    // 1. Find min and max values
    let min_val = arr[0]
    let max_val = arr[0]
    let i = 1
    while i < n {
        if arr[i] < min_val {
            min_val = arr[i]
        }
        if arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }

    if min_val == max_val {
        return arr
    }

    let range_span = max_val - min_val

    // 2. Initialize bucket storage and count arrays
    let buckets = dict()
    let bucket_sizes = dict()
    let b = 0
    while b < num_buckets {
        buckets[b] = dict()
        bucket_sizes[b] = 0
        b = b + 1
    }

    // 3. Scatter elements into buckets
    i = 0
    while i < n {
        let val = arr[i]
        let b_idx = ((val - min_val) * (num_buckets - 1)) / range_span
        if b_idx >= num_buckets {
            b_idx = num_buckets - 1
        }
        let cur_sz = bucket_sizes[b_idx]
        buckets[b_idx][cur_sz] = val
        bucket_sizes[b_idx] = cur_sz + 1
        i = i + 1
    }

    // 4. Sort each individual bucket using insertion sort
    b = 0
    while b < num_buckets {
        let sz = bucket_sizes[b]
        if sz > 1 {
            buckets[b] = insertion_sort(buckets[b], sz)
        }
        b = b + 1
    }

    // 5. Gather elements from buckets into output array
    let output = dict()
    let out_idx = 0
    b = 0
    while b < num_buckets {
        let sz = bucket_sizes[b]
        let j = 0
        while j < sz {
            output[out_idx] = buckets[b][j]
            out_idx = out_idx + 1
            j = j + 1
        }
        b = b + 1
    }

    return output
}

// -------------------------------------------------------------------
// Verification Tests
// -------------------------------------------------------------------

pub fn test_basic_positive_elements() {
    let arr = dict()
    arr[0] = 78; arr[1] = 17; arr[2] = 39; arr[3] = 26; arr[4] = 72; arr[5] = 94; arr[6] = 21; arr[7] = 12; arr[8] = 23; arr[9] = 68
    let sorted = bucket_sort(arr, 10, 5)

    assert(sorted[0] == 12, "Min element 12")
    assert(sorted[1] == 17, "Element 17")
    assert(sorted[2] == 21, "Element 21")
    assert(sorted[3] == 23, "Element 23")
    assert(sorted[4] == 26, "Element 26")
    assert(sorted[5] == 39, "Element 39")
    assert(sorted[6] == 68, "Element 68")
    assert(sorted[7] == 72, "Element 72")
    assert(sorted[8] == 78, "Element 78")
    assert(sorted[9] == 94, "Max element 94")
}

pub fn test_negative_and_zero_values() {
    let arr = dict()
    arr[0] = -15; arr[1] = 0; arr[2] = -40; arr[3] = 25; arr[4] = -5; arr[5] = 10
    let sorted = bucket_sort(arr, 6, 4)

    assert(sorted[0] == -40, "Min -40")
    assert(sorted[1] == -15, "Val -15")
    assert(sorted[2] == -5, "Val -5")
    assert(sorted[3] == 0, "Val 0")
    assert(sorted[4] == 10, "Val 10")
    assert(sorted[5] == 25, "Max 25")
}

pub fn test_duplicates_and_identical_elements() {
    let arr = dict()
    arr[0] = 50; arr[1] = 50; arr[2] = 50; arr[3] = 50
    let sorted = bucket_sort(arr, 4, 3)
    assert(sorted[0] == 50 && sorted[1] == 50 && sorted[2] == 50 && sorted[3] == 50, "Uniform elements handle correctly")
}

pub fn test_single_element() {
    let arr = dict()
    arr[0] = 99
    let sorted = bucket_sort(arr, 1, 3)
    assert(sorted[0] == 99, "Single element array unchanged")
}

pub fn main() {
    test_basic_positive_elements()
    test_negative_and_zero_values()
    test_duplicates_and_identical_elements()
    test_single_element()
    print("All Bucket Sort verification tests passed successfully!")
}
