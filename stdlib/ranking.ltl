--- Ranking standard library module for Lateralus
--- Provides TF-IDF, BM25, cosine similarity, and vector space ranking.

fn dot_product(v1, v2) {
    -- v1 and v2 are pairs of [[terms], [weights]]
    let terms1 = v1[0]
    let weights1 = v1[1]
    let terms2 = v2[0]
    let weights2 = v2[1]
    
    let sum = 0.0
    let i = 0
    while i < len(terms1) {
        let t = terms1[i]
        let w1 = weights1[i]
        let j = 0
        let found = false
        let w2 = 0.0
        while j < len(terms2) {
            if terms2[j] == t {
                w2 = weights2[j]
                found = true
            }
            j = j + 1
        }
        if found {
            sum = sum + (w1 * w2)
        }
        i = i + 1
    }
    sum
}

fn vector_norm(v) {
    let weights = v[1]
    let sum_sq = 0.0
    let i = 0
    while i < len(weights) {
        let w = weights[i]
        sum_sq = sum_sq + (w * w)
        i = i + 1
    }
    sqrt(sum_sq)
}

fn cosine_similarity(v1, v2) {
    let dp = dot_product(v1, v2)
    let n1 = vector_norm(v1)
    let n2 = vector_norm(v2)
    let denom = n1 * n2
    if denom == 0.0 {
        0.0
    } else {
        let sim = dp / denom
        if sim > 1.0 {
            1.0
        } else if sim < -1.0 {
            -1.0
        } else {
            sim
        }
    }
}

fn tfidf_weight(tf, idf) {
    tf * idf
}

fn bm25_score(doc_terms, doc_weights, query_terms, avg_dl, dl) {
    let k1 = 1.2
    let b = 0.75
    let score = 0.0
    let i = 0
    while i < len(query_terms) {
        let qt = query_terms[i]
        let j = 0
        let tf = 0.0
        let found = false
        while j < len(doc_terms) {
            if doc_terms[j] == qt {
                tf = doc_weights[j]
                found = true
            }
            j = j + 1
        }
        if found {
            let numerator = tf * (k1 + 1.0)
            let denominator = tf + k1 * (1.0 - b + b * (dl / avg_dl))
            score = score + (numerator / denominator)
        }
        i = i + 1
    }
    score
}