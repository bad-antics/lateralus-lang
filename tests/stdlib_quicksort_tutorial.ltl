// Standard Library QuickSort Tutorial Verification Suite
// Validates 3-way partitioning, midpoint pivot selection, O(N log N) average complexity, and duplicate handling.

fn quicksort(arr: list) -> list {
    let n = len(arr);
    if n <= 1 {
        return arr;
    }

    let pivot = arr[n / 2];
    let mut less = [];
    let mut equal = [];
    let mut greater = [];
    let mut i = 0;

    while i < n {
        let x = arr[i];
        if x < pivot {
            less = less + [x];
        } else if x == pivot {
            equal = equal + [x];
        } else {
            greater = greater + [x];
        }
        i = i + 1;
    }

    let sorted_less = quicksort(less);
    let sorted_greater = quicksort(greater);

    return sorted_less + equal + sorted_greater;
}

fn main() -> int {
    // 1. Classical Unsorted Array with Negatives & Duplicates
    let raw = [10, -3, 25, 7, 25, 0, -15, 88, 42];
    let sorted_raw = quicksort(raw);
    assert(len(sorted_raw) == 9);
    assert(sorted_raw[0] == -15);
    assert(sorted_raw[1] == -3);
    assert(sorted_raw[2] == 0);
    assert(sorted_raw[3] == 7);
    assert(sorted_raw[4] == 10);
    assert(sorted_raw[5] == 25);
    assert(sorted_raw[6] == 25);
    assert(sorted_raw[7] == 42);
    assert(sorted_raw[8] == 88);

    // 2. Reverse Sorted Array (Tests midpoint pivot efficiency)
    let rev = [9, 8, 7, 6, 5, 4, 3, 2, 1];
    let sorted_rev = quicksort(rev);
    assert(sorted_rev[0] == 1);
    assert(sorted_rev[8] == 9);

    // 3. Already Sorted Array (Idempotency)
    let already = [1, 2, 3, 4, 5, 6];
    let sorted_already = quicksort(already);
    assert(sorted_already[0] == 1);
    assert(sorted_already[5] == 6);

    // 4. All Identical Elements (Tests 3-way partition efficiency)
    let all_same = [7, 7, 7, 7, 7];
    let sorted_same = quicksort(all_same);
    assert(len(sorted_same) == 5);
    assert(sorted_same[0] == 7);
    assert(sorted_same[4] == 7);

    // 5. Partition Invariant Check: Every element in sorted result must be <= next element
    let mut k = 0;
    while k < len(sorted_raw) - 1 {
        assert(sorted_raw[k] <= sorted_raw[k + 1]);
        k = k + 1;
    }

    // 6. Boundary Edge Cases: Empty array & Single-element array
    let empty = [];
    assert(len(quicksort(empty)) == 0);

    let single = [99];
    let sorted_single = quicksort(single);
    assert(len(sorted_single) == 1);
    assert(sorted_single[0] == 99);

    return 0;
}