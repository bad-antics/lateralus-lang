// Lateralus Standard Library Example: Dijkstra's Shunting-Yard Algorithm
// Demonstrates infix mathematical parsing, operator precedence, and postfix RPN evaluation.

fn get_precedence(op: str) -> int {
    if op == "+" || op == "-" {
        return 1;
    }
    if op == "*" || op == "/" {
        return 2;
    }
    return 0;
}

fn is_operator(token: str) -> bool {
    if token == "+" || token == "-" || token == "*" || token == "/" {
        return true;
    }
    return false;
}

fn shunting_yard(tokens: list) -> list {
    let mut output = [];
    let mut op_stack = [];
    let mut i = 0;
    while i < len(tokens) {
        let tok = tokens[i];
        if is_operator(tok) {
            let mut prec = get_precedence(tok);
            let mut searching = true;
            while len(op_stack) > 0 && searching {
                let top_op = op_stack[len(op_stack) - 1];
                if is_operator(top_op) && get_precedence(top_op) >= prec {
                    output = output + [top_op];
                    op_stack = slice(op_stack, 0, len(op_stack) - 1);
                } else {
                    searching = false;
                }
            }
            op_stack = op_stack + [tok];
        } else {
            if tok == "(" {
                op_stack = op_stack + [tok];
            } else {
                if tok == ")" {
                    let mut found_paren = false;
                    while len(op_stack) > 0 && found_paren == false {
                        let top_op = op_stack[len(op_stack) - 1];
                        op_stack = slice(op_stack, 0, len(op_stack) - 1);
                        if top_op == "(" {
                            found_paren = true;
                        } else {
                            output = output + [top_op];
                        }
                    }
                } else {
                    output = output + [tok];
                }
            }
        }
        i = i + 1;
    }

    while len(op_stack) > 0 {
        let top_op = op_stack[len(op_stack) - 1];
        op_stack = slice(op_stack, 0, len(op_stack) - 1);
        if top_op != "(" && top_op != ")" {
            output = output + [top_op];
        }
    }

    return output;
}

fn rpn_eval(postfix: list) -> int {
    let mut val_stack = [];
    let mut i = 0;
    while i < len(postfix) {
        let tok = postfix[i];
        if is_operator(tok) {
            let n = len(val_stack);
            let b = val_stack[n - 1];
            let a = val_stack[n - 2];
            val_stack = slice(val_stack, 0, n - 2);

            let mut res = 0;
            if tok == "+" {
                res = a + b;
            } else {
                if tok == "-" {
                    res = a - b;
                } else {
                    if tok == "*" {
                        res = a * b;
                    } else {
                        if tok == "/" {
                            res = idiv(a, b);
                        }
                    }
                }
            }
            val_stack = val_stack + [res];
        } else {
            val_stack = val_stack + [to_int(tok)];
        }
        i = i + 1;
    }
    return val_stack[0];
}

fn main() -> int {
    println("=== Dijkstra's Shunting-Yard Expression Evaluator ===");

    // Infix tokens: ( ( 10 + 20 ) * 3 ) - ( 50 / 2 ) = ( 30 * 3 ) - 25 = 90 - 25 = 65
    let infix_tokens = ["(", "(", "10", "+", "20", ")", "*", "3", ")", "-", "(", "50", "/", "2", ")"];

    println("Parsing infix token stream:");
    let postfix = shunting_yard(infix_tokens);

    println("Generated Reverse Polish Notation (RPN) sequence:");
    let mut k = 0;
    while k < len(postfix) {
        println(postfix[k]);
        k = k + 1;
    }

    let result = rpn_eval(postfix);
    println("Evaluation result:");
    println(result); // 65

    println("Shunting-yard calculation completed successfully.");
    return 0;
}
