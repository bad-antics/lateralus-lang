// Rosetta Code · Collatz sequence · Lateralus
// Hailstone sequence for n, plus the longest chain below a limit.

fn collatz(n: int) -> list {
    let x = n
    let seq = [x]
    while x != 1 {
        if x % 2 == 0 { x = idiv(x, 2) } else { x = 3 * x + 1 }
        seq = seq + [x]
    }
    return seq
}

fn longest_below(limit: int) -> list {
    let best_n = 1
    let best_len = 1
    let i = 1
    while i < limit {
        let l = len(collatz(i))
        if l > best_len {
            best_len = l
            best_n = i
        }
        i = i + 1
    }
    return [best_n, best_len]
}

fn main() {
    let s = collatz(27)
    print("collatz(27) length = " + str(len(s)))
    assert_eq(len(s), 112, "27 chain length")
    assert_eq(slice(s, 0, 4), [27, 82, 41, 124], "27 head")
    let b = longest_below(1000)
    print("longest below 1000: n=" + str(b[0]) + " len=" + str(b[1]))
    assert_eq(b[0], 871, "longest n under 1000")
}

main()
