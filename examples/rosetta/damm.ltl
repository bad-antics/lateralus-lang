fn damm_validate(digits: string) -> bool {
    let table = [
        [0, 3, 1, 7, 5, 9, 8, 6, 4, 2],
        [7, 0, 9, 2, 1, 5, 4, 8, 6, 3],
        [4, 2, 0, 6, 8, 7, 1, 3, 5, 9],
        [1, 7, 5, 0, 9, 8, 3, 4, 2, 6],
        [6, 1, 2, 3, 0, 4, 5, 9, 7, 8],
        [3, 6, 4, 8, 2, 0, 7, 1, 5, 9],
        [5, 8, 7, 9, 6, 3, 0, 2, 4, 1],
        [8, 9, 6, 4, 3, 1, 2, 0, 7, 5],
        [2, 5, 3, 1, 7, 6, 9, 4, 0, 8],
        [9, 4, 8, 5, 2, 6, 1, 7, 3, 0]
    ]
    let mut interim = 0
    for c in digits.chars() {
        let digit = c.to_digit(10)
        interim = table[interim][digit]
    }
    interim == 0
}

fn main() {
    assert_eq(damm_validate("5724"), true)
    assert_eq(damm_validate("5725"), false)
    print("Damm algorithm verified successfully.")
}
