// Boyer-Moore String Search Algorithm Test Vectors
// Comprehensive test cases for the algorithm implementation

// Test helper function
function assert_equals(actual, expected, test_name) {
    if (actual == expected) {
        print(`✓ PASS: ${test_name}`);
        return true;
    } else {
        print(`✗ FAIL: ${test_name}`);
        print(`  Expected: ${expected}`);
        print(`  Actual: ${actual}`);
        return false;
    }
}

// Test 1: Single occurrence in the middle
function test_single_occurrence() {
    let text = "The quick brown fox jumps over the lazy dog";
    let pattern = "fox";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 1, "Single occurrence test") && 
           assert_equals(result[0], 16, "Single occurrence position test");
}

// Test 2: Multiple occurrences
function test_multiple_occurrences() {
    let text = "abababababab";
    let pattern = "aba";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 4, "Multiple occurrences count test") && 
           assert_equals(result.join(","), "0,2,4,6", "Multiple occurrences positions test");
}

// Test 3: Pattern at the beginning (prefix)
function test_prefix_occurrence() {
    let text = "pattern at the beginning";
    let pattern = "pattern";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 1, "Prefix occurrence test") && 
           assert_equals(result[0], 0, "Prefix occurrence position test");
}

// Test 4: Pattern at the end (suffix)
function test_suffix_occurrence() {
    let text = "this is a pattern at the end";
    let pattern = "end";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 1, "Suffix occurrence test") && 
           assert_equals(result[0], 25, "Suffix occurrence position test");
}

// Test 5: Pattern absent
function test_pattern_absent() {
    let text = "This text does not contain the pattern";
    let pattern = "xyz";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 0, "Pattern absent test");
}

// Test 6: Pattern longer than text
function test_pattern_longer_than_text() {
    let text = "short";
    let pattern = "this pattern is longer";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 0, "Pattern longer than text test");
}

// Test 7: Empty pattern
function test_empty_pattern() {
    let text = "some text";
    let pattern = "";
    let result = boyer_moore_search(text, pattern);
    // Note: This behavior may vary based on implementation
    return assert_equals(result.length, 0, "Empty pattern test");
}

// Test 8: Empty text
function test_empty_text() {
    let text = "";
    let pattern = "pattern";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 0, "Empty text test");
}

// Test 9: Single character pattern
function test_single_char_pattern() {
    let text = "aaaaaa";
    let pattern = "a";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 6, "Single char pattern count test") && 
           assert_equals(result.join(","), "0,1,2,3,4,5", "Single char pattern positions test");
}

// Test 10: Single character text
function test_single_char_text() {
    let text = "a";
    let pattern = "a";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 1, "Single char text test") && 
           assert_equals(result[0], 0, "Single char text position test");
}

// Test 11: Pattern with special characters
function test_special_characters() {
    let text = "Error #404: Not Found!";
    let pattern = "#404";
    let result = boyer_moore_search(text, pattern);
    return assert_equals(result.length, 1, "Special characters test") && 
           assert_equals(result[0], 6, "Special characters position test");
}

// Test 12: Overlapping occurrences
function test_overlapping_occurrences() {
    let text = "abababa";
    let pattern = "aba";
    let result = boyer_moore_search(text, pattern);
    // Boyer-Moore typically doesn't find overlapping occurrences
    return assert_equals(result.length, 2, "Overlapping occurrences test") && 
           assert_equals(result.join(","), "0,2", "Overlapping occurrences positions test");
}

// Run all tests
function run_all_tests() {
    print("=== Boyer-Moore Algorithm Test Suite ===");
    
    let tests = [
        test_single_occurrence,
        test_multiple_occurrences,
        test_prefix_occurrence,
        test_suffix_occurrence,
        test_pattern_absent,
        test_pattern_longer_than_text,
        test_empty_pattern,
        test_empty_text,
        test_single_char_pattern,
        test_single_char_text,
        test_special_characters,
        test_overlapping_occurrences
    ];
    
    let passed = 0;
    let total = tests.length;
    
    for (let test of tests) {
        if (test()) {
            passed++;
        }
    }
    
    print(`\n=== Test Results ===`);
    print(`Passed: ${passed}/${total}`);
    
    if (passed == total) {
        print("All tests passed!");
    } else {
        print(`${total - passed} tests failed.`);
    }
}

// Execute the test suite
run_all_tests();
