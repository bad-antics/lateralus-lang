#!/usr/bin/env lateralus
import "base64"
fn test_rfc4648() {
    let cases = [
        {input: "", std: "", url: ""},
        {input: "f", std: "Zg==", url: "Zg"},
        {input: "fo", std: "Zm8=", url: "Zm8"},
        {input: "foo", std: "Zm9v", url: "Zm9v"},
        {input: "foob", std: "Zm9vYg==", url: "Zm9vYg"},
        {input: "foobar", std: "Zm9vYmFy", url: "Zm9vYmFy"},
    ]
    for tc in cases {
        let data = base64.utf8_to_bytes(tc.input)
        let std_enc = base64.encode(data)
        assert(std_enc == tc.std)
        let url_enc = base64.encode_url(data)
        assert(url_enc == tc.url)
        let dec = base64.decode_url(url_enc)
        assert(base64.bytes_to_utf8(dec) == tc.input)
    }
    print("RFC 4648: PASSED")
}
fn test_no_pad() {
    let data = base64.utf8_to_bytes("Hello")
    let padded = base64.encode(data)
    let no_pad = base64.encode_no_pad(data)
    assert(padded == "SGVsbG8=")
    assert(no_pad == "SGVsbG8")
    assert(base64.bytes_to_utf8(base64.decode(padded)) == "Hello")
    assert(base64.bytes_to_utf8(base64.decode_no_pad(no_pad)) == "Hello")
    print("No-padding: PASSED")
}
fn test_validation() {
    assert(base64.is_valid("SGVsbG8=") == true)
    assert(base64.is_valid("SGVsbG8") == false)
    assert(base64.is_valid_url("SGVsbG8") == true)
    assert(base64.is_valid_url("SGVs-bG8") == false)
    print("Validation: PASSED")
}
fn test_lengths() {
    assert(base64.encoded_length(3) == 4)
    assert(base64.decoded_length(4) == 3)
    assert(base64.max_encoded_length(3) == 4)
    print("Lengths: PASSED")
}
fn test_errors() {
    try { base64.decode("invalid!!!"); assert(false) } catch e { print("Error caught") }
    try { base64.decode("YQ"); assert(false) } catch e { print("Length error caught") }
    print("Errors: PASSED")
}
fn main() { test_rfc4648(); test_no_pad(); test_validation(); test_lengths(); test_errors(); print("All base64 tests PASSED") }