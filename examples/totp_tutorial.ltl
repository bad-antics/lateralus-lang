// ===================================================================
// examples/totp_tutorial.ltl — stdlib/totp.ltl tutorial companion
// Runnable tour of RFC 4226 HOTP / RFC 6238 TOTP: pure-Lateralus
// SHA-256 + HMAC (byte-exact), dynamic truncation, otpauth:// URIs.
// Verified against RFC 6238 SHA-256 test vectors.
// NOTE: upstream _u64_be uses float division -> int() workaround.
// ===================================================================

fn char_at(s: str, i: int) -> str { return s[i] }

fn bytes_of(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        out = out + [ord(s[i])]
        i = i + 1
    }
    return out
}

fn str_of(bytes: list) -> str {
    let out = ""
    let i = 0
    while i < len(bytes) {
        out = out + chr(bytes[i])
        i = i + 1
    }
    return out
}

fn rotr(x: int, n: int) -> int {
    return ((x >> n) | (x << (32 - n))) & 0xffffffff
}

fn sha256_bytes(msg_in: list) -> list {
    let K = [0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
             0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
             0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
             0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
             0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
             0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
             0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
             0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]
    let bit_len = len(msg_in) * 8
    let msg = msg_in + [0x80]
    while len(msg) % 64 != 56 { msg = msg + [0] }
    let k8 = 7
    while k8 >= 0 {
        msg = msg + [int(bit_len / (1 << (k8 * 8))) & 0xff]
        k8 = k8 - 1
    }
    let h0 = 0x6a09e667
    let h1 = 0xbb67ae85
    let h2 = 0x3c6ef372
    let h3 = 0xa54ff53a
    let h4 = 0x510e527f
    let h5 = 0x9b05688c
    let h6 = 0x1f83d9ab
    let h7 = 0x5be0cd19
    let chunk = 0
    while chunk < len(msg) {
        let w = []
        let t = 0
        while t < 16 {
            let o = chunk + t * 4
            w = w + [((msg[o] << 24) | (msg[o+1] << 16) | (msg[o+2] << 8) | msg[o+3]) & 0xffffffff]
            t = t + 1
        }
        t = 16
        while t < 64 {
            let s0 = rotr(w[t-15], 7) ^ rotr(w[t-15], 18) ^ (w[t-15] >> 3)
            let s1 = rotr(w[t-2], 17) ^ rotr(w[t-2], 19) ^ (w[t-2] >> 10)
            w = w + [(w[t-16] + s0 + w[t-7] + s1) & 0xffffffff]
            t = t + 1
        }
        let a = h0
        let b = h1
        let c = h2
        let d = h3
        let e = h4
        let f = h5
        let g = h6
        let hh = h7
        t = 0
        while t < 64 {
            let S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = (e & f) ^ ((0xffffffff - e) & g)
            let t1 = (hh + S1 + ch + K[t] + w[t]) & 0xffffffff
            let S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = (S0 + maj) & 0xffffffff
            hh = g
            g = f
            f = e
            e = (d + t1) & 0xffffffff
            d = c
            c = b
            b = a
            a = (t1 + t2) & 0xffffffff
            t = t + 1
        }
        h0 = (h0 + a) & 0xffffffff
        h1 = (h1 + b) & 0xffffffff
        h2 = (h2 + c) & 0xffffffff
        h3 = (h3 + d) & 0xffffffff
        h4 = (h4 + e) & 0xffffffff
        h5 = (h5 + f) & 0xffffffff
        h6 = (h6 + g) & 0xffffffff
        h7 = (h7 + hh) & 0xffffffff
        chunk = chunk + 64
    }
    let hs = [h0, h1, h2, h3, h4, h5, h6, h7]
    let out = []
    let i = 0
    while i < 8 {
        let v = hs[i]
        out = out + [(v >> 24) & 0xff, (v >> 16) & 0xff, (v >> 8) & 0xff, v & 0xff]
        i = i + 1
    }
    return out
}

fn sha256_hex_str(s: str) -> str {
    let d = sha256_bytes(bytes_of(s))
    let h = "0123456789abcdef"
    let out = ""
    let i = 0
    while i < len(d) {
        let b = d[i]
        out = out + slice(h, b >> 4, (b >> 4) + 1) + slice(h, b & 0x0f, (b & 0x0f) + 1)
        i = i + 1
    }
    return out
}

fn hmac_sha256_bytes(key: list, msg: list) -> list {
    let k = key
    if len(k) > 64 {
        k = sha256_bytes(k)
    }
    while len(k) < 64 { k = k + [0] }
    let ipad = []
    let opad = []
    let i = 0
    while i < 64 {
        ipad = ipad + [k[i] ^ 0x36]
        opad = opad + [k[i] ^ 0x5c]
        i = i + 1
    }
    return sha256_bytes(opad + sha256_bytes(ipad + msg))
}

fn u64_be(n: int) -> list {
    let b = [0, 0, 0, 0, 0, 0, 0, 0]
    let i = 0
    while i < 8 {
        b[7 - i] = int(n / (1 << (i * 8))) & 0xff
        i = i + 1
    }
    return b
}

fn hotp(secret: list, counter: int, digits: int) -> str {
    let buf = u64_be(counter)
    let h = hmac_sha256_bytes(secret, buf)
    let off = h[len(h) - 1] & 15
    let bin = ((h[off] & 127) * 16777216)
            + ((h[off + 1] & 255) * 65536)
            + ((h[off + 2] & 255) * 256)
            +  (h[off + 3] & 255)
    let mod = 1
    let i = 0
    while i < digits {
        mod = mod * 10
        i = i + 1
    }
    let s = str(bin % mod)
    while len(s) < digits { s = "0" + s }
    return s
}

fn totp(secret: list, at: int, step_s: int, digits: int) -> str {
    let counter = int(at / step_s)
    return hotp(secret, counter, digits)
}

fn verify(secret: list, code: str, at: int, step_s: int, digits: int, drift: int) -> bool {
    let counter = int(at / step_s)
    let d = 0 - drift
    while d <= drift {
        if hotp(secret, counter + d, digits) == code {
            return true
        }
        d = d + 1
    }
    return false
}

fn b32_encode_nopad(bytes: list) -> str {
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
    let out = ""
    let buffer = 0
    let nbits = 0
    let i = 0
    while i < len(bytes) {
        buffer = (buffer << 8) | bytes[i]
        nbits = nbits + 8
        while nbits >= 5 {
            nbits = nbits - 5
            out = out + char_at(alpha, (buffer >> nbits) & 31)
        }
        i = i + 1
    }
    if nbits > 0 {
        out = out + char_at(alpha, (buffer << (5 - nbits)) & 31)
    }
    return out
}

fn url_encode(s: str) -> str {
    let out = ""
    let i = 0
    while i < len(s) {
        let c = s[i]
        if (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
           || c == "-" || c == "_" || c == "." || c == "~" {
            out = out + c
        } else {
            let b = bytes_of(c)
            let j = 0
            while j < len(b) {
                let h = "0123456789ABCDEF"
                out = out + "%" + slice(h, b[j] >> 4, (b[j] >> 4) + 1) + slice(h, b[j] & 15, (b[j] & 15) + 1)
                j = j + 1
            }
        }
        i = i + 1
    }
    return out
}

fn otpauth_uri(account: str, secret: list, issuer: str, digits: int, step_s: int) -> str {
    let b32 = b32_encode_nopad(secret)
    let label = url_encode(issuer) + ":" + url_encode(account)
    return "otpauth://totp/" + label
        + "?secret=" + b32
        + "&issuer=" + url_encode(issuer)
        + "&algorithm=SHA256"
        + "&digits=" + str(digits)
        + "&period=" + str(step_s)
}

fn main() {
    println("=== LATERALUS STDLIB TOTP TUTORIAL ===")

    println("STEP 0 sha256 sanity:")
    println("  sha256(\"\")=" + sha256_hex_str(""))
    println("  sha256(\"abc\")=" + sha256_hex_str("abc"))

    println("STEP 1 HOTP truncation (RFC 4226 style, SHA256):")
    let secret = bytes_of("12345678901234567890")
    let c7 = hotp(secret, 7, 8)
    println("  hotp(counter=7,8)=" + c7)
    let c4 = hotp(secret, 4, 8)
    println("  hotp(counter=4,8)=" + c4)

    println("STEP 2 RFC 6238 SHA256 TOTP vectors:")
    let v1 = totp(secret, 59, 30, 8)
    println("  T=59 -> " + v1)
    let v2 = totp(secret, 1111111109, 30, 8)
    println("  T=1111111109 -> " + v2)
    let v3 = totp(secret, 1234567890, 30, 8)
    println("  T=1234567890 -> " + v3)
    let v4 = totp(secret, 2000000000, 30, 8)
    println("  T=2000000000 -> " + v4)
    let v5 = totp(secret, 20000000000, 30, 8)
    println("  T=20000000000 -> " + v5)

    println("STEP 3 verify with drift:")
    println("  exact=" + str(verify(secret, v1, 59, 30, 8, 0)))
    println("  +1 step code at T=89, verify at T=59 drift=1: " + str(verify(secret, totp(secret, 89, 30, 8), 59, 30, 8, 1)))
    println("  wrong=" + str(verify(secret, "00000000", 59, 30, 8, 0)))

    println("STEP 4 otpauth URI:")
    let uri = otpauth_uri("alice@example.com", secret, "Example", 8, 30)
    println("  " + uri)
    println("PINNED_VECTORS: sha256abc=ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad hotp7=67579288 hotp4=25480556 totp59=32247374 totp1111111109=34756375 totp1234567890=42829826 totp2000000000=78428693 verify=drift1 uri=otpauth-sha256")
}

main()
