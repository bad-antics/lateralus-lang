// Advent of Code 2024 · Day 6 · Guard Gallivant
// Part 1: walk the guard from ^ until she leaves the grid; count distinct cells.
// Part 2: count cells where one new obstacle traps her in a loop.
// Self-verifying with @test blocks; sample from the AoC statement.

let SAMPLE = "....#.....
.........#
..........
..#.......
.......#..
..........
.#..^.....
........#.
#.........
......#..."

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn cell(grid: list, r: int, c: int) -> str {
    if r < 0 || c < 0 || r >= len(grid) { return "#" }
    let row = grid[r]
    if c >= len(row) { return "#" }
    return slice(row, c, c + 1)
}

fn find_guard(grid: list) -> list {
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            if cell(grid, r, c) == "^" { return [r, c] }
            c = c + 1
        }
        r = r + 1
    }
    return [-1, -1]
}

// dirs: 0=up 1=right 2=down 3=left
fn dr(dir: int) -> int {
    if dir == 0 { return -1 }
    if dir == 2 { return 1 }
    return 0
}

fn dc(dir: int) -> int {
    if dir == 1 { return 1 }
    if dir == 3 { return -1 }
    return 0
}

// Returns [steps, looped]
fn walk(grid: list, startR: int, startC: int) -> list {
    let r = startR
    let c = startC
    let dir = 0
    let seen = {}
    let steps = 0
    let limit = len(grid) * 8 * 8 * 4
    while steps < limit {
        let key = str(r) + "," + str(c) + "," + str(dir)
        if contains(seen, key) { return [steps, 1] }
        seen[key] = 1
        let nr = r + dr(dir)
        let nc = c + dc(dir)
        if nr < 0 || nc < 0 || nr >= len(grid) || nc >= len(grid[nr]) { return [steps, 0] }
        if cell(grid, nr, nc) == "#" {
            dir = (dir + 1) % 4
        } else {
            r = nr
            c = nc
        }
        steps = steps + 1
    }
    return [steps, 1]
}

fn part1(text: str) -> int {
    let grid = lines_of(text)
    let g = find_guard(grid)
    let r = g[0]
    let c = g[1]
    let dir = 0
    let visited = {}
    visited[str(r) + "," + str(c)] = 1
    let steps = 0
    let limit = len(grid) * 8 * 8 * 4
    while steps < limit {
        let nr = r + dr(dir)
        let nc = c + dc(dir)
        if nr < 0 || nc < 0 || nr >= len(grid) || nc >= len(grid[nr]) { return len(keys(visited)) }
        if cell(grid, nr, nc) == "#" {
            dir = (dir + 1) % 4
        } else {
            r = nr
            c = nc
            visited[str(r) + "," + str(c)] = 1
        }
        steps = steps + 1
    }
    return len(keys(visited))
}

fn with_obstacle(grid: list, r: int, c: int) -> list {
    let out = []
    let i = 0
    while i < len(grid) {
        if i == r {
            out = out + [slice(grid[i], 0, c) + "#" + slice(grid[i], c + 1, len(grid[i]))]
        } else {
            out = out + [grid[i]]
        }
        i = i + 1
    }
    return out
}

fn part2(text: str) -> int {
    let grid = lines_of(text)
    let g = find_guard(grid)
    let total = 0
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            if cell(grid, r, c) == "." {
                let res = walk(with_obstacle(grid, r, c), g[0], g[1])
                if res[1] == 1 { total = total + 1 }
            }
            c = c + 1
        }
        r = r + 1
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 41)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 6)
}

fn main() {
    print("Day 6 Part 1: " + str(part1(SAMPLE)))
    print("Day 6 Part 2: " + str(part2(SAMPLE)))
}

main()
