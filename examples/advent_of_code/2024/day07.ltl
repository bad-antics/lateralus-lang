// Advent of Code 2024 · Day 7 · Bridge Repair
// Part 1: sum test values reachable by inserting + and * between the numbers (left to right).
// Part 2: same, but the || concatenation operator is also allowed.

let SAMPLE = "190: 10 19
3267: 81 40 27
83: 17 5
156: 15 6
7290: 6 8 6 15
161011: 16 10 13
192: 17 8 14
21037: 9 7 18 13
292: 11 6 16 20"

// Each equation becomes [target, [n0, n1, ...]].
fn parse(text: str) -> list {
    let eqs = []
    for raw in str_split(text, "\n") {
        let line = str_trim(raw)
        if len(line) == 0 { continue }
        let halves = str_split(line, ": ")
        let nums = []
        for tok in str_split(str_trim(halves[1]), " ") { nums.append(int(tok)) }
        eqs.append([int(halves[0]), nums])
    }
    return eqs
}

// Smallest power of ten greater than n, i.e. the shift used by n's concatenation.
fn shift_for(n: int) -> int {
    let p = 10
    while p <= n { p = p * 10 }
    return p
}

// Work backwards from the target: the last operator applied to nums[i] must
// undo cleanly (subtract, exact divide, or strip the trailing digits), which
// prunes almost every branch instead of trying all 3^n operator combos.
fn solvable(target: int, nums: list, i: int, concat: bool) -> bool {
    let n = nums[i]
    if i == 0 { return target == n }
    if target >= n && solvable(target - n, nums, i - 1, concat) { return true }
    if n != 0 && imod(target, n) == 0 && solvable(idiv(target, n), nums, i - 1, concat) {
        return true
    }
    if concat {
        let p = shift_for(n)
        if target >= n && imod(target - n, p) == 0
            && solvable(idiv(target - n, p), nums, i - 1, concat) {
            return true
        }
    }
    return false
}

fn total_solvable(text: str, concat: bool) -> int {
    let total = 0
    for eq in parse(text) {
        let nums = eq[1]
        if solvable(eq[0], nums, len(nums) - 1, concat) { total = total + eq[0] }
    }
    return total
}

fn part1(text: str) -> int {
    return total_solvable(text, false)
}

fn part2(text: str) -> int {
    return total_solvable(text, true)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 3749)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 11387)
}

fn main() {
    print("Day 7 Part 1: " + str(part1(SAMPLE)))
    print("Day 7 Part 2: " + str(part2(SAMPLE)))
}

main()
