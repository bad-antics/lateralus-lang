// examples/bitops_tutorial.ltl - Demonstrates stdlib.bitops primitives
import stdlib.bitops

fn main() {
    let mut flags = 0
    flags = bitops.bit_set(flags, 0)
    flags = bitops.bit_set(flags, 4)
    flags = bitops.bit_set(flags, 7)
    
    let has_bit4 = bitops.bit_test(flags, 4)
    let total_active = bitops.popcount(flags)
    
    let swapped = bitops.bswap32(0xAABBCCDD)
    let rot = bitops.rotl32(0x80000000, 1)
    let p2 = bitops.is_power_of_2(256)
    let next_aligned = bitops.next_power_of_2(300)
}
