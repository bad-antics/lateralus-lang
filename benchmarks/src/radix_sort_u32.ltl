// Radix sort (LSD, base 256) of 100,000 u32 keys.
// Keys: Numerical Recipes LCG (seed 2024), 100,000 keys.
// Output: "<first5...> <last5...> <sum>"
// Expected output: 112674 116504 238608 245714 255117 4294921298 4294923275 4294935315 4294939266 4294949596 214657873537904
import radix_sort

fn main() {
    let n = 100000
    let keys = [0] * n
    let st = 2024
    let i = 0
    while i < n {
        st = (1664525 * st + 1013904223) % 4294967296
        keys[i] = st
        i = i + 1
    }
    let srt = radix_sort.radix_sort_u32(keys)
    let total = 0
    let j = 0
    while j < n {
        total = total + srt[j]
        j = j + 1
    }
    let line = str(srt[0]) + " " + str(srt[1]) + " " + str(srt[2]) + " " + str(srt[3]) + " " + str(srt[4]) + " " + str(srt[n - 5]) + " " + str(srt[n - 4]) + " " + str(srt[n - 3]) + " " + str(srt[n - 2]) + " " + str(srt[n - 1]) + " " + str(total)
    println(line)
}

main()
