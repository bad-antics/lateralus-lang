import stdlib/deque

fn main() {
    let d = deque.new()
    d = deque.push_back(d, 1)
    d = deque.push_back(d, 2)
    d = deque.push_front(d, 0)
    
    assert(deque.size(d) == 3)
    assert(deque.front(d) == 0)
    assert(deque.back(d) == 2)
    
    let [val, d2] = deque.pop_front(d)
    assert(val == 0)
    assert(deque.size(d2) == 2)
    
    let d3 = deque.rotate_left(d, 1)
    assert(deque.front(d3) == 1)
    
    print("Deque tests passed")
}
