#!/usr/bin/env lateralus
import roaring

fn main() {
    let a = new_bitmap()
    a = add(a, 1)
    a = add(a, 42)
    a = add(a, 65536)
    a = add(a, 65537)
    a = add(a, 131072)
    a = add(a, 42)

    let b = new_bitmap()
    b = add(b, 42)
    b = add(b, 999)
    b = add(b, 65537)

    let u = union(a, b)
    print("a cardinality:", cardinality(a))
    print("a has 65536:", has(a, 65536))
    print("a to_list:", to_list(a))
    print("union cardinality:", cardinality(u))
    print("union to_list:", to_list(u))
}
main()
