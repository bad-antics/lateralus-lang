// Advent of Code 2024 · Day 19 · Linen Layout
// Part 1: how many designs can be built by concatenating available towel patterns.
// Part 2: total number of different ways to build all the designs.

let SAMPLE = "r, wr, b, g, bwu, rb, gb, br

brwrr
bggr
gbbr
rrbgbr
ubwu
bwurrg
brgr
bbrgwb"

// Returns [towel_set, longest_towel_length, designs].
fn parse(text: str) -> list {
    let lines = str_split(str_trim(text), "\n")
    let towels = set()
    let longest = 0
    for t in str_split(lines[0], ",") {
        let towel = str_trim(t)
        towels.add(towel)
        if len(towel) > longest { longest = len(towel) }
    }
    let designs = []
    for i in range(1, len(lines)) {
        let d = str_trim(lines[i])
        if len(d) > 0 { designs.append(d) }
    }
    return [towels, longest, designs]
}

// Classic prefix DP: ways[i] = number of ways to build design[0..i].
// Each step only tries substrings up to the longest towel, looked up in a set.
fn count_ways(design: str, towels: set, longest: int) -> int {
    let n = len(design)
    let ways = [0] * (n + 1)
    ways[0] = 1
    for i in range(0, n) {
        if ways[i] == 0 { continue }
        let stop = min([n, i + longest])
        for j in range(i + 1, stop + 1) {
            if contains(towels, slice(design, i, j)) {
                ways[j] = ways[j] + ways[i]
            }
        }
    }
    return ways[n]
}

fn part1(text: str) -> int {
    let p = parse(text)
    let possible = 0
    for d in p[2] {
        if count_ways(d, p[0], p[1]) > 0 { possible = possible + 1 }
    }
    return possible
}

fn part2(text: str) -> int {
    let p = parse(text)
    let total = 0
    for d in p[2] {
        total = total + count_ways(d, p[0], p[1])
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 6)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 16)
}

@test
fn test_single_designs() {
    let p = parse(SAMPLE)
    assert_eq(count_ways("brwrr", p[0], p[1]), 2)
    assert_eq(count_ways("rrbgbr", p[0], p[1]), 6)
    assert_eq(count_ways("ubwu", p[0], p[1]), 0)
}

fn main() {
    print("Day 19 Part 1: " + str(part1(SAMPLE)))
    print("Day 19 Part 2: " + str(part2(SAMPLE)))
}

main()
