// Rosetta Code · Binary search · Lateralus
// Iterative binary search over a sorted list of ints; -1 when absent.

fn binary_search(haystack: list, needle: int) -> int {
    let lo = 0
    let hi = len(haystack) - 1
    while lo <= hi {
        let mid = lo + idiv(hi - lo, 2)
        let v = haystack[mid]
        if v == needle { return mid }
        if v < needle { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}

fn main() {
    let xs = [1, 3, 5, 7, 9, 11, 13, 17, 19, 23, 29, 31]
    assert_eq(binary_search(xs, 1), 0, "first")
    assert_eq(binary_search(xs, 31), 11, "last")
    assert_eq(binary_search(xs, 13), 6, "middle")
    assert_eq(binary_search(xs, 8), -1, "absent")
    print("binary_search: all assertions passed")
}

main()
