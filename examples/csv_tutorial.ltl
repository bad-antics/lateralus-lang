// examples/csv_tutorial.ltl - Practical CSV Data Processing
// Demonstrates RFC 4180 parsing, quoted fields, dictionary transformation, and structured CSV generation.

import csv

fn process_customer_records(raw_csv: str) {
    println("--- Parsing CSV with Header Records ---")
    let records = csv.parse_dict(raw_csv, ",")
    
    for customer in records {
        let name = customer["name"]
        let email = customer["email"]
        let balance = customer["balance"]
        println("Customer: " + name + " | Email: " + email + " | Balance: $" + balance)
    }
}

fn export_summary_csv() -> str {
    println("\n--- Exporting Formatted CSV ---")
    let headers = ["id", "service", "status"]
    
    let mut s1 = map_new()
    s1["id"] = "101"
    s1["service"] = "Payment API"
    s1["status"] = "ACTIVE"
    
    let mut s2 = map_new()
    s2["id"] = "102"
    s2["service"] = "Database, Replicated"
    s2["status"] = "ONLINE"
    
    return csv.generate_dict([s1, s2], headers, ",")
}

fn main() {
    println("=== Lateralus CSV Standard Library ===")
    
    let sample_data = "name,email,balance\nAlice Smith,alice@example.com,1420.50\nBob \"The Builder\" Jones,bob@example.com,350.00\nCarol Martinez,\"carol,sales@example.com\",2890.00\n"
    
    // 1. Parse and extract records
    process_customer_records(sample_data)
    
    // 2. Generate structured export
    let output = export_summary_csv()
    println("Generated Output:\n" + output)
}
