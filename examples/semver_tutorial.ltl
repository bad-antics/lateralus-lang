// ===================================================================
// examples/semver_tutorial.ltl
//
// Tutorial: Semantic Versioning 2.0.0 (SemVer) with Lateralus
// stdlib/semver.ltl.
//
// Demonstrates:
// 1. Parsing semver strings with build metadata and pre-release tags.
// 2. Precedence comparisons and stable vs. prerelease checks.
// 3. Automated release bumping (Major, Minor, Patch).
// 4. Dependency range satisfaction for package managers (^ and ~).
// ===================================================================

import semver

pub fn main() {
    print("=== Lateralus SemVer 2.0.0 Tutorial ===")

    // 1. Parsing complex versions
    let raw = "v1.4.2-rc.2+build.20261122"
    let v = semver_parse(raw)

    print("Parsed version: " + raw)
    print("  Major: " + str(semver_major(v)))
    print("  Minor: " + str(semver_minor(v)))
    print("  Patch: " + str(semver_patch(v)))
    print("  Prerelease: " + semver_prerelease(v))
    print("  Build metadata: " + semver_build_meta(v))
    print("  Is prerelease: " + str(semver_is_prerelease(v)))

    // 2. Version precedence comparisons
    let v_stable = semver_parse("1.4.2")
    let v_old = semver_parse("1.4.1")

    if semver_gt(v_stable, v) {
        print("PASS: Stable release 1.4.2 takes precedence over 1.4.2-rc.2")
    }

    if semver_gt(v_stable, v_old) {
        print("PASS: 1.4.2 is newer than 1.4.1")
    }

    // 3. Automated release bumping
    let next_bugfix = semver_bump_patch(v_stable)
    let next_feature = semver_bump_minor(v_stable)
    let next_breaking = semver_bump_major(v_stable)

    print("Release progression:")
    print("  Current: " + semver_to_string(v_stable))
    print("  Patch bump: " + semver_to_string(next_bugfix))
    print("  Minor bump: " + semver_to_string(next_feature))
    print("  Major bump: " + semver_to_string(next_breaking))

    // 4. Dependency range resolution
    // Suppose a package.json / ltl.toml specifies dependency "^1.4"
    let candidate_versions = [
        semver_parse("1.3.9"),
        semver_parse("1.4.0"),
        semver_parse("1.4.3"),
        semver_parse("1.5.0"),
        semver_parse("2.0.0")
    ]

    print("Evaluating dependency constraint ^1.4 across releases:")
    let i = 0
    while i < len(candidate_versions) {
        let cand = candidate_versions[i]
        let cand_str = semver_to_string(cand)
        if semver_satisfies_caret(cand, 1, 4) {
            print("  [ALLOW] " + cand_str + " matches compatible range ^1.4")
        } else {
            print("  [DENY]  " + cand_str + " incompatible with ^1.4")
        }
        i = i + 1
    }

    print("=== SemVer tutorial completed successfully ===")
}
