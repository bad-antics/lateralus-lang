// ===================================================================
// examples/template_tutorial.ltl — stdlib/template.ltl tutorial companion
// Runnable tour of the template module: <<name>> variable delimiters,
// render / render_default / extract_vars, list rendering and HTML
// escaping. Self-contained so it runs on `lateralus run`.
// Variables are passed as a list of [name, value] pairs so lookup is
// explicit and deterministic.
// ===================================================================

fn lookup(vars: list, name: str) -> str {
    let i = 0
    while i < len(vars) {
        if vars[i][0] == name {
            return vars[i][1]
        }
        i = i + 1
    }
    return ""
}

fn has_var(vars: list, name: str) -> bool {
    let i = 0
    while i < len(vars) {
        if vars[i][0] == name { return true }
        i = i + 1
    }
    return false
}

// Find the closing ">>" for a "<<" that starts at i; returns end index or -1.
fn find_close(tmpl: str, i: int) -> int {
    let j = i + 2
    while j + 1 < len(tmpl) {
        if tmpl[j] == ">" && tmpl[j + 1] == ">" {
            return j
        }
        j = j + 1
    }
    return -1
}

fn render(tmpl: str, vars: list) -> str {
    let result = ""
    let i = 0
    while i < len(tmpl) {
        if i + 1 < len(tmpl) && tmpl[i] == "<" && tmpl[i + 1] == "<" {
            let j = find_close(tmpl, i)
            if j >= 0 {
                let name = str_trim(slice(tmpl, i + 2, j))
                if has_var(vars, name) {
                    result = result + lookup(vars, name)
                } else {
                    result = result + "<<" + name + ">>"
                }
                i = j + 2
            } else {
                result = result + tmpl[i]
                i = i + 1
            }
        } else {
            result = result + tmpl[i]
            i = i + 1
        }
    }
    return result
}

fn render_default(tmpl: str, vars: list, default_val: str) -> str {
    let result = ""
    let i = 0
    while i < len(tmpl) {
        if i + 1 < len(tmpl) && tmpl[i] == "<" && tmpl[i + 1] == "<" {
            let j = find_close(tmpl, i)
            if j >= 0 {
                let name = str_trim(slice(tmpl, i + 2, j))
                if has_var(vars, name) {
                    result = result + lookup(vars, name)
                } else {
                    result = result + default_val
                }
                i = j + 2
            } else {
                result = result + tmpl[i]
                i = i + 1
            }
        } else {
            result = result + tmpl[i]
            i = i + 1
        }
    }
    return result
}

fn extract_vars(tmpl: str) -> list {
    let vars = []
    let i = 0
    while i < len(tmpl) {
        if i + 1 < len(tmpl) && tmpl[i] == "<" && tmpl[i + 1] == "<" {
            let j = find_close(tmpl, i)
            if j >= 0 {
                let name = str_trim(slice(tmpl, i + 2, j))
                if !contains(vars, name) {
                    vars = vars + [name]
                }
                i = j + 2
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return vars
}

fn render_join(tmpl: str, items: list, item_name: str, sep: str) -> str {
    let parts = []
    for item in items {
        parts = parts + [render(tmpl, [[item_name, item]])]
    }
    return join(parts, sep)
}

fn render_numbered(tmpl: str, items: list, item_name: str, index_name: str) -> str {
    let parts = []
    for i in range(0, len(items)) {
        let vars = [[item_name, items[i]], [index_name, str(i + 1)]]
        parts = parts + [render(tmpl, vars)]
    }
    return join(parts, "\n")
}

fn escape_html(s: str) -> str {
    let result = s
    result = str_replace(result, "&", "&amp;")
    result = str_replace(result, "<", "&lt;")
    result = str_replace(result, ">", "&gt;")
    return result
}

fn render_safe(tmpl: str, vars: list) -> str {
    let escaped = []
    for pair in vars {
        escaped = escaped + [[pair[0], escape_html(pair[1])]]
    }
    return render(tmpl, escaped)
}

fn main() {
    println("=== LATERALUS STDLIB TEMPLATE TUTORIAL ===")
    let vars = [["name", "world"], ["n", "42"], ["title", "Mr. <b>Bold</b> & Co"]]

    println("STEP 1: " + render("Hello <<name>>!", vars))
    println("STEP 2: " + render("n=<<n>>, missing=<<missing>>", vars))
    println("STEP 3: " + render_default("Hello <<name>> / <<city>>!", vars, "earth"))
    println("STEP 4: vars in '<<a>> and <<b>> and <<a>>' = [" + join(extract_vars("<<a>> and <<b>> and <<a>>"), ", ") + "]")
    println("STEP 5: unclosed '<<oops' -> " + render("unclosed <<oops", vars))
    println("STEP 6 join: " + render_join("- <<item>>", ["a", "b", "c"], "item", ", "))
    println("STEP 7 numbered:")
    println(render_numbered("<<i>>. <<item>>", ["apples", "pears"], "item", "i"))
    println("STEP 8 raw: " + render("Title: <<title>>", vars))
    println("STEP 9 safe: " + render_safe("Title: <<title>>", vars))
    println("PINNED_VECTORS: hello=Hello world! default=Hello world / earth! vars=a,b join=- a, - b, - c safe=Title: Mr. &lt;b&gt;Bold&lt;/b&gt; &amp; Co")
}

main()
