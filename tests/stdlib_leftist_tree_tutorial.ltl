// ===================================================================
// tests/stdlib_leftist_tree_tutorial.ltl
// -------------------------------------------------------------------
// Complete test suite for Leftist Tree (Leftist Heap) in Lateralus.
// Meldable priority queue maintaining the Null Path Length (NPL)
// invariant with guaranteed O(log n) worst-case meld, insert, and delete.
// Clark A. Crane (1972), Donald E. Knuth (TAOCP Vol. 3).
// ===================================================================

pub fn leftist_create() -> dict {
    let mut tree = {}
    let mut val = []
    let mut left = []
    let mut right = []
    let mut npl = []

    // Node 0 represents nil with npl 0
    val.push(0)
    left.push(0)
    right.push(0)
    npl.push(0)

    tree["val"] = val
    tree["left"] = left
    tree["right"] = right
    tree["npl"] = npl
    return tree
}

pub fn leftist_get_npl(tree: dict, u: int) -> int {
    if u == 0 {
        return 0
    }
    let npl = tree["npl"]
    return npl[u]
}

pub fn leftist_meld(tree: dict, u: int, v: int) -> int {
    if u == 0 {
        return v
    }
    if v == 0 {
        return u
    }

    let mut node_u = u
    let mut node_v = v

    let val = tree["val"]
    if val[node_u] > val[node_v] {
        let tmp = node_u
        node_u = node_v
        node_v = tmp
    }

    let mut right = tree["right"]
    let next_r = leftist_meld(tree, right[node_u], node_v)
    right = tree["right"]
    right[node_u] = next_r
    tree["right"] = right

    let mut left = tree["left"]
    let l_child = left[node_u]
    let r_child = right[node_u]

    let npl_l = leftist_get_npl(tree, l_child)
    let npl_r = leftist_get_npl(tree, r_child)

    // Leftist invariant: npl(left) >= npl(right)
    if npl_l < npl_r {
        left[node_u] = r_child
        right[node_u] = l_child
        tree["left"] = left
        tree["right"] = right
    }

    let updated_r = right[node_u]
    let mut npl_arr = tree["npl"]
    npl_arr[node_u] = leftist_get_npl(tree, updated_r) + 1
    tree["npl"] = npl_arr

    return node_u
}

pub fn leftist_insert(tree: dict, root: int, key: int) -> int {
    let mut val = tree["val"]
    let mut left = tree["left"]
    let mut right = tree["right"]
    let mut npl = tree["npl"]

    let node = val.len()
    val.push(key)
    left.push(0)
    right.push(0)
    npl.push(1)

    tree["val"] = val
    tree["left"] = left
    tree["right"] = right
    tree["npl"] = npl

    return leftist_meld(tree, root, node)
}

pub fn leftist_find_min(tree: dict, root: int) -> int {
    if root == 0 {
        return -1
    }
    let val = tree["val"]
    return val[root]
}

pub fn leftist_delete_min(tree: dict, root: int) -> list {
    if root == 0 {
        return [0, -1]
    }
    let val = tree["val"]
    let min_val = val[root]

    let left = tree["left"]
    let right = tree["right"]
    let l_child = left[root]
    let r_child = right[root]

    let new_root = leftist_meld(tree, l_child, r_child)
    return [new_root, min_val]
}

// Helper to check NPL and heap property recursively
pub fn leftist_check_invariant(tree: dict, u: int) -> bool {
    if u == 0 {
        return true
    }
    let val = tree["val"]
    let left = tree["left"]
    let right = tree["right"]
    let npl = tree["npl"]

    let l = left[u]
    let r = right[u]

    if l != 0 {
        if val[l] < val[u] {
            return false
        }
    }
    if r != 0 {
        if val[r] < val[u] {
            return false
        }
    }

    let npl_l = leftist_get_npl(tree, l)
    let npl_r = leftist_get_npl(tree, r)

    if npl_l < npl_r {
        return false
    }
    if npl[u] != npl_r + 1 {
        return false
    }

    if not leftist_check_invariant(tree, l) {
        return false
    }
    if not leftist_check_invariant(tree, r) {
        return false
    }
    return true
}

// -------------------------------------------------------------------
// Smoke tests and Golden Test Vectors
// -------------------------------------------------------------------

pub fn test_leftist_basic() -> bool {
    let tree = leftist_create()
    let mut root = 0

    root = leftist_insert(tree, root, 30)
    root = leftist_insert(tree, root, 10)
    root = leftist_insert(tree, root, 20)

    if leftist_find_min(tree, root) != 10 {
        return false
    }

    let res1 = leftist_delete_min(tree, root)
    root = res1[0]
    let val1 = res1[1]
    if val1 != 10 {
        return false
    }
    if leftist_find_min(tree, root) != 20 {
        return false
    }

    let res2 = leftist_delete_min(tree, root)
    root = res2[0]
    let val2 = res2[1]
    if val2 != 20 {
        return false
    }
    if leftist_find_min(tree, root) != 30 {
        return false
    }

    return true
}

pub fn test_leftist_npl_invariant() -> bool {
    let tree = leftist_create()
    let mut root = 0
    let elements = [50, 20, 80, 10, 30, 70, 90, 5, 15]

    let mut i = 0
    while i < elements.len() {
        root = leftist_insert(tree, root, elements[i])
        if not leftist_check_invariant(tree, root) {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn test_leftist_heapsort() -> bool {
    let tree = leftist_create()
    let mut root = 0
    let keys = [55, 12, 88, 3, 29, 17, 92, 1]

    let mut i = 0
    while i < keys.len() {
        root = leftist_insert(tree, root, keys[i])
        i = i + 1
    }

    let expected = [1, 3, 12, 17, 29, 55, 88, 92]
    let mut idx = 0
    while idx < expected.len() {
        let res = leftist_delete_min(tree, root)
        root = res[0]
        let extracted = res[1]
        if extracted != expected[idx] {
            return false
        }
        idx = idx + 1
    }

    if root != 0 {
        return false
    }
    return true
}

pub fn test_leftist_meld_disjoint() -> bool {
    let tree = leftist_create()
    let mut h1 = 0
    let mut h2 = 0

    h1 = leftist_insert(tree, h1, 10)
    h1 = leftist_insert(tree, h1, 30)
    h1 = leftist_insert(tree, h1, 50)

    h2 = leftist_insert(tree, h2, 20)
    h2 = leftist_insert(tree, h2, 40)
    h2 = leftist_insert(tree, h2, 60)

    let merged = leftist_meld(tree, h1, h2)
    if not leftist_check_invariant(tree, merged) {
        return false
    }

    if leftist_find_min(tree, merged) != 10 {
        return false
    }
    return true
}
