// =======================================================================
// LATERALUS v1.5 — Environment Module Tutorial and Demo
// Demonstrates process environment variable management, inspection, and defaults.
// =======================================================================

import env
import testing

@test
env.test_get_and_set = fn() {
    // Set a test environment variable
    env.set("LATERALUS_ENV_TEST", "production")
    assert_eq(env.get("LATERALUS_ENV_TEST"), "production", "retrieve set env var")

    // Check existence
    assert_true(env.exists("LATERALUS_ENV_TEST"), "env var exists")
    assert_false(env.exists("LATERALUS_NONEXISTENT_VAR_XYZ"), "nonexistent env var")
}

@test
env.test_get_or_default = fn() {
    // Retrieve with fallback default
    let val = env.get_or("LATERALUS_MISSING_VAR", "fallback_value")
    assert_eq(val, "fallback_value", "get_or returns default when missing")

    let existing = env.get_or("LATERALUS_ENV_TEST", "fallback_value")
    assert_eq(existing, "production", "get_or returns actual when present")
}

@test
env.test_env_list_and_args = fn() {
    // Verify environment keys/vars map and argument vector access
    let args = env.args()
    assert_true(len(args) >= 0, "args returns list of arguments")

    let keys = env.keys()
    assert_true(type(keys) == "list", "env keys returns list type")
}
