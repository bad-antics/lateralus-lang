// statsd_retry_queue.ltl
// -------------------------------------------------------------------
// Example tutorial for using stdlib/statsd.ltl to emit a sampled retry
// counter and a queue depth gauge. The program prints the exact metric
// strings that would be sent over UDP to a StatsD server.
// -------------------------------------------------------------------

import stdlib.statsd as statsd

fn main() {
    // ---------------------------------------------------------------
    // 1. Retry counter (sampled)
    // ---------------------------------------------------------------
    //   - Metric name: "queue.retries"
    //   - Delta: 1 (one retry)
    //   - Sample rate: 0.25 (25% sampling)
    //   - Tags: queue:render and a flag tag "retry" (no value)
    // ---------------------------------------------------------------
    let retry_metric = statsd.counter(
        "queue.retries",
        1,
        "0.25",
        [
            ["queue", "render"],
            ["retry", ""]
        ]
    )

    // ---------------------------------------------------------------
    // 2. Queue depth gauge
    // ---------------------------------------------------------------
    //   - Metric name: "queue.depth"
    //   - Current depth: 42
    //   - Tags: queue:render
    // ---------------------------------------------------------------
    let gauge_metric = statsd.gauge(
        "queue.depth",
        "42",
        [
            ["queue", "render"]
        ]
    )

    // Output the metrics – in a real application these strings would be
    // sent via UDP to a StatsD endpoint.
    println(retry_metric)
    println(gauge_metric)
}
