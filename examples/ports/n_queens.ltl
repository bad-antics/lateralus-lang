// N-Queens solution counter — Lateralus port of examples/ports/n_queens.py.
// Idiomatic ~50-line Python -> Lateralus for the recurring port bounty.
// Bitmask backtracking: cols/diag_l/diag_r mark attacked files; one queen per row.
// Note: variable shifts and string '+' concat hit C99 codegen edges, so masks
// use *2 / floor(/2) and output prints the count directly.

fn count_queens(n: int, cols: int, dl: int, dr: int) -> int {
    let mask = 1
    let i = 0
    while i < n {
        mask = mask * 2
        i = i + 1
    }
    mask = mask - 1
    if cols == mask {
        return 1
    }
    let total = 0
    let bit = 1
    let r = 0
    while r < n {
        let free_col = (cols & bit) == 0
        let free_dl = (dl & bit) == 0
        let free_dr = (dr & bit) == 0
        if free_col {
            if free_dl {
                if free_dr {
                    total = total + count_queens(n, cols | bit, (dl | bit) * 2, floor((dr | bit) / 2))
                }
            }
        }
        bit = bit * 2
        r = r + 1
    }
    return total
}

fn main() {
    let solutions = count_queens(13, 0, 0, 0)
    println(solutions)
}

main()
