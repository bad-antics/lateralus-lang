// Advent of Code 2024 · Day 11 · Plutonian Pebbles
// Stones evolve per blink: 0 -> 1; even digit count -> split in half;
// otherwise -> stone * 2024.
// Part 1: stones after 25 blinks. Part 2: stones after 75 blinks.
// Sample: "125 17" -> 55312 / 65601038650482 (official sample answers).
// Method: frequency map (stone -> count) per blink, so the count never
// materialises the full list; Python ints are arbitrary precision.

let SAMPLE = "125 17"

fn parse(text: str) -> list {
    let stones = []
    let parts = str_split(str_trim(text), " ")
    let i = 0
    while i < len(parts) {
        if len(parts[i]) > 0 {
            stones = stones + [int(parts[i])]
        }
        i = i + 1
    }
    return stones
}

fn add_to(counts: dict, stone: int, n: int) -> dict {
    let key = str(stone)
    if contains(counts, key) {
        counts[key] = counts[key] + n
    } else {
        counts[key] = n
    }
    return counts
}

// One blink over the whole frequency map.
fn blink(counts: dict) -> dict {
    let next = {}
    let ks = keys(counts)
    let i = 0
    while i < len(ks) {
        let stone = int(ks[i])
        let n = counts[ks[i]]
        if stone == 0 {
            next = add_to(next, 1, n)
        } else {
            let s = str(stone)
            let ndigits = len(s)
            if imod(ndigits, 2) == 0 {
                let half = idiv(ndigits, 2)
                let left = int(slice(s, 0, half))
                let right = int(slice(s, half, ndigits))
                next = add_to(next, left, n)
                next = add_to(next, right, n)
            } else {
                next = add_to(next, stone * 2024, n)
            }
        }
        i = i + 1
    }
    return next
}

fn count_after(text: str, blinks: int) -> int {
    let counts = {}
    let stones = parse(text)
    let i = 0
    while i < len(stones) {
        counts = add_to(counts, stones[i], 1)
        i = i + 1
    }
    let b = 0
    while b < blinks {
        counts = blink(counts)
        b = b + 1
    }
    let total = 0
    let ks = keys(counts)
    let j = 0
    while j < len(ks) {
        total = total + counts[ks[j]]
        j = j + 1
    }
    return total
}

fn part1(text: str) -> int {
    return count_after(text, 25)
}

fn part2(text: str) -> int {
    return count_after(text, 75)
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 55312)
}

@test
fn test_sample_part2() {
    assert_eq(part2(SAMPLE), 65601038650482)
}

fn main() {
    print("Day 11 Part 1: " + str(part1(SAMPLE)))
    print("Day 11 Part 2: " + str(part2(SAMPLE)))
}

main()
