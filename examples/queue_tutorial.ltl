// ===================================================================
// examples/queue_tutorial.ltl — stdlib/queue.ltl tutorial companion
// Runnable tour of the double-ended queue: construction, FIFO pops,
// push_front/pop_back deque ops, peeks, bulk ops (reverse/filter/map/
// drain/concat), and to_string. Self-contained module inline.
// ===================================================================


// -- Queue construction ----------------------------------------------

/// Create a new empty queue.
fn new() -> list {
    // Internal repr: [items…] — front at index 0
    return []
}

/// Create a queue pre-populated with `items`.
fn from_list(items: list) -> list {
    let q = []
    for item in items {
        q = q + [item]
    }
    return q
}

// -- Core operations -------------------------------------------------

/// Push an element to the back of the queue.
fn push_back(q: list, item) -> list {
    return q + [item]
}

/// Push an element to the front of the queue.
fn push_front(q: list, item) -> list {
    return [item] + q
}

/// Remove and return the front element.  Returns [value, new_queue].
fn pop_front(q: list) -> list {
    if len(q) == 0 {
        return [nil, q]
    }
    let front = q[0]
    let rest = slice(q, 1, len(q))
    return [front, rest]
}

/// Remove and return the back element.  Returns [value, new_queue].
fn pop_back(q: list) -> list {
    if len(q) == 0 {
        return [nil, q]
    }
    let back = q[len(q) - 1]
    let rest = slice(q, 0, len(q) - 1)
    return [back, rest]
}

// -- Inspection ------------------------------------------------------

/// Peek at the front element without removing.
fn front(q: list) {
    if len(q) == 0 {
        return nil
    }
    return q[0]
}

/// Peek at the back element without removing.
fn back(q: list) {
    if len(q) == 0 {
        return nil
    }
    return q[len(q) - 1]
}

/// Return the number of elements.
fn size(q: list) -> int {
    return len(q)
}

/// Check whether queue is empty.
fn is_empty(q: list) -> bool {
    return len(q) == 0
}

// -- Bulk operations -------------------------------------------------

/// Reverse the queue.
// NOTE: module version `return reverse(q)` infinite-loops — the
// user-defined `reversed` shadows Python's `reversed` builtin that the
// `reverse` shim calls. Reimplemented with an explicit loop.
fn reversed(q: list) -> list {
    let out = []
    let i = len(q) - 1
    while i >= 0 {
        out = out + [q[i]]
        i = i - 1
    }
    return out
}

/// Return a new queue containing only elements matching the predicate.
fn filter_queue(q: list, pred) -> list {
    return filter(q, pred)
}

/// Apply a function to every element, return new queue.
fn map_queue(q: list, func) -> list {
    return map(q, func)
}

/// Drain up to `n` elements from the front.  Returns [drained, remaining].
fn drain(q: list, n: int) -> list {
    let take = min(n, len(q))
    let drained = slice(q, 0, take)
    let remaining = slice(q, take, len(q))
    return [drained, remaining]
}

/// Concatenate two queues.
fn concat(a: list, b: list) -> list {
    return a + b
}

/// Convert queue to a printable string.
fn to_string(q: list) -> str {
    return "Queue(" + str(q) + ")"
}

fn main() {
    print("=== LATERALUS STDLIB QUEUE TUTORIAL ===")

    // -- Step 1: construction + FIFO order ------------------------------
    print("STEP 1 fifo:")
    let q = new()
    q = push_back(q, "a")
    q = push_back(q, "b")
    q = push_back(q, "c")
    print("  q=" + str(q))
    print("  size=" + str(size(q)))
    print("  front=" + str(front(q)))
    print("  back=" + str(back(q)))
    print("  is_empty=" + str(is_empty(q)))
    let r1 = pop_front(q)
    print("  pop_front=" + str(r1[0]) + " rest=" + str(r1[1]))
    q = r1[1]
    let r2 = pop_front(q)
    print("  pop2=" + str(r2[0]))
    q = r2[1]
    let r3 = pop_front(q)
    print("  pop3=" + str(r3[0]))
    q = r3[1]
    print("  empty_now=" + str(is_empty(q)))
    let r4 = pop_front(q)
    print("  pop_empty_val=" + str(r4[0]))

    // -- Step 2: deque ops ----------------------------------------------
    print("STEP 2 deque:")
    let d = from_list([1, 2, 3])
    d = push_front(d, 0)
    print("  after_push_front=" + str(d))
    let rb = pop_back(d)
    print("  pop_back=" + str(rb[0]) + " rest=" + str(rb[1]))
    d = rb[1]
    print("  front_peek=" + str(front(d)))
    print("  back_peek=" + str(back(d)))

    // -- Step 3: bulk ops -------------------------------------------------
    print("STEP 3 bulk:")
    let b = from_list([5, 1, 4, 1, 5, 9, 2, 6])
    print("  reversed=" + str(reversed(b)))
    let evens = filter_queue(b, fn(x) { return x % 2 == 0 })
    print("  evens=" + str(evens))
    let doubled = map_queue(b, fn(x) { return x * 2 })
    print("  doubled=" + str(doubled))
    let dr = drain(b, 3)
    print("  drained=" + str(dr[0]) + " remaining=" + str(dr[1]))
    let cat = concat(from_list([1]), from_list([2, 3]))
    print("  concat=" + str(cat))
    print("  str=" + to_string(cat))

    print("PINNED_VECTORS: fifo_abc pop_a_pop_b empty_pop_nil "
        + "deque_0123 pop_back_3 evens=[4,2,6] doubled drain3 "
        + "concat=[1,2,3]")
    print("  OK examples/queue_tutorial.ltl")
    return 0
}
