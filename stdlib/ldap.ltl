// stdlib/ldap.ltl: minimal LDAPv3 (RFC 4511) BER encoder/decoder helpers.
//
// Hardened per issue #1085:
//   * bind_request uses UTF-8 byte length for DN and password
//   * enc_integer supports negative values (two's complement)
//   * decode_tlv is fully bounds-checked and rejects BER indefinite length

// ---------------------------------------------------------------------------
// BER length encoding
// ---------------------------------------------------------------------------

fn enc_len(n) {
    if n < 0 {
        return err("enc_len: negative length");
    }
    if n < 128 {
        return [n];
    }
    let out = [];
    let v = n;
    while v > 0 {
        out = [v & 0xFF] + out;
        v = v >> 8;
    }
    return [0x80 | len(out)] + out;
}

// ---------------------------------------------------------------------------
// BER INTEGER encoding (two's complement, minimal length)
// ---------------------------------------------------------------------------

fn enc_integer(v) {
    let out = [];
    if v >= 0 {
        let n = v;
        if n == 0 {
            out = [0];
        }
        while n > 0 {
            out = [n & 0xFF] + out;
            n = n >> 8;
        }
        // Prepend 0x00 if the high bit is set so the value stays positive.
        if out[0] >= 128 {
            out = [0] + out;
        }
    } else {
        // Negative: find the minimal number of bytes needed such that the
        // two's complement representation round-trips.
        let nbytes = 1;
        while nbytes < 9 {
            let lower = 0 - (1 << (8 * nbytes - 1));
            if v >= lower {
                break;
            }
            nbytes = nbytes + 1;
        }
        // Two's complement: add 2^(8*nbytes) to v to get the unsigned value.
        let u = v + (1 << (8 * nbytes));
        let i = 0;
        while i < nbytes {
            out = [u & 0xFF] + out;
            u = u >> 8;
            i = i + 1;
        }
    }
    return [0x02] + enc_len(len(out)) + out;
}

// ---------------------------------------------------------------------------
// BER OCTET STRING / generic TLV helpers
// ---------------------------------------------------------------------------

fn enc_octet_string(s) {
    let b = bytes_of(s);
    return [0x04] + enc_len(len(b)) + b;
}

fn enc_tlv(tag, content) {
    return [tag] + enc_len(len(content)) + content;
}

// ---------------------------------------------------------------------------
// BER TLV decoding (bounds-checked)
//
// Returns {tag, length, value_offset, next} on success, or an err(...) value.
// ---------------------------------------------------------------------------

fn decode_tlv(buf, i) {
    let blen = len(buf);

    if i < 0 || i >= blen {
        return err("decode_tlv: offset out of range");
    }
    // Need at least a tag byte and one length byte.
    if i + 1 >= blen {
        return err("decode_tlv: truncated header");
    }

    let tag = buf[i];
    let b = buf[i + 1];
    let off = i + 2;
    let length = 0;

    if b == 0x80 {
        // BER indefinite length is not permitted (LDAP uses definite-length BER).
        return err("decode_tlv: indefinite length not supported");
    }

    if b < 0x80 {
        length = b;
    } else {
        let nlen = b & 0x7F;
        // 0xFF is reserved; also reject unreasonably wide lengths.
        if b == 0xFF || nlen > 4 {
            return err("decode_tlv: invalid length-of-length");
        }
        if off + nlen > blen {
            return err("decode_tlv: truncated length field");
        }
        let k = 0;
        while k < nlen {
            length = (length << 8) | buf[off + k];
            k = k + 1;
        }
        off = off + nlen;
    }

    if length < 0 || off + length > blen {
        return err("decode_tlv: truncated value");
    }

    return {
        tag: tag,
        length: length,
        value_offset: off,
        next: off + length
    };
}

// ---------------------------------------------------------------------------
// LDAP BindRequest (simple authentication)
// ---------------------------------------------------------------------------

fn bind_request(message_id, dn, password) {
    let dn_bytes = bytes_of(dn);
    let pw_bytes = bytes_of(password);

    // BindRequest ::= [APPLICATION 0] SEQUENCE {
    //     version  INTEGER (3),
    //     name     LDAPDN (OCTET STRING),
    //     authentication [0] OCTET STRING (simple) }
    let version = enc_integer(3);
    let name = [0x04] + enc_len(len(dn_bytes)) + dn_bytes;
    // Use the UTF-8 *byte* length of the password, not the character count.
    let auth = [0x80] + enc_len(len(pw_bytes)) + pw_bytes;

    let body = version + name + auth;
    let bind = [0x60] + enc_len(len(body)) + body;

    let mid = enc_integer(message_id);
    let msg_body = mid + bind;
    return [0x30] + enc_len(len(msg_body)) + msg_body;
}