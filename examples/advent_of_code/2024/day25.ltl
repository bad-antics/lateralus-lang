// Advent of Code 2024 · Day 25 · Code Chronicle
// Locks and keys as 5-column height profiles; count pairs whose columns never
// exceed 5. Sample answer 3, stated on https://adventofcode.com/2024/day/25.

let SAMPLE = "#####
.####
.####
.####
.#.#.
.#...
.....

#####
##.##
.#.##
...##
...#.
...#.
.....

.....
#....
#....
#...#
#.#.#
#.###
#####

.....
.....
#.#..
###..
###.#
###.#
#####

.....
.....
.....
#....
#.#..
#.#.#
#####"

fn blocks(text: str) -> list {
    let out = []
    let cur = []
    for raw in str_split(text, "\n") {
        let l = str_trim(raw)
        if len(l) == 0 {
            if len(cur) > 0 { out = out + [cur]; cur = [] }
        } else {
            cur = cur + [l]
        }
    }
    if len(cur) > 0 { out = out + [cur] }
    return out
}

// Column heights for a block; `isLock` flips the counting direction.
fn heights(block: list, isLock: bool) -> list {
    let hs = []
    let c = 0
    let width = len(block[0])
    while c < width {
        let h = 0
        let r = 0
        while r < len(block) {
            let ch = slice(block[r], c, c + 1)
            if isLock {
                if ch == "#" { h = h + 1 } else { r = len(block) }
            } else {
                let rr = len(block) - 1 - r
                if slice(block[rr], c, c + 1) == "#" { h = h + 1 } else { r = len(block) }
            }
            r = r + 1
        }
        hs = hs + [h - 1]
        c = c + 1
    }
    return hs
}

fn part1(text: str) -> int {
    let locks = []
    let keys_ = []
    for b in blocks(text) {
        let is_lock = slice(b[0], 0, 1) == "#"
        if is_lock { locks = locks + [heights(b, true)] } else { keys_ = keys_ + [heights(b, false)] }
    }
    let total = 0
    for lk in locks {
        for ky in keys_ {
            let ok = true
            let i = 0
            while i < len(lk) {
                if lk[i] + ky[i] > 5 { ok = false }
                i = i + 1
            }
            if ok { total = total + 1 }
        }
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 3)
}

fn main() {
    print("Day 25 Part 1 (sample): " + str(part1(SAMPLE)))
}

main()
