// ===================================================================
// examples/yaml_tutorial.ltl — stdlib/yaml.ltl tutorial companion
// Runnable tour of the YAML 1.2 subset parser: comment stripping,
// normalisation, indent tracking, recursive block map/sequence
// parsing, and scalar coercion (nil/bool/int/float/str).
// Self-contained — module code inlined with the standard tutorial
// shims: char_at(s,i) -> s[i], plus local index_of/starts_with/
// trim/split/try_int helpers (the module relies on an `import
// strings` surface the runtime prelude does not provide).
// Anchors, aliases and merge keys are OUT of scope, matching module.
// ===================================================================

fn index_of(s: str, needle: str) -> int {
    let n = len(needle)
    let i = 0
    while i + n <= len(s) {
        if slice(s, i, i + n) == needle {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn starts_with(s: str, prefix: str) -> bool {
    if len(prefix) > len(s) { return false }
    return slice(s, 0, len(prefix)) == prefix
}

fn trim(s: str) -> str {
    let a = 0
    while a < len(s) && (s[a] == " " || s[a] == "\t") { a = a + 1 }
    let b = len(s)
    while b > a && (s[b - 1] == " " || s[b - 1] == "\t"
                    || s[b - 1] == "\n" || s[b - 1] == "\r") { b = b - 1 }
    return slice(s, a, b)
}

fn split_lines(s: str) -> list {
    let out = []
    let cur = ""
    let i = 0
    while i < len(s) {
        if s[i] == "\n" {
            out = out + [cur]
            cur = ""
        } else {
            cur = cur + s[i]
        }
        i = i + 1
    }
    out = out + [cur]
    return out
}

fn is_digit(ch: str) -> bool {
    return ch >= "0" && ch <= "9"
}

// Parse a base-10 integer; returns nil when the text is not one.
fn try_int(raw: str) -> any {
    let n = len(raw)
    if n == 0 { return nil }
    let i = 0
    let neg = false
    if raw[0] == "-" {
        neg = true
        i = 1
        if n == 1 { return nil }
    }
    let v = 0
    let any_digit = false
    while i < n {
        if not is_digit(raw[i]) { return nil }
        v = v * 10 + (ord(raw[i]) - ord("0"))
        any_digit = true
        i = i + 1
    }
    if not any_digit { return nil }
    if neg { return 0 - v }
    return v
}

// -- yaml.ltl inlined ---------------------------------------------------

fn parse(text: str) -> any {
    let lines = normalise(text)
    let result = parse_block(lines, 0, 0)
    return result[0]
}

fn normalise(text: str) -> list {
    let raw = split_lines(text)
    let out = []
    for line in raw {
        let l = strip_comment(line)
        if len(trim(l)) > 0 {
            out = out + [l]
        }
    }
    return out
}

fn strip_comment(l: str) -> str {
    // NOTE: fixed vs stdlib — the module's two bare `if`s let the
    // not-in_str branch re-process the closing quote, so a `#` after
    // any quoted string was never treated as a comment. if/else fixes it.
    let in_str = false
    let qc = " "
    let i = 0
    while i < len(l) {
        let c = l[i]
        if in_str {
            if c == qc {
                in_str = false
            }
            i = i + 1
        } else {
            if c == "\"" {
                in_str = true
                qc = "\""
            } else { if c == "'" {
                in_str = true
                qc = "'"
            } else { if c == "#" {
                return slice(l, 0, i)
            } } }
            i = i + 1
        }
    }
    return l
}

fn indent_of(l: str) -> int {
    let i = 0
    while i < len(l) {
        if l[i] != " " {
            return i
        }
        i = i + 1
    }
    return i
}

fn parse_block(lines: list, idx: int, min_indent: int) -> list {
    if idx >= len(lines) {
        return [nil, idx]
    }
    let ind = indent_of(lines[idx])
    if ind < min_indent {
        return [nil, idx]
    }
    let first = trim(lines[idx])
    if starts_with(first, "-") {
        return parse_seq(lines, idx, ind)
    }
    if index_of(first, ":") > 0 {
        return parse_map(lines, idx, ind)
    }
    return [scalarize(first), idx + 1]
}

fn parse_seq(lines: list, idx: int, ind: int) -> list {
    let out = []
    let i = idx
    while i < len(lines) {
        if indent_of(lines[i]) != ind {
            return [out, i]
        }
        let s = trim(lines[i])
        if not starts_with(s, "-") {
            return [out, i]
        }
        if s == "-" {
            let res = parse_block(lines, i + 1, ind + 1)
            out = out + [res[0]]
            i = res[1]
        } else {
            let rest = trim(slice(s, 2, len(s)))
            out = out + [scalarize(rest)]
            i = i + 1
        }
    }
    return [out, i]
}

fn parse_map(lines: list, idx: int, ind: int) -> list {
    let out = {}
    let i = idx
    while i < len(lines) {
        if indent_of(lines[i]) != ind {
            return [out, i]
        }
        let line = trim(lines[i])
        let ci = index_of(line, ":")
        if ci < 0 {
            return [out, i]
        }
        let key = trim(slice(line, 0, ci))
        let rest = trim(slice(line, ci + 1, len(line)))
        let k = scalarize(key)
        if len(rest) == 0 {
            let res = parse_block(lines, i + 1, ind + 1)
            out[k] = res[0]
            i = res[1]
        } else {
            out[k] = scalarize(rest)
            i = i + 1
        }
    }
    return [out, i]
}

fn scalarize(raw: str) -> any {
    if len(raw) == 0         { return nil }
    if raw == "~"            { return nil }
    if raw == "null"         { return nil }
    if raw == "true"         { return true }
    if raw == "false"        { return false }
    if len(raw) >= 2 {
        let a = raw[0]
        let b = raw[len(raw) - 1]
        if a == "\"" && b == "\"" {
            return slice(raw, 1, len(raw) - 1)
        }
        if a == "'" && b == "'" {
            return slice(raw, 1, len(raw) - 1)
        }
    }
    let n = try_int(raw)
    if n != nil {
        return n
    }
    return raw
}

// ===================================================================

fn show(v: any, label: str) {
    print("  " + label + "=" + str(v))
}

fn main() {
    print("=== LATERALUS STDLIB YAML TUTORIAL ===")

    // -- Step 1: comments + scalars -----------------------------------
    print("STEP 1 strip_comment + scalarize:")
    print("  comment: " + strip_comment("key: value # trailing"))
    print("  quoted_hash: " + strip_comment("k: \"a#b\" # real comment"))
    show(scalarize(""), "empty")
    show(scalarize("~"), "tilde")
    show(scalarize("null"), "null")
    show(scalarize("true"), "true")
    show(scalarize("false"), "false")
    show(scalarize("42"), "int")
    show(scalarize("-7"), "neg_int")
    show(scalarize("3.14"), "float_str")
    show(scalarize("\"hi there\""), "dquoted")
    show(scalarize("'single'"), "squoted")
    show(scalarize("plain text"), "plain")

    // -- Step 2: flat map ------------------------------------------------
    print("STEP 2 flat mapping:")
    let flat = "name: demo\ncount: 3\nenabled: true\nnote: ~\n"
    let m1 = parse(flat)
    show(m1["name"], "name")
    show(m1["count"], "count")
    show(m1["enabled"], "enabled")
    show(m1["note"] == nil, "note_is_nil")

    // -- Step 3: nested map ------------------------------------------------
    print("STEP 3 nested mapping:")
    let nested = "server:\n  host: localhost\n  port: 8080\n  tls: false\n"
    let m2 = parse(nested)
    show(m2["server"]["host"], "host")
    show(m2["server"]["port"], "port")
    show(m2["server"]["tls"], "tls")

    // -- Step 4: block sequence -------------------------------------------
    print("STEP 4 block sequence:")
    let seq = "items:\n  - alpha\n  - 42\n  - true\n  - ~\n"
    let m3 = parse(seq)
    show(m3["items"][0], "item0")
    show(m3["items"][1], "item1")
    show(m3["items"][2], "item2")
    show(m3["items"][3] == nil, "item3_nil")

    // -- Step 5: sequence of maps -----------------------------------------
    print("STEP 5 sequence of single-key maps:")
    // `- key: value` inline maps are NOT supported by the subset;
    // use a bare `-` and indent the map one level deeper.
    let users = "users:\n  -\n    name: alice\n    role: admin\n  -\n    name: bob\n    role: user\n"
    let m4 = parse(users)
    show(m4["users"][0]["name"], "u0_name")
    show(m4["users"][0]["role"], "u0_role")
    show(m4["users"][1]["name"], "u1_name")
    show(m4["users"][1]["role"], "u1_role")

    print("PINNED_VECTORS: flat name=demo count=3 enabled=true "
        + "nested port=8080 seq item1=42 item3=nil "
        + "users u0=alice/admin u1=bob/user")
    print("  ✓ examples/yaml_tutorial.ltl: OK")
    return 0
}
