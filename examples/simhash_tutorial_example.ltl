// Near-duplicate clustering with stdlib/simhash.ltl.

fn main() {
    let docs = [
        "Lateralus is a small language for clear programs.",
        "Lateralus is a small language for clear programs!",
        "Lateralus is a language for systems programming.",
        "A completely unrelated document about astronomy."
    ]
    let fingerprints = simhash_fingerprint_all(docs)
    let threshold = 8
    let i = 0
    while i < len(docs) {
        let j = i + 1
        while j < len(docs) {
            let distance = simhash_hamming(fingerprints[i], fingerprints[j])
            if distance <= threshold {
                print("near duplicate: " + str(i) + " ~ " + str(j)
                      + " (hamming=" + str(distance) + ")")
            }
            j = j + 1
        }
        i = i + 1
    }
}

main()
