// ===================================================================
// examples/counting_sort_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: E-Commerce Product Rating Distribution and
// Real-Time High-Throughput Scorecard Binning using Counting Sort.
// ===================================================================

pub fn counting_sort(arr, n) {
    if n <= 1 {
        return arr
    }

    let min_val = arr[0]
    let max_val = arr[0]
    let i = 1
    while i < n {
        if arr[i] < min_val {
            min_val = arr[i]
        }
        if arr[i] > max_val {
            max_val = arr[i]
        }
        i = i + 1
    }

    let range_len = max_val - min_val + 1
    let count = dict()
    let c = 0
    while c < range_len {
        count[c] = 0
        c = c + 1
    }

    i = 0
    while i < n {
        let offset = arr[i] - min_val
        count[offset] = count[offset] + 1
        i = i + 1
    }

    c = 1
    while c < range_len {
        count[c] = count[c] + count[c - 1]
        c = c + 1
    }

    let output = dict()
    i = n - 1
    while i >= 0 {
        let val = arr[i]
        let offset = val - min_val
        let target_idx = count[offset] - 1
        output[target_idx] = val
        count[offset] = count[offset] - 1
        i = i - 1
    }

    return output
}

pub fn main() {
    print("=== E-Commerce Review Rating Distribution Binning ===")

    // Simulated batch of 10 incoming customer review scores (1 to 5 stars)
    let review_scores = dict()
    review_scores[0] = 5
    review_scores[1] = 2
    review_scores[2] = 4
    review_scores[3] = 5
    review_scores[4] = 1
    review_scores[5] = 3
    review_scores[6] = 5
    review_scores[7] = 4
    review_scores[8] = 2
    review_scores[9] = 5

    let n = 10
    print("Raw incoming batch size: 10 customer ratings")

    let sorted_reviews = counting_sort(review_scores, n)

    print("Sorted rating distributions (non-decreasing order):")
    let idx = 0
    while idx < n {
        print(sorted_reviews[idx])
        idx = idx + 1
    }

    // Verify ordering invariants
    assert(sorted_reviews[0] == 1, "Minimum rating is 1")
    assert(sorted_reviews[1] == 2, "Second rating is 2")
    assert(sorted_reviews[2] == 2, "Third rating is 2")
    assert(sorted_reviews[6] == 5, "First 5-star rating at index 6")
    assert(sorted_reviews[9] == 5, "Maximum rating is 5")

    print("Customer rating distribution sorted linearly in O(n + k) time successfully!")
}
