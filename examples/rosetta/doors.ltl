fn main() {
    let mut doors = [false; 101]
    let mut pass = 1
    while pass <= 100 {
        let mut door = pass
        while door <= 100 {
            doors[door] = !doors[door]
            door = door + pass
        }
        pass = pass + 1
    }
    
    // Verify specific doors (e.g., door 1 and 4 are open, 2 and 3 are closed)
    assert_eq(doors[1], true)
    assert_eq(doors[2], false)
    assert_eq(doors[3], false)
    assert_eq(doors[4], true)
    assert_eq(doors[9], true)
    print("100 doors verified successfully!")
}
