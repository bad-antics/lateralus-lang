// RFC 4648 Base64 tutorial example.

fn main() {
    let original = "Lateralus base64"
    let encoded = b64_encode(original)
    let decoded = b64_decode(encoded)

    println("original: " + original)
    println("encoded:  " + encoded)
    println("decoded:  " + decoded)
    println("round trip: " + str(decoded == original))

    // RFC 4648 fixed vector.
    println("RFC 4648: " + b64_encode("hello"))
}

