// Rosetta Code · Hex dump · Lateralus

fn hex2(n: int) -> str {
    let digits = "0123456789ABCDEF"
    let v = imod(n, 256)
    if v < 0 { v = v + 256 }
    let hi = idiv(v, 16)
    let lo = imod(v, 16)
    return slice(digits, hi, hi + 1) + slice(digits, lo, lo + 1)
}

fn hex_dump(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        let hexpart = ""
        let ascpart = ""
        let j = 0
        while j < 16 {
            if i + j < len(s) {
                let c = slice(s, i + j, i + j + 1)
                hexpart = hexpart + hex2(ord(c)) + " "
                ascpart = ascpart + c
            } else {
                hexpart = hexpart + "   "
            }
            j = j + 1
        }
        out = out + [pad_left(str(i), 6, "0") + "  " + hexpart + " |" + ascpart + "|"]
        i = i + 16
    }
    return out
}

fn main() {
    let lines = hex_dump("Rosetta Code")
    assert_eq(len(lines), 1, "single line")
    assert_eq(slice(lines[0], 0, 8), "000000  ", "offset prefix")
    let i = 0
    while i < len(lines) {
        print(lines[i])
        i = i + 1
    }
}

main()
