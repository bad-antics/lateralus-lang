// ===================================================================
// Lateralus Example: stdlib.trie — Command-Prefix Autocompletion
// -------------------------------------------------------------------
// Illustrates prefix tree lookup, exact matching, and auto-complete
// candidate discovery for CLI tools, routers, or shells.
// ===================================================================

import trie

fn main() {
    println("=== Command Dispatch & Prefix Completion ===")

    // Pre-populate trie with CLI command dictionary
    let commands = ["help", "history", "status", "start", "stop", "restart", "stats"]
    let router = from_words(commands)

    println("Total commands indexed: " + str(size(router)))

    // 1. Exact match lookup
    println("\n[1] Exact Matches:")
    println("  has('status'):  " + str(has(router, "status")))
    println("  has('destroy'): " + str(has(router, "destroy")))

    // 2. Prefix Autocompletion
    println("\n[2] Prefix Candidates:")
    let st_candidates = keys_with_prefix(router, "st")
    println("  Prefix 'st' matches:  " + str(st_candidates))
    println("  Count for prefix 'st': " + str(count_prefix(router, "st")))

    let h_candidates = keys_with_prefix(router, "h")
    println("  Prefix 'h' matches:   " + str(h_candidates))

    // 3. Longest Prefix Matching
    println("\n[3] Longest Prefix Routing:")
    let input = "startup"
    let matched = longest_prefix(router, input)
    println("  Input '" + input + "' routes to longest prefix: " + matched)

    // 4. Incremental Insertion
    println("\n[4] Incremental Key Insertion:")
    insert(router, "standby", true)
    let updated_st = keys_with_prefix(router, "st")
    println("  Prefix 'st' after inserting 'standby': " + str(updated_st))
}

main()
