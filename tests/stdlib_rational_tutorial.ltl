// ===================================================================
// tests/stdlib_rational_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for stdlib/rational.ltl: Euclidean GCD reduction,
// sign normalization, exact field arithmetic, and cross-ordering.
// ===================================================================

pub fn abs_int(x) {
    if x < 0 {
        return -x
    }
    return x
}

pub fn gcd(a, b) {
    let x = abs_int(a)
    let y = abs_int(b)
    while y != 0 {
        let t = x % y
        x = y
        y = t
    }
    if x == 0 {
        return 1
    }
    return x
}

pub fn make_rational(num, den) {
    let n = num
    let d = den
    if d < 0 {
        n = -n
        d = -d
    }
    let g = gcd(n, d)
    let r = dict()
    r["num"] = n / g
    r["den"] = d / g
    return r
}

pub fn rat_add(a, b) {
    return make_rational((a["num"] * b["den"]) + (b["num"] * a["den"]), a["den"] * b["den"])
}

pub fn rat_sub(a, b) {
    return make_rational((a["num"] * b["den"]) - (b["num"] * a["den"]), a["den"] * b["den"])
}

pub fn rat_mul(a, b) {
    return make_rational(a["num"] * b["num"], a["den"] * b["den"])
}

pub fn rat_div(a, b) {
    return make_rational(a["num"] * b["den"], a["den"] * b["num"])
}

pub fn rat_cmp(a, b) {
    let lhs = a["num"] * b["den"]
    let rhs = b["num"] * a["den"]
    if lhs < rhs { return -1 }
    if lhs > rhs { return 1 }
    return 0
}

pub fn test_canonical_reduction_and_sign_normalization() {
    let r1 = make_rational(42, 56)
    assert(r1["num"] == 3 && r1["den"] == 4, "42/56 reduces to 3/4")

    let r2 = make_rational(15, -25)
    assert(r2["num"] == -3 && r2["den"] == 5, "15/-25 normalizes to -3/5")

    let r3 = make_rational(-14, -21)
    assert(r3["num"] == 2 && r3["den"] == 3, "-14/-21 normalizes to 2/3")

    let r_zero = make_rational(0, -99)
    assert(r_zero["num"] == 0 && r_zero["den"] == 1, "0/-99 normalizes to 0/1")
}

pub fn test_field_arithmetic_identities() {
    let a = make_rational(5, 12)
    let b = make_rational(7, 18)

    let s = rat_add(a, b)
    assert(s["num"] == 29 && s["den"] == 36, "5/12 + 7/18 == 29/36")

    let d = rat_sub(a, b)
    assert(d["num"] == 1 && d["den"] == 36, "5/12 - 7/18 == 1/36")

    let p = rat_mul(make_rational(9, 14), make_rational(7, 15))
    assert(p["num"] == 3 && p["den"] == 10, "(9/14)*(7/15) == 3/10")

    let q = rat_div(make_rational(5, 12), make_rational(15, 18))
    assert(q["num"] == 1 && q["den"] == 2, "(5/12)/(15/18) == 1/2")
}

pub fn test_exact_ordering() {
    let a = make_rational(7, 11)
    let b = make_rational(9, 14)
    assert(rat_cmp(a, b) == -1, "7/11 < 9/14 since 98 < 99")
    assert(rat_cmp(b, a) == 1, "9/14 > 7/11")
    assert(rat_cmp(make_rational(6, 9), make_rational(14, 21)) == 0, "6/9 == 14/21")
}

pub fn main() {
    test_canonical_reduction_and_sign_normalization()
    test_field_arithmetic_identities()
    test_exact_ordering()
    print("All stdlib/rational.ltl verification tests passed!")
}
