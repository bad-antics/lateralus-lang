// Advent of Code 2024 · Day 7 · Bridge Repair
// Equations: left is the target; right is a list of numbers.
// Insert + or * between numbers (left-to-right, no precedence) to reach target.
// Part 1: sum targets achievable with + and *.
// Part 2: add || (concatenation) as a third operator.

let SAMPLE = "190: 10 19
3267: 81 40 27
83: 17 5
156: 15 6
7290: 6 8 6 15
161011: 16 10 13
192: 17 8 14
21037: 9 7 18 13
292: 11 6 16 20"

fn parse(text: str) -> list {
    let lines = str_split(text, "\n")
    let result = []
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            let colon = 0
            let j = 0
            while j < len(line) {
                if slice(line, j, j + 1) == ":" {
                    colon = j
                    j = len(line)
                }
                j = j + 1
            }
            let target = int(slice(line, 0, colon))
            let rest = str_trim(slice(line, colon + 1, len(line)))
            let toks = str_split(rest, " ")
            let nums = []
            let k = 0
            while k < len(toks) {
                let t = str_trim(toks[k])
                if len(t) > 0 {
                    nums = nums + [int(t)]
                }
                k = k + 1
            }
            result = result + [[target, nums]]
        }
        i = i + 1
    }
    return result
}

fn concat_nums(a: int, b: int) -> int {
    let bs = str(b)
    let i = 0
    let mult = 1
    while i < len(bs) {
        mult = mult * 10
        i = i + 1
    }
    return a * mult + b
}

fn can_reach(nums: list, idx: int, current: int, target: int, use_concat: bool) -> bool {
    if idx == len(nums) {
        return current == target
    }
    let n = nums[idx]
    if can_reach(nums, idx + 1, current + n, target, use_concat) { return true }
    if can_reach(nums, idx + 1, current * n, target, use_concat) { return true }
    if use_concat {
        if can_reach(nums, idx + 1, concat_nums(current, n), target, use_concat) { return true }
    }
    return false
}

fn part1(text: str) -> int {
    let equations = parse(text)
    let total = 0
    let i = 0
    while i < len(equations) {
        let eq = equations[i]
        let target = eq[0]
        let nums = eq[1]
        if len(nums) > 0 && can_reach(nums, 1, nums[0], target, false) {
            total = total + target
        }
        i = i + 1
    }
    return total
}

fn part2(text: str) -> int {
    let equations = parse(text)
    let total = 0
    let i = 0
    while i < len(equations) {
        let eq = equations[i]
        let target = eq[0]
        let nums = eq[1]
        if len(nums) > 0 && can_reach(nums, 1, nums[0], target, true) {
            total = total + target
        }
        i = i + 1
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 3749)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 11387)
}

fn main() {
    print("Day 7 Part 1: " + str(part1(SAMPLE)))
    print("Day 7 Part 2: " + str(part2(SAMPLE)))
}

main()
