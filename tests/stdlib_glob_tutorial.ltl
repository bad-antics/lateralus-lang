// Standard Library Unix Glob Pattern Matcher Tutorial Suite
// Validates greedy wildcard backtracing, exact literal matches, and boundary conditions.

fn glob_match(pattern: string, text: string) -> bool {
    let p_len = len(pattern);
    let t_len = len(text);
    let mut p_idx = 0;
    let mut t_idx = 0;
    let mut star_idx = -1;
    let mut match_idx = 0;

    while t_idx < t_len {
        let mut p_char = "";
        if p_idx < p_len {
            p_char = slice(pattern, p_idx, p_idx + 1);
        }
        let t_char = slice(text, t_idx, t_idx + 1);

        if p_idx < p_len && (p_char == "?" || p_char == t_char) {
            p_idx = p_idx + 1;
            t_idx = t_idx + 1;
        } else if p_idx < p_len && p_char == "*" {
            star_idx = p_idx;
            match_idx = t_idx;
            p_idx = p_idx + 1;
        } else if star_idx != -1 {
            p_idx = star_idx + 1;
            match_idx = match_idx + 1;
            t_idx = match_idx;
        } else {
            return false;
        }
    }

    while p_idx < p_len && slice(pattern, p_idx, p_idx + 1) == "*" {
        p_idx = p_idx + 1;
    }

    return p_idx == p_len;
}

fn main() -> int {
    // 1. Literal exact matches
    assert(glob_match("main.ltl", "main.ltl"));
    assert(!glob_match("main.ltl", "test.ltl"));

    // 2. Question mark single character wildcard
    assert(glob_match("file?.txt", "file1.txt"));
    assert(glob_match("file?.txt", "fileA.txt"));
    assert(!glob_match("file?.txt", "file12.txt"));
    assert(!glob_match("file?.txt", "file.txt"));

    // 3. Asterisk multi-character wildcard
    assert(glob_match("*.ltl", "compiler.ltl"));
    assert(glob_match("*.ltl", ".ltl"));
    assert(glob_match("src/*", "src/main.rs"));
    assert(glob_match("test_*_spec.py", "test_compiler_spec.py"));

    // 4. Multiple asterisks and combinations
    assert(glob_match("*.*", "document.pdf"));
    assert(glob_match("*lib*tutorial*", "stdlib_glob_tutorial.ltl"));
    assert(glob_match("?*?", "abc"));
    assert(!glob_match("?*?", "a"));

    // 5. Empty string edge cases
    assert(glob_match("", ""));
    assert(glob_match("*", ""));
    assert(glob_match("***", ""));
    assert(!glob_match("?", ""));
    assert(!glob_match("a", ""));

    return 0;
}
