// Prime and twin-prime counter — Lateralus port of examples/ports/prime_sieve.py.
// Idiomatic ~50-line Python -> Lateralus for the recurring port bounty.
// Sieve of Eratosthenes over a bool array; prints prime count then twin
// prime pair count, one per line, matching the Python reference.
// Note: variable << / >> hit C99 codegen edges, so multiples use * and /.

fn main() {
    let n = 5000000
    let mut is_prime = [true] * (n + 1)
    is_prime[0] = false
    is_prime[1] = false
    let mut p = 2
    while p * p <= n {
        if is_prime[p] {
            let mut multiple = p * p
            while multiple <= n {
                is_prime[multiple] = false
                multiple = multiple + p
            }
        }
        p = p + 1
    }
    let mut prime_count = 0
    let mut twin_count = 0
    let mut prev_prime = 0 - 1
    let mut candidate = 2
    while candidate <= n {
        if is_prime[candidate] {
            prime_count = prime_count + 1
            if prev_prime >= 0 {
                if candidate - prev_prime == 2 {
                    twin_count = twin_count + 1
                }
            }
            prev_prime = candidate
        }
        candidate = candidate + 1
    }
    println(prime_count)
    println(twin_count)
}

main()
