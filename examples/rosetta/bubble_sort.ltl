// Rosetta Code · Sorting algorithms/Bubble sort · Lateralus

fn bubble_sort(xs: list) -> list {
    let a = list_copy(xs)
    let n = len(a)
    let i = 0
    while i < n {
        let j = 0
        while j < n - 1 - i {
            if a[j] > a[j + 1] {
                let t = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            }
            j = j + 1
        }
        i = i + 1
    }
    return a
}

fn main() {
    assert_eq(bubble_sort([5, 2, 9, 1, 5, 6]), [1, 2, 5, 5, 6, 9], "ints")
    assert_eq(bubble_sort(["b", "a", "c"]), ["a", "b", "c"], "strings")
    assert_eq(bubble_sort([]), [], "empty")
    print("bubble_sort: " + str(bubble_sort([3, 1, 2])))
}

main()
