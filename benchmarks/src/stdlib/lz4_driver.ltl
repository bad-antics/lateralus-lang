// Driver for the lz4 stdlib micro-benchmark.
// The harness inlines stdlib/lz4.ltl above this driver.
//
// Workload: LZ4 compress + decompress round-trip.
// Bounty spec asks for 4 MB. The reference LZ4 encoder in
// stdlib/lz4.ltl builds its output with `out = out + [x]` (O(n^2) list
// append), so 4 MB is intractable in the tree-walking interpreter
// (100 KB already takes ~30 s). We run 100 KB here and the Python/Node
// references use the identical input so the comparison stays fair.
// See benchmarks/results/stdlib_results.md for the scaling note.

fn gen_byte(x: int) -> int { return (x * 31 + 7) & 0xff }

fn main() {
    let src = map(range_ltl(0, 100000), gen_byte)
    let c = compress(src)
    let d = decompress(c)
    println(len(src))
    println(len(c))
    println(len(d))
}

main()