// Standard Library Diff / LCS Tutorial Verification Suite
// Validates Longest Common Subsequence, Shortest Edit Script (SES), and Unified Diff Generation.

fn max_int(a: int, b: int) -> int {
    if a > b {
        return a;
    }
    return b;
}

fn compute_lcs_table(a: list, b: list) -> list {
    let n = len(a);
    let m = len(b);
    let cols = m + 1;
    let total_cells = (n + 1) * cols;

    let mut dp = [];
    let mut k = 0;
    while k < total_cells {
        dp = dp + [0];
        k = k + 1;
    }

    let mut i = 1;
    while i <= n {
        let mut j = 1;
        while j <= m {
            let idx = i * cols + j;
            if a[i - 1] == b[j - 1] {
                let prev_diag = (i - 1) * cols + (j - 1);
                dp[idx] = dp[prev_diag] + 1;
            } else {
                let up = (i - 1) * cols + j;
                let left = i * cols + (j - 1);
                dp[idx] = max_int(dp[up], dp[left]);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return dp;
}

fn generate_unified_diff(a: list, b: list) -> list {
    let n = len(a);
    let m = len(b);
    let cols = m + 1;
    let dp = compute_lcs_table(a, b);

    let mut reversed_diff = [];
    let mut i = n;
    let mut j = m;

    while i > 0 || j > 0 {
        if i > 0 && j > 0 && a[i - 1] == b[j - 1] {
            reversed_diff = reversed_diff + [" " + a[i - 1]];
            i = i - 1;
            j = j - 1;
        } else if j > 0 && (i == 0 || dp[i * cols + (j - 1)] >= dp[(i - 1) * cols + j]) {
            reversed_diff = reversed_diff + ["+" + b[j - 1]];
            j = j - 1;
        } else if i > 0 && (j == 0 || dp[(i - 1) * cols + j] > dp[i * cols + (j - 1)]) {
            reversed_diff = reversed_diff + ["-" + a[i - 1]];
            i = i - 1;
        }
    }

    // Reverse to chronological order
    let mut diff = [];
    let mut k = len(reversed_diff) - 1;
    while k >= 0 {
        diff = diff + [reversed_diff[k]];
        k = k - 1;
    }
    return diff;
}

fn main() -> int {
    // 1. Identical inputs: No additions, no deletions
    let a1 = ["line 1", "line 2", "line 3"];
    let b1 = ["line 1", "line 2", "line 3"];
    let diff1 = generate_unified_diff(a1, b1);
    assert(len(diff1) == 3);
    assert(diff1[0] == " line 1");
    assert(diff1[1] == " line 2");
    assert(diff1[2] == " line 3");

    // 2. Replacement in the middle
    let a2 = ["func init()", "  let timeout = 10;", "  return 0;"];
    let b2 = ["func init()", "  let timeout = 60;", "  return 0;"];
    let diff2 = generate_unified_diff(a2, b2);
    assert(len(diff2) == 4);
    assert(diff2[0] == " func init()");
    assert(diff2[1] == "-  let timeout = 10;");
    assert(diff2[2] == "+  let timeout = 60;");
    assert(diff2[3] == "  return 0;");

    // 3. Pure Insertion
    let a3 = ["alpha", "gamma"];
    let b3 = ["alpha", "beta", "gamma"];
    let diff3 = generate_unified_diff(a3, b3);
    assert(len(diff3) == 3);
    assert(diff3[0] == " alpha");
    assert(diff3[1] == "+beta");
    assert(diff3[2] == " gamma");

    // 4. Pure Deletion
    let a4 = ["alpha", "deprecated", "gamma"];
    let b4 = ["alpha", "gamma"];
    let diff4 = generate_unified_diff(a4, b4);
    assert(len(diff4) == 3);
    assert(diff4[0] == " alpha");
    assert(diff4[1] == "-deprecated");
    assert(diff4[2] == " gamma");

    // 5. Invariant: Reconstructed text from diff must equal targets
    // Reconstructing b2 from a2 and diff2
    let mut reconstructed_b = [];
    let mut idx = 0;
    while idx < len(diff2) {
        let entry = diff2[idx];
        let prefix = slice(entry, 0, 1);
        let content = slice(entry, 1, len(entry));
        if prefix == " " || prefix == "+" {
            reconstructed_b = reconstructed_b + [content];
        }
        idx = idx + 1;
    }
    assert(len(reconstructed_b) == len(b2));
    let mut check_idx = 0;
    while check_idx < len(b2) {
        assert(reconstructed_b[check_idx] == b2[check_idx]);
        check_idx = check_idx + 1;
    }

    return 0;
}