// Convex Hull Tutorial Example
// Demonstrates collision bounding polygon generation for 2D game entities

// Import convex hull functions
import "stdlib/convex_hull.ltl"

// Define game entity coordinates
let entities = [
    (10.0, 20.0),   // Player
    (15.0, 25.0),   // Enemy 1
    (30.0, 35.0),   // Enemy 2
    (25.0, 15.0),   // Enemy 3
    (5.0, 30.0),    // Power-up
    (40.0, 20.0),   // Obstacle
    (35.0, 40.0),   // Obstacle
    (20.0, 10.0)    // Collectible
]

// Generate collision bounding hull
let collision_hull = convex_hull(entities)

// Print results
println!("Original entities:")
for entity in entities {
    println!("  ({}, {})", entity.0, entity.1)
}

println!("\nCollision bounding hull:")
for vertex in collision_hull {
    println!("  ({}, {})", vertex.0, vertex.1)
}

// Calculate hull area
let hull_area = polygon_area(collision_hull)
println!("\nHull area: {}", hull_area)

// Test point collision detection
let test_points = [
    (15.0, 20.0),   // Should be inside
    (50.0, 50.0),   // Should be outside
    (25.0, 25.0)    // Should be inside
]

println!("\nPoint collision tests:")
for point in test_points {
    let inside = point_in_hull(point, collision_hull)
    println!("  ({}, {}): {}", point.0, point.1, if inside {"INSIDE"} else {"OUTSIDE"})
}

// Example with collinear points
let collinear_points = [
    (0.0, 0.0),
    (1.0, 1.0),
    (2.0, 2.0),
    (3.0, 3.0),
    (1.0, 0.0),
    (2.0, 0.0)
]

let collinear_hull = convex_hull(collinear_points)

println!("\nCollinear points hull:")
for vertex in collinear_hull {
    println!("  ({}, {})", vertex.0, vertex.1)
}

// Example with triangle boundary
let triangle_points = [
    (0.0, 0.0),
    (10.0, 0.0),
    (5.0, 8.0)
]

let triangle_hull = convex_hull(triangle_points)

println!("\nTriangle hull:")
for vertex in triangle_hull {
    println!("  ({}, {})", vertex.0, vertex.1)
}