// ===================================================================
// examples/parsec_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: Predictive Declaration Statement Grammar
// Recognizer using Choice & Sequence Combinators (stdlib/parsec.ltl)
// ===================================================================

// Token codes: 1=LET, 2=CONST, 3=IDENT, 4=EQ, 5=NUMBER, 6=SEMI

pub fn parse_choice(tokens, n, pos, tok_a, tok_b) {
    if pos >= n { return -1 }
    if (tokens[pos] == tok_a) || (tokens[pos] == tok_b) {
        return pos + 1
    }
    return -1
}

pub fn parse_sequence2(tokens, n, pos, tok_first, tok_second) {
    if (pos + 1) >= n { return -1 }
    if (tokens[pos] == tok_first) && (tokens[pos + 1] == tok_second) {
        return pos + 2
    }
    return -1
}

pub fn parse_decl_stmt(tokens, n, pos) {
    // Grammar: (LET | CONST) IDENT EQ NUMBER SEMI
    let p1 = parse_choice(tokens, n, pos, 1, 2)
    if p1 < 0 { return -1 }

    let p2 = parse_sequence2(tokens, n, p1, 3, 4)
    if p2 < 0 { return -1 }

    let p3 = parse_sequence2(tokens, n, p2, 5, 6)
    return p3
}

pub fn main() {
    print("=== Parsec Combinator Grammar Verification ===")

    // Stream: CONST IDENT EQ NUMBER SEMI (tokens: [2, 3, 4, 5, 6])
    let stream = dict()
    stream[0] = 2; stream[1] = 3; stream[2] = 4; stream[3] = 5; stream[4] = 6

    let end_pos = parse_decl_stmt(stream, 5, 0)
    assert(end_pos == 5, "Valid CONST declaration consumes all 5 tokens")

    // Invalid stream: LET EQ NUMBER SEMI (missing IDENT -> [1, 4, 5, 6])
    let bad = dict()
    bad[0] = 1; bad[1] = 4; bad[2] = 5; bad[3] = 6
    let bad_pos = parse_decl_stmt(bad, 4, 0)
    assert(bad_pos == -1, "Missing IDENT must fail and backtrack cleanly")

    print("All Parsec choice and sequence combinator vectors verified!")
}
