// Advent of Code 2024 · Day 14 · Restroom Redoubt
// Robots move in straight lines, wrapping around the grid.
// Part 1: after 100 seconds count robots in each quadrant; multiply counts.
// Part 2: find the fewest seconds until robots form a Christmas tree pattern.
//         (Use minimum safety factor as a heuristic for the tree shape.)

let SAMPLE = "p=0,4 v=3,-3
p=6,3 v=-1,-3
p=10,3 v=-1,2
p=2,0 v=2,-1
p=0,0 v=1,3
p=3,0 v=-2,-2
p=7,6 v=-1,-3
p=3,0 v=-2,-2
p=9,3 v=2,3
p=7,3 v=-1,2
p=2,4 v=2,-3
p=9,5 v=-3,-3"

// Sample uses 11x7 grid; real input uses 101x103
let SAMPLE_W = 11
let SAMPLE_H = 7

fn parse_robots(text: str) -> list {
    let lines = str_split(text, "\n")
    let robots = []
    let i = 0
    while i < len(lines) {
        let line = str_trim(lines[i])
        if len(line) > 0 {
            // "p=x,y v=dx,dy"
            let parts = str_split(line, " ")
            let ppart = str_split(parts[0], "=")
            let vpart = str_split(parts[1], "=")
            let pxy = str_split(ppart[1], ",")
            let vxy = str_split(vpart[1], ",")
            let px = int(str_trim(pxy[0]))
            let py = int(str_trim(pxy[1]))
            let vx = int(str_trim(vxy[0]))
            let vy = int(str_trim(vxy[1]))
            robots = robots + [[px, py, vx, vy]]
        }
        i = i + 1
    }
    return robots
}

fn pos_after(px: int, py: int, vx: int, vy: int, t: int, w: int, h: int) -> list {
    let x = ((px + vx * t) % w + w) % w
    let y = ((py + vy * t) % h + h) % h
    return [x, y]
}

fn safety_factor(robots: list, t: int, w: int, h: int) -> int {
    let mx = w / 2
    let my = h / 2
    let q1 = 0
    let q2 = 0
    let q3 = 0
    let q4 = 0
    let i = 0
    while i < len(robots) {
        let r = robots[i]
        let p = pos_after(r[0], r[1], r[2], r[3], t, w, h)
        let x = p[0]
        let y = p[1]
        if x < mx && y < my { q1 = q1 + 1 }
        if x > mx && y < my { q2 = q2 + 1 }
        if x < mx && y > my { q3 = q3 + 1 }
        if x > mx && y > my { q4 = q4 + 1 }
        i = i + 1
    }
    return q1 * q2 * q3 * q4
}

fn part1_wh(text: str, w: int, h: int) -> int {
    let robots = parse_robots(text)
    return safety_factor(robots, 100, w, h)
}

fn part1(text: str) -> int {
    return part1_wh(text, SAMPLE_W, SAMPLE_H)
}

// Part 2: find minimum safety factor (Christmas tree = clustered robots)
// For the sample we just return 0 as a placeholder; real puzzle needs 101x103 grid.
fn part2(text: str) -> int {
    let robots = parse_robots(text)
    let w = SAMPLE_W
    let h = SAMPLE_H
    let min_sf = safety_factor(robots, 0, w, h)
    let best_t = 0
    let t = 1
    while t < w * h {
        let sf = safety_factor(robots, t, w, h)
        if sf < min_sf {
            min_sf = sf
            best_t = t
        }
        t = t + 1
    }
    return best_t
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 12)
}

fn main() {
    print("Day 14 Part 1: " + str(part1(SAMPLE)))
    print("Day 14 Part 2 (sample, min safety factor): " + str(part2(SAMPLE)))
}

main()
