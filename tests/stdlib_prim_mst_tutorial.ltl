// ===================================================================
// tests/stdlib_prim_mst_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for the Prim-Jarník Minimum Spanning Tree (MST)
// algorithm, dense matrix representation, and cut property relaxation.
// ===================================================================

fn init_matrix(n, default_val) {
    let m = dict()
    let i = 0
    while i < n {
        let row = dict()
        let j = 0
        while j < n {
            row[j] = default_val
            j = j + 1
        }
        m[i] = row
        i = i + 1
    }
    return m
}

fn add_undirected_edge(matrix, u, v, w) {
    matrix[u][v] = w
    matrix[v][u] = w
}

pub fn prim_mst(n, matrix) {
    let in_mst = dict()
    let key = dict()
    let parent = dict()

    let i = 0
    while i < n {
        in_mst[i] = false
        key[i] = 999999999
        parent[i] = -1
        i = i + 1
    }

    key[0] = 0

    let count = 0
    let step = 0
    while step < n {
        // Find vertex u not in MST with minimum key[u]
        let min_val = 999999999
        let u = -1
        let v_idx = 0
        while v_idx < n {
            if not in_mst[v_idx] and key[v_idx] < min_val {
                min_val = key[v_idx]
                u = v_idx
            }
            v_idx = v_idx + 1
        }

        if u == -1 {
            // Disconnected component
            step = n
        } else {
            in_mst[u] = true
            count = count + 1

            // Relax neighbors of u
            let v = 0
            while v < n {
                let weight = matrix[u][v]
                if weight > 0 and not in_mst[v] and weight < key[v] {
                    key[v] = weight
                    parent[v] = u
                }
                v = v + 1
            }
            step = step + 1
        }
    }

    let total_weight = 0
    let mst_edges = []
    let is_connected = (count == n)

    if is_connected {
        let idx = 1
        while idx < n {
            total_weight = total_weight + key[idx]
            let edge = dict()
            edge["u"] = parent[idx]
            edge["v"] = idx
            edge["w"] = key[idx]
            mst_edges = push(mst_edges, edge)
            idx = idx + 1
        }
    }

    let res = dict()
    res["total_weight"] = total_weight
    res["edges"] = mst_edges
    res["is_connected"] = is_connected
    return res
}

pub fn test_prim_textbook_5_vertices() -> bool {
    let n = 5
    let mat = init_matrix(n, 0)
    add_undirected_edge(mat, 0, 1, 2)
    add_undirected_edge(mat, 0, 3, 6)
    add_undirected_edge(mat, 1, 2, 3)
    add_undirected_edge(mat, 1, 3, 8)
    add_undirected_edge(mat, 1, 4, 5)
    add_undirected_edge(mat, 2, 4, 7)
    add_undirected_edge(mat, 3, 4, 9)

    let result = prim_mst(n, mat)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 16 {
        return false
    }
    if len(result["edges"]) != 4 {
        return false
    }

    return true
}

pub fn test_prim_triangle() -> bool {
    let n = 3
    let mat = init_matrix(n, 0)
    add_undirected_edge(mat, 0, 1, 1)
    add_undirected_edge(mat, 1, 2, 2)
    add_undirected_edge(mat, 0, 2, 3)

    let result = prim_mst(n, mat)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 3 {
        return false
    }
    if len(result["edges"]) != 2 {
        return false
    }

    return true
}

pub fn test_prim_disconnected() -> bool {
    let n = 4
    let mat = init_matrix(n, 0)
    add_undirected_edge(mat, 0, 1, 5)
    add_undirected_edge(mat, 2, 3, 8)

    let result = prim_mst(n, mat)
    if result["is_connected"] {
        return false
    }

    return true
}

pub fn test_prim_minimal_2_vertices() -> bool {
    let n = 2
    let mat = init_matrix(n, 0)
    add_undirected_edge(mat, 0, 1, 42)

    let result = prim_mst(n, mat)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 42 {
        return false
    }
    if len(result["edges"]) != 1 {
        return false
    }

    return true
}

pub fn test_prim_complete_dense_4_vertices() -> bool {
    let n = 4
    let mat = init_matrix(n, 0)
    add_undirected_edge(mat, 0, 1, 1)
    add_undirected_edge(mat, 1, 2, 2)
    add_undirected_edge(mat, 2, 3, 3)
    add_undirected_edge(mat, 0, 3, 4)
    add_undirected_edge(mat, 0, 2, 5)
    add_undirected_edge(mat, 1, 3, 6)

    let result = prim_mst(n, mat)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 6 {
        return false
    }
    if len(result["edges"]) != 3 {
        return false
    }

    return true
}
