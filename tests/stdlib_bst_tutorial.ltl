// Standard Library Binary Search Tree (BST) Verification Suite
// Validates node ordering invariants, O(h) recursive search/insert, min/max extraction, and in-order sorted projection.

fn bst_new(val: int) -> dict {
    let mut node = {};
    node["val"] = val;
    node["left"] = nil;
    node["right"] = nil;
    return node;
}

fn bst_insert(root: dict, val: int) -> dict {
    if root == nil {
        return bst_new(val);
    }
    let r_val = root["val"];
    if val < r_val {
        root["left"] = bst_insert(root["left"], val);
    } else {
        if val > r_val {
            root["right"] = bst_insert(root["right"], val);
        }
    }
    return root;
}

fn bst_search(root: dict, val: int) -> bool {
    if root == nil {
        return false;
    }
    let r_val = root["val"];
    if val == r_val {
        return true;
    }
    if val < r_val {
        return bst_search(root["left"], val);
    }
    return bst_search(root["right"], val);
}

fn bst_min(root: dict) -> int {
    let mut curr = root;
    while curr["left"] != nil {
        curr = curr["left"];
    }
    return curr["val"];
}

fn bst_max(root: dict) -> int {
    let mut curr = root;
    while curr["right"] != nil {
        curr = curr["right"];
    }
    return curr["val"];
}

fn bst_inorder(root: dict) -> list {
    if root == nil {
        return [];
    }
    let left_list = bst_inorder(root["left"]);
    let right_list = bst_inorder(root["right"]);
    return left_list + [root["val"]] + right_list;
}

fn main() -> int {
    // 1. Classical 7-Node BST
    // Insert order: 50, 30, 70, 20, 40, 60, 80
    let mut root = bst_new(50);
    root = bst_insert(root, 30);
    root = bst_insert(root, 70);
    root = bst_insert(root, 20);
    root = bst_insert(root, 40);
    root = bst_insert(root, 60);
    root = bst_insert(root, 80);

    // Search tests
    assert(bst_search(root, 50) == true);
    assert(bst_search(root, 20) == true);
    assert(bst_search(root, 40) == true);
    assert(bst_search(root, 70) == true);
    assert(bst_search(root, 80) == true);
    assert(bst_search(root, 10) == false);
    assert(bst_search(root, 45) == false);
    assert(bst_search(root, 99) == false);

    // Extremum queries
    assert(bst_min(root) == 20);
    assert(bst_max(root) == 80);

    // In-order traversal must be strictly ascending
    let sorted = bst_inorder(root);
    assert(len(sorted) == 7);
    assert(sorted[0] == 20);
    assert(sorted[1] == 30);
    assert(sorted[2] == 40);
    assert(sorted[3] == 50);
    assert(sorted[4] == 60);
    assert(sorted[5] == 70);
    assert(sorted[6] == 80);

    // 2. Skewed BST (Descending chain: 5 -> 4 -> 3 -> 2 -> 1)
    let mut skewed = bst_new(5);
    skewed = bst_insert(skewed, 4);
    skewed = bst_insert(skewed, 3);
    skewed = bst_insert(skewed, 2);
    skewed = bst_insert(skewed, 1);

    assert(bst_min(skewed) == 1);
    assert(bst_max(skewed) == 5);
    let skewed_inorder = bst_inorder(skewed);
    assert(len(skewed_inorder) == 5);
    assert(skewed_inorder[0] == 1);
    assert(skewed_inorder[4] == 5);

    // 3. Single-Node Base Case
    let single = bst_new(100);
    assert(bst_search(single, 100) == true);
    assert(bst_search(single, 50) == false);
    assert(bst_min(single) == 100);
    assert(bst_max(single) == 100);
    let single_inorder = bst_inorder(single);
    assert(len(single_inorder) == 1);
    assert(single_inorder[0] == 100);

    return 0;
}
