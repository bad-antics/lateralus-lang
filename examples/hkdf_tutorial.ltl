#!/usr/bin/env lateralus
import "hkdf"
fn test_rfc5869_1() {
    let ikm = hkdf.hex_to_bytes("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let salt = hkdf.hex_to_bytes("000102030405060708090a0b0c")
    let info = hkdf.hex_to_bytes("f0f1f2f3f4f5f6f7f8f9")
    let L = 42
    let expected_prk = hkdf.hex_to_bytes("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5")
    let expected_okm = hkdf.hex_to_bytes("3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865")
    let prk = hkdf.extract(salt, ikm)
    assert(hkdf.bytes_to_hex(prk) == hkdf.bytes_to_hex(expected_prk))
    let okm = hkdf.expand(prk, info, L)
    assert(hkdf.bytes_to_hex(okm) == hkdf.bytes_to_hex(expected_okm))
    let key = hkdf.derive_key(ikm, salt, info, L)
    assert(hkdf.bytes_to_hex(key) == hkdf.bytes_to_hex(expected_okm))
    print("RFC 5869 Test Case 1: PASSED")
}
fn test_rfc5869_2() {
    let ikm = hkdf.hex_to_bytes("000102030405060708090a0b0c0d0e0f")
    let salt = hkdf.hex_to_bytes("")
    let info = hkdf.hex_to_bytes("")
    let L = 32
    let expected_prk = hkdf.hex_to_bytes("19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04")
    let expected_okm = hkdf.hex_to_bytes("8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d")
    let prk = hkdf.extract(salt, ikm)
    assert(hkdf.bytes_to_hex(prk) == hkdf.bytes_to_hex(expected_prk))
    let okm = hkdf.expand(prk, info, L)
    assert(hkdf.bytes_to_hex(okm) == hkdf.bytes_to_hex(expected_okm))
    print("RFC 5869 Test Case 2: PASSED")
}
fn test_derive_many() {
    let ikm = hkdf.hex_to_bytes("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b")
    let salt = hkdf.hex_to_bytes("000102030405060708090a0b0c")
    let info_list = [hkdf.hex_to_bytes("f0f1f2f3f4f5f6f7f8f9"), hkdf.hex_to_bytes("a0a1a2a3a4a5a6a7a8a9")]
    let lengths = [32, 32]
    let keys = hkdf.derive_many(ikm, salt, info_list, lengths)
    assert(len(keys) == 2)
    assert(len(keys[0]) == 32)
    assert(hkdf.bytes_to_hex(keys[0]) != hkdf.bytes_to_hex(keys[1]))
    print("derive_many: PASSED")
}
fn main() { test_rfc5869_1(); test_rfc5869_2(); test_derive_many(); print("All hkdf tests PASSED") }