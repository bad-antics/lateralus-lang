// Advent of Code 2024 · Day 11 · Plutonian Pebbles
// Stones transform each blink:
//   0 → 1
//   even digit count → split into two stones (left half, right half digits)
//   else → multiply by 2024
// Part 1: count stones after 25 blinks.
// Part 2: count stones after 75 blinks.
// Key insight: use memoization on (stone_value, blinks_remaining).

let SAMPLE = "125 17"

fn digit_count(n: int) -> int {
    if n == 0 { return 1 }
    let count = 0
    let x = n
    while x > 0 {
        x = x / 10
        count = count + 1
    }
    return count
}

fn split_stone(n: int, dc: int) -> list {
    // Split a dc-digit number at the midpoint
    let half = dc / 2
    let divisor = 1
    let i = 0
    while i < half {
        divisor = divisor * 10
        i = i + 1
    }
    let left = n / divisor
    let right = n % divisor
    return [left, right]
}

// Cache: key = "value,blinks" → count
let CACHE = {}

fn count_stones(val: int, blinks: int) -> int {
    if blinks == 0 { return 1 }
    let key = str(val) + "," + str(blinks)
    if contains(CACHE, key) { return CACHE[key] }

    let result = 0
    if val == 0 {
        result = count_stones(1, blinks - 1)
    } else {
        let dc = digit_count(val)
        if dc % 2 == 0 {
            let parts = split_stone(val, dc)
            result = count_stones(parts[0], blinks - 1) + count_stones(parts[1], blinks - 1)
        } else {
            result = count_stones(val * 2024, blinks - 1)
        }
    }
    CACHE[key] = result
    return result
}

fn solve(text: str, blinks: int) -> int {
    let toks = str_split(str_trim(text), " ")
    let total = 0
    let i = 0
    while i < len(toks) {
        let t = str_trim(toks[i])
        if len(t) > 0 {
            total = total + count_stones(int(t), blinks)
        }
        i = i + 1
    }
    return total
}

fn part1(text: str) -> int {
    return solve(text, 25)
}

fn part2(text: str) -> int {
    return solve(text, 75)
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 55312)
}

fn main() {
    print("Day 11 Part 1: " + str(part1(SAMPLE)))
    print("Day 11 Part 2: " + str(part2(SAMPLE)))
}

main()
