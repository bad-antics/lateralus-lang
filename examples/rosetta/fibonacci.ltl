// Rosetta Code: Fibonacci sequence (iterative)
// Run: python3 -m lateralus_lang run examples/rosetta/01_fibonacci.ltl
fn fib(n: int) -> int {
    let mut a = 0
    let mut b = 1
    let mut i = 0
    while i < n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

for n in range(0, 15) {
    println("fib(" + str(n) + ") = " + str(fib(n)))
}

// self-check
if fib(10) == 55 && fib(14) == 377 { println("OK") } else { println("FAIL") }
