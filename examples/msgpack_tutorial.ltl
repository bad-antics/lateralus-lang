// examples/msgpack_tutorial.ltl — Executable demonstration of stdlib.msgpack
// Demonstrates encoding and decoding of scalars, collections, and nested payloads.

fn main() {
    // 1. Primitive scalar values
    let val_nil = nil
    let val_bool = true
    let val_int = 42
    let val_neg = -15
    let val_str = "lateralus"

    let b_nil = encode(val_nil)
    let b_bool = encode(val_bool)
    let b_int = encode(val_int)
    let b_neg = encode(val_neg)
    let b_str = encode(val_str)

    // Verify roundtrips
    let rec_nil = decode(b_nil)[0]
    let rec_bool = decode(b_bool)[0]
    let rec_int = decode(b_int)[0]
    let rec_neg = decode(b_neg)[0]
    let rec_str = decode(b_str)[0]

    // 2. Arrays and Maps
    let sample_arr = [1, 2, 3, 4]
    let sample_map = { key: 100, flag: false }

    let b_arr = encode(sample_arr)
    let b_map = encode(sample_map)

    let rec_arr = decode(b_arr)[0]
    let rec_map = decode(b_map)[0]

    println("MsgPack roundtrip verified successfully.")
}

main()
