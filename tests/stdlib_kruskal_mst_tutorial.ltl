// ===================================================================
// tests/stdlib_kruskal_mst_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for Kruskal's Minimum Spanning Tree (MST)
// algorithm, greedy edge sorting, and Disjoint Set Union (DSU).
// ===================================================================

fn make_edge(u, v, w) {
    let e = dict()
    e["u"] = u
    e["v"] = v
    e["w"] = w
    return e
}

fn sort_edges(edges) {
    let n = len(edges)
    let i = 1
    while i < n {
        let key = edges[i]
        let j = i - 1
        while j >= 0 and edges[j]["w"] > key["w"] {
            edges[j + 1] = edges[j]
            j = j - 1
        }
        edges[j + 1] = key
        i = i + 1
    }
    return edges
}

fn dsu_find(parent, i) {
    let p = parent[i]
    while p != parent[p] {
        p = parent[p]
    }
    return p
}

fn dsu_union(parent, rank, x, y) {
    let root_x = dsu_find(parent, x)
    let root_y = dsu_find(parent, y)
    if root_x == root_y {
        return false
    }
    if rank[root_x] < rank[root_y] {
        parent[root_x] = root_y
    } else {
        if rank[root_x] > rank[root_y] {
            parent[root_y] = root_x
        } else {
            parent[root_y] = root_x
            rank[root_x] = rank[root_x] + 1
        }
    }
    return true
}

pub fn kruskal_mst(n, edges) {
    let sorted_edges = sort_edges(edges)

    let parent = dict()
    let rank = dict()
    let i = 0
    while i < n {
        parent[i] = i
        rank[i] = 0
        i = i + 1
    }

    let mst_edges = []
    let total_weight = 0
    let edge_count = 0

    let idx = 0
    while idx < len(sorted_edges) and edge_count < n - 1 {
        let edge = sorted_edges[idx]
        let u = edge["u"]
        let v = edge["v"]
        let w = edge["w"]

        if dsu_union(parent, rank, u, v) {
            mst_edges = push(mst_edges, edge)
            total_weight = total_weight + w
            edge_count = edge_count + 1
        }
        idx = idx + 1
    }

    let res = dict()
    res["edges"] = mst_edges
    res["total_weight"] = total_weight
    res["is_connected"] = (edge_count == n - 1)
    return res
}

pub fn test_kruskal_textbook_4_vertices() -> bool {
    let edges = [
        make_edge(0, 1, 10),
        make_edge(0, 2, 6),
        make_edge(0, 3, 5),
        make_edge(1, 3, 15),
        make_edge(2, 3, 4)
    ]

    let result = kruskal_mst(4, edges)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 19 {
        return false
    }
    if len(result["edges"]) != 3 {
        return false
    }

    return true
}

pub fn test_kruskal_triangle() -> bool {
    let edges = [
        make_edge(0, 1, 1),
        make_edge(1, 2, 2),
        make_edge(0, 2, 3)
    ]

    let result = kruskal_mst(3, edges)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 3 {
        return false
    }
    if len(result["edges"]) != 2 {
        return false
    }

    return true
}

pub fn test_kruskal_disconnected_graph() -> bool {
    let edges = [
        make_edge(0, 1, 5),
        make_edge(2, 3, 8)
    ]

    let result = kruskal_mst(4, edges)
    if result["is_connected"] {
        return false
    }
    if result["total_weight"] != 13 {
        return false
    }
    if len(result["edges"]) != 2 {
        return false
    }

    return true
}

pub fn test_kruskal_minimal_2_vertices() -> bool {
    let edges = [
        make_edge(0, 1, 42)
    ]

    let result = kruskal_mst(2, edges)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 42 {
        return false
    }
    if len(result["edges"]) != 1 {
        return false
    }

    return true
}

pub fn test_kruskal_identical_weights() -> bool {
    let edges = [
        make_edge(0, 1, 7),
        make_edge(1, 2, 7),
        make_edge(0, 2, 7)
    ]

    let result = kruskal_mst(3, edges)
    if not result["is_connected"] {
        return false
    }
    if result["total_weight"] != 14 {
        return false
    }
    if len(result["edges"]) != 2 {
        return false
    }

    return true
}
