// ===================================================================
// stdlib/crc.ltl — Cyclic redundancy checks
// -------------------------------------------------------------------
// Bitwise CRC implementations. The reflected (LSB-first) variants are
// the ones used on the wire by PNG, ZIP, gzip, Ethernet and most
// serial protocols.
//
// Every value here is checked against the published catalogue of CRC
// parameters and against the standard check value, which is the CRC
// of the ASCII string "123456789":
//
//   crc32(123456789)        = 0xCBF43926
//   crc16_arc(123456789)    = 0xBB3D
//   crc16_ccitt(123456789)  = 0x29B1
//   crc8(123456789)         = 0xF4
// ===================================================================

// -- CRC-32 (reflected, poly 0xEDB88320, init 0xFFFFFFFF, xorout 0xFFFFFFFF)
// The one used by PNG, ZIP, gzip and the Ethernet FCS.

pub fn crc32(data: list) -> u32 {
    let crc = 0xFFFFFFFF
    for b in data {
        crc = crc ^ (b & 0xFF)
        let i = 0
        while i < 8 {
            if crc & 1 != 0 {
                crc = (crc >> 1) ^ 0xEDB88320
            } else {
                crc = crc >> 1
            }
            i = i + 1
        }
    }
    return (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

// -- CRC-16/ARC (reflected, poly 0xA001, init 0x0000, xorout 0x0000)
// Used by ARC and LHA.

pub fn crc16_arc(data: list) -> u16 {
    let crc = 0x0000
    for b in data {
        crc = crc ^ (b & 0xFF)
        let i = 0
        while i < 8 {
            if crc & 1 != 0 {
                crc = (crc >> 1) ^ 0xA001
            } else {
                crc = crc >> 1
            }
            i = i + 1
        }
    }
    return crc & 0xFFFF
}

// -- CRC-16/CCITT-FALSE (MSB-first, poly 0x1021, init 0xFFFF)
// Used by X.25, Bluetooth HCI and many radio protocols.

pub fn crc16_ccitt(data: list) -> u16 {
    let crc = 0xFFFF
    for b in data {
        crc = crc ^ ((b & 0xFF) << 8)
        let i = 0
        while i < 8 {
            if crc & 0x8000 != 0 {
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            } else {
                crc = (crc << 1) & 0xFFFF
            }
            i = i + 1
        }
    }
    return crc & 0xFFFF
}

// -- CRC-8 (poly 0x07, init 0x00, no reflection)
// Used by SMBus and many sensor buses.

pub fn crc8(data: list) -> u8 {
    let crc = 0x00
    for b in data {
        crc = crc ^ (b & 0xFF)
        let i = 0
        while i < 8 {
            if crc & 0x80 != 0 {
                crc = ((crc << 1) ^ 0x07) & 0xFF
            } else {
                crc = (crc << 1) & 0xFF
            }
            i = i + 1
        }
    }
    return crc & 0xFF
}

/// Standard check value self-test for every routine in this module.
/// The check input is the ASCII string "123456789".
pub fn self_test() -> bool {
    let check = [0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39]
    if crc32(check) != 0xCBF43926 {
        return false
    }
    if crc16_arc(check) != 0xBB3D {
        return false
    }
    if crc16_ccitt(check) != 0x29B1 {
        return false
    }
    if crc8(check) != 0xF4 {
        return false
    }
    return true
}

/// Width in bits of a named variant.
pub fn width_of(name: str) -> int {
    if name == "crc32" {
        return 32
    }
    if name == "crc16_arc" {
        return 16
    }
    if name == "crc16_ccitt" {
        return 16
    }
    if name == "crc8" {
        return 8
    }
    return 0
}
