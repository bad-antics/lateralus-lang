// Rosetta Code: Quicksort (recursive)
fn qs(a: list) -> list {
    if len(a) <= 1 { return a }
    let pivot = a[0]
    let mut less = []
    let mut more = []
    let mut i = 1
    while i < len(a) {
        if a[i] < pivot { less = less + [a[i]] } else { more = more + [a[i]] }
        i = i + 1
    }
    return qs(less) + [pivot] + qs(more)
}
println(str(qs([3, 6, 1, 8, 2, 9, 4])))
if qs([3, 6, 1, 8, 2, 9, 4]) == [1, 2, 3, 4, 6, 8, 9] { println("OK") } else { println("FAIL") }
