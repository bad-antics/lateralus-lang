// Lateralus Standard Library Example: Fenwick Tree (Binary Indexed Tree)
// Demonstrates O(log n) prefix sums, dynamic point updates, and order-book volume queries.

fn lowbit(x: int) -> int {
    return x & (0 - x);
}

fn fenwick_add(tree: list, size: int, idx: int, delta: int) -> list {
    let mut t = tree;
    let mut i = idx;
    while i <= size {
        t[i] = t[i] + delta;
        i = i + lowbit(i);
    }
    return t;
}

fn fenwick_query(tree: list, idx: int) -> int {
    let mut sum = 0;
    let mut i = idx;
    while i > 0 {
        sum = sum + tree[i];
        i = i - lowbit(i);
    }
    return sum;
}

fn fenwick_range_query(tree: list, left: int, right: int) -> int {
    if left > right {
        return 0;
    }
    return fenwick_query(tree, right) - fenwick_query(tree, left - 1);
}

fn fenwick_build(arr: list) -> list {
    let n = len(arr);
    let mut tree = [];
    let mut i = 0;
    while i <= n {
        tree = tree + [0];
        i = i + 1;
    }
    let mut idx = 1;
    while idx <= n {
        tree = fenwick_add(tree, n, idx, arr[idx - 1]);
        idx = idx + 1;
    }
    return tree;
}

fn main() -> int {
    println("=== Fenwick Tree (Binary Indexed Tree) Example ===");

    // Order-book volume across 6 discrete price levels (Level 1..6)
    // Volumes: [100, 250, 400, 150, 300, 500]
    let initial_volumes = [100, 250, 400, 150, 300, 500];
    let mut tree = fenwick_build(initial_volumes);

    println("Cumulative volume up to Level 3 (Levels 1 + 2 + 3):");
    let cum_vol_3 = fenwick_query(tree, 3);
    println(cum_vol_3); // 100 + 250 + 400 = 750

    println("Range volume between Level 2 and Level 5:");
    let range_vol = fenwick_range_query(tree, 2, 5);
    println(range_vol); // 250 + 400 + 150 + 300 = 1100

    // New trade executed: +150 volume arrives at price Level 4
    println("Updating Level 4 with delta +150...");
    tree = fenwick_add(tree, 6, 4, 150);

    println("New cumulative volume up to Level 6 (total book depth):");
    let total_depth = fenwick_query(tree, 6);
    println(total_depth); // 1700 + 150 = 1850

    println("Fenwick tree execution completed successfully.");
    return 0;
}
