// Rosetta Code: Find the maximum and minimum of a list
// https://rosettacode.org/wiki/Find_the_maximum_and_minimum_of_a_list
module examples.rosetta.max_min

import io

fn list_max(xs: list) -> int {
    let best = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] > best { best = xs[i] }
        i = i + 1
    }
    return best
}

fn list_min(xs: list) -> int {
    let best = xs[0]
    let i = 1
    while i < len(xs) {
        if xs[i] < best { best = xs[i] }
        i = i + 1
    }
    return best
}

@test
fn test_max_min() {
    assert_eq(list_max([3, 1, 4, 1, 5]), 5)
    assert_eq(list_min([3, 1, 4, 1, 5]), 1)
    assert_eq(list_max([-5, -2, -9]), -2)
    assert_eq(list_min([-5, -2, -9]), -9)
}

fn main() {
    print("max([3,1,4,1,5]) = " + str(list_max([3, 1, 4, 1, 5])))
}

main()
