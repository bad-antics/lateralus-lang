// ═══════════════════════════════════════════════════════════
// LATERALUS LSP Hover Signatures Tests
// ═══════════════════════════════════════════════════════════

module LspHoverTest {

  @test
  fn test_lsp_hover_stdlib_documented() {
    LspHover.init_stdlib_signatures();
    let result = LspHover.handle_hover("Bencode.encode");
    assert(result |> contains("fn encode(data: BencodedData) -> str"));
    assert(result |> contains("Encodes input data into a string using the bencoding format."));
  }

  @test
  fn test_lsp_hover_stdlib_short_name() {
    LspHover.init_stdlib_signatures();
    let result = LspHover.handle_hover("encode");
    assert(result |> contains("fn encode(data: BencodedData) -> str"));
  }

  @test
  fn test_lsp_hover_unknown_symbol() {
    LspHover.init_stdlib_signatures();
    let result = LspHover.handle_hover("completely_unknown_symbol_xyz");
    assert(result |> contains("Unknown symbol: completely_unknown_symbol_xyz"));
  }
}
