// ===================================================================
// examples/simhash_tutorial.ltl — stdlib/simhash.ltl tutorial companion
// Runnable tour of 64-bit SimHash near-duplicate detection:
// tokenize, fingerprint, hamming, similarity, near_duplicate,
// fingerprint_all.
// Self-contained — module code inlined with documented fixes:
//   * `char_at` -> `slice` (missing runtime builtin)
//   * `xxhash_hash64` is defined nowhere in the repo -> substituted
//     with an inline FNV-1a 64 hasher (same role)
// ===================================================================

// xxhash_hash64 is referenced but defined nowhere in the repo —
// substituted with FNV-1a 64 (same role: per-token 64-bit hash).
fn fnv1a64(data: str) -> int {
    let h = 14695981039346656037
    let prime = 1099511628211
    for i in range(0, len(data)) {
        h = (h ^ ord(slice(data, i, i + 1))) * prime
    }
    return h
}

fn simhash_tokenize(text: str) -> list {
    let toks = []
    let buf = ""
    let i = 0
    while i < len(text) {
        let c = slice(text, i, i + 1)
        let oc = ord(c)
        let is_alnum = false
        if oc >= 48 && oc <= 57 { is_alnum = true }
        if oc >= 97 && oc <= 122 { is_alnum = true }
        if oc >= 65 && oc <= 90 {
            is_alnum = true
            c = chr(oc + 32)   // lowercase
        }
        if is_alnum {
            buf = buf + c
        } else {
            if len(buf) > 0 { toks = toks + [buf]; buf = "" }
        }
        i = i + 1
    }
    if len(buf) > 0 { toks = toks + [buf] }
    return toks
}

// Count each token once per occurrence — weighted by frequency.
fn fingerprint(text: str) -> int {
    let tokens = simhash_tokenize(text)
    // 64 signed accumulators, one per bit position
    let v = []
    let i = 0
    while i < 64 { v = v + [0]; i = i + 1 }

    let t = 0
    while t < len(tokens) {
        let h = fnv1a64(tokens[t])
        let b = 0
        while b < 64 {
            let bit = (h >> b) & 1
            if bit == 1 { v[b] = v[b] + 1 } else { v[b] = v[b] - 1 }
            b = b + 1
        }
        t = t + 1
    }

    let fp = 0
    let k = 0
    while k < 64 {
        if v[k] >= 0 { fp = fp | (1 << k) }
        k = k + 1
    }
    return fp
}

// Hamming distance between two 64-bit fingerprints.
fn hamming(a: int, b: int) -> int {
    let x = a ^ b
    let count = 0
    let i = 0
    while i < 64 {
        count = count + ((x >> i) & 1)
        i = i + 1
    }
    return count
}

// Similarity in [0,1].  0 hamming bits flipped -> 1.0.
fn similarity(a: int, b: int) -> float {
    return 1.0 - (hamming(a, b) / 64)
}

// Simple near-duplicate check.
fn near_duplicate(a: str, b: str, threshold_bits: int) -> bool {
    return hamming(fingerprint(a), fingerprint(b)) <= threshold_bits
}

// Build fingerprints for a batch of documents.
fn fingerprint_all(docs: list) -> list {
    let out = []
    let i = 0
    while i < len(docs) {
        out = out + [fingerprint(docs[i])]
        i = i + 1
    }
    return out
}

fn main() {
    print("=== LATERALUS STDLIB SIMHASH TUTORIAL ===")

    // -- Step 1: fingerprint determinism -----------------------------------
    print("STEP 1 fingerprint:")
    let d1 = "the quick brown fox jumps over the lazy dog"
    let d2 = "the quick brown fox jumps over the lazy dog!"
    let d3 = "completely unrelated content about databases"
    let f1 = fingerprint(d1)
    let f2 = fingerprint(d2)
    let f3 = fingerprint(d3)
    print("  f1=" + str(f1))
    print("  f1_again=" + str(fingerprint(d1)))
    print("  deterministic=" + str(f1 == fingerprint(d1)))

    // -- Step 2: hamming + similarity ----------------------------------------
    print("STEP 2 hamming/similarity:")
    print("  h12=" + str(hamming(f1, f2)))
    print("  h13=" + str(hamming(f1, f3)))
    print("  sim12=" + str(similarity(f1, f2)))
    print("  sim13=" + str(similarity(f1, f3)))
    print("  sim_self=" + str(similarity(f1, f1)))

    // -- Step 3: near_duplicate -----------------------------------------------
    print("STEP 3 near_duplicate:")
    print("  nd_punct=" + str(near_duplicate(d1, d2, 10)))
    print("  nd_far=" + str(near_duplicate(d1, d3, 10)))
    print("  nd_self=" + str(near_duplicate(d1, d1, 0)))

    // -- Step 4: fingerprint_all -------------------------------------------------
    print("STEP 4 fingerprint_all:")
    let docs = [d1, d2, d3]
    let fps = fingerprint_all(docs)
    print("  n=" + str(len(fps)))
    print("  dup_pair=" + str(hamming(fps[0], fps[1])))
    print("  diff_pair=" + str(hamming(fps[0], fps[2])))

    print("PINNED_VECTORS: deterministic h12_small h13_large "
        + "sim_self_1.0 nd_punct_true nd_far_false batch3")
    print("  OK examples/simhash_tutorial.ltl")
    return 0
}
