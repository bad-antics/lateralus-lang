// Boyer-Moore String Search Tutorial Examples
// Demonstrating practical applications of the algorithm

// Example 1: Source Code Text Search (Ctrl+F simulation)
function find_in_source_code() {
    let source_code = "
function calculateSum(a, b) {
    return a + b;
}

function calculateDifference(a, b) {
    return a - b;
}

function calculateProduct(a, b) {
    return a * b;
}
";
    
    let pattern = "function";
    let positions = boyer_moore_search(source_code, pattern);
    
    print("Found 'function' at positions:");
    for (let pos of positions) {
        print(pos);
    }
    
    // Expected output: positions of 'function' occurrences
}

// Example 2: Log File Error Pattern Scanning
function scan_log_errors() {
    let log_file = "
2023-01-01 10:00:00 INFO Application started
2023-01-01 10:01:00 ERROR Database connection failed
2023-01-01 10:02:00 INFO Retrying connection
2023-01-01 10:03:00 ERROR Authentication failed
2023-01-01 10:04:00 ERROR Payment processing failed
2023-01-01 10:05:00 INFO Application shutting down
";
    
    let error_pattern = "ERROR";
    let error_positions = boyer_moore_search(log_file, error_pattern);
    
    print("Found errors at positions:");
    for (let pos of error_positions) {
        print(pos);
    }
    
    // Extract error messages
    for (let pos of error_positions) {
        let end_pos = log_file.indexOf("\n", pos);
        if (end_pos != -1) {
            print(log_file.substring(pos, end_pos));
        }
    }
}

// Example 3: Searching for a specific function definition
function find_function_definition() {
    let code = "
function processUserData(user) {
    if (user && user.id) {
        validateUser(user);
        saveToDatabase(user);
        return true;
    }
    return false;
}
";
    
    let function_name = "validateUser";
    let occurrences = boyer_moore_search(code, function_name);
    
    if (occurrences.length > 0) {
        print(`Found '${function_name}' at position: ${occurrences[0]}`);
    } else {
        print(`Function '${function_name}' not found`);
    }
}

// Run all examples
print("=== Boyer-Moore Tutorial Examples ===");
print("\n1. Source Code Text Search:");
find_in_source_code();

print("\n2. Log File Error Pattern Scanning:");
scan_log_errors();

print("\n3. Finding Function Definition:");
find_function_definition();
