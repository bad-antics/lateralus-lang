// ===================================================================
// Lateralus Tutorial Demo — stdlib.semver
// Runnable test vectors and validation script
// ===================================================================

import semver

pub fn run_demo() -> bool {
    // Test parsing
    let v_str = "v1.2.3-rc.1+sha.91a"
    let parsed = semver::parse(v_str)

    if semver::major(parsed) != 1 { return false }
    if semver::minor(parsed) != 2 { return false }
    if semver::patch(parsed) != 3 { return false }
    if semver::prerelease(parsed) != "rc.1" { return false }
    if semver::build_meta(parsed) != "sha.91a" { return false }

    // Test stability checks
    if semver::is_stable(parsed) { return false }
    if !semver::is_prerelease(parsed) { return false }

    // Test comparison vectors
    let v_stable = semver::parse("1.2.3")
    let v_older = semver::parse("1.2.2")

    if !semver::gt(v_stable, v_older) { return false }
    if !semver::lt(v_older, v_stable) { return false }
    if !semver::eq(semver::parse("1.2.3+build.1"), v_stable) { return false }

    // Test bumping
    let bumped = semver::bump_minor(v_older)
    if semver::to_string(bumped) != "1.3.0" { return false }

    // Test ranges
    let target = semver::parse("1.4.5")
    if !semver::satisfies_caret(target, 1, 2) { return false }
    if !semver::satisfies_tilde(target, 1, 4) { return false }

    return true
}

pub fn main() -> int {
    let success = run_demo()
    if success {
        print("semver tutorial demo passed successfully.")
        return 0
    } else {
        print("semver tutorial demo failed!")
        return 1
    }
}
