// ===================================================================
// tests/stdlib_kadane_tutorial.ltl
// -------------------------------------------------------------------
// Verification suite for Kadane's Maximum Subarray and 2D Submatrix
// algorithm, dynamic programming state recurrence, and index tracking.
// ===================================================================

pub fn kadane_1d(nums) {
    let n = len(nums)
    if n == 0 {
        let res = dict()
        res["max_sum"] = 0
        res["start"] = -1
        res["end"] = -1
        return res
    }

    let max_so_far = nums[0]
    let current_max = nums[0]
    let start_idx = 0
    let end_idx = 0
    let temp_start = 0

    let i = 1
    while i < n {
        let x = nums[i]
        if x > current_max + x {
            current_max = x
            temp_start = i
        } else {
            current_max = current_max + x
        }

        if current_max > max_so_far {
            max_so_far = current_max
            start_idx = temp_start
            end_idx = i
        }
        i = i + 1
    }

    let res = dict()
    res["max_sum"] = max_so_far
    res["start"] = start_idx
    res["end"] = end_idx
    return res
}

pub fn kadane_2d(matrix, rows, cols) {
    if rows == 0 or cols == 0 {
        let res = dict()
        res["max_sum"] = 0
        res["r1"] = -1
        res["r2"] = -1
        res["c1"] = -1
        res["c2"] = -1
        return res
    }

    let global_max = matrix[0][0]
    let best_r1 = 0
    let best_r2 = 0
    let best_c1 = 0
    let best_c2 = 0

    let r1 = 0
    while r1 < rows {
        let col_sums = []
        let c = 0
        while c < cols {
            col_sums = push(col_sums, 0)
            c = c + 1
        }

        let r2 = r1
        while r2 < rows {
            let col_idx = 0
            while col_idx < cols {
                col_sums[col_idx] = col_sums[col_idx] + matrix[r2][col_idx]
                col_idx = col_idx + 1
            }

            let sub_res = kadane_1d(col_sums)
            if sub_res["max_sum"] > global_max {
                global_max = sub_res["max_sum"]
                best_r1 = r1
                best_r2 = r2
                best_c1 = sub_res["start"]
                best_c2 = sub_res["end"]
            }
            r2 = r2 + 1
        }
        r1 = r1 + 1
    }

    let res = dict()
    res["max_sum"] = global_max
    res["r1"] = best_r1
    res["r2"] = best_r2
    res["c1"] = best_c1
    res["c2"] = best_c2
    return res
}

pub fn test_kadane_classic_mixed() -> bool {
    let nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]
    let res = kadane_1d(nums)

    if res["max_sum"] != 6 {
        return false
    }
    if res["start"] != 3 or res["end"] != 6 {
        return false
    }

    return true
}

pub fn test_kadane_all_negative() -> bool {
    let nums = [-8, -3, -6, -2, -5, -4]
    let res = kadane_1d(nums)

    if res["max_sum"] != -2 {
        return false
    }
    if res["start"] != 3 or res["end"] != 3 {
        return false
    }

    return true
}

pub fn test_kadane_all_positive() -> bool {
    let nums = [1, 2, 3, 4, 5]
    let res = kadane_1d(nums)

    if res["max_sum"] != 15 {
        return false
    }
    if res["start"] != 0 or res["end"] != 4 {
        return false
    }

    return true
}

pub fn test_kadane_single_element() -> bool {
    let n1 = [42]
    let r1 = kadane_1d(n1)
    if r1["max_sum"] != 42 or r1["start"] != 0 or r1["end"] != 0 {
        return false
    }

    let n2 = [-7]
    let r2 = kadane_1d(n2)
    if r2["max_sum"] != -7 or r2["start"] != 0 or r2["end"] != 0 {
        return false
    }

    return true
}

pub fn test_kadane_2d_submatrix() -> bool {
    let matrix = [
        [1, 2, -1],
        [-3, 4, 5],
        [-2, -1, 2]
    ]

    let res = kadane_2d(matrix, 3, 3)
    if res["max_sum"] != 11 {
        return false
    }
    if res["r1"] != 0 or res["r2"] != 2 or res["c1"] != 1 or res["c2"] != 2 {
        return false
    }

    return true
}
