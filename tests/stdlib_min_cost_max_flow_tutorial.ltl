// ===================================================================
// tests/stdlib_min_cost_max_flow_tutorial.ltl
// -------------------------------------------------------------------
// Complete test suite for Min-Cost Max-Flow (MCMF) in Lateralus.
// Features Successive Shortest Path (SSP), SPFA residual edge relaxation,
// and Klein's negative cycle conservation.
// Busacker and Gowen (1961), Edmonds and Karp (1972).
// ===================================================================

pub fn mcmf_create(n: int) -> dict {
    let mut net = {}
    net["n"] = n

    let mut head = []
    let mut i = 0
    while i <= n {
        head.push([])
        i = i + 1
    }

    net["head"] = head
    net["edge_to"] = []
    net["edge_cap"] = []
    net["edge_cost"] = []
    return net
}

pub fn mcmf_add_edge(net: dict, u: int, v: int, cap: int, cost: int) {
    let mut head = net["head"]
    let mut edge_to = net["edge_to"]
    let mut edge_cap = net["edge_cap"]
    let mut edge_cost = net["edge_cost"]

    let forward_id = edge_to.len()
    let reverse_id = forward_id + 1

    // Forward edge
    edge_to.push(v)
    edge_cap.push(cap)
    edge_cost.push(cost)

    let mut u_edges = head[u]
    u_edges.push(forward_id)
    head[u] = u_edges

    // Reverse edge (residual capacity 0, negative cost)
    edge_to.push(u)
    edge_cap.push(0)
    edge_cost.push(0 - cost)

    let mut v_edges = head[v]
    v_edges.push(reverse_id)
    head[v] = v_edges
}

pub fn mcmf_solve(net: dict, s: int, t: int) -> dict {
    let n = net["n"]
    let head = net["head"]
    let edge_to = net["edge_to"]
    let mut edge_cap = net["edge_cap"]
    let edge_cost = net["edge_cost"]

    let inf_cost = 1000000000
    let mut total_flow = 0
    let mut total_cost = 0

    let mut has_path = true
    while has_path {
        // SPFA to find minimum cost augmenting path
        let mut dist = []
        let mut parent_edge = []
        let mut in_queue = []

        let mut i = 0
        while i <= n {
            dist.push(inf_cost)
            parent_edge.push(-1)
            in_queue.push(false)
            i = i + 1
        }

        dist[s] = 0
        let mut queue = [s]
        in_queue[s] = true
        let mut q_head = 0

        while q_head < queue.len() {
            let u = queue[q_head]
            q_head = q_head + 1
            in_queue[u] = false

            let u_edges = head[u]
            let n_edges = u_edges.len()
            let mut j = 0
            while j < n_edges {
                let e = u_edges[j]
                let v = edge_to[e]
                let cap = edge_cap[e]
                let c = edge_cost[e]

                if cap > 0 and dist[u] + c < dist[v] {
                    dist[v] = dist[u] + c
                    parent_edge[v] = e
                    if not in_queue[v] {
                        queue.push(v)
                        in_queue[v] = true
                    }
                }
                j = j + 1
            }
        }

        if dist[t] >= inf_cost {
            has_path = false
        } else {
            // Find bottleneck capacity along shortest path
            let mut bottleneck = 1000000000
            let mut curr = t
            while curr != s {
                let e = parent_edge[curr]
                let cap = edge_cap[e]
                if cap < bottleneck {
                    bottleneck = cap
                }
                // Previous node is the source of edge e
                // Reverse edge is e ^ 1 (or e - 1 if odd, e + 1 if even)
                let rev_e = 0
                if e % 2 == 0 {
                    curr = edge_to[e + 1]
                } else {
                    curr = edge_to[e - 1]
                }
            }

            // Augment along path
            curr = t
            while curr != s {
                let e = parent_edge[curr]
                let rev_e = 0
                let next_node = 0
                if e % 2 == 0 {
                    next_node = edge_to[e + 1]
                    edge_cap[e] = edge_cap[e] - bottleneck
                    edge_cap[e + 1] = edge_cap[e + 1] + bottleneck
                } else {
                    next_node = edge_to[e - 1]
                    edge_cap[e] = edge_cap[e] - bottleneck
                    edge_cap[e - 1] = edge_cap[e - 1] + bottleneck
                }
                curr = next_node
            }

            total_flow = total_flow + bottleneck
            total_cost = total_cost + bottleneck * dist[t]
        }
    }

    let mut res = {}
    res["flow"] = total_flow
    res["cost"] = total_cost
    return res
}

// -------------------------------------------------------------------
// Smoke tests and Golden Test Vectors
// -------------------------------------------------------------------

pub fn test_mcmf_classic_diamond() -> bool {
    // 4-node flow network:
    // 1 -> 2 (cap 3, cost 1)
    // 1 -> 3 (cap 2, cost 2)
    // 2 -> 3 (cap 1, cost 1)
    // 2 -> 4 (cap 2, cost 3)
    // 3 -> 4 (cap 3, cost 1)
    let net = mcmf_create(4)
    mcmf_add_edge(net, 1, 2, 3, 1)
    mcmf_add_edge(net, 1, 3, 2, 2)
    mcmf_add_edge(net, 2, 3, 1, 1)
    mcmf_add_edge(net, 2, 4, 2, 3)
    mcmf_add_edge(net, 3, 4, 3, 1)

    let res = mcmf_solve(net, 1, 4)

    // Expected Max Flow: 5, Min Cost: 17
    if res["flow"] != 5 or res["cost"] != 17 {
        return false
    }
    return true
}

pub fn test_mcmf_assignment_problem() -> bool {
    // 2 workers, 2 tasks:
    // Source: 1, Sink: 6
    // Workers: 2, 3; Tasks: 4, 5
    let net = mcmf_create(6)

    // Source to workers
    mcmf_add_edge(net, 1, 2, 1, 0)
    mcmf_add_edge(net, 1, 3, 1, 0)

    // Worker 1 costs: Task 1 costs 10, Task 2 costs 15
    mcmf_add_edge(net, 2, 4, 1, 10)
    mcmf_add_edge(net, 2, 5, 1, 15)

    // Worker 2 costs: Task 1 costs 12, Task 2 costs 8
    mcmf_add_edge(net, 3, 4, 1, 12)
    mcmf_add_edge(net, 3, 5, 1, 8)

    // Tasks to sink
    mcmf_add_edge(net, 4, 6, 1, 0)
    mcmf_add_edge(net, 5, 6, 1, 0)

    let res = mcmf_solve(net, 1, 6)

    // Optimal matching: Worker 1 -> Task 1 (10), Worker 2 -> Task 2 (8)
    // Total Flow: 2, Total Min Cost: 18
    if res["flow"] != 2 or res["cost"] != 18 {
        return false
    }
    return true
}

pub fn test_mcmf_zero_flow() -> bool {
    // Disconnected source and sink
    let net = mcmf_create(3)
    mcmf_add_edge(net, 1, 2, 10, 5)

    let res = mcmf_solve(net, 1, 3)
    if res["flow"] != 0 or res["cost"] != 0 {
        return false
    }
    return true
}
