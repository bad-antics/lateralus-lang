// Lateralus Standard Library Example: Huffman Lossless Compression Pipeline
// Demonstrates variable-length entropy encoding and streaming decoding without dictionary ambiguity.

fn encode_msg(text: string, codes: dict) -> string {
    let mut out = "";
    let mut i = 0;
    while i < len(text) {
        let ch = slice(text, i, i + 1);
        if contains(codes, ch) {
            out = out + codes[ch];
        }
        i = i + 1;
    }
    return out;
}

fn decode_msg(bits: string, rev_map: dict) -> string {
    let mut out = "";
    let mut buf = "";
    let mut i = 0;
    while i < len(bits) {
        buf = buf + slice(bits, i, i + 1);
        if contains(rev_map, buf) {
            out = out + rev_map[buf];
            buf = "";
        }
        i = i + 1;
    }
    return out;
}

fn main() -> int {
    println("=== Lateralus Huffman Entropy Compression Pipeline Demo ===");

    let raw = "ABRACADABRA";
    println("Original Raw Payload: \"" + raw + "\" (" + str(len(raw)) + " characters)");

    let mut code_book = {};
    code_book["A"] = "0";
    code_book["B"] = "100";
    code_book["R"] = "101";
    code_book["C"] = "110";
    code_book["D"] = "111";

    let mut dec_book = {};
    dec_book["0"] = "A";
    dec_book["100"] = "B";
    dec_book["101"] = "R";
    dec_book["110"] = "C";
    dec_book["111"] = "D";

    // 1. Encode
    let bitstream = encode_msg(raw, code_book);
    println("Compressed Bitstream: " + bitstream);
    println("  -> Original Size (8-bit ASCII): " + str(len(raw) * 8) + " bits");
    println("  -> Huffman Size: " + str(len(bitstream)) + " bits");
    println("  -> Bandwidth Reduction: 73.8%!");

    assert(bitstream == "01001010110011101001010");

    // 2. Decode
    let recovered = decode_msg(bitstream, dec_book);
    println("Decompressed Payload: \"" + recovered + "\"");
    assert(recovered == raw);

    println("\nHuffman lossless compression & decompression verified 100% faithful!");
    return 0;
}
