// Advent of Code 2024 · Day 19 · Linen Layout
// Towel patterns are reusable; each design must be built by exact matching.
// Part 1: how many designs are possible. Part 2: total number of arrangements.
// Part 1 sample answer (6) is stated on https://adventofcode.com/2024/day/19;
// part 2 counts arrangements for the same sample via exhaustive DP.

let SAMPLE = "r, wr, b, g, bwu, rb, gb, br

brwrr
bggr
gbbr
rrbgbr
ubwu
bwurrg
brgr
bbrgwb"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn parse(text: str) -> list {
    let lines = lines_of(text)
    let pats = []
    for p in str_split(lines[0], ",") {
        let t = str_trim(p)
        if len(t) > 0 { pats = pats + [t] }
    }
    let designs = []
    let i = 1
    while i < len(lines) { designs = designs + [lines[i]]; i = i + 1 }
    return [pats, designs]
}

fn starts_with_at(s: str, p: str, i: int) -> bool {
    if i + len(p) > len(s) { return false }
    return slice(s, i, i + len(p)) == p
}

// Number of ways to tile `design` with the available patterns (DP over index).
fn ways(pats: list, design: str) -> int {
    let n = len(design)
    let dp = [0]
    let k = 1
    while k <= n { dp = dp + [0]; k = k + 1 }
    dp[0] = 1
    let i = 0
    while i < n {
        if dp[i] > 0 {
            for p in pats {
                if starts_with_at(design, p, i) {
                    let j = i + len(p)
                    dp[j] = dp[j] + dp[i]
                }
            }
        }
        i = i + 1
    }
    return dp[n]
}

fn part1(text: str) -> int {
    let parsed = parse(text)
    let pats = parsed[0]
    let total = 0
    for d in parsed[1] {
        if ways(pats, d) > 0 { total = total + 1 }
    }
    return total
}

fn part2(text: str) -> int {
    let parsed = parse(text)
    let pats = parsed[0]
    let total = 0
    for d in parsed[1] { total = total + ways(pats, d) }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 6)
}

@test
fn test_part2() {
    // exhaustive count for the sample designs: 16 arrangements in total
    assert_eq(part2(SAMPLE), 16)
}

fn main() {
    print("Day 19 Part 1 (sample): " + str(part1(SAMPLE)))
    print("Day 19 Part 2 (sample): " + str(part2(SAMPLE)))
}

main()
