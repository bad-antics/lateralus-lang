// Standard Library MergeSort Tutorial Verification Suite
// Validates O(N log N) divide-and-conquer sorting, linear merge, stability preservation, and edge cases.

fn merge(left: list, right: list) -> list {
    let mut res = [];
    let mut i = 0;
    let mut j = 0;
    let n_left = len(left);
    let n_right = len(right);

    while i < n_left && j < n_right {
        if left[i] <= right[j] {
            res = res + [left[i]];
            i = i + 1;
        } else {
            res = res + [right[j]];
            j = j + 1;
        }
    }

    while i < n_left {
        res = res + [left[i]];
        i = i + 1;
    }

    while j < n_right {
        res = res + [right[j]];
        j = j + 1;
    }

    return res;
}

fn mergesort(arr: list) -> list {
    let n = len(arr);
    if n <= 1 {
        return arr;
    }

    let mid = n / 2;
    let left = slice(arr, 0, mid);
    let right = slice(arr, mid, n);

    let sorted_left = mergesort(left);
    let sorted_right = mergesort(right);

    return merge(sorted_left, sorted_right);
}

fn merge_pairs(left: list, right: list) -> list {
    let mut res = [];
    let mut i = 0;
    let mut j = 0;
    let n_left = len(left);
    let n_right = len(right);

    while i < n_left && j < n_right {
        // Critical stability invariant: '<=' ensures left elements precede right elements on equal keys
        if left[i][0] <= right[j][0] {
            res = res + [left[i]];
            i = i + 1;
        } else {
            res = res + [right[j]];
            j = j + 1;
        }
    }

    while i < n_left {
        res = res + [left[i]];
        i = i + 1;
    }

    while j < n_right {
        res = res + [right[j]];
        j = j + 1;
    }

    return res;
}

fn mergesort_pairs(arr: list) -> list {
    let n = len(arr);
    if n <= 1 {
        return arr;
    }

    let mid = n / 2;
    let left = slice(arr, 0, mid);
    let right = slice(arr, mid, n);

    let sorted_left = mergesort_pairs(left);
    let sorted_right = mergesort_pairs(right);

    return merge_pairs(sorted_left, sorted_right);
}

fn main() -> int {
    // 1. Classical Unsorted Array
    let raw = [38, 27, 43, 3, 9, 82, 10];
    let sorted_raw = mergesort(raw);
    assert(len(sorted_raw) == 7);
    assert(sorted_raw[0] == 3);
    assert(sorted_raw[1] == 9);
    assert(sorted_raw[2] == 10);
    assert(sorted_raw[3] == 27);
    assert(sorted_raw[4] == 38);
    assert(sorted_raw[5] == 43);
    assert(sorted_raw[6] == 82);

    // 2. Reverse Sorted Array
    let reverse = [50, 40, 30, 20, 10];
    let sorted_rev = mergesort(reverse);
    assert(sorted_rev[0] == 10);
    assert(sorted_rev[4] == 50);

    // 3. Already Sorted Array (Idempotency)
    let already = [1, 2, 3, 4, 5];
    let sorted_already = mergesort(already);
    assert(sorted_already[0] == 1);
    assert(sorted_already[4] == 5);

    // 4. Stability Verification: Equal keys preserve relative input arrival order
    let items = [
        [5, "First_5"],
        [2, "Only_2"],
        [5, "Second_5"],
        [1, "Only_1"],
        [5, "Third_5"]
    ];

    let stable_sorted = mergesort_pairs(items);
    assert(len(stable_sorted) == 5);

    // Keys must be in order: 1, 2, 5, 5, 5
    assert(stable_sorted[0][0] == 1);
    assert(stable_sorted[1][0] == 2);
    assert(stable_sorted[2][0] == 5);
    assert(stable_sorted[3][0] == 5);
    assert(stable_sorted[4][0] == 5);

    // Stability Invariant: Tags for key 5 must appear as First, Second, Third
    assert(stable_sorted[2][1] == "First_5");
    assert(stable_sorted[3][1] == "Second_5");
    assert(stable_sorted[4][1] == "Third_5"); // Proof of stable sorting!

    // 5. Edge cases: empty and single-element
    let empty = [];
    assert(len(mergesort(empty)) == 0);

    let single = [42];
    let sorted_single = mergesort(single);
    assert(len(sorted_single) == 1);
    assert(sorted_single[0] == 42);

    return 0;
}