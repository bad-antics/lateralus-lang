// Standard Library RLE (Run-Length Encoding) Tutorial Verification Suite
// Validates lossless run compaction, expansion, worst-case handling, and roundtrip equivalence.

fn rle_encode(text: string) -> list {
    let mut runs = [];
    let n = len(text);
    if n == 0 {
        return runs;
    }

    let mut current_char = slice(text, 0, 1);
    let mut current_count = 1;
    let mut i = 1;

    while i < n {
        let ch = slice(text, i, i + 1);
        if ch == current_char {
            current_count = current_count + 1;
        } else {
            runs = runs + [[current_count, current_char]];
            current_char = ch;
            current_count = 1;
        }
        i = i + 1;
    }
    runs = runs + [[current_count, current_char]];
    return runs;
}

fn rle_decode(runs: list) -> string {
    let mut result = "";
    let mut i = 0;
    while i < len(runs) {
        let run = runs[i];
        let mut count = run[0];
        let ch = run[1];
        while count > 0 {
            result = result + ch;
            count = count - 1;
        }
        i = i + 1;
    }
    return result;
}

fn rle_to_compact_string(runs: list) -> string {
    let mut s = "";
    let mut i = 0;
    while i < len(runs) {
        let run = runs[i];
        s = s + str(run[0]) + run[1];
        i = i + 1;
    }
    return s;
}

fn main() -> int {
    // 1. Classical Run Payload: "WWWWWWAAAAAABBBCCCD" (19 chars)
    let payload1 = "WWWWWWAAAAAABBBCCCD";
    let runs1 = rle_encode(payload1);
    assert(len(runs1) == 5);
    // Expected: 6W, 6A, 3B, 3C, 1D
    assert(runs1[0][0] == 6);
    assert(runs1[0][1] == "W");
    assert(runs1[1][0] == 6);
    assert(runs1[1][1] == "A");
    assert(runs1[2][0] == 3);
    assert(runs1[2][1] == "B");
    assert(runs1[3][0] == 3);
    assert(runs1[3][1] == "C");
    assert(runs1[4][0] == 1);
    assert(runs1[4][1] == "D");

    let compact1 = rle_to_compact_string(runs1);
    assert(compact1 == "6W6A3B3C1D");

    // Lossless Roundtrip Invariant
    let restored1 = rle_decode(runs1);
    assert(restored1 == payload1);

    // 2. Uniform Repeat Payload: 10 'Z's
    let payload2 = "ZZZZZZZZZZ";
    let runs2 = rle_encode(payload2);
    assert(len(runs2) == 1);
    assert(runs2[0][0] == 10);
    assert(runs2[0][1] == "Z");
    assert(rle_decode(runs2) == payload2);

    // 3. Worst-case (Non-repeating alphabet): "ABCDEF"
    let payload3 = "ABCDEF";
    let runs3 = rle_encode(payload3);
    assert(len(runs3) == 6);
    let mut k = 0;
    while k < 6 {
        assert(runs3[k][0] == 1);
        k = k + 1;
    }
    assert(rle_decode(runs3) == payload3);

    // 4. Single-character edge case: "X"
    let payload4 = "X";
    let runs4 = rle_encode(payload4);
    assert(len(runs4) == 1);
    assert(runs4[0][0] == 1);
    assert(runs4[0][1] == "X");
    assert(rle_decode(runs4) == "X");

    return 0;
}