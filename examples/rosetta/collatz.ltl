// Rosetta Code: Collatz sequence — length for n = 27 is 112 steps
fn collatz_steps(n: int) -> int {
    let mut x = n
    let mut steps = 0
    while x != 1 {
        if x % 2 == 0 { x = x / 2 } else { x = 3 * x + 1 }
        steps = steps + 1
    }
    return steps
}
println("steps(27) = " + str(collatz_steps(27)))
if collatz_steps(27) == 111 { println("OK") } else { println("FAIL: " + str(collatz_steps(27))) }
