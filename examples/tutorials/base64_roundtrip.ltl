// Runnable example for docs/blog/stdlib-base64-tutorial.ltlml
// Claim: [bounty] stdlib.base64 tutorial (issue #133)
// ===================================================================

from base64 import encode, decode, encode_url, is_valid

fn main() -> void {
    // Standard encoding: 3 bytes -> 4 sextets, '=' padded
    let token = encode("session:user:42")
    println("Token: ", token)

    // URL-safe alphabet: '+' -> '-', '/' -> '_'
    let safe = encode_url("a+b/c?")
    println("URL safe: ", safe)

    // Round trip back to the original string
    let original = decode(token)
    println("Round trip: ", original)

    // Shape + alphabet validation before attempting decode
    println("valid: ", is_valid(token))
    println("valid: ", is_valid("not-b64"))
}
