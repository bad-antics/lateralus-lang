// Demonstrate stdlib.set's canonical representation: sorted, unique lists.

// The CLI compiler currently treats imports as stdlib shims. Keep this
// example self-contained so `lateralus run examples/stdlib_set.ltl` works.
fn set_from_list(items: list) -> list {
    let result = []
    for item in items {
        if !contains(result, item) { result = result + [item] }
    }
    return sort(result)
}

fn set_add(s: list, item) -> list {
    if contains(s, item) { return s }
    return sort(s + [item])
}

fn set_intersection(a: list, b: list) -> list {
    return set_from_list(a |> filter(fn(x) { contains(b, x) }))
}

fn set_remove(s: list, item) -> list {
    return set_from_list(s |> filter(fn(x) { x != item }))
}

fn set_equals(a: list, b: list) -> bool {
    return set_from_list(a) == set_from_list(b)
}

let languages = set_from_list(["Lateralus", "Python", "Lateralus", "C"])
let compiled = set_add(languages, "Wasm")
let shared = set_intersection(compiled, ["C", "Wasm", "C"])
let without_c = set_remove(compiled, "C")

println(languages)
println(compiled)
println(shared)
println(without_c)
println(set_equals([3, 1, 3, 2], [1, 2, 3]))
