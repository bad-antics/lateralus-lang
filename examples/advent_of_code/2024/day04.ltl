// =======================================================================
// ADVENT OF CODE 2024 — Day 4: Ceres Search
// =======================================================================

import testing

const SAMPLE_INPUT = [
    "MMMSXXMASM",
    "MSAMXMSMSA",
    "AMXSXMAAMM",
    "MSAMASMSMX",
    "XMASAMXAMM",
    "XXAMMXXAMA",
    "SMSMSASXSS",
    "SAXAMASAAA",
    "MAMMMXMMMM",
    "MXMXAXMASX"
]

fn count_xmas(grid: list) -> int {
    let rows = len(grid)
    let cols = len(grid[0])
    let count = 0
    let dr = [0, 1, 1, 1, 0, -1, -1, -1]
    let dc = [1, 1, 0, -1, -1, -1, 0, 1]

    for r in range(rows) {
        for c in range(cols) {
            for i in range(8) {
                let found = true
                let word = "XMAS"
                for k in range(4) {
                    let nr = r + k * dr[i]
                    let nc = c + k * dc[i]
                    if nr < 0 or nr >= rows or nc < 0 or nc >= cols {
                        found = false
                        break
                    }
                    // Simple grid character check
                    let char_code = grid[nr][nc]
                    if char_code != word[k] {
                        found = false
                        break
                    }
                }
                if found {
                    count = count + 1
                }
            }
        }
    }
    return count
}

@test
day04_test() {
    assert_eq(count_xmas(SAMPLE_INPUT), 18, "Sample day 4 count")
}
