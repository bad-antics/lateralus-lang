// Pinned SimHash behavior vectors.

fn check(name: str, condition: bool) {
    if condition == false { panic("simhash vector failed: " + name) }
}

fn main() {
    let empty = simhash_fingerprint("")
    check("empty fingerprint has 64 set bits", simhash_hamming(empty, 0) == 64)

    let a = simhash_fingerprint("The quick brown fox")
    let same = simhash_fingerprint("the QUICK brown fox")
    check("identical after normalization", a == same)
    check("hamming identical is zero", simhash_hamming(a, same) == 0)

    let mutation = simhash_fingerprint("The quick brown cat")
    check("single word mutation is nearby", simhash_hamming(a, mutation) <= 16)
    check("near duplicate threshold", simhash_near_duplicate(
        "The quick brown fox", "The quick brown cat", 16))

    let docs = ["alpha beta", "alpha beta", "gamma delta"]
    let batch = simhash_fingerprint_all(docs)
    check("batch length", len(batch) == 3)
    check("batch preserves identical fingerprints", batch[0] == batch[1])
}

main()
