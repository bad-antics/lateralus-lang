// ===================================================================
// examples/prometheus_tutorial.ltl — stdlib/prometheus.ltl companion
// Runnable tour of the Prometheus text exposition format: label
// escaping/formatting, HELP/TYPE/sample emitters, histogram blocks,
// and the exposition parser. Self-contained.
// NOTE: char_at/index_of/split replaced by s[i], local index_of, str_split.
// ===================================================================

fn cat(s: str, i: int) -> str { return s[i] }

fn index_of(s: str, needle: str) -> int {
    let n = len(needle)
    let i = 0
    while i + n <= len(s) {
        if slice(s, i, i + n) == needle {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

fn escape_label_value(v: str) -> str {
    let out = ""
    let i = 0
    while i < len(v) {
        let c = cat(v, i)
        if c == "\\"      { out = out + "\\\\" }
        else if c == "\"" { out = out + "\\\"" }
        else if c == "\n" { out = out + "\\n" }
        else              { out = out + c }
        i = i + 1
    }
    return out
}

fn format_labels(labels: list) -> str {
    if len(labels) == 0 { return "" }
    let out = chr(123)
    let i = 0
    while i < len(labels) {
        if i > 0 { out = out + "," }
        let l = labels[i]
        out = out + l[0] + "=\"" + escape_label_value(l[1]) + "\""
        i = i + 1
    }
    return out + "}"
}

fn help_line(metric: str, description: str) -> str {
    return "# HELP " + metric + " " + description + "\n"
}

fn type_line(metric: str, kind: str) -> str {
    return "# TYPE " + metric + " " + kind + "\n"
}

fn sample_line(metric: str, labels: list, value: str) -> str {
    return metric + format_labels(labels) + " " + value + "\n"
}

fn metric_block(name: str, description: str, kind: str, samples: list) -> str {
    let out = help_line(name, description) + type_line(name, kind)
    let i = 0
    while i < len(samples) {
        let s = samples[i]
        out = out + sample_line(name, s[0], s[1])
        i = i + 1
    }
    return out
}

fn histogram_block(name: str, description: str, labels: list,
                   buckets: list, sum_v: str, count_v: str) -> str {
    let out = help_line(name, description) + type_line(name, "histogram")
    let i = 0
    while i < len(buckets) {
        let b = buckets[i]
        let ls = labels + [["le", b[0]]]
        out = out + sample_line(name + "_bucket", ls, b[1])
        i = i + 1
    }
    out = out + sample_line(name + "_sum", labels, sum_v)
    out = out + sample_line(name + "_count", labels, count_v)
    return out
}

fn parse_labels(s: str) -> list {
    let out = []
    let n = len(s)
    let i = 0
    while i < n {
        let eq = index_of(slice(s, i, n), "=")
        if eq < 0 { return out }
        let k = slice(s, i, i + eq)
        i = i + eq + 1
        if i >= n or cat(s, i) != "\"" { return out }
        i = i + 1
        let v = ""
        let scanning = true
        while scanning and i < n {
            let c = cat(s, i)
            if c == "\\" and i + 1 < n {
                let nx = cat(s, i + 1)
                if nx == "n"      { v = v + "\n" }
                else if nx == "\"" { v = v + "\"" }
                else if nx == "\\" { v = v + "\\" }
                else               { v = v + nx }
                i = i + 2
            } else if c == "\"" {
                scanning = false
                i = i + 1
            } else {
                v = v + c
                i = i + 1
            }
        }
        out = out + [[k, v]]
        if i < n and cat(s, i) == "," { i = i + 1 }
    }
    return out
}

fn parse_line(line: str) -> map {
    let n = len(line)
    if n == 0 { return nil }
    if cat(line, 0) == "#" { return nil }
    let i = 0
    while i < n and cat(line, i) != chr(123) and cat(line, i) != " " {
        i = i + 1
    }
    let metric = slice(line, 0, i)
    let labels = []
    if i < n and cat(line, i) == chr(123) {
        i = i + 1
        let close = index_of(slice(line, i, n), "}")
        if close < 0 { return nil }
        labels = parse_labels(slice(line, i, i + close))
        i = i + close + 1
    }
    while i < n and cat(line, i) == " " { i = i + 1 }
    let v_end = i
    while v_end < n and cat(line, v_end) != " " { v_end = v_end + 1 }
    let value = slice(line, i, v_end)
    let m = {}
    m["metric"] = metric
    m["labels"] = labels
    m["value"] = value
    return m
}

fn parse_exposition(doc: str) -> list {
    let out = []
    let lines = str_split(doc, "\n")
    let i = 0
    while i < len(lines) {
        let ln = lines[i]
        if len(ln) > 0 and cat(ln, 0) != "#" {
            let m = parse_line(ln)
            if m != nil { out = out + [m] }
        }
        i = i + 1
    }
    return out
}

fn vis(s: str) -> str {
    let out = ""
    let i = 0
    while i < len(s) {
        if s[i] == "\n" { out = out + "\\n" }
        else { out = out + s[i] }
        i = i + 1
    }
    return out
}

fn main() {
    println("=== LATERALUS STDLIB PROMETHEUS TUTORIAL ===")

    println("STEP 1 label escaping:")
    println("  " + format_labels([["path", "/a/b"], ["code", "200"]]))
    println("  " + format_labels([["msg", "say \"hi\"\nnow"]]))
    println("  empty: '" + format_labels([]) + "'")

    println("STEP 2 metric block:")
    let s1 = [[["method", "GET"], ["code", "200"]], "1027"]
    let s2 = [[["method", "POST"], ["code", "500"]], "3"]
    let blk = metric_block("http_requests_total", "Total requests", "counter", [s1, s2])
    println(vis(blk))

    println("STEP 3 histogram block:")
    let hist = histogram_block("request_duration_seconds", "Latency", [],
        [["0.1", "10"], ["0.5", "25"], ["+Inf", "30"]], "12.5", "30")
    println(vis(hist))

    println("STEP 4 parse exposition:")
    let ob = chr(123)
    let cb = chr(125)
    let doc = "# HELP h Total\n# TYPE h counter\nh" + ob + "method=\"GET\"" + cb + " 42\nh" + ob + "method=\"POST\"" + cb + " 7 1395066363000\n"
    let samples = parse_exposition(doc)
    println("  parsed " + str(len(samples)) + " samples")
    for s in samples {
        println("  " + str(s["metric"]) + " labels=" + str(s["labels"]) + " value=" + str(s["value"]))
    }

    println("STEP 5 round-trip check:")
    let rt = parse_line("cpu_seconds" + ob + "core=\"0\",mode=\"idle\"" + cb + " 123.45")
    println("  metric=" + str(rt["metric"]) + " value=" + str(rt["value"]) +
        " labels=" + str(len(rt["labels"])))
    println("PINNED_VECTORS: lbl=path-code-200 esc=quoted-newline blk=HELP-TYPE-2samples hist=buckets-sum-count parsed=2 rt=cpu_seconds-123.45")
}

main()
