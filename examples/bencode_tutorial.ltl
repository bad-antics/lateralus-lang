// ===================================================================
// examples/bencode_tutorial.ltl
// -------------------------------------------------------------------
// Practical Application: BEP-0003 BitTorrent Metadata & Piece-Length
// Canonical Bencode Serializer (stdlib/bencode.ltl)
// ===================================================================

pub fn bencode_int(val) {
    return "i" + str(val) + "e"
}

pub fn bencode_str(s) {
    return str(len(s)) + ":" + s
}

pub fn bencode_list_ints(arr, n) {
    let out = "l"
    let i = 0
    while i < n {
        out = out + bencode_int(arr[i])
        i = i + 1
    }
    return out + "e"
}

pub fn bencode_kv_pair(k, v_encoded) {
    return bencode_str(k) + v_encoded
}

pub fn bencode_torrent_info(name_val, piece_len, total_len) {
    // Keys sorted lexicographically: "length" < "name" < "piece length"
    let p1 = bencode_kv_pair("length", bencode_int(total_len))
    let p2 = bencode_kv_pair("name", bencode_str(name_val))
    let p3 = bencode_kv_pair("piece length", bencode_int(piece_len))
    return "d" + p1 + p2 + p3 + "e"
}

pub fn main() {
    print("=== BEP-0003 Canonical Bencode Metadata Serialization ===")

    let enc_zero = bencode_int(0)
    assert(enc_zero == "i0e", "Zero integer encoding")

    let enc_neg = bencode_int(-42)
    assert(enc_neg == "i-42e", "Negative integer encoding")

    let enc_str = bencode_str("lateralus")
    assert(enc_str == "9:lateralus", "Length-prefixed string encoding")

    let ports = dict()
    ports[0] = 6881
    ports[1] = 6889
    let enc_list = bencode_list_ints(ports, 2)
    assert(enc_list == "li6881ei6889ee", "List of integer ports encoding")

    let info_dict = bencode_torrent_info("ubuntu.iso", 262144, 4194304)
    assert(info_dict == "d6:lengthi4194304e4:name10:ubuntu.iso12:piece lengthi262144ee", "Canonical torrent info dictionary")
    print(info_dict)
    print("All BEP-0003 Bencode canonical serialization vectors verified!")
}
