// Rosetta Code · Damm algorithm · Lateralus
// https://rosettacode.org/wiki/Damm_algorithm
//
// Check-digit scheme built on a totally anti-symmetric quasigroup of
// order 10. It catches every single-digit error and every adjacent
// transposition. A number is valid when folding all its digits through the
// table ends at interim digit 0.

let DAMM = [
    [0, 3, 1, 7, 5, 9, 8, 6, 4, 2],
    [7, 0, 9, 2, 1, 5, 4, 8, 6, 3],
    [4, 2, 0, 6, 8, 7, 1, 3, 5, 9],
    [1, 7, 5, 0, 9, 8, 3, 4, 2, 6],
    [6, 1, 2, 3, 0, 4, 5, 9, 7, 8],
    [3, 6, 7, 4, 2, 0, 9, 5, 8, 1],
    [5, 8, 6, 9, 7, 2, 0, 1, 3, 4],
    [8, 9, 4, 5, 3, 6, 2, 0, 1, 7],
    [9, 4, 3, 8, 6, 1, 7, 2, 0, 5],
    [2, 5, 8, 1, 4, 3, 6, 7, 9, 0]
]

fn damm_interim(digits: str) -> int {
    let interim = 0
    let i = 0
    while i < len(digits) {
        interim = DAMM[interim][int(slice(digits, i, i + 1))]
        i = i + 1
    }
    return interim
}

fn damm_valid(digits: str) -> bool {
    return damm_interim(digits) == 0
}

// The check digit to append is simply the interim digit of the payload.
fn damm_check_digit(digits: str) -> int {
    return damm_interim(digits)
}

fn main() {
    // The four numbers from the Rosetta task.
    let cases = [
        ["5724", true], ["5727", false], ["112946", true], ["112949", false]
    ]
    let i = 0
    while i < len(cases) {
        let n = cases[i][0]
        let ok = damm_valid(n)
        let verdict = "invalid"
        if ok { verdict = "valid" }
        print(pad_left(n, 7) + " is " + verdict)
        assert_eq(ok, cases[i][1])
        i = i + 1
    }

    // Generating check digits reproduces the valid numbers above.
    assert_eq(damm_check_digit("572"), 4)
    assert_eq(damm_check_digit("11294"), 6)

    // Every adjacent transposition of a valid number is detected.
    let base = "112946"
    let k = 0
    while k < len(base) - 1 {
        let a = slice(base, k, k + 1)
        let b = slice(base, k + 1, k + 2)
        if a != b {
            let swapped = slice(base, 0, k) + b + a + slice(base, k + 2, len(base))
            assert_true(!damm_valid(swapped))
        }
        k = k + 1
    }
    print("all adjacent transpositions of " + base + " detected")
}

main()
