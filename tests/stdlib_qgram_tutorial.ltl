// Pinned test vectors for stdlib/qgram.ltl
import qgram

@test
fn test_qgram_overlap_and_jaccard() {
    let grams = qgrams("cat", 2)
    assert(len(grams) == 4)
    assert(grams[1] == "ca")
    assert(grams[2] == "at")
    assert(overlap("night", "nacht", 2) == 3)
    let j = jaccard("night", "nacht", 2)
    assert(j > 0.333 && j < 0.334)
}

@test
fn test_qgram_inverted_index_query() {
    let idx = build_index(["lateralus", "lathe", "banana"], 3)
    let hits = query(idx, "late", 3)
    assert(hits == [[0, 4], [1, 4]])
}
