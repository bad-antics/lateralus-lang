// Rosetta Code · SHA-256 · Lateralus
// https://rosettacode.org/wiki/SHA-256
//
// From-scratch FIPS 180-4 SHA-256: 64-entry message schedule, 64
// compression rounds, eight 32-bit working registers.

let MASK32 = 0xFFFFFFFF
let HEX = "0123456789abcdef"

// First 32 bits of the fractional parts of the cube roots of the first 64 primes.
let K = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

// First 32 bits of the fractional parts of the square roots of the first 8 primes.
let H_INIT = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
]

fn utf8_bytes(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        let cp = ord(slice(s, i, i + 1))
        if cp < 0x80 {
            out = out + [cp]
        } else if cp < 0x800 {
            out = out + [0xC0 | (cp >> 6), 0x80 | (cp & 0x3F)]
        } else if cp < 0x10000 {
            out = out + [0xE0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
        } else {
            out = out + [0xF0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3F),
                         0x80 | ((cp >> 6) & 0x3F), 0x80 | (cp & 0x3F)]
        }
        i = i + 1
    }
    return out
}

fn rotr(x: int, n: int) -> int {
    return ((x >> n) | (x << (32 - n))) & MASK32
}

fn hex_word(w: int) -> str {
    let out = ""
    let shift = 28
    while shift >= 0 {
        let nib = (w >> shift) & 15
        out = out + slice(HEX, nib, nib + 1)
        shift = shift - 4
    }
    return out
}

fn sha256_bytes(msg: list) -> str {
    let bit_len = len(msg) * 8
    let data = msg + [0x80]
    while len(data) % 64 != 56 { data = data + [0] }
    let i = 7
    while i >= 0 {
        data = data + [(bit_len >> (8 * i)) & 0xFF]
        i = i - 1
    }

    let h = list_copy(H_INIT)

    let off = 0
    while off < len(data) {
        let w = []
        let t = 0
        while t < 16 {
            let p = off + 4 * t
            w = w + [(data[p] << 24) | (data[p + 1] << 16) | (data[p + 2] << 8) | data[p + 3]]
            t = t + 1
        }
        while t < 64 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w = w + [(w[t - 16] + s0 + w[t - 7] + s1) & MASK32]
            t = t + 1
        }

        let a = h[0]
        let b = h[1]
        let c = h[2]
        let d = h[3]
        let e = h[4]
        let f = h[5]
        let g = h[6]
        let hh = h[7]
        t = 0
        while t < 64 {
            let big_s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let ch = (e & f) ^ ((~e) & g)
            let temp1 = (hh + big_s1 + ch + K[t] + w[t]) & MASK32
            let big_s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = (big_s0 + maj) & MASK32
            hh = g
            g = f
            f = e
            e = (d + temp1) & MASK32
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & MASK32
            t = t + 1
        }
        let regs = [a, b, c, d, e, f, g, hh]
        let k = 0
        while k < 8 {
            h[k] = (h[k] + regs[k]) & MASK32
            k = k + 1
        }
        off = off + 64
    }

    let out = ""
    let k = 0
    while k < 8 {
        out = out + hex_word(h[k])
        k = k + 1
    }
    return out
}

fn sha256(s: str) -> str {
    return sha256_bytes(utf8_bytes(s))
}

fn main() {
    // The Rosetta task asks for the digest of "Rosetta code"; the rest are
    // FIPS 180 examples, including the empty string and a two-block message.
    let cases = [
        ["Rosetta code", "764faf5c61ac315f1497f9dfa542713965b785e5cc2f707d6468d7d1124cdfcf"],
        ["", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"],
        ["abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"],
        ["abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
         "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"]
    ]
    let i = 0
    while i < len(cases) {
        let got = sha256(cases[i][0])
        print(got + "  \"" + cases[i][0] + "\"")
        assert_eq(got, cases[i][1])
        i = i + 1
    }
}

main()
