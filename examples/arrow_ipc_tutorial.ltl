// examples/arrow_ipc_tutorial.ltl
// Demonstrates Apache Arrow IPC stream framing, columnar layout buffers,
// validity bitmaps, and 8-byte alignment using stdlib/arrow_ipc.ltl.

import stdlib.arrow_ipc

fn main() {
    println("=== Apache Arrow IPC Stream Framing Tutorial ===")

    // 1. Column validity bitmap (null indicator)
    let null_mask = [true, true, false, true, true, false, true, true, true]
    let bitmap = validity_bitmap(null_mask)
    println("Validity bitmap (8-byte padded): " + str(bitmap))

    // 2. Int32 columnar buffer
    let int_col = [100, -250, 42, 99999]
    let int_buf = buffer_i32(int_col)
    println("Int32 buffer byte length: " + str(len(int_buf)))

    // 3. UTF-8 string buffers (offsets + data)
    let names = ["lateralus", "arrow", "ipc"]
    let str_buffers = buffers_utf8(names)
    let offsets = str_buffers[0]
    let str_data = str_buffers[1]
    println("Offsets buffer length: " + str(len(offsets)))
    println("String data buffer length: " + str(len(str_data)))

    // 4. Wrap record batch message (metadata + body)
    let dummy_metadata = [1, 2, 3, 4]
    let message = frame_message(dummy_metadata, int_buf)
    let header = parse_frame_header(message, 0)
    println("Framed message length: " + str(len(message)))
    println("Parsed metadata length: " + str(header["metadata_len"]))

    // 5. End of stream marker
    let eos = end_of_stream()
    let eos_header = parse_frame_header(eos, 0)
    println("EOS byte length: " + str(len(eos)))
    println("EOS metadata length: " + str(eos_header["metadata_len"]))
}

main()
