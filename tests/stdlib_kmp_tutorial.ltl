// Standard Library Knuth-Morris-Pratt (KMP) Tutorial Verification Suite
// Validates LPS partial match table precomputation, linear searching, and golden vectors.

fn compute_lps(pattern: string) -> list {
    let p_len = len(pattern);
    if p_len == 0 {
        return [];
    }
    let mut lps = [0];
    let mut prev_lps = 0;
    let mut i = 1;

    while i < p_len {
        let ch_i = slice(pattern, i, i + 1);
        let ch_prev = slice(pattern, prev_lps, prev_lps + 1);

        if ch_i == ch_prev {
            prev_lps = prev_lps + 1;
            lps.append(prev_lps);
            i = i + 1;
        } else {
            if prev_lps != 0 {
                prev_lps = lps[prev_lps - 1];
            } else {
                lps.append(0);
                i = i + 1;
            }
        }
    }
    return lps;
}

fn kmp_search_first(text: string, pattern: string) -> int {
    let t_len = len(text);
    let p_len = len(pattern);
    if p_len == 0 { return 0; }
    if t_len < p_len { return -1; }

    let lps = compute_lps(pattern);
    let mut i = 0;
    let mut j = 0;

    while i < t_len {
        let ch_t = slice(text, i, i + 1);
        let ch_p = slice(pattern, j, j + 1);

        if ch_t == ch_p {
            i = i + 1;
            j = j + 1;
            if j == p_len {
                return i - j; // Match found at start index!
            }
        } else {
            if j != 0 {
                j = lps[j - 1];
            } else {
                i = i + 1;
            }
        }
    }

    return -1;
}

fn main() -> int {
    // 1. Classical LPS Golden Vectors
    // "ABCDABD" -> [0, 0, 0, 0, 1, 2, 0]
    let lps1 = compute_lps("ABCDABD");
    assert(len(lps1) == 7);
    assert(lps1[0] == 0);
    assert(lps1[1] == 0);
    assert(lps1[2] == 0);
    assert(lps1[3] == 0);
    assert(lps1[4] == 1);
    assert(lps1[5] == 2);
    assert(lps1[6] == 0);

    // "AAAA" -> [0, 1, 2, 3]
    let lps_rep = compute_lps("AAAA");
    assert(lps_rep[0] == 0);
    assert(lps_rep[1] == 1);
    assert(lps_rep[2] == 2);
    assert(lps_rep[3] == 3);

    // 2. Classical Substring Search Benchmarks
    let text1 = "ABC ABCDAB ABCDABCDABDE";
    let pattern1 = "ABCDABD";
    let idx1 = kmp_search_first(text1, pattern1);
    assert(idx1 == 15);

    // 3. Simple & Boundary Searches
    let text2 = "lateralus standard library kmp";
    assert(kmp_search_first(text2, "standard") == 10);
    assert(kmp_search_first(text2, "kmp") == 27);
    assert(kmp_search_first(text2, "notfound") == -1);

    // Empty pattern matches at index 0
    assert(kmp_search_first("hello", "") == 0);

    return 0;
}
