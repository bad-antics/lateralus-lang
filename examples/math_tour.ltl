// ===================================================================
// examples/math_tour.ltl  —  companion to
// docs/blog/math-module-tour.ltlml
//
// Runnable tour of stdlib/math.ltl with pinned test vectors.
// Every expected value below is asserted, so a regression prints FAIL.
//
//   python3 -m lateralus_lang run examples/math_tour.ltl
// ===================================================================

from stdlib.math import sqrt, pow, floor, ceil, clamp, sign, gcd, lcm, factorial, log, exp, sin, cos, tan, PI, E

// Returns 1 on success, 0 on failure — accumulation happens in main(),
// because assigning to a module-level binding from inside a function
// is a Python-backend local-variable error.
fn check(name: str, actual: float, expected: float) -> int {
    if actual == expected {
        print("  ok    " + name + " = " + str(actual))
        return 1
    }
    print("  FAIL  " + name + " = " + str(actual) + "  (expected " + str(expected) + ")")
    return 0
}

fn check_int(name: str, actual: int, expected: int) -> int {
    if actual == expected {
        print("  ok    " + name + " = " + str(actual))
        return 1
    }
    print("  FAIL  " + name + " = " + str(actual) + "  (expected " + str(expected) + ")")
    return 0
}

fn main() {
    let p = 0
    let f = 0

    print("=== stdlib/math.ltl — pinned vectors ===")

    // --- roots and powers -------------------------------------------
    print("-- roots and powers")
    p = p + check("sqrt(2.0)", sqrt(2.0), 1.4142135623730951)
    p = p + check("sqrt(16.0)", sqrt(16.0), 4.0)
    p = p + check("pow(2.0, 10.0)", pow(2.0, 10.0), 1024.0)

    // --- floor / ceil: the sign trap ---------------------------------
    print("-- rounding toward -inf / +inf")
    p = p + check_int("floor(2.5)", floor(2.5), 2)
    p = p + check_int("floor(-2.5)", floor(-2.5), -3)
    p = p + check_int("ceil(2.5)", ceil(2.5), 3)
    p = p + check_int("ceil(-2.5)", ceil(-2.5), -2)

    // --- clamp / sign -------------------------------------------------
    print("-- clamp and sign")
    p = p + check("clamp(9, 0, 5)", clamp(9, 0, 5), 5.0)
    p = p + check("clamp(-1, 0, 5)", clamp(-1, 0, 5), 0.0)
    p = p + check("clamp(3, 0, 5)", clamp(3, 0, 5), 3.0)
    p = p + check_int("sign(-3)", sign(-3), -1)
    p = p + check_int("sign(0)", sign(0), 0)
    p = p + check_int("sign(4)", sign(4), 1)

    // --- integer helpers ---------------------------------------------
    print("-- integer helpers")
    p = p + check_int("gcd(12, 18)", gcd(12, 18), 6)
    p = p + check_int("gcd(0, 5)", gcd(0, 5), 5)
    p = p + check_int("lcm(4, 6)", lcm(4, 6), 12)
    p = p + check_int("factorial(5)", factorial(5), 120)
    p = p + check_int("factorial(0)", factorial(0), 1)

    // --- logs and exp -------------------------------------------------
    // `log` is the NATURAL log: log(8.0) == ln(8) == 2.0794...
    print("-- log is natural log")
    p = p + check("log(8.0)", log(8.0), 2.0794415416798357)
    p = p + check("exp(1.0)", exp(1.0), 2.718281828459045)

    // --- trigonometry -------------------------------------------------
    print("-- trig")
    p = p + check("sin(0.0)", sin(0.0), 0.0)
    p = p + check("cos(0.0)", cos(0.0), 1.0)
    p = p + check("tan(0.0)", tan(0.0), 0.0)

    // --- constants ----------------------------------------------------
    print("-- constants")
    p = p + check("PI", PI, 3.141592653589793)
    p = p + check("E", E, 2.718281828459045)

    // --- unary minus binds to the call result -------------------------
    print("-- unary minus")
    p = p + check("-sqrt(4.0)", -sqrt(4.0), -2.0)

    let total = p + f
    print("")
    print("  " + str(p) + " passed, " + str(f) + " failed  (" + str(total) + " vectors)")
    if f > 0 {
        print("  REGRESSION: pinned vectors changed")
    }
}
