// Rich demo exercising all four spiral_wave functions with distinct output.
fn spiral_zeros(n: int) -> list {
    let m = []
    for i in range(n) {
        let row = []
        for j in range(n) {
            row = row + [0]
        }
        m = m + [row]
    }
    return m
}
fn spiral_build(n: int) -> list {
    let m = spiral_zeros(n)
    let top = 0
    let bottom = n - 1
    let left = 0
    let right = n - 1
    let val = 1
    while top <= bottom && left <= right {
        let c = left
        while c <= right { m[top][c] = val; val = val + 1; c = c + 1 }
        top = top + 1
        let r = top
        while r <= bottom { m[r][right] = val; val = val + 1; r = r + 1 }
        right = right - 1
        if top <= bottom {
            let c2 = right
            while c2 >= left { m[bottom][c2] = val; val = val + 1; c2 = c2 - 1 }
            bottom = bottom - 1
        }
        if left <= right {
            let r2 = bottom
            while r2 >= top { m[r2][left] = val; val = val + 1; r2 = r2 - 1 }
            left = left + 1
        }
    }
    return m
}
fn spiral_print(m: list) {
    let n = len(m)
    let i = 0
    while i < n {
        let line = ""
        let j = 0
        while j < n {
            let cell = m[i][j]
            let pad = ""
            if cell < 10 { pad = "  " } else { pad = " " }
            line = line + pad + str(cell)
            j = j + 1
        }
        println(line)
        i = i + 1
    }
}
fn spiral_checksum(m: list) -> int {
    let n = len(m)
    let total = 0
    let i = 0
    while i < n {
        let j = 0
        while j < n { total = total + m[i][j] * (1 + i + j); j = j + 1 }
        i = i + 1
    }
    return total
}
fn main() {
    // 1) Show the raw zero canvas before filling.
    println("--- spiral_zeros(3) ---")
    spiral_print(spiral_zeros(3))

    // 2) Build and print a 4x4 spiral.
    println("--- spiral_build(4) ---")
    let m4 = spiral_build(4)
    spiral_print(m4)

    // 3) Checksums across sizes act as a regression fingerprint.
    println("--- checksums ---")
    println("N=1: " + str(spiral_checksum(spiral_build(1))))
    println("N=4: " + str(spiral_checksum(m4)))
    println("N=5: " + str(spiral_checksum(spiral_build(5))))
}
main()
