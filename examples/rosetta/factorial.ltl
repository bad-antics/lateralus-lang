// Rosetta Code: Factorial
// https://rosettacode.org/wiki/Factorial
module examples.rosetta.factorial

import io

fn factorial(n: int) -> int {
    if n <= 1 { return 1 }
    let result = 1
    let i = 2
    while i <= n {
        result = result * i
        i = i + 1
    }
    return result
}

@test
fn test_factorial() {
    assert_eq(factorial(0), 1)
    assert_eq(factorial(1), 1)
    assert_eq(factorial(5), 120)
    assert_eq(factorial(10), 3628800)
}

fn main() {
    print("Factorial(10) = " + str(factorial(10)))
}

main()
