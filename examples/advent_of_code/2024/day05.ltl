// Advent of Code 2024 · Day 5 · Print Queue
// Rules "X|Y" mean X must come before Y when both appear.
// Part 1: sum middle pages of valid updates.
// Part 2: sort invalid updates by rules; sum their middle pages.

let SAMPLE = "47|53
97|13
97|61
97|47
75|29
61|13
75|53
29|13
97|29
53|29
61|53
97|53
61|29
47|13
75|47
97|75
47|61
75|61
47|29
75|13
53|13

75,47,61,53,29
97,61,53,29,13
75,29,13
75,97,47,61,53
61,13,29
97,13,75,29,47"

fn parse_input(text: str) -> list {
    let parts = str_split(text, "\n\n")
    let rule_lines = str_split(str_trim(parts[0]), "\n")
    let update_lines = str_split(str_trim(parts[1]), "\n")

    let rules = {}
    let i = 0
    while i < len(rule_lines) {
        let line = str_trim(rule_lines[i])
        if len(line) > 0 {
            let ab = str_split(line, "|")
            let key = str_trim(ab[0]) + "|" + str_trim(ab[1])
            rules[key] = true
        }
        i = i + 1
    }

    let updates = []
    let j = 0
    while j < len(update_lines) {
        let line = str_trim(update_lines[j])
        if len(line) > 0 {
            let pages = str_split(line, ",")
            let nums = []
            let k = 0
            while k < len(pages) {
                nums = nums + [int(str_trim(pages[k]))]
                k = k + 1
            }
            updates = updates + [nums]
        }
        j = j + 1
    }
    return [rules, updates]
}

fn is_valid(update: list, rules: map) -> bool {
    let i = 0
    while i < len(update) {
        let j = i + 1
        while j < len(update) {
            let key = str(update[j]) + "|" + str(update[i])
            if contains(rules, key) { return false }
            j = j + 1
        }
        i = i + 1
    }
    return true
}

fn sort_by_rules(update: list, rules: map) -> list {
    // Bubble sort using rules as comparator
    let arr = update
    let n = len(arr)
    let i = 0
    while i < n {
        let j = 0
        while j < n - 1 {
            let key = str(arr[j + 1]) + "|" + str(arr[j])
            if contains(rules, key) {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return arr
}

fn middle(update: list) -> int {
    return update[int(len(update) / 2)]
}

fn part1(text: str) -> int {
    let parsed = parse_input(text)
    let rules = parsed[0]
    let updates = parsed[1]
    let total = 0
    let i = 0
    while i < len(updates) {
        if is_valid(updates[i], rules) {
            total = total + middle(updates[i])
        }
        i = i + 1
    }
    return total
}

fn part2(text: str) -> int {
    let parsed = parse_input(text)
    let rules = parsed[0]
    let updates = parsed[1]
    let total = 0
    let i = 0
    while i < len(updates) {
        if !is_valid(updates[i], rules) {
            let sorted = sort_by_rules(updates[i], rules)
            total = total + middle(sorted)
        }
        i = i + 1
    }
    return total
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 143)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 123)
}

fn main() {
    print("Day 5 Part 1: " + str(part1(SAMPLE)))
    print("Day 5 Part 2: " + str(part2(SAMPLE)))
}

main()
