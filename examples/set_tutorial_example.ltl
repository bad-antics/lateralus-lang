// ===================================================================
// examples/set_tutorial.ltl -- stdlib set tutorial example
// Companion example for the stdlib.set blog tutorial.
//
// Scenario: two readers' tag collections. Build a set for each,
// then report the shared tags, the tags only the first reader
// follows, and the size of the combined collection.
// ===================================================================

// stdlib pub functions are called with the module prefix:
// set_from_list, set_intersection, set_difference, ...

let alice = set_from_list(["lateralus", "stdlib", "tutorial", "bounty", "tutorial"])
let bob = set_from_list(["lateralus", "playground", "stdlib", "wasm"])

let shared = set_intersection(alice, bob)
let alice_only = set_difference(alice, bob)
let combined = set_union(alice, bob)

println("alice tags: {set_size(alice)}")
println("bob tags: {set_size(bob)}")
println("shared tags: {set_size(shared)}")
for tag in shared {
    println("  {tag}")
}
println("alice-only tags: {set_size(alice_only)}")
for tag in alice_only {
    println("  {tag}")
}
println("combined tags: {set_size(combined)}")

// Expected output:
//   alice tags: 4
//   bob tags: 4
//   shared tags: 2
//     lateralus
//     stdlib
//   alice-only tags: 2
//     bounty
//     tutorial
//   combined tags: 6
//
// Why alice has 4 tags, not 5: her raw list names "tutorial"
// twice, and set_from_list deduplicates before sorting. Sets are
// sorted lists, so every loop above prints in alphabetical order.
