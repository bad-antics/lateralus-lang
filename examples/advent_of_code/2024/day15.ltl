// Advent of Code 2024 · Day 15 · Warehouse Woes
// A robot walks a warehouse pushing boxes. Part 1: smaller box grid.
// Part 2: every cell doubles in width, boxes become two-cell pairs that
// must move together.
// Sample answers from https://adventofcode.com/2024/day/15
// (small map 2028, full map 10092 and 9021).

let SAMPLE_SMALL = "########
#..O.O.#
##@.O..#
#...O..#
#.#.O..#
#...O..#
#......#
########

<^^>>>vv<v>>v<<"

let SAMPLE = "##########
#..O..O.O#
#......O.#
#.OO..O.O#
#..O@..O.#
#O#..O...#
#O..O..O.#
#.OO.O.OO#
#....O...#
##########

<vv>^<v^>v>^vv^v>v<>v^v<v<^vv<<<^><<><>>v<vvv<>^v^>^<<<><<v<<<v^vv^v>^
vvv<<^>^v^^><<>>><>^<<><^vv^^<>vvv<>><^^v>^>vv<>v<<<<v<^v>^<^^>>>^<v<v
><>vv>v^v^<>><>>>><^^>vv>v<^^^>>v^v^<^^>v^^>v^<^v>v<>>v^v^<v>v^^<^^vv<
<<v<^>>^^^^>>>v^<>vvv^><v<<<>^^^vv^<vvv>^>v<^^^^v<>^>vvvv><>>v^<<^^^^^
^><^><>>><>^^<<^^v>>><^<v>^<vv>>v>>>^v><>^v><<<<v>>v<v<v>vvv>^<><<>^><
^>><>^v<><^vvv<^^<><v<<<<<><^v<<<><<<^^<v<^^^><^>>^<v^><<<^>>^v<v^v<v^
>^>>^v>vv>^<<^v<>><<><<v<<v><>v<^vv<<<>^^v^>^^>>><<^v>>v^v><^^>>^<>vv^
<><^^>^^^<><vvvvv^v<v<<>^v<v>v<<^><<><<><<<^^<<<^<<>><<><^^^>^^<>^>v<>
^^>vv<^v^v<vv>^<><v<^v>^^^>>>^^vvv^>vvv<>>>^<^>>>>>^<<^v>^vvv<>^<><<v>
v^^>>><<^^<>>^v^<v^vv<>v^<<>^<^v^v><^<<<><<^<v><v<>vv>>v><v^<vv<>v^<<^"

fn chars(s: str) -> list {
    let out = []
    let i = 0
    while i < len(s) {
        out = out + [slice(s, i, i + 1)]
        i = i + 1
    }
    return out
}

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

// Split the document into grid rows and the move sequence.
fn parse(text: str, widen: bool) -> list {
    let raw = str_split(text, "\n")
    let grid = []
    let moves = ""
    let in_moves = false
    for line in raw {
        let l = str_trim(line)
        if len(l) == 0 {
            in_moves = true
        } else if in_moves {
            moves = moves + l
        } else {
            let row = []
            for ch in chars(l) {
                if widen {
                    if ch == "#" { row = row + ["#", "#"] }
                    if ch == "O" { row = row + ["[", "]"] }
                    if ch == "." { row = row + [".", "."] }
                    if ch == "@" { row = row + ["@", "."] }
                } else {
                    row = row + [ch]
                }
            }
            grid = grid + [row]
        }
    }
    // lift the robot off the grid
    let rr = 0
    let rc = 0
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            if grid[r][c] == "@" { rr = r; rc = c; grid[r][c] = "." }
            c = c + 1
        }
        r = r + 1
    }
    return [grid, moves, rr, rc]
}

fn step_of(m: str) -> list {
    if m == "^" { return [-1, 0] }
    if m == "v" { return [1, 0] }
    if m == "<" { return [0, -1] }
    return [0, 1]
}

fn gps(grid: list, box: str) -> int {
    let total = 0
    let r = 0
    while r < len(grid) {
        let c = 0
        while c < len(grid[r]) {
            if grid[r][c] == box { total = total + 100 * r + c }
            c = c + 1
        }
        r = r + 1
    }
    return total
}

fn part1(text: str) -> int {
    let parsed = parse(text, false)
    let grid = parsed[0]
    let moves = parsed[1]
    let r = parsed[2]
    let c = parsed[3]
    for m in chars(moves) {
        let d = step_of(m)
        let dr = d[0]
        let dc = d[1]
        // walk the run of boxes in front of the robot
        let boxes = []
        let nr = r + dr
        let nc = c + dc
        while grid[nr][nc] == "O" {
            boxes = boxes + [[nr, nc]]
            nr = nr + dr
            nc = nc + dc
        }
        if grid[nr][nc] == "#" { continue }
        // shift the run back to front so nothing is overwritten
        let i = len(boxes) - 1
        while i >= 0 {
            let b = boxes[i]
            grid[b[0] + dr][b[1] + dc] = "O"
            grid[b[0]][b[1]] = "."
            i = i - 1
        }
        r = r + dr
        c = c + dc
    }
    return gps(grid, "O")
}

fn has_cell(cells: list, r: int, c: int) -> bool {
    for p in cells {
        if p[0] == r && p[1] == c { return true }
    }
    return false
}

// Sort cells so the ones furthest along the push direction move first.
fn ordered_cells(cells: list, dr: int) -> list {
    let out = []
    for p in cells { out = out + [p] }
    let i = 0
    while i < len(out) {
        let j = 0
        while j < len(out) - 1 - i {
            let a = out[j]
            let b = out[j + 1]
            let swap = false
            if dr > 0 && a[0] < b[0] { swap = true }
            if dr < 0 && a[0] > b[0] { swap = true }
            if swap {
                out[j] = b
                out[j + 1] = a
            }
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Vertical push where every touched [] pair has to move as one piece.
fn push_up_down(grid: list, r: int, c: int, dr: int) -> list {
    let nr = r + dr
    let cell = grid[nr][c]
    if cell == "#" { return [false, r] }
    if cell == "." { return [true, nr] }
    let pair_c = c + 1
    if cell == "]" { pair_c = c - 1 }
    let touched = [[nr, c]]
    if !has_cell(touched, nr, pair_c) { touched = touched + [[nr, pair_c]] }
    let queue = []
    for p in touched { queue = queue + [p] }
    let blocked = false
    while len(queue) > 0 {
        let next = []
        for p in queue {
            let rr = p[0] + dr
            let cc = p[1]
            let ahead = grid[rr][cc]
            if ahead == "#" { blocked = true }
            if ahead == "[" || ahead == "]" {
                if !has_cell(touched, rr, cc) {
                    touched = touched + [[rr, cc]]
                    next = next + [[rr, cc]]
                }
                let mate = cc + 1
                if ahead == "]" { mate = cc - 1 }
                if !has_cell(touched, rr, mate) {
                    touched = touched + [[rr, mate]]
                    next = next + [[rr, mate]]
                }
            }
        }
        queue = next
    }
    if blocked { return [false, r] }
    for p in ordered_cells(touched, dr) {
        grid[p[0] + dr][p[1]] = grid[p[0]][p[1]]
        grid[p[0]][p[1]] = "."
    }
    return [true, nr]
}

fn part2(text: str) -> int {
    let parsed = parse(text, true)
    let grid = parsed[0]
    let moves = parsed[1]
    let r = parsed[2]
    let c = parsed[3]
    for m in chars(moves) {
        let d = step_of(m)
        let dr = d[0]
        let dc = d[1]
        if dr != 0 {
            let res = push_up_down(grid, r, c, dr)
            r = res[1]
        } else {
            let boxes = []
            let nc = c + dc
            while grid[r][nc] == "[" || grid[r][nc] == "]" {
                boxes = boxes + [nc]
                nc = nc + dc
            }
            if grid[r][nc] == "#" { continue }
            let i = len(boxes) - 1
            while i >= 0 {
                grid[r][boxes[i] + dc] = grid[r][boxes[i]]
                grid[r][boxes[i]] = "."
                i = i - 1
            }
            c = c + dc
        }
    }
    return gps(grid, "[")
}

@test
fn test_small_part1() {
    assert_eq(part1(SAMPLE_SMALL), 2028)
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 10092)
}

@test
fn test_part2() {
    assert_eq(part2(SAMPLE), 9021)
}

fn main() {
    print("Day 15 Part 1 (small sample): " + str(part1(SAMPLE_SMALL)))
    print("Day 15 Part 1 (sample): " + str(part1(SAMPLE)))
    print("Day 15 Part 2 (sample): " + str(part2(SAMPLE)))
}

main()
