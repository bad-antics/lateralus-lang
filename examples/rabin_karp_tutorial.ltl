// Lateralus Standard Library Example: Rabin-Karp Substring Search
// Demonstrates polynomial rolling hash sliding window for high-performance substring and log pattern matching.

fn rabin_karp_search(text: str, pattern: str) -> list {
    let n = len(text);
    let m = len(pattern);
    let mut matches = [];

    if m == 0 || m > n {
        return matches;
    }

    let B = 256;
    let M = 1000000007;

    // Precompute h = B^(m - 1) % M
    let mut h = 1;
    let mut i = 0;
    while i < (m - 1) {
        h = (h * B) % M;
        i = i + 1;
    }

    // Compute initial hash of pattern and first window of text
    let mut p_hash = 0;
    let mut t_hash = 0;
    let mut j = 0;
    while j < m {
        p_hash = (p_hash * B + ord(slice(pattern, j, j + 1))) % M;
        t_hash = (t_hash * B + ord(slice(text, j, j + 1))) % M;
        j = j + 1;
    }

    // Slide window across text
    let mut idx = 0;
    while idx <= (n - m) {
        if p_hash == t_hash {
            if slice(text, idx, idx + m) == pattern {
                matches = matches + [idx];
            }
        }

        if idx < (n - m) {
            let c_out = ord(slice(text, idx, idx + 1));
            let c_in = ord(slice(text, idx + m, idx + m + 1));
            t_hash = (t_hash - (c_out * h) % M) % M;
            if t_hash < 0 {
                t_hash = t_hash + M;
            }
            t_hash = (t_hash * B + c_in) % M;
        }

        idx = idx + 1;
    }

    return matches;
}

fn main() -> int {
    println("=== Rabin-Karp Rolling Hash Substring Search Example ===");

    let log_stream = "[INFO] Connection accepted; [ERROR] Socket timeout; [INFO] Retrying; [ERROR] Connection reset";
    let target = "[ERROR]";

    println("Searching log stream for error events:");
    let match_indices = rabin_karp_search(log_stream, target);

    println("Found error occurrences at character offsets:");
    let mut k = 0;
    while k < len(match_indices) {
        println(match_indices[k]);
        k = k + 1;
    }

    println("Rabin-Karp search completed successfully.");
    return 0;
}
