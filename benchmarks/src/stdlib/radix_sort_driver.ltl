// Driver for the radix_sort_u32 stdlib micro-benchmark.
// The harness inlines stdlib/radix_sort.ltl above this driver.
//
// Workload: LSD radix sort of 100,000 u32 keys (full bounty spec size).

fn gen_key(x: int) -> int { return (x * 2654435761) & 0xffffffff }

fn main() {
    let xs = map(range_ltl(0, 100000), gen_key)
    let s = radix_sort_u32(xs)
    println(len(s))
    println(s[0])
    println(s[99999])
}

main()