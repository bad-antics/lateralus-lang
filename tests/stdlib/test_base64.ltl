import stdlib.base64

fn test_base64() {
    // Empty input
    assert(base64.encode("") == "")
    
    // Padding tests
    assert(base64.encode("f") == "Zg==")
    assert(base64.encode("fo") == "Zm8=")
    assert(base64.encode("foo") == "Zm9v")
    
    // URL-safe alphabet
    let url_enc = base64.encode_url("+")
    assert(url_enc == "-")
    assert(base64.decode_url(url_enc) == "+")
    
    // Round-trip
    let input = "Lateralus-Lang-Base64"
    assert(base64.decode(base64.encode(input)) == input)
    
    // Validation
    assert(base64.is_valid("Zm9v"))
    assert(!base64.is_valid("!!!"))
    
    print("Base64 tests passed")
}

test_base64()