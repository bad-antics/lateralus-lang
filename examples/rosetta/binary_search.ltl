fn binary_search(arr: list, target: int) -> int {
    let lo = 0
    let hi = len(arr) - 1
    while lo <= hi {
        let mid = int((lo + hi) / 2)
        if arr[mid] == target { return mid }
        if arr[mid] < target { lo = mid + 1 } else { hi = mid - 1 }
    }
    return -1
}
fn main() {
    println(binary_search([1, 2, 3, 4, 5], 3))
}
