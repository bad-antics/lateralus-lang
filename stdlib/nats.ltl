// stdlib/nats.ltl -- NATS client protocol helpers (command builders + parser)
//
// All builders return Result<String, String>:
//   Ok(wire_bytes_as_string) on success
//   Err(reason)              when an argument would corrupt the protocol
//
// parse_message returns Result<Option<Message>, String>:
//   Ok(Some(msg)) -> a full frame was parsed
//   Ok(None)      -> not enough data yet (caller should read more)
//   Err(reason)   -> protocol violation

import "stdlib/strings"

let CRLF = "\r\n"

// ---------------------------------------------------------------------------
// Validation helpers
// ---------------------------------------------------------------------------

// True if `s` contains CR, LF or NUL.
fn has_ctl(s) {
    return contains(s, "\r") || contains(s, "\n") || contains(s, "\0")
}

// True if `s` contains any whitespace delimiter used by NATS framing.
fn has_ws(s) {
    return contains(s, " ") || contains(s, "\t")
}

// Validate a whitespace-delimited protocol token (subject, reply, queue, sid).
// `allow_empty` lets optional fields (reply/queue) be "".
fn check_token(name, value, allow_empty) {
    if len(value) == 0 {
        if allow_empty {
            return Ok(value)
        }
        return Err(name + " must not be empty")
    }
    if has_ctl(value) {
        return Err(name + " must not contain CR, LF or NUL")
    }
    if has_ws(value) {
        return Err(name + " must not contain whitespace")
    }
    return Ok(value)
}

// Validate a free-form protocol line argument (e.g. CONNECT JSON): no CR/LF/NUL.
fn check_line(name, value) {
    if has_ctl(value) {
        return Err(name + " must not contain CR, LF or NUL")
    }
    return Ok(value)
}

// True if `s` is a non-empty string of ASCII digits only.
fn is_uint_str(s) {
    if len(s) == 0 {
        return false
    }
    let i = 0
    while i < len(s) {
        let c = slice(s, i, i + 1)
        if c < "0" || c > "9" {
            return false
        }
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Command builders
// ---------------------------------------------------------------------------

fn connect(opts_json) {
    let checked = check_line("opts_json", opts_json)
    if is_err(checked) {
        return checked
    }
    return Ok("CONNECT " + opts_json + CRLF)
}

fn pub_msg(subject, reply, payload) {
    let s = check_token("subject", subject, false)
    if is_err(s) {
        return s
    }
    let r = check_token("reply", reply, true)
    if is_err(r) {
        return r
    }
    // Payload is length-prefixed, so it may legally contain any bytes (incl. CRLF).
    // The length MUST be the UTF-8 byte length, not the character count.
    let nbytes = len(bytes_of(payload))
    let head = "PUB " + subject
    if len(reply) > 0 {
        head = head + " " + reply
    }
    head = head + " " + str(nbytes) + CRLF
    return Ok(head + payload + CRLF)
}

fn sub(subject, queue, sid) {
    let s = check_token("subject", subject, false)
    if is_err(s) {
        return s
    }
    let q = check_token("queue", queue, true)
    if is_err(q) {
        return q
    }
    let i = check_token("sid", sid, false)
    if is_err(i) {
        return i
    }
    let head = "SUB " + subject
    if len(queue) > 0 {
        head = head + " " + queue
    }
    return Ok(head + " " + sid + CRLF)
}

fn unsub(sid, max) {
    let i = check_token("sid", sid, false)
    if is_err(i) {
        return i
    }
    // `max` is optional: "" / nil means unsubscribe immediately.
    if max == nil || max == "" {
        return Ok("UNSUB " + sid + CRLF)
    }
    let max_s = str(max)
    if !is_uint_str(max_s) {
        return Err("max must be a non-negative integer")
    }
    return Ok("UNSUB " + sid + " " + max_s + CRLF)
}

fn ping() {
    return "PING" + CRLF
}

fn pong() {
    return "PONG" + CRLF
}

// ---------------------------------------------------------------------------
// Parser
// ---------------------------------------------------------------------------

// Split a protocol line on single spaces, dropping empty fragments.
fn split_ws(line) {
    let out = []
    let parts = split(line, " ")
    for p in parts {
        if len(p) > 0 {
            out = out + [p]
        }
    }
    return out
}

// Parse one server frame from the front of `buf`.
// On success returns Ok(Some({kind, ..., consumed})) where `consumed` is the
// number of bytes of `buf` used by the frame.
fn parse_message(buf) {
    let eol = index_of(buf, CRLF)
    if eol < 0 {
        return Ok(None)    // need more data
    }
    let line = slice(buf, 0, eol)
    let line_end = eol + 2

    if line == "PING" {
        return Ok(Some({ kind: "PING", consumed: line_end }))
    }
    if line == "PONG" {
        return Ok(Some({ kind: "PONG", consumed: line_end }))
    }
    if line == "+OK" {
        return Ok(Some({ kind: "OK", consumed: line_end }))
    }

    if starts_with(line, "INFO ") {
        return Ok(Some({
            kind: "INFO",
            json: slice(line, 5, len(line)),
            consumed: line_end
        }))
    }

    // "-ERR" may be bare, or followed by a space and a message.
    if line == "-ERR" {
        return Ok(Some({ kind: "ERR", message: "", consumed: line_end }))
    }
    if starts_with(line, "-ERR ") {
        return Ok(Some({
            kind: "ERR",
            message: slice(line, 5, len(line)),
            consumed: line_end
        }))
    }

    if starts_with(line, "MSG ") {
        let parts = split_ws(line)
        // MSG <subject> <sid> [reply] <#bytes>
        if len(parts) != 4 && len(parts) != 5 {
            return Err("malformed MSG header")
        }
        let subject = parts[1]
        let sid = parts[2]
        let reply = ""
        let nbytes_s = parts[3]
        if len(parts) == 5 {
            reply = parts[3]
            nbytes_s = parts[4]
        }
        if !is_uint_str(nbytes_s) {
            return Err("invalid MSG #bytes: " + nbytes_s)
        }
        let nbytes = try_int(nbytes_s, -1)
        if nbytes < 0 {
            return Err("invalid MSG #bytes: " + nbytes_s)
        }

        // Work in bytes so framing is correct for multi-byte payloads.
        let rest = bytes_of(slice(buf, line_end, len(buf)))
        if len(rest) < nbytes + 2 {
            return Ok(None)    // payload / trailing CRLF not fully received yet
        }
        let payload_bytes = slice(rest, 0, nbytes)
        let trailer = slice(rest, nbytes, nbytes + 2)
        if trailer != bytes_of(CRLF) {
            return Err("MSG payload not terminated by CRLF")
        }
        let consumed = line_end + nbytes + 2
        return Ok(Some({
            kind: "MSG",
            subject: subject,
            sid: sid,
            reply: reply,
            payload: string_from_bytes(payload_bytes),
            consumed: consumed
        }))
    }

    return Err("unknown NATS frame: " + line)
}