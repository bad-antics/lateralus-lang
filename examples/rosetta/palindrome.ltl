// Rosetta Code: Palindrome detection
// https://rosettacode.org/wiki/Palindrome_detection
module examples.rosetta.palindrome

import io

fn is_palindrome(s: str) -> bool {
    let cs = chars(s)
    let n = len(cs)
    let i = 0
    while i < n / 2 {
        if cs[i] != cs[n - 1 - i] { return false }
        i = i + 1
    }
    return true
}

@test
fn test_palindrome() {
    assert_eq(is_palindrome(""), true)
    assert_eq(is_palindrome("a"), true)
    assert_eq(is_palindrome("aba"), true)
    assert_eq(is_palindrome("abba"), true)
    assert_eq(is_palindrome("abc"), false)
}

fn main() {
    print("is_palindrome(\"abba\") = " + str(is_palindrome("abba")))
}

main()
