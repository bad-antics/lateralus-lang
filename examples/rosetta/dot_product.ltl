// Rosetta Code · Dot product · Lateralus

fn dot(a: list, b: list) -> float {
    let acc = 0.0
    let i = 0
    while i < len(a) {
        acc = acc + a[i] * b[i]
        i = i + 1
    }
    return acc
}

fn main() {
    assert_eq(dot([1, 3, -5], [4, -2, -1]), 3, "classic")
    assert_eq(dot([], []), 0, "empty")
    print("dot([1,3,-5],[4,-2,-1]) = " + str(dot([1, 3, -5], [4, -2, -1])))
}

main()
