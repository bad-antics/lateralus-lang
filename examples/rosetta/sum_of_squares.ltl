// Rosetta Code: Sum of squares (1..100 = 338350)
fn sum_sq(n: int) -> int {
    let mut s = 0
    let mut i = 1
    while i <= n { s = s + i * i; i = i + 1 }
    return s
}
println("sum_sq(100) = " + str(sum_sq(100)))
if sum_sq(100) == 338350 && sum_sq(1) == 1 { println("OK") } else { println("FAIL") }
