// Rosetta Code: Factorial (recursive + iterative)
fn fact_rec(n: int) -> int {
    if n <= 1 { return 1 }
    return n * fact_rec(n - 1)
}
fn fact_iter(n: int) -> int {
    let mut r = 1
    let mut i = 2
    while i <= n { r = r * i; i = i + 1 }
    return r
}
println("10! = " + str(fact_rec(10)))
if fact_rec(10) == 3628800 && fact_iter(10) == 3628800 { println("OK") } else { println("FAIL") }
