// Rosetta Code · Perfect numbers · Lateralus

fn divisors(n: int) -> list {
    let out = []
    let d = 1
    while d * d <= n {
        if n % d == 0 {
            out = out + [d]
            let other = idiv(n, d)
            if other != d { out = out + [other] }
        }
        d = d + 1
    }
    return sorted(out)
}

fn is_perfect(n: int) -> bool {
    if n < 2 { return false }
    let ds = divisors(n)
    let sum = 0
    let i = 0
    while i < len(ds) {
        if ds[i] != n { sum = sum + ds[i] }
        i = i + 1
    }
    return sum == n
}

fn main() {
    let found = []
    let i = 1
    while i <= 10000 {
        if is_perfect(i) { found = found + [i] }
        i = i + 1
    }
    assert_eq(found, [6, 28, 496, 8128], "perfect <= 10000")
    print("perfect numbers <= 10000: " + str(found))
    print("divisors(28) = " + str(divisors(28)))
}

main()
