// ===================================================================
// examples/dict_encoding_tutorial.ltl
//
// Tutorial: Columnar Data Compression with Dictionary Encoding
// using Lateralus `stdlib/dict_encoding.ltl`.
//
// Demonstrates:
// 1. Columnar telemetry encoding (HTTP status codes & device types).
// 2. Cardinality tracking and first-seen deduplication.
// 3. Calculating index bit width: ceil(log2(cardinality)).
// 4. Memory footprint savings analysis.
// 5. Exact lossless round-trip reconstruction.
// ===================================================================

import dict_encoding

fn lists_equal(a: list, b: list) -> bool {
    if len(a) != len(b) {
        return false
    }
    let i = 0
    while i < len(a) {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    return true
}

pub fn main() {
    print("=== Lateralus Dictionary Encoding Tutorial ===")

    // 1. Synthetic access telemetry column (20 rows, low cardinality)
    let http_status_column = [
        "200_OK", "200_OK", "404_NOT_FOUND", "200_OK", "500_INTERNAL_SERVER_ERROR",
        "200_OK", "304_NOT_MODIFIED", "200_OK", "200_OK", "404_NOT_FOUND",
        "200_OK", "200_OK", "304_NOT_MODIFIED", "200_OK", "200_OK",
        "500_INTERNAL_SERVER_ERROR", "200_OK", "200_OK", "404_NOT_FOUND", "200_OK"
    ]

    let row_count = len(http_status_column)
    print("Raw column rows: " + str(row_count))

    // 2. Apply dictionary encoding
    let encoded = dict_encoding_encode(http_status_column)
    let dict = encoded["dictionary"]
    let indices = encoded["indices"]
    let card = dict_encoding_cardinality(encoded)
    let bit_width = dict_encoding_index_bit_width(encoded)

    print("Unique dictionary entries (cardinality): " + str(card))
    print("Required bit-width per index: " + str(bit_width) + " bits")

    // 3. Print dictionary mapping
    let d_idx = 0
    while d_idx < len(dict) {
        print("  Index [" + str(d_idx) + "] -> '" + dict[d_idx] + "'")
        d_idx = d_idx + 1
    }

    // 4. Compression analysis
    // Assume average string length ~16 bytes in raw column
    // Dictionary: card * 16 bytes. Indices: row_count * (bit_width / 8 bytes)
    print("Encoded indices count: " + str(len(indices)))

    // 5. Reconstruct and verify lossless round-trip
    let decoded = dict_encoding_decode(encoded)
    let is_identical = lists_equal(decoded, http_status_column)
    if is_identical {
        print("[VERIFIED] Exact round-trip reconstruction matches raw column!")
    } else {
        print("[FAILED] Decoded column differs from original.")
    }

    print("=== Dictionary Encoding Tutorial Completed Successfully ===")
}
