// examples/hopcroft_karp_tutorial.ltl
// Systems Engineering Demonstration:
// Kubernetes Batch Gang Pod-to-Worker-Node Placement via Hopcroft-Karp Algorithm

pub fn schedule_gang_pods(pod_affinity: list, pod_count: int, node_count: int) -> map {
    let mut pair_u = [];
    let mut dist_u = [];
    let mut i = 0;
    while i < pod_count {
        pair_u = pair_u + [-1];
        dist_u = dist_u + [999999];
        i = i + 1;
    }

    let mut pair_v = [];
    let mut j = 0;
    while j < node_count {
        pair_v = pair_v + [-1];
        j = j + 1;
    }

    let mut scheduled_count = 0;
    let mut searching = true;
    let mut phase = 0;

    while searching && phase < 50 {
        phase = phase + 1;

        // BFS Phase: Construct layered DAG of shortest augmenting paths
        let mut queue = [];
        let mut dist_nil = 999999;

        let mut u = 0;
        while u < pod_count {
            if pair_u[u] == -1 {
                dist_u[u] = 0;
                queue = queue + [u];
            } else {
                dist_u[u] = 999999;
            }
            u = u + 1;
        }

        let mut head = 0;
        while head < len(queue) {
            let mut curr_u = queue[head];
            head = head + 1;

            if dist_u[curr_u] < dist_nil {
                let mut candidates = pod_affinity[curr_u];
                let mut c_idx = 0;
                while c_idx < len(candidates) {
                    let mut node = candidates[c_idx];
                    let mut matched_pod = pair_v[node];
                    if matched_pod == -1 {
                        if dist_nil == 999999 {
                            dist_nil = dist_u[curr_u] + 1;
                        }
                    } else {
                        if dist_u[matched_pod] == 999999 {
                            dist_u[matched_pod] = dist_u[curr_u] + 1;
                            queue = queue + [matched_pod];
                        }
                    }
                    c_idx = c_idx + 1;
                }
            }
        }

        if dist_nil == 999999 {
            searching = false;
        } else {
            // DFS Phase: Greedily augment along maximal vertex-disjoint paths
            let mut u_start = 0;
            while u_start < pod_count {
                if pair_u[u_start] == -1 {
                    let mut candidates = pod_affinity[u_start];
                    let mut found = false;
                    let mut idx = 0;
                    while idx < len(candidates) && !found {
                        let mut node = candidates[idx];
                        let mut next_u = pair_v[node];
                        if next_u == -1 {
                            pair_u[u_start] = node;
                            pair_v[node] = u_start;
                            scheduled_count = scheduled_count + 1;
                            found = true;
                        } else {
                            if dist_u[next_u] == dist_u[u_start] + 1 {
                                let mut sub_candidates = pod_affinity[next_u];
                                let mut s_idx = 0;
                                while s_idx < len(sub_candidates) && !found {
                                    let mut sub_node = sub_candidates[s_idx];
                                    if pair_v[sub_node] == -1 {
                                        pair_u[next_u] = sub_node;
                                        pair_v[sub_node] = next_u;
                                        pair_u[u_start] = node;
                                        pair_v[node] = u_start;
                                        scheduled_count = scheduled_count + 1;
                                        found = true;
                                    }
                                    s_idx = s_idx + 1;
                                }
                            }
                        }
                        idx = idx + 1;
                    }
                }
                u_start = u_start + 1;
            }
        }
    }

    return {
        scheduled_pods: scheduled_count,
        pod_placement: pair_u,
        node_binding: pair_v
    };
}

pub fn main() -> int {
    // 5 Gang ML Worker Pods: [DataLoader, ParameterServer, GPUWorker1, GPUWorker2, Checkpointer]
    // 5 Physical Nodes: [WorkerNode-0, WorkerNode-1, WorkerNode-2, WorkerNode-3, WorkerNode-4]
    let mut cluster_topology = [
        [0, 1],       // Pod 0 can bind to Node 0, Node 1
        [1, 2],       // Pod 1 can bind to Node 1, Node 2
        [2, 3],       // Pod 2 can bind to Node 2, Node 3
        [3, 4],       // Pod 3 can bind to Node 3, Node 4
        [0, 4]        // Pod 4 can bind to Node 0, Node 4
    ];

    let mut result = schedule_gang_pods(cluster_topology, 5, 5);
    let mut total = result["scheduled_pods"];
    return total;
}
