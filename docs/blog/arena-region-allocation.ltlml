---
--- Pinned-Vector Arena Example
--- Demonstrates arena region allocation, block rollover, batch allocation, and safe indexing.
---

use stdlib.arena

fn main() -> Int {
    -- 1. Default & New construction with custom block size (e.g., 64 bytes)
    let region = arena::new(64)
    
    println("=== Arena Pinned-Vector Demo ===")
    println("Initial block count: {region |> arena::block_count}")
    println("Initial total capacity: {region |> arena::total}")
    println("Initial remaining bytes: {region |> arena::remaining}")

    -- 2. Allocate individual items and set/get values
    let idx1 = region |> arena::alloc(10)
    let idx2 = region |> arena::alloc(20)
    let idx3 = region |> arena::alloc(30)

    region |> arena::set(idx1, 100)
    region |> arena::set(idx2, 200)
    region |> arena::set(idx3, 300)

    println("\nAllocated 3 slots individually:")
    println("Item 1 at {idx1}: {region |> arena::get(idx1)}")
    println("Item 2 at {idx2}: {region |> arena::get(idx2)}")
    println("Item 3 at {idx3}: {region |> arena::get(idx3)}")

    -- 3. Test block rollover by allocating more data than fits in the first 64-byte block
    println("\nTriggering block rollover...")
    let bulk_idx = region |> arena::alloc_many(5, 99)
    println("Block count after rollover: {region |> arena::block_count}")
    println("Total capacity after rollover: {region |> arena::total}")
    println("Remaining bytes: {region |> arena::remaining}")

    -- 4. Verify bulk allocated vector values
    println("Bulk item at start of allocation: {region |> arena::get(bulk_idx)}")

    -- 5. Out-of-range read testing
    println("\nTesting out-of-range safety:")
    let safe_read = try {
        region |> arena::get(9999)
    } recover err {
        println("Caught expected out-of-range error: {err}")
        0
    }

    println("\nArena demonstration completed successfully.")
    0
}
