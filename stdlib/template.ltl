---
--- stdlib.template Tutorial
---
--- This module tutorial demonstrates how to use the Lateralus standard library 
--- `template` module for filling named placeholders, handling missing values gracefully,
--- and enforcing safety constraints in dynamic text rendering.
---

use stdlib.template

fn main() -> Result<(), String> {
    println("=== Lateralus stdlib.template Tutorial ===")

    -- 1. Basic Template Rendering with Named Placeholders
    let tpl = "Hello, {{name}}! Welcome to {{location}}. Your role is {{role}}."
    
    let data = {
        name: "Alice",
        location: "Cybertron",
        role: "Principal Architect"
    }

    let rendered = tpl |> template.render(data)
    println("Rendered (Success):")
    println(rendered)
    -- Expected output:
    -- Hello, Alice! Welcome to Cybertron. Your role is Principal Architect.

    -- 2. Handling Missing Values and Fallbacks
    -- When a key is missing from the data dictionary, template rendering can either 
    -- fail or substitute a default fallback value using `render_with_default`.
    let partial_data = {
        name: "Bob"
        -- location and role are omitted
    }

    let safe_rendered = partial_data |> template.render_with_default(
        "Hello, {{name}}! Welcome to {{location | 'Unknown Sector'}}. Role: {{role | 'Guest'}}."
    )
    
    println("\nRendered with Defaults (Missing Keys Handled):")
    println(safe_rendered)
    -- Expected output:
    -- Hello, Bob! Welcome to Unknown Sector. Role: Guest.

    -- 3. Fallible Template Pipeline with Strict Error Recovery
    -- Using the fallible pipeline operator `|?>` to catch unhandled template keys
    let strict_result = try {
        "Critical Alert: {{alert_code}} at {{facility}}" 
            |?> template.render_strict(partial_data)
    } recover err {
        "Fallback Alert: Template rendering failed due to missing keys: {err}"
    }

    println("\nStrict Rendering Recovery:")
    println(strict_result)
    -- Expected output:
    -- Fallback Alert: Template rendering failed due to missing keys: KeyError: 'alert_code'

    println("\nTutorial completed successfully.")
    return Ok(())
}