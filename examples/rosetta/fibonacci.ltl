// Rosetta Code: Fibonacci sequence
// https://rosettacode.org/wiki/Fibonacci_sequence
// Iterative implementation with self-verifying @test blocks.

module examples.rosetta.fibonacci

import io

fn fib(n: int) -> int {
    if n < 2 { return n }
    let a = 0
    let b = 1
    let i = 2
    while i <= n {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }
    return b
}

@test
fn test_fib_base() {
    assert_eq(fib(0), 0)
    assert_eq(fib(1), 1)
}

@test
fn test_fib_small() {
    assert_eq(fib(2), 1)
    assert_eq(fib(3), 2)
    assert_eq(fib(10), 55)
}

fn main() {
    print("Fibonacci(10) = " + str(fib(10)))
}

main()
