//! Fixed-width inventory line with stdlib.fmt.
//! Right-aligns quantity, left-aligns the item, and right-aligns the price.

use stdlib.fmt

fn line(qty: int, item: str, cents: int) -> str {
    let q = fmt.pad_left(str(qty), 3, " ")
    let name = fmt.pad_right(item, 12, ".")
    let price = fmt.pad_left(str(cents), 6, " ")
    return q + "  " + name + " " + price
}

fn main() {
    fmt.printf("%s\n", [line(2, "washers", 149)])
    fmt.printf("%s\n", [line(11, "bolts", 75)])
    fmt.printf("%s\n", [line(1, "torque wrench", 4999)])
}
