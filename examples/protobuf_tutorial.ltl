#!/usr/bin/env lateralus
import "protobuf"
fn test_varint() {
    let encoded = protobuf.encode_varint(300)
    let hex = protobuf.bytes_to_hex(encoded)
    let decoded = protobuf.decode_varint(encoded)
    assert(hex == "ac02")
    assert(decoded == 300)
    print("Varint: 300 -> " + hex + " -> " + str(decoded))
}
fn test_zigzag() {
    assert(protobuf.encode_zigzag(-5) == 9)
    assert(protobuf.decode_zigzag(9) == -5)
    print("Zigzag: -5 equals 9")
}
fn test_length_delimited() {
    let payload = protobuf.utf8_to_bytes("hello")
    let encoded = protobuf.encode_length_delimited(payload)
    let decoded = protobuf.decode_length_delimited(encoded)
    assert(protobuf.bytes_to_utf8(decoded) == "hello")
    print("Length-delimited: hello")
}
fn test_sensor() {
    let fields = {1: {wire_type: 0, value: 42}, 2: {wire_type: 0, value: 2350}}
    let msg = protobuf.encode_message(fields)
    let decoded = protobuf.decode_message(msg)
    assert(decoded[1]?[0] == 42)
    assert(decoded[2]?[0] == 2350)
    print("Message encoding works")
}
fn main() { test_varint(); test_zigzag(); test_length_delimited(); test_sensor(); print("All protobuf tests PASSED") }