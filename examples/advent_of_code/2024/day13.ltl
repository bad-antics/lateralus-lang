// Advent of Code 2024 · Day 13 · Claw Contraption
// Each machine: two buttons (A costs 3 tokens, B costs 1) and a prize position.
// Part 1: cheapest token total to reach each prize exactly, else 0.
// Part 2: same, with both prize coordinates shifted by 10^13.
// Self-verifying with @test blocks; sample from the AoC statement.

let SAMPLE = "Button A: X+94, Y+34
Button B: X+22, Y+67
Prize: X=8400, Y=5400

Button A: X+26, Y+66
Button B: X+67, Y+21
Prize: X=12748, Y=12176

Button A: X+17, Y+86
Button B: X+84, Y+37
Prize: X=7870, Y=6450

Button A: X+69, Y+23
Button B: X+27, Y+71
Prize: X=18641, Y=10279"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

// Extract the integer after "X+" / "Y+" / "X=" / "Y=".
fn num_after(s: str, marker: str) -> int {
    let i = 0
    let start = -1
    while i < len(s) - 1 {
        if slice(s, i, i + 2) == marker { start = i + 2; i = len(s) }
        i = i + 1
    }
    if start < 0 { return 0 }
    let digits = ""
    let j = start
    while j < len(s) {
        let c = slice(s, j, j + 1)
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { digits = digits + c; j = j + 1 } else { j = len(s) }
    }
    if len(digits) == 0 { return 0 }
    return int(digits)
}

fn parse(text: str) -> list {
    let machines = []
    let cur = []
    for line in lines_of(text) {
        cur = cur + [line]
        if len(cur) == 3 {
            let ax = num_after(cur[0], "X+")
            let ay = num_after(cur[0], "Y+")
            let bx = num_after(cur[1], "X+")
            let by = num_after(cur[1], "Y+")
            let px = num_after(cur[2], "X=")
            let py = num_after(cur[2], "Y=")
            machines = machines + [[ax, ay, bx, by, px, py]]
            cur = []
        }
    }
    return machines
}

// Cramer's rule; returns token cost or 0 when unreachable/non-integer.
fn cost(m: list, shift: int) -> int {
    let ax = m[0]
    let ay = m[1]
    let bx = m[2]
    let by = m[3]
    let px = m[4] + shift
    let py = m[5] + shift
    let det = ax * by - ay * bx
    if det == 0 { return 0 }
    let na = px * by - py * bx
    let nb = ax * py - ay * px
    if na % det != 0 || nb % det != 0 { return 0 }
    let a = int(na / det)
    let b = int(nb / det)
    if a < 0 || b < 0 { return 0 }
    return 3 * a + b
}

fn solve(text: str, shift: int) -> int {
    let total = 0
    for m in parse(text) { total = total + cost(m, shift) }
    return total
}

@test
fn test_part1() {
    assert_eq(solve(SAMPLE, 0), 480)
}

@test
fn test_part2() {
    assert_eq(solve(SAMPLE, 10000000000000), 875318608908)
}

fn main() {
    print("Day 13 Part 1: " + str(solve(SAMPLE, 0)))
    print("Day 13 Part 2: " + str(solve(SAMPLE, 10000000000000)))
}

main()
