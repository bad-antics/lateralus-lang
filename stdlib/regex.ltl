// ============================================================================
// stdlib/regex.ltl: Regular-expression helpers and common validators
// ============================================================================
//
// Thin convenience layer over the runtime regex engine, plus a small set of
// pre-built validators (is_email, is_ipv4, is_int, is_float, ...).
//
// Conventions:
//   * All validators are anchored (^...$) and total: they never raise.
//   * `escape` returns a string safe to interpolate into a pattern, including
//     inside a character class `[...]`.
// ============================================================================

module regex

// ----------------------------------------------------------------------------
// Core matching primitives (delegated to the runtime)
// ----------------------------------------------------------------------------

fn matches(pattern, text) {
    return __rt_regex_match(pattern, text)
}

fn find(pattern, text) {
    return __rt_regex_find(pattern, text)
}

fn find_all(pattern, text) {
    return __rt_regex_find_all(pattern, text)
}

fn replace(pattern, text, replacement) {
    return __rt_regex_replace(pattern, text, replacement)
}

fn split(pattern, text) {
    return __rt_regex_split(pattern, text)
}

// ----------------------------------------------------------------------------
// Validators
// ----------------------------------------------------------------------------

// Email (pragmatic subset of RFC 5322).
fn is_email(s) {
    return matches("^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$", s)
}

// A single IPv4 octet: 0-255, no leading zeros (except the literal "0").
//   25[0-5]   -> 250-255
//   2[0-4]\d  -> 200-249
//   1\d\d     -> 100-199
//   [1-9]?\d  -> 0-99 (no leading zero on two-digit values)
let IPV4_OCTET = "(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"

// IPv4 dotted-quad with every octet validated to 0-255.
// Rejects: "999.999.999.999", "256.0.0.1", "1.2.3", "1.2.3.4.5", "01.2.3.4"
fn is_ipv4(s) {
    return matches("^(?:" + IPV4_OCTET + "\\.){3}" + IPV4_OCTET + "$", s)
}

// Optionally-signed base-10 integer.
fn is_int(s) {
    return matches("^[+-]?[0-9]+$", s)
}

// Optionally-signed decimal float. A value is a float only when it has a
// fractional part or an exponent; plain integers are NOT floats.
//
//   Accepted: "1.5", "-0.5", ".5", "+.5", "0.0", "1e5", "1.5e-3", "-2E+10", ".5e2"
//   Rejected: "42", "42.", "-7", "", ".", "e5", "1e", "1.e5", "abc"
//
// Structure:
//   [+-]?
//   (?:
//       [0-9]+\.[0-9]+([eE][+-]?[0-9]+)?   digits '.' digits [exponent]
//     | \.[0-9]+([eE][+-]?[0-9]+)?         '.' digits [exponent]
//     | [0-9]+[eE][+-]?[0-9]+              integer mantissa + exponent
//   )
fn is_float(s) {
    return matches(
        "^[+-]?(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)$",
        s
    )
}

// Hexadecimal literal with optional 0x prefix.
fn is_hex(s) {
    return matches("^(?:0[xX])?[0-9A-Fa-f]+$", s)
}

// ----------------------------------------------------------------------------
// Escaping
// ----------------------------------------------------------------------------

// Regex metacharacters that must be backslash-escaped when matching literally.
// '-' is included so escaped text interpolated inside a character class
// ("[" + escape(x) + "]") cannot accidentally form a range such as a-z.
let META_CHARS = ["\\", ".", "^", "$", "*", "+", "?", "(", ")", "[", "]", "{", "}", "|", "-"]

fn escape(s) {
    let out = ""
    for ch in s {
        if META_CHARS |> contains(ch) {
            out = out + "\\" + ch
        } else {
            out = out + ch
        }
    }
    return out
}

// ----------------------------------------------------------------------------
// Self-checks (run via `lateralus test stdlib/regex.ltl`)
// ----------------------------------------------------------------------------

fn __selftest() {
    // is_ipv4
    assert(is_ipv4("192.168.1.1"))
    assert(is_ipv4("0.0.0.0"))
    assert(is_ipv4("255.255.255.255"))
    assert(!is_ipv4("999.999.999.999"))
    assert(!is_ipv4("256.0.0.1"))
    assert(!is_ipv4("1.2.3"))
    assert(!is_ipv4("1.2.3.4.5"))
    assert(!is_ipv4("01.2.3.4"))
    assert(!is_ipv4("1.2.3.256"))

    // is_float
    assert(is_float("1.5"))
    assert(is_float("-0.5"))
    assert(is_float(".5"))
    assert(is_float("0.5"))
    assert(is_float("1e5"))
    assert(is_float("1.5e-3"))
    assert(!is_float("42"))
    assert(!is_float("42."))
    assert(!is_float("-7"))
    assert(!is_float(""))
    assert(!is_float("."))
    assert(!is_float("1e"))
    assert(!is_float("abc"))

    // escape
    assert(escape("a-z") == "a\\-z")
    assert(escape("a.b") == "a\\.b")
    assert(escape("(x|y)") == "\\(x\\|y\\)")
    assert(escape("plain") == "plain")
}