// Lateralus Standard Library Example: 2D/3D Matrix Transformation Pipeline
// Demonstrates matrix multiplication, coordinate transformations, and determinant scale factors.

fn matrix_mul(a: list, b: list) -> list {
    let m = len(a);
    let k_dim = len(a[0]);
    let n = len(b[0]);

    let mut c = [];
    let mut i = 0;
    while i < m {
        let mut row = [];
        let mut j = 0;
        while j < n {
            let mut sum = 0;
            let mut k = 0;
            while k < k_dim {
                sum = sum + a[i][k] * b[k][j];
                k = k + 1;
            }
            row = row + [sum];
            j = j + 1;
        }
        c = c + [row];
        i = i + 1;
    }
    return c;
}

fn matrix_transpose(a: list) -> list {
    let rows = len(a);
    let cols = len(a[0]);
    let mut t = [];
    let mut j = 0;
    while j < cols {
        let mut row = [];
        let mut i = 0;
        while i < rows {
            row = row + [a[i][j]];
            i = i + 1;
        }
        t = t + [row];
        j = j + 1;
    }
    return t;
}

fn matrix_det2(a: list) -> int {
    return a[0][0] * a[1][1] - a[0][1] * a[1][0];
}

fn main() -> int {
    println("=== Lateralus Matrix Transformation Pipeline Demo ===");

    // Define 2D Shear/Scale Linear Transformation Matrix:
    // [ [2, 1], [0, 3] ]
    let transform = [
        [2, 1],
        [0, 3]
    ];
    println("Transformation Matrix T: " + str(transform));

    // Area scaling factor given by determinant: det(T) = 2*3 - 1*0 = 6
    let area_scale = matrix_det2(transform);
    println("Transformation Area Scaling Factor (Determinant): " + str(area_scale));
    assert(area_scale == 6);

    // Coordinate Vector Column: P = [ [4], [5] ]
    let p = [
        [4],
        [5]
    ];
    println("Initial Coordinate Vector P: " + str(p));

    // Transform P' = T * P
    // [ [2*4 + 1*5], [0*4 + 3*5] ] = [ [13], [15] ]
    let p_prime = matrix_mul(transform, p);
    println("Transformed Coordinate Vector P' = T * P: " + str(p_prime));
    assert(p_prime[0][0] == 13);
    assert(p_prime[1][0] == 15);

    // Compute Transpose T^T
    let transform_t = matrix_transpose(transform);
    println("Transposed Matrix T^T: " + str(transform_t));
    assert(transform_t[0][1] == 0);
    assert(transform_t[1][0] == 1);

    println("\nMatrix linear transformations and determinant verified 100% faithful!");
    return 0;
}