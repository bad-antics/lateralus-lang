// Run with: python3 scripts/run_suffix_array_tutorial.py
// The runner prepends the unchanged stdlib/suffix_array.ltl source.

// Compatibility helper: the current Python backend does not supply char_at.
fn char_at(text: str, index: int) -> str {
    return slice(text, index, index + 1)
}

fn main() {
    let text = "banana"
    let suffixes = build(text)
    println(suffixes)
    println(lcp(text, suffixes))
    println(longest_repeated(text))
}
