// Advent of Code 2024 · Day 22 · Monkey Market
// Pseudo-random generator per buyer. Part 1: sum the 2000th secret number.
// Sample answers from https://adventofcode.com/2024/day/22
// (sequence 15887950,16495136,... and sum 37327623 for 1,10,100,2024).

let SEED = 123
let SAMPLE = "1
10
100
2024"

fn lines_of(text: str) -> list {
    let out = []
    for line in str_split(text, "\n") {
        let l = str_trim(line)
        if len(l) > 0 { out = out + [l] }
    }
    return out
}

fn mix(v: int, secret: int) -> int {
    return bxor(v, secret)
}

fn prune(v: int) -> int {
    return v % 16777216
}

fn bxor(x: int, y: int) -> int {
    let result = 0
    let place = 1
    let p = x
    let q = y
    while p > 0 || q > 0 {
        let xb = p % 2
        let yb = q % 2
        if xb != yb { result = result + place }
        p = int(p / 2)
        q = int(q / 2)
        place = place * 2
    }
    return result
}

fn next_secret(secret: int) -> int {
    let s = prune(mix(secret * 64, secret))
    s = prune(mix(int(s / 32), s))
    return prune(mix(s * 2048, s))
}

fn nth_secret(start: int, n: int) -> int {
    let s = start
    let i = 0
    while i < n { s = next_secret(s); i = i + 1 }
    return s
}

fn part1(text: str) -> int {
    let total = 0
    for line in lines_of(text) { total = total + nth_secret(int(line), 2000) }
    return total
}

@test
fn test_sequence() {
    // the 10th secret number for seed 123 is 5908254 (stated on the page)
    assert_eq(nth_secret(SEED, 10), 5908254)
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 37327623)
}

fn main() {
    print("Day 22 Part 1 (sample): " + str(part1(SAMPLE)))
    print("Day 22 secret 10 of 123: " + str(nth_secret(SEED, 10)))
}

main()
