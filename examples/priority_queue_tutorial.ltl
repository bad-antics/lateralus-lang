// Lateralus Standard Library Example: Priority Queue Task Scheduler
// Demonstrates scheduling delayed jobs and dispatching them in strictly ascending deadline order.

fn sift_up(heap: list, idx: int) -> int {
    let mut i = idx;
    while i > 0 {
        let p = (i - 1) / 2;
        if heap[i] < heap[p] {
            let tmp = heap[i];
            heap[i] = heap[p];
            heap[p] = tmp;
            i = p;
        } else {
            break;
        }
    }
    return 0;
}

fn sift_down(heap: list, idx: int) -> int {
    let mut i = idx;
    let n = len(heap);
    while 2 * i + 1 < n {
        let l = 2 * i + 1;
        let r = 2 * i + 2;
        let mut min_i = i;
        if heap[l] < heap[min_i] {
            min_i = l;
        }
        if r < n && heap[r] < heap[min_i] {
            min_i = r;
        }
        if min_i != i {
            let tmp = heap[i];
            heap[i] = heap[min_i];
            heap[min_i] = tmp;
            i = min_i;
        } else {
            break;
        }
    }
    return 0;
}

fn drop_tail(items: list) -> list {
    let mut rem = [];
    let mut i = 0;
    while i < len(items) - 1 {
        rem.append(items[i]);
        i = i + 1;
    }
    return rem;
}

fn main() -> int {
    println("=== Lateralus Priority Queue Task Scheduler Demo ===");

    let mut deadline_heap = [];

    // Schedule 4 background jobs with distinct target execution offsets (milliseconds)
    println("Enqueuing jobs with deadlines:");
    println("  - job:backup_db      (500ms)");
    println("  - job:sync_metrics   (100ms)");
    println("  - job:heartbeat_ping (20ms)");
    println("  - job:send_report    (1200ms)");

    deadline_heap.append(500); sift_up(deadline_heap, len(deadline_heap) - 1);
    deadline_heap.append(100); sift_up(deadline_heap, len(deadline_heap) - 1);
    deadline_heap.append(20);  sift_up(deadline_heap, len(deadline_heap) - 1);
    deadline_heap.append(1200); sift_up(deadline_heap, len(deadline_heap) - 1);

    assert(len(deadline_heap) == 4);
    println("\nAll jobs enqueued. Min-heap root is: " + str(deadline_heap[0]) + "ms");
    assert(deadline_heap[0] == 20);

    // Dispatch loop
    println("\nDispatching tasks by earliest deadline:");
    let mut prev_deadline = -1;
    let mut count = 0;

    while len(deadline_heap) > 0 {
        let next_deadline = deadline_heap[0];
        println("  -> Dispatched task at deadline: " + str(next_deadline) + "ms");
        assert(next_deadline > prev_deadline); // Must be strictly ascending!
        prev_deadline = next_deadline;
        count = count + 1;

        if len(deadline_heap) > 1 {
            deadline_heap[0] = deadline_heap[len(deadline_heap) - 1];
            deadline_heap = drop_tail(deadline_heap);
            sift_down(deadline_heap, 0);
        } else {
            deadline_heap = [];
        }
    }

    assert(count == 4);
    println("\nPriority Queue dispatch sequence verified 100% ascending in O(N log N)!");
    return 0;
}
