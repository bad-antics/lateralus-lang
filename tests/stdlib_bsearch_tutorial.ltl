// Standard Library Binary Search & Bounds Tutorial Verification Suite
// Validates O(log N) exact search, lower_bound, upper_bound, and partition point invariants.

fn binary_search(arr: list, target: int) -> int {
    let mut low = 0;
    let mut high = len(arr) - 1;
    while low <= high {
        let mid = low + (high - low) / 2;
        if arr[mid] == target {
            return mid;
        } else if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1;
}

fn lower_bound(arr: list, target: int) -> int {
    let mut low = 0;
    let mut high = len(arr);
    while low < high {
        let mid = low + (high - low) / 2;
        if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

fn upper_bound(arr: list, target: int) -> int {
    let mut low = 0;
    let mut high = len(arr);
    while low < high {
        let mid = low + (high - low) / 2;
        if arr[mid] <= target {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

fn count_occurrences(arr: list, target: int) -> int {
    return upper_bound(arr, target) - lower_bound(arr, target);
}

fn main() -> int {
    // 1. Classical Sorted Array with Duplicates
    let nums = [10, 20, 25, 25, 25, 30, 45, 50, 70, 90];
    let n = len(nums);

    // Exact searches
    assert(binary_search(nums, 10) == 0);
    assert(binary_search(nums, 90) == 9);
    assert(binary_search(nums, 45) == 6);
    assert(binary_search(nums, 999) == -1);
    assert(binary_search(nums, 5) == -1);

    // 2. Lower Bound: First index where val >= target
    assert(lower_bound(nums, 25) == 2);
    assert(lower_bound(nums, 26) == 5); // Points to 30 at index 5
    assert(lower_bound(nums, 5) == 0);  // Less than all: index 0
    assert(lower_bound(nums, 100) == n);// Greater than all: index n

    // 3. Upper Bound: First index where val > target
    assert(upper_bound(nums, 25) == 5); // Points to 30 at index 5
    assert(upper_bound(nums, 20) == 2);
    assert(upper_bound(nums, 5) == 0);
    assert(upper_bound(nums, 90) == n);

    // 4. Duplicate Range Invariant: Count of 25s
    // range: [2, 5) -> count = 3
    let count25 = count_occurrences(nums, 25);
    assert(count25 == 3);

    let count20 = count_occurrences(nums, 20);
    assert(count20 == 1);

    let count999 = count_occurrences(nums, 999);
    assert(count999 == 0);

    // 5. Partition Predicate Invariant Verification
    let lb = lower_bound(nums, 30);
    let mut i = 0;
    while i < lb {
        assert(nums[i] < 30);
        i = i + 1;
    }
    let mut j = lb;
    while j < n {
        assert(nums[j] >= 30);
        j = j + 1;
    }

    // 6. Empty Array Edge Case
    let empty = [];
    assert(binary_search(empty, 42) == -1);
    assert(lower_bound(empty, 42) == 0);
    assert(upper_bound(empty, 42) == 0);

    return 0;
}