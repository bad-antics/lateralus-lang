// ===================================================================
// examples/yaml_tutorial.ltl
//
// Tutorial: Cloud-Native Declarative Manifests with Lateralus
// stdlib/yaml.ltl (YAML 1.2).
//
// Demonstrates:
// 1. Parsing indentation-based YAML manifests into nested data structures.
// 2. Traversing multi-level nested maps and block sequence arrays.
// 3. Extracting typed fields (integers, strings, booleans, and nulls).
// 4. Safe quote-aware comment stripping.
// ===================================================================

import yaml

pub fn main() {
    print("=== Lateralus YAML 1.2 Parser Tutorial ===")

    // Define cloud-native service manifest
    let manifest = "
# Microservice Configuration Deployment
apiVersion: v1
kind: Service
metadata:
  name: billing-api
  tier: production
spec:
  replicas: 3
  active: true
  ports:
    - 80
    - 443
    - 8080
"

    print("Parsing YAML deployment manifest...")
    let doc = yaml_parse(manifest)

    print("API Version: " + doc["apiVersion"])
    print("Kind:        " + doc["kind"])

    let meta = doc["metadata"]
    print("Metadata:    name=" + meta["name"] + ", tier=" + meta["tier"])

    let spec = doc["spec"]
    print("Spec:")
    print("  Replicas: " + str(spec["replicas"]))
    print("  Active:   " + str(spec["active"]))

    let ports = spec["ports"]
    print("Configured port forwardings (" + str(len(ports)) + " entries):")
    let i = 0
    while i < len(ports) {
        print("  Port [" + str(i + 1) + "]: " + str(ports[i]))
        i = i + 1
    }

    if len(ports) == 3 && ports[1] == 443 {
        print("PASS: Port sequence extracted accurately from indentation tree!")
    }

    print("=== YAML tutorial demonstration completed successfully ===")
}
