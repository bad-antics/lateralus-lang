// Standard Library Huffman Coding Tutorial Verification Suite
// Validates prefix-free entropy codes, variable-length compression, and lossless roundtrip decoding.

fn huffman_encode(text: string, code_table: dict) -> string {
    let mut bits = "";
    let mut i = 0;
    while i < len(text) {
        let ch = slice(text, i, i + 1);
        if contains(code_table, ch) {
            bits = bits + code_table[ch];
        }
        i = i + 1;
    }
    return bits;
}

fn huffman_decode(bitstring: string, reverse_table: dict) -> string {
    let mut decoded = "";
    let mut buffer = "";
    let mut i = 0;
    while i < len(bitstring) {
        let b = slice(bitstring, i, i + 1);
        buffer = buffer + b;
        if contains(reverse_table, buffer) {
            decoded = decoded + reverse_table[buffer];
            buffer = "";
        }
        i = i + 1;
    }
    return decoded;
}

fn main() -> int {
    // 1. Classical Textbook Corpus: "ABRACADABRA"
    // Frequencies: A:5, B:2, R:2, C:1, D:1
    let original = "ABRACADABRA";

    // 2. Optimal prefix-free code table
    let mut code_map = {};
    code_map["A"] = "0";
    code_map["B"] = "100";
    code_map["R"] = "101";
    code_map["C"] = "110";
    code_map["D"] = "111";

    let mut rev_map = {};
    rev_map["0"] = "A";
    rev_map["100"] = "B";
    rev_map["101"] = "R";
    rev_map["110"] = "C";
    rev_map["111"] = "D";

    // 3. Encode operation
    let encoded_bits = huffman_encode(original, code_map);
    // Expected bits:
    // A(0) B(100) R(101) A(0) C(110) A(0) D(111) A(0) B(100) R(101) A(0)
    assert(encoded_bits == "01001010110011101001010");
    assert(len(encoded_bits) == 23); // 23 bits vs 88 bits (8-bit ASCII)

    // 4. Lossless Decode Roundtrip
    let restored = huffman_decode(encoded_bits, rev_map);
    assert(restored == original);
    assert(len(restored) == 11);

    // 5. Prefix-free Invariant Verification
    // Ensure no code word is a prefix of any other code word
    let codes = ["0", "100", "101", "110", "111"];
    let mut i = 0;
    while i < len(codes) {
        let mut j = 0;
        while j < len(codes) {
            if i != j {
                let c1 = codes[i];
                let c2 = codes[j];
                let len1 = len(c1);
                let len2 = len(c2);
                if len1 <= len2 {
                    let sub = slice(c2, 0, len1);
                    assert(sub != c1); // Proves prefix-free property!
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    return 0;
}
