// examples/ports/collatz/collatz.ltl
// Collatz Hailstone Max-Sequence Explorer in idiomatic Lateralus

module examples.ports.collatz

import io

fn collatz_len(n: int) -> int {
    let mut steps = 1
    let mut curr = n
    while curr > 1 {
        if curr % 2 == 0 {
            curr = curr / 2
        } else {
            curr = 3 * curr + 1
        }
        steps += 1
    }
    return steps
}

fn max_collatz_under(limit: int) -> int {
    let mut max_len = 0
    let mut best_start = 1
    let mut i = 1
    while i <= limit {
        let l = collatz_len(i)
        if l > max_len {
            max_len = l
            best_start = i
        }
        i += 1
    }
    return best_start
}

fn main() {
    let limit = 100000
    let best = max_collatz_under(limit)
    let length = collatz_len(best)
    io.println("limit=" + limit as str + " best_start=" + best as str + " length=" + length as str)
}

main()
