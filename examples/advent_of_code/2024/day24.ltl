// Advent of Code 2024 · Day 24 · Crossed Wires
// Logic-gate simulation. Part 1 uses the larger official sample:
// the z wires combine to 2024.
// Part 2: NO official sample answer exists for this puzzle — the puzzle
// asks for the 8 swapped wires of the (full, adder-shaped) input, and
// the sample circuit is NOT an adder (5-bit x/y but 13 z wires), so no
// sample value can be asserted. part2() below implements the standard
// adder-structure validation (rules R1-R5, see suspect_wires) and
// returns the suspect wires it flags on the given circuit as a
// diagnostic string. On a real adder input with 4 swapped pairs these
// rules identify exactly the 8 swapped wires; on the sample they flag
// many wires, because the sample is not an adder. So the @tests below
// do NOT assert the sample's diagnostic list — they validate the
// diagnostic function itself on two small synthetic 3-bit adders built
// for this purpose: a correct one (0 suspects) and the same adder with
// the outputs of two gates swapped (exactly those two wires flagged).
// main() still labels the sample output as diagnostic.

let SAMPLE = "x00: 1
x01: 0
x02: 1
x03: 1
x04: 0
y00: 1
y01: 1
y02: 1
y03: 1
y04: 1

ntg XOR fgs -> mjb
y02 OR x01 -> tnw
kwq OR kpj -> z05
x00 OR x03 -> fst
tgd XOR rvg -> z01
vdt OR tnw -> bfw
bfw AND frj -> z10
ffh OR nrd -> bqk
y00 AND y03 -> djm
y03 OR y00 -> psh
bqk OR frj -> z08
tnw OR fst -> frj
gnj AND tgd -> z11
bfw XOR mjb -> z00
x03 OR x00 -> vdt
gnj AND wpb -> z02
x04 AND y00 -> kjc
djm OR pbm -> qhw
nrd AND vdt -> hwm
kjc AND fst -> rvg
y04 OR y02 -> fgs
y01 AND x02 -> pbm
ntg OR kjc -> kwq
psh XOR fgs -> tgd
qhw XOR tgd -> z09
pbm OR djm -> kpj
x03 XOR y03 -> ffh
x00 XOR y04 -> ntg
bfw OR bqk -> z06
nrd XOR fgs -> wpb
frj XOR qhw -> z04
bqk OR frj -> z07
y03 OR x01 -> nrd
hwm AND bqk -> z03
tgd XOR rvg -> z12
tnw OR pbm -> gnj"

// Parse into [values dict, gates list]; each gate is [a, op, b, out].
fn parse(text: str) -> list {
    let vals = {}
    let gates = []
    let sections = str_split(text, "\n\n")
    let vlines = str_split(sections[0], "\n")
    let i = 0
    while i < len(vlines) {
        let line = str_trim(vlines[i])
        if len(line) > 0 {
            let parts = str_split(line, ": ")
            vals[parts[0]] = int(parts[1])
        }
        i = i + 1
    }
    let glines = str_split(sections[1], "\n")
    let j = 0
    while j < len(glines) {
        let line = str_trim(glines[j])
        if len(line) > 0 {
            let parts = str_split(line, " -> ")
            let lhs = str_split(parts[0], " ")
            gates = gates + [[lhs[0], lhs[1], lhs[2], parts[1]]]
        }
        j = j + 1
    }
    return [vals, gates]
}

// Evaluate all gates (in input order, repeated until nothing changes).
// Values are 0/1 ints; AND/OR/XOR via arithmetic so no bool/int mix.
fn simulate(vals: dict, gates: list) -> dict {
    let changed = true
    let iters = 0
    while changed {
        if iters >= 1000 { break }
        iters = iters + 1
        changed = false
        let i = 0
        while i < len(gates) {
            let g = gates[i]
            let out = g[3]
            if contains(vals, out) == false {
                if contains(vals, g[0]) {
                    if contains(vals, g[2]) {
                        let a = vals[g[0]]
                        let b = vals[g[2]]
                        let v = 0
                        if g[1] == "AND" { v = a * b }
                        if g[1] == "OR" { v = a + b - a * b }
                        if g[1] == "XOR" { v = a + b - 2 * a * b }
                        vals[out] = v
                        changed = true
                    }
                }
            }
            i = i + 1
        }
    }
    return vals
}

fn z_value(vals: dict) -> int {
    let zs = []
    let ks = keys(vals)
    let i = 0
    while i < len(ks) {
        if str_starts_with(ks[i], "z") { zs = zs + [ks[i]] }
        i = i + 1
    }
    zs = sorted(zs)
    let total = 0
    let pow2 = 1
    let j = 0
    while j < len(zs) {
        total = total + vals[zs[j]] * pow2
        pow2 = pow2 * 2
        j = j + 1
    }
    return total
}

fn part1(text: str) -> int {
    let p = parse(text)
    let vals = simulate(p[0], p[1])
    return z_value(vals)
}

// True if any gate consuming `wire` has operator `op`.
fn feeds_op(uses: dict, wire: str, op: str) -> bool {
    if contains(uses, wire) == false { return false }
    let lst = uses[wire]
    let i = 0
    while i < len(lst) {
        let pair = lst[i]
        if pair[1] == op { return true }
        i = i + 1
    }
    return false
}

// Adder-structure validation. In a correct ripple-carry adder:
//  R1: every z output except the highest must come from an XOR gate.
//  R2: an XOR gate not outputting z must take an x/y input (it is either
//      x_i XOR y_i, or a sum XOR); otherwise it is misplaced.
//  R3: an AND gate other than x00 AND y00 must feed an OR gate (it makes
//      a carry term).
//  R4: an OR gate other than the one producing the highest z must feed
//      an XOR gate (its carry goes into the next sum).
//  R5: an XOR gate with x/y inputs outputting z (other than z00) is
//      misplaced: x_i XOR y_i must feed a sum XOR, not a z output.
// Returns the sorted list of suspect output wires.
fn suspect_wires(text: str) -> list {
    let p = parse(text)
    let gates = p[1]
    let by_out = {}
    let uses = {}
    let i = 0
    while i < len(gates) {
        let g = gates[i]
        by_out[g[3]] = [g[0], g[1], g[2]]
        let a = g[0]
        let b = g[2]
        let rec = [g[3], g[1]]
        if contains(uses, a) == false { uses[a] = [] }
        let la = uses[a]
        la = la + [rec]
        uses[a] = la
        if contains(uses, b) == false { uses[b] = [] }
        let lb = uses[b]
        lb = lb + [rec]
        uses[b] = lb
        i = i + 1
    }
    let zs = []
    let oks = keys(by_out)
    let k = 0
    while k < len(oks) {
        if str_starts_with(oks[k], "z") { zs = zs + [oks[k]] }
        k = k + 1
    }
    zs = sorted(zs)
    let zmax = zs[len(zs) - 1]
    let bad = {}
    let j = 0
    while j < len(gates) {
        let g = gates[j]
        let out = g[3]
        let op = g[1]
        let a = g[0]
        let b = g[2]
        // R1
        if str_starts_with(out, "z") {
            if out != zmax {
                if op != "XOR" { bad[out] = true }
            }
        }
        // R2
        if op == "XOR" {
            if str_starts_with(out, "z") == false {
                let has_xy = false
                if str_starts_with(a, "x") { has_xy = true }
                if str_starts_with(a, "y") { has_xy = true }
                if str_starts_with(b, "x") { has_xy = true }
                if str_starts_with(b, "y") { has_xy = true }
                if has_xy == false { bad[out] = true }
            }
        }
        // R3
        if op == "AND" {
            let is_first = false
            if a == "x00" {
                if b == "y00" { is_first = true }
            }
            if a == "y00" {
                if b == "x00" { is_first = true }
            }
            if is_first == false {
                if feeds_op(uses, out, "OR") == false { bad[out] = true }
            }
        }
        // R4
        if op == "OR" {
            if out != zmax {
                if feeds_op(uses, out, "XOR") == false { bad[out] = true }
            }
        }
        // R5
        if op == "XOR" {
            if str_starts_with(out, "z") {
                if out != "z00" {
                    if str_starts_with(a, "x") { bad[out] = true }
                    if str_starts_with(a, "y") { bad[out] = true }
                    if str_starts_with(b, "x") { bad[out] = true }
                    if str_starts_with(b, "y") { bad[out] = true }
                }
            }
        }
        j = j + 1
    }
    return sorted(keys(bad))
}

// Diagnostic only (see header): comma-joined suspect wires for the
// adder-structure check. No official sample answer exists for part 2.
fn part2(text: str) -> str {
    return str_join(suspect_wires(text), ",")
}

@test
fn test_sample_part1() {
    assert_eq(part1(SAMPLE), 2024)
}

// Synthetic 3-bit ripple-carry adder (x = 5, y = 3, so z = 8), built to
// validate the part-2 diagnostic: a correct adder must flag 0 wires.
let SYNTH_ADDER = "x00: 1
x01: 0
x02: 1
y00: 1
y01: 1
y02: 0

x00 XOR y00 -> z00
x00 AND y00 -> c00
x01 XOR y01 -> t01
x01 AND y01 -> a01
t01 XOR c00 -> z01
t01 AND c00 -> b01
a01 OR b01 -> c01
x02 XOR y02 -> t02
x02 AND y02 -> a02
t02 XOR c01 -> z02
t02 AND c01 -> b02
a02 OR b02 -> z03"

// Same adder with the outputs of two gates swapped:
// "x01 XOR y01 -> t01" and "t01 XOR c00 -> z01" became
// "x01 XOR y01 -> z01" and "t01 XOR c00 -> t01".
// The diagnostic must flag exactly those two wires.
let SYNTH_SWAPPED = "x00: 1
x01: 0
x02: 1
y00: 1
y01: 1
y02: 0

x00 XOR y00 -> z00
x00 AND y00 -> c00
x01 XOR y01 -> z01
x01 AND y01 -> a01
t01 XOR c00 -> t01
t01 AND c00 -> b01
a01 OR b01 -> c01
x02 XOR y02 -> t02
x02 AND y02 -> a02
t02 XOR c01 -> z02
t02 AND c01 -> b02
a02 OR b02 -> z03"

@test
fn test_synth_adder_part1() {
    assert_eq(part1(SYNTH_ADDER), 8)
}

@test
fn test_synth_adder_no_suspects() {
    assert_eq(len(suspect_wires(SYNTH_ADDER)), 0)
    assert_eq(part2(SYNTH_ADDER), "")
}

@test
fn test_synth_swapped_two_suspects() {
    assert_eq(suspect_wires(SYNTH_SWAPPED), ["t01", "z01"])
    assert_eq(part2(SYNTH_SWAPPED), "t01,z01")
}

fn main() {
    print("Day 24 Part 1: " + str(part1(SAMPLE)))
    print("Day 24 Part 2 (diagnostic, no sample answer): " + part2(SAMPLE))
}

main()
