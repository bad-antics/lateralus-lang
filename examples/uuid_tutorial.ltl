// examples/uuid_tutorial.ltl - Practical UUID Generation, Validation, and Storage
// Demonstrates generating UUID v4 identifiers, formatting for URL/database storage, and validating incoming inputs.

import uuid

fn create_user_session(user_id: int) -> map {
    let session_id = uuid.uuid4()
    let compact_id = uuid.compact(session_id)
    
    return {
        "user_id": user_id,
        "session_id": session_id,
        "compact_key": compact_id,
        "version": uuid.version(session_id)
    }
}

fn validate_session_token(token: str) -> bool {
    if !uuid.is_valid(token) {
        return false
    }
    // Verify it is a random UUID v4
    return uuid.version(token) == 4
}

fn main() {
    println("=== Lateralus UUID Standard Library ===")
    
    // 1. Generate session with UUID v4
    let session = create_user_session(42)
    let sid = session["session_id"]
    let ckey = session["compact_key"]
    
    println("Generated Session UUID: " + sid)
    println("Storage Key (Compact): " + ckey)
    println("Version: " + to_str(session["version"]))
    
    // 2. Validate token format
    let valid = validate_session_token(sid)
    println("Token validation check: " + to_str(valid))
    
    // 3. Compact and Expand round-trip
    let restored = uuid.expand(ckey)
    if uuid.equals(restored, sid) {
        println("Compact <-> Standard round-trip verified successfully!")
    }
    
    // 4. Standard Namespaces
    println("DNS Namespace: " + uuid.NAMESPACE_DNS)
    println("URL Namespace: " + uuid.NAMESPACE_URL)
}
