// Lateralus Standard Library Example: Bellman-Ford Shortest Path & Arbitrage Detection
// Demonstrates relaxation with negative edge weights and financial arbitrage cycle detection.

fn bellman_ford(n: int, edges: list, source: int) -> dict {
    let INF = 1000000000;
    let mut dist = [];
    let mut parent = [];
    let mut i = 0;
    while i < n {
        dist = dist + [INF];
        parent = parent + [-1];
        i = i + 1;
    }
    dist[source] = 0;

    let mut iter = 0;
    while iter < (n - 1) {
        let mut updated = false;
        let mut e_idx = 0;
        while e_idx < len(edges) {
            let e = edges[e_idx];
            let u = e[0];
            let v = e[1];
            let w = e[2];
            if dist[u] != INF {
                if dist[u] + w < dist[v] {
                    dist[v] = dist[u] + w;
                    parent[v] = u;
                    updated = true;
                }
            }
            e_idx = e_idx + 1;
        }
        if updated == false {
            iter = n;
        } else {
            iter = iter + 1;
        }
    }

    let mut has_negative_cycle = false;
    let mut cycle_node = -1;
    let mut k = 0;
    while k < len(edges) {
        let e2 = edges[k];
        let u2 = e2[0];
        let v2 = e2[1];
        let w2 = e2[2];
        if dist[u2] != INF {
            if dist[u2] + w2 < dist[v2] {
                has_negative_cycle = true;
                cycle_node = v2;
                k = len(edges);
            }
        }
        k = k + 1;
    }

    let mut result = {};
    result["dist"] = dist;
    result["parent"] = parent;
    result["has_negative_cycle"] = has_negative_cycle;
    result["cycle_node"] = cycle_node;
    return result;
}

fn reconstruct_path(parent: list, target: int) -> list {
    let mut path = [];
    let mut curr = target;
    while curr != -1 {
        path = [curr] + path;
        curr = parent[curr];
    }
    return path;
}

fn main() -> int {
    println("=== Bellman-Ford SSSP & Arbitrage Detection Example ===");

    // Scenario 1: Routing with negative weights (discounts/rebates)
    // 0: Source, 1: Hop A, 2: Hop B, 3: Hop C, 4: Target
    let edges = [
        [0, 1, 6],
        [0, 2, 7],
        [1, 2, 8],
        [1, 3, 5],
        [1, 4, -4],
        [2, 3, -3],
        [2, 4, 9],
        [3, 1, -2],
        [4, 3, 7]
    ];

    let result = bellman_ford(5, edges, 0);
    let dist = result["dist"];
    let parent = result["parent"];
    let has_neg = result["has_negative_cycle"];

    if has_neg {
        println("Warning: Negative-weight cycle detected!");
    } else {
        println("Shortest distance to target node 4:");
        println(dist[4]);

        let path = reconstruct_path(parent, 4);
        println("Reconstructed shortest path to node 4:");
        let mut idx = 0;
        while idx < len(path) {
            println(path[idx]);
            idx = idx + 1;
        }
    }

    println("Bellman-Ford execution completed successfully.");
    return 0;
}
