// Standard Library 0/1 Knapsack Dynamic Programming Verification Suite
// Validates Bellman optimality recurrence, capacity constraints, and subset reconstruction.

fn knapsack_01(weights: list, values: list, capacity: int) -> dict {
    let n = len(weights);
    let mut dp = [];
    let mut i = 0;
    while i <= n {
        let mut row = [];
        let mut w = 0;
        while w <= capacity {
            row = row + [0];
            w = w + 1;
        }
        dp = dp + [row];
        i = i + 1;
    }

    let mut item = 1;
    while item <= n {
        let wt = weights[item - 1];
        let val = values[item - 1];
        let mut cap = 0;
        while cap <= capacity {
            if wt <= cap {
                let without_item = dp[item - 1][cap];
                let with_item = dp[item - 1][cap - wt] + val;
                if with_item > without_item {
                    dp[item][cap] = with_item;
                } else {
                    dp[item][cap] = without_item;
                }
            } else {
                dp[item][cap] = dp[item - 1][cap];
            }
            cap = cap + 1;
        }
        item = item + 1;
    }

    let max_val = dp[n][capacity];

    // Reconstruct selected item indices
    let mut selected = [];
    let mut curr_w = capacity;
    let mut k = n;
    while k > 0 {
        if dp[k][curr_w] != dp[k - 1][curr_w] {
            selected = [k - 1] + selected;
            curr_w = curr_w - weights[k - 1];
        }
        k = k - 1;
    }

    let mut result = {};
    result["max_value"] = max_val;
    result["selected"] = selected;
    return result;
}

fn main() -> int {
    // 1. Classical 4-item instance
    // Items:
    // 0: weight 2, value 3
    // 1: weight 3, value 4
    // 2: weight 4, value 5
    // 3: weight 5, value 6
    // Capacity: 5
    // Optimal: select items 0 and 1 -> weight 2+3=5, value 3+4=7
    let w1 = [2, 3, 4, 5];
    let v1 = [3, 4, 5, 6];
    let res1 = knapsack_01(w1, v1, 5);
    assert(res1["max_value"] == 7);
    let s1 = res1["selected"];
    assert(len(s1) == 2);
    assert(s1[0] == 0);
    assert(s1[1] == 1);

    // 2. Larger instance with 5 items
    // Items:
    // 0: weight 1, value 1
    // 1: weight 2, value 6
    // 2: weight 5, value 18
    // 3: weight 6, value 22
    // 4: weight 7, value 28
    // Capacity: 11
    // Combinations:
    // item 1 + 2 + 3: wt 2+5+6 = 13 (exceeds)
    // item 1 + 2: wt 7, val 24
    // item 0 + 1 + 4: wt 1+2+7 = 10, val 1+6+28 = 35
    // item 0 + 2 + 5 (wt 1+5+? -> wt 1+5+? etc)
    // Let's verify: wt 2+7 = 9 (val 34), wt 1+2+7 = 10 (val 35), wt 5+6 = 11 (val 40)
    // 18 + 22 = 40 (weight 5 + 6 = 11)
    let w2 = [1, 2, 5, 6, 7];
    let v2 = [1, 6, 18, 22, 28];
    let res2 = knapsack_01(w2, v2, 11);
    assert(res2["max_value"] == 40);
    let s2 = res2["selected"];
    assert(len(s2) == 2);
    assert(s2[0] == 2);
    assert(s2[1] == 3);

    // 3. Zero Capacity Limit
    let res3 = knapsack_01(w1, v1, 0);
    assert(res3["max_value"] == 0);
    assert(len(res3["selected"]) == 0);

    // 4. Capacity Larger than Total Items Weight
    // All items fit: total weight 2+3+4+5 = 14, total value 3+4+5+6 = 18
    let res4 = knapsack_01(w1, v1, 20);
    assert(res4["max_value"] == 18);
    assert(len(res4["selected"]) == 4);

    // 5. Heavy items exceeding capacity discarded
    let w5 = [10, 20, 30];
    let v5 = [100, 200, 300];
    let res5 = knapsack_01(w5, v5, 5);
    assert(res5["max_value"] == 0);
    assert(len(res5["selected"]) == 0);

    return 0;
}
