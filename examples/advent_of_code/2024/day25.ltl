// Advent of Code 2024 · Day 25 · Code Chronicle
// Keys and locks are 5-wide 7-tall grids.
// Locks: top row all #, bottom row all .; pin heights counted from top.
// Keys: bottom row all #, top row all .; key heights counted from bottom.
// A key fits a lock if no column sum exceeds 5 (no overlap).
// Part 1: count fitting key/lock pairs.
// No Part 2 — this is Christmas Day!

let SAMPLE = "#####
.####
.####
.####
.#.#.
.#...
.....

#####
##.##
.#.##
...##
...#.
...#.
.....

.....
#....
#....
#...#
#.#.#
#.###
#####

.....
.....
#.#..
###..
###.#
###.#
#####

.....
.....
.....
#....
#.#..
#.#.#
#####"

fn parse_schematics(text: str) -> list {
    let blocks = str_split(text, "\n\n")
    let locks = []
    let keys = []
    let i = 0
    while i < len(blocks) {
        let block = str_trim(blocks[i])
        if len(block) == 0 { i = i + 1 }
        else {
            let lines = str_split(block, "\n")
            let rows = []
            let j = 0
            while j < len(lines) {
                let row = str_trim(lines[j])
                if len(row) > 0 { rows = rows + [row] }
                j = j + 1
            }
            if len(rows) == 0 { i = i + 1 }
            else {
                // Lock: first row all '#'
                let is_lock = true
                let k = 0
                while k < len(rows[0]) {
                    if slice(rows[0], k, k + 1) != "#" { is_lock = false }
                    k = k + 1
                }
                // Count column heights (excluding first/last row)
                let heights = []
                let col = 0
                while col < 5 {
                    let h = 0
                    let r = 1
                    while r < len(rows) - 1 {
                        if slice(rows[r], col, col + 1) == "#" { h = h + 1 }
                        r = r + 1
                    }
                    heights = heights + [h]
                    col = col + 1
                }
                if is_lock {
                    locks = locks + [heights]
                } else {
                    keys = keys + [heights]
                }
                i = i + 1
            }
        }
    }
    return [locks, keys]
}

fn fits(lock: list, key: list) -> bool {
    let i = 0
    while i < len(lock) {
        if lock[i] + key[i] > 5 { return false }
        i = i + 1
    }
    return true
}

fn part1(text: str) -> int {
    let parsed = parse_schematics(text)
    let locks = parsed[0]
    let keys = parsed[1]
    let count = 0
    let i = 0
    while i < len(locks) {
        let j = 0
        while j < len(keys) {
            if fits(locks[i], keys[j]) { count = count + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return count
}

@test
fn test_part1() {
    assert_eq(part1(SAMPLE), 3)
}

fn main() {
    print("Day 25 Part 1: " + str(part1(SAMPLE)))
    print("Day 25 Part 2: 🎄 Merry Christmas!")
}

main()
