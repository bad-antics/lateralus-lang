// Pinned RFC 4648 vectors for the stdlib/base64 tutorial.

pub fn test_rfc4648_hello() -> bool {
    return b64_encode("hello") == "aGVsbG8=" && b64_decode("aGVsbG8=") == "hello"
}

pub fn test_roundtrip() -> bool {
    let original = "Lateralus base64"
    return b64_decode(b64_encode(original)) == original
}

pub fn test_padding_vectors() -> bool {
    return b64_encode("f") == "Zg==" && b64_encode("fo") == "Zm8=" && b64_encode("foo") == "Zm9v"
}

