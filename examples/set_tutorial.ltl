// ===================================================================
// examples/set_tutorial.ltl — stdlib/set.ltl tutorial companion
// Runnable tour of the set module: sorted-dedup-list representation,
// construction, union/intersection/difference/symmetric_difference,
// subset/superset/disjoint/equality predicates, map/filter/fold and
// power_set. Self-contained so it runs on `lateralus run`.
// ===================================================================

fn set_new() -> list { return [] }

fn set_from_list(items: list) -> list {
    let s = []
    for item in items {
        if !contains(s, item) {
            s = s + [item]
        }
    }
    return sort(s)
}

fn set_add(s: list, item) -> list {
    if contains(s, item) { return s }
    return sort(s + [item])
}

fn set_union(a: list, b: list) -> list {
    let result = a |> map(fn(x) { x })
    for item in b {
        if !contains(result, item) {
            result = result + [item]
        }
    }
    return sort(result)
}

fn set_intersection(a: list, b: list) -> list {
    return a |> filter(fn(x) { contains(b, x) })
}

fn set_difference(a: list, b: list) -> list {
    return a |> filter(fn(x) { !contains(b, x) })
}

fn set_symdiff(a: list, b: list) -> list {
    return sort(set_difference(a, b) + set_difference(b, a))
}

fn set_is_subset(a: list, b: list) -> bool {
    for item in a {
        if !contains(b, item) { return false }
    }
    return true
}

fn set_is_disjoint(a: list, b: list) -> bool {
    return len(set_intersection(a, b)) == 0
}

fn set_equals(a: list, b: list) -> bool {
    if len(a) != len(b) { return false }
    return set_is_subset(a, b)
}

fn set_map(s: list, f: fn) -> list {
    return set_from_list(s |> map(f))
}

fn set_filter(s: list, pred: fn) -> list {
    return s |> filter(pred)
}

fn set_power(s: list) -> list {
    if len(s) == 0 { return [[]] }
    let rest = slice(s, 1, len(s))
    let ps = set_power(rest)
    let with_first = ps |> map(fn(sub) { sort([s[0]] + sub) })
    return ps + with_first
}

fn yesno(b: bool) -> str {
    if b { return "true" }
    return "false"
}

fn show(label: str, xs: list) {
    println(label + ": [" + join(xs, ", ") + "]")
}

fn main() {
    println("=== LATERALUS STDLIB SET TUTORIAL ===")
    let a = set_from_list([4, 1, 3, 2, 2, 4])
    let b = set_from_list([6, 3, 5, 4])
    show("A = from_list([4,1,3,2,2,4])", a)
    show("B = from_list([6,3,5,4])", b)

    println("STEP 1: from_list dedup+sort -> " + join(a, ","))
    show("STEP 2: add(A, 9)", set_add(a, 9))
    show("STEP 3: union(A,B)", set_union(a, b))
    show("STEP 4: intersection(A,B)", set_intersection(a, b))
    show("STEP 5: difference(A,B)", set_difference(a, b))
    show("STEP 6: symmetric_difference(A,B)", set_symdiff(a, b))
    println("STEP 7: is_subset([1,2],A) = " + yesno(set_is_subset([1, 2], a)))
    println("STEP 7b: is_subset(B,A) = " + yesno(set_is_subset(b, a)))
    println("STEP 8: is_disjoint(A,[7,8]) = " + yesno(set_is_disjoint(a, [7, 8])))
    println("STEP 8b: is_disjoint(A,B) = " + yesno(set_is_disjoint(a, b)))
    println("STEP 9: equals(from_list([4,3,2,1]),A) = " + yesno(set_equals(set_from_list([4, 3, 2, 1]), a)))
    show("STEP 10: map_set(A, x*10)", set_map(a, fn(x) { x * 10 }))
    show("STEP 11: filter_set(A, even)", set_filter(a, fn(x) { x % 2 == 0 }))

    let ps = set_power([1, 2])
    println("STEP 12: power_set([1,2]) has " + str(len(ps)) + " subsets")
    let i = 0
    while i < len(ps) {
        show("  subset " + str(i), ps[i])
        i = i + 1
    }

    println("PINNED_VECTORS: A=[1,2,3,4] union=[1,2,3,4,5,6] inter=[3,4] diff=[1,2] symdiff=[1,2,5,6] powerset_size=4")
}

main()
