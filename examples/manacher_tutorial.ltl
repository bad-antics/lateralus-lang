// Lateralus Standard Library Example: Manacher's Algorithm
// Demonstrates linear O(n) longest palindromic substring search and biological DNA sequence analysis.

fn manacher_preprocess(s: str) -> str {
    let n = len(s);
    if n == 0 {
        return "^$";
    }
    let mut res = "^";
    let mut i = 0;
    while i < n {
        res = res + "#" + slice(s, i, i + 1);
        i = i + 1;
    }
    res = res + "#$";
    return res;
}

fn longest_palindromic_substring(s: str) -> str {
    let n = len(s);
    if n <= 1 {
        return s;
    }

    let t = manacher_preprocess(s);
    let m = len(t);

    let mut p = [];
    let mut idx = 0;
    while idx < m {
        p = p + [0];
        idx = idx + 1;
    }

    let mut center = 0;
    let mut right = 0;

    let mut i = 1;
    while i < (m - 1) {
        let i_mirror = 2 * center - i;
        if right > i {
            let mirror_rad = p[i_mirror];
            let bound_rad = right - i;
            if mirror_rad < bound_rad {
                p[i] = mirror_rad;
            } else {
                p[i] = bound_rad;
            }
        } else {
            p[i] = 0;
        }

        while slice(t, i + 1 + p[i], i + 1 + p[i] + 1) == slice(t, i - 1 - p[i], i - 1 - p[i] + 1) {
            p[i] = p[i] + 1;
        }

        if (i + p[i]) > right {
            center = i;
            right = i + p[i];
        }

        i = i + 1;
    }

    let mut max_len = 0;
    let mut center_idx = 0;
    let mut k = 1;
    while k < (m - 1) {
        if p[k] > max_len {
            max_len = p[k];
            center_idx = k;
        }
        k = k + 1;
    }

    let start = (center_idx - max_len) >> 1;
    return slice(s, start, start + max_len);
}

fn main() -> int {
    println("=== Manacher's Algorithm Example ===");

    // Simulated genomic DNA sequence containing an inverted repeat hairpin loop:
    let dna_strand = "ACGTGCATATACGTTGCA";
    println("Analyzing DNA sequence:");
    println(dna_strand);

    let longest_pal = longest_palindromic_substring(dna_strand);
    println("Longest palindromic substring detected:");
    println(longest_pal);

    println("Length of palindromic region:");
    println(len(longest_pal));

    println("Manacher algorithm execution completed successfully.");
    return 0;
}
