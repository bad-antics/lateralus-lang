// Pinned vectors for stdlib/simhash.ltl.
// Load stdlib/xxhash.ltl and stdlib/simhash.ltl before this file.

let PASS = 0
let FAIL = 0

fn check(name: str, condition: bool) {
    if condition { PASS = PASS + 1 } else {
        FAIL = FAIL + 1
        print("FAIL: " + name)
    }
}

fn main() {
    // XXH64 anchors the per-token hash used by SimHash.
    check("xxh64 empty", hash64_str("", 0) == 0xEF46DB3751D8E999)
    check("xxh64 abc", hash64_str("abc", 0) == 0x44BC2CF5AD770999)

    check("empty fingerprint", fingerprint("") == 0xFFFFFFFFFFFFFFFF)
    check("quick fox vector",
          fingerprint("The quick brown fox jumps over the lazy dog")
          == 0x593B03225397E4AE)
    check("case folding",
          fingerprint("THE QUICK BROWN FOX JUMPS OVER THE LAZY DOG")
          == 0x593B03225397E4AE)
    check("hamming identical", hamming(0x593B03225397E4AE,
                                        0x593B03225397E4AE) == 0)
    check("near duplicate", near_duplicate("hello world foo",
                                            "hello world foo", 3))

    print("pass=" + str(PASS) + " fail=" + str(FAIL))
}

main()
