// Lateralus Standard Library Example: Levenshtein Distance & CLI "Did you mean?"
// Demonstrates fuzzy distance computation and automated spelling correction.

fn min_val(a: int, b: int) -> int {
    if a < b { return a; }
    return b;
}

fn min3(a: int, b: int, c: int) -> int {
    return min_val(min_val(a, b), c);
}

fn levenshtein(s1: string, s2: string) -> int {
    let len1 = len(s1);
    let len2 = len(s2);
    if len1 == 0 { return len2; }
    if len2 == 0 { return len1; }

    let mut prev = [];
    let mut j = 0;
    while j <= len2 {
        prev.append(j);
        j = j + 1;
    }

    let mut i = 0;
    while i < len1 {
        let ch1 = slice(s1, i, i + 1);
        let mut curr = [i + 1];
        let mut k = 0;
        while k < len2 {
            let ch2 = slice(s2, k, k + 1);
            let mut cost = 1;
            if ch1 == ch2 {
                cost = 0;
            }
            let deletion = prev[k + 1] + 1;
            let insertion = curr[k] + 1;
            let substitution = prev[k] + cost;
            curr.append(min3(deletion, insertion, substitution));
            k = k + 1;
        }
        prev = curr;
        i = i + 1;
    }
    return prev[len2];
}

fn main() -> int {
    println("=== Lateralus CLI \"Did you mean?\" Demo ===");

    let typo = "chek";
    println("User entered unknown CLI command: '" + typo + "'");

    let candidates = ["build", "test", "check", "clean", "publish"];
    let mut best_candidate = "";
    let mut best_dist = 999;

    let mut idx = 0;
    while idx < len(candidates) {
        let candidate = candidates[idx];
        let d = levenshtein(typo, candidate);
        println("Distance to '" + candidate + "': " + str(d));

        if d < best_dist {
            best_dist = d;
            best_candidate = candidate;
        }
        idx = idx + 1;
    }

    println("Suggestion: Did you mean '" + best_candidate + "'? (distance: " + str(best_dist) + ")");
    assert(best_candidate == "check");
    assert(best_dist == 1);

    return 0;
}
