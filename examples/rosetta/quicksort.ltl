// Rosetta Code · Sorting algorithms/Quicksort · Lateralus
// Lomuto partition, recursive on both halves.

fn partition(a: list, lo: int, hi: int) -> int {
    let pivot = a[hi]
    let i = lo
    let j = lo
    while j < hi {
        if a[j] < pivot {
            let t = a[i]
            a[i] = a[j]
            a[j] = t
            i = i + 1
        }
        j = j + 1
    }
    let t2 = a[i]
    a[i] = a[hi]
    a[hi] = t2
    return i
}

fn qs(a: list, lo: int, hi: int) {
    if lo < hi {
        let p = partition(a, lo, hi)
        qs(a, lo, p - 1)
        qs(a, p + 1, hi)
    }
}

fn quicksort(xs: list) -> list {
    let a = list_copy(xs)
    qs(a, 0, len(a) - 1)
    return a
}

fn main() {
    assert_eq(quicksort([3, 7, 8, 5, 2, 1, 9, 5, 4]), [1, 2, 3, 4, 5, 5, 7, 8, 9], "ints")
    assert_eq(quicksort([]), [], "empty")
    assert_eq(quicksort([1]), [1], "single")
    print("quicksort: " + str(quicksort([10, -2, 0, 5])))
}

main()
