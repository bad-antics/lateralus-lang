// Lateralus Standard Library Example: ULID Generation & Lexicographical Sorting
// Demonstrates Crockford Base32 encoding and monotonic time sorting.

fn crockford_symbol(val: int) -> string {
    let charset = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
    // Modular mapping for demonstration
    if val >= 0 && val < 32 {
        return slice(charset, val, val + 1);
    }
    return "0";
}

fn generate_simulated_ulid(timestamp_marker: string, sequence: int) -> string {
    let entropy = "7ZZZZZZZZZZZZZZ";
    let seq_char = crockford_symbol(sequence);
    return timestamp_marker + entropy + seq_char;
}

fn main() -> int {
    println("=== Lateralus ULID (Crockford Base32) Demo ===");

    // Three consecutive events at millisecond offsets:
    // Event 1 at timestamp prefix 01ARYZ6S40
    // Event 2 at timestamp prefix 01ARYZ6S41
    // Event 3 at timestamp prefix 01ARYZ6S42
    let ulid_1 = generate_simulated_ulid("01ARYZ6S40", 1);
    let ulid_2 = generate_simulated_ulid("01ARYZ6S41", 2);
    let ulid_3 = generate_simulated_ulid("01ARYZ6S42", 3);

    println("Event 1 ULID: " + ulid_1);
    println("Event 2 ULID: " + ulid_2);
    println("Event 3 ULID: " + ulid_3);

    // Verify length (26 characters standard)
    assert(len(ulid_1) == 26);
    assert(len(ulid_2) == 26);
    assert(len(ulid_3) == 26);

    // Verify monotonic property: ulid_1 < ulid_2 < ulid_3
    assert(ulid_1 < ulid_2);
    assert(ulid_2 < ulid_3);

    println("Verification Successful: ULIDs are strictly monotonic and sortable!");
    return 0;
}
