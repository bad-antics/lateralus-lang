// Lateralus Standard Library Example: UTF-8 Stream Validator & Unicode Decoder
// Demonstrates RFC 3629 compliant variable-length byte decoding and security sanity checks.

fn utf8_encode_codepoint(cp: int) -> list {
    if cp < 128 {
        return [cp];
    }
    if cp < 2048 {
        return [192 | (cp >> 6), 128 | (cp & 63)];
    }
    if cp < 65536 {
        return [224 | (cp >> 12), 128 | ((cp >> 6) & 63), 128 | (cp & 63)];
    }
    return [240 | (cp >> 18), 128 | ((cp >> 12) & 63), 128 | ((cp >> 6) & 63), 128 | (cp & 63)];
}

fn utf8_validate_and_decode(bytes: list) -> list {
    let mut codepoints = [];
    let mut i = 0;
    let n = len(bytes);

    while i < n {
        let b0 = bytes[i];
        if (b0 & 128) == 0 {
            codepoints = codepoints + [b0];
            i = i + 1;
        } else if (b0 & 224) == 192 {
            if i + 1 >= n { return []; }
            let b1 = bytes[i + 1];
            if (b1 & 192) != 128 { return []; }
            let cp = ((b0 & 31) << 6) | (b1 & 63);
            if cp < 128 { return []; }
            codepoints = codepoints + [cp];
            i = i + 2;
        } else if (b0 & 240) == 224 {
            if i + 2 >= n { return []; }
            let b1 = bytes[i + 1];
            let b2 = bytes[i + 2];
            if (b1 & 192) != 128 || (b2 & 192) != 128 { return []; }
            let cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
            if cp < 2048 { return []; }
            if cp >= 55296 && cp <= 57343 { return []; }
            codepoints = codepoints + [cp];
            i = i + 3;
        } else if (b0 & 248) == 240 {
            if i + 3 >= n { return []; }
            let b1 = bytes[i + 1];
            let b2 = bytes[i + 2];
            let b3 = bytes[i + 3];
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 { return []; }
            let cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
            if cp < 65536 || cp > 1114111 { return []; }
            codepoints = codepoints + [cp];
            i = i + 4;
        } else {
            return [];
        }
    }
    return codepoints;
}

fn main() -> int {
    println("=== Lateralus RFC 3629 UTF-8 Validation & Decoder Demo ===");

    // Concatenate byte streams for: "Hello € 🚀"
    // 'H' (72), 'i' (105), ' ' (32), '€' (8364), ' ' (32), '🚀' (128640)
    let mut stream = [];
    stream = stream + utf8_encode_codepoint(72);     // 'H' (1 byte)
    stream = stream + utf8_encode_codepoint(105);    // 'i' (1 byte)
    stream = stream + utf8_encode_codepoint(32);     // ' ' (1 byte)
    stream = stream + utf8_encode_codepoint(8364);   // '€' (3 bytes: [226, 130, 172])
    stream = stream + utf8_encode_codepoint(32);     // ' ' (1 byte)
    stream = stream + utf8_encode_codepoint(128640); // '🚀' (4 bytes: [240, 159, 154, 128])

    println("Serialized UTF-8 Byte Array: " + str(stream));
    println("Total Encoded Bytes: " + str(len(stream)) + " bytes (vs 24 bytes in 32-bit UCS-4)");

    let decoded = utf8_validate_and_decode(stream);
    println("Decoded Unicode Codepoints: " + str(decoded));
    assert(len(decoded) == 6);
    assert(decoded[0] == 72);
    assert(decoded[3] == 8364);
    assert(decoded[5] == 128640);

    // Overlong test defense
    let evil_overlong = [193, 129]; // Illegal 2-byte representation of 'A' (65)
    let defense = utf8_validate_and_decode(evil_overlong);
    assert(len(defense) == 0);
    println("Security Defense: Successfully rejected overlong payload [0xC1, 0x81]");

    println("\nUTF-8 validator and decoding engine verified 100% faithful!");
    return 0;
}