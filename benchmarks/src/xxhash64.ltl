// XXH64 over 2 MB of deterministic pseudo-random data.
// Input: glibc LCG bytes (seed 777), 2,097,152 bytes.
// Expected output: 16759434631272806465
import xxhash

fn main() {
    let n = 2097152
    let data = [0] * n
    let st = 777
    let i = 0
    while i < n {
        st = (1103515245 * st + 12345) % 2147483648
        data[i] = (st >> 16) & 0xff
        i = i + 1
    }
    println(xxhash.hash64(data, 0))
}

main()
