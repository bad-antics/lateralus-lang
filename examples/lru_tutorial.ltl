// ===================================================================
// examples/lru_tutorial.ltl — stdlib/lru.ltl tutorial companion
// Runnable tour of the LRU cache: put/get with recency ordering,
// capacity eviction, hits/misses/hit_rate, has/remove, resize/clear,
// from_pairs. Self-contained module inline (no changes needed).
// ===================================================================

fn new(capacity: int) -> map {
    let cache = {}
    cache["data"] = {}
    cache["order"] = []
    cache["capacity"] = capacity
    cache["hits"] = 0
    cache["misses"] = 0
    return cache
}

/// Create with initial entries.  If entries exceed capacity, oldest
/// are evicted.
fn from_pairs(pairs: list, capacity: int) -> map {
    let c = new(capacity)
    for pair in pairs {
        c = put(c, pair[0], pair[1])
    }
    return c
}

// -- Core operations -------------------------------------------------

/// Get a value by key.  Moves the key to most-recently-used.
/// Returns [cache, value] — value is nil if not found.
fn get(c: map, key: str) -> list {
    let data = c["data"]
    if contains(keys(data), key) {
        c["hits"] = c["hits"] + 1
        c = _move_to_end(c, key)
        return [c, data[key]]
    }
    c["misses"] = c["misses"] + 1
    return [c, nil]
}

/// Put a key-value pair into the cache.
/// If at capacity, evicts the least recently used entry.
fn put(c: map, key: str, value) -> map {
    let data = c["data"]

    // If key already exists, update and move to end
    if contains(keys(data), key) {
        data[key] = value
        c["data"] = data
        c = _move_to_end(c, key)
        return c
    }

    // Evict if at capacity
    let order = c["order"]
    if len(order) >= c["capacity"] and c["capacity"] > 0 {
        let evict_key = order[0]
        order = slice(order, 1, len(order))
        let new_data = {}
        for k in keys(data) {
            if k != evict_key {
                new_data[k] = data[k]
            }
        }
        data = new_data
    }

    // Insert new entry
    data[key] = value
    order = order + [key]
    c["data"] = data
    c["order"] = order
    return c
}

/// Remove a key from the cache.
fn remove(c: map, key: str) -> map {
    let data = c["data"]
    if not contains(keys(data), key) {
        return c
    }
    let new_data = {}
    for k in keys(data) {
        if k != key {
            new_data[k] = data[k]
        }
    }
    c["data"] = new_data
    c["order"] = _remove_from_list(c["order"], key)
    return c
}

/// Check if a key exists (does NOT update recency).
fn has(c: map, key: str) -> bool {
    return contains(keys(c["data"]), key)
}

// -- Query -----------------------------------------------------------

/// Number of entries in the cache.
fn size(c: map) -> int {
    return len(c["order"])
}

/// Maximum capacity.
fn capacity(c: map) -> int {
    return c["capacity"]
}

/// Whether the cache is empty.
fn is_empty(c: map) -> bool {
    return len(c["order"]) == 0
}

/// Whether the cache is at capacity.
fn is_full(c: map) -> bool {
    return len(c["order"]) >= c["capacity"]
}

/// Cache hit count.
fn hits(c: map) -> int {
    return c["hits"]
}

/// Cache miss count.
fn misses(c: map) -> int {
    return c["misses"]
}

/// Hit rate (0.0 to 1.0).
fn hit_rate(c: map) -> float {
    let total = c["hits"] + c["misses"]
    if total == 0 {
        return 0.0
    }
    return float(c["hits"]) / float(total)
}

/// Get all keys in order from least to most recently used.
fn all_keys(c: map) -> list {
    return c["order"]
}

/// Get cache statistics.
fn stats(c: map) -> map {
    let s = {}
    s["size"] = size(c)
    s["capacity"] = capacity(c)
    s["hits"] = hits(c)
    s["misses"] = misses(c)
    s["hit_rate"] = hit_rate(c)
    return s
}

// -- Lifecycle -------------------------------------------------------

/// Clear all entries.
fn clear(c: map) -> map {
    c["data"] = {}
    c["order"] = []
    c["hits"] = 0
    c["misses"] = 0
    return c
}

/// Resize the cache capacity.  Evicts oldest entries if shrinking.
fn resize(c: map, new_capacity: int) -> map {
    c["capacity"] = new_capacity
    let order = c["order"]
    while len(order) > new_capacity {
        let evict_key = order[0]
        order = slice(order, 1, len(order))
        let data = c["data"]
        let new_data = {}
        for k in keys(data) {
            if k != evict_key {
                new_data[k] = data[k]
            }
        }
        c["data"] = new_data
    }
    c["order"] = order
    return c
}

// -- Internal helpers ------------------------------------------------

fn _move_to_end(c: map, key: str) -> map {
    c["order"] = _remove_from_list(c["order"], key) + [key]
    return c
}

fn _remove_from_list(lst: list, value) -> list {
    let result = []
    for item in lst {
        if item != value {
            result = result + [item]
        }
    }
    return result
}

fn main() {
    print("=== LATERALUS STDLIB LRU TUTORIAL ===")

    // -- Step 1: put/get + recency ---------------------------------------
    print("STEP 1 put/get:")
    let c = new(3)
    c = put(c, "a", 1)
    c = put(c, "b", 2)
    c = put(c, "c", 3)
    print("  keys=" + str(all_keys(c)))
    let g = get(c, "a")
    c = g[0]
    print("  get_a=" + str(g[1]))
    print("  keys_after_get=" + str(all_keys(c)))

    // -- Step 2: eviction ---------------------------------------------------
    print("STEP 2 eviction:")
    c = put(c, "d", 4)   // evicts b (LRU after 'a' was touched)
    print("  keys=" + str(all_keys(c)))
    print("  has_b=" + str(has(c, "b")))
    print("  get_b=" + str(get(c, "b")[1]))
    c = get(c, "b")[0]   // reinsert? no — get doesn't insert; put does
    c = put(c, "e", 5)   // evicts next LRU
    print("  keys2=" + str(all_keys(c)))

    // -- Step 3: hits/misses/hit_rate ---------------------------------------
    print("STEP 3 stats:")
    let s = stats(c)
    print("  size=" + str(s["size"]))
    print("  hits=" + str(s["hits"]))
    print("  misses=" + str(s["misses"]))
    print("  hit_rate=" + str(s["hit_rate"]))

    // -- Step 4: has (no recency) / remove -------------------------------------
    print("STEP 4 has/remove:")
    print("  has_a=" + str(has(c, "a")))
    print("  keys_before=" + str(all_keys(c)))
    print("  has_a=" + str(has(c, "a")))
    print("  keys_after_has=" + str(all_keys(c)))
    c = remove(c, "c")
    print("  after_remove=" + str(all_keys(c)))
    print("  has_c=" + str(has(c, "c")))

    // -- Step 5: resize + clear ------------------------------------------------
    print("STEP 5 resize/clear:")
    c = resize(c, 1)
    print("  after_resize=" + str(all_keys(c)))
    c = clear(c)
    print("  empty=" + str(is_empty(c)))
    print("  stats_hits_kept=" + str(hits(c)))

    // -- Step 6: from_pairs ------------------------------------------------------
    print("STEP 6 from_pairs:")
    let c2 = from_pairs([["x", 1], ["y", 2], ["z", 3], ["w", 4]], 2)
    print("  keys=" + str(all_keys(c2)))
    print("  get_w=" + str(get(c2, "w")[1]))
    print("  get_x=" + str(get(c2, "x")[1]))

    print("PINNED_VECTORS: cap3 recency_a_first evict_b hits1_misses2 "
        + "hit_rate_0.33 has_no_touch remove_missing_noop resize1_e "
        + "clear_resets_stats pairs_cap2_keeps_zw")
    print("  OK examples/lru_tutorial.ltl")
    return 0
}
