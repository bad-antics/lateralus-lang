// Convex Hull Tutorial Tests
// Tests for Monotone Chain convex hull implementation

import "stdlib/convex_hull.ltl"

// Test cross product orientation
fn test_cross_product() {
    let o = (0.0, 0.0)
    let a = (1.0, 0.0)
    let b = (0.0, 1.0)
    
    // Counter-clockwise turn should be positive
    let ccw_result = cross_product(o, a, b)
    assert(ccw_result > 0.0, "Counter-clockwise turn should be positive")
    
    // Clockwise turn should be negative
    let cw_result = cross_product(o, b, a)
    assert(cw_result < 0.0, "Clockwise turn should be negative")
    
    // Collinear points should be zero
    let collinear_result = cross_product(o, a, (2.0, 0.0))
    assert(collinear_result == 0.0, "Collinear points should have zero cross product")
}

// Test convex hull with classic multi-point cloud
fn test_convex_hull_multi_point() {
    let points = [
        (0.0, 0.0),
        (1.0, 0.0),
        (1.0, 1.0),
        (0.0, 1.0),
        (0.5, 0.5),  // Interior point
        (2.0, 2.0),
        (-1.0, -1.0)
    ]
    
    let hull = convex_hull(points)
    
    // Verify hull has the expected vertices
    assert(len(hull) == 4, "Hull should have 4 vertices")
    
    // Check that hull vertices are in counter-clockwise order
    let area = polygon_area(hull)
    assert(area > 0.0, "Hull area should be positive")
}

// Test collinear point handling
fn test_convex_hull_collinear() {
    let collinear_points = [
        (0.0, 0.0),
        (1.0, 1.0),
        (2.0, 2.0),
        (3.0, 3.0),
        (1.0, 0.0),
        (2.0, 0.0)
    ]
    
    let hull = convex_hull(collinear_points)
    
    // Hull should only include endpoints
    assert(len(hull) == 2, "Collinear hull should have only endpoints")
    
    // Check endpoints are correct
    assert(hull[0] == (0.0, 0.0), "First endpoint should be (0, 0)")
    assert(hull[1] == (3.0, 3.0), "Second endpoint should be (3, 3)")
}

// Test triangle boundary
fn test_convex_hull_triangle() {
    let triangle_points = [
        (0.0, 0.0),
        (10.0, 0.0),
        (5.0, 8.0)
    ]
    
    let hull = convex_hull(triangle_points)
    
    // All points should be on hull
    assert(len(hull) == 3, "Triangle hull should have 3 vertices")
    
    // Check area calculation
    let area = polygon_area(hull)
    assert(area > 0.0, "Triangle area should be positive")
}

// Test square boundary
fn test_convex_hull_square() {
    let square_points = [
        (0.0, 0.0),
        (10.0, 0.0),
        (10.0, 10.0),
        (0.0, 10.0),
        (5.0, 5.0)  // Interior point
    ]
    
    let hull = convex_hull(square_points)
    
    // Hull should have 4 vertices
    assert(len(hull) == 4, "Square hull should have 4 vertices")
    
    // Check area calculation
    let area = polygon_area(hull)
    assert(area == 100.0, "Square area should be 100")
}

// Test edge cases
fn test_convex_hull_edge_cases() {
    // Single point
    let single_point = [(5.0, 5.0)]
    let hull_single = convex_hull(single_point)
    assert(len(hull_single) == 1, "Single point hull should have 1 vertex")
    
    // Two points
    let two_points = [(1.0, 1.0), (5.0, 5.0)]
    let hull_two = convex_hull(two_points)
    assert(len(hull_two) == 2, "Two points hull should have 2 vertices")
    
    // Three collinear points
    let three_collinear = [(0.0, 0.0), (1.0, 1.0), (2.0, 2.0)]
    let hull_collinear = convex_hull(three_collinear)
    assert(len(hull_collinear) == 2, "Three collinear points hull should have 2 vertices")
}

// Test point in hull
fn test_point_in_hull() {
    let hull = [
        (0.0, 0.0),
        (10.0, 0.0),
        (10.0, 10.0),
        (0.0, 10.0)
    ]
    
    // Point inside
    let inside_point = (5.0, 5.0)
    assert(point_in_hull(inside_point, hull), "Center point should be inside hull")
    
    // Point outside
    let outside_point = (15.0, 15.0)
    assert(!point_in_hull(outside_point, hull), "Outside point should not be in hull")
    
    // Point on edge
    let edge_point = (0.0, 5.0)
    assert(point_in_hull(edge_point, hull), "Edge point should be in hull")
}

// Run all tests
fn main() {
    test_cross_product()
    test_convex_hull_multi_point()
    test_convex_hull_collinear()
    test_convex_hull_triangle()
    test_convex_hull_square()
    test_convex_hull_edge_cases()
    test_point_in_hull()
    
    println!("All convex hull tests passed!")
}