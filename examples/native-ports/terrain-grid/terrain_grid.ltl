fn height_at(row: int, column: int) -> int {
    let mut ridge = (3 * column + row) % 97
    if ridge > 48 {
        ridge = 96 - ridge
    }
    let mut fold = (column + 5 * row) % 61
    if fold > 30 {
        fold = 60 - fold
    }
    let basin = (row / 11 + column / 17) % 29
    return 400 + 9 * ridge + 4 * fold - 3 * basin
}

fn magnitude(delta: int) -> int {
    if delta < 0 {
        return -delta
    }
    return delta
}

fn survey(side: int) -> void {
    let mut minimum = height_at(0, 0)
    let mut maximum = minimum
    let mut height_total = 0
    let mut high_cells = 0
    let mut horizontal_change = 0
    let mut vertical_change = 0

    let mut row = 0
    while row < side {
        let mut column = 0
        let mut left = height_at(row, 0)
        while column < side {
            let height = height_at(row, column)
            if height < minimum {
                minimum = height
            }
            if height > maximum {
                maximum = height
            }
            if height >= 800 {
                high_cells += 1
            }
            height_total += height

            // Count each shared edge once, from its right or bottom cell.
            if column > 0 {
                horizontal_change += magnitude(height - left)
            }
            if row > 0 {
                vertical_change += magnitude(height - height_at(row - 1, column))
            }
            left = height
            column += 1
        }
        row += 1
    }

    let edges_per_direction = side * (side - 1)
    let mean_mm = height_total * 1000 / (side * side)
    let east_step_mm = horizontal_change * 1000 / edges_per_direction
    let south_step_mm = vertical_change * 1000 / edges_per_direction
    print(side)
    print("x")
    print(side)
    print(" min_m=")
    print(minimum)
    print(" max_m=")
    print(maximum)
    print(" mean_mm=")
    print(mean_mm)
    print(" high_cells=")
    print(high_cells)
    print(" east_step_mm=")
    print(east_step_mm)
    print(" south_step_mm=")
    println(south_step_mm)
}

pub fn main() -> int {
    survey(8)
    survey(1536)
    return 0
}
