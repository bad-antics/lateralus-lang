// Rosetta Code · Word frequency · Lateralus
// Count words, then order them by descending count (selection sort over pairs).

fn count_words(text: str) -> dict {
    let counts = {}
    let toks = str_split(str_lower(text), " ")
    let i = 0
    while i < len(toks) {
        let w = str_trim(toks[i])
        if len(w) > 0 {
            if contains(counts, w) { counts[w] = counts[w] + 1 }
            else { counts[w] = 1 }
        }
        i = i + 1
    }
    return counts
}

fn ranked(text: str) -> list {
    let counts = count_words(text)
    let ws = sorted(keys(counts))
    let pairs = []
    let i = 0
    while i < len(ws) {
        pairs = pairs + [[ws[i], counts[ws[i]]]]
        i = i + 1
    }
    // selection sort: heavier count first, ties by word asc (already sorted input)
    let a = 0
    while a < len(pairs) {
        let best = a
        let b = a + 1
        while b < len(pairs) {
            if pairs[b][1] > pairs[best][1] { best = b }
            b = b + 1
        }
        if best != a {
            let t = pairs[a]
            pairs[a] = pairs[best]
            pairs[best] = t
        }
        a = a + 1
    }
    return pairs
}

fn main() {
    let text = "the quick brown fox jumps over the lazy dog the fox"
    let r = ranked(text)
    assert_eq(r[0][0], "the", "top word")
    assert_eq(r[0][1], 3, "top count")
    assert_eq(r[1][0], "fox", "second word")
    assert_eq(r[1][1], 2, "second count")
    print("top 5: " + str(slice(r, 0, 5)))
}

main()
