{
  "stdlib: xxhash": {
    "prefix": "std-xxhash",
    "body": ["import stdlib.xxhash", "", "let h = xxhash.hash64(${1:data})"],
    "description": "xxHash64 fast non-cryptographic hash"
  },
  "stdlib: lz4": {
    "prefix": "std-lz4",
    "body": ["import stdlib.lz4", "", "let packed = lz4.compress(${1:data})", "let data2 = lz4.decompress(packed)"],
    "description": "LZ4 compress / decompress round-trip"
  },
  "stdlib: chacha20": {
    "prefix": "std-chacha20",
    "body": ["import stdlib.chacha20", "", "let ct = chacha20.encrypt(${1:key}, ${2:nonce}, ${3:plaintext})"],
    "description": "ChaCha20 stream encryption"
  },
  "stdlib: aho_corasick": {
    "prefix": "std-aho",
    "body": ["import stdlib.aho_corasick", "", "let ac = aho_corasick.compile(${1:patterns})", "let hits = aho_corasick.search(ac, ${2:text})"],
    "description": "Aho-Corasick multi-pattern search"
  },
  "stdlib: radix_sort": {
    "prefix": "std-radix",
    "body": ["import stdlib.radix_sort", "", "let sorted = radix_sort.radix_sort_u32(${1:keys})"],
    "description": "O(n) radix sort for u32 keys"
  },
  "stdlib: json": {
    "prefix": "std-json",
    "body": ["import stdlib.json", "", "let value = json.parse(${1:text})", "let text2 = json.encode(value)"],
    "description": "JSON parse / encode"
  },
  "stdlib: regex": {
    "prefix": "std-regex",
    "body": ["import stdlib.regex", "", "let re = regex.compile(${1:pattern})", "let m = regex.find(re, ${2:text})"],
    "description": "Regular expression compile / find"
  },
  "stdlib: csv": {
    "prefix": "std-csv",
    "body": ["import stdlib.csv", "", "let rows = csv.parse(${1:text})"],
    "description": "CSV parsing"
  },
  "stdlib: http": {
    "prefix": "std-http",
    "body": ["import stdlib.http", "", "let resp = http.get(${1:url})"],
    "description": "HTTP client request"
  },
  "stdlib: time": {
    "prefix": "std-time",
    "body": ["import stdlib.time", "", "let now = time.now()"],
    "description": "Date and time helpers"
  },
  "stdlib: base64": {
    "prefix": "std-base64",
    "body": ["import stdlib.base64", "", "let enc = base64.encode(${1:data})", "let dec = base64.decode(enc)"],
    "description": "Base64 encode / decode"
  },
  "stdlib: collections": {
    "prefix": "std-collections",
    "body": ["import stdlib.collections", "", "let m = collections.new_map()"],
    "description": "Collection helpers"
  },
  "stdlib: statistics": {
    "prefix": "std-statistics",
    "body": ["import stdlib.statistics", "", "let mean = statistics.mean(${1:xs})"],
    "description": "Statistical functions"
  },
  "stdlib: graph": {
    "prefix": "std-graph",
    "body": ["import stdlib.graph", "", "let g = graph.new()"],
    "description": "Graph data structure and algorithms"
  },
  "stdlib: datetime": {
    "prefix": "std-datetime",
    "body": ["import stdlib.datetime", "", "let d = datetime.parse(${1:text})"],
    "description": "Datetime parsing and formatting"
  },
  "stdlib: parquet": {
    "prefix": "std-parquet",
    "body": ["import stdlib.parquet", "", "let table = parquet.read(${1:path})"],
    "description": "Parquet columnar file reader"
  },
  "stdlib: logfmt": {
    "prefix": "std-logfmt",
    "body": ["import stdlib.logfmt", "", "let record = logfmt.parse(${1:line})"],
    "description": "logfmt line parsing"
  },
  "stdlib: uuid": {
    "prefix": "std-uuid",
    "body": ["import stdlib.uuid", "", "let id = uuid.v4()"],
